    minaret:textIndopak "الرَّحْمٰنِ الرَّحِیْمِ ۟ۙ" ;
    minaret:textUthmani "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ" ;
    minaret:translationEn "The Entirely Merciful, the Especially Merciful," ;
    minaret:translationUr "بہت مہربان ، نہایت رحم کرنے والاہے۔" ;
    minaret:verseNumber 3 ;
    skos:exactMatch qur:quran1-3,
