minaret:VerseOccurrence_TQ2005-0315_0001_23_12_59_21 a minaret:VerseOccurrence ;
    minaret:endTime 52.48 ;
    minaret:evidenceText "اگر اس قرآن کو ہم کسی پہاڑ پر اتارتے، پہاڑ پر رکھتے، تو تم دیکھتے کہ وہ دب گیا ہے، دب گیا ہے۔ «خَاشِعًا مُّتَصَدِّعًا»، پھٹ گیا ہے، ٹکڑے ٹکڑے ہو گیا ہے، «مِّنْ خَشْیَةِ اللّٰهِ»، اللہ کے خوف سے۔" ;
    minaret:hasExtentType minaret:PartialCitation ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_TQ2005-0315_23_12_52_48 ;
    minaret:refersTo minaret:QuranVerse_59_21 ;
    minaret:startTime 23.12 .

