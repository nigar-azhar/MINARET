minaret:QuranVerse_1_4 a minaret:QuranVerse ;
    minaret:juz 1 ;
    minaret:surahNumber 1 ;
    minaret:textClean "مالك يوم الدين" ;
    minaret:textIndopak "مٰلِكِ یَوْمِ الدِّیْنِ ۟ؕ" ;
