minaret:QuranVerse_1_1 a minaret:QuranVerse ;
    minaret:juz 1 ;
    minaret:surahNumber 1 ;
    minaret:textClean "بسم الله الرحمن الرحيم" ;
    minaret:textIndopak "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ ۟" ;
    minaret:textUthmani "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ" ;
    minaret:translationEn "In the name of Allah, the Entirely Merciful, the Especially Merciful." ;
    minaret:translationUr "اللہ کے نام سے (ابتدا)جو بہت مہربان، نہایت رحم کرنے والا ہے ۔" ;
    minaret:verseNumber 1 ;
    skos:exactMatch qur:quran1-1,
        tafsir:V001_001 .

