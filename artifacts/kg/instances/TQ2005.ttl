minaret:QuranVerse_1_6 a minaret:QuranVerse ;
    minaret:juz 1 ;
    minaret:surahNumber 1 ;
    minaret:textClean "اهدنا الصراط المستقيم" ;
    minaret:textIndopak "اِهْدِنَا الصِّرَاطَ الْمُسْتَقِیْمَ ۟ۙ" ;
    minaret:textUthmani "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ" ;
    minaret:translationEn "Guide us to the straight path -" ;
    minaret:translationUr "دکھا ہمیں سیدھا راستہ ۔" ;
    minaret:verseNumber 6 ;
    skos:exactMatch qur:quran1-6,
