    skos:exactMatch qur:quran26-193,
        tafsir:V026_193 .

minaret:QuranVerse_26_194 a minaret:QuranVerse ;
    minaret:juz 19 ;
    minaret:surahNumber 26 ;
    minaret:textClean "على قلبك لتكون من المنذرين" ;
    minaret:textIndopak "عَلٰی قَلْبِكَ لِتَكُوْنَ مِنَ الْمُنْذِرِیْنَ ۟ۙ" ;
    minaret:textUthmani "عَلَىٰ قَلۡبِكَ لِتَكُونَ مِنَ ٱلۡمُنذِرِينَ" ;
    minaret:translationEn "Upon your heart, [O Muhammad] - that you may be of the warners -" ;
    minaret:translationUr "" ;
    minaret:verseNumber 194 ;
    skos:exactMatch qur:quran26-194,
        tafsir:V026_194 .

minaret:QuranVerse_26_195 a minaret:QuranVerse ;
    minaret:juz 19 ;
    minaret:surahNumber 26 ;
    minaret:textClean "بلسان عربي مبين" ;
    minaret:textIndopak "بِلِسَانٍ عَرَبِیٍّ مُّبِیْنٍ ۟ؕ" ;
    minaret:textUthmani "بِلِسَانٍ عَرَبِيٍّ مُّبِينٍ" ;
