minaret:HadithOccurrence_TQ2005-0319_0006_1276_98_SM_395 a minaret:HadithOccurrence ;
    minaret:endTime 1367.42 ;
    minaret:evidenceText "میں نے نماز کو اپنے اور بندے کے درمیان آدھا آدھا تقسیم کر دیا ہے... میرا بندہ نماز میں کھڑا ہوتا ہے اور کہتا ہے الحمد للہ رب العالمین تو اللہ تعالیٰ فرماتا ہے میرے بندے نے میری تعریف کی..." ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_TQ2005-0319_1276_98_1367_42 ;
    minaret:refersTo minaret:Hadith_SM_395 ;
    minaret:startTime 1276.98 .

minaret:HadithOccurrence_TQ2005-0319_0007_2139_46_SB_780 a minaret:HadithOccurrence ;
    minaret:endTime 2177.54 ;
    minaret:evidenceText "جب امام ولا الضالین کہے تو تم آمین کہو، جس کا آمین کہنا فرشتوں کے آمین کہنے کے موافق ہو گیا اس کے پچھلے گناہ بخش دیے جاتے ہیں" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_TQ2005-0319_2139_46_2177_54 ;
    minaret:refersTo minaret:Hadith_SB_780 ;
    minaret:startTime 2139.46 .

