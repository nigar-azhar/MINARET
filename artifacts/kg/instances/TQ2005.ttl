minaret:SegmentGroup_TQ2005-0314_11_08_17_9 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_TQ2005-0314_0001 ;
    minaret:endTime 17.9 ;
    minaret:startTime 11.08 .

minaret:SegmentGroup_TQ2005-0316_64_86_83_66 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_TQ2005-0316_0007,
        minaret:Segment_TQ2005-0316_0008 ;
    minaret:endTime 83.66 ;
    minaret:startTime 64.86 .

minaret:Segment_TQ2005-0314_0000 a minaret:TranscriptSegment ;
    minaret:endTime 11.08 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0001 ;
    minaret:sequenceIndex 0 ;
    minaret:startTime 0.62 ;
    minaret:text "نَحْمَدُهٗ وَنُصَلِّیْ عَلٰی رَسُوْلِهِ الْكَرِیْمِ، اَمَّا بَعْدُ، فَاَعُوْذُ بِاللّٰهِ مِنَ الشَّیْطٰنِ الرَّجِیْمِ، بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ۔ رَبِّ" .

minaret:Segment_TQ2005-0314_0002 a minaret:TranscriptSegment ;
    minaret:endTime 33.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0003 ;
    minaret:sequenceIndex 2 ;
    minaret:startTime 20.659999999999993 ;
    minaret:text "ہم صرف کام نہیں کریں گے بلکہ اپنے کام کا حساب بھی خود ہی کریں گے، کیونکہ جب تک ہم خود اپنے آپ سے کام نہیں کرائیں گے،" .

minaret:Segment_TQ2005-0314_0003 a minaret:TranscriptSegment ;
    minaret:endTime 43.22 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0004 ;
    minaret:sequenceIndex 3 ;
    minaret:startTime 34.019999999999996 ;
    minaret:text "جب تک ہم اپنے آپ کو خود نمبر نہیں دیں گے کہ ہم کہاں کھڑے ہیں، جب تک ہم اپنی ایویلویشن خود نہیں کریں گے،" .

minaret:Segment_TQ2005-0314_0004 a minaret:TranscriptSegment ;
    minaret:endTime 50.8 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0005 ;
    minaret:sequenceIndex 4 ;
    minaret:startTime 44.34 ;
    minaret:text "اپنی خوبیوں اور خامیوں کو نہیں جانیں گے، اس وقت تک آگے نہیں بڑھ سکتے۔" .

minaret:Segment_TQ2005-0314_0005 a minaret:TranscriptSegment ;
    minaret:endTime 60.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 52.96 ;
    minaret:text "تو ہمارے سامنے جو ایک بہت بڑا چیلنج ہے وہ کیا ہے؟ کہ ہمیں اللہ نے عقل والا انسان بنایا ہے" .

minaret:Segment_TQ2005-0314_0006 a minaret:TranscriptSegment ;
    minaret:endTime 70.34 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 61.42 ;
    minaret:text "اور عقل کی نعمت دے کر پیدا کیا ہے، اور جو ہمارا اس دنیا میں سب سے بڑا امتحان ہے وہ یہی ہے کہ ہم اپنی اس عقل کو استعمال کس طرح کرتے ہیں۔" .

minaret:Segment_TQ2005-0314_0007 a minaret:TranscriptSegment ;
    minaret:endTime 78.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 71.55999999999997 ;
    minaret:text "اور یہی چیز ہمیں جانوروں سے الگ کرتی ہے۔ جانور بھی اپنی ضرورت کی عقل استعمال کر لیتے ہیں،" .

minaret:Segment_TQ2005-0314_0008 a minaret:TranscriptSegment ;
    minaret:endTime 86.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 79.82 ;
    minaret:text "لیکن ان کے پاس عقل ہے ہی لمیٹڈ، ہمارے پاس عقل زیادہ ہے۔" .

minaret:Segment_TQ2005-0314_0009 a minaret:TranscriptSegment ;
    minaret:endTime 95.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 87.03999999999999 ;
    minaret:text "تو ہمیں اس کو استعمال کرنا ہے، اس سے فائدہ اٹھانا ہے اور سوچ سمجھ کی زندگی بسر کرنی ہے، اندھا دھند نہیں، آنکھیں بند کر کے نہیں۔" .

minaret:Segment_TQ2005-0314_0010 a minaret:TranscriptSegment ;
    minaret:endTime 106.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 96.72 ;
    minaret:text "جو ہم نے بات کی تھی نا کہ کامیاب انسان کون ہوتا ہے؟ تو اس میں کامیاب انسان ایک معتدل شخصیت ہوتا ہے جس کی جسمانی، ذہنی،" .

minaret:Segment_TQ2005-0314_0011 a minaret:TranscriptSegment ;
    minaret:endTime 116.34 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0012 ;
    minaret:sequenceIndex 11 ;
    minaret:startTime 106.84 ;
    minaret:text "روحانی اور امم جذباتی اور سماجی شخصیت جو ہے یا لائف کے جو ایسپیکٹس ہیں، ان سب کے اندر ایک ہارمونی اور بیلنس ہو۔" .

minaret:Segment_TQ2005-0314_0012 a minaret:TranscriptSegment ;
    minaret:endTime 128.28 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0013 ;
    minaret:sequenceIndex 12 ;
    minaret:startTime 116.34 ;
    minaret:text "اور جب تک ہماری ذہنی صحت یا ہمارا ذہنی ایسپیکٹ یا انٹلیکچوئل ایسپیکٹ یا ہمارے شعور اور سوچ کا ایسپیکٹ جاگتا نہیں،" .

minaret:Segment_TQ2005-0314_0013 a minaret:TranscriptSegment ;
    minaret:endTime 140.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0014 ;
    minaret:sequenceIndex 13 ;
    minaret:startTime 129.12 ;
    minaret:text "اس وقت تک ہم دین میں ترقی نہیں کر سکتے۔ تو کوئی بھی کام آنکھیں بند کر کے نہیں کرنا، ہر چیز کو کریٹیکلی دیکھنا ہے۔" .

minaret:Segment_TQ2005-0314_0020 a minaret:TranscriptSegment ;
    minaret:endTime 211.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0021 ;
    minaret:sequenceIndex 20 ;
    minaret:startTime 203.06 ;
    minaret:text "جی، یہ بتا رہی ہیں کہ ان کی ایک گروپ فیلو نے یہ بتایا کہ انہوں نے جب گھر جا کر شیئر کیا کہ انہوں نے آج یہاں کیا سیکھا،" .

minaret:Segment_TQ2005-0314_0021 a minaret:TranscriptSegment ;
    minaret:endTime 222.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0022 ;
    minaret:sequenceIndex 21 ;
    minaret:startTime 212.5 ;
    minaret:text "تو اس شیئرنگ کا فائدہ یہ ہوا کہ ان کی جو دیورانی تھیں وہ بھی آ گئیں اور یہ اس بات کی، خیر و برکت کی علامت" .

minaret:Segment_TQ2005-0314_0022 a minaret:TranscriptSegment ;
    minaret:endTime 232.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 222.54 ;
    minaret:text "ہے کہ جب آپ اپنی باتیں دوسروں سے اور خاص طور پر نیکی کی باتیں، کام کی باتیں شیئر کرتے ہیں تو آپ دراصل دوسروں کو ایک مدد دے رہے ہوتے ہیں۔" .

minaret:Segment_TQ2005-0314_0023 a minaret:TranscriptSegment ;
    minaret:endTime 243.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 233.52 ;
    minaret:text "اور سب سے بڑی بات اگر آپ کو یاد رہی ہو کہ کسی بھی انسان کی سب سے بڑی خیرخواہی کیا ہے؟ کہ اس کے نامۂ اعمال میں" .

minaret:Segment_TQ2005-0314_0026 a minaret:TranscriptSegment ;
    minaret:endTime 279.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 269.96000000000004 ;
    minaret:text "اب وہ جو بھی صاحبہ ہیں خود آئیں، ساتھ دیورانی کو لے آئیں۔ اب دیورانی اگر پڑھتی ہیں اور جتنی بھی نیکی کریں گی،" .

minaret:Segment_TQ2005-0314_0033 a minaret:TranscriptSegment ;
    minaret:endTime 358.64 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0034 ;
    minaret:sequenceIndex 33 ;
    minaret:startTime 348.52 ;
    minaret:text "دونوں نیکیاں ہیں۔ میں یہ نہیں کہتی کہ دنیا میں آپ کسی کا کوئی بھلا نہ کریں، دنیا کا بھی کریں، لیکن وہ چیز جو کسی کی آخرت بنانے والی ہے اور آخرت کے کام آنے والی ہے،" .

minaret:Segment_TQ2005-0314_0034 a minaret:TranscriptSegment ;
    minaret:endTime 368.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0035 ;
    minaret:sequenceIndex 34 ;
    minaret:startTime 359.4 ;
    minaret:text "وہ حقیقی معنی میں بہت بڑی چیز ہے، چاہے کوئی اس کی قدر کرے یا نہ کرے۔ بعض وقت ایسا ہوتا ہے آپ کسی کو اچھی بات بتانے لگتے ہیں وہ الٹا پڑتا ہے آپ پہ،" .

minaret:Segment_TQ2005-0314_0035 a minaret:TranscriptSegment ;
    minaret:endTime 381.24 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0036 ;
    minaret:sequenceIndex 35 ;
    minaret:startTime 369.02 ;
    minaret:text "وہ کہتے ہیں: ”مجھے کیوں بتا رہے ہو؟ تم جاؤ اپنا کام کرو۔“ اسی وجہ سے اس چیز کا اجر بہت بڑا رکھا، کیونکہ یہ کام آسان نہیں ہے۔ اگر آپ کسی کی دنیا بنانا چاہتے ہیں تو وہ خوش ہو کے آپ کو ویلکم کرتا ہے۔" .

minaret:Segment_TQ2005-0314_0057 a minaret:TranscriptSegment ;
    minaret:endTime 615.64 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0058 ;
    minaret:sequenceIndex 57 ;
    minaret:startTime 608.46 ;
    minaret:text "دیکھیے کہ ہم عام طور پر یہ سمجھتے ہیں کہ سیکھنا جو ہے وہ علم انڈیلنا ہے اپنے اندر۔ یہاں آئیں گے،" .

minaret:Segment_TQ2005-0314_0058 a minaret:TranscriptSegment ;
    minaret:endTime 626.14 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 616.1800000000001 ;
    minaret:text "لمبا چوڑا لیکچر سنیں گے، نئی نئی باتیں سن کے وہ چلے جائیں گے اور ختم۔ نہیں، یہ سیکھنا نہیں ہوتا، یہ تو بس انفارمیشن پاس کرنا ہے۔ سیکھنے میں" .

minaret:Segment_TQ2005-0314_0059 a minaret:TranscriptSegment ;
    minaret:endTime 637.4 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0060 ;
    minaret:sequenceIndex 59 ;
    minaret:startTime 627.3199999999999 ;
    minaret:text "انفارمیشن لینا، یہ ایسے ہی ہے جیسے کھانا منہ میں ڈالنا اور پیٹ میں اتارنا۔ اب اگلا مرحلہ کیا ہے؟ ہضم کرنا ہے، ہے یا نہیں؟" .

minaret:Segment_TQ2005-0314_0060 a minaret:TranscriptSegment ;
    minaret:endTime 648.64 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0061 ;
    minaret:sequenceIndex 60 ;
    minaret:startTime 638.22 ;
    minaret:text "ایک طریقہ تو یہ ہے کہ آپ کھاتے جائیں، کھاتے جائیں، کھاتے جائیں اور کھا کے چلے جائیں اور کھانا وہیں کا وہیں رک جائے، اور اگلا مرحلہ کیا ہے کہ وہ ڈائجسٹ ہو۔" .

minaret:Segment_TQ2005-0314_0061 a minaret:TranscriptSegment ;
    minaret:endTime 661.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0062 ;
    minaret:sequenceIndex 61 ;
    minaret:startTime 649.7 ;
    minaret:text "جب ڈائجیشن کا مرحلہ آتا ہے تو اس میں کیا کیا چیز شامل ہوتی ہے؟ کون کون سے باڈی پارٹس اپنا رول پلے کرتے ہیں؟ کچھ تھوڑا بہت سب کو ہی پتا ہوگا۔" .

minaret:Segment_TQ2005-0314_0062 a minaret:TranscriptSegment ;
    minaret:endTime 672.08 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0063 ;
    minaret:sequenceIndex 62 ;
    minaret:startTime 662.14 ;
    minaret:text "معدہ شریک ہوتا ہے، اور؟ اور بھی تو ایک بہت بڑا آرگن ساتھ ملتا ہے: لیور، جگر۔ اگر وہ بیمار ہو تو ڈائجیشن ٹھیک نہیں ہوتی۔" .

minaret:Segment_TQ2005-0314_0063 a minaret:TranscriptSegment ;
    minaret:endTime 678.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0064 ;
    minaret:sequenceIndex 63 ;
    minaret:startTime 673.0 ;
    minaret:text "اور کیا؟ گال بلیڈر، سلائیوا آپ کے منہ سے ہی ساتھ شامل ہو جاتا ہے۔" .

minaret:Segment_TQ2005-0314_0064 a minaret:TranscriptSegment ;
    minaret:endTime 689.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0065 ;
    minaret:sequenceIndex 64 ;
    minaret:startTime 679.72 ;
    minaret:text "انٹسٹائن، وہاں جا کے بھی وہ ابزارپشن ہوتی ہے۔ معدے کا ایسڈ جو ہے، اور بھی اگر آپ ڈیٹیل میں جائیں تو بہت ساری اندر چیزیں کام کر رہی ہیں، تب جا کر آپ کی خوراک" .

minaret:Segment_TQ2005-0314_0065 a minaret:TranscriptSegment ;
    minaret:endTime 699.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0066 ;
    minaret:sequenceIndex 65 ;
    minaret:startTime 690.6 ;
    minaret:text "آپ کے جسم کے لیے طاقت کا ذریعہ بنتی ہے۔ اب ایک تو طریقہ یہ ہے کہ جو کچھ آپ سیکھیں اس کو ڈائجسٹ کریں،" .

minaret:Segment_TQ2005-0314_0066 a minaret:TranscriptSegment ;
    minaret:endTime 709.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0067 ;
    minaret:sequenceIndex 66 ;
    minaret:startTime 700.02 ;
    minaret:text "اس کو کسی کام میں لائیں، اور ایک طریقہ کیا ہے؟ بس کھاتے جائیں اور کھاتے جائیں اور اس کی پروا نہ کریں کہ وہ ڈائجسٹ ہوتا ہے یا نہیں ہوتا۔" .

minaret:Segment_TQ2005-0314_0067 a minaret:TranscriptSegment ;
    minaret:endTime 719.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0068 ;
    minaret:sequenceIndex 67 ;
    minaret:startTime 710.3199999999999 ;
    minaret:text "اور یاد رکھیے کہ صرف ایک استاد کے بولنے سے، ایک کتاب کے مل جانے سے، معلومات کے اضافے سے" .

minaret:Segment_TQ2005-0314_0068 a minaret:TranscriptSegment ;
    minaret:endTime 731.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0069 ;
    minaret:sequenceIndex 68 ;
    minaret:startTime 720.3599999999999 ;
    minaret:text "ڈائجیشن نہیں ہوا کرتی۔ اس میں گروپ انچارج کا رول ہوگا اور اس میں آپ کے ساتھیوں کا رول ہوگا۔ آپ کے جو ساتھی ہیں،" .

minaret:Segment_TQ2005-0314_0069 a minaret:TranscriptSegment ;
    minaret:endTime 741.22 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0070 ;
    minaret:sequenceIndex 69 ;
    minaret:startTime 731.8 ;
    minaret:text "ان سے آپ بہت کچھ سیکھیں گے اور ان کو بہت کچھ سکھائیں گے۔ اور پھر صرف یہی نہیں بات بنے گی، اس میں آپ کے گھر والے،" .

minaret:Segment_TQ2005-0314_0070 a minaret:TranscriptSegment ;
    minaret:endTime 753.02 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0071 ;
    minaret:sequenceIndex 70 ;
    minaret:startTime 741.84 ;
    minaret:text "آپ کا سوشل سرکل وہ بھی ساتھ ایک حد تک شریک ہوگا۔ ہو سکتا ہے وہ آپ سے پوچھے: ”کیا سیکھا؟“ ہو سکتا ہے وہ آپ کو اپوز کرے، وہ کہے: ”یہ تمہیں غلط بتایا گیا۔" .

minaret:Segment_TQ2005-0314_0071 a minaret:TranscriptSegment ;
    minaret:endTime 763.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0072 ;
    minaret:sequenceIndex 71 ;
    minaret:startTime 753.6999999999999 ;
    minaret:text "یہ تو ٹھیک ہی نہیں ہے۔“ تو چیلنج آگیا نا آپ کے سامنے؟ اب جب چیلنج آئے گا تو پھر آپ کہیں گے: ”اچھا؟“ آپ کے اندر ایک شک ابھرے گا کہ" .

minaret:Segment_TQ2005-0314_0072 a minaret:TranscriptSegment ;
    minaret:endTime 774.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0073 ;
    minaret:sequenceIndex 72 ;
    minaret:startTime 764.3000000000001 ;
    minaret:text "وہ غلط بتایا ہمیں؟ میں ذرا چیک کرتی ہوں۔ پھر آپ کیا کریں گے؟ کسی اور انسان سے پوچھیں گے یا کتاب سے دیکھیں گے، تو اس طرح یہ" .

minaret:Segment_TQ2005-0314_0073 a minaret:TranscriptSegment ;
    minaret:endTime 786.5 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0074 ;
    minaret:sequenceIndex 73 ;
    minaret:startTime 775.44 ;
    minaret:text "مختلف طریقوں سے علم آپ کے اندر ڈائجسٹ ہوگا، تب آپ نشوونما پائیں گے اور علمی لحاظ سے اور عملی لحاظ سے ان شاء اللہ" .

minaret:Segment_TQ2005-0314_0074 a minaret:TranscriptSegment ;
    minaret:endTime 796.4 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0075 ;
    minaret:sequenceIndex 74 ;
    minaret:startTime 787.32 ;
    minaret:text "مضبوط ہوں گے اور ایک کامیاب زندگی کی طرف سفر کریں گے۔ اور یہ جو سفر ہے یہ مت سوچیں کہ اس کورس کی حد تک ہے اور ختم ہے۔ انسان بھولتا ہے،" .

minaret:Segment_TQ2005-0314_0075 a minaret:TranscriptSegment ;
    minaret:endTime 802.46 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0076 ;
    minaret:sequenceIndex 75 ;
    minaret:startTime 797.04 ;
    minaret:text "جان کے انجان ہو جاتا ہے، یاد دہانی چاہیے، سیکھتے رہنے کی ضرورت ہے۔" .

minaret:Segment_TQ2005-0314_0086 a minaret:TranscriptSegment ;
    minaret:endTime 936.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0087 ;
    minaret:sequenceIndex 86 ;
    minaret:startTime 925.42 ;
    minaret:text "اور جس کا نام پکارا گیا ہے وہ بتانے کے بجائے دوسرا شخص کہہ رہا ہے وہ بیٹھا ہوا ہے۔ We have to control ourselves. مومن کی خوبی کیا ہوتی ہے؟" .

minaret:Segment_TQ2005-0314_0088 a minaret:TranscriptSegment ;
    minaret:endTime 958.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0089 ;
    minaret:sequenceIndex 88 ;
    minaret:startTime 949.28 ;
    minaret:text "کوئی حاضر ہوا ہے تو وہ خود بتا دے گا کہ وہ حاضر ہے، اور اگر حاضر نہیں ہوا تو آپ کو ضرورت نہیں ہے کہ آپ بتائیں کہ یہ حاضر ہے اور بیٹھی ہوئی ہے۔ آپ اس کے حصے کا کام نہیں کریں۔" .

minaret:Segment_TQ2005-0314_0089 a minaret:TranscriptSegment ;
    minaret:endTime 969.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0090 ;
    minaret:sequenceIndex 89 ;
    minaret:startTime 960.0999999999999 ;
    minaret:text "ہم سب کو اپنے شعور سے کام لینا ہے، عقل استعمال کرنی ہے، خود ہی ایوالیویٹ کرنا ہے چیزوں کو اور پھر ان کو درست کرنا ہے۔" .

minaret:Segment_TQ2005-0314_0096 a minaret:TranscriptSegment ;
    minaret:endTime 1046.46 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0097 ;
    minaret:sequenceIndex 96 ;
    minaret:startTime 1036.18 ;
    minaret:text "ہمارے دین میں ہر روز نماز کے لیے کیا بنتی ہیں؟ صفیں بنتی ہیں، بنتی ہیں۔ اگر صف نہ بنے تو نماز ہو جاتی ہے؟ نہیں ہوتی نا۔" .

minaret:Segment_TQ2005-0314_0099 a minaret:TranscriptSegment ;
    minaret:endTime 1064.22 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0100 ;
    minaret:sequenceIndex 99 ;
    minaret:startTime 1055.3 ;
    minaret:text "اسی طرح سرکل کا درست ہونا تعلیم کا حصہ ہے، ٹھیک ہے؟ اور ڈسپلن کو فالو کرنا،" .

minaret:Segment_TQ2005-0314_0102 a minaret:TranscriptSegment ;
    minaret:endTime 1090.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0103 ;
    minaret:sequenceIndex 102 ;
    minaret:startTime 1083.5600000000002 ;
    minaret:text "ہمارا سننا، ہمارا بولنا، ہمارا لینا، ہمارا دینا، ہمارا چلنا، ہمارا اٹھنا، ہمارا بیٹھنا" .

minaret:Segment_TQ2005-0314_0105 a minaret:TranscriptSegment ;
    minaret:endTime 1124.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0106 ;
    minaret:sequenceIndex 105 ;
    minaret:startTime 1115.58 ;
    minaret:text "اور پھر آپ دیکھیں کہ ہم اللہ کی نظر میں تو ہیں ہی، ہم فرشتوں کے ریکارڈ میں بھی ہیں، وہ بھی ہر وقت کیمرے لے کے ہمارے چاروں طرف ہیں،" .

minaret:Segment_TQ2005-0314_0106 a minaret:TranscriptSegment ;
    minaret:endTime 1133.2 ;
    minaret:sequenceIndex 106 ;
    minaret:startTime 1124.7 ;
    minaret:text "لیکن پھر ہم لوگوں کی مسلسل نظروں میں ہیں کہ ہم کیا کرتے ہیں۔ تو ان ساری نظروں کا احترام کیجیے۔" .

minaret:Segment_TQ2005-0315_0005 a minaret:TranscriptSegment ;
    minaret:endTime 70.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 62.3 ;
    minaret:text "اگر پہاڑ کا یہ عالم ہو، تو انسان کا کیا ہونا چاہیے؟ اس کی کیفیت کیا ہونی چاہیے؟" .

minaret:Segment_TQ2005-0315_0006 a minaret:TranscriptSegment ;
    minaret:endTime 81.02 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 71.88 ;
    minaret:text "اللہ کے کلام کا انسان کو ملنا کوئی معمولی بات نہیں ہے، کوئی معمولی واقعہ نہیں ہے،" .

minaret:Segment_TQ2005-0315_0007 a minaret:TranscriptSegment ;
    minaret:endTime 92.24 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 81.96 ;
    minaret:text "کوئی عام سی بات نہیں ہے۔ یہ اس کائنات کا سب سے حیرت انگیز تجربہ ہے، سب سے زیادہ حیرت انگیز واقعہ ہے" .

minaret:Segment_TQ2005-0315_0008 a minaret:TranscriptSegment ;
    minaret:endTime 105.18 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 93.24 ;
    minaret:text "کہ کائنات کا بنانے والا اپنا کلام بندوں کے لیے بھیجے، اور شاید اس بات کو وہ زیادہ بہتر طور پر سمجھ سکے جو اللہ کی عظمت کو پہچانتا ہو،" .

minaret:Segment_TQ2005-0315_0009 a minaret:TranscriptSegment ;
    minaret:endTime 109.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 105.96 ;
    minaret:text "جسے رب کی معرفت ہو کہ یہ بات ہے کس کی۔" .

minaret:Segment_TQ2005-0315_0019 a minaret:TranscriptSegment ;
    minaret:endTime 222.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0020 ;
    minaret:sequenceIndex 19 ;
    minaret:startTime 209.96 ;
    minaret:text "تو دیکھیے کہ سب سے پہلے تو میں یہ کہوں گی کہ یہ ایک book ہے جو اللہ کا کلام ہے، اور اللہ تعالیٰ نے اپنے فرشتے جبرائیل علیہ السلام کے ذریعے محمد صلی اللہ علیہ وسلم پر" .

minaret:Segment_TQ2005-0315_0020 a minaret:TranscriptSegment ;
    minaret:endTime 232.18 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0021 ;
    minaret:sequenceIndex 20 ;
    minaret:startTime 223.14000000000001 ;
    minaret:text "نازل کیا۔ کس سنچری میں؟ 7th century میں، کیونکہ آپ صلی اللہ علیہ وسلم 40 کے ہوئے تھے تو اس وقت سیونتھ سنچری شروع ہو چکی تھی۔" .

minaret:Segment_TQ2005-0315_0021 a minaret:TranscriptSegment ;
    minaret:endTime 243.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0022 ;
    minaret:sequenceIndex 21 ;
    minaret:startTime 233.24 ;
    minaret:text "آپ کو یہ پتا ہونا چاہیے، you should talk like this کہ it was revealed in 7th century۔ کیوں؟ کیوں ایسے بولیں گے آپ کہ سیونتھ سنچری میں نازل ہوا تھا؟" .

minaret:Segment_TQ2005-0315_0022 a minaret:TranscriptSegment ;
    minaret:endTime 251.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 244.0 ;
    minaret:text "کل بھی میں نے آپ کو بات کہی تھی کہ ہر چیز دلیل کے ساتھ اور ہر چیز کے پیچھے کوئی reference اور proof کے ساتھ کچھ بات ہونی چاہیے۔" .

minaret:Segment_TQ2005-0315_0023 a minaret:TranscriptSegment ;
    minaret:endTime 263.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 252.96 ;
    minaret:text "اور آپ پھر یہ بتائیں گے کہ یہ 23 years میں reveal ہوا، اور کچھ حصہ اس کا مکہ میں اور کچھ مدینہ میں، and everybody knows now کہ where is Makkah and where is Madinah۔" .

minaret:Segment_TQ2005-0315_0026 a minaret:TranscriptSegment ;
    minaret:endTime 299.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 292.5 ;
    minaret:text "Complete introduction ہے۔ سورۃ الشعراء، آیت نمبر 192 سے 196۔" .

minaret:Segment_TQ2005-0315_0029 a minaret:TranscriptSegment ;
    minaret:endTime 330.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0030 ;
    minaret:sequenceIndex 29 ;
    minaret:startTime 321.21999999999997 ;
    minaret:text "تو یہ ایک بہترین تعارف ہے۔ اس میں تین چار باتیں ہیں، آپ لکھ سکتے ہیں۔ اس آیت کو خود گھر جا کر نکالیے قرآن پاک میں سے،" .

minaret:Segment_TQ2005-0315_0032 a minaret:TranscriptSegment ;
    minaret:endTime 363.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0033 ;
    minaret:sequenceIndex 32 ;
    minaret:startTime 355.41999999999996 ;
    minaret:text "«لِتَكُوْنَ مِنَ الْمُنْذِرِیْنَ»، پرپس کیا ہے؟ تاکہ لوگوں کو خبردار کیا جائے، وارن کیا جائے، آخری دن کے بارے میں بتایا جائے۔" .

minaret:Segment_TQ2005-0315_0043 a minaret:TranscriptSegment ;
    minaret:endTime 496.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0044 ;
    minaret:sequenceIndex 43 ;
    minaret:startTime 489.47999999999996 ;
    minaret:text "اب آپ دیکھیے کہ یہ جو لفظ ہے نا «مُنْذِرِیْنَ»، اس سے مطلب یہ ہے کہ صرف آپ صلی اللہ علیہ وسلم پر کتاب نہیں آئی بلکہ اس کے علاوہ بھی پیغمبر آئے ہیں۔" .

minaret:Segment_TQ2005-0315_0044 a minaret:TranscriptSegment ;
    minaret:endTime 502.64 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0045 ;
    minaret:sequenceIndex 44 ;
    minaret:startTime 497.34 ;
    minaret:text "قرآن پاک میں ایک ادب بتایا گیا ہے کہ جب آپ بات کریں اہل کتاب سے، خاص طور پر،" .

minaret:Segment_TQ2005-0315_0046 a minaret:TranscriptSegment ;
    minaret:endTime 524.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0047 ;
    minaret:sequenceIndex 46 ;
    minaret:startTime 514.76 ;
    minaret:text "اہل کتاب سے ہمیشہ common grounds پر بات کریں۔ Common grounds کیا ہیں؟ ہمارے اور تمہارے درمیان کیا سوا ہے، اور فرق کہاں آ گیا، ٹھیک ہے؟" .

minaret:Segment_TQ2005-0315_0047 a minaret:TranscriptSegment ;
    minaret:endTime 536.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0048 ;
    minaret:sequenceIndex 47 ;
    minaret:startTime 526.38 ;
    minaret:text "اچھا، پھر اس کے بعد آپ دیکھیے کہ اب آپ کو جو پروف دینا ہے، وہ نمبر ایک یہ ہے کہ چودہ سو سال سے اس میں کوئی تبدیلی نہیں ہوئی، اور یہ بات بھی پرووڈ ہے۔" .

minaret:Segment_TQ2005-0315_0048 a minaret:TranscriptSegment ;
    minaret:endTime 547.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0049 ;
    minaret:sequenceIndex 48 ;
    minaret:startTime 537.08 ;
    minaret:text "فیکٹ ہے یہ، اور اس میں آگے آپ کو وہ دلیل بھی دیں گے کہ کس طرح جرمنی کا ایک انسٹیٹیوٹ، جس میں ہزاروں کی تعداد میں قرآن پاک کو جمع کر کے وہاں کمپیئر کیا گیا، کولیٹ" .

minaret:Segment_TQ2005-0315_0049 a minaret:TranscriptSegment ;
    minaret:endTime 556.92 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0050 ;
    minaret:sequenceIndex 49 ;
    minaret:startTime 547.2 ;
    minaret:text "کیا گیا، اور کوئی بھی فرق انہیں نظر نہیں آیا سوائے مس پرنٹ حروف کے یا کچھ زبر زیر کے، ادروائز سب ایک ہی جیسا تھا۔" .

minaret:Segment_TQ2005-0315_0050 a minaret:TranscriptSegment ;
    minaret:endTime 566.88 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0051 ;
    minaret:sequenceIndex 50 ;
    minaret:startTime 556.92 ;
    minaret:text "دوسرا پروف: کہ ڈیڑھ ہزار سال پہلے جب یہ قرآن نازل ہوا تھا، تو اس وقت کوئی نہیں جانتا تھا فزکس کو، کیمسٹری کو،" .

minaret:Segment_TQ2005-0315_0051 a minaret:TranscriptSegment ;
    minaret:endTime 577.5 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0052 ;
    minaret:sequenceIndex 51 ;
    minaret:startTime 566.88 ;
    minaret:text "بائیولوجی کو، جیولوجی کو، آسٹرولوجی کو، کچھ نہیں کسی کو آتا تھا ان چیزوں میں سے، لیکن جو فیکٹس اس وقت بتائے گئے وہ آج بیسویں صدی میں" .

minaret:Segment_TQ2005-0315_0052 a minaret:TranscriptSegment ;
    minaret:endTime 590.36 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0053 ;
    minaret:sequenceIndex 52 ;
    minaret:startTime 578.26 ;
    minaret:text "سائنس نے پروف کیے اور وہ قرآن میں الریڈی موجود ہیں۔ تو پھر آپ تھوڑے سے فیکٹس یاد بھی کر سکتے ہیں۔ یہ ڈیٹیلز ہیں، پھر یہ آپ کی اپنی ضرورت پر ہیں جو ہر ایک کی ضرورت نہیں ہے ٹپس پر یاد کرنے کی۔" .

minaret:Segment_TQ2005-0315_0053 a minaret:TranscriptSegment ;
    minaret:endTime 595.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0054 ;
    minaret:sequenceIndex 53 ;
    minaret:startTime 590.9 ;
    minaret:text "اور اس میں خاص طور پر اگر کوئی مزید انٹرسٹ شو کرے تو موریس بوکائی" .

minaret:Segment_TQ2005-0315_0054 a minaret:TranscriptSegment ;
    minaret:endTime 602.14 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0055 ;
    minaret:sequenceIndex 54 ;
    minaret:startTime 595.3 ;
    minaret:text "کی جو کتاب ہے، «قرآن، بائبل اور سائنس»۔" .

minaret:Segment_TQ2005-0315_0055 a minaret:TranscriptSegment ;
    minaret:endTime 612.16 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0056 ;
    minaret:sequenceIndex 55 ;
    minaret:startTime 602.14 ;
    minaret:text "ان کا سوال بڑا ریلیونٹ ہے کہ جب یہ نان مسلمز کو کہتے ہیں کہ ہماری کتاب تبدیل نہیں ہوئی، تو وہ کہتے ہیں کہ کوئی پروف لائیں اور کیسے آپ ثابت کریں گے؟ تو اس کا سب سے بڑا پروف یہی ہے کہ جس زبان میں یہ" .

minaret:Segment_TQ2005-0315_0056 a minaret:TranscriptSegment ;
    minaret:endTime 622.16 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0057 ;
    minaret:sequenceIndex 56 ;
    minaret:startTime 612.16 ;
    minaret:text "کتاب اتری ہے، وہ زبان بھی محفوظ ہے اسی طرح اور اس میں کوئی تبدیلی نہیں ہوئی۔ آج بھی چودہ سو سال پہلے کی زبان سمجھی جاتی ہے۔ اس کے برعکس انگلش، فرینچ، کوئی زبان ایسی" .

minaret:Segment_TQ2005-0315_0057 a minaret:TranscriptSegment ;
    minaret:endTime 632.8 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0058 ;
    minaret:sequenceIndex 57 ;
    minaret:startTime 622.16 ;
    minaret:text "نہیں کہ جو تین چار سو سال پہلے بھی اگر آپ اس کو دیکھیں تو وہ اور آج کی زبان ملتی جلتی ہو۔ اتنی کوششیں کی گئیں کہ زبان میں تبدیلیاں کریں، ڈائلیکٹس کو اتنا فروغ دیا گیا، لیکن کوئی بات نہیں بنی۔" .

minaret:Segment_TQ2005-0315_0058 a minaret:TranscriptSegment ;
    minaret:endTime 643.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 633.4799999999999 ;
    minaret:text "اور اصل عربی، فصحٰی عربی جس کو کہتے ہیں، standard language، وہ وہی ہے جو چودہ سو سال پہلے ہے۔ تو جب زبان محفوظ ہے تو اس کے اندر جو کتاب ہے وہ بھی محفوظ ہے۔" .

minaret:Segment_TQ2005-0315_0065 a minaret:TranscriptSegment ;
    minaret:endTime 716.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0066 ;
    minaret:sequenceIndex 65 ;
    minaret:startTime 708.0 ;
    minaret:text "اور کیسے اب تک پہنچا؟ کیا یہ اسی طرح بک کی شکل میں اوپر سے آیا تھا جیسے موسیٰ علیہ السلام پر نازل ہوئی تھی تورات،" .

minaret:Segment_TQ2005-0315_0066 a minaret:TranscriptSegment ;
    minaret:endTime 731.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0067 ;
    minaret:sequenceIndex 66 ;
    minaret:startTime 717.6600000000001 ;
    minaret:text "تختیوں کی شکل میں، یا پھر کیا ہوا؟ اور محفوظ کس طرح ہوئی؟ آپ صلی اللہ علیہ وسلم کے پاس ہر وقت کاتب موجود ہوتے تھے، writers۔" .

minaret:Segment_TQ2005-0315_0067 a minaret:TranscriptSegment ;
    minaret:endTime 742.82 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0068 ;
    minaret:sequenceIndex 67 ;
    minaret:startTime 732.8199999999999 ;
    minaret:text "مکہ میں سترہ لوگ لکھنا جانتے تھے صرف، اور اس میں سے تقریباً بارہ لوگ جو تھے وہ آپ کے حکم کے منتظر ہوتے تھے، فوراً فوراً آپ کو کوئی بھی" .

minaret:Segment_TQ2005-0315_0068 a minaret:TranscriptSegment ;
    minaret:endTime 751.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0069 ;
    minaret:sequenceIndex 68 ;
    minaret:startTime 742.82 ;
    minaret:text "چیز اترتی تھی، آپ ان کو جس وقت بلاتے، دن کو بلاتے یا رات کو بلاتے، وہ فوراً حاضر ہوتے اور وہ لکھ لیتے تھے، حتیٰ کہ ہجرت کے سفر میں۔" .

minaret:Segment_TQ2005-0315_0069 a minaret:TranscriptSegment ;
    minaret:endTime 762.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0070 ;
    minaret:sequenceIndex 69 ;
    minaret:startTime 752.52 ;
    minaret:text "ہجرت کا سفر آپ کو معلوم ہے نا کہ کتنا کٹھن سفر تھا۔ اس میں بھی کاتب آپ کے ساتھ تھے۔ کون؟ کون سے کاتب آپ کے ساتھ تھے؟" .

minaret:Segment_TQ2005-0315_0070 a minaret:TranscriptSegment ;
    minaret:endTime 774.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0071 ;
    minaret:sequenceIndex 70 ;
    minaret:startTime 763.4 ;
    minaret:text "حضرت ابوبکر صدیق رضی اللہ تعالیٰ عنہ! وہ ہجرت کے سفر میں بھی اپنے سامان کے ساتھ موجود تھے کہ اگر کہیں کچھ وحی نازل ہوئی، کچھ بھی لکھنا پڑا تو ساتھ ہی لکھ لیں گے۔" .

minaret:Segment_TQ2005-0315_0071 a minaret:TranscriptSegment ;
    minaret:endTime 783.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0072 ;
    minaret:sequenceIndex 71 ;
    minaret:startTime 775.62 ;
    minaret:text "یعنی اس کی حفاظت کا جو اہتمام اللہ تعالیٰ نے کیا، وہ ایک تو تحریر کے ذریعے یا کتابت کے ذریعے ہوا،" .

minaret:Segment_TQ2005-0315_0072 a minaret:TranscriptSegment ;
    minaret:endTime 798.5 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0073 ;
    minaret:sequenceIndex 72 ;
    minaret:startTime 784.84 ;
    minaret:text "دوسرا اہتمام کہ فوراً یاد کر لیتے تھے، زبانی یاد کرتے تھے۔ جتنا جتنا اترتا، مرد کیا اور عورتیں کیا اور بچے کیا، اس کو حفظ کرتے تھے۔ اور عربوں کا حافظہ بہت مثالی تھا۔" .

minaret:Segment_TQ2005-0315_0073 a minaret:TranscriptSegment ;
    minaret:endTime 807.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0074 ;
    minaret:sequenceIndex 73 ;
    minaret:startTime 799.2 ;
    minaret:text "وہ لمبے لمبے قصائد، نسب نامے، قصیدے اور بہت سی اور چیزیں اس طرح کی یاد کرتے تھے۔" .

minaret:Segment_TQ2005-0315_0074 a minaret:TranscriptSegment ;
    minaret:endTime 817.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0075 ;
    minaret:sequenceIndex 74 ;
    minaret:startTime 808.3000000000001 ;
    minaret:text "آج بھی آپ دیکھیں کہ جن علاقوں میں زیادہ اسکول، کتابیں، پڑھے لکھے لوگ نہیں ہوتے، تو عام طور پر کیا ہوتا ہے؟ وہاں لوگوں کے حافظے زیادہ بہتر ہوتے ہیں۔" .

minaret:Segment_TQ2005-0315_0075 a minaret:TranscriptSegment ;
    minaret:endTime 830.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0076 ;
    minaret:sequenceIndex 75 ;
    minaret:startTime 818.44 ;
    minaret:text "اور جب ہمیں پتا ہے نا چیز لکھی ہوئی کتاب میں موجود ہے، تو ہم اتنے ریلیکس ہو جاتے ہیں، ہم کہتے ہیں پڑھ ہی لیں گے نا دوبارہ، اپنے ذہن پر زور ڈالنے کی کیا ضرورت ہے۔ ذہن کا عجیب حال ہے، اس کو جتنا استعمال کریں گے وہ اتنا چمکے گا،" .

minaret:Segment_TQ2005-0315_0076 a minaret:TranscriptSegment ;
    minaret:endTime 834.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0077 ;
    minaret:sequenceIndex 76 ;
    minaret:startTime 831.16 ;
    minaret:text "اور جتنا آپ ریلیکس ہو جائیں گے، اس کو چھوڑ دیں گے، وہ اتنا ہی بھولنا شروع کر دے گا۔" .

minaret:Segment_TQ2005-0315_0077 a minaret:TranscriptSegment ;
    minaret:endTime 846.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0078 ;
    minaret:sequenceIndex 77 ;
    minaret:startTime 836.46 ;
    minaret:text "اچھا، اب مجھے اس ایک سوال کا اور جواب دے دیجیے۔ اصل میں قرآن شروع کرنے سے پہلے تھوڑا سا قرآن کو پہچان بھی تو لیتے ہیں کہ یہ جو ہم پڑھنے جا رہے ہیں، یہ ہے کیا چیز، تاکہ ہمارے اپنے بھی ڈاؤٹس پوری طرح کلیئر ہو جائیں۔" .

minaret:Segment_TQ2005-0315_0078 a minaret:TranscriptSegment ;
    minaret:endTime 857.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0079 ;
    minaret:sequenceIndex 78 ;
    minaret:startTime 847.58 ;
    minaret:text "اچھا یہ بتائیے کہ قرآن پاک کی جو ترتیب ہے، مثلاً پہلے سورۃ الفاتحہ لکھی جائے، پھر البقرہ، پھر آل عمران، پھر یہ، یہ کس نے کہی تھی کہ ایسے لکھا جائے؟" .

minaret:Segment_TQ2005-0315_0079 a minaret:TranscriptSegment ;
    minaret:endTime 862.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0080 ;
    minaret:sequenceIndex 79 ;
    minaret:startTime 858.98 ;
    minaret:text "اب دیکھیے کہ سورۃ الفاتحہ پانچویں نمبر پہ اتری ہے۔" .

minaret:Segment_TQ2005-0315_0080 a minaret:TranscriptSegment ;
    minaret:endTime 876.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0081 ;
    minaret:sequenceIndex 80 ;
    minaret:startTime 864.56 ;
    minaret:text "نزولی ترتیب میں پانچویں نمبر پر ہے، اور ویسے یہ نمبر ون پر ہے۔ تو یہ کس نے ڈیسائیڈ کیا کہ سورۃ الفاتحہ کو نمبر ون پہ رکھنا ہے؟ اس بارے میں ایک بات یاد رکھیے" .

minaret:Segment_TQ2005-0315_0081 a minaret:TranscriptSegment ;
    minaret:endTime 882.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0082 ;
    minaret:sequenceIndex 81 ;
    minaret:startTime 876.8199999999999 ;
    minaret:text "کہ صرف کتاب نہیں اتری، اس کی ترتیب بھی اتری ہے۔" .

minaret:Segment_TQ2005-0315_0082 a minaret:TranscriptSegment ;
    minaret:endTime 895.34 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0083 ;
    minaret:sequenceIndex 82 ;
    minaret:startTime 884.24 ;
    minaret:text "تو یہ جو قرآن کی ترتیب ہے، یہ اللہ کی طرف سے ہے، جبرائیل امین کے ذریعے آپ صلی اللہ علیہ وسلم کو دی گئی۔" .

minaret:Segment_TQ2005-0315_0083 a minaret:TranscriptSegment ;
    minaret:endTime 907.56 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0084 ;
    minaret:sequenceIndex 83 ;
    minaret:startTime 896.9399999999999 ;
    minaret:text "قرآن پاک 632 کو مکمل ہوا تھا۔ تو 632 میں قرآن پاک کی تکمیل ہوئی، اور اس کے ساتھ اس کی ترتیب بھی مکمل ہوئی۔" .

minaret:Segment_TQ2005-0315_0084 a minaret:TranscriptSegment ;
    minaret:endTime 921.22 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0085 ;
    minaret:sequenceIndex 84 ;
    minaret:startTime 908.9 ;
    minaret:text "اس کے بعد آپ صلی اللہ علیہ وسلم کی تھوڑے عرصے کے بعد وفات ہو گئی۔ آپ دنیا سے تشریف لے گئے۔ میرا سوال آپ سے یہ ہے کہ کیا جب آپ دنیا سے تشریف لے گئے تھے تو قرآن پاک ایک جلد میں تھا؟" .

minaret:Segment_TQ2005-0315_0085 a minaret:TranscriptSegment ;
    minaret:endTime 927.46 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0086 ;
    minaret:sequenceIndex 85 ;
    minaret:startTime 922.6999999999999 ;
    minaret:text "نہیں تھا، ایک جلد میں نہیں تھا۔ جلد میں کس نے رکھا؟" .

minaret:Segment_TQ2005-0315_0086 a minaret:TranscriptSegment ;
    minaret:endTime 939.14 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0087 ;
    minaret:sequenceIndex 86 ;
    minaret:startTime 929.04 ;
    minaret:text "حضرت ابوبکر رضی اللہ تعالیٰ عنہ نے، ٹھیک ہے؟ یعنی مجلد میں رکھنے کا کام حضرت ابوبکر نے خود نہیں کیا تھا بلکہ آپ کے" .

minaret:Segment_TQ2005-0315_0087 a minaret:TranscriptSegment ;
    minaret:endTime 950.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0088 ;
    minaret:sequenceIndex 87 ;
    minaret:startTime 939.7600000000001 ;
    minaret:text "احکام کے تحت یا آپ کے حکم کے تحت کیا تھا، اور اس کام کو کرنے کے لیے کس مشہور صحابی کو اپوائنٹ کیا گیا تھا؟ یہ زید بن ثابت تھے،" .

minaret:Segment_TQ2005-0315_0088 a minaret:TranscriptSegment ;
    minaret:endTime 960.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0089 ;
    minaret:sequenceIndex 88 ;
    minaret:startTime 951.2600000000001 ;
    minaret:text "انصاری تھے یہ، اور یہ قرآن کے مکمل حافظ تھے۔ انہوں نے کیا کیا کہ اس کو ڈبل چیک کیا۔" .

minaret:Segment_TQ2005-0315_0089 a minaret:TranscriptSegment ;
    minaret:endTime 973.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0090 ;
    minaret:sequenceIndex 89 ;
    minaret:startTime 961.52 ;
    minaret:text "ترتیب کو ڈبل چیک کیا۔ ڈبل چیک کیسے کرنا ہوتا ہے؟ ٹو وے۔ کیسے؟ حافظوں کو بلایا، ان سے سنتے تھے، کیونکہ جو حافظ تھے نا آپ صلی اللہ علیہ وسلم کے زمانے میں، انہوں نے ترتیب سے حفظ کیا ہوا تھا۔" .

minaret:Segment_TQ2005-0315_0090 a minaret:TranscriptSegment ;
    minaret:endTime 986.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0091 ;
    minaret:sequenceIndex 90 ;
    minaret:startTime 974.0 ;
    minaret:text "ان سے سنتے اور لکھے ہوئے کو چیک کرتے، پھر لکھے ہوئے کو حافظوں پر پڑھتے اور اس طرح چیک کرتے، تو یہ ڈبل چیکنگ ہو گئی۔ یعنی ایک کو دوسرے سے اور دوسرے کو پہلے سے کمپیئر کیا گیا۔" .

minaret:Segment_TQ2005-0315_0091 a minaret:TranscriptSegment ;
    minaret:endTime 998.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0092 ;
    minaret:sequenceIndex 91 ;
    minaret:startTime 987.1999999999999 ;
    minaret:text "لکھے ہوئے کو یاد کیے ہوئے سے اور یاد کیے ہوئے کو لکھے ہوئے سے کمپیئر کیا گیا، اور اس طرح اس کو اصل شکل میں ایک جلد میں رکھا گیا۔" .

minaret:Segment_TQ2005-0315_0092 a minaret:TranscriptSegment ;
    minaret:endTime 1005.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0093 ;
    minaret:sequenceIndex 92 ;
    minaret:startTime 999.88 ;
    minaret:text "اور آپ کو پتا ہے کہ وہ جلد کی شیپ کیسی تھی؟ جلد کی شیپ پوچھ رہی ہوں میں۔" .

minaret:Segment_TQ2005-0315_0093 a minaret:TranscriptSegment ;
    minaret:endTime 1017.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0094 ;
    minaret:sequenceIndex 93 ;
    minaret:startTime 1006.74 ;
    minaret:text "چوکور! اسی لیے اس کو رُباعہ کہا گیا۔ جو جلد حضرت ابوبکر کے زمانے میں بنی تھی، وہ جلد چوکور تھی اور اس کو رُباعہ کہا گیا تھا، ٹھیک ہے؟" .

minaret:Segment_TQ2005-0315_0094 a minaret:TranscriptSegment ;
    minaret:endTime 1027.72 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0095 ;
    minaret:sequenceIndex 94 ;
    minaret:startTime 1018.32 ;
    minaret:text "اس کو کس کے پاس رکھوایا گیا تھا؟ کمپلیٹ کر کے، جلد میں رکھ کے کسی کے پاس رکھوا دیا گیا تھا کہ اب اس کو سنبھال لو: حضرت حفصہ!" .

minaret:Segment_TQ2005-0315_0095 a minaret:TranscriptSegment ;
    minaret:endTime 1034.8 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0096 ;
    minaret:sequenceIndex 95 ;
    minaret:startTime 1028.7 ;
    minaret:text "حضرت حفصہ رسول اللہ صلی اللہ علیہ وسلم کی زوجہ محترمہ تھیں، جو حضرت عمر کی بیٹی تھیں۔" .

minaret:Segment_TQ2005-0315_0096 a minaret:TranscriptSegment ;
    minaret:endTime 1042.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0097 ;
    minaret:sequenceIndex 96 ;
    minaret:startTime 1036.6 ;
    minaret:text "جب میں نے پہلی دفعہ یہ پڑھا تھا تو مجھے اتنا اچھا لگا تھا کہ اچھا، عورت اتنی قابل ہو سکتی ہے کہ وہ اتنی بڑی ذمہ داری لے!" .

minaret:Segment_TQ2005-0315_0097 a minaret:TranscriptSegment ;
    minaret:endTime 1054.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0098 ;
    minaret:sequenceIndex 97 ;
    minaret:startTime 1043.84 ;
    minaret:text "یہ کتنی بڑی سعادت کی بات ہے، آپ کی اتنی ازواج میں سے حضرت حفصہ کے حصے میں یہ چیز آئی کہ ان کی حفاظت میں دیا گیا کہ آپ اس کو رکھیں، اپنے پاس سنبھال لیں، یہ اوریجنل کاپی ہے۔" .

minaret:Segment_TQ2005-0315_0098 a minaret:TranscriptSegment ;
    minaret:endTime 1062.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0099 ;
    minaret:sequenceIndex 98 ;
    minaret:startTime 1054.8999999999999 ;
    minaret:text "ایک خاتون کو بھی شریک کیا گیا ہے۔ یہ جو کہتے ہیں نا عورت کو تو کوئی مقام ہی نہیں اسلام میں دیا گیا، تو ایسی باتیں بھی یاد رکھا کریں۔" .

minaret:Segment_TQ2005-0315_0099 a minaret:TranscriptSegment ;
    minaret:endTime 1075.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0100 ;
    minaret:sequenceIndex 99 ;
    minaret:startTime 1063.9199999999998 ;
    minaret:text "اچھا، اب یہ ان کے پاس رہا، حضرت عمر کے دور میں بھی رہا، حتیٰ کہ حضرت عثمان کا دور آ گیا۔ حضرت عثمان نے کیا کیا تھا؟ ان کا کیا کام تھا؟" .

minaret:Segment_TQ2005-0315_0100 a minaret:TranscriptSegment ;
    minaret:endTime 1083.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0101 ;
    minaret:sequenceIndex 100 ;
    minaret:startTime 1076.7399999999998 ;
    minaret:text "حضرت عثمان نے اس کی آفیشل کاپیز جو تھیں وہ بڑے بڑے شہروں میں بھجوائی تھیں، ٹھیک ہے؟" .

minaret:Segment_TQ2005-0315_0101 a minaret:TranscriptSegment ;
    minaret:endTime 1092.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0102 ;
    minaret:sequenceIndex 101 ;
    minaret:startTime 1084.62 ;
    minaret:text "اوریجنل کو لے کے اس کی ہو بہو کاپیز بنوا کے بڑے بڑے شہروں میں آپ نے ارسال کر دی تھیں، کس لیے؟" .

minaret:Segment_TQ2005-0315_0102 a minaret:TranscriptSegment ;
    minaret:endTime 1104.88 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0103 ;
    minaret:sequenceIndex 102 ;
    minaret:startTime 1094.8799999999999 ;
    minaret:text "ایک اس پر جمع کرنے کے لیے۔ اسی لیے ان کو کیا کہا جاتا ہے: جامع القرآن! کہ انہوں نے جمع و تدوین جو ان کی طرف ایٹریبیوٹ کی جاتی ہے، حضرت عثمان کی طرف،" .

minaret:Segment_TQ2005-0315_0103 a minaret:TranscriptSegment ;
    minaret:endTime 1114.6200000000001 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0104 ;
    minaret:sequenceIndex 103 ;
    minaret:startTime 1104.88 ;
    minaret:text "وہ اسی وجہ سے کہ لوگوں کو ایک چیز پر جمع کیا تھا، اور مختلف جگہوں پر جامع مسجدیں جو تھیں وہاں پر کاپیز رکھوائی گئی تھیں اور اس کے مطابق باقی لوگوں کو فالو کرنے کے لیے کہا گیا۔" .

minaret:Segment_TQ2005-0315_0104 a minaret:TranscriptSegment ;
    minaret:endTime 1131.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0105 ;
    minaret:sequenceIndex 104 ;
    minaret:startTime 1116.62 ;
    minaret:text "اچھا یہ بتائیے کہ شروع میں زبر زیر نہیں تھی، بہت سمپل سی تحریر تھی۔ حضرت عثمان کا مصحف اگر آپ نے کبھی اس کی تصویر دیکھی ہو تو آپ دیکھیں گے کہ ابھی اگر آپ پڑھنا چاہیں تو شاید اس کو پڑھ بھی نہ سکیں نا، وہ اتنا سمپل طریقے سے لکھا ہوا ہے۔" .

minaret:Segment_TQ2005-0315_0105 a minaret:TranscriptSegment ;
    minaret:endTime 1141.82 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0106 ;
    minaret:sequenceIndex 105 ;
    minaret:startTime 1131.8 ;
    minaret:text "تو کس نے پھر زبر زیر اس پر لگوائی تھی؟ حجاج بن یوسف نے لگوائی تھی۔ اس کے بعد آپ دیکھیے کہ اگلا جو سٹیپ تھا،" .

minaret:Segment_TQ2005-0315_0106 a minaret:TranscriptSegment ;
    minaret:endTime 1149.8 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0107 ;
    minaret:sequenceIndex 106 ;
    minaret:startTime 1142.9 ;
    minaret:text "وہ خطاطی کو خوبصورت بنایا گیا، یعنی لکھنے کا جو انداز تھا اسے امپروو کیا گیا۔" .

minaret:Segment_TQ2005-0315_0107 a minaret:TranscriptSegment ;
    minaret:endTime 1161.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0108 ;
    minaret:sequenceIndex 107 ;
    minaret:startTime 1151.32 ;
    minaret:text "کسی مشہور خطاط کا نام آپ بتائیں گے کہ جس نے عربی کیلیگرافی کو بہت زیادہ پریکٹس کے بعد ایک خاص شیپ دی جس کو خط کوفی کہا جاتا ہے؟" .

minaret:Segment_TQ2005-0315_0108 a minaret:TranscriptSegment ;
    minaret:endTime 1176.5 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0109 ;
    minaret:sequenceIndex 108 ;
    minaret:startTime 1162.5600000000002 ;
    minaret:text "ابن مقلہ کا نام سنا کسی نے؟ ابن مقلہ: میم، قاف، لام، ہ۔ ابن مقلہ نے کیلیگرافی کو بہت امپروو کیا تھا اور پھر خوبصورت وہاں سے قرآن پاک لکھنے کا آغاز ہوا۔" .

minaret:Segment_TQ2005-0315_0109 a minaret:TranscriptSegment ;
    minaret:endTime 1184.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0110 ;
    minaret:sequenceIndex 109 ;
    minaret:startTime 1177.3600000000001 ;
    minaret:text "پھر اس کے بعد، جیسا کہ آپ نے فرمایا کہ لہجوں میں فرق تھا اور ڈائلیکٹس مختلف تھے، تو فنِ قراءت وجود میں آیا۔" .

minaret:Segment_TQ2005-0315_0110 a minaret:TranscriptSegment ;
    minaret:endTime 1194.36 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0111 ;
    minaret:sequenceIndex 110 ;
    minaret:startTime 1185.72 ;
    minaret:text "فنِ قراءت: کہ قرآن کو پڑھنا کیسے ہے؟ اور جب عجمی لوگ مسلمان ہوئے تو مخارج کا مسئلہ ہوا، جیسے ہم لوگوں کے ساتھ ہے، اور" .

minaret:Segment_TQ2005-0315_0111 a minaret:TranscriptSegment ;
    minaret:endTime 1205.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0112 ;
    minaret:sequenceIndex 111 ;
    minaret:startTime 1195.2 ;
    minaret:text "پھر اس پر بہت محنت ہوئی اور قرآن پاک کو خوبصورت سے خوبصورت انداز میں، عین اس طریقے پر پڑھنے کی کوشش کی گئی جس پر یہ نازل ہوا تھا، ٹھیک ہے؟" .

minaret:Segment_TQ2005-0315_0112 a minaret:TranscriptSegment ;
    minaret:endTime 1215.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0113 ;
    minaret:sequenceIndex 112 ;
    minaret:startTime 1206.72 ;
    minaret:text "یہ سارے مرحلے ہیں حفاظت کے اور قرآن کے اوریجنل ٹیکسٹ کو خوبصورت شکل میں لوگوں کے سامنے لانے کے۔" .

minaret:Segment_TQ2005-0315_0113 a minaret:TranscriptSegment ;
    minaret:endTime 1226.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0114 ;
    minaret:sequenceIndex 113 ;
    minaret:startTime 1216.8200000000002 ;
    minaret:text "اس کے بعد اب اس مرحلے پر جہاں ہم پہنچ چکے ہیں، اب اللہ تعالیٰ نے حفاظت دو طرح سے کی ہے آج کے دور میں بھی۔ ایک" .

minaret:Segment_TQ2005-0315_0114 a minaret:TranscriptSegment ;
    minaret:endTime 1237.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0115 ;
    minaret:sequenceIndex 114 ;
    minaret:startTime 1226.9 ;
    minaret:text "تو پرنٹنگ پریس کی ایجاد کی وجہ سے، اور خصوصاً جو مدینہ منورہ میں شاہ فہد کمپلیکس ہے جس میں قرآن پاک کی پرنٹنگ" .

minaret:Segment_TQ2005-0315_0115 a minaret:TranscriptSegment ;
    minaret:endTime 1243.0 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0116 ;
    minaret:sequenceIndex 115 ;
    minaret:startTime 1237.04 ;
    minaret:text "ہوتی ہے، وہاں سے کروڑوں کی تعداد میں قرآن پاک چھپ کے دنیا کے ہر علاقے میں" .

minaret:Segment_TQ2005-0315_0116 a minaret:TranscriptSegment ;
    minaret:endTime 1256.3799999999999 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0117 ;
    minaret:sequenceIndex 116 ;
    minaret:startTime 1243.7 ;
    minaret:text "لوگوں تک پہنچائے جا رہے ہیں، ایسے علاقے کہ جہاں کے لوگ خریدنے کی وہ سکت نہیں رکھتے تھے یا یہ کہ فیسلٹیز نہیں تھیں وہاں، پھر مختلف زبانوں میں اس کے تراجم وغیرہ بھی ساتھ ہو رہے ہیں۔" .

minaret:Segment_TQ2005-0315_0117 a minaret:TranscriptSegment ;
    minaret:endTime 1265.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0118 ;
    minaret:sequenceIndex 117 ;
    minaret:startTime 1257.02 ;
    minaret:text "یعنی پرنٹنگ پریس سے پہلے کس کس پہلو سے حفاظت ہوئی؟ اس کی ریڈنگ کی حفاظت ہوئی کہ جس لہجے پر آپ نے پڑھا اسی پر پڑھا جائے۔" .

minaret:Segment_TQ2005-0315_0118 a minaret:TranscriptSegment ;
    minaret:endTime 1276.14 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0119 ;
    minaret:sequenceIndex 118 ;
    minaret:startTime 1265.8400000000001 ;
    minaret:text "جیسا آپ نے لکھوایا وہ ٹیکسٹ محفوظ رہے۔ اس میں حسن تو پیدا کیا گیا لکھنے کے اعتبار سے، لیکن تبدیلی کوئی نہیں ہوئی۔ اور" .

minaret:Segment_TQ2005-0315_0119 a minaret:TranscriptSegment ;
    minaret:endTime 1289.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0120 ;
    minaret:sequenceIndex 119 ;
    minaret:startTime 1276.14 ;
    minaret:text "اب دوسرا طریقہ حفاظت کا: ایک تحریر، پرنٹنگ پریس، اور دوسرا ہے ریکارڈنگ۔ نہ صرف یہ کہ الفاظ محفوظ ہیں بلکہ ان کے پڑھنے کا انداز بھی محفوظ ہو گیا۔" .

minaret:Segment_TQ2005-0315_0120 a minaret:TranscriptSegment ;
    minaret:endTime 1298.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0121 ;
    minaret:sequenceIndex 120 ;
    minaret:startTime 1291.04 ;
    minaret:text "ایک زمانہ تھا کہ جو بھی آپ کے محلے میں امّی جی ہوں، پڑھانے والی ہوں، وہ جیسا پڑھا دیں، صرف وہ available تھیں۔" .

minaret:Segment_TQ2005-0315_0121 a minaret:TranscriptSegment ;
    minaret:endTime 1304.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0122 ;
    minaret:sequenceIndex 121 ;
    minaret:startTime 1299.42 ;
    minaret:text "تھا نا؟ اگر آپ لوگ اپنے بچپن کو دیکھیں تو آپ میں سے بہت سے لوگوں کے پاس سوائے اس امّی جی کے" .

minaret:Segment_TQ2005-0315_0122 a minaret:TranscriptSegment ;
    minaret:endTime 1319.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0123 ;
    minaret:sequenceIndex 122 ;
    minaret:startTime 1305.58 ;
    minaret:text "پڑھانے کا کوئی دوسرا ذریعہ نہیں تھا، ایسے ہی تھا نا؟ اور آپ انہی کے رحم و کرم پر تھے، وہ جس لہجے میں پڑھا دیں آپ کو، وہ چاہے اصل لہجے کے مطابق ہے یا نہیں، آپ نے بس وہی پڑھ لیا۔" .

minaret:Segment_TQ2005-0315_0123 a minaret:TranscriptSegment ;
    minaret:endTime 1330.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0124 ;
    minaret:sequenceIndex 123 ;
    minaret:startTime 1321.3600000000001 ;
    minaret:text "لیکن ریسنٹلی پچھلے چند سالوں میں جب سے ٹیکنالوجی نے اور زیادہ ترقی کی ہے، دنیا بھر میں بہترین قاریوں کی،" .

minaret:Segment_TQ2005-0315_0124 a minaret:TranscriptSegment ;
    minaret:endTime 1340.88 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0125 ;
    minaret:sequenceIndex 124 ;
    minaret:startTime 1330.84 ;
    minaret:text "جو بالکل درست پڑھتے ہیں، ان کی کیسٹس، سی ڈیز اور پھر اب تو آپ دیکھیں کہ انٹرنیٹ کے اوپر ایک لفظ بھی آپ کو تلاش کرنا ہے اور ایک" .

minaret:Segment_TQ2005-0315_0125 a minaret:TranscriptSegment ;
    minaret:endTime 1345.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0126 ;
    minaret:sequenceIndex 125 ;
    minaret:startTime 1340.88 ;
    minaret:text "لائن بھی آپ کو ڈھونڈنی ہے، تو اصل شکل میں آپ لمحوں کے اندر اس کو فائنڈ آؤٹ کر سکتے ہیں۔" .

minaret:Segment_TQ2005-0315_0140 a minaret:TranscriptSegment ;
    minaret:endTime 1500.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0141 ;
    minaret:sequenceIndex 140 ;
    minaret:startTime 1495.22 ;
    minaret:text "تو اس کے لیے آپ کو محنت کرنی ہے۔ اور آپ کا اب حصہ کیا ہے اس میں؟" .

minaret:Segment_TQ2005-0315_0141 a minaret:TranscriptSegment ;
    minaret:endTime 1511.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0142 ;
    minaret:sequenceIndex 141 ;
    minaret:startTime 1501.54 ;
    minaret:text "کہ نمبر ایک: آپ اس طرح پڑھیں گے اس کو کہ کوئی بھی آیت آپ کے سامنے آئے تو آپ اس کو سمجھیں کہ ہاں، اس کا مطلب یہ ہے،" .

minaret:Segment_TQ2005-0315_0142 a minaret:TranscriptSegment ;
    minaret:endTime 1526.18 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0143 ;
    minaret:sequenceIndex 142 ;
    minaret:startTime 1511.72 ;
    minaret:text "یہ آیت یہ کہتی ہے، کیونکہ اللہ کا کلام ہے، اللہ کی بات ہے۔ ٹھیک ہے، بہت لمبی چوڑی تفسیریں اور بہت لمبی چوڑی وضاحتیں نہ بھی ہوں، لیکن آیت دیکھتے ہی آپ فوراً اس کو اس طرح پہچان جائیں جیسے آپ اپنی کسی بھی پیاری چیز کو پہچان جاتے ہیں۔" .

minaret:Segment_TQ2005-0315_0143 a minaret:TranscriptSegment ;
    minaret:endTime 1535.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0144 ;
    minaret:sequenceIndex 143 ;
    minaret:startTime 1527.68 ;
    minaret:text "قرآن سے اگر ہمیں محبت ہے تو پھر اس کی بھی ہمیں ایسی ہی پہچان ہونی چاہیے، اور یہ کچھ مشکل نہیں، کوشش شرط ہے۔" .

minaret:Segment_TQ2005-0315_0144 a minaret:TranscriptSegment ;
    minaret:endTime 1539.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0145 ;
    minaret:sequenceIndex 144 ;
    minaret:startTime 1537.36 ;
    minaret:text "جہاد بالنفس کرنا پڑے گا۔" .

minaret:Segment_TQ2005-0315_0145 a minaret:TranscriptSegment ;
    minaret:endTime 1543.88 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0146 ;
    minaret:sequenceIndex 145 ;
    minaret:startTime 1540.98 ;
    minaret:text "اور یہی وہ چیز ہے جو آپ کو اللہ سے" .

minaret:Segment_TQ2005-0315_0146 a minaret:TranscriptSegment ;
    minaret:endTime 1548.7 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0147 ;
    minaret:sequenceIndex 146 ;
    minaret:startTime 1543.88 ;
    minaret:text "براہِ راست ملا دیتی ہے۔ اب دیکھیں، جس سے آپ کو محبت" .

minaret:Segment_TQ2005-0315_0147 a minaret:TranscriptSegment ;
    minaret:endTime 1560.46 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0148 ;
    minaret:sequenceIndex 147 ;
    minaret:startTime 1548.7 ;
    minaret:text "ہوتی ہے تو آپ کا کیا دل چاہتا ہے؟ کہ آپ اس کے ساتھ کس طرح کمیونیکیٹ کریں، کیسے بات کریں؟ کہ بیچ میں اور کوئی نہ ہو، کوئی بیریئر نہ ہو، رکاوٹ نہ ہو، ڈائریکٹ بات کریں۔" .

minaret:Segment_TQ2005-0315_0148 a minaret:TranscriptSegment ;
    minaret:endTime 1569.56 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0149 ;
    minaret:sequenceIndex 148 ;
    minaret:startTime 1560.96 ;
    minaret:text "تو اسی طرح اللہ تعالیٰ سے محبت کا تقاضا کیا ہے؟ کہ کیسے بات کریں اللہ سے؟ ہر چیز بیچ میں سے ہٹ جائے، ڈائریکٹ!" .

minaret:Segment_TQ2005-0315_0149 a minaret:TranscriptSegment ;
    minaret:endTime 1581.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0150 ;
    minaret:sequenceIndex 149 ;
    minaret:startTime 1571.5 ;
    minaret:text "چلیے، آج ہم سورۃ الفاتحہ ان شاء اللہ پڑھیں گے۔ طریقہ کار کچھ اس طرح ہوگا کہ سب سے پہلے لفظی ترجمہ،" .

minaret:Segment_TQ2005-0315_0150 a minaret:TranscriptSegment ;
    minaret:endTime 1594.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0151 ;
    minaret:sequenceIndex 150 ;
    minaret:startTime 1582.4 ;
    minaret:text "پھر لفظوں کا انالیسز، اور پھر اس کے بعد اس کی تفسیر، اور پھر ان شاء اللہ تفسیر سے متعلق عمل کی بات، وہ چیز جو ہم دوسروں سے شیئر کر سکیں۔" .

minaret:Segment_TQ2005-0315_0151 a minaret:TranscriptSegment ;
    minaret:endTime 1608.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0152 ;
    minaret:sequenceIndex 151 ;
    minaret:startTime 1596.1200000000001 ;
    minaret:text "قرآن پاک عربی زبان میں نازل ہوا۔ اردو بولنے اور پڑھنے والے اس لحاظ سے خوش قسمت ہیں کہ اردو میں بہت سے ایسے الفاظ پائے جاتے ہیں جو عربی ہی سے نکلے ہوئے ہیں۔" .

minaret:Segment_TQ2005-0315_0152 a minaret:TranscriptSegment ;
    minaret:endTime 1619.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0153 ;
    minaret:sequenceIndex 152 ;
    minaret:startTime 1609.52 ;
    minaret:text "پروفیسر عبدالجبار شاکر لکھتے ہیں کہ قرآن مجید کے 65 یعنی 65% الفاظ ہم اپنی روزمرہ اردو زبان میں استعمال" .

minaret:Segment_TQ2005-0315_0153 a minaret:TranscriptSegment ;
    minaret:endTime 1628.82 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0154 ;
    minaret:sequenceIndex 153 ;
    minaret:startTime 1619.52 ;
    minaret:text "کرتے ہیں، یعنی more than 50%، آدھے سے زیادہ قرآن پاک میں الفاظ وہ ہیں جو ہمیں پہلے سے ہی پتا ہیں،" .

minaret:Segment_TQ2005-0315_0154 a minaret:TranscriptSegment ;
    minaret:endTime 1640.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0155 ;
    minaret:sequenceIndex 154 ;
    minaret:startTime 1629.84 ;
    minaret:text "کیونکہ ہم ان کو اردو میں استعمال کرتے ہیں، 65%۔ 20% وہ الفاظ ہیں جو قرآن مجید میں بہت تکرار سے استعمال ہوئے، یعنی repetition ہے بہت ان کی۔" .

minaret:Segment_TQ2005-0315_0155 a minaret:TranscriptSegment ;
    minaret:endTime 1649.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0156 ;
    minaret:sequenceIndex 155 ;
    minaret:startTime 1641.48 ;
    minaret:text "ہیں عربی کے، لیکن قرآن پاک کے 20% الفاظ ایسے ہیں جن کے اندر بہت repetition ہے، بار بار استعمال ہوئے ہیں۔" .

minaret:Segment_TQ2005-0315_0156 a minaret:TranscriptSegment ;
    minaret:endTime 1661.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0157 ;
    minaret:sequenceIndex 156 ;
    minaret:startTime 1650.98 ;
    minaret:text "تو گویا اگر آپ ایک دفعہ جان لیں ان کا معنی، تو آپ کو ہر دفعہ جاننے کی ضرورت نہیں، آپ اس کو اپنے پچھلے یاد کیے ہوئے کو ذہن میں رکھ کے جان سکتے ہیں۔" .

minaret:Segment_TQ2005-0315_0157 a minaret:TranscriptSegment ;
    minaret:endTime 1671.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0158 ;
    minaret:sequenceIndex 157 ;
    minaret:startTime 1662.6399999999999 ;
    minaret:text "صرف پندرہ فیصد یعنی 15% ایسے ورڈز رہ جاتے ہیں جن پر غور و فکر اور تدبر کی ضرورت ہے۔" .

minaret:Segment_TQ2005-0315_0158 a minaret:TranscriptSegment ;
    minaret:endTime 1681.56 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0159 ;
    minaret:sequenceIndex 158 ;
    minaret:startTime 1672.54 ;
    minaret:text "اور اگر آپ غور کریں تو پھر آپ کا کام کتنا ہے؟ یعنی قرآن کے کتنے پرسنٹ پر آپ کو محنت کرنا ہے؟" .

minaret:Segment_TQ2005-0315_0159 a minaret:TranscriptSegment ;
    minaret:endTime 1697.08 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0160 ;
    minaret:sequenceIndex 159 ;
    minaret:startTime 1682.4199999999998 ;
    minaret:text "15%۔ اس لیے ہم دیکھتے ہیں کہ اردو سمجھنے والے یا بولنے والے لوگ جو ہیں، ان کے لیے قرآن کو ڈائریکٹ سمجھنا کچھ مشکل نہیں۔ اور ویسے بھی مشکل نہیں، کیوں؟ اس لیے کہ" .

minaret:Segment_TQ2005-0315_0162 a minaret:TranscriptSegment ;
    minaret:endTime 1715.98 ;
    minaret:sequenceIndex 162 ;
    minaret:startTime 1709.72 ;
    minaret:text "جو اس پر تھوڑی سی محنت کرے گا، وہ بہت بڑا خزانہ پا لے گا۔" .

minaret:Segment_TQ2005-0316_0000 a minaret:TranscriptSegment ;
    minaret:endTime 9.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0316_0001 ;
    minaret:sequenceIndex 0 ;
    minaret:startTime 0.0 ;
    minaret:text "تو سب سے پہلے ہم لفظی ترجمے کو دیکھیں گے۔ اَعُوْذُ بِاللّٰهِ مِنَ الشَّیْطَانِ الرَّجِیْمِ، بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ۔" .

minaret:Segment_TQ2005-0316_0004 a minaret:TranscriptSegment ;
    minaret:endTime 45.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0316_0005 ;
    minaret:sequenceIndex 4 ;
    minaret:startTime 36.92 ;
    minaret:text "«رَبِّ» جو رب ہے، «الْعٰلَمِیْنَ» تمام جہانوں کا، «الرَّحْمٰنِ» بہت مہربان ہے،" .

minaret:Segment_TQ2005-0317_0009 a minaret:TranscriptSegment ;
    minaret:endTime 99.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 89.48 ;
    minaret:text "سمجھے؟ اب یہاں پر آپ دیکھیے کہ «لِلّٰهِ»، لام کا معنی ہے «کے لیے»، اردو میں بھی استعمال ہوتا ہے جیسے «لہٰذا»۔" .

minaret:Segment_TQ2005-0317_0010 a minaret:TranscriptSegment ;
    minaret:endTime 106.94000000000001 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 101.04 ;
    minaret:text "یا «اَلْحَمْدُ لِلّٰهِ»، ہم اردو میں بھی «الحمد للہ» کا لفظ بولتے ہیں اور اس میں بھی اسی معنی میں بولتے ہیں۔" .

minaret:Segment_TQ2005-0317_0011 a minaret:TranscriptSegment ;
    minaret:endTime 121.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0012 ;
    minaret:sequenceIndex 11 ;
    minaret:startTime 108.22 ;
    minaret:text "«الْعٰلَمِیْنَ»، عالم کی جمع۔ عالمِ اسلام، عالمِ برزخ، عالمِ کفر، یہ سب بولتے ہیں۔ پھر اسی طرح «مٰلِكِ»، مالک کا لفظ اردو میں استعمال ہوتا ہے، ملکیت کا لفظ بھی اسی سے ہے۔" .

minaret:Segment_TQ2005-0317_0012 a minaret:TranscriptSegment ;
    minaret:endTime 131.4 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0013 ;
    minaret:sequenceIndex 12 ;
    minaret:startTime 122.12 ;
    minaret:text "«یَوْمِ»، دن کے لیے استعمال ہوتا ہے، یومِ آخرت، یوم، ایام، یومِ آزادی۔ پھر «نَعْبُدُ»، عبادت کا معنی،" .

minaret:Segment_TQ2005-0317_0013 a minaret:TranscriptSegment ;
    minaret:endTime 142.18 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0014 ;
    minaret:sequenceIndex 13 ;
    minaret:startTime 132.18 ;
    minaret:text "عبادت، عابد، معبود، یہ سب اردو میں لفظ استعمال ہوتے ہیں۔ «وَ»، جیسے دو لفظوں کے بیچ میں ہم بولتے ہیں جوڑنے کے لیے، شان و شوکت، نہیں کہتے شان" .

minaret:Segment_TQ2005-0317_0014 a minaret:TranscriptSegment ;
    minaret:endTime 152.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0015 ;
    minaret:sequenceIndex 14 ;
    minaret:startTime 142.18 ;
    minaret:text "و شوکت کہتے ہیں، لیکن اصل میں یہ وہی «وَ» ہے یعنی شان اور شوکت۔ «وَ» بمعنی «اور» کے ہے یہاں۔ «نَسْتَعِیْنُ»، ہم مدد چاہتے ہیں، استعانت" .

minaret:Segment_TQ2005-0317_0015 a minaret:TranscriptSegment ;
    minaret:endTime 163.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0016 ;
    minaret:sequenceIndex 15 ;
    minaret:startTime 152.2 ;
    minaret:text "کا لفظ، تعاون، معاون، معاونت، یہ اردو میں لفظ استعمال ہوتے ہیں۔ «اِهْدِنَا»، ہدایت، ہادیِ برحق۔ «الصِّرَاطَ»، راستہ، جیسے پل صراط کہتے ہیں ہم۔" .

minaret:Segment_TQ2005-0317_0016 a minaret:TranscriptSegment ;
    minaret:endTime 173.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0017 ;
    minaret:sequenceIndex 16 ;
    minaret:startTime 164.95999999999998 ;
    minaret:text "«الْمُسْتَقِیْمَ»، جیسے استقامت یا خطِ مستقیم۔ «اَنْعَمْتَ»، انعام، نعمت، منعم۔" .

minaret:Segment_TQ2005-0317_0017 a minaret:TranscriptSegment ;
    minaret:endTime 184.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0018 ;
    minaret:sequenceIndex 17 ;
    minaret:startTime 174.39999999999998 ;
    minaret:text "«عَلَیْهِمْ»، علیٰحدہ، علیٰ العموم، علیٰ الاعلان۔ «علیٰ» کا لفظ جو ہے، استعمال ہوتا ہے جڑ کر جیسے ان الفاظ میں۔ «الْمَغْضُوْبِ»،" .

minaret:Segment_TQ2005-0317_0018 a minaret:TranscriptSegment ;
    minaret:endTime 195.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0019 ;
    minaret:sequenceIndex 18 ;
    minaret:startTime 185.4 ;
    minaret:text "غضب، غضب ناک۔ «الضَّآلِّیْنَ»، ضلالت۔ ہم «ض» کو ہم «ظ» کے طور پر پڑھتے ہیں لیکن لفظ وہی اور معنی بھی وہی ہوتا ہے۔" .

minaret:Segment_TQ2005-0317_0019 a minaret:TranscriptSegment ;
    minaret:endTime 208.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0020 ;
    minaret:sequenceIndex 19 ;
    minaret:startTime 197.22 ;
    minaret:text "یہ تو تھی ایک مختصر سی پہچان۔ اور سورۃ الفاتحہ ایسی سورت ہے کہ جس کا معنی آپ میں سے ہر ایک کو کم و بیش سب کو آتا ہے۔ اب جب آپ سبق یاد کریں گے یا ترجمہ یاد کریں گے،" .

minaret:Segment_TQ2005-0317_0020 a minaret:TranscriptSegment ;
    minaret:endTime 215.72 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0021 ;
    minaret:sequenceIndex 20 ;
    minaret:startTime 209.26 ;
    minaret:text "تو آپ اپنے پاس ایک رولر رکھیں گے یا کوئی بھی ایسی چیز کہ جو" .

minaret:Segment_TQ2005-0317_0021 a minaret:TranscriptSegment ;
    minaret:endTime 227.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0022 ;
    minaret:sequenceIndex 21 ;
    minaret:startTime 216.71999999999997 ;
    minaret:text "ترجمے والے حصے کو ڈھانپ لے، اور آپ اپنے آپ کو خود ٹیسٹ کریں گے کہ آپ کو کیا سمجھ میں آیا۔ پہلے آپ دیکھ کر دو تین دفعہ پڑھ لیجیے اور اس کے بعد" .

minaret:Segment_TQ2005-0317_0022 a minaret:TranscriptSegment ;
    minaret:endTime 236.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 228.51999999999998 ;
    minaret:text "اردو ترجمے کو نیچے سے چھپا کے اپنا امتحان خود لیجیے کہ کتنے پرسنٹ آپ کو آیا، اور پھر ان شاء اللہ آپ سے گروپ میں سنا جائے گا۔" .

minaret:Segment_TQ2005-0317_0023 a minaret:TranscriptSegment ;
    minaret:endTime 248.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 238.18 ;
    minaret:text "گروپ میں آپ لفظی ترجمہ سنائیں گے، کس طرح؟ «بِ» ساتھ، «اسْمِ» نام، «اللّٰهِ» اللہ کے،" .

minaret:Segment_TQ2005-0317_0024 a minaret:TranscriptSegment ;
    minaret:endTime 259.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 249.60000000000002 ;
    minaret:text "«الرَّحْمٰنِ» جو بہت مہربان ہے، «الرَّحِیْمِ» بار بار رحم کرنے والا ہے۔ اس طرح آپ کو یاد ہونا چاہیے لفظ لفظ، لفظ کا" .

minaret:Segment_TQ2005-0317_0025 a minaret:TranscriptSegment ;
    minaret:endTime 269.62 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 259.42 ;
    minaret:text "ترجمہ، ٹھیک ہے؟ یوں نہیں آپ سنائیں گے: «بسم اللہ»، ساتھ اللہ کے نام کے۔ رواں نہیں سنانا آپ کو، کس طرح سنانا ہے؟ لفظ لفظ، لفظ کا ترجمہ سنانا ہے۔" .

minaret:Segment_TQ2005-0317_0026 a minaret:TranscriptSegment ;
    minaret:endTime 284.62 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 270.78000000000003 ;
    minaret:text "جب آپ کو لفظ لفظ آ جائے گا، حرف حرف آ جائے گا تو جملہ خود ہی جوڑ لیں گے آپ۔ یہ آپ اپنی ہوم ورک ڈائری میں الگ یہ انسٹرکشن لکھ لیں گے کہ آپ کو سنانا کیسے ہے، اور تمام انچارجز بھی غور سے سن رہے ہیں کہ انہوں نے سننا کیسے ہے،" .

minaret:Segment_TQ2005-0317_0027 a minaret:TranscriptSegment ;
    minaret:endTime 298.92 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 285.24 ;
    minaret:text "ٹھیک ہے؟ لفظی ترجمہ ہے نا، اس لیے کیسے سنائیں گے؟ لفظ لفظ۔ یہ لفظ لفظ، لفظ یاد رکھ لیجیے کہ مجھے ہر ہر لفظ کا انفرادی معنی آنا چاہیے۔" .

minaret:Segment_TQ2005-0317_0028 a minaret:TranscriptSegment ;
    minaret:endTime 306.22 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0029 ;
    minaret:sequenceIndex 28 ;
    minaret:startTime 299.79999999999995 ;
    minaret:text "جس کو لفظ آ گیا اس کو جملہ بھی آ جائے گا، اور اگر لفظ ہی نہیں پہچانا گیا تو جملہ کہاں سے پہچانا جائے گا؟" .

minaret:Segment_TQ2005-0317_0029 a minaret:TranscriptSegment ;
    minaret:endTime 314.94 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0030 ;
    minaret:sequenceIndex 29 ;
    minaret:startTime 307.58 ;
    minaret:text "اب یہ نہیں کہ آپ اس طرح رٹنا شروع کر دیں کہ یہ جو اس کے ساتھ مجھے یہ پڑھنا ہے۔ غور کریں گے کہ اس کا معنی کیا بنتا ہے، پھر سوچ کے پڑھیں گے،" .

minaret:Segment_TQ2005-0317_0030 a minaret:TranscriptSegment ;
    minaret:endTime 324.82 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0031 ;
    minaret:sequenceIndex 30 ;
    minaret:startTime 315.56 ;
    minaret:text "اور سمپل ٹیکسٹ سے پڑھیں گے۔ سب لوگ سادہ قرآن پاک اپنے ساتھ لائیں، ٹھیک ہے؟ کیوں؟ اس لیے کہ ہمارا گول کیا ہے؟" .

minaret:Segment_TQ2005-0317_0031 a minaret:TranscriptSegment ;
    minaret:endTime 335.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0032 ;
    minaret:sequenceIndex 31 ;
    minaret:startTime 325.4 ;
    minaret:text "کہ ہم کسی بھی ترجمے کے بغیر اس طرح دیکھ کے عبارت کو جان سکیں، یعنی پوری کی پوری بغیر نیچے دیکھے ہمیں سمجھ میں آنی چاہیے۔" .

minaret:Segment_TQ2005-0317_0032 a minaret:TranscriptSegment ;
    minaret:endTime 347.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0033 ;
    minaret:sequenceIndex 32 ;
    minaret:startTime 337.08 ;
    minaret:text "اب جیسے آپ دیکھیں نا یہ «بِ» ہے، تو آپ خود غور کیجیے کہ «بِ» کا کیا معنی ہے، «اسْمِ» کا کیا معنی ہے، «اللّٰهِ» کا کیا معنی ہے۔ اب آپ دیکھیں «اِیَّاكَ» دو دفعہ آیا ہے،" .

minaret:Segment_TQ2005-0317_0033 a minaret:TranscriptSegment ;
    minaret:endTime 361.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0034 ;
    minaret:sequenceIndex 33 ;
    minaret:startTime 349.1 ;
    minaret:text "اسی طرح «عَلَیْهِمْ» کا «ـهِمْ» دو دفعہ آیا ہے، «الَّذِیْنَ» یہاں آیا ہے پھر آگے بھی آپ دیکھیں گے اگلے سبق میں بھی «الَّذِیْنَ» دوبارہ آ رہا ہے، یعنی «الَّذِیْنَ» ان لفظوں میں سے ہے جو قرآن پاک میں بہت زیادہ ریپیٹ ہوا ہے۔" .

minaret:Segment_TQ2005-0317_0034 a minaret:TranscriptSegment ;
    minaret:endTime 365.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0035 ;
    minaret:sequenceIndex 34 ;
    minaret:startTime 362.46 ;
    minaret:text "«ـهِمْ» کا بھی لفظ، «نَا» کا بھی لفظ، «اِیَّاكَ» کا بھی۔" .

minaret:Segment_TQ2005-0317_0035 a minaret:TranscriptSegment ;
    minaret:endTime 372.62 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0036 ;
    minaret:sequenceIndex 35 ;
    minaret:startTime 366.76 ;
    minaret:text "«الْعٰلَمِیْنَ» میں آپ دیکھیں کہ یہ «ـیْنَ» کی وجہ سے جمع ہوا، ورنہ اگر یہ «ـیْنَ» ہٹا دیں تو کیا بنے گا؟" .

minaret:Segment_TQ2005-0317_0036 a minaret:TranscriptSegment ;
    minaret:endTime 381.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0037 ;
    minaret:sequenceIndex 36 ;
    minaret:startTime 373.82 ;
    minaret:text "«عَالَم»، عالم سنگولر ہے تو یہ «ـیْنَ» جمع کی علامت ہے۔ «عَالَمِیْنَ» ہونے کی وجہ سے تمام جہان ہو گئے۔ اسی طرح" .

minaret:Segment_TQ2005-0317_0037 a minaret:TranscriptSegment ;
    minaret:endTime 390.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0038 ;
    minaret:sequenceIndex 37 ;
    minaret:startTime 382.71999999999997 ;
    minaret:text "«نَعْبُدُ» میں آپ دیکھیں کہ «نـ» کا مطلب «ہم» ہے، باقی ع، ب، د جو ہے عبادت کے معنوں میں ہے۔ «ہم عبادت کرتے ہیں»، ٹھیک ہے؟" .

minaret:Segment_TQ2005-0317_0038 a minaret:TranscriptSegment ;
    minaret:endTime 396.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0039 ;
    minaret:sequenceIndex 38 ;
    minaret:startTime 391.64000000000004 ;
    minaret:text "پھر اسی طرح «اِهْدِنَا» میں بھی ن، ا «نَا» ہے، «نَا» کا معنی یہاں پر «ہمیں» ہو گا۔" .

minaret:Segment_TQ2005-0317_0039 a minaret:TranscriptSegment ;
    minaret:endTime 412.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0040 ;
    minaret:sequenceIndex 39 ;
    minaret:startTime 397.70000000000005 ;
    minaret:text "پھر اسی طرح «الَّذِیْنَ» بہت دفعہ ریپیٹ ہوتا ہے، «وہ لوگ، ان لوگوں کا» کے معنوں میں۔ پھر «اَنْعَمْتَ»، اگر آپ «تَ» کو ہٹا دیں تو «اَنْعَمَ» آپ دیکھیں کہ نعمت کے معنی میں آپ اکثر استعمال کرتے ہیں۔ «تَ» کا مطلب «تو» ہے۔" .

minaret:Segment_TQ2005-0317_0040 a minaret:TranscriptSegment ;
    minaret:endTime 424.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0041 ;
    minaret:sequenceIndex 40 ;
    minaret:startTime 413.42 ;
    minaret:text "«نَا» کا مطلب «ہم» ہے تو «تَ» کا مطلب «تم» ہے۔ پھر «عَلَیْهِمْ» ہے، «غَیْرِ»، «الْمَغْضُوْبِ عَلَیْهِمْ»، «وَ» اور، «لَا» نہیں،" .

minaret:Segment_TQ2005-0317_0041 a minaret:TranscriptSegment ;
    minaret:endTime 432.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0042 ;
    minaret:sequenceIndex 41 ;
    minaret:startTime 425.15999999999997 ;
    minaret:text "«الضَّآلِّیْنَ»، جو سب گمراہ ہوئے۔ تو hopefully اس پہ تھوڑا سا ٹائم آپ کو لگانا پڑے گا لیکن" .

minaret:Segment_TQ2005-0317_0042 a minaret:TranscriptSegment ;
    minaret:endTime 444.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0043 ;
    minaret:sequenceIndex 42 ;
    minaret:startTime 433.06 ;
    minaret:text "کہوں گی میں یہی کہ غور و فکر سیکھیں، خود معنی نکالنا سیکھیں اور چیزوں کو اپنی عقل سے جاننا سیکھیں۔ جو لکھا ہوا ہے اس پر depend کم کریں،" .

minaret:Segment_TQ2005-0317_0043 a minaret:TranscriptSegment ;
    minaret:endTime 456.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0044 ;
    minaret:sequenceIndex 43 ;
    minaret:startTime 445.22 ;
    minaret:text "اپنے حافظے پہ کریں، اپنی correction کریں، اپنے آپ کو خود درست کریں اس میں، ٹھیک ہے؟ اچھا، گروپ میں سنانے کے لیے آپ سادہ قرآن ساتھ رکھیے۔" .

minaret:Segment_TQ2005-0317_0044 a minaret:TranscriptSegment ;
    minaret:endTime 471.4 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0045 ;
    minaret:sequenceIndex 44 ;
    minaret:startTime 457.64000000000004 ;
    minaret:text "آپ کی چوائس ہے، آپ چاہیں اردو میں سنائیں، آپ چاہیں انگریزی میں سنائیں، لیکن انگلش والے انگلش گروپ میں ہی پھر بیٹھیں گے۔ جو لوگ اردو گروپ جوائن کیے ہوئے ہیں وہ اردو میں ہی ترجمہ سنائیں گے، جو انگلش گروپ جوائن کیے ہوئے ہیں وہ انگلش میں سنائیں گے،" .

minaret:Segment_TQ2005-0317_0045 a minaret:TranscriptSegment ;
    minaret:endTime 481.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0046 ;
    minaret:sequenceIndex 45 ;
    minaret:startTime 472.18 ;
    minaret:text "ٹھیک ہے؟ کیونکہ ہماری primary language یہاں اردو ہے تو اس لیے instructions ساری اردو میں ہوں گی، مگر ہمت کی داد دیتی ہوں ان لوگوں کو جو انگریزی میں یاد کریں گے اور لکھیں گے۔" .

minaret:Segment_TQ2005-0317_0046 a minaret:TranscriptSegment ;
    minaret:endTime 490.64000000000004 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0047 ;
    minaret:sequenceIndex 46 ;
    minaret:startTime 481.88 ;
    minaret:text "پچھلے دس سال سے الحمدللہ ایسی بہت سی مثالیں موجود ہیں، حتیٰ کہ ہماری ایک بچی آذربائیجان سے آئی تھی، نہ انگلش آتی تھی نہ عربی آتی تھی نہ اردو آتی تھی۔" .

minaret:Segment_TQ2005-0317_0047 a minaret:TranscriptSegment ;
    minaret:endTime 499.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0048 ;
    minaret:sequenceIndex 47 ;
    minaret:startTime 491.56 ;
    minaret:text "قرآن ایسا معجزہ ہے کہ تھوڑے ہی عرصے میں اس نے پہلے تھوڑی سی انگلش کی شد بد کی، پھر اس کے بعد عربی پڑھنا شروع کیا،" .

minaret:Segment_TQ2005-0317_0048 a minaret:TranscriptSegment ;
    minaret:endTime 513.7 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0049 ;
    minaret:sequenceIndex 48 ;
    minaret:startTime 500.64 ;
    minaret:text "کچھ اردو بھی ساتھیوں سے، ہاسٹل میں رہتی تھی، سیکھ لی۔ اور مجھے یاد ہے کہ پہلے دن کی کلاس تھی تو میں نے اس کو بٹھا دیا ایک اپنے سٹوڈنٹ کے ساتھ جو اس سے پچھلے بیچ سے انگلش میں کر چکی تھی، تو میں نے کہا کہ آپ لکھو" .

minaret:Segment_TQ2005-0317_0049 a minaret:TranscriptSegment ;
    minaret:endTime 524.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0050 ;
    minaret:sequenceIndex 49 ;
    minaret:startTime 514.2 ;
    minaret:text "اور یہ ساتھ بیٹھ کے صرف تمہارا لکھا ہوا پڑھتی جائے۔ تو وہ لکھتی جاتی تھی اور وہ صرف سنتی تھی میرے منہ سے، پھر وہاں دیکھتی تھی، پھر سنتی تھی، پھر ادھر دیکھتی تھی، سنتی پھر دیکھتی۔" .

minaret:Segment_TQ2005-0317_0050 a minaret:TranscriptSegment ;
    minaret:endTime 532.16 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0051 ;
    minaret:sequenceIndex 50 ;
    minaret:startTime 524.5799999999999 ;
    minaret:text "اور آپ کو پتا ہے کہ قرآن ختم ہونے سے پہلے اس نے اپنی زبان میں سورۃ البقرہ کی ٹرانسلیشن اور تفسیر بھی کر لی تھی! اتنی محنتی لڑکی تھی۔" .

minaret:Segment_TQ2005-0317_0051 a minaret:TranscriptSegment ;
    minaret:endTime 544.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0052 ;
    minaret:sequenceIndex 51 ;
    minaret:startTime 533.14 ;
    minaret:text "اصل بات ہے شوق اور نیت اور جذبے کی کہ آپ کرنے والے بنیں، اور یہ قرآن تو معجزہ ہے۔ ان پڑھ لوگوں کو عربی پڑھنا آ جاتی ہے تو پڑھے لکھے لوگوں کو کیسے نہیں آ سکتا؟" .

minaret:Segment_TQ2005-0317_0052 a minaret:TranscriptSegment ;
    minaret:endTime 555.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0053 ;
    minaret:sequenceIndex 52 ;
    minaret:startTime 545.48 ;
    minaret:text "اور پھر اس نے سورۃ یٰس حفظ کی تھی، یعنی یہاں تک اس کو قرآن عربی میں پڑھنا آ گیا الحمدللہ، قراءت اتنی اچھی کرنا شروع کر دی۔ بہرحال،" .

minaret:Segment_TQ2005-0317_0053 a minaret:TranscriptSegment ;
    minaret:endTime 566.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0054 ;
    minaret:sequenceIndex 53 ;
    minaret:startTime 555.8599999999999 ;
    minaret:text "تو مشکل کچھ نہیں ہے۔ اپنے آپ سے سوال کیجیے، آپ کی نیت ہے؟ جب تک آپ کی نیت خالص نہیں ہو گی، آپ کے اندر پکا ارادہ نہیں ہو گا تو اللہ راستے نہیں کھولتا۔" .

minaret:Segment_TQ2005-0317_0054 a minaret:TranscriptSegment ;
    minaret:endTime 574.94 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0055 ;
    minaret:sequenceIndex 54 ;
    minaret:startTime 567.06 ;
    minaret:text "راستے اس سے کھلتے ہیں جب آپ کے اندر سے تڑپ اٹھتی ہے کہ یہ مجھے کر کے چھوڑنا ہے، یہ میرے لیے چیلنج ہے اور میں نے کر کے چھوڑنا ہے، اور پھر اللہ کو آپ پکارتے ہیں۔" .

minaret:Segment_TQ2005-0317_0055 a minaret:TranscriptSegment ;
    minaret:endTime 584.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0056 ;
    minaret:sequenceIndex 55 ;
    minaret:startTime 575.6 ;
    minaret:text "اللہ کے بھروسے پہ آپ شروع کرتے ہیں اور اللہ تعالیٰ آسان کر دیتا ہے۔ یقین مانیے، 70 پلس، 80 پلس، ٹین ایجرز، سب نے پڑھا ہے،" .

minaret:Segment_TQ2005-0317_0056 a minaret:TranscriptSegment ;
    minaret:endTime 594.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0057 ;
    minaret:sequenceIndex 56 ;
    minaret:startTime 585.16 ;
    minaret:text "ہر ایج گروپ میں سے لوگوں نے پڑھا ہے اور الحمدللہ سب کر گئے! ٹھیک ہے کچھ لوگ بیمار ہوئے، نہیں کر سکے پورا، مگر کر لیا لوگوں نے۔ بس آپ ارادہ کر لیں۔" .

minaret:Segment_TQ2005-0317_0057 a minaret:TranscriptSegment ;
    minaret:endTime 602.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0058 ;
    minaret:sequenceIndex 57 ;
    minaret:startTime 595.24 ;
    minaret:text "اگر آپ کا ارادہ اور کوشش ہو تو اللہ کی مدد بھی اسی حساب سے آئے گی ان شاء اللہ، اور کچھ مشکل مشکل نہیں رہے گی۔" .

minaret:Segment_TQ2005-0317_0058 a minaret:TranscriptSegment ;
    minaret:endTime 616.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 603.4 ;
    minaret:text "بہرحال، اب ایک مشکل جو آپ کو ہو سکتی ہے وہ یہ ہے کہ کل جب آپ کو کہا جائے کہ جی آپ پلین ٹیکسٹ میں قرآن پاک اپنے ساتھ لائیں، سبق سنا جائے گا یا بیچ میں پوچھا جائے گا، تو اب آپ کے لیے رکاوٹ ہو سکتی ہے کہ ہمیں تو چھونا ہی نہیں قرآن،" .

minaret:Segment_TQ2005-0317_0059 a minaret:TranscriptSegment ;
    minaret:endTime 627.08 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0060 ;
    minaret:sequenceIndex 59 ;
    minaret:startTime 617.26 ;
    minaret:text "اٹھانا ہی نہیں۔ اب ہم کیا کریں؟ تو اس کے لیے یہ ابن باز کا فتویٰ میں آپ کو پڑھ کے سنا دیتی ہوں کہ کیا آپ کے لیے" .

minaret:Segment_TQ2005-0317_0060 a minaret:TranscriptSegment ;
    minaret:endTime 640.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0061 ;
    minaret:sequenceIndex 60 ;
    minaret:startTime 627.08 ;
    minaret:text "جائز ہے پیریڈز کی حالت میں قرآن کو اٹھا کر سبق یاد کرنا یا نہیں؟ کیونکہ اگر آٹھ آٹھ، دس دس دن آپ نے قرآن کو ہاتھ ہی نہیں لگایا تو پھر تو کیا بنے گا؟ سبق نہیں یاد ہو گا۔" .

minaret:Segment_TQ2005-0317_0061 a minaret:TranscriptSegment ;
    minaret:endTime 655.34 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0062 ;
    minaret:sequenceIndex 61 ;
    minaret:startTime 641.34 ;
    minaret:text "اب اس کے لیے کرنا کیا ہے؟ پہلے تو فتویٰ پڑھ لیتے ہیں، پھر اگر اس میں سے کوئی چیز سمجھ نہ آئی تو اس کو ایکسپلین کر دیں گے۔ ابن باز سے کسی نے سوال کیا تھا کہ ہم گرلز کالج کی طالبات کے لیے قرآنِ کریم کا ایک پارہ حفظ کرنا ضروری ہے،" .

minaret:Segment_TQ2005-0317_0062 a minaret:TranscriptSegment ;
    minaret:endTime 669.08 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0063 ;
    minaret:sequenceIndex 62 ;
    minaret:startTime 655.9599999999999 ;
    minaret:text "کالج میں ان کے نصاب کا حصہ ہے، آپ کا بھی ہے۔ کبھی کبھی امتحان کا وقت پیریڈز کے دنوں میں آ جاتا ہے، یعنی مینسیز کے دنوں میں، تو کیا یہ جائز ہے کہ قرآن کی سورت کاغذ پر لکھ کر یاد کر لی جائے؟" .

minaret:Segment_TQ2005-0317_0063 a minaret:TranscriptSegment ;
    minaret:endTime 675.0 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0064 ;
    minaret:sequenceIndex 63 ;
    minaret:startTime 669.08 ;
    minaret:text "تو شیخ ابن باز فرماتے ہیں کہ ہاں، بغیر" .

minaret:Segment_TQ2005-0317_0064 a minaret:TranscriptSegment ;
    minaret:endTime 683.44 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0065 ;
    minaret:sequenceIndex 64 ;
    minaret:startTime 675.0 ;
    minaret:text "مصحف چھوئے قرآن پڑھنا جائز ہے، اس لیے کہ عدمِ جواز یعنی جائز نہ ہونے کی کوئی دلیل ثابت نہیں۔" .

minaret:Segment_TQ2005-0317_0065 a minaret:TranscriptSegment ;
    minaret:endTime 694.72 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0066 ;
    minaret:sequenceIndex 65 ;
    minaret:startTime 684.44 ;
    minaret:text "دونوں قسم کی عورتیں کسی پاک کپڑے کے ذریعے قرآن کو پکڑ سکتی ہیں۔ تو کپڑے میں اگر مشکل ہو تو یہ جو میڈیکل گلوز ہوتے ہیں، سرجیکل جو" .

minaret:Segment_TQ2005-0317_0066 a minaret:TranscriptSegment ;
    minaret:endTime 704.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0067 ;
    minaret:sequenceIndex 66 ;
    minaret:startTime 694.72 ;
    minaret:text "استعمال میں ہوتے ہیں ربڑ کے، اس سے صفحہ پلٹنا بھی بہت آسان ہوتا ہے، تھن بھی ہوتا ہے تو آپ کلاس میں بھی رائٹ ہینڈ پر اس کو آپ" .

minaret:Segment_TQ2005-0317_0067 a minaret:TranscriptSegment ;
    minaret:endTime 714.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0068 ;
    minaret:sequenceIndex 67 ;
    minaret:startTime 704.58 ;
    minaret:text "پہن کے لکھ سکتے ہیں اگر کوئی حرف نیچے بھی آ گیا لکھا ہوا یا کچھ، اور اسی طرح جب آپ یاد کر رہے ہوں گے یا سنا رہے ہوں گے یا سن رہے ہوں گے تو اس کے ذریعے سہولت کے ساتھ" .

minaret:Segment_TQ2005-0317_0068 a minaret:TranscriptSegment ;
    minaret:endTime 722.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0069 ;
    minaret:sequenceIndex 68 ;
    minaret:startTime 714.54 ;
    minaret:text "آپ مصحف کو اٹھا کے اپنا کام کر سکتے ہیں، سبق یاد بھی کر سکتے ہیں، سن بھی سکتے ہیں، سنا بھی سکتے ہیں اور لکھ بھی سکتے ہیں۔" .

minaret:Segment_TQ2005-0317_0069 a minaret:TranscriptSegment ;
    minaret:endTime 730.94 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0070 ;
    minaret:sequenceIndex 69 ;
    minaret:startTime 722.38 ;
    minaret:text "مصحف قرآن کو کہتے ہیں۔ یعنی ڈائریکٹ آپ کا ہاتھ عربی ٹیکسٹ کو نہیں چھونا چاہیے، بیچ میں کپڑا ہو، یا ٹشو پیپر ہو، یا" .

minaret:Segment_TQ2005-0317_0070 a minaret:TranscriptSegment ;
    minaret:endTime 741.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0071 ;
    minaret:sequenceIndex 70 ;
    minaret:startTime 730.94 ;
    minaret:text "گلوز ہوں یا کچھ بھی، تو کپڑے کے گلوز یا اور گلوز وغیرہ جو ہوتے ہیں وہ مشکل کرتے ہیں۔ سب سے آسان گلوز جو ہیں وہ یہ باریک قسم کا جو ربڑ کا گلو ہے وہ بہتر ہے۔" .

minaret:Segment_TQ2005-0317_0071 a minaret:TranscriptSegment ;
    minaret:endTime 752.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0072 ;
    minaret:sequenceIndex 71 ;
    minaret:startTime 742.6800000000001 ;
    minaret:text "اس طرح کاغذ پر لکھ کر ضرورت کے وقت اس کی مدد سے پڑھا جا سکتا ہے۔ البتہ جُنبی قرآن نہیں پڑھے گا، یعنی حالتِ جنابت میں نہیں، یہاں تک کہ غسل کر لیں، اس لیے کہ صحیح حدیث عدمِ" .

minaret:Segment_TQ2005-0317_0072 a minaret:TranscriptSegment ;
    minaret:endTime 760.94 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0073 ;
    minaret:sequenceIndex 72 ;
    minaret:startTime 752.74 ;
    minaret:text "جواز پر دلالت کرتی ہے۔ حائضہ اور نفاس والی عورتوں کو جُنبی پر قیاس نہیں کیا جا سکتا، دونوں حالتیں فرق ہیں، اس لیے کہ ان کی مدت طویل ہوتی ہے،" .

minaret:Segment_TQ2005-0317_0073 a minaret:TranscriptSegment ;
    minaret:endTime 766.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0074 ;
    minaret:sequenceIndex 73 ;
    minaret:startTime 761.54 ;
    minaret:text "لیکن جُنبی تو جنابت کے سبب سے فارغ ہوتے ہی فوراً غسل کر سکتا ہے، ٹھیک ہے؟" .

minaret:Segment_TQ2005-0317_0075 a minaret:TranscriptSegment ;
    minaret:endTime 790.82 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0076 ;
    minaret:sequenceIndex 75 ;
    minaret:startTime 780.64 ;
    minaret:text "کوئی صحیح حدیث ایسی نہیں کہ جس میں عورت کو قرآن کی تعلیم حاصل کرنے سے ان دنوں میں روکا گیا ہو، پڑھنے یا پڑھانے یا سیکھنے یا سکھانے سے، ٹھیک" .

minaret:Segment_TQ2005-0317_0076 a minaret:TranscriptSegment ;
    minaret:endTime 800.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0077 ;
    minaret:sequenceIndex 76 ;
    minaret:startTime 790.82 ;
    minaret:text "ہے؟ اور یہ میرا فتویٰ نہیں ہے، یہ نیچے لکھا ہوا ہے: فتاویٰ از علامہ عبدالعزیز بن عبداللہ بن باز، مفتیِ عام مملکتِ سعودی عرب۔ کتاب" .

minaret:Segment_TQ2005-0317_0077 a minaret:TranscriptSegment ;
    minaret:endTime 807.08 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0078 ;
    minaret:sequenceIndex 77 ;
    minaret:startTime 800.84 ;
    minaret:text "چھپی ہوئی ہے، اس کے پیج 73 اور 79 پہ ہے، اگر اس کی انگلش ٹرانسلیشن ہے تو انگلش میں بھی یہ فتویٰ موجود ہو گا۔" .

minaret:Segment_TQ2005-0317_0078 a minaret:TranscriptSegment ;
    minaret:endTime 817.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0079 ;
    minaret:sequenceIndex 78 ;
    minaret:startTime 808.02 ;
    minaret:text "تو یہ اپنے پاس رکھیے، جب کوئی اعتراض کرے آپ پر تو آپ یہ بتا دیجیے، ٹھیک ہے؟ اور اپنے آپ کو بھی اطمینان سے سیکھنے سکھانے کے عمل میں مصروف رکھیے۔" .

minaret:Segment_TQ2005-0317_0079 a minaret:TranscriptSegment ;
    minaret:endTime 824.26 ;
    minaret:sequenceIndex 79 ;
    minaret:startTime 817.6 ;
    minaret:text "اچھا، یہ ہماری انٹرنیٹ کی سائٹ پر بھی موجود ہے فتویٰ: «حالتِ حیض میں تلاوتِ قرآنِ پاک»، ٹھیک ہے؟" .

minaret:Segment_TQ2005-0318_0001 a minaret:TranscriptSegment ;
    minaret:endTime 21.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0002 ;
    minaret:sequenceIndex 1 ;
    minaret:startTime 11.46 ;
    minaret:text "سمجھیں گے، تاکہ ہم پھر جملہ سمجھیں اور پھر عبارت سمجھیں اور اس کے مفہوم کو جانیں، ٹھیک ہے؟" .

minaret:Segment_TQ2005-0318_0003 a minaret:TranscriptSegment ;
    minaret:endTime 42.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0004 ;
    minaret:sequenceIndex 3 ;
    minaret:startTime 36.04 ;
    minaret:text "جن میں سے سب سے پہلے «ب» کا یہاں پر حرف آیا ہے۔ «ب» کا معنی ہوتا ہے" .

minaret:Segment_TQ2005-0318_0004 a minaret:TranscriptSegment ;
    minaret:endTime 54.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0005 ;
    minaret:sequenceIndex 4 ;
    minaret:startTime 44.14 ;
    minaret:text "«ساتھ»۔ «اسْمِ»: مشہور لفظ ہے اردو میں بھی، اسم نام کے لیے استعمال ہوتا ہے جس سے کسی چیز کی ذات معلوم کی جا سکے۔ نام،" .

minaret:Segment_TQ2005-0318_0005 a minaret:TranscriptSegment ;
    minaret:endTime 64.36 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 55.66 ;
    minaret:text "نام کیا ہوتا ہے؟ جس سے کسی چیز کی ذات کا پتا چلے، یعنی اس کی نیچر کا پتا چلے ہمیں کہ یہ کیا چیز ہے۔" .

minaret:Segment_TQ2005-0318_0006 a minaret:TranscriptSegment ;
    minaret:endTime 75.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 65.64 ;
    minaret:text "مثلاً اس میز پر جو بھی آپ کے سامنے چیزیں رکھی ہوئی ہیں، ان سب کا کوئی نہ کوئی نام ہے، ٹھیک ہے نا؟ کاغذ، قلم، کتاب، گلاس۔" .

minaret:Segment_TQ2005-0318_0007 a minaret:TranscriptSegment ;
    minaret:endTime 86.8 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 76.44 ;
    minaret:text "تو یہ کتاب کیا ہے؟ نام ہے، کس کا؟ اس چیز کا۔ اور اس ورڈ کے ذہن میں آتے ہی ہمارے ذہن میں ایک خاص چیز کی پکچر بن جاتی ہے۔" .

minaret:Segment_TQ2005-0318_0008 a minaret:TranscriptSegment ;
    minaret:endTime 98.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 88.0 ;
    minaret:text "اسم کا جو روٹ ہے عربی میں س، م، و ہے۔ «اللّٰهِ» کا لفظ معلوم ہے آپ سب کو، ء، ل، ہ روٹ ہے۔ «الرَّحْمٰنِ»:" .

minaret:Segment_TQ2005-0318_0009 a minaret:TranscriptSegment ;
    minaret:endTime 107.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 99.06 ;
    minaret:text "فعلان کے وزن پر مبالغے کا صیغہ ہے۔ کچھ باتیں شاید آپ کو مشکل لگیں تو لکھ چھوڑیے، نہ بھی سمجھ آئیں، آنے لگیں گی سمجھ۔" .

minaret:Segment_TQ2005-0318_0010 a minaret:TranscriptSegment ;
    minaret:endTime 118.88 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 109.08 ;
    minaret:text "رحمٰن کا روٹ ر، ح، م ہے، رحم سے ہے۔ لطف اور کرم کا معنی اس میں پایا جاتا ہے اور رحمٰن میں بہت زیادہ مبالغہ ہے،" .

minaret:Segment_TQ2005-0318_0011 a minaret:TranscriptSegment ;
    minaret:endTime 130.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0012 ;
    minaret:sequenceIndex 11 ;
    minaret:startTime 119.38 ;
    minaret:text "بہت زیادہ رحم کرنے والا۔ «الرَّحِیْمِ» کا لفظ بھی اسی روٹ سے ہے، اس کا بھی روٹ ر، ح، م ہے، ر، ح، م، رحم، بہت زیادہ رحم فرمانے والا۔" .

minaret:Segment_TQ2005-0318_0012 a minaret:TranscriptSegment ;
    minaret:endTime 139.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0013 ;
    minaret:sequenceIndex 12 ;
    minaret:startTime 131.58 ;
    minaret:text "پھر سورۃ الفاتحہ: سورت کہتے ہیں کسی چیز کے ٹکڑے اور حصے کو، س، و، ر اس کا روٹ ہے۔" .

minaret:Segment_TQ2005-0318_0013 a minaret:TranscriptSegment ;
    minaret:endTime 149.82 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0014 ;
    minaret:sequenceIndex 13 ;
    minaret:startTime 141.32 ;
    minaret:text "الفاتحہ کا روٹ ہے ف، ت، ح، فتح سے۔ فتح کا معنی ہوتا ہے کسی چیز کی بندش کو دور کرنا، کھولنا۔" .

minaret:Segment_TQ2005-0318_0014 a minaret:TranscriptSegment ;
    minaret:endTime 160.24 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0015 ;
    minaret:sequenceIndex 14 ;
    minaret:startTime 151.24 ;
    minaret:text "اور سورت کا نام ہے، یعنی قرآن کھلتا ہے اس سے، قرآن کی ابتدا ہوتی ہے۔ اس سورت کے اور بھی کئی نام ہیں جیسے ام الکتاب، ام القرآن،" .

minaret:Segment_TQ2005-0318_0015 a minaret:TranscriptSegment ;
    minaret:endTime 174.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0016 ;
    minaret:sequenceIndex 15 ;
    minaret:startTime 161.12 ;
    minaret:text "سورۃ الحمد، الشفاء، الکنز۔ پھر ہے «اَلْحَمْدُ»: حَمِدَ يَحْمَدُ سے، حمد تعریف کرنے کو کہتے ہیں، کسی کے اچھے اوصاف بیان کرنا۔" .

minaret:Segment_TQ2005-0318_0016 a minaret:TranscriptSegment ;
    minaret:endTime 186.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0017 ;
    minaret:sequenceIndex 16 ;
    minaret:startTime 176.34 ;
    minaret:text "بنیادی طور پر حمد ایک لطیف احساس ہے جو دل میں اٹھتا ہے۔ حمد کیا ہے؟ ایک لطیف سا احساس ہے" .

minaret:Segment_TQ2005-0318_0017 a minaret:TranscriptSegment ;
    minaret:endTime 199.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0018 ;
    minaret:sequenceIndex 17 ;
    minaret:startTime 187.12 ;
    minaret:text "جو انسان کے اندر سے اٹھتا ہے، اللہ کی تعریف اور اس کے شکر کے لیے۔ اب آپ دیکھیں کہ ہر طرف تو اللہ ہی کی بنائی ہوئی چیزیں ہیں تو پھر ساری تعریفیں اسی کی ہوں گی نا؟" .

minaret:Segment_TQ2005-0318_0018 a minaret:TranscriptSegment ;
    minaret:endTime 207.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0019 ;
    minaret:sequenceIndex 18 ;
    minaret:startTime 200.38 ;
    minaret:text "اسی کی ہو جائیں گی نا جب ہر چیز اس کی ہے۔ کسی انسان کی بھی جب آپ تعریف کرتے ہیں تو اس کو کس نے بنایا ہے؟" .

minaret:Segment_TQ2005-0318_0019 a minaret:TranscriptSegment ;
    minaret:endTime 218.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0020 ;
    minaret:sequenceIndex 19 ;
    minaret:startTime 208.92 ;
    minaret:text "کسی کی خوبصورت آنکھیں آپ کو دکھیں، کسی کی شکل، کسی کا رنگ، کسی کا کچھ۔ عموماً چھوٹے بچوں کو جب دیکھتے ہیں نا، نیو بارن بیبیز کو دیکھ کے تو سب کے اندر ایک تھرل آتی ہے نا؟" .

minaret:Segment_TQ2005-0318_0020 a minaret:TranscriptSegment ;
    minaret:endTime 228.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0021 ;
    minaret:sequenceIndex 20 ;
    minaret:startTime 218.86 ;
    minaret:text "اور اس وقت ہر کوئی حیران ہوتا ہے: یا رب! یہ ماں کے پیٹ سے کیا چیز برآمد ہوئی! یہ کس نے بنایا ہے، یہ کیسے بنایا ہے؟ کبھی آپ ہاتھوں کو دیکھتے ہیں، کبھی انگلیاں دیکھتے ہیں، کبھی ناخن دیکھتے ہیں، کبھی بال" .

minaret:Segment_TQ2005-0318_0021 a minaret:TranscriptSegment ;
    minaret:endTime 239.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0022 ;
    minaret:sequenceIndex 21 ;
    minaret:startTime 228.76 ;
    minaret:text "دیکھتے ہیں، کبھی کچھ دیکھتے ہیں، کبھی کچھ دیکھتے ہیں۔ وہ منہ کھولتا ہے زبان دیکھتے ہیں، آنکھ کھولتا ہے تو کہتے ہیں آنکھ کھول دی! حالانکہ آپ کے آس پاس بہت سے لوگ آنکھیں کھولے ہیں مگر ان کی کھلی آنکھیں آپ کے اندر تھرل نہیں پیدا کرتیں۔" .

minaret:Segment_TQ2005-0318_0022 a minaret:TranscriptSegment ;
    minaret:endTime 252.18 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 241.18 ;
    minaret:text "ایک دفعہ میں اپنی آئی سائٹ چیک کرانے کے لیے کسی کلینک میں گئی تو وہاں اتنی بڑی آنکھ کی تصویر لگی تھی، میں نے رونا شروع کر دیا اس کو دیکھ کے! میں نے کہا کہ یا رب! یہ بنایا ہے تو نے ہمارے لیے؟" .

minaret:Segment_TQ2005-0318_0023 a minaret:TranscriptSegment ;
    minaret:endTime 258.46 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 252.74 ;
    minaret:text "یہ کس طرح کام کرتی ہے آنکھ؟ اور یہ سب کیا ہے؟ ایک عجیب کیفیت دل میں آئی،" .

minaret:Segment_TQ2005-0318_0024 a minaret:TranscriptSegment ;
    minaret:endTime 268.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 258.96 ;
    minaret:text "اور اللہ کی وہ عظمت کا احساس جو عام طور پر آنکھ دیکھ کے کبھی نہیں خیال آیا، نہ اپنی آنکھوں کا خیال کرتے۔ تو جب کبھی بھی آپ کو اللہ کی کوئی عظمت یا قدرت یا تخلیق" .

minaret:Segment_TQ2005-0318_0025 a minaret:TranscriptSegment ;
    minaret:endTime 276.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 268.96 ;
    minaret:text "سمجھ آئے، نظر آئے، محسوس ہو، اس کے بعد جو آپ کے دل سے نکلے، جو آپ کے منہ سے نکلے، جو شکر آئے،" .

minaret:Segment_TQ2005-0318_0026 a minaret:TranscriptSegment ;
    minaret:endTime 287.16 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 277.06 ;
    minaret:text "یہی حمد ہے اور یہ ساری اللہ ہی کے لیے ہے، کیونکہ ہر چیز، اگر کسی انسان کے اندر کوئی خوبی ہے نا تو وہ بھی اس کی اپنی ذاتی نہیں ہے، وہ اس کی دی ہوئی ہے۔" .

minaret:Segment_TQ2005-0318_0027 a minaret:TranscriptSegment ;
    minaret:endTime 297.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 287.16 ;
    minaret:text "اگر کوئی انسان خوبصورت ہے تو وہ اس کا کیا کمال ہے؟ وہ تو اس نے بنایا ہے نا، تو تعریف تو ادھر ہی جاتی ہے نا، اصل کے اوپر لوٹتی ہے نا، کمال تو اس کا ہے۔" .

minaret:Segment_TQ2005-0318_0028 a minaret:TranscriptSegment ;
    minaret:endTime 307.92 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0029 ;
    minaret:sequenceIndex 28 ;
    minaret:startTime 299.28 ;
    minaret:text "تو الحمد للہ، حمد جو ہوتا ہے نا ایک ایکسپیرینس ہوتا ہے بیسیکلی، انر ایکسپیرینس۔ تو یہ ہے" .

minaret:Segment_TQ2005-0318_0030 a minaret:TranscriptSegment ;
    minaret:endTime 332.44 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0031 ;
    minaret:sequenceIndex 30 ;
    minaret:startTime 319.6 ;
    minaret:text "آہستہ آہستہ ذرے سے کمال تک پہنچانے والا۔ پالنا محدود معنی میں ہو جاتا ہے، اگر ہم کہیں نا پالنے والا تو وہ ایک limited معنی دیتا ہے، یعنی آپ کہہ سکتے ہیں پرورش کرنے والا۔" .

minaret:Segment_TQ2005-0318_0031 a minaret:TranscriptSegment ;
    minaret:endTime 343.0 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0032 ;
    minaret:sequenceIndex 31 ;
    minaret:startTime 333.08 ;
    minaret:text "پرورش کرنے والا، پالنے والا۔ لیکن اس میں کیا چیز ہے؟ آہستہ آہستہ عدم سے چیز کو وجود میں لانا، چھوٹے سے بڑا کرنا، جیسے" .

minaret:Segment_TQ2005-0318_0032 a minaret:TranscriptSegment ;
    minaret:endTime 356.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0033 ;
    minaret:sequenceIndex 32 ;
    minaret:startTime 343.54 ;
    minaret:text "ایک انسان کی آغاز، ابتدا کہاں سے ہوتی ہے اور پھر وہ پالتا ہے اس کو، شکل بناتا ہے اس کی، اس کو ساری صلاحیتیں دیتا ہے۔ تو یہ جو عمل ہے، اس عمل کا کرنے والا جو ہے وہ رب کہلاتا ہے۔" .

minaret:Segment_TQ2005-0318_0033 a minaret:TranscriptSegment ;
    minaret:endTime 372.0 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0034 ;
    minaret:sequenceIndex 33 ;
    minaret:startTime 357.1 ;
    minaret:text "اور پھر «الْعٰلَمِیْنَ»: سارے جہانوں کا۔ سارے جہانوں کا پالنے والا اور ان کی پرورش کرنے والا اور ان کو ذرے سے کمال تک پہنچانے والا اللہ ہی ہے۔ اور پھر ایک اور چیز، اس پرورش میں" .

minaret:Segment_TQ2005-0318_0034 a minaret:TranscriptSegment ;
    minaret:endTime 382.08 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0035 ;
    minaret:sequenceIndex 34 ;
    minaret:startTime 372.84 ;
    minaret:text "محبت، شفقت، حفاظت، نگہداشت، امانت، یہ ساری چیزیں آتی ہیں، یعنی محض پالنے والا نہیں۔" .

minaret:Segment_TQ2005-0318_0035 a minaret:TranscriptSegment ;
    minaret:endTime 395.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0036 ;
    minaret:sequenceIndex 35 ;
    minaret:startTime 382.7 ;
    minaret:text "بلکہ کس طرح پالتا ہے؟ جس کے اندر محبت بھی ہے، شفقت بھی ہے، حفاظت بھی ہے۔ اس کو کیسے نگہداشت کرتا ہے؟ ماں کے پیٹ میں کیسا انتظام کیا، تین پردوں میں بچے کو رکھا، کیسی حفاظت سے پالا اس کو!" .

minaret:Segment_TQ2005-0318_0036 a minaret:TranscriptSegment ;
    minaret:endTime 409.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0037 ;
    minaret:sequenceIndex 36 ;
    minaret:startTime 396.58 ;
    minaret:text "اور اس کی نگہداشت بھی کرتا ہے اور پھر اس کو پورا پورا اپنے کمال تک پہنچاتا ہے۔ اور بعض اوقات رب کا لفظ جو ہے وہ انسانوں کی طرف بھی منسوب کیا جاتا ہے، آقا یا مالک کے معنوں میں لیا جاتا ہے۔" .

minaret:Segment_TQ2005-0318_0037 a minaret:TranscriptSegment ;
    minaret:endTime 420.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0038 ;
    minaret:sequenceIndex 37 ;
    minaret:startTime 410.64 ;
    minaret:text "عورت کو عربی میں کہتے ہیں «ربۃ البیت»، اس صورت میں مصدر بدل جاتا ہے۔ ربوبیت کی بجائے جو مصدر ہے وہ فرق ہو جاتا ہے۔" .

minaret:Segment_TQ2005-0318_0038 a minaret:TranscriptSegment ;
    minaret:endTime 432.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0039 ;
    minaret:sequenceIndex 38 ;
    minaret:startTime 420.94 ;
    minaret:text "اگر آپ سمجھیں کہ میں زیادہ دور تک جا رہی ہوں تو آپ بے شک مجھے روک سکتے ہیں کہ اتنی نہ باتیں بتائیں، کیونکہ مجھے نہیں معلوم کہ آپ کتنا اس کو لے سکیں، لیکن کچھ چیزیں ایسی ہیں جو آپ لکھ لیں اور کچھ چیزیں سمجھ لیں بس۔" .

minaret:Segment_TQ2005-0318_0040 a minaret:TranscriptSegment ;
    minaret:endTime 457.24 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0041 ;
    minaret:sequenceIndex 40 ;
    minaret:startTime 445.64 ;
    minaret:text "تو بہرحال اس میں یہ ہے کہ ربوبیت کی بجائے ربابیت اس کا مصدر ہوتا ہے جب انسان کی طرف اس کا ہو، تو اب اس کے لیے «ربۃ البیت» عورت کو کہتے ہیں، گھر کی مالکہ کے لیے۔" .

minaret:Segment_TQ2005-0318_0041 a minaret:TranscriptSegment ;
    minaret:endTime 467.7 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0042 ;
    minaret:sequenceIndex 41 ;
    minaret:startTime 457.74 ;
    minaret:text "کیوں؟ عورت کیا کرتی ہے؟ بچے پالتی ہے اور گھر کی ہر چیز کی نگہداشت کرتی ہے، حفاظت کرتی ہے، ایک خاص کیئر کرتی ہے،" .

minaret:Segment_TQ2005-0318_0042 a minaret:TranscriptSegment ;
    minaret:endTime 481.88 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0043 ;
    minaret:sequenceIndex 42 ;
    minaret:startTime 467.7 ;
    minaret:text "تو یہ اس وجہ سے اس کو۔ اور یہ سب چیزیں مالک کے اندر ہی آتی ہیں، کیونکہ جو مالک ہی نہیں ہوتا اس کو چیزوں کی پروا بھی نہیں ہوتی۔ تو اللہ تعالیٰ چونکہ سب چیزوں کا خالق ہے تو مالک ہے، تو سب کی حفاظت بھی پھر کر رہا ہے، ہر ایک کو پنپنے کا موقع دے رہا ہے، پھلنے پھولنے کا۔" .

minaret:Segment_TQ2005-0318_0043 a minaret:TranscriptSegment ;
    minaret:endTime 494.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0044 ;
    minaret:sequenceIndex 43 ;
    minaret:startTime 483.52 ;
    minaret:text "«الْعٰلَمِیْنَ»: عالمین عالم کی جمع ہے۔ عالم کا لفظ جو ہے، اس کا روٹ کیا ہوگا بھلا؟ ع، ل، م، عالم۔ اس روٹ سے ایک اور لفظ بھی بنا ہوا ہے، وہ کیا ہے؟" .

minaret:Segment_TQ2005-0318_0044 a minaret:TranscriptSegment ;
    minaret:endTime 504.64 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0045 ;
    minaret:sequenceIndex 44 ;
    minaret:startTime 495.42 ;
    minaret:text "عِلم۔ علم کا کیا معنی ہوتا ہے؟ جاننا۔ تو عالَم پھر کیا چیز ہو گی؟ نہیں، عالِم نہیں ہے،" .

minaret:Segment_TQ2005-0318_0045 a minaret:TranscriptSegment ;
    minaret:endTime 515.44 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0046 ;
    minaret:sequenceIndex 45 ;
    minaret:startTime 505.44 ;
    minaret:text "عالِم نہیں ہے، عالَم ہے، فرق ہے۔ جہان تو ہے، لیکن اس کا جو روٹ ہے ع، ل، م، اس سے یہ" .

minaret:Segment_TQ2005-0318_0046 a minaret:TranscriptSegment ;
    minaret:endTime 527.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0047 ;
    minaret:sequenceIndex 46 ;
    minaret:startTime 515.44 ;
    minaret:text "پتا چلتا ہے کہ عالَم ہے وہ چیز جس سے کچھ جانا جائے، پہچانا جائے۔ یعنی اس سے ہر وہ چیز جو" .

minaret:Segment_TQ2005-0318_0047 a minaret:TranscriptSegment ;
    minaret:endTime 538.28 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0048 ;
    minaret:sequenceIndex 47 ;
    minaret:startTime 528.28 ;
    minaret:text "اپنے بنانے والے کی پہچان کا ذریعہ ہے۔ ہم مثلاً درختوں کو دیکھتے ہیں تو ہمیں کون یاد آتا ہے؟ تو یہ پہچان" .

minaret:Segment_TQ2005-0318_0048 a minaret:TranscriptSegment ;
    minaret:endTime 548.92 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0049 ;
    minaret:sequenceIndex 48 ;
    minaret:startTime 538.28 ;
    minaret:text "ہے نا، کس کی؟ بنانے والے کی۔ عالَم: جس سے کوئی چیز پہچانی جائے۔ یعنی یہ لفظی معنی ہے، یعنی جس کے ذریعے کوئی چیز پہچانی جائے۔" .

minaret:Segment_TQ2005-0318_0049 a minaret:TranscriptSegment ;
    minaret:endTime 560.08 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0050 ;
    minaret:sequenceIndex 49 ;
    minaret:startTime 549.56 ;
    minaret:text "عالمین کیا ہے؟ سارے جہان۔ تو ہر چیز سے کون پہچانا جا رہا ہے؟ اللہ تعالیٰ۔ ہر چیز کس چیز کی طرف دلالت کر رہی ہے آپ کی؟ اللہ کے بنانے والے کی طرف۔" .

minaret:Segment_TQ2005-0318_0054 a minaret:TranscriptSegment ;
    minaret:endTime 621.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0055 ;
    minaret:sequenceIndex 54 ;
    minaret:startTime 611.36 ;
    minaret:text "صرف تیری ہی یا صرف تجھ سے ہی۔ «نَعْبُدُ»: کیا روٹ ہو گا؟ ع، ب، د، عبادت۔ عبادت کا لفظی معنی کیا ہے؟" .

minaret:Segment_TQ2005-0318_0055 a minaret:TranscriptSegment ;
    minaret:endTime 633.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0056 ;
    minaret:sequenceIndex 55 ;
    minaret:startTime 622.22 ;
    minaret:text "ہم عربی ڈکشنری دیکھتے ہیں، ایک ڈکشنری جس کا نام ہے «لسان العرب»، کئی والیمز میں ہے۔ لسان العرب میں دیکھتے ہیں کہ «أصل العبودية الخضوع والتذلل»، یہ معنی ہے۔" .

minaret:Segment_TQ2005-0318_0056 a minaret:TranscriptSegment ;
    minaret:endTime 639.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0057 ;
    minaret:sequenceIndex 56 ;
    minaret:startTime 634.88 ;
    minaret:text "خشوع و خضوع لفظ کبھی سنا ہے؟ تو عبودیت کی جو اصل ہے وہ ان دو لفظوں میں ہے:" .

minaret:Segment_TQ2005-0318_0057 a minaret:TranscriptSegment ;
    minaret:endTime 653.18 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0058 ;
    minaret:sequenceIndex 57 ;
    minaret:startTime 641.24 ;
    minaret:text "خضوع اور تذلل۔ یہ دو لفظ یاد کر لیں: «الْخُضُوعُ وَالتَّذَلُّلُ»۔ خضوع کا کیا معنی ہوتا ہے؟ دب جانا، خضوع: دب جانا۔" .

minaret:Segment_TQ2005-0318_0058 a minaret:TranscriptSegment ;
    minaret:endTime 662.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 654.76 ;
    minaret:text "تذلل: عاجزی۔ تو عبادت کی اصل کیا ہے؟ جھکنا اور عاجزی اختیار کرنا۔" .

minaret:Segment_TQ2005-0318_0059 a minaret:TranscriptSegment ;
    minaret:endTime 678.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0060 ;
    minaret:sequenceIndex 59 ;
    minaret:startTime 663.7 ;
    minaret:text "انتہائی محبت کے ساتھ اور انتہائی خوف کے ساتھ جھکنا۔ کمال الذل اور کمال الحب، اس میں دو چیزیں آتی ہیں پھر: ذل اور حب۔ یہ دو لفظ یاد رکھیں۔" .

minaret:Segment_TQ2005-0318_0060 a minaret:TranscriptSegment ;
    minaret:endTime 689.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0061 ;
    minaret:sequenceIndex 60 ;
    minaret:startTime 678.9 ;
    minaret:text "عبادت ان دو چیزوں سے مل کے بنتی ہے، کس سے؟ ذل اور حب سے۔ حب کس کو کہتے ہیں؟ محبت، وہ تو سب کو پتا ہے۔ ذل:" .

minaret:Segment_TQ2005-0318_0061 a minaret:TranscriptSegment ;
    minaret:endTime 698.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0062 ;
    minaret:sequenceIndex 61 ;
    minaret:startTime 690.3 ;
    minaret:text "عاجزی، انتہائی عاجزی۔ اچھا، اب اس کو نہ تو رٹیے، نہ ہی پریشان ہوئیے، ذرا سوچیے، کیا آپ کو فیلنگ آئی اس لفظ سے؟ عبادت کیا ہے؟" .

minaret:Segment_TQ2005-0318_0062 a minaret:TranscriptSegment ;
    minaret:endTime 710.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0063 ;
    minaret:sequenceIndex 62 ;
    minaret:startTime 700.56 ;
    minaret:text "لفظِ عبادت سنتے ہی آپ کے اندر ایک احساس آنا چاہیے کہ آپ نے کیا سنا۔ اگر کوئی لفظ بولتا ہے عبادت، تو آپ کے اندر فوراً اس کا معنی آنا چاہیے، کیا" .

minaret:Segment_TQ2005-0318_0063 a minaret:TranscriptSegment ;
    minaret:endTime 720.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0064 ;
    minaret:sequenceIndex 63 ;
    minaret:startTime 710.52 ;
    minaret:text "معنی آئے گا؟ ابھی آپ کہہ رہے تھے بندگی، غلامی، یہ سب باتیں ٹھیک ہیں، لیکن اصل جو ہے عبادت کا لفظ، اس میں دو کانسیپٹس جو ہیں:" .

minaret:Segment_TQ2005-0318_0064 a minaret:TranscriptSegment ;
    minaret:endTime 731.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0065 ;
    minaret:sequenceIndex 64 ;
    minaret:startTime 721.46 ;
    minaret:text "عاجزی بھی ہو اور خوف بھی شامل ہو۔ محبت اور عاجزی بھی اگر آپ یاد کر لیں گے تو بات بن جائے گی۔ انتہائی محبت، انتہائی عاجزی۔" .

minaret:Segment_TQ2005-0318_0065 a minaret:TranscriptSegment ;
    minaret:endTime 742.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0066 ;
    minaret:sequenceIndex 65 ;
    minaret:startTime 733.16 ;
    minaret:text "انتہائی محبت، انتہائی عاجزی۔ تو اللہ کی عبادت ہو نہیں سکتی جب تک کہ انسان کے اندر انتہائی عاجزی اور انتہائی محبت نہ ہو۔" .

minaret:Segment_TQ2005-0318_0066 a minaret:TranscriptSegment ;
    minaret:endTime 750.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0067 ;
    minaret:sequenceIndex 66 ;
    minaret:startTime 743.94 ;
    minaret:text "جب ہم کہیں گے «اِیَّاكَ نَعْبُدُ»، کیا کہہ رہے ہیں؟ ہر نماز میں ہم پڑھتے ہیں:" .

minaret:Segment_TQ2005-0318_0068 a minaret:TranscriptSegment ;
    minaret:endTime 766.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0069 ;
    minaret:sequenceIndex 68 ;
    minaret:startTime 752.4 ;
    minaret:text "صرف تیری ہم عبادت کرتے ہیں۔ کیا کرتے ہیں؟ کیا کہہ رہے ہیں، کیا کرتے ہیں؟ یعنی سب سے زیادہ تجھ سے محبت کرتے ہیں، سچ بولتے ہیں؟" .

minaret:Segment_TQ2005-0318_0070 a minaret:TranscriptSegment ;
    minaret:endTime 782.14 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0071 ;
    minaret:sequenceIndex 70 ;
    minaret:startTime 771.18 ;
    minaret:text "سب دنیا کے لیے only yours لکھتے رہتے ہیں سوائے اللہ کے! جس کے لیے only yours ہونا چاہیے، اس کے لیے کبھی only yours نہیں کرتے۔ مجھے ہمیشہ یہ لفظ لکھنا" .

minaret:Segment_TQ2005-0318_0072 a minaret:TranscriptSegment ;
    minaret:endTime 806.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0073 ;
    minaret:sequenceIndex 72 ;
    minaret:startTime 795.02 ;
    minaret:text "اسلام تو آیا تھا بندوں کی غلامی سے نکال کے اللہ کی غلامی میں ڈالنے کے لیے، اور ہم بندوں کے غلام ہو گئے۔ میں سمجھتی ہوں کہ ہم جب بندوں کو only yours لکھتے ہیں تو اس کا کیا مطلب ہوتا ہے،" .

minaret:Segment_TQ2005-0318_0073 a minaret:TranscriptSegment ;
    minaret:endTime 817.34 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0074 ;
    minaret:sequenceIndex 73 ;
    minaret:startTime 806.9 ;
    minaret:text "لیکن only yours صرف اللہ کے لیے ہو سکتا ہے، غیر اللہ کے لیے نہیں ہو سکتا۔ یہ مومنانہ طرزِ عمل نہیں ہے only yours لکھنا انسانوں کے لیے، ٹھیک ہے؟ لیکن ہم کبھی سوچتے نہیں۔" .

minaret:Segment_TQ2005-0318_0074 a minaret:TranscriptSegment ;
    minaret:endTime 827.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0075 ;
    minaret:sequenceIndex 74 ;
    minaret:startTime 817.9 ;
    minaret:text "محبت سے لکھتے ہیں نا؟ چلیے کہتے ہیں محبت میں ہر چیز جائز ہوتی ہے، یہ بھی صحیح ہے کہ نہیں؟ یہ بھی صحیح نہیں ہے، اس لیے کہ ہمارا معیار یہ قرآن ہے،" .

minaret:Segment_TQ2005-0318_0075 a minaret:TranscriptSegment ;
    minaret:endTime 834.94 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0076 ;
    minaret:sequenceIndex 75 ;
    minaret:startTime 827.9 ;
    minaret:text "لوگوں کی کہاوتیں نہیں ہیں، لوگوں کے اقوال نہیں ہیں کہ کسی نے فرمایا تھا تو ہم اس کے مطابق اپنے آپ کو بنا لیں۔" .

minaret:Segment_TQ2005-0318_0078 a minaret:TranscriptSegment ;
    minaret:endTime 873.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0079 ;
    minaret:sequenceIndex 78 ;
    minaret:startTime 863.68 ;
    minaret:text "ع، و، ن، کسی سے مدد چاہنا، کسی سے تعاون حاصل کرنا۔ تعاون کا لفظ تو اسی سے نکلا ہے۔ «اِهْدِنَا»: دکھا ہم کو۔" .

minaret:Segment_TQ2005-0318_0079 a minaret:TranscriptSegment ;
    minaret:endTime 885.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0080 ;
    minaret:sequenceIndex 79 ;
    minaret:startTime 874.64 ;
    minaret:text "«اِهْدِنَا» کا لفظ جو ہے نا، یہ ہدایت سے ہے، اس کا روٹ ہے ہ، د، ی، ہُدیٰ۔ ہدیٰ لفظ اسی سے ہے، لطف و مہربانی کے ساتھ رہنمائی کرنا، راستہ بتانا۔" .

minaret:Segment_TQ2005-0318_0080 a minaret:TranscriptSegment ;
    minaret:endTime 897.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0081 ;
    minaret:sequenceIndex 80 ;
    minaret:startTime 886.24 ;
    minaret:text "اور اس میں تین چیزیں ہوتی ہیں: کسی کو راستہ دکھانا، اس پہ چلانا اور منزل تک پہنچانا۔ تو جب ہم کہتے ہیں «اِهْدِنَا» تو مطلب کیا ہے؟" .

minaret:Segment_TQ2005-0318_0081 a minaret:TranscriptSegment ;
    minaret:endTime 906.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0082 ;
    minaret:sequenceIndex 81 ;
    minaret:startTime 897.84 ;
    minaret:text "پہلے تو راستہ دکھا جانا کدھر ہے، پھر اس پہ چلا اور پھر منزل تک پہنچا، یہ نہ ہو کہ ہم اس پہ چلتے چلتے ادھر ادھر ہو جائیں۔" .

minaret:Segment_TQ2005-0318_0084 a minaret:TranscriptSegment ;
    minaret:endTime 935.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0085 ;
    minaret:sequenceIndex 84 ;
    minaret:startTime 927.74 ;
    minaret:text "دیتا ہے۔ اچھا، اس سے بچ کے انسان آگے جاتا ہے وہاں پھسل پڑتا ہے، پھر اس کو سمجھیں: اوہ! میں تو غلط راستے پہ جا رہا ہوں، غلط موڑ مڑ گیا۔" .

minaret:Segment_TQ2005-0318_0085 a minaret:TranscriptSegment ;
    minaret:endTime 946.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0086 ;
    minaret:sequenceIndex 85 ;
    minaret:startTime 937.76 ;
    minaret:text "غلط ایگزٹ پہ نکل گئے، تو آپ کہاں جائیں گے؟ آپ غلط ایگزٹ لے کے کہاں جائیں گے؟ آپ گھر پہنچیں گے، منزل پہ پہنچیں گے؟" .

minaret:Segment_TQ2005-0318_0086 a minaret:TranscriptSegment ;
    minaret:endTime 955.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0087 ;
    minaret:sequenceIndex 86 ;
    minaret:startTime 947.2 ;
    minaret:text "نہیں پہنچیں گے! اس لیے «اِهْدِنَا» کا مطلب یہ ہے کہ اے اللہ! پہلے تو راستہ بتا، پھر اس پہ چلا اور ہر شیطانِ مردود سے بچا،" .

minaret:Segment_TQ2005-0318_0087 a minaret:TranscriptSegment ;
    minaret:endTime 966.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0088 ;
    minaret:sequenceIndex 87 ;
    minaret:startTime 956.66 ;
    minaret:text "اور پھر منزل تک پہنچا، یعنی مرتے دم تک اسی پر قائم رہیں۔ یہ ہے «اِهْدِنَا» کا معنی، «دکھا ہم کو» نہیں صرف کہیں گے۔" .

minaret:Segment_TQ2005-0318_0089 a minaret:TranscriptSegment ;
    minaret:endTime 991.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0090 ;
    minaret:sequenceIndex 89 ;
    minaret:startTime 983.36 ;
    minaret:text "«الصِّرَاطَ»: راستے کو کہتے ہیں، وہ راستہ جسے انتہائی احتیاط سے طے کرنا پڑے، جس کے اردگرد بہت سے خطرے ہوں۔" .

minaret:Segment_TQ2005-0318_0090 a minaret:TranscriptSegment ;
    minaret:endTime 1004.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0091 ;
    minaret:sequenceIndex 90 ;
    minaret:startTime 992.06 ;
    minaret:text "راستے کے لیے عربی میں کئی لفظ استعمال ہوتے ہیں، اور صراط اس راستے کو کہتے ہیں جس پہ احتیاط سے چلنا پڑے۔ اسی لیے پل صراط جو ہے نا، اس سے یاد کر لیجیے، صراط کا لفظ بولیں تو پل صراط یاد کر لیں۔" .

minaret:Segment_TQ2005-0318_0091 a minaret:TranscriptSegment ;
    minaret:endTime 1007.62 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0092 ;
    minaret:sequenceIndex 91 ;
    minaret:startTime 1005.92 ;
    minaret:text "پل صراط پہ کیسے چلنا پڑے گا؟" .

minaret:Segment_TQ2005-0318_0092 a minaret:TranscriptSegment ;
    minaret:endTime 1020.88 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0093 ;
    minaret:sequenceIndex 92 ;
    minaret:startTime 1009.2 ;
    minaret:text "دیکھیے، میں سمجھتی ہوں دو پل صراط ہیں، ایک تو ہے آخرت میں اور ایک ہے اس دنیا میں۔ اس دنیا کے پل صراط پر بھی بہت احتیاط سے چلنے کی ضرورت ہے۔" .

minaret:Segment_TQ2005-0318_0093 a minaret:TranscriptSegment ;
    minaret:endTime 1032.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0094 ;
    minaret:sequenceIndex 93 ;
    minaret:startTime 1021.98 ;
    minaret:text "ہر لمحہ، ہر روز اپنے خیالات، اپنے اخلاق، اپنے معاملات کا محاسبہ کرتے رہنے کی ضرورت ہے کہ کہیں ادھر نہ پھسل گریں، کہیں ادھر نہ پھسل گریں۔" .

minaret:Segment_TQ2005-0318_0094 a minaret:TranscriptSegment ;
    minaret:endTime 1045.08 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0095 ;
    minaret:sequenceIndex 94 ;
    minaret:startTime 1033.6 ;
    minaret:text "جو یہاں استقامت کے ساتھ رہا وہ قیامت کے دن بھی اس پل صراط پر بھی مزے سے چل لے گا، اور جو آج بھٹکا نا، ادھر گرا اور ادھر گرا، تو وہ وہاں کیسے سیدھا چلے گا، بتائیے؟" .

minaret:Segment_TQ2005-0318_0095 a minaret:TranscriptSegment ;
    minaret:endTime 1054.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0096 ;
    minaret:sequenceIndex 95 ;
    minaret:startTime 1046.28 ;
    minaret:text "وہ جو پل صراط ہے نا، وہ اصل میں ریفلیکشن ہے کس کا؟ اس پل صراط کا۔ دیکھیے، اس لیے میں آپ کو کہتی ہوں لفظ لفظ کو پہچانیے" .

minaret:Segment_TQ2005-0318_0096 a minaret:TranscriptSegment ;
    minaret:endTime 1063.24 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0097 ;
    minaret:sequenceIndex 96 ;
    minaret:startTime 1055.8 ;
    minaret:text "اور لفظ لفظ کا جو ہے نا امیجینیشن اپنے اندر رکھیے تاکہ جب آپ پڑھیں یا کسی امام کے پیچھے سنیں تو آپ کو پل صراط یاد آ جائے،" .

minaret:Segment_TQ2005-0318_0097 a minaret:TranscriptSegment ;
    minaret:endTime 1074.64 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0098 ;
    minaret:sequenceIndex 97 ;
    minaret:startTime 1064.92 ;
    minaret:text "کہ یا رب! یہ دنیا تو کانٹوں سے بھری ہوئی ہے، اتنے بہکانے پھسلانے والے عوامل اور فیکٹرز ہیں کہ بچنا بہت مشکل ہے۔ تو اس لیے" .

minaret:Segment_TQ2005-0318_0098 a minaret:TranscriptSegment ;
    minaret:endTime 1082.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0099 ;
    minaret:sequenceIndex 98 ;
    minaret:startTime 1074.64 ;
    minaret:text "تیرے سے ہی ہم مدد مانگتے ہیں، تو ہی ہمیں سیدھے راستے پر رکھ اور ہم احتیاط سے... جیسے پل صراط کے پار کیا ہے؟ جنت!" .

minaret:Segment_TQ2005-0318_0099 a minaret:TranscriptSegment ;
    minaret:endTime 1089.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0100 ;
    minaret:sequenceIndex 99 ;
    minaret:startTime 1083.5 ;
    minaret:text "میں سمجھتی ہوں حشر کا تو سارا ہی دن بڑا مشکل ہے، لیکن اگر آپ ڈسکرپشن پڑھیں پل صراط کی تو روح کانپ جاتی ہے۔" .

minaret:Segment_TQ2005-0318_0100 a minaret:TranscriptSegment ;
    minaret:endTime 1105.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0101 ;
    minaret:sequenceIndex 100 ;
    minaret:startTime 1090.48 ;
    minaret:text "سب سے مشکل مرحلہ مجھے پل صراط لگتا ہے، کیونکہ جنت وہ قریب ہوگی نا، سامنے، لیکن اس کے اوپر سے گزرے بغیر وہاں نہیں جا سکتے۔ یہ ٹیسٹ ہے، آخری ٹیسٹ ہے بیسیکلی، اور" .

minaret:Segment_TQ2005-0318_0102 a minaret:TranscriptSegment ;
    minaret:endTime 1119.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0103 ;
    minaret:sequenceIndex 102 ;
    minaret:startTime 1108.48 ;
    minaret:text "ہر ایک کو اس سے گزرنا ہے، ہر پیغمبر، نبی، ولی، نیک، بد، سب کو اسی سے گزرنا ہے۔ جنت کا راستہ ہی وہ ہے۔ دنیا میں کیا فرمایا؟ جنت کا راستہ کس سے گھرا ہوا ہے؟" .

minaret:Segment_TQ2005-0318_0103 a minaret:TranscriptSegment ;
    minaret:endTime 1127.5 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0104 ;
    minaret:sequenceIndex 103 ;
    minaret:startTime 1120.54 ;
    minaret:text "کانٹوں سے گھرا ہوا ہے۔ اس دنیا میں بھی ہم پل صراط پر ہی ہیں مگر ہم اس کو دیکھ نہیں رہے نا تو ریالائز نہیں کرتے،" .

minaret:Segment_TQ2005-0318_0104 a minaret:TranscriptSegment ;
    minaret:endTime 1140.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0105 ;
    minaret:sequenceIndex 104 ;
    minaret:startTime 1128.62 ;
    minaret:text "لیکن کل کو وہ حقیقی معنوں میں سامنے رکھا جائے گا اور اس کے اوپر چل کر اینڈ تک پہنچنا ہو گا۔ لہٰذا، یا رب! ہمیں صراطِ مستقیم پر ہی چلا" .

minaret:Segment_TQ2005-0318_0105 a minaret:TranscriptSegment ;
    minaret:endTime 1152.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0106 ;
    minaret:sequenceIndex 105 ;
    minaret:startTime 1142.72 ;
    minaret:text "اور منزل تک پہنچا، کیونکہ آپ کو پتا ہے کہ کئی لوگ پل صراط کا ایک لمبا حصہ پار کر لیں گے اور جب جنت کے قریب پہنچنے والے ہوں گے تو وہاں جا گریں گے نیچے!" .

minaret:Segment_TQ2005-0318_0106 a minaret:TranscriptSegment ;
    minaret:endTime 1163.72 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0107 ;
    minaret:sequenceIndex 106 ;
    minaret:startTime 1153.56 ;
    minaret:text "اسی لیے قرآن پاک میں قیامت کے دن کو کیا کہا گیا؟ حسرت کا دن۔ کئی لوگ ساری زندگی بڑی اچھی گزارتے ہیں، ساری زندگی نیکیاں کرتے ہیں، ایسا شیطان" .

minaret:Segment_TQ2005-0318_0107 a minaret:TranscriptSegment ;
    minaret:endTime 1176.88 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0108 ;
    minaret:sequenceIndex 107 ;
    minaret:startTime 1163.72 ;
    minaret:text "بیچ میں آ جاتا ہے، جاتے جاتے وصیت غلط کر دیں، اولاد کو وراثت سے محروم کر دیں یا کوئی اور ایسی خرابی کریں گے کہ وہ گر گئے، یا ایسا بول بول دیا کہ احسان کیا وہ سب ضائع کر دیا۔ کہتے ہیں:" .

minaret:Segment_TQ2005-0318_0109 a minaret:TranscriptSegment ;
    minaret:endTime 1185.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0110 ;
    minaret:sequenceIndex 109 ;
    minaret:startTime 1179.4 ;
    minaret:text "کسی کے ساتھ خوب نیکی کی ساری زندگی، اور مرنے سے پہلے اس کو ایسی باتیں سنائیں، سب صفایا کر کے گئے۔" .

minaret:Segment_TQ2005-0318_0110 a minaret:TranscriptSegment ;
    minaret:endTime 1198.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0111 ;
    minaret:sequenceIndex 110 ;
    minaret:startTime 1186.32 ;
    minaret:text "تو یہ اس زندگی میں انسان کا ایک امتحان ہے اور ایک مسلسل امتحان ہے۔ جیسے پل صراط سے جب تک انسان اتر نہیں نا جائے گا، اسی طرح جب تک ہم موت کے بعد اللہ کے ہاں پہنچ نہیں جاتے نا، ہم امتحان میں ہیں۔" .

minaret:Segment_TQ2005-0318_0111 a minaret:TranscriptSegment ;
    minaret:endTime 1209.16 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0112 ;
    minaret:sequenceIndex 111 ;
    minaret:startTime 1199.5 ;
    minaret:text "کبھی کوئی نہ سمجھے کہ میں تو بڑا نیک بن گیا، میں تو بڑا محفوظ ہو گیا۔ نہیں، continuous test! ہر روز ایک نیا امتحان لے کے آتا ہے آپ کے لیے،" .

minaret:Segment_TQ2005-0318_0112 a minaret:TranscriptSegment ;
    minaret:endTime 1214.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0113 ;
    minaret:sequenceIndex 112 ;
    minaret:startTime 1209.76 ;
    minaret:text "اور آپ کو انتہائی conscious ہو کے اور محتاط ہو کے زندگی بسر کرنی ہے۔ Anyhow," .

minaret:Segment_TQ2005-0318_0113 a minaret:TranscriptSegment ;
    minaret:endTime 1225.36 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0114 ;
    minaret:sequenceIndex 113 ;
    minaret:startTime 1215.56 ;
    minaret:text "تو صراط کا معنی آپ نے جانا عربی میں کس کو کہتے ہیں؟ وہ راستہ جس کو احتیاط سے پار کرنا ہو اور جس کے اردگرد خطرات ہوں، اور «الْمُسْتَقِیْمَ»: straight," .

minaret:Segment_TQ2005-0318_0114 a minaret:TranscriptSegment ;
    minaret:endTime 1236.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0115 ;
    minaret:sequenceIndex 114 ;
    minaret:startTime 1225.36 ;
    minaret:text "سیدھا۔ وہ چیز جو سیدھی بھی ہو، balanced بھی ہو اور افراط و تفریط سے پاک ہو، یعنی uneven نہ ہو بلکہ even ہو، ٹھیک ہے نا؟" .

minaret:Segment_TQ2005-0318_0115 a minaret:TranscriptSegment ;
    minaret:endTime 1250.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0116 ;
    minaret:sequenceIndex 115 ;
    minaret:startTime 1237.16 ;
    minaret:text "اب آپ دیکھیں کہ زندگی خطرات سے گھری ہوئی ہے نا، تو اس کو کیا چیز پھر درست راستہ دکھاتی ہے ہمیں یا ہمارے لیے کیا چیز راہ کھولتی ہے کہ ہم بچ سکیں؟ وہ اللہ کا دین ہے۔" .

minaret:Segment_TQ2005-0318_0116 a minaret:TranscriptSegment ;
    minaret:endTime 1260.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0117 ;
    minaret:sequenceIndex 116 ;
    minaret:startTime 1251.02 ;
    minaret:text "تو صراطِ مستقیم بیسیکلی کیا ہے؟ اللہ کا دکھایا ہوا راستہ، یعنی دینِ اسلام۔ «اَنْعَمْتَ»: انعام کیا تُو نے،" .

minaret:Segment_TQ2005-0318_0117 a minaret:TranscriptSegment ;
    minaret:endTime 1270.4 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0118 ;
    minaret:sequenceIndex 117 ;
    minaret:startTime 1261.56 ;
    minaret:text "ن، ع، م سے ہے۔ انعام کے معنی احسان کرنا، انعام کرنا بھی ہوتا ہے، یعنی تُو نے احسان کیا «عَلَیْهِمْ» جن پر۔" .

minaret:Segment_TQ2005-0318_0118 a minaret:TranscriptSegment ;
    minaret:endTime 1281.18 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0119 ;
    minaret:sequenceIndex 118 ;
    minaret:startTime 1270.94 ;
    minaret:text "انعام کا لفظ نعمت سے بھی ہے، انعام اور نعمت۔ نعمت کا لفظ کبھی سنا ہے آپ نے؟ بہت استعمال ہوتا ہے نا؟ تو نعمتوں کی کئی قسمیں ہوتی ہیں، جسمانی ہوتی ہیں، روحانی ہوتی ہیں،" .

minaret:Segment_TQ2005-0318_0119 a minaret:TranscriptSegment ;
    minaret:endTime 1292.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0120 ;
    minaret:sequenceIndex 119 ;
    minaret:startTime 1281.94 ;
    minaret:text "انہیریٹڈ ہوتی ہیں، کچھ خود انسان کوشش کر کے حاصل کرتا ہے۔ تو بہرحال، جن پر تیرا انعام ہوا۔ «الْمَغْضُوْبِ»: جن پر غضب ہوا،" .

minaret:Segment_TQ2005-0318_0120 a minaret:TranscriptSegment ;
    minaret:endTime 1302.8 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0121 ;
    minaret:sequenceIndex 120 ;
    minaret:startTime 1292.94 ;
    minaret:text "غ، ض، ب، غضب۔ غضب کا کیا مطلب ہوتا ہے؟ غصہ، یعنی جن پر تُو ناراض ہوا، ہمیں ان کا راستہ نہیں چاہیے۔" .

minaret:Segment_TQ2005-0318_0121 a minaret:TranscriptSegment ;
    minaret:endTime 1310.94 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0122 ;
    minaret:sequenceIndex 121 ;
    minaret:startTime 1303.38 ;
    minaret:text "«وَلَا الضَّآلِّیْنَ»: اور نہ وہ جو بھٹک گئے۔ ضالین کا لفظ جو ہے، یہ ض، ل، ل سے ہے، بھٹکے ہوئے لوگ، اصل راستے سے ہٹے ہوئے لوگ،" .

minaret:Segment_TQ2005-0318_0122 a minaret:TranscriptSegment ;
    minaret:endTime 1319.62 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0123 ;
    minaret:sequenceIndex 122 ;
    minaret:startTime 1311.82 ;
    minaret:text "جو راستہ گم کر بیٹھے، غلط ایگزٹ سے نکل گئے، ایسٹ کی بجائے ویسٹ لے لیا یا نارتھ کی بجائے ساؤتھ لے لیا۔" .

minaret:Segment_TQ2005-0318_0123 a minaret:TranscriptSegment ;
    minaret:endTime 1332.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0124 ;
    minaret:sequenceIndex 123 ;
    minaret:startTime 1320.62 ;
    minaret:text "کیا بھول گئے؟ وہ صرف پہلا حصہ دیکھتے ہیں: اچھا یہ فلاں روٹ ہے؟ چلو، چلو اس پر! یہ بھول جاتے ہیں کہ ویسٹ کی طرف نکلنا تھا یا ایسٹ کی ایگزٹ سے نکلنا تھا۔" .

minaret:Segment_TQ2005-0318_0124 a minaret:TranscriptSegment ;
    minaret:endTime 1345.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0125 ;
    minaret:sequenceIndex 124 ;
    minaret:startTime 1332.94 ;
    minaret:text "اگر آپ آدھا پڑھیں اور آدھا چھوڑ دیں اور نکل کھڑے ہوں، کہاں پہنچیں گے؟ بالکل الٹے راستے پر چلے جائیں گے، totally opposite direction! تو اسی طرح بعض لوگ جلدبازی میں" .

minaret:Segment_TQ2005-0318_0125 a minaret:TranscriptSegment ;
    minaret:endTime 1358.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0126 ;
    minaret:sequenceIndex 125 ;
    minaret:startTime 1346.42 ;
    minaret:text "ایسے زندگی میں غلط فیصلے کرتے ہیں کہ جس سے وہ حق سے، ہدایت سے بہت دور نکل جاتے ہیں۔ نعمت وہ ہاتھ کی ریچ میں ہوتی ہے لیکن اس سے وہ بہت دور چلے جاتے ہیں۔" .

minaret:Segment_TQ2005-0318_0131 a minaret:TranscriptSegment ;
    minaret:endTime 1430.34 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0132 ;
    minaret:sequenceIndex 131 ;
    minaret:startTime 1420.02 ;
    minaret:text "الشَّیْطَانِ الرَّجِیْمِ ۟ بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ ۟ اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِیْنَ ۟ۙ»" .

minaret:Segment_TQ2005-0318_0132 a minaret:TranscriptSegment ;
    minaret:endTime 1440.5 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0133 ;
    minaret:sequenceIndex 132 ;
    minaret:startTime 1430.34 ;
    minaret:text "«الرَّحْمٰنِ الرَّحِیْمِ ۟ۙ مٰلِكِ یَوْمِ الدِّیْنِ ۟ؕ اِیَّاكَ نَعْبُدُ»" .

minaret:Segment_TQ2005-0318_0133 a minaret:TranscriptSegment ;
    minaret:endTime 1450.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0134 ;
    minaret:sequenceIndex 133 ;
    minaret:startTime 1440.5 ;
    minaret:text "«وَاِیَّاكَ نَسْتَعِیْنُ ۟ؕ اِهْدِنَا الصِّرَاطَ الْمُسْتَقِیْمَ ۟ۙ صِرَاطَ الَّذِیْنَ»" .

minaret:Segment_TQ2005-0318_0134 a minaret:TranscriptSegment ;
    minaret:endTime 1459.58 ;
    minaret:sequenceIndex 134 ;
    minaret:startTime 1450.04 ;
    minaret:text "«اَنْعَمْتَ عَلَیْهِمْ ۙ۬ غَیْرِ الْمَغْضُوْبِ عَلَیْهِمْ وَلَا الضَّآلِّیْنَ»" .

minaret:Segment_TQ2005-0319_0000 a minaret:TranscriptSegment ;
    minaret:endTime 13.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0001 ;
    minaret:sequenceIndex 0 ;
    minaret:startTime 0.0 ;
    minaret:text "چلیے! اَعُوْذُ بِاللّٰهِ مِنَ الشَّیْطَانِ الرَّجِیْمِ، بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ۔ سورۃ الفاتحہ قرآن پاک کی سب سے پہلی سورت ہے، اور اس سورت کی فضیلت میں کچھ احادیث بھی وارد ہوئی ہیں۔" .

minaret:Segment_TQ2005-0319_0001 a minaret:TranscriptSegment ;
    minaret:endTime 25.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0002 ;
    minaret:sequenceIndex 1 ;
    minaret:startTime 15.12 ;
    minaret:text "حضرت عبداللہ بن عباس فرماتے ہیں کہ ایک دن جبرائیل علیہ السلام رسول اللہ صلی اللہ علیہ وسلم کے پاس بیٹھے ہوئے تھے، کیونکہ یہ آپ کو معلوم ہے نا" .

minaret:Segment_TQ2005-0319_0002 a minaret:TranscriptSegment ;
    minaret:endTime 31.5 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0003 ;
    minaret:sequenceIndex 2 ;
    minaret:startTime 25.12 ;
    minaret:text "کہ جب وہ وحی لاتے تھے تو آپ کے پاس بیٹھتے تھے، کہ انہوں نے اپنے اوپر ایک زوردار آواز سنی۔" .

minaret:Segment_TQ2005-0319_0003 a minaret:TranscriptSegment ;
    minaret:endTime 39.88 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0004 ;
    minaret:sequenceIndex 3 ;
    minaret:startTime 32.4 ;
    minaret:text "انہوں نے اپنا سر اٹھایا، پھر فرمایا: یہ آسمان کا ایک دروازہ ہے جو آج سے پہلے کبھی نہیں کھلا۔" .

minaret:Segment_TQ2005-0319_0004 a minaret:TranscriptSegment ;
    minaret:endTime 51.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0005 ;
    minaret:sequenceIndex 4 ;
    minaret:startTime 40.82 ;
    minaret:text "پھر فرمایا: یہ ایک فرشتہ ہے جو آج سے پہلے زمین پر کبھی نہیں اترا۔ پھر اس فرشتے نے آپ صلی اللہ علیہ وسلم کو سلام کیا اور دو نوروں کی خوشخبری دی،" .

minaret:Segment_TQ2005-0319_0007 a minaret:TranscriptSegment ;
    minaret:endTime 91.82 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 82.08 ;
    minaret:text "صحیح مسلم کی روایت ہے۔ تو اس سے پتا چلتا ہے کہ سورۃ الفاتحہ کتنی عظیم سورت ہے اور اس کا پڑھنا کتنا" .

minaret:Segment_TQ2005-0319_0008 a minaret:TranscriptSegment ;
    minaret:endTime 103.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 91.82 ;
    minaret:text "بابرکت ہے، اور اللہ سبحانہ و تعالیٰ نے رسول اللہ صلی اللہ علیہ وسلم پر خاص انعام فرمایا اور آپ کو یہ سورت عطا فرمائی۔ قرآن پاک میں آتا ہے:" .

minaret:Segment_TQ2005-0319_0011 a minaret:TranscriptSegment ;
    minaret:endTime 127.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0012 ;
    minaret:sequenceIndex 11 ;
    minaret:startTime 117.94 ;
    minaret:text "ایک اور حدیث ہے جو بخاری کی ہے، آپ صلی اللہ علیہ وسلم فرماتے ہیں حضرت ابو سعید سے، یعنی اپنے ایک صحابی سے آپ نے فرمایا: میں" .

minaret:Segment_TQ2005-0319_0016 a minaret:TranscriptSegment ;
    minaret:endTime 176.56 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0017 ;
    minaret:sequenceIndex 16 ;
    minaret:startTime 166.52 ;
    minaret:text "ماں سے مراد یہاں کیا؟ یعنی اصل بنیاد، ام الکتاب اور دہرائی ہوئی سات آیات۔ اس سورت کا نام" .

minaret:Segment_TQ2005-0319_0017 a minaret:TranscriptSegment ;
    minaret:endTime 188.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0018 ;
    minaret:sequenceIndex 17 ;
    minaret:startTime 176.56 ;
    minaret:text "الشفاء بھی ہے اور الرقیہ بھی ہے، یعنی اس کے ذریعے دم بھی کیا جاتا ہے، شفا بھی حاصل ہوتی ہے، اور ویسے تو قرآن سارے کا سارا ہی شفا ہے۔" .

minaret:Segment_TQ2005-0319_0018 a minaret:TranscriptSegment ;
    minaret:endTime 204.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0019 ;
    minaret:sequenceIndex 18 ;
    minaret:startTime 190.06 ;
    minaret:text "سورۃ الفاتحہ ترتیبِ نزولی کے اعتبار سے پانچویں نمبر پر آتی ہے اور یوں یہ نبوت کے ابتدائی دور میں نازل ہوئی، اور یہ پہلی سورت ہے جو پوری کی پوری ایک ہی بار اتری۔" .

minaret:Segment_TQ2005-0319_0019 a minaret:TranscriptSegment ;
    minaret:endTime 214.92 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0020 ;
    minaret:sequenceIndex 19 ;
    minaret:startTime 206.0 ;
    minaret:text "باقی سورتیں تو کس طرح ہوتی ہیں کہ کوئی حصہ ایک دفعہ اترا، پھر کچھ بعد میں اترا، پھر ان کو اکٹھا کیا گیا، لیکن یہ پوری سات آیات اکٹھی اتری ہیں۔" .

minaret:Segment_TQ2005-0319_0020 a minaret:TranscriptSegment ;
    minaret:endTime 223.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0021 ;
    minaret:sequenceIndex 20 ;
    minaret:startTime 216.54 ;
    minaret:text "قرآن پاک کا جب آغاز کیا جائے تو حکم ہے کہ اللہ کی پناہ طلب کی جائے شیطان مردود سے۔" .

minaret:Segment_TQ2005-0319_0023 a minaret:TranscriptSegment ;
    minaret:endTime 254.44 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 241.54 ;
    minaret:text "تو قرآن پاک کے پڑھنے کے آداب میں سے پہلا ادب کیا ہے کہ شروع میں کیا کیا جائے؟ شیطان مردود سے پناہ مانگی جائے اور اللہ تعالیٰ کی پناہ میں اپنے آپ کو دیا جائے۔" .

minaret:Segment_TQ2005-0319_0024 a minaret:TranscriptSegment ;
    minaret:endTime 264.28 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 254.98 ;
    minaret:text "کیوں؟ شیطان انسان کے دل میں ویسے بھی بہت وسوسے ڈالتا ہے، لیکن اس کی کوششیں اس وقت اور تیز ہو جاتی ہیں" .

minaret:Segment_TQ2005-0319_0025 a minaret:TranscriptSegment ;
    minaret:endTime 272.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 265.02 ;
    minaret:text "جب انسان اللہ کے راستے کی طرف قدم اٹھاتا ہے اور وہ اس مقام تک پہنچ جاتا ہے کہ اللہ کی کتاب کھول لے۔" .

minaret:Segment_TQ2005-0319_0026 a minaret:TranscriptSegment ;
    minaret:endTime 282.18 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 272.92 ;
    minaret:text "کیونکہ اب وہ اور زیادہ خوف میں مبتلا ہو جاتا ہے کہ اگر یہ شخص قرآن سے جڑ گیا تو پھر کیا ہو گا، میرے ہاتھ سے نکل جائے گا۔ اور اگر قرآن اس کو سمجھ آ گیا،" .

minaret:Segment_TQ2005-0319_0027 a minaret:TranscriptSegment ;
    minaret:endTime 288.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 282.78 ;
    minaret:text "اس کے دل میں اتر گیا، تو پھر یہ میرے بس میں نہیں رہے گا۔ کیونکہ اللہ تعالیٰ نے قرآن پاک میں فرمایا ہے:" .

minaret:Segment_TQ2005-0319_0030 a minaret:TranscriptSegment ;
    minaret:endTime 309.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0031 ;
    minaret:sequenceIndex 30 ;
    minaret:startTime 302.36 ;
    minaret:text "سمجھتے ہوئے بھی ادھر ادھر ہو جائے۔ یعنی وہ یہاں بھی، جیسے نماز میں سب سے زیادہ وسوسے ڈالتا ہے، اسی طرح قرآن پڑھتے وقت بھی بہت وسوسے ڈالتا ہے۔" .

minaret:Segment_TQ2005-0319_0031 a minaret:TranscriptSegment ;
    minaret:endTime 321.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0032 ;
    minaret:sequenceIndex 31 ;
    minaret:startTime 310.5 ;
    minaret:text "یہ تو بہت مشکل ہے اور یہ تو تمہارے بس کی بات نہیں اور کیا پتا اس کا معنی یہ نہ ہو کچھ اور ہو، اور اس طرح کی باتیں جو انسان کو اس سے پیچھے کر دیں، ہٹا دیں۔" .

minaret:Segment_TQ2005-0319_0032 a minaret:TranscriptSegment ;
    minaret:endTime 332.18 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0033 ;
    minaret:sequenceIndex 32 ;
    minaret:startTime 322.06 ;
    minaret:text "اس لیے بہتر ہے کہ جب انسان قرآن کھولے، پڑھنے لگے تو اعوذ باللہ کے ساتھ ابتدا کرے۔ لہٰذا آپ «اَعُوْذُ بِاللّٰهِ مِنَ الشَّیْطَانِ الرَّجِیْمِ» بھی پڑھ سکتے ہیں، «اَعُوْذُ بِاللّٰهِ" .

minaret:Segment_TQ2005-0319_0033 a minaret:TranscriptSegment ;
    minaret:endTime 342.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0034 ;
    minaret:sequenceIndex 33 ;
    minaret:startTime 332.18 ;
    minaret:text "السَّمِیْعِ الْعَلِیْمِ مِنَ الشَّیْطٰنِ الرَّجِیْمِ» بھی پڑھ سکتے ہیں، یعنی کسی بھی طرح اللہ تعالیٰ کی پناہ میں آئیں۔ اس کے بعد ہے: «بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ»" .

minaret:Segment_TQ2005-0319_0034 a minaret:TranscriptSegment ;
    minaret:endTime 348.34 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0035 ;
    minaret:sequenceIndex 34 ;
    minaret:startTime 343.32 ;
    minaret:text "اللہ کے نام سے جو بہت مہربان، بار بار رحم فرمانے والا ہے۔" .

minaret:Segment_TQ2005-0319_0035 a minaret:TranscriptSegment ;
    minaret:endTime 361.46 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0036 ;
    minaret:sequenceIndex 35 ;
    minaret:startTime 349.52 ;
    minaret:text "انسان جب بھی کوئی کام شروع کرتا ہے، کوئی نیا کام، کوئی اہم کام، کوئی قابلِ ذکر کام، تو عموماً وہ کسی کے بھروسے پہ کرتا ہے، ایسے ہی ہے نا؟" .

minaret:Segment_TQ2005-0319_0036 a minaret:TranscriptSegment ;
    minaret:endTime 372.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0037 ;
    minaret:sequenceIndex 36 ;
    minaret:startTime 362.46 ;
    minaret:text "کس کس کا بھروسہ لیتا ہے؟ کبھی اپنی طاقت: میں کر سکتی ہوں۔ کبھی اپنی ذہنی طاقت، کبھی قابلیت،" .

minaret:Segment_TQ2005-0319_0037 a minaret:TranscriptSegment ;
    minaret:endTime 387.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0038 ;
    minaret:sequenceIndex 37 ;
    minaret:startTime 373.24 ;
    minaret:text "کبھی صحت، کبھی اپنی عقل اور علم اور سمجھداری، اور انسان سمجھتا ہے کہ یہ تو میرا کمال ہے، میں کرنے والا ہوں، میں کر سکتا ہوں۔ یا پھر اپنے سے باہر کچھ اور چیزوں کا بھروسہ لیتا ہے:" .

minaret:Segment_TQ2005-0319_0038 a minaret:TranscriptSegment ;
    minaret:endTime 398.82 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0039 ;
    minaret:sequenceIndex 38 ;
    minaret:startTime 388.36 ;
    minaret:text "بچے کام آئیں گے یا یہ میرا مال کام آئے گا یا فلاں میرے دوست میرا ساتھ دیں گے یا فلاں انسان میری مدد کرے گا، ایسے ہی ہوتا ہے نا؟" .

minaret:Segment_TQ2005-0319_0039 a minaret:TranscriptSegment ;
    minaret:endTime 409.88 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0040 ;
    minaret:sequenceIndex 39 ;
    minaret:startTime 399.46 ;
    minaret:text "کوئی اہم کام آپ کرنے لگیں تو کیا خیال آتا ہے؟ ہے میرے پاس پیسے، میں کر سکتا ہوں، ہے مجھے اتنی سمجھ، میں خود یہ سیکھ سکتا ہوں۔" .

minaret:Segment_TQ2005-0319_0040 a minaret:TranscriptSegment ;
    minaret:endTime 422.0 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0041 ;
    minaret:sequenceIndex 40 ;
    minaret:startTime 411.04 ;
    minaret:text "تو یہ بالکل ایک قدرتی سی بات ہے کہ انسان جب بھی کوئی اہم کام، مثلاً آپ اگر آج کل کے حساب سے دیکھیں تو آپ کی زندگی میں اہم کام کیا ہوا ہے؟" .

minaret:Segment_TQ2005-0319_0041 a minaret:TranscriptSegment ;
    minaret:endTime 431.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0042 ;
    minaret:sequenceIndex 41 ;
    minaret:startTime 423.3 ;
    minaret:text "قرآن کا آغاز آپ کر رہے ہیں آج، یا اس کورس کا آغاز کیا آپ نے، تو آپ کے دل میں کیا خیال آیا؟" .

minaret:Segment_TQ2005-0319_0042 a minaret:TranscriptSegment ;
    minaret:endTime 441.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0043 ;
    minaret:sequenceIndex 42 ;
    minaret:startTime 433.1 ;
    minaret:text "میرے پاس گاڑی بھی ہے، میرے پاس وقت بھی ہے یا میری ہمت، توفیق بھی ہے، عقل ہے، سمجھ ہے، سب ہے اور میں کر سکتی ہوں۔" .

minaret:Segment_TQ2005-0319_0043 a minaret:TranscriptSegment ;
    minaret:endTime 457.56 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0044 ;
    minaret:sequenceIndex 43 ;
    minaret:startTime 442.82 ;
    minaret:text "قدرتی طور پر شیطان ایسی باتیں ذہن میں ڈالتا ہے اور عام رجحان بھی یہی ہوتا ہے کہ جب ہم کسی اہم کام کے کرنے کا سوچتے ہیں تو ہم سوچتے ہیں: آتا ہے مجھے، میں کر سکتا ہوں۔ کبھی اپنے علم پہ بھروسہ، کبھی اپنی طاقت پہ بھروسہ، کبھی کسی بھی خارجی امر پہ بھروسہ،" .

minaret:Segment_TQ2005-0319_0044 a minaret:TranscriptSegment ;
    minaret:endTime 468.7 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0045 ;
    minaret:sequenceIndex 44 ;
    minaret:startTime 458.54 ;
    minaret:text "کبھی اسباب پہ بھروسہ۔ ٹھیک ہے انسان کو اللہ تعالیٰ نے حکم دیا کہ اسباب کو استعمال کرے، لیکن اسباب پہ بھروسہ نہیں! تو کیا کرے؟" .

minaret:Segment_TQ2005-0319_0045 a minaret:TranscriptSegment ;
    minaret:endTime 477.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0046 ;
    minaret:sequenceIndex 45 ;
    minaret:startTime 469.36 ;
    minaret:text "«بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ»۔ اللہ! میرے میں طاقت نہیں، تیرے بھروسے پہ کام کرنے جا رہی ہوں، تو کرائے گا۔" .

minaret:Segment_TQ2005-0319_0046 a minaret:TranscriptSegment ;
    minaret:endTime 491.4 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0047 ;
    minaret:sequenceIndex 46 ;
    minaret:startTime 478.28 ;
    minaret:text "کیونکہ ہر چیز پر تیری رحمت چھائی ہوئی ہے۔ میں تیری رحمت کی وجہ سے اس قابل ہوں گی کہ میں یہ کر سکوں، پڑھ سکوں یا پڑھا سکوں یا آ سکوں یا اس پر عمل کر سکوں۔" .

minaret:Segment_TQ2005-0319_0047 a minaret:TranscriptSegment ;
    minaret:endTime 505.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0048 ;
    minaret:sequenceIndex 47 ;
    minaret:startTime 492.48 ;
    minaret:text "تو مومن کا طرزِ عمل کیا ہوتا ہے؟ کافر ہے تو شمشیر پہ کرتا ہے بھروسہ، وہ ایک عام شعر آپ نے پڑھا ہو گا نا کہ وہ اسباب پہ بھروسہ کرتے ہیں۔" .

minaret:Segment_TQ2005-0319_0048 a minaret:TranscriptSegment ;
    minaret:endTime 512.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0049 ;
    minaret:sequenceIndex 48 ;
    minaret:startTime 505.72 ;
    minaret:text "ان میں اور آپ میں فرق کیا ہے؟ مومن اسباب اختیار کرتا ہے، بھروسہ نہیں کرتا۔" .

minaret:Segment_TQ2005-0319_0049 a minaret:TranscriptSegment ;
    minaret:endTime 524.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0050 ;
    minaret:sequenceIndex 49 ;
    minaret:startTime 513.74 ;
    minaret:text "یہ ایک اندر ایک ایسا فرق آ جاتا ہے ایمان لانے کے بعد اور اللہ کے دین کی طرف آنے کے بعد کہ انسان حقیقی عاجزی اختیار کرتا ہے، ہر" .

minaret:Segment_TQ2005-0319_0050 a minaret:TranscriptSegment ;
    minaret:endTime 537.7 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0051 ;
    minaret:sequenceIndex 50 ;
    minaret:startTime 524.06 ;
    minaret:text "کمال اللہ کے لیے، ہر تعریف اللہ کے لیے، اور اپنی صرف کوشش۔ تو سب سے بہتر آغاز کسی بھی کام کے لیے کیا ہو سکتا ہے کہ انسان وہ کام کس طرح شروع کرے؟" .

minaret:Segment_TQ2005-0319_0051 a minaret:TranscriptSegment ;
    minaret:endTime 541.16 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0052 ;
    minaret:sequenceIndex 51 ;
    minaret:startTime 538.82 ;
    minaret:text "اللہ کے بھروسے پر شروع کرے۔" .

minaret:Segment_TQ2005-0319_0052 a minaret:TranscriptSegment ;
    minaret:endTime 554.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0053 ;
    minaret:sequenceIndex 52 ;
    minaret:startTime 543.22 ;
    minaret:text "تو ہمیں حکم کیا دیا گیا کہ ہم کیا کریں؟ اپنے کاموں کو کس سے شروع کریں؟ بسم اللہ سے۔ جیسے وضو کرتے وقت، کھانا کھاتے وقت، گھر میں داخل ہوتے وقت،" .

minaret:Segment_TQ2005-0319_0053 a minaret:TranscriptSegment ;
    minaret:endTime 569.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0054 ;
    minaret:sequenceIndex 53 ;
    minaret:startTime 556.74 ;
    minaret:text "گاڑی میں بیٹھتے وقت، تو جتنے بھی اہم کام ہیں تو ان کے شروع میں آپ کو کیا کرنا ہے؟ بسم اللہ پڑھنا ہے۔ اور اہم ترین کاموں میں سے اہم:" .

minaret:Segment_TQ2005-0319_0054 a minaret:TranscriptSegment ;
    minaret:endTime 579.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0055 ;
    minaret:sequenceIndex 54 ;
    minaret:startTime 570.92 ;
    minaret:text "قرآن پڑھنا! اس لیے قرآن کے آغاز میں بھی آپ کیا کرتے ہیں؟ «بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ» پڑھتے ہیں۔" .

minaret:Segment_TQ2005-0319_0056 a minaret:TranscriptSegment ;
    minaret:endTime 602.14 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0057 ;
    minaret:sequenceIndex 56 ;
    minaret:startTime 591.62 ;
    minaret:text "حمد نعمتوں کے اعتراف کے لیے ہوتا ہے، یا حمد کا معنی ہے نعمت کا اعتراف کرنا کہ یہ میرے رب نے ہی مجھے دی ہے۔" .

minaret:Segment_TQ2005-0319_0057 a minaret:TranscriptSegment ;
    minaret:endTime 612.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0058 ;
    minaret:sequenceIndex 57 ;
    minaret:startTime 602.74 ;
    minaret:text "یہ اسی کی طرف سے مجھے ملی۔ بندۂ مومن ہر خیر اور ہر بھلائی کے ملنے پر بھلائی دینے والے کو یاد کرتا ہے،" .

minaret:Segment_TQ2005-0319_0058 a minaret:TranscriptSegment ;
    minaret:endTime 626.18 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 613.04 ;
    minaret:text "اس کا شکر کرتا ہے، اس کی طرف رجوع کرتا ہے، اس کا اعتراف کرتا ہے کہ اس نے مجھے دی۔ تو یہ کلمہ جب وہ بولتا ہے تو یہ خالق کو خوش کرتا ہے، مالک کو خوش کرتا ہے۔" .

minaret:Segment_TQ2005-0319_0059 a minaret:TranscriptSegment ;
    minaret:endTime 634.64 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0060 ;
    minaret:sequenceIndex 59 ;
    minaret:startTime 626.74 ;
    minaret:text "اسی لیے جب ایک دفعہ انسان دل سے... ایک تو نا زبانی تکرار ہم کرتے رہتے ہیں، وہ بھی ٹھیک ہے، لیکن ایک یہ کہ دل سے" .

minaret:Segment_TQ2005-0319_0060 a minaret:TranscriptSegment ;
    minaret:endTime 645.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0061 ;
    minaret:sequenceIndex 60 ;
    minaret:startTime 635.44 ;
    minaret:text "کھانا کھاتا ہے یا پانی پیتا ہے یا کوئی بھی نعمت اس کو ملتی ہے جس سے وہ راحت اور سکون پاتا ہے یا خوشی ملتی ہے، چاہے وہ دیکھنے کی ہو، چاہے وہ کھانے کی ہو،" .

minaret:Segment_TQ2005-0319_0061 a minaret:TranscriptSegment ;
    minaret:endTime 660.36 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0062 ;
    minaret:sequenceIndex 61 ;
    minaret:startTime 646.38 ;
    minaret:text "چاہے وہ نیند جیسی نعمت ہو، تو وہ کیا کرتا ہے؟ فوراً اللہ کا شکر ادا کرتا ہے اور «الحمد للہ» کہتا ہے۔ تو جو شخص دل سے «الحمد للہ» کہتا ہے تو صحیح مسلم میں آتا ہے:" .

minaret:Segment_TQ2005-0319_0063 a minaret:TranscriptSegment ;
    minaret:endTime 672.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0064 ;
    minaret:sequenceIndex 63 ;
    minaret:startTime 664.94 ;
    minaret:text "«الحمد للہ» کا کہنا میزان کو بھر دیتا ہے، یعنی اللہ کے نزدیک اتنا پسندیدہ کلمہ ہے۔" .

minaret:Segment_TQ2005-0319_0064 a minaret:TranscriptSegment ;
    minaret:endTime 681.28 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0065 ;
    minaret:sequenceIndex 64 ;
    minaret:startTime 673.08 ;
    minaret:text "ہم اس کو فار گرانٹڈ لیتے ہیں: بھوک لگی ہے، کھانا ہے ہمارے پاس، کھا لیا، بس ٹھیک ہے۔ تو پھر حق تو نہیں ادا کیا، شکر تو نہیں ادا کیا۔" .

minaret:Segment_TQ2005-0319_0065 a minaret:TranscriptSegment ;
    minaret:endTime 688.64 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0066 ;
    minaret:sequenceIndex 65 ;
    minaret:startTime 682.6 ;
    minaret:text "ہمارے پیسے تھے، ہم بنا کے لائے تھے اور ہم نے کھا لیا، بس؟ نہیں!" .

minaret:Segment_TQ2005-0319_0066 a minaret:TranscriptSegment ;
    minaret:endTime 701.24 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0067 ;
    minaret:sequenceIndex 66 ;
    minaret:startTime 690.2 ;
    minaret:text "کتنے ہی لوگ ایسے ہیں جن کے پاس یہ سب کچھ نہیں ہے۔ اگر آپ کو اللہ نے دیا ہے، نوازا ہے، تو پھر دینے والے کا شکر ادا کرنا بھی لازم ہے۔" .

minaret:Segment_TQ2005-0319_0068 a minaret:TranscriptSegment ;
    minaret:endTime 727.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0069 ;
    minaret:sequenceIndex 68 ;
    minaret:startTime 717.74 ;
    minaret:text "اسی طرح «الحمد للہ» مختصر ترین ہے، لیکن حمد کے اور بھی کئی طریقے اور انداز ہیں جو مختلف مقامات پر ان کا اظہار" .

minaret:Segment_TQ2005-0319_0069 a minaret:TranscriptSegment ;
    minaret:endTime 740.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0070 ;
    minaret:sequenceIndex 69 ;
    minaret:startTime 727.84 ;
    minaret:text "کیا گیا۔ مثلاً بندۂ مومن صبح اٹھتا ہے تو «الحمد للہ» سے آغاز کرتا ہے، کھاتا ہے، پیتا ہے تو «الحمد للہ» پڑھتا ہے۔ پھر اسی طرح نماز میں رکوع کے بعد: «حَمْدًا كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ»" .

minaret:Segment_TQ2005-0319_0072 a minaret:TranscriptSegment ;
    minaret:endTime 775.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0073 ;
    minaret:sequenceIndex 72 ;
    minaret:startTime 761.84 ;
    minaret:text "الفاظ میں اس کا اظہار کرتا ہے۔ کیونکہ وہ جو اس سے پہلے میں نے لفظی وضاحت میں عرض کیا تھا کہ وہ جو ایک تھرل دل میں پیدا ہوتی ہے کسی نعمت کو دیکھ کر، تو اس کے بعد پھر بے ساختہ جو الفاظ زبان سے نکلتے ہیں،" .

minaret:Segment_TQ2005-0319_0073 a minaret:TranscriptSegment ;
    minaret:endTime 786.36 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0074 ;
    minaret:sequenceIndex 73 ;
    minaret:startTime 776.42 ;
    minaret:text "وہ اللہ کے ہاں بہت ہی ویلیو ایبل یا قدر کیے گئے الفاظ ہوتے ہیں۔ اس لیے ہم دیکھتے ہیں کہ جب کسی شخص نے آپ" .

minaret:Segment_TQ2005-0319_0074 a minaret:TranscriptSegment ;
    minaret:endTime 798.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0075 ;
    minaret:sequenceIndex 74 ;
    minaret:startTime 786.36 ;
    minaret:text "صلی اللہ علیہ وسلم کے پیچھے نماز پڑھتے وقت رکوع سے اٹھ کر یہ کہا تھا، تو آپ نے پوچھا تھا سلام پھیرنے کے بعد کہ یہ کس نے یہ کلمہ ادا کیا؟ کہا کہ میں نے دیکھا تیس سے زائد فرشتے لپکے اس کلمے کے اٹھانے کے لیے!" .

minaret:Segment_TQ2005-0319_0075 a minaret:TranscriptSegment ;
    minaret:endTime 809.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0076 ;
    minaret:sequenceIndex 75 ;
    minaret:startTime 799.26 ;
    minaret:text "یعنی اتنی بڑی بات اس نے کہی، اور وہ کیا تھی دراصل؟ محبت کا اظہار تھا، اپنے جذبات کا اظہار تھا کہ یا رب! تیرا شکر کیسے ادا کروں؟ کوئی اس کو نعمت یاد آئی ہو گی اللہ کی۔" .

minaret:Segment_TQ2005-0319_0076 a minaret:TranscriptSegment ;
    minaret:endTime 821.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0077 ;
    minaret:sequenceIndex 76 ;
    minaret:startTime 810.88 ;
    minaret:text "تو «الحمد للہ» کہنا بہترین الفاظ میں اللہ کی نعمت کا شکر ادا کرنا ہے۔ تو «اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِیْنَ»۔" .

minaret:Segment_TQ2005-0319_0077 a minaret:TranscriptSegment ;
    minaret:endTime 831.46 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0078 ;
    minaret:sequenceIndex 77 ;
    minaret:startTime 822.08 ;
    minaret:text "اور یہاں پر «رَبِّ الْعٰلَمِیْنَ» کیوں کہا گیا؟ کہ یا رب! تو مجھے بھی دیتا ہے اور تو تو پورے جہان کا پالنے والا ہے،" .

minaret:Segment_TQ2005-0319_0078 a minaret:TranscriptSegment ;
    minaret:endTime 842.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0079 ;
    minaret:sequenceIndex 78 ;
    minaret:startTime 832.02 ;
    minaret:text "سب کی نگہداشت کر رہا ہے، سب کو کھلا رہا ہے، پلا رہا ہے، تیرا کس کس طرح شکر ادا کیا جائے! «الرَّحْمٰنِ الرَّحِیْمِ»، بہت ہی مہربان ہے،" .

minaret:Segment_TQ2005-0319_0079 a minaret:TranscriptSegment ;
    minaret:endTime 856.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0080 ;
    minaret:sequenceIndex 79 ;
    minaret:startTime 843.96 ;
    minaret:text "بار بار رحم فرمانے والا ہے۔ وہ ہمیں نعمتیں دیتا ہے، ہم گناہ کرتے ہیں، وہ ہمیں پکڑتا نہیں۔ وہ ہمیں اتنا کچھ دیتا ہے جسے ہم گن نہیں سکتے،" .

minaret:Segment_TQ2005-0319_0085 a minaret:TranscriptSegment ;
    minaret:endTime 918.16 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0086 ;
    minaret:sequenceIndex 85 ;
    minaret:startTime 911.64 ;
    minaret:text "اور اس کا وہ مالک ہے۔ تو کیا تصور آتا ہے قیامت کے دن کا؟ مالک ہے، مالک!" .

minaret:Segment_TQ2005-0319_0086 a minaret:TranscriptSegment ;
    minaret:endTime 927.8 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0087 ;
    minaret:sequenceIndex 86 ;
    minaret:startTime 919.5 ;
    minaret:text "سارے ڈسیژنز اس کے ہاتھ میں ہیں، ہر چیز اس کے اختیار میں ہو گی، ہر چیز اس کی قدرت میں ہو گی، کمپلیٹلی وہ مالک!" .

minaret:Segment_TQ2005-0319_0094 a minaret:TranscriptSegment ;
    minaret:endTime 1018.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0095 ;
    minaret:sequenceIndex 94 ;
    minaret:startTime 1007.7 ;
    minaret:text "اور آپ نے یہ دنیا میں محسوس کیا ہو گا نا، بعض وقت آپ کی زبان سے کوئی ایک بات نکل جاتی ہے تو فوراً ہی پکڑی جاتی ہے، ہوتا ہے نا ایسے؟ ہم دعویٰ کرتے ہیں: یہ کام تو میں کل ضروری کر لوں گی،" .

minaret:Segment_TQ2005-0319_0095 a minaret:TranscriptSegment ;
    minaret:endTime 1029.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0096 ;
    minaret:sequenceIndex 95 ;
    minaret:startTime 1018.74 ;
    minaret:text "یہ کیا مشکل ہے، یہ چیز تو ایسے ہے۔ اور پھر اللہ تعالیٰ بتاتے ہیں کہ اچھا، تم سمجھتے ہو یہ سب تمہارا کمال ہے؟ تو «مٰلِكِ یَوْمِ الدِّیْنِ»، مالک ہے روزِ جزا کا۔" .

minaret:Segment_TQ2005-0319_0097 a minaret:TranscriptSegment ;
    minaret:endTime 1052.0 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0098 ;
    minaret:sequenceIndex 97 ;
    minaret:startTime 1043.52 ;
    minaret:text "کیونکہ مالک جو تو ہے، کوئی اور ہے نہیں نا کہ اس کے وفادار ہوں۔ صرف تیری ہم عبادت کرتے ہیں، صرف تیری!" .

minaret:Segment_TQ2005-0319_0098 a minaret:TranscriptSegment ;
    minaret:endTime 1063.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0099 ;
    minaret:sequenceIndex 98 ;
    minaret:startTime 1052.92 ;
    minaret:text "اور عبادت میں کیا؟ عاجزی اور محبت، کہ محبت کے ساتھ تیرے آگے جھکے ہوئے ہیں، تجھ سے ڈرتے بھی ہیں اور تیرے آگے سر رکھے ہوئے ہیں۔" .

minaret:Segment_TQ2005-0319_0099 a minaret:TranscriptSegment ;
    minaret:endTime 1074.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0100 ;
    minaret:sequenceIndex 99 ;
    minaret:startTime 1064.1 ;
    minaret:text "عبادت کی اعلیٰ ترین شکل کیا ہے؟ سجدہ، جس میں انسان واقعی عاجزی کا فزیکلی ثبوت دیتا ہے۔ سب سے چھوٹی شیپ ہو جاتی ہے بندے کی، اور انسان اپنا" .

minaret:Segment_TQ2005-0319_0100 a minaret:TranscriptSegment ;
    minaret:endTime 1083.56 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0101 ;
    minaret:sequenceIndex 100 ;
    minaret:startTime 1074.1 ;
    minaret:text "ناک اور اپنا ماتھا، جو دونوں انسان کی عزت کی علامت ہیں، یہ زمین پر ٹیک دیتا ہے اپنے رب کے حضور۔ اور یہ پیشانی صرف اسی کے آگے جھکنی چاہیے،" .

minaret:Segment_TQ2005-0319_0101 a minaret:TranscriptSegment ;
    minaret:endTime 1099.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0102 ;
    minaret:sequenceIndex 101 ;
    minaret:startTime 1084.48 ;
    minaret:text "یہ ناک صرف اسی کے آگے زمین پر لگنا چاہیے۔ تو «اِیَّاكَ نَعْبُدُ»، صرف تیری ہم عبادت کرتے ہیں، «وَاِیَّاكَ نَسْتَعِیْنُ»، صرف تجھ سے ہم مدد چاہتے ہیں۔ دنیا میں جو بھی ہماری مشکلات ہیں ان میں بھی" .

minaret:Segment_TQ2005-0319_0103 a minaret:TranscriptSegment ;
    minaret:endTime 1122.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0104 ;
    minaret:sequenceIndex 103 ;
    minaret:startTime 1111.36 ;
    minaret:text "لیکن جس کی ہمیں عبادت کرنی ہے، مرضی بھی تو اسی کی دیکھنی ہے نا! اب عبادت کے نام پہ ہم خود سے کام تھوڑی ایجاد کر سکتے ہیں کہ عبادت اس کی ہو رہی ہے اور کام اپنی مرضی کے ہو رہے ہیں، اور اس کو ہم عبادت کا نام دے دیں؟" .

minaret:Segment_TQ2005-0319_0104 a minaret:TranscriptSegment ;
    minaret:endTime 1129.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0105 ;
    minaret:sequenceIndex 104 ;
    minaret:startTime 1123.8 ;
    minaret:text "خود ساختہ چیزیں دین میں ایجاد کر لیں، دین کے نام پہ، اللہ کے نام پر من مانے کام شروع کر دیں۔" .

minaret:Segment_TQ2005-0319_0105 a minaret:TranscriptSegment ;
    minaret:endTime 1133.46 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0106 ;
    minaret:sequenceIndex 105 ;
    minaret:startTime 1129.12 ;
    minaret:text "عبادت کس کو کہتے ہیں؟" .

minaret:Segment_TQ2005-0319_0106 a minaret:TranscriptSegment ;
    minaret:endTime 1140.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0107 ;
    minaret:sequenceIndex 106 ;
    minaret:startTime 1133.46 ;
    minaret:text "اللہ کے سامنے جھکنا، اللہ کی اطاعت کرنا، اللہ کی بات ماننا، اور انتہائی محبت کے ساتھ، مصیبت سمجھ کے نہیں، بوجھ سمجھ کے نہیں۔" .

minaret:Segment_TQ2005-0319_0107 a minaret:TranscriptSegment ;
    minaret:endTime 1150.7 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0108 ;
    minaret:sequenceIndex 107 ;
    minaret:startTime 1141.7 ;
    minaret:text "تو اس کے لیے ہمیں پھر سیدھا راستہ چاہیے تاکہ ہم اس کو راضی کر سکیں۔ تو «اِهْدِنَا الصِّرَاطَ الْمُسْتَقِیْمَ»، تو ہمیں سیدھا راستہ دکھا دے،" .

minaret:Segment_TQ2005-0319_0108 a minaret:TranscriptSegment ;
    minaret:endTime 1158.0 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0109 ;
    minaret:sequenceIndex 108 ;
    minaret:startTime 1151.38 ;
    minaret:text "یعنی ایسا راستہ کہ جو ہمیں تجھ سے ملا دے، وہ راستہ ہم پر کھول بھی دے،" .

minaret:Segment_TQ2005-0319_0109 a minaret:TranscriptSegment ;
    minaret:endTime 1165.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0110 ;
    minaret:sequenceIndex 109 ;
    minaret:startTime 1158.86 ;
    minaret:text "پھر چلنے کی توفیق بھی دے، کیونکہ بعض وقت پتا تو چل جاتا ہے یہ راستہ جاتا ہے، ہم ہی کم ہمت ہو جاتے ہیں،" .

minaret:Segment_TQ2005-0319_0110 a minaret:TranscriptSegment ;
    minaret:endTime 1179.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0111 ;
    minaret:sequenceIndex 110 ;
    minaret:startTime 1167.04 ;
    minaret:text "چلا بھی اور پھر آخری دم تک چلا کہ منزل تک پہنچیں! کیونکہ جیسے کہ وہ میں نے حدیث آپ کو سنائی تھی کہ آپ صلی اللہ علیہ وسلم نے ایک مرتبہ زمین پر ایک سیدھا خط کھینچا،" .

minaret:Segment_TQ2005-0319_0111 a minaret:TranscriptSegment ;
    minaret:endTime 1194.62 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0112 ;
    minaret:sequenceIndex 111 ;
    minaret:startTime 1180.34 ;
    minaret:text "اور اس کے دائیں بائیں آڑے خط کھینچے۔ پھر فرمایا کہ یہ اللہ تعالیٰ کا راستہ ہے اور یہ آڑے ترچھے خط پگڈنڈیاں ہیں، اور ان میں سے ہر پگڈنڈی پہ کوئی نہ کوئی شیطان بیٹھا ہوا ہے جو اس کو اپنی طرف بلا رہا ہے۔" .

minaret:Segment_TQ2005-0319_0112 a minaret:TranscriptSegment ;
    minaret:endTime 1205.02 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0113 ;
    minaret:sequenceIndex 112 ;
    minaret:startTime 1195.2 ;
    minaret:text "کہیں نفس ہے اپنا ہی، کہیں کوئی انسان ہے، کہیں کوئی اور چیز ہے، اور انسان قدم قدم پہ بھول جاتا ہے کیونکہ یہ سب سامنے نظر آتے ہیں،" .

minaret:Segment_TQ2005-0319_0113 a minaret:TranscriptSegment ;
    minaret:endTime 1219.02 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0114 ;
    minaret:sequenceIndex 113 ;
    minaret:startTime 1205.8 ;
    minaret:text "اور اللہ کا راستہ ہمیں دھندلا جاتا ہے۔ تو «اِهْدِنَا الصِّرَاطَ الْمُسْتَقِیْمَ»، اور ہر روز کی، ہر نماز کی، ہر رکعت میں ہم یہی مانگتے ہیں، کیونکہ ہم ہر نماز کے بعد پھر بھول جاتے ہیں۔" .

minaret:Segment_TQ2005-0319_0114 a minaret:TranscriptSegment ;
    minaret:endTime 1230.0 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0115 ;
    minaret:sequenceIndex 114 ;
    minaret:startTime 1219.76 ;
    minaret:text "پھر نئے سرے سے پھر کھڑے ہوتے ہیں، پھر یہی مانگتے ہیں۔ کبھی آپ نے سوچا کہ یہ اتنی ریپیٹیشن کیوں سورۃ الفاتحہ کی؟ اور جیسا کہ آپ جانتے ہیں کہ نماز ہوتی ہی نہیں کس کے بغیر؟" .

minaret:Segment_TQ2005-0319_0115 a minaret:TranscriptSegment ;
    minaret:endTime 1242.64 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0116 ;
    minaret:sequenceIndex 115 ;
    minaret:startTime 1230.68 ;
    minaret:text "سورۃ الفاتحہ کے بغیر! یعنی جس نماز میں سورۃ الفاتحہ نہ ہو وہ نماز، نماز ہی نہیں۔ حضرت ابوہریرہ رضی اللہ عنہ فرماتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا:" .

minaret:Segment_TQ2005-0319_0116 a minaret:TranscriptSegment ;
    minaret:endTime 1255.56 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0117 ;
    minaret:sequenceIndex 116 ;
    minaret:startTime 1243.28 ;
    minaret:text "جس نے نماز پڑھی اور اس میں ام القرآن نہ پڑھی، نماز تو پڑھی یہ سورت نہیں پڑھی، اس کی نماز ناقص ہے، ناقص ہے، ناقص ہے، ناتمام ہے۔" .

minaret:Segment_TQ2005-0319_0117 a minaret:TranscriptSegment ;
    minaret:endTime 1265.5 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0118 ;
    minaret:sequenceIndex 117 ;
    minaret:startTime 1256.4 ;
    minaret:text "ابوہریرہ سے ایک صحابی نے پوچھا: اے ابوہریرہ! کبھی میں امام کے پیچھے ہوتا ہوں تو پھر میں کیا کروں؟ ابوہریرہ نے فرمایا:" .

minaret:Segment_TQ2005-0319_0118 a minaret:TranscriptSegment ;
    minaret:endTime 1276.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0119 ;
    minaret:sequenceIndex 118 ;
    minaret:startTime 1266.14 ;
    minaret:text "فارسی کے بیٹے! دل میں پڑھ لیا کرو، کیونکہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو یہ کہتے ہوئے سنا کہ اللہ تعالیٰ نے فرمایا: میں نے نماز کو" .

minaret:Segment_TQ2005-0319_0127 a minaret:TranscriptSegment ;
    minaret:endTime 1379.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0128 ;
    minaret:sequenceIndex 127 ;
    minaret:startTime 1369.02 ;
    minaret:text "تو نماز ہو یا نماز کے علاوہ، سورۃ الفاتحہ صرف پڑھی نہیں جاتی، اس کے آدھے حصے میں اللہ تعالیٰ" .

minaret:Segment_TQ2005-0319_0128 a minaret:TranscriptSegment ;
    minaret:endTime 1385.5 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0129 ;
    minaret:sequenceIndex 128 ;
    minaret:startTime 1379.1 ;
    minaret:text "کی تعریف اور حمد بیان کی جاتی ہے اور دوسرے حصے میں اس سے کچھ مانگا جاتا ہے۔" .

minaret:Segment_TQ2005-0319_0129 a minaret:TranscriptSegment ;
    minaret:endTime 1394.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0130 ;
    minaret:sequenceIndex 129 ;
    minaret:startTime 1387.1 ;
    minaret:text "تو جو اچھے سے تعریف کرتا ہے اور پھر اچھے طریقے سے مانگتا ہے، وہ محروم نہیں رہتا۔" .

minaret:Segment_TQ2005-0319_0130 a minaret:TranscriptSegment ;
    minaret:endTime 1404.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0131 ;
    minaret:sequenceIndex 130 ;
    minaret:startTime 1395.94 ;
    minaret:text "تو اس سے پتا چلتا ہے کہ یہ انتہائی اہم سورتوں میں سے ہے جس میں انتہائی اہم دعا مانگی گئی ہے، اور زندگی کی اہم ترین دعا کیا ہے؟" .

minaret:Segment_TQ2005-0319_0131 a minaret:TranscriptSegment ;
    minaret:endTime 1415.72 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0132 ;
    minaret:sequenceIndex 131 ;
    minaret:startTime 1406.26 ;
    minaret:text "سیدھے راستے کی رہنمائی کی دعا! اب ہم ہر روز مانگتے ہیں: اللہ دکھا! اللہ تعالیٰ کہتا ہے یہ کتاب ہے، دیکھو! اس کو ہم کھولتے نہیں۔" .

minaret:Segment_TQ2005-0319_0132 a minaret:TranscriptSegment ;
    minaret:endTime 1427.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0133 ;
    minaret:sequenceIndex 132 ;
    minaret:startTime 1416.64 ;
    minaret:text "ساری دنیا کے علوم پڑھیں گے، اس کو نہیں پڑھنا چاہتے۔ کیسے راستہ پتا چلے؟ اگر آپ کو یہاں سے کسی دوسرے شہر میں جانا ہو تو نقشہ لیتے ہیں یا نہیں؟" .

minaret:Segment_TQ2005-0319_0133 a minaret:TranscriptSegment ;
    minaret:endTime 1437.72 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0134 ;
    minaret:sequenceIndex 133 ;
    minaret:startTime 1428.36 ;
    minaret:text "یا ایسے ہی چل پڑتے ہیں ہائی وے پر کہ میں نے ڈرائیونگ لائسنس لے لیا ہے، میں نے ڈرائیونگ ٹیسٹ پاس کر لیا، میں گاڑی چلا سکتی ہوں میں جا رہی ہوں؟ ایسے تھوڑی کرتے ہیں! کیا کرتے ہیں؟" .

minaret:Segment_TQ2005-0319_0134 a minaret:TranscriptSegment ;
    minaret:endTime 1453.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0135 ;
    minaret:sequenceIndex 134 ;
    minaret:startTime 1439.52 ;
    minaret:text "میپ لے کے، ڈائریکشنز لے کے۔ ڈائریکشنز لیتے ہیں کہیں نکلنے سے پہلے یا ایسے ہی اندازاً چل پڑتے ہیں کہ وہ جہاں گاڑیاں جا رہی ہوں گی پیچھے پیچھے میں بھی چلی جاؤں گی؟ ایسے تھوڑی جاتے ہیں، معلوم نہیں کون کدھر جا رہا ہے، مجھے تو وہاں جانا ہے جہاں میری ضرورت ہے۔" .

minaret:Segment_TQ2005-0319_0135 a minaret:TranscriptSegment ;
    minaret:endTime 1462.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0136 ;
    minaret:sequenceIndex 135 ;
    minaret:startTime 1454.52 ;
    minaret:text "تو مجھے کسی اور پر ڈیپنڈ نہیں کرنا۔ اگر کبھی بھی آپ کسی اور گاڑی کو فالو کرتے ہوئے اپنی منزل پہ پہنچنے لگے تو کیا ہو گا؟ کہیں اور ہی پہنچ جائیں گے!" .

minaret:Segment_TQ2005-0319_0136 a minaret:TranscriptSegment ;
    minaret:endTime 1473.16 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0137 ;
    minaret:sequenceIndex 136 ;
    minaret:startTime 1463.22 ;
    minaret:text "تو اس طرح آپ صرف معاشرے کو، لوگوں کی بھیڑ کو، لوگوں کے چلنے کو دیکھ کر کہ چلو تم ادھر کو ہوا ہو جدھر کی، اور جدھر لوگ" .

minaret:Segment_TQ2005-0319_0137 a minaret:TranscriptSegment ;
    minaret:endTime 1483.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0138 ;
    minaret:sequenceIndex 137 ;
    minaret:startTime 1473.16 ;
    minaret:text "جا رہے ہیں، ریلا جا رہا ہے عوام الناس کا، تم بھی وہی کرتے رہو، نہ اپنی عقل سے سوچو اور نہ اچھے برے کی تمیز جانو، اور کہو کہ ہم تو جنت میں پہنچنے کے کام کر رہے ہیں" .

minaret:Segment_TQ2005-0319_0138 a minaret:TranscriptSegment ;
    minaret:endTime 1493.16 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0139 ;
    minaret:sequenceIndex 138 ;
    minaret:startTime 1483.2 ;
    minaret:text "اور پہنچ جائیں گے اپنی منزل پہ، تو یہ خود کو دھوکا دینا ہے۔ اگر آپ واقعی اللہ کی رضا تک پہنچنا چاہتے ہیں، ابدی خوشیوں تک پہنچنا چاہتے ہیں تو لازم ہے کہ راستہ دیکھیں۔" .

minaret:Segment_TQ2005-0319_0140 a minaret:TranscriptSegment ;
    minaret:endTime 1513.94 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0141 ;
    minaret:sequenceIndex 140 ;
    minaret:startTime 1504.68 ;
    minaret:text "اور پھر چلتے چلتے رک نہ جائیں بلکہ مرتے دم تک چلیں! یہ دعا ہے جو ہم مانگتے ہیں نماز میں: «اِهْدِنَا الصِّرَاطَ الْمُسْتَقِیْمَ»۔" .

minaret:Segment_TQ2005-0319_0142 a minaret:TranscriptSegment ;
    minaret:endTime 1534.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0143 ;
    minaret:sequenceIndex 142 ;
    minaret:startTime 1524.74 ;
    minaret:text "مجھے ان لوگوں کا راستہ چاہیے جن کو تُو نے نوازا، ہدایت سے نوازا، نعمتوں سے نوازا، اپنی رضا سے نوازا، اور جن کو تُو نے اس" .

minaret:Segment_TQ2005-0319_0143 a minaret:TranscriptSegment ;
    minaret:endTime 1542.92 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0144 ;
    minaret:sequenceIndex 143 ;
    minaret:startTime 1534.6 ;
    minaret:text "منزل تک پہنچا دیا، مجھے بھی ویسا ہی بنا دے۔ جن بندوں سے تُو محبت کرتا ہے، مجھے بھی تُو ویسا ہی بنا دے۔" .

minaret:Segment_TQ2005-0319_0144 a minaret:TranscriptSegment ;
    minaret:endTime 1553.36 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0145 ;
    minaret:sequenceIndex 144 ;
    minaret:startTime 1544.26 ;
    minaret:text "اے اللہ! مجھے اپنی محبت دے، اس کی محبت دے جو تجھ سے محبت کرتا ہو۔ محبت کرنے کا بھی ایک معیار ہے، ہر ایک سے نہیں محبت کی جا سکتی۔" .

minaret:Segment_TQ2005-0319_0145 a minaret:TranscriptSegment ;
    minaret:endTime 1564.44 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0146 ;
    minaret:sequenceIndex 145 ;
    minaret:startTime 1554.32 ;
    minaret:text "مجھے اس کی محبت دے جو تجھ سے محبت کرتا ہے، اور «وَحُبَّ عَمَلٍ يُقَرِّبُنِي إِلَىٰ حُبِّكَ»، اور ایسے کاموں کی محبت" .

minaret:Segment_TQ2005-0319_0146 a minaret:TranscriptSegment ;
    minaret:endTime 1574.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0147 ;
    minaret:sequenceIndex 146 ;
    minaret:startTime 1564.44 ;
    minaret:text "دے، ان کاموں سے محبت دے، ان کاموں میں میرا دل لگا دے جو مجھے تیری محبت دے دیں، جس چیز سے مجھے تیری محبت مل جائے۔" .

minaret:Segment_TQ2005-0319_0149 a minaret:TranscriptSegment ;
    minaret:endTime 1611.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0150 ;
    minaret:sequenceIndex 149 ;
    minaret:startTime 1601.46 ;
    minaret:text "جتنے بھی اللہ کے نیک بندے، پیغمبر ہیں، ان سب کی سب سے بڑی تڑپ یہی ہوتی تھی کہ یا رب! اپنے پیاروں کے ساتھ ملا دے، «وَّاَلْحِقْنِیْ بِالصّٰلِحِیْنَ»۔" .

minaret:Segment_TQ2005-0319_0150 a minaret:TranscriptSegment ;
    minaret:endTime 1622.94 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0151 ;
    minaret:sequenceIndex 150 ;
    minaret:startTime 1611.3 ;
    minaret:text "«وَاَدْخِلْنِیْ بِرَحْمَتِكَ فِیْ عِبَادِكَ الصّٰلِحِیْنَ»۔ تو ہمیں اپنے لیے بھی روز کیا مانگنا ہے؟ اے اللہ! جن بندوں سے تو راضی ہے،" .

minaret:Segment_TQ2005-0319_0151 a minaret:TranscriptSegment ;
    minaret:endTime 1633.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0152 ;
    minaret:sequenceIndex 151 ;
    minaret:startTime 1623.52 ;
    minaret:text "ہمیں بھی ان میں شامل کر، ہمارا نام بھی اسی رجسٹر میں لکھ دے، ہمیں بھی ان جیسے کام کرنے کی توفیق دے: «صِرَاطَ الَّذِیْنَ" .

minaret:Segment_TQ2005-0319_0152 a minaret:TranscriptSegment ;
    minaret:endTime 1645.44 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0153 ;
    minaret:sequenceIndex 152 ;
    minaret:startTime 1634.7 ;
    minaret:text "اَنْعَمْتَ عَلَیْهِمْ»، انعام یافتہ لوگوں جیسا بنا دے۔ اور وہ کون ہیں؟ انبیاء ہیں، اولیاء ہیں، شہداء ہیں، صالحین ہیں۔ سورۃ النساء کی آیت 69 میں ہے:" .

minaret:Segment_TQ2005-0319_0155 a minaret:TranscriptSegment ;
    minaret:endTime 1675.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0156 ;
    minaret:sequenceIndex 155 ;
    minaret:startTime 1664.3 ;
    minaret:text "مغضوب علیہم وہ لوگ ہوتے ہیں جو علم پانے کے بعد بھٹکتے ہیں۔ مغضوب علیہم کون ہوتے ہیں؟ جو علم پانے کے بعد بھٹکتے ہیں،" .

minaret:Segment_TQ2005-0319_0156 a minaret:TranscriptSegment ;
    minaret:endTime 1687.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0157 ;
    minaret:sequenceIndex 156 ;
    minaret:startTime 1676.66 ;
    minaret:text "اور ضالین وہ ہوتے ہیں جو بغیر علم کے بھٹکتے ہیں۔ بھٹکنے والوں کی دو قسمیں ہیں۔ ہمیں سیدھا راستہ چاہیے نا، مغضوب علیہم اور ضالین کا نہیں چاہیے۔" .

minaret:Segment_TQ2005-0319_0157 a minaret:TranscriptSegment ;
    minaret:endTime 1701.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0158 ;
    minaret:sequenceIndex 157 ;
    minaret:startTime 1688.44 ;
    minaret:text "راستہ گم نہیں کرنا ہم نے، تو کون ہیں جو راستہ گم کیے ہوئے ہیں؟ نمبر ایک: جن پر اللہ کا غضب ہوا، اللہ کی ناراضگی ہوئی ہے، کہ ان کو پتا تھا پھر غلط کام کیے۔ اللہ کیسے ناراض ہوتا ہے؟" .

minaret:Segment_TQ2005-0319_0158 a minaret:TranscriptSegment ;
    minaret:endTime 1714.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0159 ;
    minaret:sequenceIndex 158 ;
    minaret:startTime 1702.78 ;
    minaret:text "جان بوجھ کے غلط کام کرتا ہے، اس پر غضب بھڑکتا ہے۔ آپ نے دیکھا ہو گا کہ آپ کا بچہ جب غلطی کرتا ہے، اس کو پتا نہیں ہوتا، تو آپ کیا کرتے ہیں؟ اگنور کر دیتے ہیں،" .

minaret:Segment_TQ2005-0319_0159 a minaret:TranscriptSegment ;
    minaret:endTime 1725.2 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0160 ;
    minaret:sequenceIndex 159 ;
    minaret:startTime 1715.52 ;
    minaret:text "سمجھا دیتے ہیں، اگنور کر دیتے ہیں، پتا نہیں اس کو۔ لیکن جب پتا ہو، جان بوجھ کے کرے، غصہ آتا ہے کبھی آپ کو؟ آتا ہے غصہ؟" .

minaret:Segment_TQ2005-0319_0160 a minaret:TranscriptSegment ;
    minaret:endTime 1734.34 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0161 ;
    minaret:sequenceIndex 160 ;
    minaret:startTime 1726.72 ;
    minaret:text "اللہ کا غصہ بھی ان لوگوں پر ہوتا ہے کہ جو پتا چل جانے کے بعد غلط کام کرتے ہیں، اور اس میں" .

minaret:Segment_TQ2005-0319_0162 a minaret:TranscriptSegment ;
    minaret:endTime 1760.44 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0163 ;
    minaret:sequenceIndex 162 ;
    minaret:startTime 1748.6 ;
    minaret:text "کیا ہی نہیں وہ کچھ جو دعوے ہو رہے ہیں! انتہائی اللہ کا غصہ بھڑکانے والی بات۔ بعض اوقات آپ کہتے ہیں نا: میں نے یہ بھی کیا، میں نے یہ بھی کیا، میں نے یہ بھی کیا، حالانکہ کچھ نہیں کیا ہوتا۔" .

minaret:Segment_TQ2005-0319_0163 a minaret:TranscriptSegment ;
    minaret:endTime 1772.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0164 ;
    minaret:sequenceIndex 163 ;
    minaret:startTime 1761.46 ;
    minaret:text "«لِمَ تَقُوْلُوْنَ مَا لَا تَفْعَلُوْنَ»، جو کیا نہیں وہ کہہ کیوں رہے ہو کہ کیا ہے؟ تو ایسے تمام کام جن میں غلط بیانی ہو، یہ اللہ کے غضب کو بھڑکانے والی چیز ہے۔" .

minaret:Segment_TQ2005-0319_0164 a minaret:TranscriptSegment ;
    minaret:endTime 1785.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0165 ;
    minaret:sequenceIndex 164 ;
    minaret:startTime 1773.72 ;
    minaret:text "اسی طرح بعض وقت آپ کا کوئی ارادہ نہیں کرنے کا، یعنی نمبر ایک: کیا ہی نہیں اور کہہ رہے ہیں کہ کیا ہے، نمبر دو: ارادہ ہی کوئی نہیں کرنے کا اور کہہ رہے ہیں کہ ہم کریں گے۔" .

minaret:Segment_TQ2005-0319_0165 a minaret:TranscriptSegment ;
    minaret:endTime 1797.62 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0166 ;
    minaret:sequenceIndex 165 ;
    minaret:startTime 1785.9 ;
    minaret:text "«لِمَ تَقُوْلُوْنَ مَا لَا تَفْعَلُوْنَ»، جو کرنا نہیں وہ کیوں کہہ رہے ہیں کہ کریں گے جب اندر نیت ہی کوئی نہیں؟ بعض وقت کوئی ہم سے کچھ مانگتا ہے یا کوئی بات پوچھتے ہیں، ہم کہیں: ہاں کریں گے، کریں گے! کرنا دھرنا کچھ نہیں، اندر نیت ہے ہی نہیں کرنے کی،" .

minaret:Segment_TQ2005-0319_0166 a minaret:TranscriptSegment ;
    minaret:endTime 1804.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0167 ;
    minaret:sequenceIndex 166 ;
    minaret:startTime 1798.22 ;
    minaret:text "اور صرف جھوٹ سے دوسرے کو بہلا رہے ہیں، تو یہ چیز اللہ کے غضب کو بھڑکانے والی ہوتی ہے۔" .

minaret:Segment_TQ2005-0319_0167 a minaret:TranscriptSegment ;
    minaret:endTime 1813.22 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0168 ;
    minaret:sequenceIndex 167 ;
    minaret:startTime 1805.78 ;
    minaret:text "پچھلی قوموں میں سے جتنی بھی قومیں برباد ہوئیں، سب سے پہلے کس کے اوپر تباہی آئی؟ قومِ نوح،" .

minaret:Segment_TQ2005-0319_0168 a minaret:TranscriptSegment ;
    minaret:endTime 1824.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0169 ;
    minaret:sequenceIndex 168 ;
    minaret:startTime 1813.88 ;
    minaret:text "پھر ہود، صالح، ان پیغمبروں کی جو قومیں تھیں عاد و ثمود وغیرہ، ان پہ اللہ ناراض ہوا نا؟ تباہ ہوئیں نا یہ قومیں یا نہیں؟" .

minaret:Segment_TQ2005-0319_0169 a minaret:TranscriptSegment ;
    minaret:endTime 1837.14 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0170 ;
    minaret:sequenceIndex 169 ;
    minaret:startTime 1824.98 ;
    minaret:text "پھر کرتے کرتے آگے بنی اسرائیل پہ اللہ کا غضب ہوا۔ تو اللہ تعالیٰ ایسے ہی نہیں کسی قوم کو تباہ کرتا جب تک کہ اس کے اوپر حجت تمام نہ کر دے، اس تک حق نہ پہنچا دے۔" .

minaret:Segment_TQ2005-0319_0170 a minaret:TranscriptSegment ;
    minaret:endTime 1842.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0171 ;
    minaret:sequenceIndex 170 ;
    minaret:startTime 1837.66 ;
    minaret:text "اللہ تعالیٰ نے حق پہنچایا، پیغمبر بھیجے۔ حضرت نوح علیہ السلام کیا کہتے ہیں؟" .

minaret:Segment_TQ2005-0319_0172 a minaret:TranscriptSegment ;
    minaret:endTime 1854.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0173 ;
    minaret:sequenceIndex 172 ;
    minaret:startTime 1845.06 ;
    minaret:text "رات دن پکارا، چپکے چپکے بھی پکارا، بلند آواز سے، ہر طرح بتایا، اور پھر سن کے نہیں دیا تو پھر سب کو ڈبو دیا اللہ نے، اللہ کا غضب ٹوٹا!" .

minaret:Segment_TQ2005-0319_0173 a minaret:TranscriptSegment ;
    minaret:endTime 1865.22 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0174 ;
    minaret:sequenceIndex 173 ;
    minaret:startTime 1855.7 ;
    minaret:text "یہ اس طرح کی جو آفات ہوتی ہیں وہ ایک طرح سے اللہ کا غضب بھی ہوتی ہیں کہ جب کسی کے اندر کوئی خیر باقی نہیں رہتی تو پھر صفایا ہوتا ہے کہ یہ کوڑا کرکٹ ہے، صاف کرو اس کو، یہ جینے کے لائق نہیں۔" .

minaret:Segment_TQ2005-0319_0174 a minaret:TranscriptSegment ;
    minaret:endTime 1878.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0175 ;
    minaret:sequenceIndex 174 ;
    minaret:startTime 1866.28 ;
    minaret:text "تو اے اللہ! ہمیں ایسے لوگوں میں شامل نہ کرنا جن سے تو ناراض ہوتا ہے۔ یہ سمپل معنی ہے۔ ہم جب اس کی تفسیر کرتے ہیں، کبھی کسی ایک قوم، دو قوموں کے اوپر نام لگا دیتے ہیں کہ یہ مغضوب ہیں، اور پھر کہتے ہیں ہم تو الحمد للہ" .

minaret:Segment_TQ2005-0319_0175 a minaret:TranscriptSegment ;
    minaret:endTime 1887.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0176 ;
    minaret:sequenceIndex 175 ;
    minaret:startTime 1879.04 ;
    minaret:text "ہدایت یافتہ ہیں! حالانکہ کام ہم بھی وہی کر رہے تھے جو انہوں نے کیا۔ جیسے آپ نے فرمایا: تم ہر اس کھوہ میں گھسو گے جہاں بنی اسرائیل یا پہلی قومیں گھسیں۔" .

minaret:Segment_TQ2005-0319_0176 a minaret:TranscriptSegment ;
    minaret:endTime 1898.0 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0177 ;
    minaret:sequenceIndex 176 ;
    minaret:startTime 1888.42 ;
    minaret:text "تو سب غلط کام کر کے پھر ہم کہیں اللہ ہم سے راضی ہے؟ آج آپ دیکھیں، مجموعی طور پر مسلمانوں کا حال کیا ہے؟ کبھی سوچا کیوں؟" .

minaret:Segment_TQ2005-0319_0177 a minaret:TranscriptSegment ;
    minaret:endTime 1908.92 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0178 ;
    minaret:sequenceIndex 177 ;
    minaret:startTime 1898.74 ;
    minaret:text "ہر وقت دوسروں کو بلیم کرتے ہیں: وہ فلاں نے ہمارے پر بڑا ظلم کیا، فلاں نے سازش کی، فلاں نے... سب یہی بولی بول رہے ہوتے ہیں۔ کبھی نہیں سوچتے ہم نے بھی تو کچھ کیا ہو گا، وہ ہم نے کیا کیا؟" .

minaret:Segment_TQ2005-0319_0178 a minaret:TranscriptSegment ;
    minaret:endTime 1920.36 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0179 ;
    minaret:sequenceIndex 178 ;
    minaret:startTime 1909.44 ;
    minaret:text "آخر ہم کلمہ گو ہیں، اللہ کیوں ناراض ہے ہم سے؟ ہمیں اس طرح بھی سوچنا ہے کہ ہماری غلطی کہاں ہے۔ اور بہت بڑی غلطی ہوتی ہے کہ جب ہم دعوے بڑے بڑے کرتے ہیں۔ یہود بھی تو کہتے ہیں:" .

minaret:Segment_TQ2005-0319_0179 a minaret:TranscriptSegment ;
    minaret:endTime 1933.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0180 ;
    minaret:sequenceIndex 179 ;
    minaret:startTime 1922.36 ;
    minaret:text "ہم اللہ کے بیٹے ہیں، اللہ کے محبوب ہیں، اللہ کے بڑے پیارے ہیں۔ ہم بھی کیا کہتے ہیں؟ ہم حضور صلی اللہ علیہ وسلم کی امت ہیں اور آپ کے لاڈلے ہیں اور آپ کے بہت پیارے ہیں، اور ہم آپ سے بھی بڑی محبت کرتے ہیں، لیکن" .

minaret:Segment_TQ2005-0319_0180 a minaret:TranscriptSegment ;
    minaret:endTime 1939.08 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0181 ;
    minaret:sequenceIndex 180 ;
    minaret:startTime 1933.86 ;
    minaret:text "اس کے بعد ایک سنت پر عمل کرنے کو تیار نہیں! تو جب آپ دعویٰ کر رہے ہیں محبت کا:" .

minaret:Segment_TQ2005-0319_0182 a minaret:TranscriptSegment ;
    minaret:endTime 1956.44 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0183 ;
    minaret:sequenceIndex 182 ;
    minaret:startTime 1946.48 ;
    minaret:text "اللہ کی محبت چاہیے تو کیا کرو؟ پھر وہ کرو جو پیغمبر نے کیا، جو اس کے محبوب نے کیا۔ تو «مَغْضُوْبِ عَلَیْهِمْ» صرف کسی خاص قوم کی" .

minaret:Segment_TQ2005-0319_0183 a minaret:TranscriptSegment ;
    minaret:endTime 1962.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0184 ;
    minaret:sequenceIndex 183 ;
    minaret:startTime 1956.44 ;
    minaret:text "طرف اشارہ نہیں، یہ ہر اس بندے کی طرف اشارہ ہے کہ جو اللہ کے غضب کو بھڑکانے والے کام کرے۔" .

minaret:Segment_TQ2005-0319_0185 a minaret:TranscriptSegment ;
    minaret:endTime 1988.22 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0186 ;
    minaret:sequenceIndex 185 ;
    minaret:startTime 1978.02 ;
    minaret:text "راستہ گم کرنا لاعلمی کی وجہ سے۔ پتا ہی نہیں، ڈائریکشن لیے بغیر گھر سے نکل کھڑے ہوئے، کوئی نہ سیکھا نہ جانا نہ بوجھا اور چل پڑے۔" .

minaret:Segment_TQ2005-0319_0186 a minaret:TranscriptSegment ;
    minaret:endTime 1999.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0187 ;
    minaret:sequenceIndex 186 ;
    minaret:startTime 1989.06 ;
    minaret:text "ایسے لوگ جو لاعلمی سے بھٹکتے ہیں ان کے لیے کیا حکم ہے؟ کہ وہ ضالین ہیں۔ یا اللہ! ہمیں ضالین میں شامل نہ کرنا،" .

minaret:Segment_TQ2005-0319_0187 a minaret:TranscriptSegment ;
    minaret:endTime 2007.34 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0188 ;
    minaret:sequenceIndex 187 ;
    minaret:startTime 2000.02 ;
    minaret:text "بھٹکنے والوں میں شامل نہ کرنا جنہوں نے اپنا راستہ گم کر دیا، جنہوں نے راستہ جاننے کی زحمت ہی گوارا نہیں کی۔" .

minaret:Segment_TQ2005-0319_0188 a minaret:TranscriptSegment ;
    minaret:endTime 2018.7 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0189 ;
    minaret:sequenceIndex 188 ;
    minaret:startTime 2008.88 ;
    minaret:text "دنیا میں بے شمار لوگ ایسے ہیں، بے شمار، ان گنت! کیا کرتے ہیں وہ؟ راستہ جاننے کے لیے اس کو کھولتے ہی نہیں۔" .

minaret:Segment_TQ2005-0319_0189 a minaret:TranscriptSegment ;
    minaret:endTime 2029.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0190 ;
    minaret:sequenceIndex 189 ;
    minaret:startTime 2019.3 ;
    minaret:text "ہے نا؟ انجانے میں بھٹک رہے ہیں۔ کیوں غلط کام کر رہے ہیں؟ پتا ہی نہیں کہ صحیح کیا ہے، صحیح اور غلط کی تمیز ہی کوئی نہیں۔ تو یا اللہ! ہمیں نہیں ان میں شامل کرنا۔" .

minaret:Segment_TQ2005-0319_0190 a minaret:TranscriptSegment ;
    minaret:endTime 2042.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0191 ;
    minaret:sequenceIndex 190 ;
    minaret:startTime 2030.28 ;
    minaret:text "تو ہمیں کس میں پھر شامل کرنا؟ انعام یافتہ لوگوں میں۔ انعام، سب سے پہلا انعام کیا ہے؟ ہدایت کا انعام، کہ اللہ کسی پر دینِ اسلام کی نعمت کھول دے:" .

minaret:Segment_TQ2005-0319_0192 a minaret:TranscriptSegment ;
    minaret:endTime 2066.28 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0193 ;
    minaret:sequenceIndex 192 ;
    minaret:startTime 2054.0 ;
    minaret:text "چلتا رہا، کیونکہ ساری زندگی سیکھتا ہوا چلتا رہتا ہے، چلتا رہتا ہے، جب تک موت نہیں آ جاتی یہ سفر جاری رہتا ہے، سیکھتا رہتا ہے انسان، اور پھر آخر اپنے رب سے جا ملا نفسِ مطمئنہ بن کے۔" .

minaret:Segment_TQ2005-0319_0193 a minaret:TranscriptSegment ;
    minaret:endTime 2070.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0194 ;
    minaret:sequenceIndex 193 ;
    minaret:startTime 2067.38 ;
    minaret:text "یہ ہے وہ راستہ جو انعام یافتہ لوگوں کا راستہ ہے۔" .

minaret:Segment_TQ2005-0319_0194 a minaret:TranscriptSegment ;
    minaret:endTime 2081.72 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0195 ;
    minaret:sequenceIndex 194 ;
    minaret:startTime 2072.46 ;
    minaret:text "اور اب ہمیں اپنے لیے کیا سبق لینا ہے؟ کہ جو پڑھا ہے یا جو جانتے ہیں، اس پر حتیٰ الوسع عمل کی کوشش کریں۔" .

minaret:Segment_TQ2005-0319_0195 a minaret:TranscriptSegment ;
    minaret:endTime 2093.46 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0196 ;
    minaret:sequenceIndex 195 ;
    minaret:startTime 2082.28 ;
    minaret:text "اب آپ کہیں گے: نہیں ہم تو جانتے نہیں، ہم نہیں جانتے۔ ظاہر ہے ہم جاننے کی کوشش نہیں کرتے، کیا چھوٹ جائیں گے؟ دوسری کیٹگری میں آ گریں گے، اور وہ کون سی ہے؟ جو انجان ہے۔" .

minaret:Segment_TQ2005-0319_0196 a minaret:TranscriptSegment ;
    minaret:endTime 2105.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0197 ;
    minaret:sequenceIndex 196 ;
    minaret:startTime 2094.22 ;
    minaret:text "بہت سے لوگ کیا کرتے ہیں؟ جب ان سے یہ کہا جائے کہ دیکھو جو پڑھ رہے ہو عمل کرو، تو کہتے ہیں: ہم پڑھتے ہی نہیں! ایسے کہتے ہیں نا؟ ہم انجان بن جاتے ہیں۔ تو یہ ضالین کون ہیں؟" .

minaret:Segment_TQ2005-0319_0197 a minaret:TranscriptSegment ;
    minaret:endTime 2113.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0198 ;
    minaret:sequenceIndex 197 ;
    minaret:startTime 2107.12 ;
    minaret:text "انجان۔ ہر روز نماز میں تو ہم یہ کہتے ہیں: یا رب ہمیں سیدھا راستہ دکھا، اپنے پسندیدہ بندوں میں داخل کر،" .

minaret:Segment_TQ2005-0319_0198 a minaret:TranscriptSegment ;
    minaret:endTime 2126.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0199 ;
    minaret:sequenceIndex 198 ;
    minaret:startTime 2114.32 ;
    minaret:text "غضب والوں میں نہیں، بھٹکنے والوں میں نہیں، اور پھر ہم یا تو جان کے کچھ عمل نہیں کرتے یا پھر جاننے کی کوشش ہی نہیں کرتے۔ تو ان دونوں سے نکل کر کرنے کا کام کیا ہے؟ «اَنْعَمْتَ عَلَیْهِمْ» میں شامل ہونا،" .

minaret:Segment_TQ2005-0319_0199 a minaret:TranscriptSegment ;
    minaret:endTime 2137.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0200 ;
    minaret:sequenceIndex 199 ;
    minaret:startTime 2127.24 ;
    minaret:text "دینِ اسلام کی نعمت کو واقعی نعمت سمجھنا، قبول کرنا، اس کا حق ادا کرنا، اس کو سمجھنے کی کوشش کرنا۔ اور اسی کے اوپر آخر میں کیا کہا جاتا ہے؟ آمین!" .

minaret:Segment_TQ2005-0319_0200 a minaret:TranscriptSegment ;
    minaret:endTime 2152.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0201 ;
    minaret:sequenceIndex 200 ;
    minaret:startTime 2139.46 ;
    minaret:text "حضرت ابوہریرہ رضی اللہ عنہ فرماتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جب امام «وَلَا الضَّآلِّیْنَ» کہے تو تم آمین کہو، جس کا آمین کہنا فرشتوں کے آمین کہنے کے موافق ہو گیا اس کے پچھلے گناہ بخش دیے جاتے ہیں۔" .

minaret:Segment_TQ2005-0319_0201 a minaret:TranscriptSegment ;
    minaret:endTime 2161.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0202 ;
    minaret:sequenceIndex 201 ;
    minaret:startTime 2153.38 ;
    minaret:text "ٹھیک ہے؟ جب امام «وَلَا الضَّآلِّیْنَ» کہے، جیسے مسجد میں خاص طور پر، تو تم آمین کہو،" .

minaret:Segment_TQ2005-0319_0202 a minaret:TranscriptSegment ;
    minaret:endTime 2177.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0203 ;
    minaret:sequenceIndex 202 ;
    minaret:startTime 2162.58 ;
    minaret:text "جس کا آمین کہنا فرشتوں کے آمین کہنے سے مل گیا، موافق ہو گیا، اس کے پچھلے گناہ بخش دیے جائیں گے۔ صحیح بخاری کی روایت ہے۔ اسی طرح عطاء بن ابی رباح کہتے ہیں کہ آمین دعا ہے۔" .

minaret:Segment_TQ2005-0319_0207 a minaret:TranscriptSegment ;
    minaret:endTime 2286.92 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0208 ;
    minaret:sequenceIndex 207 ;
    minaret:startTime 2215.72 ;
    minaret:text "«اَعُوْذُ بِاللّٰهِ مِنَ الشَّیْطَانِ الرَّجِیْمِ ۟ بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ ۟ اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِیْنَ ۟ۙ الرَّحْمٰنِ الرَّحِیْمِ ۟ۙ مٰلِكِ یَوْمِ الدِّیْنِ ۟ؕ اِیَّاكَ نَعْبُدُ وَاِیَّاكَ نَسْتَعِیْنُ ۟ؕ اِهْدِنَا الصِّرَاطَ الْمُسْتَقِیْمَ ۟ۙ صِرَاطَ الَّذِیْنَ اَنْعَمْتَ عَلَیْهِمْ ۙ۬ غَیْرِ الْمَغْضُوْبِ عَلَیْهِمْ وَلَا الضَّآلِّیْنَ ۟۠ آمين»" .

minaret:Dua_QuranicDua-62 a minaret:Dua ;
    minaret:duaTypeEn "Dua for Guidance" ;
    minaret:duaTypeUr "سیدھے راستے کی دعا" ;
    minaret:reference "QuranicDua-62" ;
    minaret:translationEn "Guide us to the straight path" ;
    minaret:translationUr "اے اللہ ہمیں سیدھا راستہ دکھا" ;
    minaret:transliteration "" .

minaret:SegmentGroup_TQ2005-0315_279_48_291_42 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_TQ2005-0315_0025 ;
    minaret:endTime 291.42 ;
    minaret:startTime 279.48 .

minaret:SegmentGroup_TQ2005-0317_17_4_27_3 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_TQ2005-0317_0002 ;
    minaret:endTime 27.3 ;
    minaret:startTime 17.4 .

minaret:Segment_TQ2005-0314_0001 a minaret:TranscriptSegment ;
    minaret:endTime 17.9 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0002 ;
    minaret:sequenceIndex 1 ;
    minaret:startTime 11.08 ;
    minaret:text "اشْرَحْ لِیْ صَدْرِیْ وَیَسِّرْ لِیْۤ اَمْرِیْ وَاحْلُلْ عُقْدَةً مِّنْ لِّسَانِیْ یَفْقَهُوْا قَوْلِیْ۔" .

minaret:Segment_TQ2005-0314_0024 a minaret:TranscriptSegment ;
    minaret:endTime 256.82 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 244.82 ;
    minaret:text "کسی نیکی کے اضافے کا ذریعہ بن جانا، کہ اس کی نیکیوں میں اضافے کا آپ سبب بن گئے، کیونکہ حدیث میں آتا ہے نا: «اَلدَّالُّ عَلَى الْخَیْرِ كَفَاعِلِهٖ»" .

minaret:Segment_TQ2005-0314_0025 a minaret:TranscriptSegment ;
    minaret:endTime 269.24 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 258.32 ;
    minaret:text "«اَلدَّالُّ عَلَى الْخَیْرِ كَفَاعِلِهٖ»، مطلب کیا ہے؟ کہ نیکی کی طرف رہنمائی کرنے والا ایسا ہی ہے جیسے خود کرنے والا۔" .

minaret:Segment_TQ2005-0314_0027 a minaret:TranscriptSegment ;
    minaret:endTime 292.1 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 280.3 ;
    minaret:text "وہ ساری نیکیاں ان کو جتنی ملیں گی، اتنی ہی برابر ان کو بھی ملیں گی کیونکہ وہ ان کے لیے ذریعہ بنی ہیں لانے کا۔ کسی کی دنیا سنوارنا یہ بھی ایک نیکی ہے،" .

minaret:Segment_TQ2005-0314_0028 a minaret:TranscriptSegment ;
    minaret:endTime 302.12 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0029 ;
    minaret:sequenceIndex 28 ;
    minaret:startTime 293.0 ;
    minaret:text "لیکن کسی کی آخرت سنوارنا یہ اس سے بہت بڑی نیکی ہے۔ کتنی بڑی؟ اس کو آپ یوں دیکھیے کہ اگر آپ نے کسی کی دنیا سنواری" .

minaret:Segment_TQ2005-0314_0029 a minaret:TranscriptSegment ;
    minaret:endTime 312.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0030 ;
    minaret:sequenceIndex 29 ;
    minaret:startTime 303.28000000000003 ;
    minaret:text "تو آپ نے اتنے دن اس کو فائدہ پہنچایا، مثلاً آپ نے کسی کو گھر بنا کر دے دیا فار ایگزیمپل، تو آپ نے اس کو فائدہ پہنچایا" .

minaret:Segment_TQ2005-0314_0030 a minaret:TranscriptSegment ;
    minaret:endTime 324.28 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0031 ;
    minaret:sequenceIndex 30 ;
    minaret:startTime 313.5 ;
    minaret:text "اتنے دن جتنے دن وہ اس گھر میں رہا۔ اب آپ نے اگر کسی کو مثلاً گھر بنا کر دیا تو آپ نے اس کے لیے کتنی بڑی نیکی کی کہ جتنے دن اس کی زندگی کے تھے، مہینے، سال،" .

minaret:Segment_TQ2005-0314_0031 a minaret:TranscriptSegment ;
    minaret:endTime 335.64 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0032 ;
    minaret:sequenceIndex 31 ;
    minaret:startTime 325.32 ;
    minaret:text "اتنے دن اس کے لیے آپ نے بھلائی کی، مثلاً دس سال بھلائی، بیس سال بھلائی۔ اور اگر آپ کی وجہ سے کسی کی آخرت بچ گئی" .

minaret:Segment_TQ2005-0314_0032 a minaret:TranscriptSegment ;
    minaret:endTime 347.44 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0033 ;
    minaret:sequenceIndex 32 ;
    minaret:startTime 336.28000000000003 ;
    minaret:text "اور اس کو جنت میں جگہ مل گئی، وہ جہنم سے بچ گیا تو آپ نے اس کے ساتھ کتنی بھلائی کی؟ ہمیشہ کے لیے کی نا!" .

minaret:Segment_TQ2005-0314_0087 a minaret:TranscriptSegment ;
    minaret:endTime 948.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0088 ;
    minaret:sequenceIndex 87 ;
    minaret:startTime 936.94 ;
    minaret:text "«مِنْ حُسْنِ اِسْلَامِ الْمَرْءِ تَرْكُهٗ مَا لَا یَعْنِیْهِ»۔ اسلام کا حسن کیا ہے، خوبصورتی کیا ہے؟ کہ ان باتوں کو چھوڑ دے جس سے اس کا کوئی مطلب نہیں۔" .

minaret:Segment_TQ2005-0314_0097 a minaret:TranscriptSegment ;
    minaret:endTime 1050.62 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0098 ;
    minaret:sequenceIndex 97 ;
    minaret:startTime 1046.46 ;
    minaret:text "«فَاِنَّ تَسْوِیَةَ الصُّفُوْفِ مِنْ اِقَامَةِ الصَّلٰوةِ»" .

minaret:Segment_TQ2005-0314_0098 a minaret:TranscriptSegment ;
    minaret:endTime 1053.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0099 ;
    minaret:sequenceIndex 98 ;
    minaret:startTime 1050.6200000000001 ;
    minaret:text "صفوں کی درستگی نماز کا حصہ ہے۔" .

minaret:Segment_TQ2005-0314_0103 a minaret:TranscriptSegment ;
    minaret:endTime 1104.5 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0104 ;
    minaret:sequenceIndex 103 ;
    minaret:startTime 1091.72 ;
    minaret:text "چلتی پھرتی تبلیغ ہو جائے، تاکہ لوگ دیکھیں تو رشک کریں کہ میں بھی ایسا بن جاؤں۔ اور ایک شخص آپ کو دیکھ کے مسلمان ہو گیا نا، تو وہ آپ کے لیے سرخ قیمتی اونٹوں سے زیادہ بہتر ہے،" .

minaret:Segment_TQ2005-0314_0104 a minaret:TranscriptSegment ;
    minaret:endTime 1114.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0314_0105 ;
    minaret:sequenceIndex 104 ;
    minaret:startTime 1105.2 ;
    minaret:text "دنیا کی بڑی بڑی نعمتوں سے زیادہ بہتر ہے۔ اور اگر آپ کو دیکھ کر ایک شخص دین سے بھٹکا اور بہکا اور بھاگا کہ ایسے ہیں مسلمان!" .

minaret:Segment_TQ2005-0315_0001 a minaret:TranscriptSegment ;
    minaret:endTime 22.28 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0002 ;
    minaret:sequenceIndex 1 ;
    minaret:startTime 11.739999999999998 ;
    minaret:text "قرآن پاک میں اللہ تعالیٰ فرماتے ہیں: «لَوْ اَنْزَلْنَا هٰذَا الْقُرْاٰنَ عَلٰی جَبَلٍ لَّرَاَیْتَهٗ خَاشِعًا مُّتَصَدِّعًا مِّنْ خَشْیَةِ اللّٰهِ»" .

minaret:Segment_TQ2005-0315_0002 a minaret:TranscriptSegment ;
    minaret:endTime 37.34 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0003 ;
    minaret:sequenceIndex 2 ;
    minaret:startTime 23.119999999999997 ;
    minaret:text "اگر اس قرآن کو ہم کسی پہاڑ پر اتارتے، پہاڑ پر رکھتے، تو تم دیکھتے کہ وہ دب گیا ہے، دب گیا ہے۔ «خَاشِعًا مُّتَصَدِّعًا»، پھٹ گیا ہے،" .

minaret:Segment_TQ2005-0315_0004 a minaret:TranscriptSegment ;
    minaret:endTime 60.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0005 ;
    minaret:sequenceIndex 4 ;
    minaret:startTime 53.2 ;
    minaret:text "یہ کوئی کھیل تماشے کی چیز نہیں ہے، یہ کوئی ہنسی مذاق کی چیز نہیں ہے، یہ تو فیصلہ کن بات ہے۔" .

minaret:Segment_TQ2005-0315_0024 a minaret:TranscriptSegment ;
    minaret:endTime 278.64000000000004 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 264.56 ;
    minaret:text "اور آپ دیکھیں کہ قرآن پاک میں ایک آیت ہے جو خود self-explanatory ہے کہ what is Quran, what is Quran? قرآن کے بارے میں سورۃ الشعراء کی ایک آیت ہے: «وَاِنَّهٗ لَتَنْزِیْلُ رَبِّ الْعٰلَمِیْنَ»" .

minaret:Segment_TQ2005-0315_0025 a minaret:TranscriptSegment ;
    minaret:endTime 291.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 279.48 ;
    minaret:text "«نَزَلَ بِهِ الرُّوْحُ الْاَمِیْنُ ۙ عَلٰی قَلْبِكَ لِتَكُوْنَ مِنَ الْمُنْذِرِیْنَ ۙ بِلِسَانٍ عَرَبِیٍّ مُّبِیْنٍ ؕ وَاِنَّهٗ لَفِیْ زُبُرِ الْاَوَّلِیْنَ»" .

minaret:Segment_TQ2005-0315_0027 a minaret:TranscriptSegment ;
    minaret:endTime 308.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 300.64 ;
    minaret:text "ترجمہ بتاتی ہوں اب آپ کو: بے شک یہ خداوندِ عالم کا اتارا ہوا کلام ہے، اس کو امانت دار فرشتہ لے کر اترا ہے،" .

minaret:Segment_TQ2005-0315_0028 a minaret:TranscriptSegment ;
    minaret:endTime 320.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0029 ;
    minaret:sequenceIndex 28 ;
    minaret:startTime 309.09999999999997 ;
    minaret:text "تمہارے دل پر، یعنی محمد صلی اللہ علیہ وسلم کے دل پر، تاکہ تم ڈرانے والوں میں سے بنو، صاف عربی زبان میں ہے، اور اس کا ذکر پہلے لوگوں کی کتابوں میں بھی ہے، ٹھیک ہے؟" .

minaret:Segment_TQ2005-0315_0030 a minaret:TranscriptSegment ;
    minaret:endTime 341.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0031 ;
    minaret:sequenceIndex 30 ;
    minaret:startTime 331.34 ;
    minaret:text "نکال کر اس کو آپ سیدھی لائن میں نہیں لکھیں گے، اوپر سے نیچے لکھیں گے۔ کیسے؟ «وَاِنَّهٗ لَتَنْزِیْلُ رَبِّ الْعٰلَمِیْنَ»، ایک بات۔" .

minaret:Segment_TQ2005-0315_0031 a minaret:TranscriptSegment ;
    minaret:endTime 354.02 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0032 ;
    minaret:sequenceIndex 31 ;
    minaret:startTime 342.71999999999997 ;
    minaret:text "نمبر دو: «نَزَلَ بِهِ الرُّوْحُ الْاَمِیْنُ»، دوسری بات۔ «عَلٰی قَلْبِكَ»، تیسری بات۔ «لِتَكُوْنَ مِنَ الْمُنْذِرِیْنَ»، چوتھی بات کر سکتے ہیں۔" .

minaret:Segment_TQ2005-0315_0033 a minaret:TranscriptSegment ;
    minaret:endTime 375.64 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0034 ;
    minaret:sequenceIndex 33 ;
    minaret:startTime 364.78 ;
    minaret:text "«بِلِسَانٍ عَرَبِیٍّ مُّبِیْنٍ»، اور یہ عربی زبان میں ہے۔ «وَاِنَّهٗ لَفِیْ زُبُرِ الْاَوَّلِیْنَ»، اور اس کا ذکر یا اس میں جو انفارمیشن ہے، یہ صرف اسی میں نہیں، اس کی ریلیٹڈ انفارمیشن پہلی کتابوں میں بھی موجود ہے۔" .

minaret:Segment_TQ2005-0315_0045 a minaret:TranscriptSegment ;
    minaret:endTime 513.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0046 ;
    minaret:sequenceIndex 45 ;
    minaret:startTime 503.29999999999995 ;
    minaret:text "تو آپ کس طرح بات کریں؟ «تَعَالَوْا اِلٰی كَلِمَةٍ سَوَآءٍۭ بَیْنَنَا وَبَیْنَكُمْ»، آؤ ایک بات کی طرف جو ہمارے اور تمہارے درمیان برابر ہے، یعنی common grounds پر بات کریں ہمیشہ۔" .

minaret:Segment_TQ2005-0315_0160 a minaret:TranscriptSegment ;
    minaret:endTime 1699.8 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0161 ;
    minaret:sequenceIndex 160 ;
    minaret:startTime 1697.08 ;
    minaret:text "«وَلَقَدْ یَسَّرْنَا الْقُرْاٰنَ لِلذِّكْرِ فَهَلْ مِنْ مُّدَّكِرٍ»" .

minaret:Segment_TQ2005-0315_0161 a minaret:TranscriptSegment ;
    minaret:endTime 1709.02 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0162 ;
    minaret:sequenceIndex 161 ;
    minaret:startTime 1699.8000000000002 ;
    minaret:text "ہم نے قرآن کو نصیحت کے لیے آسان بنا دیا، تو ہے کوئی جو نصیحت حاصل کرے؟ یعنی کوئی بھی شخص" .

minaret:Segment_TQ2005-0316_0001 a minaret:TranscriptSegment ;
    minaret:endTime 18.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0316_0002 ;
    minaret:sequenceIndex 1 ;
    minaret:startTime 9.1 ;
    minaret:text "«بِ» ساتھ، «اسْمِ» نام، «اللّٰهِ» اللہ کے، اللہ کے نام کے" .

minaret:Segment_TQ2005-0316_0002 a minaret:TranscriptSegment ;
    minaret:endTime 27.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0316_0003 ;
    minaret:sequenceIndex 2 ;
    minaret:startTime 18.76 ;
    minaret:text "ساتھ یا اللہ کے نام سے۔ «الرَّحْمٰنِ» جو بہت مہربان ہے، «الرَّحِیْمِ»" .

minaret:Segment_TQ2005-0316_0003 a minaret:TranscriptSegment ;
    minaret:endTime 36.92 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0316_0004 ;
    minaret:sequenceIndex 3 ;
    minaret:startTime 27.48 ;
    minaret:text "نہایت رحم کرنے والا ہے۔ «اَلْحَمْدُ» سب تعریف، «لِلّٰهِ» اللہ کے لیے ہے،" .

minaret:Segment_TQ2005-0316_0005 a minaret:TranscriptSegment ;
    minaret:endTime 55.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0316_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 45.96 ;
    minaret:text "«الرَّحِیْمِ» نہایت رحم کرنے والا ہے۔ «مٰلِكِ» مالک ہے، «یَوْمِ» دن کا، «الدِّیْنِ»" .

minaret:Segment_TQ2005-0316_0006 a minaret:TranscriptSegment ;
    minaret:endTime 64.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0316_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 55.58 ;
    minaret:text "بدلے کے، یعنی قیامت کے۔ «اِیَّاكَ» صرف تیری ہی، «نَعْبُدُ» ہم عبادت کرتے ہیں،" .

minaret:Segment_TQ2005-0316_0009 a minaret:TranscriptSegment ;
    minaret:endTime 92.28 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0316_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 83.66 ;
    minaret:text "«الَّذِیْنَ» ان کا، «اَنْعَمْتَ» انعام کیا تو نے، «عَلَیْهِمْ» جن پر، «غَیْرِ» نہ،" .

minaret:Segment_TQ2005-0316_0010 a minaret:TranscriptSegment ;
    minaret:endTime 102.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0316_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 92.28 ;
    minaret:text "«الْمَغْضُوْبِ» ان کا جو غضب کیا گیا، «عَلَیْهِمْ» جن پر، «وَ» اور، «لَا» نہ، «الضَّآلِّیْنَ»" .

minaret:Segment_TQ2005-0316_0011 a minaret:TranscriptSegment ;
    minaret:endTime 106.36 ;
    minaret:sequenceIndex 11 ;
    minaret:startTime 102.26 ;
    minaret:text "ان کا جو گمراہ ہیں۔ آمین۔" .

minaret:Segment_TQ2005-0317_0001 a minaret:TranscriptSegment ;
    minaret:endTime 16.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0002 ;
    minaret:sequenceIndex 1 ;
    minaret:startTime 4.540000000000005 ;
    minaret:text "«اَلْحَمْدُ لِلّٰهِ»، سب تعریف اللہ کے لیے ہے، «رَبِّ الْعٰلَمِیْنَ»، جو رب ہے تمام جہانوں کا، یا جو تمام جہانوں کا رب ہے۔" .

minaret:Segment_TQ2005-0317_0002 a minaret:TranscriptSegment ;
    minaret:endTime 27.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0003 ;
    minaret:sequenceIndex 2 ;
    minaret:startTime 17.400000000000002 ;
    minaret:text "«الرَّحْمٰنِ الرَّحِیْمِ»، نہایت مہربان، بار بار رحم کرنے والا۔ «مٰلِكِ یَوْمِ الدِّیْنِ»، روزِ جزا کا مالک ہے۔" .

minaret:Segment_TQ2005-0317_0003 a minaret:TranscriptSegment ;
    minaret:endTime 42.92 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0004 ;
    minaret:sequenceIndex 3 ;
    minaret:startTime 28.68 ;
    minaret:text "«اِیَّاكَ نَعْبُدُ»، صرف تیری ہم عبادت کرتے ہیں، «وَاِیَّاكَ نَسْتَعِیْنُ»، اور صرف تجھ ہی سے ہم مدد چاہتے ہیں۔ «اِهْدِنَا الصِّرَاطَ الْمُسْتَقِیْمَ»، ہمیں سیدھا راستہ دکھا۔" .

minaret:Segment_TQ2005-0317_0004 a minaret:TranscriptSegment ;
    minaret:endTime 55.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0005 ;
    minaret:sequenceIndex 4 ;
    minaret:startTime 43.779999999999994 ;
    minaret:text "«صِرَاطَ الَّذِیْنَ اَنْعَمْتَ عَلَیْهِمْ»، ان لوگوں کا راستہ جن پر تُو نے انعام کیا، «غَیْرِ الْمَغْضُوْبِ عَلَیْهِمْ»، نہ ان کا جن پر غضب کیا گیا،" .

minaret:Segment_TQ2005-0317_0005 a minaret:TranscriptSegment ;
    minaret:endTime 60.010000000000005 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 57.84 ;
    minaret:text "«وَلَا الضَّآلِّیْنَ»، اور نہ وہ گمراہ ہوئے۔" .

minaret:Segment_TQ2005-0317_0006 a minaret:TranscriptSegment ;
    minaret:endTime 69.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 61.660000000000004 ;
    minaret:text "اب اس میں آپ دیکھیے کہ نیا لفظ پوری سورت میں صرف ایک ہے اور وہ کیا ہے؟ «الدِّیْنِ»۔" .

minaret:Segment_TQ2005-0317_0007 a minaret:TranscriptSegment ;
    minaret:endTime 77.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 70.94 ;
    minaret:text "«الدِّیْنِ» کا لفظ جو ہے، اگرچہ ہم دین کے معنوں میں استعمال کرتے ہیں، دینِ اسلام کے معنوں میں،" .

minaret:Segment_TQ2005-0317_0008 a minaret:TranscriptSegment ;
    minaret:endTime 88.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 78.19999999999999 ;
    minaret:text "لیکن دین کا یہ معنی جو یہاں بیان کیا گیا ہے، جزا و سزا کا، بدلے کا، یہ نیا لفظ ہے۔ یہ اردو میں دین اس معنی میں استعمال نہیں ہوتا،" .

minaret:Segment_TQ2005-0317_0074 a minaret:TranscriptSegment ;
    minaret:endTime 779.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0317_0075 ;
    minaret:sequenceIndex 74 ;
    minaret:startTime 767.42 ;
    minaret:text "اور نیچے انہوں نے وجہ بتائی بھی ہے کہ وہ حدیث جس میں یہ آتا ہے کہ حائضہ اور نفاس والی عورت جو ہے وہ قرآن نہ پڑھے تو یہ ابن عمر کی روایت ہے، ضعیف حدیث ہے اور اس کی وجہ بھی انہوں نے ضعف کی لکھی ہوئی ہے۔" .

minaret:Segment_TQ2005-0318_0002 a minaret:TranscriptSegment ;
    minaret:endTime 34.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0003 ;
    minaret:sequenceIndex 2 ;
    minaret:startTime 22.44 ;
    minaret:text "«بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ»۔ «بِ»: «ب» حروفِ تہجی میں سے ہے جسے الف، با، تا، ثا ہم کہتے ہیں۔ عربی میں کچھ حروفِ تہجی ایسے ہیں کہ جن کے معنی ہیں،" .

minaret:Segment_TQ2005-0318_0029 a minaret:TranscriptSegment ;
    minaret:endTime 318.86 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0030 ;
    minaret:sequenceIndex 29 ;
    minaret:startTime 309.74 ;
    minaret:text "«اَلْحَمْدُ لِلّٰهِ»۔ «رَبِّ»: رب، ر، ب، ب سے ہے، رَبَّ يَرُبُّ سے۔ رب کہتے ہیں کسی چیز کو" .

minaret:Segment_TQ2005-0318_0039 a minaret:TranscriptSegment ;
    minaret:endTime 444.94 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0040 ;
    minaret:sequenceIndex 39 ;
    minaret:startTime 434.42 ;
    minaret:text "ضروری نہیں کہ لکھیں اور یاد کریں، ضروری نہیں کہ امتحان میں آئیں، لیکن تھوڑا سا نالج زیادہ، اور خود ہی تو آپ نے کہا ہم نے دعا مانگی: «رَبِّ زِدْنِیْ عِلْمًا»، اور اگر اس کے لیے کچھ موقع مل جائے تو پریشان نہ ہوں۔" .

minaret:Segment_TQ2005-0318_0067 a minaret:TranscriptSegment ;
    minaret:endTime 752.4 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0068 ;
    minaret:sequenceIndex 67 ;
    minaret:startTime 750.04 ;
    minaret:text "«اِیَّاكَ نَعْبُدُ»" .

minaret:Segment_TQ2005-0318_0069 a minaret:TranscriptSegment ;
    minaret:endTime 771.18 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0070 ;
    minaret:sequenceIndex 69 ;
    minaret:startTime 766.06 ;
    minaret:text "«اِیَّاكَ نَعْبُدُ»، صرف، صرف، صرف، صرف! Only yours!" .

minaret:Segment_TQ2005-0318_0076 a minaret:TranscriptSegment ;
    minaret:endTime 847.0 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0077 ;
    minaret:sequenceIndex 76 ;
    minaret:startTime 836.1 ;
    minaret:text "ٹھیک ہے؟ «اِیَّاكَ نَعْبُدُ»، صرف تیری ہم عبادت کرتے ہیں، بہت زیادہ محبت تجھ سے کرتے ہیں، تیرے آگے جھکے ہوئے ہیں،" .

minaret:Segment_TQ2005-0318_0077 a minaret:TranscriptSegment ;
    minaret:endTime 862.14 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0078 ;
    minaret:sequenceIndex 77 ;
    minaret:startTime 847.54 ;
    minaret:text "جھکے ہوئے ہیں۔ «وَاِیَّاكَ نَسْتَعِیْنُ»، اور صرف تجھ سے ہم مدد چاہتے ہیں، صرف تجھ سے، صرف تجھ سے ہم مدد چاہتے ہیں۔ «نَسْتَعِیْنُ» کا لفظ جو ہے، یہ اس کا روٹ ہے ع، و، ن۔" .

minaret:Segment_TQ2005-0318_0082 a minaret:TranscriptSegment ;
    minaret:endTime 916.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0083 ;
    minaret:sequenceIndex 82 ;
    minaret:startTime 907.36 ;
    minaret:text "جیسے وہ حدیث میں آتا ہے نا کہ آپ صلی اللہ علیہ وسلم نے ایک سیدھا خط کھینچا، سیدھی لکیر کھینچی، اور پھر اس کے ساتھ ادھر ادھر لکیریں بھی۔" .

minaret:Segment_TQ2005-0318_0083 a minaret:TranscriptSegment ;
    minaret:endTime 927.74 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0084 ;
    minaret:sequenceIndex 83 ;
    minaret:startTime 917.64 ;
    minaret:text "آپ نے فرمایا کہ یہ صراطِ مستقیم ہے، اور ہر راستے پہ شیطان بیٹھا ہوا ہے۔ جب انسان اس پہ چلنے لگتا ہے تو کہتا ہے: ادھر آؤ، ادھر لے جاتا ہے، ہٹا" .

minaret:Segment_TQ2005-0318_0088 a minaret:TranscriptSegment ;
    minaret:endTime 981.62 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0089 ;
    minaret:sequenceIndex 88 ;
    minaret:startTime 968.18 ;
    minaret:text "دیکھیں نا، اردو میں کوئی لفظ ہے جو یہ تینوں معانی آپ کو اکٹھے کر دے؟ یہ ہے لسانِ عربیِ مبین۔ راستے کی نشان دہی اور اس پہ چلانا اور پھر آخر تک پہنچانا: «اِهْدِنَا الصِّرَاطَ الْمُسْتَقِیْمَ»۔" .

minaret:Segment_TQ2005-0318_0101 a minaret:TranscriptSegment ;
    minaret:endTime 1108.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0102 ;
    minaret:sequenceIndex 101 ;
    minaret:startTime 1105.04 ;
    minaret:text "«وَاِنْ مِّنْكُمْ اِلَّا وَارِدُهَا»" .

minaret:Segment_TQ2005-0318_0108 a minaret:TranscriptSegment ;
    minaret:endTime 1179.4 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0109 ;
    minaret:sequenceIndex 108 ;
    minaret:startTime 1176.88 ;
    minaret:text "«لَا تُبْطِلُوْا صَدَقٰتِكُمْ بِالْمَنِّ وَالْاَذٰی»" .

minaret:Segment_TQ2005-0319_0005 a minaret:TranscriptSegment ;
    minaret:endTime 66.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 52.88 ;
    minaret:text "اور کہا: یہ دو نور آپ ہی کو دیے جا رہے ہیں، آپ سے پہلے کسی نبی کو نہیں دیے گئے۔ ایک سورۃ الفاتحہ اور دوسرا سورۃ البقرہ کی آخری دو آیات۔" .

minaret:Segment_TQ2005-0319_0006 a minaret:TranscriptSegment ;
    minaret:endTime 81.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 67.42 ;
    minaret:text "آپ جب کبھی ان دونوں میں سے کوئی کلمہ تلاوت کریں، یعنی سورۃ الفاتحہ پڑھیں یا سورۃ البقرہ کی آخری آیات پڑھیں، تو آپ کو طلب کردہ چیز ضرور عطا کی جائے گی، یعنی اس کے بعد دعا قبول ہوتی ہے۔" .

minaret:Segment_TQ2005-0319_0009 a minaret:TranscriptSegment ;
    minaret:endTime 108.78 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 103.3 ;
    minaret:text "«وَلَقَدْ اٰتَیْنٰكَ سَبْعًا مِّنَ الْمَثَانِیْ وَالْقُرْاٰنَ الْعَظِیْمَ»" .

minaret:Segment_TQ2005-0319_0010 a minaret:TranscriptSegment ;
    minaret:endTime 116.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 108.78 ;
    minaret:text "کہ ہم نے آپ کو سات بار بار دہرائی جانے والی آیات عطا کی ہیں، اور اس سے مراد سورۃ الفاتحہ ہی ہے۔" .

minaret:Segment_TQ2005-0319_0013 a minaret:TranscriptSegment ;
    minaret:endTime 145.34 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0014 ;
    minaret:sequenceIndex 13 ;
    minaret:startTime 137.72 ;
    minaret:text "یہی ہے وہ سات آیات جو بار بار دہرائی جاتی ہیں، اور قرآنِ عظیم جو مجھے دیا گیا۔" .

minaret:Segment_TQ2005-0319_0014 a minaret:TranscriptSegment ;
    minaret:endTime 156.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0015 ;
    minaret:sequenceIndex 14 ;
    minaret:startTime 146.54 ;
    minaret:text "حضرت ابوہریرہ رضی اللہ عنہ فرماتے ہیں کہ آپ صلی اللہ علیہ وسلم نے فرمایا: سورت الحمد ہی ام القرآن، ام الکتاب اور دہرائی ہوئی سات" .

minaret:Segment_TQ2005-0319_0015 a minaret:TranscriptSegment ;
    minaret:endTime 166.52 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0016 ;
    minaret:sequenceIndex 15 ;
    minaret:startTime 156.58 ;
    minaret:text "آیات ہیں۔ یہ ترمذی کی روایت ہے۔ کیا؟ ام القرآن۔ ام کا کیا معنی ہوتا ہے؟ ماں۔ اور" .

minaret:Segment_TQ2005-0319_0021 a minaret:TranscriptSegment ;
    minaret:endTime 230.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0022 ;
    minaret:sequenceIndex 21 ;
    minaret:startTime 224.16 ;
    minaret:text "قرآن پاک میں آتا ہے: «فَاِذَا قَرَاْتَ الْقُرْاٰنَ فَاسْتَعِذْ بِاللّٰهِ مِنَ الشَّیْطٰنِ الرَّجِیْمِ»" .

minaret:Segment_TQ2005-0319_0022 a minaret:TranscriptSegment ;
    minaret:endTime 240.38 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 232.06 ;
    minaret:text "سورۃ النحل، آیت نمبر 98: کہ جب تم قرآن کی تلاوت کرو تو شیطان مردود سے اللہ کی پناہ مانگو۔" .

minaret:Segment_TQ2005-0319_0028 a minaret:TranscriptSegment ;
    minaret:endTime 291.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0029 ;
    minaret:sequenceIndex 28 ;
    minaret:startTime 288.32 ;
    minaret:text "«اِنَّ عِبَادِیْ لَیْسَ لَكَ عَلَیْهِمْ سُلْطٰنٌ»" .

minaret:Segment_TQ2005-0319_0029 a minaret:TranscriptSegment ;
    minaret:endTime 302.36 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0030 ;
    minaret:sequenceIndex 29 ;
    minaret:startTime 291.96 ;
    minaret:text "جو میرے بندے بن جائیں گے، بے شک میرے بندے، ان پر تیرا کوئی زور نہیں چلے گا۔ تو وہ پورا زور لگاتا ہے کہ انسان قرآن پڑھ کر بھی بھٹکے یا قرآن پڑھتے،" .

minaret:Segment_TQ2005-0319_0055 a minaret:TranscriptSegment ;
    minaret:endTime 590.4 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0056 ;
    minaret:sequenceIndex 55 ;
    minaret:startTime 581.92 ;
    minaret:text "«اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِیْنَ»، سب تعریف اللہ کے لیے ہے جو رب ہے تمام جہانوں کا۔" .

minaret:Segment_TQ2005-0319_0062 a minaret:TranscriptSegment ;
    minaret:endTime 664.94 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0063 ;
    minaret:sequenceIndex 62 ;
    minaret:startTime 661.14 ;
    minaret:text "«اَلْحَمْدُ لِلّٰهِ تَمْلَاُ الْمِیْزَانَ»" .

minaret:Segment_TQ2005-0319_0067 a minaret:TranscriptSegment ;
    minaret:endTime 716.32 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0068 ;
    minaret:sequenceIndex 67 ;
    minaret:startTime 703.14 ;
    minaret:text "ترمذی کی روایت ہے: «اَلْحَمْدُ لِلّٰهِ اَفْضَلُ الدُّعَاءِ»، «الحمد للہ» سب دعاؤں سے افضل ہے۔ یعنی جب آپ «الحمد للہ» کہتے ہیں تو اللہ کی رحمت کو اپنی طرف متوجہ کرتے ہیں۔" .

minaret:Segment_TQ2005-0319_0070 a minaret:TranscriptSegment ;
    minaret:endTime 750.7 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0071 ;
    minaret:sequenceIndex 70 ;
    minaret:startTime 741.32 ;
    minaret:text "یا «مِلْءَ السَّمَاوَاتِ وَمِلْءَ الْأَرْضِ وَمِلْءَ مَا بَيْنَهُمَا وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ»، اور آگے بھی طویل روایت ہے یہ۔" .

minaret:Segment_TQ2005-0319_0071 a minaret:TranscriptSegment ;
    minaret:endTime 761.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0072 ;
    minaret:sequenceIndex 71 ;
    minaret:startTime 751.72 ;
    minaret:text "تو اس وقت بھی کھڑے ہو کر وہ اللہ کی نعمتوں کو یاد کر کے شکر ادا کرتا ہے۔ اسی طرح جب کوئی اس کی زندگی میں خاص نعمت آتی ہے تو وہ اپنے اپنے" .

minaret:Segment_TQ2005-0319_0084 a minaret:TranscriptSegment ;
    minaret:endTime 911.0 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0085 ;
    minaret:sequenceIndex 84 ;
    minaret:startTime 898.6 ;
    minaret:text "بہت زیادہ رحمت فرمانے والا۔ «مٰلِكِ یَوْمِ الدِّیْنِ»، مالک ہے جزا سزا کے دن کا۔ جزا سزا کے دن سے مراد کیا؟ یوم الدین سے مراد قیامت کا دن،" .

minaret:Segment_TQ2005-0319_0087 a minaret:TranscriptSegment ;
    minaret:endTime 939.8 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0088 ;
    minaret:sequenceIndex 87 ;
    minaret:startTime 929.04 ;
    minaret:text "سورۃ المؤمن میں آتا ہے: «یَوْمَ هُمْ بَارِزُوْنَ ۬ۚ لَا یَخْفٰی عَلَى اللّٰهِ مِنْهُمْ شَیْءٌ ؕ لِمَنِ الْمُلْكُ الْیَوْمَ ؕ لِلّٰهِ الْوَاحِدِ الْقَهَّارِ»" .

minaret:Segment_TQ2005-0319_0088 a minaret:TranscriptSegment ;
    minaret:endTime 948.54 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0089 ;
    minaret:sequenceIndex 88 ;
    minaret:startTime 939.8 ;
    minaret:text "«اَلْیَوْمَ تُجْزٰی كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ ؕ لَا ظُلْمَ الْیَوْمَ ؕ اِنَّ اللّٰهَ سَرِیْعُ الْحِسَابِ»" .

minaret:Segment_TQ2005-0319_0089 a minaret:TranscriptSegment ;
    minaret:endTime 957.62 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0090 ;
    minaret:sequenceIndex 89 ;
    minaret:startTime 948.54 ;
    minaret:text "وہ دن جب سب لوگ بے پردہ ہوں گے، بغیر لباس کے اور بغیر کسی اوٹ کے سامنے جا کے کھڑے ہوں گے حشر کے دن۔" .

minaret:Segment_TQ2005-0319_0090 a minaret:TranscriptSegment ;
    minaret:endTime 968.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0091 ;
    minaret:sequenceIndex 90 ;
    minaret:startTime 958.44 ;
    minaret:text "اللہ سے ان کی کوئی بات چھپی نہ ہو گی، یعنی بے پردہ صرف جسمانی اعتبار سے نہیں بلکہ اپنے اعمال کے اعتبار سے جو انہوں نے دنیا میں کیے۔ اس روز پکار کے پوچھا جائے گا: آج بادشاہت کس کی ہے؟" .

minaret:Segment_TQ2005-0319_0091 a minaret:TranscriptSegment ;
    minaret:endTime 980.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0092 ;
    minaret:sequenceIndex 91 ;
    minaret:startTime 969.78 ;
    minaret:text "آج مالک کون ہے؟ آج بادشاہ کون ہے؟ تو سارا عالم پکار اٹھے گا: «لِلَّهِ الْوَاحِدِ الْقَهَّارِ»، صرف ایک اللہ کی جو بہت زبردست ہے!" .

minaret:Segment_TQ2005-0319_0092 a minaret:TranscriptSegment ;
    minaret:endTime 994.05 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0093 ;
    minaret:sequenceIndex 92 ;
    minaret:startTime 981.48 ;
    minaret:text "پھر فرمایا: آج ہر شخص کو اس کی کمائی کا بدلہ دے دیا جائے گا۔ وہ دن بدلے کا دن ہے جس کا وہ مالک ہے، اسی کی بادشاہت ہو گی اس دن اور وہ ہر ایک کو اس کے کیے کا بدلہ دے گا۔" .

minaret:Segment_TQ2005-0319_0093 a minaret:TranscriptSegment ;
    minaret:endTime 1007.04 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0094 ;
    minaret:sequenceIndex 93 ;
    minaret:startTime 995.24 ;
    minaret:text "آج ہر متنفس کو اس کی کمائی کا بدلہ دیا جائے گا جو اس نے کی تھی، آج کسی پر کوئی ظلم نہ ہو گا اور اللہ حساب لینے میں بہت تیز ہے، حساب لیتے اس کو دیر نہیں لگتی۔" .

minaret:Segment_TQ2005-0319_0096 a minaret:TranscriptSegment ;
    minaret:endTime 1042.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0097 ;
    minaret:sequenceIndex 96 ;
    minaret:startTime 1031.6 ;
    minaret:text "«اِیَّاكَ نَعْبُدُ وَاِیَّاكَ نَسْتَعِیْنُ»، اگر وہ مالک ہے اس دن کا تو پھر ہمیں بھی کیا کرنا چاہیے؟ صرف اس کے بن جانا چاہیے، only yours!" .

minaret:Segment_TQ2005-0319_0102 a minaret:TranscriptSegment ;
    minaret:endTime 1109.76 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0103 ;
    minaret:sequenceIndex 102 ;
    minaret:startTime 1099.68 ;
    minaret:text "تیری ہی مدد چاہیے ہمیں، تیرے ہی بھروسے پہ ہم چل رہے ہیں۔ «اِهْدِنَا الصِّرَاطَ الْمُسْتَقِیْمَ»، تیری عبادت کے لیے ہمیں تیرا ہی بتایا ہوا راستہ چاہیے۔" .

minaret:Segment_TQ2005-0319_0119 a minaret:TranscriptSegment ;
    minaret:endTime 1287.3 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0120 ;
    minaret:sequenceIndex 119 ;
    minaret:startTime 1277.62 ;
    minaret:text "اور مراد یہاں نماز سے سورۃ الفاتحہ ہے، میں نے نماز کو اپنے اور بندے کے درمیان آدھا آدھا تقسیم کر دیا ہے،" .

minaret:Segment_TQ2005-0319_0120 a minaret:TranscriptSegment ;
    minaret:endTime 1297.84 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0121 ;
    minaret:sequenceIndex 120 ;
    minaret:startTime 1288.5 ;
    minaret:text "آدھی میرے لیے ہے اور آدھی میرے بندے کے لیے، جو کچھ وہ سوال کرے، یعنی بندے کے لیے کیا ہے جو وہ مانگے۔" .

minaret:Segment_TQ2005-0319_0121 a minaret:TranscriptSegment ;
    minaret:endTime 1310.8 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0122 ;
    minaret:sequenceIndex 121 ;
    minaret:startTime 1299.58 ;
    minaret:text "میرا بندہ نماز میں کھڑا ہوتا ہے اور کہتا ہے: «اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِیْنَ»، تو اللہ تعالیٰ فرماتا ہے: میرے بندے نے میری تعریف کی،" .

minaret:Segment_TQ2005-0319_0122 a minaret:TranscriptSegment ;
    minaret:endTime 1317.98 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0123 ;
    minaret:sequenceIndex 122 ;
    minaret:startTime 1312.52 ;
    minaret:text "لیکن اگر ہم سوچتے ہی نہیں اس وقت تو اللہ تعالیٰ کیا جواب دیتے ہوں گے؟" .

minaret:Segment_TQ2005-0319_0123 a minaret:TranscriptSegment ;
    minaret:endTime 1329.14 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0124 ;
    minaret:sequenceIndex 123 ;
    minaret:startTime 1319.56 ;
    minaret:text "پھر وہ کہتا ہے: «الرَّحْمٰنِ الرَّحِیْمِ»، تو اللہ تعالیٰ فرماتا ہے: میرے بندے نے میری ثنا بیان کی، یعنی تعریف کی۔" .

minaret:Segment_TQ2005-0319_0124 a minaret:TranscriptSegment ;
    minaret:endTime 1341.96 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0125 ;
    minaret:sequenceIndex 124 ;
    minaret:startTime 1330.12 ;
    minaret:text "پھر وہ کہتا ہے: «مٰلِكِ یَوْمِ الدِّیْنِ»، تو اللہ تعالیٰ فرماتا ہے: میرے بندے نے میری بزرگی بیان کی۔ اور «اِیَّاكَ نَعْبُدُ وَاِیَّاكَ نَسْتَعِیْنُ»" .

minaret:Segment_TQ2005-0319_0125 a minaret:TranscriptSegment ;
    minaret:endTime 1353.58 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0126 ;
    minaret:sequenceIndex 125 ;
    minaret:startTime 1342.62 ;
    minaret:text "میرے اور میرے بندے کے درمیان مشترک ہے، اور سورت کا باقی حصہ میرے بندے کے لیے ہے اور میرے بندے کو وہ کچھ ملے گا جو اس نے مانگا۔" .

minaret:Segment_TQ2005-0319_0126 a minaret:TranscriptSegment ;
    minaret:endTime 1367.42 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0127 ;
    minaret:sequenceIndex 126 ;
    minaret:startTime 1354.64 ;
    minaret:text "میرے بندے کو وہ کچھ ملے گا جو اس نے مانگا۔ تو مانگتے ہوئے پھر کیفیت کیا ہونی چاہیے؟ واقعی مانگنے والے کی، صرف پڑھنے والے کی نہیں!" .

minaret:Segment_TQ2005-0319_0139 a minaret:TranscriptSegment ;
    minaret:endTime 1503.8 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0140 ;
    minaret:sequenceIndex 139 ;
    minaret:startTime 1493.16 ;
    minaret:text "اس کتاب کو پڑھیں، کیونکہ «ذٰلِكَ الْكِتٰبُ لَا رَیْبَ ۛ فِیْهِ ۛ هُدًى لِّلْمُتَّقِیْنَ» اور ہدی للناس۔ نمبر دو: صرف دیکھ کر پھر اس کو بند نہ کر دیں، چلیں!" .

minaret:Segment_TQ2005-0319_0141 a minaret:TranscriptSegment ;
    minaret:endTime 1523.62 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0142 ;
    minaret:sequenceIndex 141 ;
    minaret:startTime 1514.78 ;
    minaret:text "اب اس صراط کی مزید وضاحت ہے: «صِرَاطَ الَّذِیْنَ اَنْعَمْتَ عَلَیْهِمْ»، ان لوگوں کا راستہ جن پر تُو نے انعام کیا۔" .

minaret:Segment_TQ2005-0319_0147 a minaret:TranscriptSegment ;
    minaret:endTime 1586.6 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0148 ;
    minaret:sequenceIndex 147 ;
    minaret:startTime 1574.74 ;
    minaret:text "تو «صِرَاطَ الَّذِیْنَ اَنْعَمْتَ عَلَیْهِمْ» کن کا راستہ ہے؟ اللہ کے پیاروں کا راستہ ہے۔ اے اللہ! اپنے پیاروں میں شامل کر لے: «وَاَدْخِلْنِیْ بِرَحْمَتِكَ فِیْ عِبَادِكَ الصّٰلِحِیْنَ»۔" .

minaret:Segment_TQ2005-0319_0148 a minaret:TranscriptSegment ;
    minaret:endTime 1600.68 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0149 ;
    minaret:sequenceIndex 148 ;
    minaret:startTime 1587.52 ;
    minaret:text "یوسف علیہ السلام کو جب مصر کی بادشاہت ملی، کیا مانگا انہوں نے؟ «فَاطِرَ السَّمٰوٰتِ وَالْاَرْضِ اَنْتَ وَلِیّٖ فِی الدُّنْیَا وَالْاٰخِرَةِ ۚ تَوَفَّنِیْ مُسْلِمًا وَّاَلْحِقْنِیْ بِالصّٰلِحِیْنَ»۔" .

minaret:Segment_TQ2005-0319_0153 a minaret:TranscriptSegment ;
    minaret:endTime 1652.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0154 ;
    minaret:sequenceIndex 153 ;
    minaret:startTime 1646.18 ;
    minaret:text "«فَاُولٰٓىِٕكَ مَعَ الَّذِیْنَ اَنْعَمَ اللّٰهُ عَلَیْهِمْ مِّنَ النَّبِیّٖنَ وَالصِّدِّیْقِیْنَ وَالشُّهَدَآءِ وَالصّٰلِحِیْنَ»" .

minaret:Segment_TQ2005-0319_0154 a minaret:TranscriptSegment ;
    minaret:endTime 1663.16 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0155 ;
    minaret:sequenceIndex 154 ;
    minaret:startTime 1653.68 ;
    minaret:text "«غَیْرِ الْمَغْضُوْبِ عَلَیْهِمْ»، اے اللہ! مجھے ان لوگوں جیسا نہیں بننا جن پر تیرا غضب ہوا، جن سے تو ناراض ہوا ہے، ان کا راستہ نہیں چاہیے مجھے۔" .

minaret:Segment_TQ2005-0319_0161 a minaret:TranscriptSegment ;
    minaret:endTime 1747.56 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0162 ;
    minaret:sequenceIndex 161 ;
    minaret:startTime 1735.04 ;
    minaret:text "مثلاً قرآن پاک میں ایک مثال ہے: «یٰۤاَیُّهَا الَّذِیْنَ اٰمَنُوْا لِمَ تَقُوْلُوْنَ مَا لَا تَفْعَلُوْنَ ۟ كَبُرَ مَقْتًا عِنْدَ اللّٰهِ اَنْ تَقُوْلُوْا مَا لَا تَفْعَلُوْنَ»۔ اے لوگو جو ایمان لائے ہو! کیوں وہ باتیں کہتے ہو جو کرتے نہیں ہو؟" .

minaret:Segment_TQ2005-0319_0171 a minaret:TranscriptSegment ;
    minaret:endTime 1845.06 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0172 ;
    minaret:sequenceIndex 171 ;
    minaret:startTime 1842.38 ;
    minaret:text "«قَالَ رَبِّ اِنِّیْ دَعَوْتُ قَوْمِیْ لَیْلًا وَّنَهَارًا»" .

minaret:Segment_TQ2005-0319_0181 a minaret:TranscriptSegment ;
    minaret:endTime 1946.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0182 ;
    minaret:sequenceIndex 181 ;
    minaret:startTime 1939.08 ;
    minaret:text "«قُلْ اِنْ كُنْتُمْ تُحِبُّوْنَ اللّٰهَ فَاتَّبِعُوْنِیْ یُحْبِبْكُمُ اللّٰهُ»" .

minaret:Segment_TQ2005-0319_0184 a minaret:TranscriptSegment ;
    minaret:endTime 1977.44 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0185 ;
    minaret:sequenceIndex 184 ;
    minaret:startTime 1964.04 ;
    minaret:text "باتیں کرے یا کام کرے۔ اور ان میں نمبر ون: جو نہ کیا ہو وہ کہے کہ میں نے کیا ہے، اور جو نہ کرنا ہو وہ کہے کہ میں کروں گا۔ «وَلَا الضَّآلِّیْنَ»، ض، ل، ل،" .

minaret:Segment_TQ2005-0319_0191 a minaret:TranscriptSegment ;
    minaret:endTime 2053.24 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0192 ;
    minaret:sequenceIndex 191 ;
    minaret:startTime 2042.84 ;
    minaret:text "«اَتْمَمْتُ عَلَیْكُمْ نِعْمَتِیْ»، اسلام کو نعمت کہا گیا۔ تو جو اسلام میں داخل ہو گیا، پھر اس کے بعد اس کو راستہ مل گیا، سچا راستہ، پھر اس کے بعد اس نے دین کا علم حاصل کیا،" .

minaret:SegmentGroup_TQ2005-0315_300_64_320_26 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_TQ2005-0315_0027,
        minaret:Segment_TQ2005-0315_0028 ;
    minaret:endTime 320.26 ;
    minaret:startTime 300.64 .

minaret:SegmentGroup_TQ2005-0317_28_68_42_92 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_TQ2005-0317_0003 ;
    minaret:endTime 42.92 ;
    minaret:startTime 28.68 .

minaret:Segment_TQ2005-0315_0003 a minaret:TranscriptSegment ;
    minaret:endTime 52.48 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0315_0004 ;
    minaret:sequenceIndex 3 ;
    minaret:startTime 38.2 ;
    minaret:text "ٹکڑے ٹکڑے ہو گیا ہے، «مِّنْ خَشْیَةِ اللّٰهِ»، اللہ کے خوف سے۔ یہ اللہ کا کلام ہے، کوئی معمولی چیز نہیں ہے۔ «اِنَّهٗ لَقَوْلٌ فَصْلٌ ۙ وَّمَا هُوَ بِالْهَزْلِ»" .

minaret:Segment_TQ2005-0316_0007 a minaret:TranscriptSegment ;
    minaret:endTime 74.26 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0316_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 64.86 ;
    minaret:text "«وَ» اور، «اِیَّاكَ» صرف تیری ہی، «نَسْتَعِیْنُ» ہم مدد چاہتے ہیں۔ «اِهْدِنَا»" .

minaret:Segment_TQ2005-0316_0008 a minaret:TranscriptSegment ;
    minaret:endTime 83.66 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0316_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 74.26 ;
    minaret:text "ہدایت دے ہمیں، «الصِّرَاطَ» راستے، «الْمُسْتَقِیْمَ» سیدھے کی، «صِرَاطَ» راستہ،" .

minaret:Segment_TQ2005-0318_0071 a minaret:TranscriptSegment ;
    minaret:endTime 793.44 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0318_0072 ;
    minaret:sequenceIndex 71 ;
    minaret:startTime 782.78 ;
    minaret:text "ناگوار رہا ہے کہ only yours کیوں؟ اللہ نے ہمیں اپنی عبادت کے لیے پیدا کیا: «وَمَا خَلَقْتُ الْجِنَّ وَالْاِنْسَ اِلَّا لِیَعْبُدُوْنِ»، اور ہم بندوں کے only yours ہو گئے۔" .

minaret:Segment_TQ2005-0319_0012 a minaret:TranscriptSegment ;
    minaret:endTime 137.72 ;
    minaret:precedesSegment minaret:Segment_TQ2005-0319_0013 ;
    minaret:sequenceIndex 12 ;
    minaret:startTime 127.9 ;
    minaret:text "تجھے قرآن کی ایک ایسی سورت بتلاؤں گا جو قرآن کی سب سورتوں سے بڑھ کر ہے، اور وہ ہے «اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِیْنَ»، اور" .

