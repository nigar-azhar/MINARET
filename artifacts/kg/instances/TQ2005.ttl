    minaret:endTime 269.24 ;
    minaret:evidenceText "نیکی کی طرف رہنمائی کرنے والا ایسا ہی ہے جیسے خود کرنے والا" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_TQ2005-0314_258_32_269_24 ;
    minaret:refersTo minaret:Hadith_JT_2670 ;
    minaret:startTime 258.32 .

minaret:HadithOccurrence_TQ2005-0314_0003_936_94_JT_2317 a minaret:HadithOccurrence ;
    minaret:endTime 948.26 ;
    minaret:evidenceText "«مِنْ حُسْنِ اِسْلَامِ الْمَرْءِ تَرْكُهٗ مَا لَا یَعْنِیْهِ»" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_TQ2005-0314_936_94_948_26 ;
    minaret:refersTo minaret:Hadith_JT_2317 ;
    minaret:startTime 936.94 .

minaret:HadithOccurrence_TQ2005-0314_0004_936_94_JT_2317 a minaret:HadithOccurrence ;
    minaret:endTime 948.26 ;
    minaret:evidenceText "اسلام کا حسن کیا ہے، خوبصورتی کیا ہے؟ کہ ان باتوں کو چھوڑ دے جس سے اس کا کوئی مطلب نہیں۔" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_TQ2005-0314_936_94_948_26 ;
    minaret:refersTo minaret:Hadith_JT_2317 ;
    minaret:startTime 936.94 .

minaret:HadithOccurrence_TQ2005-0314_0005_1046_46_SB_723 a minaret:HadithOccurrence ;
    minaret:endTime 1050.62 ;
    minaret:evidenceText "«فَاِنَّ تَسْوِیَةَ الصُّفُوْفِ مِنْ اِقَامَةِ الصَّلٰوةِ»" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_TQ2005-0314_1046_46_1050_62 ;
    minaret:refersTo minaret:Hadith_SB_723 ;
    minaret:startTime 1046.46 .

