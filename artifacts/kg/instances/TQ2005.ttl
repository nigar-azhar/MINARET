minaret:QuranVerse_26_196 a minaret:QuranVerse ;
    minaret:juz 19 ;
    minaret:surahNumber 26 ;
    minaret:textClean "وإنه لفي زبر الأولين" ;
    minaret:textIndopak "وَاِنَّهٗ لَفِیْ زُبُرِ الْاَوَّلِیْنَ ۟" ;
    minaret:textUthmani "وَإِنَّهُۥ لَفِي زُبُرِ ٱلۡأَوَّلِينَ" ;
