    minaret:sequenceIndex 96 ;
    minaret:startTime 520.5 ;
    minaret:text " اس کی جان  اس کے دونوں پہلوں سے نکل رہی ہوتی ہے  جان نکل رہی ہوتی ہے" .

minaret:Segment_SKD2025-0004_0097 a minaret:TranscriptSegment ;
