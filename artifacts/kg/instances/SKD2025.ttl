minaret:Segment_SKD2025-0002_0004 a minaret:TranscriptSegment ;
    minaret:endTime 14.94 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_0005 ;
    minaret:sequenceIndex 4 ;
