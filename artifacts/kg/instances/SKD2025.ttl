    minaret:text "فَأَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ" .

minaret:Segment_SKD2025-0002_0005 a minaret:TranscriptSegment ;
    minaret:endTime 17.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_0006 ;
    minaret:sequenceIndex 5 ;
