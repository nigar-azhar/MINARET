    minaret:sequenceIndex 120 ;
    minaret:startTime 620.88 ;
    minaret:text " ہوتی ہے  پھر ماں کیا کرتی  اس کے ساتھ" .

minaret:Segment_SKD2025-0004_0121 a minaret:TranscriptSegment ;
