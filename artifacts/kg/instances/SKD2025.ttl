    minaret:sequenceIndex 142 ;
    minaret:startTime 690.54 ;
    minaret:text " اس کا ذکر کیا بغیر  کوئی چیز نہیں  عربی زبان میں" .

minaret:Segment_SKD2025-0004_0143 a minaret:TranscriptSegment ;
    minaret:endTime 697.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0144 ;
    minaret:sequenceIndex 143 ;
    minaret:startTime 693.9399999999999 ;
    minaret:text " نعمت پر  شکر کرنے کے لئے  حمد کا لفظی استعمال ہوتا ہے" .

minaret:Segment_SKD2025-0004_0144 a minaret:TranscriptSegment ;
