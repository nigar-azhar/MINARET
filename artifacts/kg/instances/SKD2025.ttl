    minaret:precedesSegment minaret:Segment_SKD2025-0004_0135 ;
    minaret:sequenceIndex 134 ;
    minaret:startTime 663.02 ;
    minaret:text " اگر نہیں کرتے  تو ہمیں فرق پڑتا ہے  ہماری تکلیف" .

minaret:Segment_SKD2025-0004_0135 a minaret:TranscriptSegment ;
