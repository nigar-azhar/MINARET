    minaret:sequenceIndex 446 ;
    minaret:startTime 2486.62 ;
    minaret:text " یہ بیماری لا علاج ہے  مریضوں کے پاس جا کے  ایسی باتیں کر رہے ہوتے ہیں" .

minaret:Segment_SKD2025-0001_0447 a minaret:TranscriptSegment ;
