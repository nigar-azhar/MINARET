    minaret:precedesSegment minaret:Segment_SKD2025-0004_0146 ;
    minaret:sequenceIndex 145 ;
    minaret:startTime 699.92 ;
    minaret:text " کہ ان کے درمیان  کوئی فرق نہیں  لیکن" .

minaret:Segment_SKD2025-0004_0146 a minaret:TranscriptSegment ;
