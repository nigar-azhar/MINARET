    minaret:sequenceIndex 59 ;
    minaret:startTime 349.46000000000004 ;
    minaret:text " دوسری قسم  مشکل حالات میں صبر کرنے والے لوگ  صبر کرنے والے" .

minaret:Segment_SKD2025-0004_0060 a minaret:TranscriptSegment ;
    minaret:endTime 361.92 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0061 ;
    minaret:sequenceIndex 60 ;
    minaret:startTime 355.26000000000005 ;
    minaret:text " یہ بھی بہت اچھے لوگ ہیں  کیونکہ ہمارا دین ہمیں کیا سکھاتا ہے  اور مومن دو حالتوں میں سے ایک حالت میں ہوتا ہے" .

minaret:Segment_SKD2025-0004_0061 a minaret:TranscriptSegment ;
    minaret:endTime 366.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0062 ;
    minaret:sequenceIndex 61 ;
    minaret:startTime 361.92 ;
    minaret:text " جب نعمت اس کو کویٔ ملتی  شکر ادا کرتا ہے  جب تکلیف آتی ہے تو وہ صبر کرتا ہے" .

minaret:Segment_SKD2025-0004_0062 a minaret:TranscriptSegment ;
