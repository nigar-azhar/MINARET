    minaret:precedesSegment minaret:Segment_SKD2025-0004_0120 ;
    minaret:sequenceIndex 119 ;
    minaret:startTime 619.0 ;
    minaret:text " تو  ماں تنگ ہوتی ہے  کہ نہیں" .

