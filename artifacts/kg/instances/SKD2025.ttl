    minaret:startTime 563.98 ;
    minaret:text " کہ چہرے پر ایسی مسکراہٹ تھی  اور چہرہ چمک رہا تھا  وفات کے بعد بھی" .

minaret:Segment_SKD2025-0004_0106 a minaret:TranscriptSegment ;
    minaret:endTime 572.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0107 ;
    minaret:sequenceIndex 106 ;
    minaret:startTime 568.4399999999999 ;
    minaret:text " کیونکہ ہر حال میں  انہوں نے کیا پکڑ لیا  الحمدللہ" .

minaret:Segment_SKD2025-0004_0107 a minaret:TranscriptSegment ;
    minaret:endTime 575.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0108 ;
    minaret:sequenceIndex 107 ;
    minaret:startTime 572.04 ;
    minaret:text " کہ میں نے زندگی میں  اتنی نعمتیں دیکھی ہیں  تو اب اس تکلیف میں" .

minaret:Segment_SKD2025-0004_0108 a minaret:TranscriptSegment ;
    minaret:endTime 580.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0109 ;
    minaret:sequenceIndex 108 ;
    minaret:startTime 575.76 ;
    minaret:text " بھی کوئی خیر ہے  یہ بھی میرے رب کا فیصلہ ہے  تو آپ نے اپنے لئے" .

minaret:Segment_SKD2025-0004_0110 a minaret:TranscriptSegment ;
    minaret:endTime 588.9 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0111 ;
    minaret:sequenceIndex 110 ;
    minaret:startTime 584.74 ;
    minaret:text " اور ہر مشکل میں  الحمدللہ  الحمدللہ" .

minaret:Segment_SKD2025-0004_0111 a minaret:TranscriptSegment ;
    minaret:endTime 593.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0112 ;
    minaret:sequenceIndex 111 ;
    minaret:startTime 588.9 ;
    minaret:text " بہترین دعا ہے  بہترین دوا ہے  بہترین علاج ہے" .

minaret:Segment_SKD2025-0004_0112 a minaret:TranscriptSegment ;
    minaret:endTime 596.5799999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0113 ;
    minaret:sequenceIndex 112 ;
    minaret:startTime 593.3 ;
    minaret:text " کیونکہ  شکر گزار بندہ ہی  دراصل" .

minaret:Segment_SKD2025-0004_0113 a minaret:TranscriptSegment ;
    minaret:endTime 599.5999999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0114 ;
    minaret:sequenceIndex 113 ;
    minaret:startTime 596.5799999999999 ;
    minaret:text " الحمدللہ  کہہ سکتا ہے  اور اللہ کا وعدہ ہے" .

minaret:Segment_SKD2025-0004_0116 a minaret:TranscriptSegment ;
    minaret:endTime 611.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0117 ;
    minaret:sequenceIndex 116 ;
    minaret:startTime 607.92 ;
    minaret:text " محبت کے ساتھ  اس کی خوبیاں بیان کرنا  یعنی" .

minaret:Segment_SKD2025-0004_0117 a minaret:TranscriptSegment ;
    minaret:endTime 614.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0118 ;
    minaret:sequenceIndex 117 ;
    minaret:startTime 611.4 ;
    minaret:text " حمد نکلتی ہے  محبت کی وجہ سے  جس کو" .

minaret:Segment_SKD2025-0004_0118 a minaret:TranscriptSegment ;
