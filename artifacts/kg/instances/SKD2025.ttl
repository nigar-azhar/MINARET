    minaret:precedesSegment minaret:Segment_SKD2025-0004_0119 ;
    minaret:sequenceIndex 118 ;
    minaret:startTime 614.56 ;
    minaret:text " اللہ سے محبت ہوتی ہے  آپ دیکھیں کہ  بچہ جب رو رہا ہوتا ہے" .

minaret:Segment_SKD2025-0004_0119 a minaret:TranscriptSegment ;
