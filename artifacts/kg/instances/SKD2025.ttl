    minaret:precedesSegment minaret:Segment_SKD2025-0004_0149 ;
    minaret:sequenceIndex 148 ;
    minaret:startTime 707.24 ;
    minaret:text " بولا جاتا ہے  اور اس کے علاوہ بھی  بولا جاتا ہے" .

minaret:Segment_SKD2025-0004_0149 a minaret:TranscriptSegment ;
    minaret:endTime 712.5200000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0150 ;
    minaret:sequenceIndex 149 ;
    minaret:startTime 709.38 ;
    minaret:text " تو الحمدللہ کا  مطلب ہوتا ہے  شکر خالصتا" .

minaret:Segment_SKD2025-0004_0150 a minaret:TranscriptSegment ;
    minaret:endTime 715.5600000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0151 ;
    minaret:sequenceIndex 150 ;
    minaret:startTime 712.5200000000001 ;
    minaret:text " اللہ ہی کے لئے ہے  اور  اللہ کے علاوہ" .

minaret:Segment_SKD2025-0004_0151 a minaret:TranscriptSegment ;
    minaret:endTime 718.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0152 ;
    minaret:sequenceIndex 151 ;
    minaret:startTime 715.5600000000001 ;
    minaret:text " جس کی بھی  عبادت کی جاتی ہے  اس کا کوئی شکر نہیں" .

minaret:Segment_SKD2025-0004_0152 a minaret:TranscriptSegment ;
    minaret:endTime 722.34 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0153 ;
    minaret:sequenceIndex 152 ;
    minaret:startTime 718.76 ;
    minaret:text " اس نے کچھ دیا ہی نہیں  اس کی تعریف نہیں  تو آپ دیکھئے کہ" .

minaret:Segment_SKD2025-0004_0153 a minaret:TranscriptSegment ;
