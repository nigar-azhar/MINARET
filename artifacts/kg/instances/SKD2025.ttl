    minaret:nameEn "Hope and perseverance in supplication" ;
    minaret:nameUr "دعا میں امید اور استقامت" ;
    skos:related minaret:Topic_Supplication_in_Islam_Ad_Du_a .

minaret:Topic_Supplication_and_humility a minaret:Topic ;
