    minaret:sequenceIndex 62 ;
    minaret:startTime 366.62 ;
    minaret:text " تو یہ کیا ہے  مومن کے لئے ایک بارڈر لائن ہے  کہ اتنا تو کرنا ہی کرنا ہے" .

minaret:Segment_SKD2025-0004_0063 a minaret:TranscriptSegment ;
