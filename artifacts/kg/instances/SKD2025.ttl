minaret:Segment_SKD2025-0004_0064 a minaret:TranscriptSegment ;
    minaret:endTime 380.78 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0065 ;
    minaret:sequenceIndex 64 ;
    minaret:startTime 375.14 ;
    minaret:text " اللہ کی رضا میں راضی  اور خوش رہتے ہیں  یہ اس سے ایک اونچا درجہ ہے" .

minaret:Segment_SKD2025-0004_0065 a minaret:TranscriptSegment ;
