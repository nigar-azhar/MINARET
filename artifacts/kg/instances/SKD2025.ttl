    minaret:descriptionUr "علاج کے ساتھ دعا، توکل اور اللہ کے سامنے عاجزی اختیار کرنا۔" ;
    minaret:nameEn "Supplication and reliance on Allah" ;
    minaret:nameUr "دعا اور توکل" ;
    skos:related minaret:Topic_Supplication_in_Islam_Ad_Du_a .

minaret:Topic_Supplication_and_visiting_the_sick a minaret:Topic ;
