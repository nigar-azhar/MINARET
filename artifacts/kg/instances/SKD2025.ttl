    minaret:sequenceIndex 447 ;
    minaret:startTime 2490.5 ;
    minaret:text " تو اللہ ایسے انسانوں سے  ہمیں بچا کے رکھے  پناہ میں رکھے" .

minaret:Segment_SKD2025-0001_0448 a minaret:TranscriptSegment ;
