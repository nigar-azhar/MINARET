    minaret:precedesSegment minaret:Segment_SKD2025-0004_0129 ;
    minaret:sequenceIndex 128 ;
    minaret:startTime 644.4 ;
    minaret:text " ٹھیک ہے  ہماری تعریف  سے اللہ تعالیٰ کو" .

minaret:Segment_SKD2025-0004_0129 a minaret:TranscriptSegment ;
    minaret:endTime 649.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0130 ;
    minaret:sequenceIndex 129 ;
    minaret:startTime 647.1 ;
    minaret:text " کوئی فائدہ پہنچتا ہے  نہیں  اور" .

minaret:Segment_SKD2025-0004_0130 a minaret:TranscriptSegment ;
    minaret:endTime 652.6999999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0131 ;
    minaret:sequenceIndex 130 ;
    minaret:startTime 649.4 ;
    minaret:text " ہم نہ تعریف کریں  تو اس کو کوئی نقصان ہوتا ہے  نہیں" .

minaret:Segment_SKD2025-0004_0131 a minaret:TranscriptSegment ;
    minaret:endTime 655.86 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0132 ;
    minaret:sequenceIndex 131 ;
    minaret:startTime 652.6999999999999 ;
    minaret:text " وہ بے نیاز ہے  یہ دراصل  بندوں کے" .

minaret:Segment_SKD2025-0004_0132 a minaret:TranscriptSegment ;
