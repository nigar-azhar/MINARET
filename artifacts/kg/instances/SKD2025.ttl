    minaret:text "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ" .

minaret:Segment_SKD2025-0002_0006 a minaret:TranscriptSegment ;
    minaret:endTime 24.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_0007 ;
    minaret:sequenceIndex 6 ;
