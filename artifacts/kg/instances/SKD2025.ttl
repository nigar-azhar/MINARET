    minaret:sequenceIndex 439 ;
    minaret:startTime 2457.6 ;
    minaret:text " گہرہ اثر ڈالتی ہیں  منفی سوچ negative thinking" .

minaret:Segment_SKD2025-0001_0444 a minaret:TranscriptSegment ;
