        minaret:Segment_SKD2025-0001_0288 ;
    minaret:endTime 1607.3 ;
    minaret:startTime 1596.92 .

minaret:SegmentGroup_SKD2025-0001_1977_8_1986_22 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_SKD2025-0001_0357,
        minaret:Segment_SKD2025-0001_0358 ;
    minaret:endTime 1986.22 ;
    minaret:startTime 1977.8 .

minaret:SegmentGroup_SKD2025-0001_19_58_29_66 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_SKD2025-0001_0002 ;
    minaret:endTime 29.66 ;
    minaret:startTime 19.58 .

minaret:SegmentGroup_SKD2025-0001_2073_12_2082_96 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_SKD2025-0001_0370,
        minaret:Segment_SKD2025-0001_0371 ;
    minaret:endTime 2082.96 ;
    minaret:startTime 2073.12 .

minaret:Segment_SKD2025-0001_0000 a minaret:TranscriptSegment ;
    minaret:endTime 11.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0001 ;
    minaret:sequenceIndex 0 ;
    minaret:startTime 0.0 ;
    minaret:text "السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ وَعَلَيْكُمُ السَّلَامُ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ نَحْمَدُهُ وَنُصَلِّیْ عَلٰی رَسُوْلِهِ الْکَرِیْمِ" .

minaret:Segment_SKD2025-0001_0005 a minaret:TranscriptSegment ;
    minaret:endTime 52.120000000000005 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 45.76 ;
    minaret:text " اللہ سبحانہ وتعالی کی طرف  ہدایت اور توفیق کے بعد  سب سے بڑی نعمت" .

minaret:Segment_SKD2025-0001_0006 a minaret:TranscriptSegment ;
    minaret:endTime 58.44 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 52.120000000000005 ;
    minaret:text " خود ہماری زندگی ہے  اور اس زندگی میں  صحت اور عافیت بہت بڑی نعمت ہے" .

minaret:Segment_SKD2025-0001_0007 a minaret:TranscriptSegment ;
    minaret:endTime 63.42 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 58.44 ;
    minaret:text " اعضاء کا سلامت ہونا  بیماریوں سے محفوظ ہونا  طاقتور ہونا" .

minaret:Segment_SKD2025-0001_0008 a minaret:TranscriptSegment ;
    minaret:endTime 70.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 63.42 ;
    minaret:text " کسی کام کے قابل ہونا  یہ اللہ تعالی کی بہت بڑی نعمتیں  اور جب کوئی نعمت ملتی ہے تو کیا کرتے ہیں" .

minaret:Segment_SKD2025-0001_0009 a minaret:TranscriptSegment ;
    minaret:endTime 76.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 70.56 ;
    minaret:text " شکر ادا کرتے ہیں  اس نعمت کا صحیح استعمال کرتے ہیں  صحیح استعمال" .

minaret:Segment_SKD2025-0001_0010 a minaret:TranscriptSegment ;
    minaret:endTime 82.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 76.8 ;
    minaret:text " شکر کہلاتا ہے  اور شکر کا فائدہ کیا ہوتا ہے  نعمت میں اضافہ ہوتا ہے" .

minaret:Segment_SKD2025-0001_0011 a minaret:TranscriptSegment ;
    minaret:endTime 90.28 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0012 ;
    minaret:sequenceIndex 11 ;
    minaret:startTime 82.06 ;
    minaret:text " نعمت کی حفاظت ہوتی ہے  تو الحمدللہ جو لوگ ہم میں سے صحت مند ہیں  انہیں اپنی اس نعمت پر شکر ادا کرنا چاہیے " .

minaret:Segment_SKD2025-0001_0012 a minaret:TranscriptSegment ;
    minaret:endTime 98.12 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0013 ;
    minaret:sequenceIndex 12 ;
    minaret:startTime 90.28 ;
    minaret:text " لیکن کوئی انسان بھی ایسا نہیں ہے  جسے زندگی میں کبھی نہ کبھی بیمار ہونے کا اتفاق نہ ہوا ہو  بلکہ اگر یوں کہا جائے" .

minaret:Segment_SKD2025-0001_0013 a minaret:TranscriptSegment ;
    minaret:endTime 104.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0014 ;
    minaret:sequenceIndex 13 ;
    minaret:startTime 98.12 ;
    minaret:text " کہ ہم میں سے ہر شخص  کسی نہ کسی  چھوٹی یا بڑی بیماری کا شکار ہے" .

minaret:Segment_SKD2025-0001_0014 a minaret:TranscriptSegment ;
    minaret:endTime 110.28 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0015 ;
    minaret:sequenceIndex 14 ;
    minaret:startTime 104.3 ;
    minaret:text " جب انسان بیمار ہوتا ہے  تو اس کا سب سے بڑا نقصان یہ ہوتا ہے  کہ وہ اللہ تعالی کی عبادت" .

minaret:Segment_SKD2025-0001_0019 a minaret:TranscriptSegment ;
    minaret:endTime 141.42000000000002 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0020 ;
    minaret:sequenceIndex 19 ;
    minaret:startTime 134.92000000000002 ;
    minaret:text " جب انسان بیمار ہوتا ہے  تو دوسروں پر بوجھ بن جاتا ہے  اور دوسرے اس سے تنگ آ جاتے ہیں" .

minaret:Segment_SKD2025-0001_0022 a minaret:TranscriptSegment ;
    minaret:endTime 159.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 154.92000000000002 ;
    minaret:text " علاج کرنے میں کچھ تو  مادی علاج ہوتے ہیں  جیسے کوئی دوا کھانا" .

minaret:Segment_SKD2025-0001_0023 a minaret:TranscriptSegment ;
    minaret:endTime 165.34 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 159.8 ;
    minaret:text " کوئی اور ٹوٹکے وغیرہ کرنا  کچھ لوگ تو ڈاکٹر کے پاس نہیں جاتے  صرف ٹوٹکے وغیرہ کر کے" .

minaret:Segment_SKD2025-0001_0024 a minaret:TranscriptSegment ;
    minaret:endTime 172.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 165.34 ;
    minaret:text " اپنا علاج کر لیتے ہیں  لیکن یہ طریقہ علاج کافی نہیں  مومن اپنی بیماریوں میں" .

minaret:Segment_SKD2025-0001_0025 a minaret:TranscriptSegment ;
    minaret:endTime 178.22 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 172.0 ;
    minaret:text " دعا سے کام لیتا ہے  دعا سے فائدہ اٹھاتا ہے  اور شفا اور دعا کا" .

minaret:Segment_SKD2025-0001_0026 a minaret:TranscriptSegment ;
    minaret:endTime 184.64000000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 178.22 ;
    minaret:text " آپس میں گہرہ روحانی تعلق ہے  بندے کا کام ہے دعا مانگنا  اور اللہ کا کام ہے" .

minaret:Segment_SKD2025-0001_0027 a minaret:TranscriptSegment ;
    minaret:endTime 189.64000000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 184.64000000000001 ;
    minaret:text " شفا دینا  ابراہیم علیہ السلام نے کہا تھا نا وَإِذَا مَرِضْتُ" .

minaret:Segment_SKD2025-0001_0030 a minaret:TranscriptSegment ;
    minaret:endTime 209.17999999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0031 ;
    minaret:sequenceIndex 30 ;
    minaret:startTime 202.7 ;
    minaret:text " اللہ کے اذن سے وہ علاج کرتا ہے  میں نے فلاں ڈاکٹر سے علاج کروایا  مجھے بہت فائدہ ہوا" .

minaret:Segment_SKD2025-0001_0031 a minaret:TranscriptSegment ;
    minaret:endTime 214.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0032 ;
    minaret:sequenceIndex 31 ;
    minaret:startTime 209.17999999999998 ;
    minaret:text " یہ کہہ سکتے ہیں  لیکن اس ڈاکٹر نے مجھے شفا دی  یا اس ڈاکٹر کے ہاتھ میں شفا ہے" .

minaret:Segment_SKD2025-0001_0037 a minaret:TranscriptSegment ;
    minaret:endTime 247.82 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0038 ;
    minaret:sequenceIndex 37 ;
    minaret:startTime 244.24 ;
    minaret:text " فرق کس چیز کا ہے  ایک کو اللہ نے شفا دی  اور دوسرے کے بارے میں" .

minaret:Segment_SKD2025-0001_0038 a minaret:TranscriptSegment ;
    minaret:endTime 254.78 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0039 ;
    minaret:sequenceIndex 38 ;
    minaret:startTime 247.82 ;
    minaret:text " اللہ کا اذن نہیں تھا  لہذا ہمیں دعا مانگتے رہنا چاہیے  زندگی کے ہر مسئلے میں دعا مانگنی چاہیے" .

minaret:Segment_SKD2025-0001_0039 a minaret:TranscriptSegment ;
    minaret:endTime 259.72 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0040 ;
    minaret:sequenceIndex 39 ;
    minaret:startTime 254.78 ;
    minaret:text " لیکن خاص طور پر شفا کے لیے  اور آپ دیکھیں  کہ بیماریوں کے بھی کئی قسمیں ہیں" .

minaret:Segment_SKD2025-0001_0040 a minaret:TranscriptSegment ;
    minaret:endTime 266.96 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0041 ;
    minaret:sequenceIndex 40 ;
    minaret:startTime 259.72 ;
    minaret:text " کچھ تو جسمانی بیماریاں ہوتی ہیں  لیکن کچھ ذہنی بیماریاں بھی ہوتی ہیں  روحانی بیماریاں بھی ہوتی ہیں" .

minaret:Segment_SKD2025-0001_0041 a minaret:TranscriptSegment ;
    minaret:endTime 274.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0042 ;
    minaret:sequenceIndex 41 ;
    minaret:startTime 266.96 ;
    minaret:text " اور کچھ اخلاقی بیماریاں بھی ہوتی ہیں  تو بیماریاں کی تو بہت سی قسمیں ہیں  ہم ان اقسام کی طرف نہیں جائیں گے" .

minaret:Segment_SKD2025-0001_0042 a minaret:TranscriptSegment ;
    minaret:endTime 280.73999999999995 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0043 ;
    minaret:sequenceIndex 42 ;
    minaret:startTime 274.06 ;
    minaret:text " لیکن بیماری کسی بھی قسم کی ہو  اس کی کوئی بھی نوعیت ہو  جسمانی ہو یا روحانی ہو" .

minaret:Segment_SKD2025-0001_0043 a minaret:TranscriptSegment ;
    minaret:endTime 289.79999999999995 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0044 ;
    minaret:sequenceIndex 43 ;
    minaret:startTime 280.73999999999995 ;
    minaret:text " ان سب میں دعا فائدہ دیتی ہیں  بلکہ کچھ بیماریاں تو ایسی ہیں  کہ جن میں دعا کے علاوہ کوئی چیز فائدہ نہیں دیتی" .

minaret:Segment_SKD2025-0001_0044 a minaret:TranscriptSegment ;
    minaret:endTime 299.82 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0045 ;
    minaret:sequenceIndex 44 ;
    minaret:startTime 289.79999999999995 ;
    minaret:text " دعا کا فائدہ کیا ہوتا ہے  کہ جہاں انسان کو بیماری سے نجات ملتی ہے  وہاں دعا انسان کو اللہ کے قریب بھی کرتی ہے" .

minaret:Segment_SKD2025-0001_0045 a minaret:TranscriptSegment ;
    minaret:endTime 306.92 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0046 ;
    minaret:sequenceIndex 45 ;
    minaret:startTime 299.82 ;
    minaret:text " دعا بذات خود ایک عبادت بھی ہے  تو دعا مانگنے کا صرف یہ مقصد نہیں  کہ ہمیں شفا ہو جائے" .

minaret:Segment_SKD2025-0001_0046 a minaret:TranscriptSegment ;
    minaret:endTime 316.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0047 ;
    minaret:sequenceIndex 46 ;
    minaret:startTime 306.92 ;
    minaret:text " بلکہ دعا کے ذریعے ہم ایک عبادت بھی کریں  بیماری کی حالت میں بھی  اور پھر اللہ سبحانہ وتعالی کے ساتھ" .

minaret:Segment_SKD2025-0001_0047 a minaret:TranscriptSegment ;
    minaret:endTime 322.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0048 ;
    minaret:sequenceIndex 47 ;
    minaret:startTime 316.04 ;
    minaret:text " ایک تعلق بھی قائم کریں  پھر اللہ سبحانہ وتعالی کے سامنے  ہم اپنی عاجزی کمزوری کا اظہار بھی کریں" .

minaret:Segment_SKD2025-0001_0048 a minaret:TranscriptSegment ;
    minaret:endTime 328.15999999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0049 ;
    minaret:sequenceIndex 48 ;
    minaret:startTime 322.52 ;
    minaret:text " جو اللہ تعالی کو پسند ہے  اور عبادت کی اصل بھی یہی ہے  کہ انسان اس بات کا اظہار کرے" .

minaret:Segment_SKD2025-0001_0049 a minaret:TranscriptSegment ;
    minaret:endTime 332.96 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0050 ;
    minaret:sequenceIndex 49 ;
    minaret:startTime 328.15999999999997 ;
    minaret:text " کہ اللہ میں کچھ نہیں  تو ہی سب کچھ ہے  میرے ہاتھ میں کچھ نہیں" .

minaret:Segment_SKD2025-0001_0050 a minaret:TranscriptSegment ;
    minaret:endTime 340.59999999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0051 ;
    minaret:sequenceIndex 50 ;
    minaret:startTime 332.96 ;
    minaret:text " تو ہی ہر چیز کا مالک ہے  اور ہر چیز کی تدبیر بھی تو ہی کرتا ہے  لہٰذا دعا جہاں فائدہ دیتی ہے" .

minaret:Segment_SKD2025-0001_0051 a minaret:TranscriptSegment ;
    minaret:endTime 345.08000000000004 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0052 ;
    minaret:sequenceIndex 51 ;
    minaret:startTime 340.59999999999997 ;
    minaret:text " شفا کی صورت میں  یعنی اس سے شفاحاصل ہوتی ہے  وہاں یہ کہ انسان کو" .

minaret:Segment_SKD2025-0001_0052 a minaret:TranscriptSegment ;
    minaret:endTime 353.38000000000005 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0053 ;
    minaret:sequenceIndex 52 ;
    minaret:startTime 345.08000000000004 ;
    minaret:text " بیماری کے دوران پر سکون بھی کرتی ہے  یعنی دعا سے سکون بھی حاصل ہوتا ہے  تو دعا کے اندر بہت گہرائی ہے" .

minaret:Segment_SKD2025-0001_0058 a minaret:TranscriptSegment ;
    minaret:endTime 384.47999999999996 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 379.91999999999996 ;
    minaret:text " کہ  ہر تکلیف میں ہمیں کس کی طرف رجوع کرنا ہے  اللہ کی طرف" .

minaret:Segment_SKD2025-0001_0059 a minaret:TranscriptSegment ;
    minaret:endTime 391.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0060 ;
    minaret:sequenceIndex 59 ;
    minaret:startTime 384.47999999999996 ;
    minaret:text " ہر تکلیف میں  پہلا خیال ہمیں اللہ تعالیٰ کا آنا چاہیے  پہلا دھیان ادھر جانا چاہیے" .

minaret:Segment_SKD2025-0001_0060 a minaret:TranscriptSegment ;
    minaret:endTime 396.68 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0061 ;
    minaret:sequenceIndex 60 ;
    minaret:startTime 391.06 ;
    minaret:text " اس پر اپنے آپ کو ٹیسٹ بھی کریں  کہ کیا ہم ایسا کرتے ہیں  کہ جب ہمیں کوئی مشکل پیش آتی ہے" .

minaret:Segment_SKD2025-0001_0061 a minaret:TranscriptSegment ;
    minaret:endTime 401.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0062 ;
    minaret:sequenceIndex 61 ;
    minaret:startTime 396.68 ;
    minaret:text " ہمارے جسم میں یہ باہر  تو کیا ہم اللہ تعالیٰ کی طرف رجوع کرتے ہیں  اگر نہیں تو ہمیں" .

minaret:Segment_SKD2025-0001_0064 a minaret:TranscriptSegment ;
    minaret:endTime 420.58 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0065 ;
    minaret:sequenceIndex 64 ;
    minaret:startTime 414.76 ;
    minaret:text " ٹھیک ہے  یعنی اگر آپ کو ڈاکٹرز جواب بھی دے جائیں  کہ آپ کے مرض کو کوئی علاج ہے ہی نہیں" .

minaret:Segment_SKD2025-0001_0072 a minaret:TranscriptSegment ;
    minaret:endTime 500.03999999999996 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0073 ;
    minaret:sequenceIndex 72 ;
    minaret:startTime 495.15999999999997 ;
    minaret:text " مائیں سوچیں ان کے بچے انہیں بلاتے ہیں  اماں اماں اماں  ماں ایک نہیں سنتی" .

minaret:Segment_SKD2025-0001_0073 a minaret:TranscriptSegment ;
    minaret:endTime 507.12 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0074 ;
    minaret:sequenceIndex 73 ;
    minaret:startTime 500.03999999999996 ;
    minaret:text " کتنی دفعہ اگنور کر دیتی  اسی طرح مدد کے لیے لوگ ہمیں پکارتے ہیں  ہم جواب نہیں دیتے ہیں" .

minaret:Segment_SKD2025-0001_0074 a minaret:TranscriptSegment ;
    minaret:endTime 515.5600000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0075 ;
    minaret:sequenceIndex 74 ;
    minaret:startTime 507.12 ;
    minaret:text " لیکن یقین کر لیجئے  کہ بندہ جب جہاں جس حال میں  جیسے بھی اپنے رب کو پکارتا ہے" .

minaret:Segment_SKD2025-0001_0082 a minaret:TranscriptSegment ;
    minaret:endTime 558.94 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0083 ;
    minaret:sequenceIndex 82 ;
    minaret:startTime 553.1800000000001 ;
    minaret:text " یا کسی بھی مشکل سے نکلنا کیسے ہے اور یہاں پر اللہ سبحانہ وتعالی  مومن بندوں سے خطاب کر  رہے " .

minaret:Segment_SKD2025-0001_0083 a minaret:TranscriptSegment ;
    minaret:endTime 564.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0084 ;
    minaret:sequenceIndex 83 ;
    minaret:startTime 558.94 ;
    minaret:text " عبادی  ویسے تو سارے ہی بندے اللہ کے ہیں  لیکن جو اللہ پر ایمان لاتے ہیں" .

minaret:Segment_SKD2025-0001_0084 a minaret:TranscriptSegment ;
    minaret:endTime 569.94 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0085 ;
    minaret:sequenceIndex 84 ;
    minaret:startTime 564.0 ;
    minaret:text " اللہ تعالیٰ ان کو پکار رہے ہیں  ان سے خطاب کر رہے ہیں  تو جب بھی آپ کے دل میں یہ خیال آئے" .

minaret:Segment_SKD2025-0001_0087 a minaret:TranscriptSegment ;
    minaret:endTime 585.6600000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0088 ;
    minaret:sequenceIndex 87 ;
    minaret:startTime 579.6 ;
    minaret:text " دعا کی قبولیت کے اعتبار سے  کہ وہ سنتا ہے وہ جواب دیتا ہے  وہ دعا قبول کرتا ہے" .

minaret:Segment_SKD2025-0001_0088 a minaret:TranscriptSegment ;
    minaret:endTime 591.68 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0089 ;
    minaret:sequenceIndex 88 ;
    minaret:startTime 585.66 ;
    minaret:text " اور دوسرا دعا کو سننے کے اعتبار سے  تو اللہ سبحانہ و تعالیٰ کی ایک صفت  القَرِيبٌ ہے" .

minaret:Segment_SKD2025-0001_0089 a minaret:TranscriptSegment ;
    minaret:endTime 597.64 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0090 ;
    minaret:sequenceIndex 89 ;
    minaret:startTime 591.68 ;
    minaret:text " اور قرب جوہوتا ہے وہ دو طرح کا ہوتا ہے  ایک علم کے اعتبار سے  اللہ تعالیٰ سب کے قریب ہے" .

minaret:Segment_SKD2025-0001_0090 a minaret:TranscriptSegment ;
    minaret:endTime 603.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0091 ;
    minaret:sequenceIndex 90 ;
    minaret:startTime 597.64 ;
    minaret:text " یعنی سب کو قریب سے جانتا ہے  ظاہر بھی باطن بھی  ان کے دل کے خیالات بھی سب کچھ" .

minaret:Segment_SKD2025-0001_0091 a minaret:TranscriptSegment ;
    minaret:endTime 607.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0092 ;
    minaret:sequenceIndex 91 ;
    minaret:startTime 603.06 ;
    minaret:text " اور دوسرا یہ ہے  کہ جو لوگ اللہ کی عبادت کرتے ہیں  اللہ تعالیٰ کی اطاعت کرتے ہیں" .

minaret:Segment_SKD2025-0001_0092 a minaret:TranscriptSegment ;
    minaret:endTime 615.02 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0093 ;
    minaret:sequenceIndex 92 ;
    minaret:startTime 607.76 ;
    minaret:text " اللہ تعالیٰ کی بات مانتے ہیں  اللہ تعالیٰ ان کو خاص قرب عطا کرتا ہے  اللہ تعالیٰ ان کے بہت قریب ہوتا ہے" .

minaret:Segment_SKD2025-0001_0093 a minaret:TranscriptSegment ;
    minaret:endTime 619.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0094 ;
    minaret:sequenceIndex 93 ;
    minaret:startTime 615.02 ;
    minaret:text " اور وہ اللہ تعالیٰ کو  قریب محسوس کرتے ہیں  ویسے تو اللہ تعالیٰ" .

minaret:Segment_SKD2025-0001_0094 a minaret:TranscriptSegment ;
    minaret:endTime 625.7 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0095 ;
    minaret:sequenceIndex 94 ;
    minaret:startTime 619.5 ;
    minaret:text " کہاں ہے  کچھ لوگ کہہ رہے ہیں عرش پر  اچھا کون کون کہتا ہے کہ اللہ تعالیٰ" .

minaret:Segment_SKD2025-0001_0095 a minaret:TranscriptSegment ;
    minaret:endTime 631.48 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0096 ;
    minaret:sequenceIndex 95 ;
    minaret:startTime 625.7 ;
    minaret:text " ہمارے دل میں ہے  اچھا اور کون کون کہتا ہے  کہ اللہ تعالیٰ ہر جگہ موجود ہے" .

minaret:Segment_SKD2025-0001_0096 a minaret:TranscriptSegment ;
    minaret:endTime 637.72 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0097 ;
    minaret:sequenceIndex 96 ;
    minaret:startTime 631.48 ;
    minaret:text " علم کے اعتبار سے  موجود نہیں ہے  اللہ تعالیٰ" .

minaret:Segment_SKD2025-0001_0097 a minaret:TranscriptSegment ;
    minaret:endTime 643.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0098 ;
    minaret:sequenceIndex 97 ;
    minaret:startTime 637.72 ;
    minaret:text " کہاں ہیں  عرش پر  آپ نے کبھی بھی اس پہ ہاتھ نہیں کھڑا کرنا" .

minaret:Segment_SKD2025-0001_0098 a minaret:TranscriptSegment ;
    minaret:endTime 649.64 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0099 ;
    minaret:sequenceIndex 98 ;
    minaret:startTime 643.5 ;
    minaret:text " کہ اللہ تعالیٰ ہر جگہ موجود ہے  ٹھیک ہے  اور وہ ایک شعربنا ہوا ہے" .

minaret:Segment_SKD2025-0001_0099 a minaret:TranscriptSegment ;
    minaret:endTime 654.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0100 ;
    minaret:sequenceIndex 99 ;
    minaret:startTime 649.64 ;
    minaret:text " ڈھادے جو کجھ ڈھیندہ  دل  نہ کسے دا ڈھاویں کیونکہ رب دلاں وچ رہندا" .

minaret:Segment_SKD2025-0001_0100 a minaret:TranscriptSegment ;
    minaret:endTime 659.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0101 ;
    minaret:sequenceIndex 100 ;
    minaret:startTime 654.38 ;
    minaret:text " ٹھیک ہے یاد کے اعتبار سے تو ہے  وہ کہتے ہیں نا  ہر چیز کے اندر اللہ تعالیٰ نعوذ باللہ" .

minaret:Segment_SKD2025-0001_0101 a minaret:TranscriptSegment ;
    minaret:endTime 664.08 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0102 ;
    minaret:sequenceIndex 101 ;
    minaret:startTime 659.32 ;
    minaret:text " ایسا کچھ نہیں ہے  یہ اللہ تعالیٰ کی شان کے خلاف  ایسے بات سوچنی بھی نہیں چاہیے" .

minaret:Segment_SKD2025-0001_0102 a minaret:TranscriptSegment ;
    minaret:endTime 666.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0103 ;
    minaret:sequenceIndex 102 ;
    minaret:startTime 664.08 ;
    minaret:text " اللہ تعالیٰ اپنے عرش پر  ٹھیک  اچھا" .

minaret:Segment_SKD2025-0001_0103 a minaret:TranscriptSegment ;
    minaret:endTime 672.6600000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0104 ;
    minaret:sequenceIndex 103 ;
    minaret:startTime 666.98 ;
    minaret:text " لیکن  علم کے اعتبار سے قریب ہے  بندوں کی مدد کرنے کے اعتبار سے قریب ہے" .

minaret:Segment_SKD2025-0001_0109 a minaret:TranscriptSegment ;
    minaret:endTime 706.6600000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0110 ;
    minaret:sequenceIndex 109 ;
    minaret:startTime 702.5600000000001 ;
    minaret:text " نیکی کرنے والوں  محسنین کے قریب ہے  عبادت کرنے والوں" .

minaret:Segment_SKD2025-0001_0110 a minaret:TranscriptSegment ;
    minaret:endTime 710.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0111 ;
    minaret:sequenceIndex 110 ;
    minaret:startTime 706.6600000000001 ;
    minaret:text " اور دعا کرنے والوں کے قریب ہے  لہٰذا  جب بھی آپ دعا کرتے ہیں" .

minaret:Segment_SKD2025-0001_0111 a minaret:TranscriptSegment ;
    minaret:endTime 723.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0112 ;
    minaret:sequenceIndex 111 ;
    minaret:startTime 717.2 ;
    minaret:text "توآپ ضروری نہیں کہ بہت چلا کر کریں  زور زور سے کریں اللہ سبحانہ وتعالیٰ آپ کے دل کی دعا بھی سن لیتا ہے آپ کی سر گوشیاں بھی سن لیتا ہے آپ کی مناجات" .

minaret:Segment_SKD2025-0001_0117 a minaret:TranscriptSegment ;
    minaret:endTime 758.9000000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0118 ;
    minaret:sequenceIndex 117 ;
    minaret:startTime 752.58 ;
    minaret:text " جب بھی آپ کریں گے آپ کو فائدہ ہی ہوگا  اس کا کوئی نقصان نہیں  ہماری کتنی ہی باتیں" .

minaret:Segment_SKD2025-0001_0118 a minaret:TranscriptSegment ;
    minaret:endTime 764.6 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0119 ;
    minaret:sequenceIndex 118 ;
    minaret:startTime 758.9000000000001 ;
    minaret:text " ہوتی ہیں جو ہم بندوں سے کرتے ہیں  اور بندے ان کو بھول جاتے ہیں  ان کو یاد نہیں کرتے" .

minaret:Segment_SKD2025-0001_0119 a minaret:TranscriptSegment ;
    minaret:endTime 770.96 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0120 ;
    minaret:sequenceIndex 119 ;
    minaret:startTime 764.6 ;
    minaret:text " ان کومذاق میں اڑا دیتے ہیں  ان کو اہمیت نہیں دیتے  لیکن جب بندہ اپنے" .

minaret:Segment_SKD2025-0001_0120 a minaret:TranscriptSegment ;
    minaret:endTime 776.18 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0121 ;
    minaret:sequenceIndex 120 ;
    minaret:startTime 770.96 ;
    minaret:text " رب سے بات کرتا ہے  تو رب بڑی شان والا  جو ہم سے بے نیاز ہے" .

minaret:Segment_SKD2025-0001_0121 a minaret:TranscriptSegment ;
    minaret:endTime 782.64 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0122 ;
    minaret:sequenceIndex 121 ;
    minaret:startTime 776.18 ;
    minaret:text " اس کو ہماری ضرورت نہیں  وہ ہماری بات کو ضائع نہیں کرتا رائیگاں نہیں کرتا  یہ اپنے دل میں یقین پکا کر لیں" .

minaret:Segment_SKD2025-0001_0122 a minaret:TranscriptSegment ;
    minaret:endTime 788.16 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0123 ;
    minaret:sequenceIndex 122 ;
    minaret:startTime 782.64 ;
    minaret:text " کہ میں نے جب بھی پکارنا ہے  چاہے بیماری میں یا اس کے علاوہ کسی ضرورت میں  اس نے سننا ہے" .

minaret:Segment_SKD2025-0001_0123 a minaret:TranscriptSegment ;
    minaret:endTime 794.58 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0124 ;
    minaret:sequenceIndex 123 ;
    minaret:startTime 788.16 ;
    minaret:text " وہ نہیں سنے گا تو کون سنے گا  وہ سب سے زیادہ سنتا ہے  جتنا آپ کا اس بات پر" .

minaret:Segment_SKD2025-0001_0124 a minaret:TranscriptSegment ;
    minaret:endTime 800.72 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0125 ;
    minaret:sequenceIndex 124 ;
    minaret:startTime 794.58 ;
    minaret:text " یقین ہوگا اتنا ہی دعا  کی قبولیت کا زیادہ  امکان ہوگا اس کے چانسز" .

minaret:Segment_SKD2025-0001_0125 a minaret:TranscriptSegment ;
    minaret:endTime 806.58 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0126 ;
    minaret:sequenceIndex 125 ;
    minaret:startTime 800.72 ;
    minaret:text " بڑھ جائیں تو دعا کرتے ہوئے  کیا کرنا ہے اللہ میرے قریب  ہے اور وہ میری بات" .

minaret:Segment_SKD2025-0001_0127 a minaret:TranscriptSegment ;
    minaret:endTime 818.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0128 ;
    minaret:sequenceIndex 127 ;
    minaret:startTime 812.5 ;
    minaret:text "طرح کی ہوتی ہے ایک کو کہتے ہیں دعاۓ  عبادت اور ایک کو کہتے ہیں دعائے مسئلہ" .

minaret:Segment_SKD2025-0001_0128 a minaret:TranscriptSegment ;
    minaret:endTime 824.22 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0129 ;
    minaret:sequenceIndex 128 ;
    minaret:startTime 818.38 ;
    minaret:text " عبادت کی دعا اور  مانگنے کی دعا دعاۓ عبادت  یہ لفظ کبھی سنا ہے پہلے" .

minaret:Segment_SKD2025-0001_0129 a minaret:TranscriptSegment ;
    minaret:endTime 830.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0130 ;
    minaret:sequenceIndex 129 ;
    minaret:startTime 824.22 ;
    minaret:text " نہیں سنا عام طور پہ یہ معروف نہیں  ہے دعائے عبادت کا لفظ  ہر وہ عبادت جس کا اللہ" .

minaret:Segment_SKD2025-0001_0130 a minaret:TranscriptSegment ;
    minaret:endTime 836.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0131 ;
    minaret:sequenceIndex 130 ;
    minaret:startTime 830.46 ;
    minaret:text " نے حکم دیا ہے  ٹھیک ہے وہ دعائے عبادت  کہلاتی ہے ہر وہ" .

minaret:Segment_SKD2025-0001_0131 a minaret:TranscriptSegment ;
    minaret:endTime 842.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0132 ;
    minaret:sequenceIndex 131 ;
    minaret:startTime 836.46 ;
    minaret:text " عبادت جس کا اللہ نے حکم دیا ہے  یعنی جب مسلمان کوئی  فرض یا نفل ادا کرتا ہے" .

minaret:Segment_SKD2025-0001_0132 a minaret:TranscriptSegment ;
    minaret:endTime 848.22 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0133 ;
    minaret:sequenceIndex 132 ;
    minaret:startTime 842.62 ;
    minaret:text " تو وہ دراصل اس عبادت  کو اللہ کی طرف وسیلہ  بناتا ہے اور اللہ تعالیٰ" .

minaret:Segment_SKD2025-0001_0133 a minaret:TranscriptSegment ;
    minaret:endTime 853.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0134 ;
    minaret:sequenceIndex 133 ;
    minaret:startTime 848.22 ;
    minaret:text " اس پر اس کو ثواب عطا کرتا ہے  اجر عطا کرتا ہے  جنت میں داخل کرتا ہے" .

minaret:Segment_SKD2025-0001_0134 a minaret:TranscriptSegment ;
    minaret:endTime 860.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0135 ;
    minaret:sequenceIndex 134 ;
    minaret:startTime 853.98 ;
    minaret:text " عذاب سے بچاتا ہے  یعنی دعا سے بھی کیا ہوتا ہے آپ کو فائدہ حاصل ہوتے ہیں  اور آپ نقصان سے بچتے ہیں" .

minaret:Segment_SKD2025-0001_0137 a minaret:TranscriptSegment ;
    minaret:endTime 877.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0138 ;
    minaret:sequenceIndex 137 ;
    minaret:startTime 872.1999999999999 ;
    minaret:text " وہ کیا ہیں  ہمارے حال کو درست کرنے  کا ذریعہ ہیں" .

minaret:Segment_SKD2025-0001_0143 a minaret:TranscriptSegment ;
    minaret:endTime 909.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0144 ;
    minaret:sequenceIndex 143 ;
    minaret:startTime 902.2 ;
    minaret:text " آپ کا حال درست کر دے گا  کیونکہ عبادت کے ذریعے انسان خیرطلب کرتا ہے  اور دوسرا ہے مانگنے کی دعا" .

minaret:Segment_SKD2025-0001_0144 a minaret:TranscriptSegment ;
    minaret:endTime 914.24 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0145 ;
    minaret:sequenceIndex 144 ;
    minaret:startTime 909.76 ;
    minaret:text " تو مانگنے کی دعا کیا ہے  کہ انسان اللہ تعالی کے سامنے  اپنی حاجت رکھے" .

minaret:Segment_SKD2025-0001_0145 a minaret:TranscriptSegment ;
    minaret:endTime 920.1800000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0146 ;
    minaret:sequenceIndex 145 ;
    minaret:startTime 914.24 ;
    minaret:text " اپنے ہاتھ پھیلائے  سجدے میں جا کے مانگے  بیماری سے شفامانگے" .

minaret:Segment_SKD2025-0001_0146 a minaret:TranscriptSegment ;
    minaret:endTime 927.44 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0147 ;
    minaret:sequenceIndex 146 ;
    minaret:startTime 920.1800000000001 ;
    minaret:text " بھوک سے رزق مانگے  مصیبت دور کرنے کی دعا کرے  قرض کی ادائیگی کی دعا کرے" .

minaret:Segment_SKD2025-0001_0147 a minaret:TranscriptSegment ;
    minaret:endTime 934.2600000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0148 ;
    minaret:sequenceIndex 147 ;
    minaret:startTime 927.44 ;
    minaret:text " جنت میں جانے کی دعا کرے  جہنم سے بچنے کی دعا کرے  قبر میں منکر نکیر کے جو سوال ہیں" .

minaret:Segment_SKD2025-0001_0148 a minaret:TranscriptSegment ;
