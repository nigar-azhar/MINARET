    minaret:startTime 1457.02 ;
    minaret:text " ابھی انہی کے پاس جاؤ  اس سے بھی بڑی عقل ماری جا سکتی  کسی انسان کی" .

minaret:Segment_SKD2025-0001_0260 a minaret:TranscriptSegment ;
    minaret:endTime 1466.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0261 ;
    minaret:sequenceIndex 260 ;
    minaret:startTime 1461.62 ;
    minaret:text " کہ وہ مردہ کو پکار رہے ہیں  اس زندہ عالی شان رب کو چھوڑ کر  حیرت کی بات نہیں" .

minaret:Segment_SKD2025-0001_0261 a minaret:TranscriptSegment ;
    minaret:endTime 1472.6799999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0262 ;
    minaret:sequenceIndex 261 ;
    minaret:startTime 1466.8 ;
    minaret:text " آپ کو کیسا لگتا ہے زراسوچیں  یعنی جو لوگ بھی قبروں پہ جاتے ہیں  دعائیں کرنے کے لیے" .

minaret:Segment_SKD2025-0001_0262 a minaret:TranscriptSegment ;
    minaret:endTime 1478.12 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0263 ;
    minaret:sequenceIndex 262 ;
    minaret:startTime 1472.6799999999998 ;
    minaret:text " وہ کس کو پکار رہے ہیں  اس کو جو اپنے کام نہیں آسکا  جو مٹی کے نیچے دبا پڑا ہے" .

minaret:Segment_SKD2025-0001_0263 a minaret:TranscriptSegment ;
    minaret:endTime 1482.3799999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0264 ;
    minaret:sequenceIndex 263 ;
    minaret:startTime 1478.12 ;
    minaret:text " اس کو خوش کرنے کے لیے  چادریں چڑھا رہے ہیں  پھول ڈال رہے ہیں" .

minaret:Segment_SKD2025-0001_0264 a minaret:TranscriptSegment ;
    minaret:endTime 1486.58 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0265 ;
    minaret:sequenceIndex 264 ;
    minaret:startTime 1482.3799999999999 ;
    minaret:text " پیسے ڈال رہے ہیں  دھمال ڈال رہے ہیں  کھانے کھلا رہے ہیں" .

minaret:Segment_SKD2025-0001_0265 a minaret:TranscriptSegment ;
    minaret:endTime 1489.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0266 ;
    minaret:sequenceIndex 265 ;
    minaret:startTime 1486.58 ;
    minaret:text " وہاں پر  پتہ نہیں کیا کیا کر رہے ہیں پیچھلے دنوں" .

minaret:Segment_SKD2025-0001_0266 a minaret:TranscriptSegment ;
    minaret:endTime 1494.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0267 ;
    minaret:sequenceIndex 266 ;
    minaret:startTime 1489.5 ;
    minaret:text " ایک چھوٹا سا survey کسی کامیں نے دیکھا  وہ قلندر صاحب ہیں  ان کا کوئی مزار ہے" .

minaret:Segment_SKD2025-0001_0267 a minaret:TranscriptSegment ;
    minaret:endTime 1497.9799999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0268 ;
    minaret:sequenceIndex 267 ;
    minaret:startTime 1494.04 ;
    minaret:text " تو وہاں پر جو لوگ گئے ہوئے تھے  تو ان سے پوچھا کہ  آپ یہاں کیا کرنے آئے ہیں" .

minaret:Segment_SKD2025-0001_0268 a minaret:TranscriptSegment ;
    minaret:endTime 1501.88 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0269 ;
    minaret:sequenceIndex 268 ;
    minaret:startTime 1497.9799999999998 ;
    minaret:text " کیوں آئے ہیں  تو ان کے پاس کوئی جواب نہیں تھا  وہ کہتے ہیں کہ" .

minaret:Segment_SKD2025-0001_0269 a minaret:TranscriptSegment ;
    minaret:endTime 1505.8600000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0270 ;
    minaret:sequenceIndex 269 ;
    minaret:startTime 1501.88 ;
    minaret:text " ہمارے بڑے ایسے ہی کرتے تھے  اس لئے ہم آگئے ہیں  مشرکین  مکہ بھی تو یہ کہتے تھے نا" .

minaret:Segment_SKD2025-0001_0270 a minaret:TranscriptSegment ;
    minaret:endTime 1510.58 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0271 ;
    minaret:sequenceIndex 270 ;
    minaret:startTime 1505.8600000000001 ;
    minaret:text "وَجَدْنَا عَلَيْهَا آبَاءَنَا  تو اگر ان سے پوچھا جائے  وہ تمہاری دعا سنتے ہیں" .

minaret:Segment_SKD2025-0001_0271 a minaret:TranscriptSegment ;
    minaret:endTime 1514.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0272 ;
    minaret:sequenceIndex 271 ;
    minaret:startTime 1510.58 ;
    minaret:text " تمہاری پکار سنتے ہیں  تو ان کے پاس کوئی دلیل نہیں  کہ وہ سنتے ہیں" .

minaret:Segment_SKD2025-0001_0272 a minaret:TranscriptSegment ;
    minaret:endTime 1520.3600000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0273 ;
    minaret:sequenceIndex 272 ;
    minaret:startTime 1514.0 ;
    minaret:text " کوئی ایک جگہ قرآن پاک میں دکھا دیں  کوئی حدیث میں دکھا دیں عقل سے سوچ کے بتا دیں" .

minaret:Segment_SKD2025-0001_0273 a minaret:TranscriptSegment ;
    minaret:endTime 1532.1200000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0274 ;
    minaret:sequenceIndex 273 ;
    minaret:startTime 1520.3600000000001 ;
    minaret:text " کہ کہیں یہ لکھا ہو  کہ دعا کرنے کیلیے مردے کے پاس جاــؤ ہے کوئی ماننے والی بات آپ کا دل کیا کہتا  آپ کے بھی کوئی نہ کوئی جان پہچان والے لوگ" .

minaret:Segment_SKD2025-0001_0274 a minaret:TranscriptSegment ;
    minaret:endTime 1536.14 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0275 ;
    minaret:sequenceIndex 274 ;
    minaret:startTime 1532.1200000000001 ;
    minaret:text " مشکلات میں جاتے ہوں گے  کہاں  درباروں پر" .

minaret:Segment_SKD2025-0001_0275 a minaret:TranscriptSegment ;
    minaret:endTime 1541.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0276 ;
    minaret:sequenceIndex 275 ;
    minaret:startTime 1536.14 ;
    minaret:text " پتہ نہیں دربار کیوں نام رکھا ہوا ہے  قبر کا نام دربار رکھ دیا  دربار تو بادشاہوں کے ہوتے ہیں" .

minaret:Segment_SKD2025-0001_0276 a minaret:TranscriptSegment ;
    minaret:endTime 1547.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0277 ;
    minaret:sequenceIndex 276 ;
    minaret:startTime 1541.38 ;
    minaret:text " تو اس لئے وہ ان کو بادشاہ سمجھتے ہیں  مرنے کے بعد تو بادشاہوں کے تاج بھی اتر جاتے ہیں  چلیں" .

minaret:Segment_SKD2025-0001_0277 a minaret:TranscriptSegment ;
    minaret:endTime 1551.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0278 ;
    minaret:sequenceIndex 277 ;
    minaret:startTime 1547.06 ;
    minaret:text " بادشاہ ہی مان لیں ان کو  نیک لوگ تھے  آپ کے نزدیک وہ بادشاہ ہو گئے" .

minaret:Segment_SKD2025-0001_0278 a minaret:TranscriptSegment ;
    minaret:endTime 1554.66 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0279 ;
    minaret:sequenceIndex 278 ;
    minaret:startTime 1551.52 ;
    minaret:text " ٹھیک ہے  لیکن  کیا کوئی جواز بنتا ہے کہ ان سے جا کے مانگیں بنتا ہے نہیں بنتا" .

minaret:Segment_SKD2025-0001_0279 a minaret:TranscriptSegment ;
    minaret:endTime 1564.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0280 ;
    minaret:sequenceIndex 279 ;
    minaret:startTime 1559.22 ;
    minaret:text " لہذا ہمیں مانگنا صرف ایک ذات سے چاہیے  اور وہ ہے  اللہ کی ذات" .

minaret:Segment_SKD2025-0001_0283 a minaret:TranscriptSegment ;
    minaret:endTime 1580.1000000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0284 ;
    minaret:sequenceIndex 283 ;
    minaret:startTime 1577.88 ;
    minaret:text "جی  یعنی  جو" .

minaret:Segment_SKD2025-0001_0284 a minaret:TranscriptSegment ;
    minaret:endTime 1585.16 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0285 ;
    minaret:sequenceIndex 284 ;
    minaret:startTime 1580.1000000000001 ;
    minaret:text " اللہ پر ایمان لاتا ہے  اللہ کی بات مانتا ہے  اس کا معاملہ" .

minaret:Segment_SKD2025-0001_0285 a minaret:TranscriptSegment ;
    minaret:endTime 1589.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0286 ;
    minaret:sequenceIndex 285 ;
    minaret:startTime 1585.16 ;
    minaret:text " سب لوگوں سے بہتر ہوتا ہے  اس نے  صحیح راہ اختیار کر لی ہوتی ہے" .

minaret:Segment_SKD2025-0001_0286 a minaret:TranscriptSegment ;
    minaret:endTime 1594.1999999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0287 ;
    minaret:sequenceIndex 286 ;
    minaret:startTime 1589.62 ;
    minaret:text " اسے  خیر کی توفیق دے دی جاتی ہے  ہدایت دے دی جاتی ہے" .

minaret:Segment_SKD2025-0001_0291 a minaret:TranscriptSegment ;
    minaret:endTime 1632.3799999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0292 ;
    minaret:sequenceIndex 291 ;
    minaret:startTime 1626.36 ;
    minaret:text " یعنی سبب بن جائے گا کوئی  صحیح والی دوامل جائے گی  صحیح تشخیص ہو جائے گی" .

minaret:Segment_SKD2025-0001_0292 a minaret:TranscriptSegment ;
    minaret:endTime 1636.6999999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0293 ;
    minaret:sequenceIndex 292 ;
    minaret:startTime 1632.3799999999999 ;
    minaret:text " آپ کو پتا دنیا میں بہت ساری  ڈیکس اب مجھے صحیح ایگزیکٹ وہ فگر یاد نہیں" .

minaret:Segment_SKD2025-0001_0293 a minaret:TranscriptSegment ;
    minaret:endTime 1642.78 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0294 ;
    minaret:sequenceIndex 293 ;
    minaret:startTime 1636.6999999999998 ;
    minaret:text " صرف ڈاکٹروں کی غلط تشخیص  اور غلط علاج کی وجہ سے ہوتی ہیں  کیونکہ ہم سارا بھروسہ" .

minaret:Segment_SKD2025-0001_0294 a minaret:TranscriptSegment ;
    minaret:endTime 1648.34 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0295 ;
    minaret:sequenceIndex 294 ;
    minaret:startTime 1642.78 ;
    minaret:text " انہی پہ کر لیتے ہیں  اور ان کو سمجھ نہیں آتی کرنا کیا ہے  اور مریض دن بہ دن بگڑتا چلا جاتا ہے" .

minaret:Segment_SKD2025-0001_0295 a minaret:TranscriptSegment ;
    minaret:endTime 1652.7 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0296 ;
    minaret:sequenceIndex 295 ;
    minaret:startTime 1648.34 ;
    minaret:text " کیونکہ سمجھ نہیں آتی علاج ہے کیا  تو جب دعا کرتے ہیں  تو پھر اللہ تعالیٰ" .

minaret:Segment_SKD2025-0001_0296 a minaret:TranscriptSegment ;
    minaret:endTime 1655.78 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0297 ;
    minaret:sequenceIndex 296 ;
    minaret:startTime 1652.7 ;
    minaret:text "لَعَلَّهُمْ   يَرْشُدُونَ  رہنمائی کر دیتے ہیں" .

minaret:Segment_SKD2025-0001_0297 a minaret:TranscriptSegment ;
    minaret:endTime 1661.82 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0298 ;
    minaret:sequenceIndex 297 ;
    minaret:startTime 1655.78 ;
    minaret:text " چلیے مجھے بتائیے آپ  یقین بڑھانے کے لیے کیا کرنا چاہئے  اس کے لیے یہ بھی ہوتا ہے" .

minaret:Segment_SKD2025-0001_0298 a minaret:TranscriptSegment ;
    minaret:endTime 1667.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0299 ;
    minaret:sequenceIndex 298 ;
    minaret:startTime 1661.82 ;
    minaret:text " کہ جس پر آپ بھروسہ کریں  اس کی معرفت صحیح ہونی چاہیے  تو پھر انسان اسی کے پاس جاتا ہے" .

minaret:Segment_SKD2025-0001_0299 a minaret:TranscriptSegment ;
    minaret:endTime 1671.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0300 ;
    minaret:sequenceIndex 299 ;
    minaret:startTime 1667.0 ;
    minaret:text " کہ یہ پوری کرے گا میری  بہت اچھی بات کی  آپ کا یقین کیسے بڑھے گا" .

minaret:Segment_SKD2025-0001_0300 a minaret:TranscriptSegment ;
    minaret:endTime 1678.4199999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0301 ;
    minaret:sequenceIndex 300 ;
    minaret:startTime 1671.54 ;
    minaret:text " جتنی معرفت اللہ کی پہچان زیادہ ہوگی نا  اللہ تعالیٰ کیا کچھ کر سکتا ہے  اتنا یقین بڑھے گا" .

minaret:Segment_SKD2025-0001_0301 a minaret:TranscriptSegment ;
    minaret:endTime 1682.1399999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0302 ;
    minaret:sequenceIndex 301 ;
    minaret:startTime 1678.4199999999998 ;
    minaret:text " تو یقین بڑھانے کے لیے  قرآن کا مطالعہ بھی ہے  اور اس کے ساتھ ساتھ" .

minaret:Segment_SKD2025-0001_0302 a minaret:TranscriptSegment ;
    minaret:endTime 1685.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0303 ;
    minaret:sequenceIndex 302 ;
    minaret:startTime 1682.1399999999999 ;
    minaret:text " اللہ تعالیٰ کے ناموں  اور اس کی صفات کے ذریعے  اللہ کی پہچان" .

minaret:Segment_SKD2025-0001_0303 a minaret:TranscriptSegment ;
    minaret:endTime 1691.1200000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0304 ;
    minaret:sequenceIndex 303 ;
    minaret:startTime 1685.74 ;
    minaret:text " اور پھر کائنات میں غور فکر کہ  اللہ تعالیٰ آپ نے تو اتنا  کچھ بنا دیا ہے" .

minaret:Segment_SKD2025-0001_0304 a minaret:TranscriptSegment ;
    minaret:endTime 1697.66 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0305 ;
    minaret:sequenceIndex 304 ;
    minaret:startTime 1691.1200000000001 ;
    minaret:text " خاص طور پراب تو اتنا آسان ہو گیا ہے  کائنات کی مختلف چیزوں کو دیکھنا  جو کل کا انسان نہیں دیکھ سکتا تھا" .

minaret:Segment_SKD2025-0001_0305 a minaret:TranscriptSegment ;
    minaret:endTime 1701.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0306 ;
    minaret:sequenceIndex 305 ;
    minaret:startTime 1697.66 ;
    minaret:text " تو اللہ تعالیٰ آپ نے  اس سورج سے بھی ہزاروں  گناہ بڑے سورج بنا دیئے" .

minaret:Segment_SKD2025-0001_0306 a minaret:TranscriptSegment ;
    minaret:endTime 1706.8400000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0307 ;
    minaret:sequenceIndex 306 ;
    minaret:startTime 1701.98 ;
    minaret:text " ستارے اور سیارے  اور نئی نئی کہکشائیں   اور انسان کے ذہن کے اندر" .

minaret:Segment_SKD2025-0001_0307 a minaret:TranscriptSegment ;
    minaret:endTime 1711.34 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0308 ;
    minaret:sequenceIndex 307 ;
    minaret:startTime 1706.8400000000001 ;
    minaret:text " سما ہی نہیں سکتیں  وہ وسعتیں جو اللہ نے پیدا کی ہیں  وہ خود کتنا بڑا ہوگا" .

minaret:Segment_SKD2025-0001_0308 a minaret:TranscriptSegment ;
    minaret:endTime 1717.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0309 ;
    minaret:sequenceIndex 308 ;
    minaret:startTime 1712.08 ;
    minaret:text " جو اتنا کچھ کر سکتا  وہ ہمارے لیے چھوٹا سا مسئلہ نہیں حل کر سکتا  استاذہ یقین کا جیسے graph" .

minaret:Segment_SKD2025-0001_0309 a minaret:TranscriptSegment ;
    minaret:endTime 1719.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0310 ;
    minaret:sequenceIndex 309 ;
    minaret:startTime 1717.32 ;
    minaret:text " اوپر نیچے ہو جاتا ہے  انسان کا  تو مجھے لگتا ہے کہ" .

minaret:Segment_SKD2025-0001_0310 a minaret:TranscriptSegment ;
    minaret:endTime 1723.26 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0311 ;
    minaret:sequenceIndex 310 ;
    minaret:startTime 1719.62 ;
    minaret:text " ایسی محفلوں میں بیٹھنا چاہیے  خود جا کے  مطلب یہ نہیں کہ صرف آن لائن" .

minaret:Segment_SKD2025-0001_0311 a minaret:TranscriptSegment ;
    minaret:endTime 1727.9199999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0312 ;
    minaret:sequenceIndex 311 ;
    minaret:startTime 1723.26 ;
    minaret:text " جا کے بیٹھنا چاہیے  جہاں پہ اس چیز کو  اور پختگی اور ایک بیس ملے" .

minaret:Segment_SKD2025-0001_0312 a minaret:TranscriptSegment ;
    minaret:endTime 1732.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0313 ;
    minaret:sequenceIndex 312 ;
    minaret:startTime 1727.9199999999998 ;
    minaret:text " تو کمپنی کا بہت اثر ہوتا ہے  کمپنی کا اثر ہوتا ہے  اس سے کوئی شک نہیں" .

minaret:Segment_SKD2025-0001_0313 a minaret:TranscriptSegment ;
    minaret:endTime 1739.26 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0314 ;
    minaret:sequenceIndex 313 ;
    minaret:startTime 1732.54 ;
    minaret:text " کمپنی کا اثر ہوتا ہے  پھر آپ ایسے لوگوں کی باتیں سنتے ہیں  جن کے کچھ ایسے تجربات ہوتے ہیں" .

minaret:Segment_SKD2025-0001_0314 a minaret:TranscriptSegment ;
    minaret:endTime 1744.58 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0315 ;
    minaret:sequenceIndex 314 ;
    minaret:startTime 1739.26 ;
    minaret:text " کہ جو  اللہ پر ایمان کو اور بڑھا دیتے ہیں  یعنی انہوں نے زندگی میں دعا کی" .

minaret:Segment_SKD2025-0001_0315 a minaret:TranscriptSegment ;
    minaret:endTime 1748.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0316 ;
    minaret:sequenceIndex 315 ;
    minaret:startTime 1744.58 ;
    minaret:text " اور ان کی دعا کی  کیسے قبولیت ہوئی  اور ان کو کیسے رستہ مل گیا" .

minaret:Segment_SKD2025-0001_0316 a minaret:TranscriptSegment ;
    minaret:endTime 1751.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0317 ;
    minaret:sequenceIndex 316 ;
    minaret:startTime 1748.04 ;
    minaret:text " لوگ اپنی بیماریوں کے علاج شیئر کرتے ہیں  جی استاذہ جی" .

minaret:Segment_SKD2025-0001_0317 a minaret:TranscriptSegment ;
    minaret:endTime 1756.6399999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0318 ;
    minaret:sequenceIndex 317 ;
    minaret:startTime 1751.46 ;
    minaret:text " قلبی بصیرت جب حاصل ہوتی ہے  تو انسان کے یقین میں بھی اضافہ ہوتا ہے  بلکل" .

minaret:Segment_SKD2025-0001_0318 a minaret:TranscriptSegment ;
    minaret:endTime 1762.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0319 ;
    minaret:sequenceIndex 318 ;
    minaret:startTime 1756.6399999999999 ;
    minaret:text " جب دل کی نگاہیں  آنکھیں باہ ہو جاتی ہیں  تو وہ کچھ نظر آتا ہے" .

minaret:Segment_SKD2025-0001_0319 a minaret:TranscriptSegment ;
    minaret:endTime 1766.1399999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0320 ;
    minaret:sequenceIndex 319 ;
    minaret:startTime 1762.4 ;
    minaret:text " جوویسے نظر نہیں آتا  استاذہ جی  جیسے یہ ہے نا" .

minaret:Segment_SKD2025-0001_0322 a minaret:TranscriptSegment ;
    minaret:endTime 1786.3000000000002 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0323 ;
    minaret:sequenceIndex 322 ;
    minaret:startTime 1779.38 ;
    minaret:text " انسان اللہ تعالی سے دور ہوتا چلا جاتا ہے نا  اور پھر دل مردہ ہو جاتا ہے  پھر دل کرتا ہی نہیں دعا کرنے کو" .

minaret:Segment_SKD2025-0001_0323 a minaret:TranscriptSegment ;
    minaret:endTime 1793.5400000000002 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0324 ;
    minaret:sequenceIndex 323 ;
    minaret:startTime 1786.3000000000002 ;
    minaret:text " پھر شیطان اس دل کو پکڑ لیتا ہے  پھر اور پریشانی اور اندھیرے بڑھ جاتے ہیں  مسائل کا سلسلہ ختم ہی نہیں ہوتا" .

minaret:Segment_SKD2025-0001_0324 a minaret:TranscriptSegment ;
    minaret:endTime 1799.88 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0325 ;
    minaret:sequenceIndex 324 ;
    minaret:startTime 1793.5400000000002 ;
    minaret:text " الہدٰی میں جس سے بھی ملاقات ہوتی ہے  تو جب پوچھتے تو  وہ یہ اپنی قرآن کی طرف آنے کے سٹوری میں" .

minaret:Segment_SKD2025-0001_0325 a minaret:TranscriptSegment ;
    minaret:endTime 1805.5600000000002 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0326 ;
    minaret:sequenceIndex 325 ;
    minaret:startTime 1799.88 ;
    minaret:text " یہ چیز ضرور بتاتے ہیں  کہ ہم اللہ تعالی سےبہت دعا کرتے تھے  اور اللہ تعالی پھر لے آتے ہیں" .

minaret:Segment_SKD2025-0001_0326 a minaret:TranscriptSegment ;
    minaret:endTime 1810.9 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0327 ;
    minaret:sequenceIndex 326 ;
    minaret:startTime 1805.5600000000002 ;
    minaret:text " آپ میں سے کس کس نے دعا کی تھی  یہاں آنے کے لیے  آپ سب کا تو یقین بہت" .

minaret:Segment_SKD2025-0001_0327 a minaret:TranscriptSegment ;
    minaret:endTime 1817.22 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0328 ;
    minaret:sequenceIndex 327 ;
    minaret:startTime 1810.9 ;
    minaret:text " پہنچا ہوا ہے  استاذہ انبیاء کے واقعات پڑھنے سے بھی  کس طرح اللہ تعالی نے اپنے نبیوں کی دعائیں قبول کیں" .

minaret:Segment_SKD2025-0001_0328 a minaret:TranscriptSegment ;
    minaret:endTime 1822.5800000000002 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0329 ;
    minaret:sequenceIndex 328 ;
    minaret:startTime 1817.22 ;
    minaret:text " بہت اچھی بات کی  کیونکہ میں جب بھی قرآن مجید پڑھتی ہوں نا  اور مختلف انبیاء" .

minaret:Segment_SKD2025-0001_0329 a minaret:TranscriptSegment ;
    minaret:endTime 1826.7800000000002 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0330 ;
    minaret:sequenceIndex 329 ;
    minaret:startTime 1822.5800000000002 ;
    minaret:text " اس خاص طرح سورة الانبیاء  اور ایک کے بعد ایک دعا  اس کی بھی دعا قبول کر لی" .

minaret:Segment_SKD2025-0001_0330 a minaret:TranscriptSegment ;
    minaret:endTime 1830.24 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0331 ;
    minaret:sequenceIndex 330 ;
    minaret:startTime 1826.78 ;
    minaret:text " اس کی بھی کر لی میں کہتی ہوں اللہ تعالی آپ نے ان سب کی کر لی  میری بھی کر لے" .

minaret:Segment_SKD2025-0001_0331 a minaret:TranscriptSegment ;
    minaret:endTime 1834.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0332 ;
    minaret:sequenceIndex 331 ;
    minaret:startTime 1830.24 ;
    minaret:text " میں ان جیسی نیک تو نہیں ہوں  لیکن  آپ سے ہی مانگتے ہیں نا" .

minaret:Segment_SKD2025-0001_0332 a minaret:TranscriptSegment ;
    minaret:endTime 1838.84 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0333 ;
    minaret:sequenceIndex 332 ;
    minaret:startTime 1834.3 ;
    minaret:text " اگر آپ سے نہیں مانگیں پھر کہاں جائیں  اور تو کوئی جگہ ہے نہیں  تو دعا" .

minaret:Segment_SKD2025-0001_0333 a minaret:TranscriptSegment ;
    minaret:endTime 1843.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0334 ;
    minaret:sequenceIndex 333 ;
    minaret:startTime 1838.84 ;
    minaret:text " عبادت بھی ہے  اللہ سے تعلق بھی ہے  انسان کے درجے بھی بڑھاتا " .

minaret:Segment_SKD2025-0001_0334 a minaret:TranscriptSegment ;
    minaret:endTime 1850.3999999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0335 ;
    minaret:sequenceIndex 334 ;
    minaret:startTime 1843.74 ;
    minaret:text " اور انسان کی مشکلات حل کرنے کا ذریعہ بھی ہے  تو بہت ہی عظیم چیز ہے  جو ہمارے رب نے ہمیں عطا کر دی ہے" .

minaret:Segment_SKD2025-0001_0340 a minaret:TranscriptSegment ;
    minaret:endTime 1877.48 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0341 ;
    minaret:sequenceIndex 340 ;
    minaret:startTime 1872.4 ;
    minaret:text " برکتیں حاصل ہوں گی  اللہ کا قرب نصیب ہوگا  یہ دنیا میں حاصل ہوگا" .

minaret:Segment_SKD2025-0001_0341 a minaret:TranscriptSegment ;
    minaret:endTime 1883.44 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0342 ;
    minaret:sequenceIndex 341 ;
    minaret:startTime 1877.48 ;
    minaret:text " اور آگے  اس دعا کی وجہ سے جنت بھی ان شاء اللہ نصیب ہوگی  تو جو شخص مشکلات سے" .

minaret:Segment_SKD2025-0001_0342 a minaret:TranscriptSegment ;
    minaret:endTime 1887.0600000000002 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0343 ;
    minaret:sequenceIndex 342 ;
    minaret:startTime 1883.44 ;
    minaret:text " نکلنا چاہتا ہے  اسے چاہیے کہ وہ دعا کو  لازم کر لے" .

minaret:Segment_SKD2025-0001_0343 a minaret:TranscriptSegment ;
    minaret:endTime 1892.44 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0344 ;
    minaret:sequenceIndex 343 ;
    minaret:startTime 1887.0600000000002 ;
    minaret:text " جو مشکل سے نکلنا چاہتا ہے  وہ دعا کو لازم کر لے  لازم کا کیا مطلب چمٹ جائے" .

minaret:Segment_SKD2025-0001_0350 a minaret:TranscriptSegment ;
    minaret:endTime 1933.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0351 ;
    minaret:sequenceIndex 350 ;
    minaret:startTime 1928.44 ;
    minaret:text " کہ صرف اللہ کو پکارے  اس لیے جب انسان کو کوئی تکلیف آتی ہے  اور ایسی تکلیف" .

minaret:Segment_SKD2025-0001_0351 a minaret:TranscriptSegment ;
    minaret:endTime 1938.96 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0352 ;
    minaret:sequenceIndex 351 ;
    minaret:startTime 1933.76 ;
    minaret:text " جس میں انسان سمجھتا ہے  کہ بس سوائے اللہ کے کوئی نہیں بچا سکتا  تو سب کو بھول جاتا ہے" .

minaret:Segment_SKD2025-0001_0352 a minaret:TranscriptSegment ;
    minaret:endTime 1945.78 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0353 ;
    minaret:sequenceIndex 352 ;
    minaret:startTime 1938.96 ;
    minaret:text " اور وہ صرف اللہ ہی کو یاد کرتا ہے  اب دعا یا تو اسی وقت قبول کر لی جاتی  انسان فوراً مشکل سے باہر آ جاتا ہے" .

minaret:Segment_SKD2025-0001_0353 a minaret:TranscriptSegment ;
    minaret:endTime 1952.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0354 ;
    minaret:sequenceIndex 353 ;
    minaret:startTime 1945.78 ;
    minaret:text " یا آخرت کے لیے ذخیرہ کر لی جاتی ہے  یا اس جیسی کوئی تکلیف دور کر دی جاتی  یعنی وہ تکلیف دور نہیں کی جاتی" .

minaret:Segment_SKD2025-0001_0354 a minaret:TranscriptSegment ;
    minaret:endTime 1956.3999999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0355 ;
    minaret:sequenceIndex 354 ;
    minaret:startTime 1952.32 ;
    minaret:text " کوئی اور کر دی جاتی  تو اس لیے یقین رکھ ہے  کہ قبول تو ہو گئی ہے" .

minaret:Segment_SKD2025-0001_0355 a minaret:TranscriptSegment ;
    minaret:endTime 1961.58 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0356 ;
    minaret:sequenceIndex 355 ;
    minaret:startTime 1956.3999999999999 ;
    minaret:text " پر یہ اللہ کو پتا ہے  کہ کس شکل میں قبول ہوئی ہے  لیکن فائدہ اس کا ضرور ہوگا" .

minaret:Segment_SKD2025-0001_0356 a minaret:TranscriptSegment ;
    minaret:endTime 1969.9199999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0357 ;
    minaret:sequenceIndex 356 ;
    minaret:startTime 1961.58 ;
    minaret:text " اور یہ جملہ بھی بھولنا نہیں آپ نے  اللہ میری دعاوں کو رائیگاں نہیں کرے گا  اللہ میری دعاؤں کو رائیگاں نہیں کرے گا" .

minaret:Segment_SKD2025-0001_0359 a minaret:TranscriptSegment ;
    minaret:endTime 1992.58 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0360 ;
    minaret:sequenceIndex 359 ;
    minaret:startTime 1987.96 ;
    minaret:text " کوئی نقصان نہیں ہوا  اس لیے میں مایوس نہیں  اس لیے میں عاجز نہیں" .

minaret:Segment_SKD2025-0001_0365 a minaret:TranscriptSegment ;
    minaret:endTime 2028.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0366 ;
    minaret:sequenceIndex 365 ;
    minaret:startTime 2022.14 ;
    minaret:text " دعائیں کس طرح کام آتی ہیں  تو اس میں ہم قرآن سے ایک مثال لیتے ہیں  ایوب علیہ السلام کی" .

minaret:Segment_SKD2025-0001_0375 a minaret:TranscriptSegment ;
    minaret:endTime 2108.72 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0376 ;
    minaret:sequenceIndex 375 ;
    minaret:startTime 2103.66 ;
    minaret:text " ابن قیم کہتے ہیں  مصیبت کو ٹالنے  اور اپنا مقصد حاصل کرنے میں" .

minaret:Segment_SKD2025-0001_0376 a minaret:TranscriptSegment ;
    minaret:endTime 2116.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0377 ;
    minaret:sequenceIndex 376 ;
    minaret:startTime 2108.72 ;
    minaret:text " دعا قوی ترین اسباب میں سے ایک سبب ہے  یہ تمام دوائیوں سے زیادہ مفید ہے  ساریmedicines  سے زیادہ مفید ہے" .

minaret:Segment_SKD2025-0001_0377 a minaret:TranscriptSegment ;
    minaret:endTime 2123.1800000000003 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0378 ;
    minaret:sequenceIndex 377 ;
    minaret:startTime 2116.5 ;
    minaret:text " یہ آزمائشوں کی دشمن ہے  کتنا خوبصورت جملہ ہے نا یہ  دعا آزمائشوں کی دشمن ہے" .

minaret:Segment_SKD2025-0001_0378 a minaret:TranscriptSegment ;
    minaret:endTime 2129.48 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0379 ;
    minaret:sequenceIndex 378 ;
    minaret:startTime 2123.1800000000003 ;
    minaret:text " یہ آزمائشوں کو دور دھکیلتی ہے  ان سے زور آزمائی کرتی ہے  ان کو واقع ہونے سے روکتی ہے" .

minaret:Segment_SKD2025-0001_0379 a minaret:TranscriptSegment ;
    minaret:endTime 2135.2200000000003 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0380 ;
    minaret:sequenceIndex 379 ;
    minaret:startTime 2129.48 ;
    minaret:text " اور جو واقع ہو چکی ہیں ان کو ختم کر دیتی ہے  یا ان کو ہلکا کر دیتی ہے  یہ مومن کا ہتھیار ہے" .

minaret:Segment_SKD2025-0001_0380 a minaret:TranscriptSegment ;
    minaret:endTime 2141.44 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0381 ;
    minaret:sequenceIndex 380 ;
    minaret:startTime 2135.2200000000003 ;
    minaret:text " دعا ان مصیبتوں میں بھی فائدہ دیتی ہے  جو اتر چکی ہیں اور ان کو بھی  جو نہیں اتریں وہ ان کو پیچھے دھکیلتی ہے" .

minaret:Segment_SKD2025-0001_0381 a minaret:TranscriptSegment ;
    minaret:endTime 2146.84 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0382 ;
    minaret:sequenceIndex 381 ;
    minaret:startTime 2141.44 ;
    minaret:text " واپس جاؤ  دعا علاج کے ایک قسم ہے  یعنی دعا علاج ہے" .

minaret:Segment_SKD2025-0001_0382 a minaret:TranscriptSegment ;
    minaret:endTime 2152.84 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0383 ;
    minaret:sequenceIndex 382 ;
    minaret:startTime 2146.84 ;
    minaret:text " نبی صلی اللہ علیہ وسلم کا ہم دیکھتے ہیں  کہ بیماریوں سے علاج تین قسم کا ہوتا تھا  قدرتی ادویات کے ساتھ" .

minaret:Segment_SKD2025-0001_0383 a minaret:TranscriptSegment ;
    minaret:endTime 2159.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0384 ;
    minaret:sequenceIndex 383 ;
    minaret:startTime 2153.38 ;
    minaret:text " اور الہی ادویات کے ساتھ  اور دونوں کا مرکب  یعنی دعاوں کے ساتھ دواؤں کے ساتھ" .

minaret:Segment_SKD2025-0001_0384 a minaret:TranscriptSegment ;
    minaret:endTime 2165.1800000000003 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0385 ;
    minaret:sequenceIndex 384 ;
    minaret:startTime 2159.32 ;
    minaret:text " اور دونوں کو ملا کر  اور بیماری میں دعا کی بہت تاثیر ہے  اور اس پر ہم دیکھتے ہیں" .

minaret:Segment_SKD2025-0001_0385 a minaret:TranscriptSegment ;
    minaret:endTime 2171.9399999999996 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0386 ;
    minaret:sequenceIndex 385 ;
    minaret:startTime 2165.1800000000003 ;
    minaret:text " کہresearches  بھی ہوئی ہیں  کہ جن مریضوں کے لیے دعا کی گئی  ان کے مقابلے میں جلدی شفا حاصل ہوئی" .

minaret:Segment_SKD2025-0001_0386 a minaret:TranscriptSegment ;
    minaret:endTime 2178.22 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0387 ;
    minaret:sequenceIndex 386 ;
    minaret:startTime 2171.9399999999996 ;
    minaret:text " جن کے لیے دعائیں نہیں تھیں  لیکن کونسی چیز ہمیں مایوس کر دیتی ہے  کہ میں نے بہت دعائیں کر لیں" .

minaret:Segment_SKD2025-0001_0387 a minaret:TranscriptSegment ;
    minaret:endTime 2182.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0388 ;
    minaret:sequenceIndex 387 ;
    minaret:startTime 2178.22 ;
    minaret:text " وہ فلاں نے بھی کی تھی  لیکن وہ فوت ہو گیا  اس طرح کی باتیں ہوتی ہیں نا" .

minaret:Segment_SKD2025-0001_0388 a minaret:TranscriptSegment ;
    minaret:endTime 2185.8199999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0389 ;
    minaret:sequenceIndex 388 ;
    minaret:startTime 2182.62 ;
    minaret:text " سننے میں آتی ہیں  کوئی فائدہ نہیں دعا کرنے کا  بہت کر لی ہے" .

minaret:Segment_SKD2025-0001_0389 a minaret:TranscriptSegment ;
    minaret:endTime 2190.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0390 ;
    minaret:sequenceIndex 389 ;
    minaret:startTime 2185.8199999999997 ;
    minaret:text " یہ شیطانی جملے ہوتے ہیں  شیطان ایسی باتیں سجھاتا ہے  جو ہمارا دشمن ہے" .

minaret:Segment_SKD2025-0001_0390 a minaret:TranscriptSegment ;
    minaret:endTime 2201.3599999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0391 ;
    minaret:sequenceIndex 390 ;
    minaret:startTime 2190.04 ;
    minaret:text " تاکہ یہ خیر سے محروم ہو جائے  ایک بات دوسری بات یہ ہے کہ اللہ سبحانہ وتعالیٰ بندے کی دعا رد تو نہیں کرتا  لیکن اس کا بدلہ" .

minaret:Segment_SKD2025-0001_0391 a minaret:TranscriptSegment ;
    minaret:endTime 2206.24 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0392 ;
    minaret:sequenceIndex 391 ;
    minaret:startTime 2201.3599999999997 ;
    minaret:text " اس صورت میں دیتا ہے  جو زیادہ اس کے لیے فائدہ مند  کبھی وہی کر کے جو اس کو چاہیے" .

minaret:Segment_SKD2025-0001_0392 a minaret:TranscriptSegment ;
    minaret:endTime 2211.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0393 ;
    minaret:sequenceIndex 392 ;
    minaret:startTime 2206.24 ;
    minaret:text " اور کبھی اس سے بہتر عطا کر کے  اور کتنی ہی مصیبتیں  ہماری دعاوں کی وجہ سے ٹل جاتی ہیں" .

minaret:Segment_SKD2025-0001_0393 a minaret:TranscriptSegment ;
    minaret:endTime 2215.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0394 ;
    minaret:sequenceIndex 393 ;
    minaret:startTime 2211.52 ;
    minaret:text " بعض اوقات ہوتا ہے نا  کہ آپ گاڑی چلا رہے ہوتے ہیں  اور بالکل قریب پہنچ جاتے ہیں" .

minaret:Segment_SKD2025-0001_0394 a minaret:TranscriptSegment ;
    minaret:endTime 2218.7999999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0395 ;
    minaret:sequenceIndex 394 ;
    minaret:startTime 2215.5 ;
    minaret:text " اور آپ کہتے ہیں  اوہ اللہ نے بچا لیا  آپ کو نہیں پتا ہوتا" .

minaret:Segment_SKD2025-0001_0395 a minaret:TranscriptSegment ;
    minaret:endTime 2222.16 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0396 ;
    minaret:sequenceIndex 395 ;
    minaret:startTime 2218.7999999999997 ;
    minaret:text " ہو سکتا ہے  وہ آپ کی کسی دعا کی وجہ سے ہو  اللہ کو پتا تھا" .

minaret:Segment_SKD2025-0001_0396 a minaret:TranscriptSegment ;
    minaret:endTime 2225.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0397 ;
    minaret:sequenceIndex 396 ;
    minaret:startTime 2222.16 ;
    minaret:text " اس کو یہ نہیں دینا  اس کے بدلے یہ دینا ہے  کیونکہ یہ مانگ رہا ہے" .

minaret:Segment_SKD2025-0001_0397 a minaret:TranscriptSegment ;
    minaret:endTime 2230.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0398 ;
    minaret:sequenceIndex 397 ;
    minaret:startTime 2225.98 ;
    minaret:text " اور یہ عبادت کر رہا ہے  تو کبھی اللہ تعالی  اس سے بہتر عطا کرتا ہے" .

minaret:Segment_SKD2025-0001_0398 a minaret:TranscriptSegment ;
    minaret:endTime 2236.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0399 ;
    minaret:sequenceIndex 398 ;
    minaret:startTime 2230.06 ;
    minaret:text " جو ہم نے مانگا ہوتا ہے  حضرت مریم کی جو والدہ تھیں  انہوں نے کس کی دعا کی تھی" .

minaret:Segment_SKD2025-0001_0399 a minaret:TranscriptSegment ;
    minaret:endTime 2242.66 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0400 ;
    minaret:sequenceIndex 399 ;
    minaret:startTime 2236.3 ;
    minaret:text " تو کیا ملا  ایسی کو بیٹی دنیا میں آئی  ان کو تو نہیں پتا تھا" .

minaret:Segment_SKD2025-0001_0400 a minaret:TranscriptSegment ;
    minaret:endTime 2247.9 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0401 ;
    minaret:sequenceIndex 400 ;
    minaret:startTime 2242.66 ;
    minaret:text " کہ میری بیٹی کی کیا شان ہوگی  اس کا نام قرآن میں ہوگا  قیامت تک اس کو یاد رکھا جائے گا" .

minaret:Segment_SKD2025-0001_0402 a minaret:TranscriptSegment ;
    minaret:endTime 2261.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0403 ;
    minaret:sequenceIndex 402 ;
    minaret:startTime 2255.06 ;
    minaret:text " ہماری دعاوں کے نتیجے میں  جو بھی فیصلہ ہمارے سامنے آئے  جو بھی قبولیت کا طریقہ سامنے آئے" .

minaret:Segment_SKD2025-0001_0403 a minaret:TranscriptSegment ;
    minaret:endTime 2265.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0404 ;
    minaret:sequenceIndex 403 ;
    minaret:startTime 2261.54 ;
    minaret:text " تو کیا کرنا چاہیے  قبول کر لینا چاہیے  انسان کی happiness" .

minaret:Segment_SKD2025-0001_0404 a minaret:TranscriptSegment ;
    minaret:endTime 2270.64 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0405 ;
    minaret:sequenceIndex 404 ;
    minaret:startTime 2265.98 ;
    minaret:text " اس کی acceptance میں ہے  اللہ کے فیصلوں پر راضی ہونا  آپ کو نہیں معلوم" .

minaret:Segment_SKD2025-0001_0405 a minaret:TranscriptSegment ;
    minaret:endTime 2274.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0406 ;
    minaret:sequenceIndex 405 ;
    minaret:startTime 2270.64 ;
    minaret:text " ایک دروازہ بند ہوئے  تو دوسرے کسی دروازے سے  آپ کہاں پہنچنے والے ہیں" .

minaret:Segment_SKD2025-0001_0406 a minaret:TranscriptSegment ;
    minaret:endTime 2279.2799999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0407 ;
    minaret:sequenceIndex 406 ;
    minaret:startTime 2274.56 ;
    minaret:text " لیکن یہ ہے کہ اگر ہم چاہتے ہیں  کہ اللہ سبحانہ وتعالی ہماری دعائیں  قبول کرے" .

minaret:Segment_SKD2025-0001_0407 a minaret:TranscriptSegment ;
    minaret:endTime 2284.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0408 ;
    minaret:sequenceIndex 407 ;
    minaret:startTime 2279.2799999999997 ;
    minaret:text " تو پھر پورے اخلاص کے ساتھ  توجہ کے ساتھ  قبولیت کے یقین کے ساتھ" .

minaret:Segment_SKD2025-0001_0408 a minaret:TranscriptSegment ;
    minaret:endTime 2289.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0409 ;
    minaret:sequenceIndex 408 ;
    minaret:startTime 2284.74 ;
    minaret:text " خُشُوع و خُضُوع کے ساتھ  عاجزی کے ساتھ  تکرار اور اسرار کے ساتھ دعائیں کریں" .

minaret:Segment_SKD2025-0001_0413 a minaret:TranscriptSegment ;
    minaret:endTime 2314.66 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0414 ;
    minaret:sequenceIndex 413 ;
    minaret:startTime 2308.0 ;
    minaret:text " مٹھی بند کر کے دعا کر رہے   پھر دعا کے آداب بھی ہمیں پتہ ہونے چاہیے  اسماء حسنہ کو وسیلہ بنا کے دعا کریں" .

minaret:Segment_SKD2025-0001_0414 a minaret:TranscriptSegment ;
    minaret:endTime 2318.84 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0415 ;
    minaret:sequenceIndex 414 ;
    minaret:startTime 2314.66 ;
    minaret:text " اس سے بھی قبولیت ہوتی ہے  أبو الدرداءؓ جو تھے  وہ کہتے ہیں کہ" .

minaret:Segment_SKD2025-0001_0415 a minaret:TranscriptSegment ;
    minaret:endTime 2324.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0416 ;
    minaret:sequenceIndex 415 ;
    minaret:startTime 2318.84 ;
    minaret:text " اللہ مومنوں پر رحم فرمائے  اور اس کے بعد صرف کہتے تھے  ربنا ربنا ربنا" .

minaret:Segment_SKD2025-0001_0416 a minaret:TranscriptSegment ;
    minaret:endTime 2327.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0417 ;
    minaret:sequenceIndex 416 ;
    minaret:startTime 2324.04 ;
    minaret:text " بس  دعا کرنے کے بعد  ایک دفعہ مانگ لیتے" .

minaret:Segment_SKD2025-0001_0417 a minaret:TranscriptSegment ;
    minaret:endTime 2333.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0418 ;
    minaret:sequenceIndex 417 ;
    minaret:startTime 2327.62 ;
    minaret:text " کہ ربنا ربنا ربنا  صرف اللہ کا نام پکارتے رہتے ہیں  کوئی بھی نام آپ پکار سکتے ہیں" .

minaret:Segment_SKD2025-0001_0421 a minaret:TranscriptSegment ;
    minaret:endTime 2361.1 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0422 ;
    minaret:sequenceIndex 421 ;
    minaret:startTime 2356.38 ;
    minaret:text " دعا کی ایک تاثیر  اس لحاظ سے بھی بہت ہوتی ہے  کہ اس میں انسان" .

minaret:Segment_SKD2025-0001_0422 a minaret:TranscriptSegment ;
