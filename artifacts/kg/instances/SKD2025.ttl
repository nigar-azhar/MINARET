    minaret:precedesSegment minaret:Segment_SKD2025-0004_0148 ;
    minaret:sequenceIndex 147 ;
    minaret:startTime 704.6999999999999 ;
    minaret:text " بعض وقت  حمد کو  شکر کے مقام پر بھی" .

minaret:Segment_SKD2025-0004_0148 a minaret:TranscriptSegment ;
