    minaret:text " روحانی بیماریاں" .

minaret:Segment_SKD2025-0002_1347 a minaret:TranscriptSegment ;
    minaret:endTime 2528.2400000000002 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1348 ;
    minaret:sequenceIndex 1347 ;
    minaret:startTime 2527.0 ;
    minaret:text " غم بے سکونی" .

minaret:Segment_SKD2025-0002_1348 a minaret:TranscriptSegment ;
    minaret:endTime 2528.96 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1349 ;
    minaret:sequenceIndex 1348 ;
    minaret:startTime 2528.2400000000002 ;
    minaret:text " depression" .

minaret:Segment_SKD2025-0002_1349 a minaret:TranscriptSegment ;
    minaret:endTime 2530.36 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1350 ;
    minaret:sequenceIndex 1349 ;
    minaret:startTime 2528.96 ;
    minaret:text " نیند کی کمی" .

minaret:Segment_SKD2025-0002_1350 a minaret:TranscriptSegment ;
    minaret:endTime 2533.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1351 ;
    minaret:sequenceIndex 1350 ;
    minaret:startTime 2530.36 ;
    minaret:text " اور اسی طرح جسمانی بیماریاں" .

minaret:Segment_SKD2025-0002_1351 a minaret:TranscriptSegment ;
    minaret:endTime 2535.26 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1352 ;
    minaret:sequenceIndex 1351 ;
    minaret:startTime 2533.46 ;
    minaret:text " اور آخری بات یہ کہوں گی" .

minaret:Segment_SKD2025-0002_1352 a minaret:TranscriptSegment ;
    minaret:endTime 2537.6600000000003 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1353 ;
    minaret:sequenceIndex 1352 ;
    minaret:startTime 2535.26 ;
    minaret:text " کہ جب کوئی تکلیف آئے" .

minaret:Segment_SKD2025-0002_1353 a minaret:TranscriptSegment ;
    minaret:endTime 2539.1000000000004 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1354 ;
    minaret:sequenceIndex 1353 ;
    minaret:startTime 2537.6600000000003 ;
    minaret:text " چاہے بیماری آئے" .

minaret:Segment_SKD2025-0002_1354 a minaret:TranscriptSegment ;
    minaret:endTime 2541.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1355 ;
    minaret:sequenceIndex 1354 ;
    minaret:startTime 2539.1000000000004 ;
    minaret:text " تو اپنے اندر شکر گزاری پیدا کریں" .

minaret:Segment_SKD2025-0002_1355 a minaret:TranscriptSegment ;
    minaret:endTime 2543.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1356 ;
    minaret:sequenceIndex 1355 ;
    minaret:startTime 2541.3 ;
    minaret:text " کیونکہ شکر گزاری جو ہے" .

minaret:Segment_SKD2025-0002_1356 a minaret:TranscriptSegment ;
    minaret:endTime 2545.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1357 ;
    minaret:sequenceIndex 1356 ;
    minaret:startTime 2543.4 ;
    minaret:text " اس سے ذہنی صحت بہتر ہوتی ہے" .

minaret:Segment_SKD2025-0002_1357 a minaret:TranscriptSegment ;
    minaret:endTime 2547.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1358 ;
    minaret:sequenceIndex 1357 ;
    minaret:startTime 2545.76 ;
    minaret:text " ذہنی صحت بہتر ہوتی ہے" .

minaret:Segment_SKD2025-0002_1358 a minaret:TranscriptSegment ;
    minaret:endTime 2550.14 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1359 ;
    minaret:sequenceIndex 1358 ;
    minaret:startTime 2547.3 ;
    minaret:text " تو جسمانی صحت بھی بہتر ہو جاتی ہے" .

minaret:Segment_SKD2025-0002_1359 a minaret:TranscriptSegment ;
    minaret:endTime 2552.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1360 ;
    minaret:sequenceIndex 1359 ;
    minaret:startTime 2550.14 ;
    minaret:text " بیماریوں سے نجات مل جاتی ہے" .

minaret:Segment_SKD2025-0002_1360 a minaret:TranscriptSegment ;
    minaret:endTime 2553.84 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1361 ;
    minaret:sequenceIndex 1360 ;
    minaret:startTime 2552.3 ;
    minaret:text " لہذا" .

minaret:Segment_SKD2025-0002_1361 a minaret:TranscriptSegment ;
    minaret:endTime 2556.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1362 ;
    minaret:sequenceIndex 1361 ;
    minaret:startTime 2553.84 ;
    minaret:text " اپنی سوچ کو مثبت کریں" .

minaret:Segment_SKD2025-0002_1362 a minaret:TranscriptSegment ;
    minaret:endTime 2558.44 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1363 ;
    minaret:sequenceIndex 1362 ;
    minaret:startTime 2556.32 ;
    minaret:text " اللہ سے اچھا گمان رکھیں" .

minaret:Segment_SKD2025-0002_1363 a minaret:TranscriptSegment ;
    minaret:endTime 2559.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1364 ;
    minaret:sequenceIndex 1363 ;
    minaret:startTime 2558.44 ;
    minaret:text " اور" .

minaret:Segment_SKD2025-0002_1364 a minaret:TranscriptSegment ;
    minaret:endTime 2561.48 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1365 ;
    minaret:sequenceIndex 1364 ;
    minaret:startTime 2559.46 ;
    minaret:text " قرآن سے بڑھ کر کوئی چیز" .

minaret:Segment_SKD2025-0002_1365 a minaret:TranscriptSegment ;
    minaret:endTime 2563.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1366 ;
    minaret:sequenceIndex 1365 ;
    minaret:startTime 2561.48 ;
    minaret:text " انسان کو مثبت سوچ نہیں دیتی" .

minaret:Segment_SKD2025-0002_1366 a minaret:TranscriptSegment ;
    minaret:endTime 2566.2200000000003 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1367 ;
    minaret:sequenceIndex 1366 ;
    minaret:startTime 2563.76 ;
    minaret:text " اگر وہ اس کو صحیح معنوں میں غور و فکر کے ساتھ" .

minaret:Segment_SKD2025-0002_1367 a minaret:TranscriptSegment ;
    minaret:endTime 2567.48 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1368 ;
    minaret:sequenceIndex 1367 ;
    minaret:startTime 2566.2200000000003 ;
    minaret:text " علاج کی نیت سے پڑھیں" .

minaret:Segment_SKD2025-0002_1368 a minaret:TranscriptSegment ;
    minaret:endTime 2568.92 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1369 ;
    minaret:sequenceIndex 1368 ;
    minaret:startTime 2567.48 ;
    minaret:text " تو خلاصہ کیا ہوا" .

minaret:Segment_SKD2025-0002_1369 a minaret:TranscriptSegment ;
    minaret:endTime 2570.2400000000002 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1370 ;
    minaret:sequenceIndex 1369 ;
    minaret:startTime 2568.92 ;
    minaret:text " شفا صرف" .

minaret:Segment_SKD2025-0002_1370 a minaret:TranscriptSegment ;
    minaret:endTime 2571.58 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1371 ;
    minaret:sequenceIndex 1370 ;
    minaret:startTime 2570.2400000000002 ;
    minaret:text " اللہ کے ہاتھ" .

minaret:Segment_SKD2025-0002_1371 a minaret:TranscriptSegment ;
    minaret:endTime 2576.12 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_1372 ;
    minaret:sequenceIndex 1371 ;
    minaret:startTime 2571.58 ;
    minaret:text " تو شفا اور شافی آج کا آپ کے لئے message تھا" .

minaret:Segment_SKD2025-0003_0000 a minaret:TranscriptSegment ;
    minaret:endTime 10.34 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0001 ;
    minaret:sequenceIndex 0 ;
    minaret:startTime 0.98 ;
    minaret:text "السلام علیکم ورحمۃ اللہ وبرکاتہ! وعلیکم السلام ورحمۃ اللہ وبرکاتہ! کیا حال ہے آپ لوگوں کا؟" .

minaret:Segment_SKD2025-0003_0004 a minaret:TranscriptSegment ;
    minaret:endTime 73.02 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0005 ;
    minaret:sequenceIndex 4 ;
    minaret:startTime 63.04 ;
    minaret:text "وہ کون ہے؟ الشافی! اللہ سبحانہ وتعالیٰ۔ یعنی جب انسان کو کوئی پریشانی لاحق ہوتی ہے، وہ کسی مرض میں مبتلا ہوتا ہے،" .

minaret:Segment_SKD2025-0003_0005 a minaret:TranscriptSegment ;
    minaret:endTime 83.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 73.02 ;
    minaret:text "یا کسی مصیبت میں گرفتار ہو جاتا ہے، یا کسی ظالم کے ہتھے چڑھ جاتا ہے، تو وہ خوب خوب پکارنے لگتا ہے، ایک ہستی کی طرف متوجہ ہوتا ہے۔" .

minaret:Segment_SKD2025-0003_0006 a minaret:TranscriptSegment ;
    minaret:endTime 92.86 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 83.04 ;
    minaret:text "حتیٰ کہ مشرکین بھی جب سخت مشکل میں گرفتار ہوتے تو کیا کرتے؟ سب کو بھول کر صرف اللہ کی طرف متوجہ ہو جاتے ہیں،" .

minaret:Segment_SKD2025-0003_0007 a minaret:TranscriptSegment ;
    minaret:endTime 102.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 92.86 ;
    minaret:text "اس رب کی طرف جو فریاد رس کرتا ہے، جو مصیبت کو دور کرتا ہے۔ اور مضطر کون ہوتا ہے؟ بے قرار کون ہوتا ہے؟" .

minaret:Segment_SKD2025-0003_0008 a minaret:TranscriptSegment ;
    minaret:endTime 113.02 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 102.8 ;
    minaret:text "ابنِ عباس کہتے ہیں: اس سے مراد سخت ضرورت والا، یعنی جس کو کسی بھی چیز کی سخت حاجت پیش آ گئی ہو۔ سدی کہتے ہیں: جس کے پاس کوئی ہیلا اور قوت نہیں، بے بس ہے، لاچار ہے، کچھ کر نہیں سکتا۔" .

minaret:Segment_SKD2025-0003_0009 a minaret:TranscriptSegment ;
    minaret:endTime 123.14 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 113.02 ;
    minaret:text "ذوالنون مصری کہتے ہیں: جس نے اللہ تعالیٰ کے سوا سب سے تعلقات ختم کر دیے ہوں، سب کو چھوڑ کر صرف اور صرف اللہ کی طرف متوجہ ہونے والا۔" .

minaret:Segment_SKD2025-0003_0010 a minaret:TranscriptSegment ;
    minaret:endTime 140.44 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 130.16 ;
    minaret:text "ابو عثمان نیشاپوری کہتے ہیں: اس سے مراد مفلس ہے، مفلس یعنی جس کے پاس کچھ نہیں۔ سہیل بن عبداللہ کہتے ہیں: اس سے مراد وہ شخص ہے جب وہ اللہ تعالیٰ کی بارگاہ میں دعا کے لیے اپنے ہاتھ اٹھائے،" .

minaret:Segment_SKD2025-0003_0011 a minaret:TranscriptSegment ;
    minaret:endTime 150.28 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0012 ;
    minaret:sequenceIndex 11 ;
    minaret:startTime 140.44 ;
    minaret:text "تو اس کے پاس اطاعت سے کوئی وسیلہ نہ ہو جن کو وہ پیش کرے—یعنی اس کے پاس کوئی عبادت نہیں، کوئی چیز نہیں جو وسیلہ بنا کے پیش کرے—" .

minaret:Segment_SKD2025-0003_0012 a minaret:TranscriptSegment ;
    minaret:endTime 160.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0013 ;
    minaret:sequenceIndex 12 ;
    minaret:startTime 150.28 ;
    minaret:text "یعنی ایک انسان ہے، سخت گناہگار ہے، اللہ سے بہت دور ہے، لیکن ایک لمحہ آتا ہے زندگی میں سخت تکلیف اور پریشانی کا، کہ جس میں پھر اس کو اللہ کے سوا کوئی یاد نہیں آتا،" .

minaret:Segment_SKD2025-0003_0013 a minaret:TranscriptSegment ;
    minaret:endTime 170.64 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0014 ;
    minaret:sequenceIndex 13 ;
    minaret:startTime 160.52 ;
    minaret:text "اور اس وقت وہ سوچتا ہے کہ وہی ہے جو میری تکلیف دور کر سکتا ہے۔ اس کا ایمان جاگ اٹھتا ہے، اس کے اندر کی جو بے قراری ہوتی ہے وہ اس کے سارے غفلت کے پردے چاک کر دیتی ہے۔" .

minaret:Segment_SKD2025-0003_0014 a minaret:TranscriptSegment ;
    minaret:endTime 180.68 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0015 ;
    minaret:sequenceIndex 14 ;
    minaret:startTime 170.64 ;
    minaret:text "جب کوئی انسان سخت مجبور ہو جاتا ہے اور وہ اخلاص کے ساتھ دعا کرتا ہے، سب وسیلوں کو چھوڑ کر، سب سہاروں کو چھوڑ کر صرف ایک سہارا پکڑتا ہے، تو ایسے شخص کی دعا اللہ تعالیٰ قبول کر لیتا ہے۔" .

minaret:Segment_SKD2025-0003_0015 a minaret:TranscriptSegment ;
    minaret:endTime 193.64 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0016 ;
    minaret:sequenceIndex 15 ;
    minaret:startTime 180.68 ;
    minaret:text "اللہ تعالیٰ ضمانت دے رہا ہے: وَيَكْشِفُ السُّوءَ، کہ وہ تکلیف دور کر دیتا ہے۔ اور یہ جو اخلاص ہوتا ہے، یہ تکلیف اور بے قراری سے پیدا ہوتا ہے۔" .

minaret:Segment_SKD2025-0003_0016 a minaret:TranscriptSegment ;
    minaret:endTime 204.24 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0017 ;
    minaret:sequenceIndex 16 ;
    minaret:startTime 194.28 ;
    minaret:text "اس سے یہ بات سمجھ میں آتی ہے کہ اللہ تعالیٰ انسان کو مختلف آزمائشوں میں کیوں ڈالتا ہے؟ کیونکہ وہ اس کو اپنے لیے کیا کرنا چاہتا ہے؟ خالص کرنا چاہتا ہے۔" .

minaret:Segment_SKD2025-0003_0017 a minaret:TranscriptSegment ;
    minaret:endTime 214.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0018 ;
    minaret:sequenceIndex 17 ;
    minaret:startTime 204.24 ;
    minaret:text "ہم پہ جب کوئی مشکل آتی ہے تو ہم کیا کرتے ہیں؟ بعض لوگ اللہ تعالیٰ سے شکوے کرنے لگتے ہیں: \"ایک میں ہی رہ گئی تھی؟ مجھ پر ہی کیوں بار بار یہ مشکلات آتی ہیں؟ میری زندگی میں چین کیوں نہیں؟ میرے ساتھ یہ کیوں ہو گیا؟ وائی می؟\"" .

minaret:Segment_SKD2025-0003_0018 a minaret:TranscriptSegment ;
    minaret:endTime 224.16 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0019 ;
    minaret:sequenceIndex 18 ;
    minaret:startTime 214.32 ;
    minaret:text "اس طرح کے جملے بولتے ہیں۔ کیا اس سے مشکلات دور ہو جاتی ہیں؟ نہیں! دوسری طرح کے لوگ وہ ہوتے ہیں جو اس وقت جب سخت تپش میں ڈالے جاتے ہیں، ایک بھٹی میں ڈال دیے جاتے ہیں آزمائش کی،" .

minaret:Segment_SKD2025-0003_0019 a minaret:TranscriptSegment ;
    minaret:endTime 234.16 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0020 ;
    minaret:sequenceIndex 19 ;
    minaret:startTime 224.16 ;
    minaret:text "تو وہ کیا کرتے ہیں؟ پھر خالص ہو کر اللہ کو پکارتے ہیں: \"اللہ بس تو ہی ہے، تیرے سوا اور کوئی نہیں۔\" تو پھر کیا ہوتا ہے؟" .

minaret:Segment_SKD2025-0003_0020 a minaret:TranscriptSegment ;
    minaret:endTime 244.28 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0021 ;
    minaret:sequenceIndex 20 ;
    minaret:startTime 234.16 ;
    minaret:text "جب اس کا قلبی تعلق، دل کا تعلق، محبت کا تعلق، امید کا تعلق، توکل کا تعلق اللہ تعالیٰ سے پیدا ہوتا ہے، تو پھر ایسے اخلاص کی اللہ تعالیٰ بہت قدر کرتا ہے،" .

minaret:Segment_SKD2025-0003_0021 a minaret:TranscriptSegment ;
    minaret:endTime 269.92 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0022 ;
    minaret:sequenceIndex 21 ;
    minaret:startTime 244.28 ;
    minaret:text "चाहे ऐसा कोई شخص مومن ہو یا غیر مومن ہو، اطاعت شعار ہو یا فاجر و فاسق ہو، کوئی بھی ہو! اللہ تو سب کا ہے؛ اور جب کوئی شخص بھٹکتا ہے، شیطان کے ہتھے چڑھتا ہے، اور پھر کسی موقع پر اللہ کی طرف پلٹ آتا ہے، تو اللہ تعالیٰ اس کو ویلکم کرتے ہیں یا نہیں؟" .

minaret:Segment_SKD2025-0003_0022 a minaret:TranscriptSegment ;
    minaret:endTime 281.42 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 271.28 ;
    minaret:text "خوش होते हैं उससे कि नहीं? اس سے بھی زیادہ خوش ہوتے ہیں جس کی مثال اس شخص سے دی گئی جس کی اونٹنی گم ہو گئی اور وہ اس کے مرنے کے چانسز بڑھ گئے اور پھر اونٹنی مل گئی تو وہ خوش ہو گیا" .

minaret:Segment_SKD2025-0003_0023 a minaret:TranscriptSegment ;
    minaret:endTime 302.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 281.98 ;
    minaret:text "اور کہنے لگا کہ \"تو میرا بندہ اور میں تیرا رب!\" (یعنی آپس میں باہر ہو گئے خوشی کے مارے)۔ تو اللہ تعالیٰ ہر ایسے بندے سے خوش होते हैं जो اللہ تعالیٰ کی طرف پلٹتا ہے، رجوع کرتا ہے، اور پلٹنا بھی اسی کی طرف چاہیے، ٹھیک ہے؟" .

minaret:Segment_SKD2025-0003_0024 a minaret:TranscriptSegment ;
    minaret:endTime 316.72 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 309.78 ;
    minaret:text "اَمَّن يُجِيبُ الْمُطَرَّ اِذَا دَعَاهُ وَيَكْشِفُ السُّوءَ" .

minaret:Segment_SKD2025-0003_0025 a minaret:TranscriptSegment ;
    minaret:endTime 327.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 317.44 ;
    minaret:text "کیا ہمارے اوپر کبھی ایسی کوئی کیفیت گزری کہ ہم مضطر ہو گئے ہوں، بے قرار ہوں، بے چین ہوں، نہ کھڑے چین، نہ بیٹھے چین، نہ لیٹے چین،" .

minaret:Segment_SKD2025-0003_0026 a minaret:TranscriptSegment ;
    minaret:endTime 337.64 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 327.32 ;
    minaret:text "کسی چیز میں دل نہ لگے، ڈپریشن کا دورہ پڑ جائے یا درد اتنی شدید ہو کہ کچھ نہ سوجھے؟ کوئی وقت یاد کریں، یاد آیا؟" .

minaret:Segment_SKD2025-0003_0027 a minaret:TranscriptSegment ;
    minaret:endTime 348.66 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 338.68 ;
    minaret:text "اور کچھ لوگوں کو تو ہر مہینے ایسی پین سے گزرنا پڑتا ہے کہ سخت تکلیف اور بے قراری ہو جاتی ہے، الٹیاں شروع ہو جاتی ہیں، لوٹ پوٹ ہو جاتے ہیں،" .

minaret:Segment_SKD2025-0003_0028 a minaret:TranscriptSegment ;
    minaret:endTime 358.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0029 ;
    minaret:sequenceIndex 28 ;
    minaret:startTime 348.66 ;
    minaret:text "سانس رکنے لگتا ہے، جان کے لالے پڑ جاتے ہیں۔ پھر کیا کرتے ہیں ہم؟ یہ ہے ہمارا امتحان! ٹھیک ہے؟" .

minaret:Segment_SKD2025-0003_0029 a minaret:TranscriptSegment ;
    minaret:endTime 368.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0030 ;
    minaret:sequenceIndex 29 ;
    minaret:startTime 358.56 ;
    minaret:text "اصل میں اس کتاب کے پڑھنے کا یا اس کو پیش کرنے کا جو بنیادی مقصد ہے، وہ یہ ہے کہ ہمارا دھیان سب سے ہٹ کر، دوائیوں سے ہٹ کر، ڈاکٹروں سے ہٹ کر، پیاروں سے ہٹ کر، سب سے ہٹ کر کس کی طرف ہو جائے؟" .

minaret:Segment_SKD2025-0003_0030 a minaret:TranscriptSegment ;
    minaret:endTime 378.6 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0031 ;
    minaret:sequenceIndex 30 ;
    minaret:startTime 368.76 ;
    minaret:text "اللہ کی طرف! \"یا اللہ! یا ربی!\" اللہ کو پیارے پیارے ناموں سے، \"یا شافی! یا کافی!\" پکارتے رہیں، اس کو: \"آپ میری رہنمائی کریں کہ میرا علاج کس چیز میں ہے، آپ ہی میری تکلیف دور کر دیں!\"" .

minaret:Segment_SKD2025-0003_0031 a minaret:TranscriptSegment ;
    minaret:endTime 388.7 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0032 ;
    minaret:sequenceIndex 31 ;
    minaret:startTime 378.6 ;
    minaret:text "آپ تو بغیر دوا کے بھی ٹھیک کر سکتے ہیں۔ کچھ ایسی جگہ بھی ہوتی ہے نا جہاں ایپروپریٹ دوا ہوتی کوئی نہیں، ڈاکٹر بھی होते हैं, دوائیاں بھی، لیکن دوائی آؤٹ آف سٹاک ہے، دوا نہیں ہے، جان کے لالے پڑے ہوئے ہیں!" .

minaret:Segment_SKD2025-0003_0032 a minaret:TranscriptSegment ;
    minaret:endTime 398.94 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0033 ;
    minaret:sequenceIndex 32 ;
    minaret:startTime 389.32 ;
    minaret:text "تو یہ ہمارا ٹارگٹ نمبر ون، پہلا گول ہونا چاہیے: مخلوق سے بے نیازی اور ساری رغبت اللہ کی طرف، چھوٹی تکلیف، بڑی تکلیف، ہر تکلیف میں، ٹھیک ہے؟" .

minaret:Segment_SKD2025-0003_0033 a minaret:TranscriptSegment ;
    minaret:endTime 409.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0034 ;
    minaret:sequenceIndex 33 ;
    minaret:startTime 398.94 ;
    minaret:text "اچھا، پھر بتائیے کہ اسی پیج پر نیچے کیا بنا ہوا ہے؟ یہ نیچے کیا چیز ہے؟ یہ جو ڈبیاں تین بنی ہوئی ہیں، کیو آر کوڈز ہیں، یہ کس لیے چھاپے گئے ہیں؟ کیا کرنا ہے؟" .

minaret:Segment_SKD2025-0003_0034 a minaret:TranscriptSegment ;
    minaret:endTime 431.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0035 ;
    minaret:sequenceIndex 34 ;
    minaret:startTime 421.3 ;
    minaret:text "سکین کرنا ہے اور کیا کرنا ہے؟ کروانا ہے! جو بھی بے قرار ہیں ان کو سکین کروانا ہے تاکہ ان کو یہاں سے دعائیں ملتی رہیں،" .

minaret:Segment_SKD2025-0003_0035 a minaret:TranscriptSegment ;
    minaret:endTime 438.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0036 ;
    minaret:sequenceIndex 35 ;
    minaret:startTime 431.54 ;
    minaret:text "آپ جو کچھ پڑھ رہے ہیں اس کے نوٹس ملتے رہیں، جو سن رہے ہیں اس کے لنک ملتے رہیں۔ وہ کیوں ملتے رہیں؟" .

minaret:Segment_SKD2025-0003_0036 a minaret:TranscriptSegment ;
    minaret:endTime 450.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0037 ;
    minaret:sequenceIndex 36 ;
    minaret:startTime 440.42 ;
    minaret:text "پڑھنے کے لیے اور پڑھ کر عمل کرنے کے لیے۔ کبھی کوئی شخص آپ کے پاس آیا ہے جو تکلیف میں مبتلا ہو؟ آتے ہیں نا؟ ہر دوسرا بندہ کوئی نہ کوئی گلہ شکوہ کر रहा होता है: \"میرے ساتھ یہ ہو گیا، مجھے یہ ہو گیا، مجھے وہ ہو گیا!\"" .

minaret:Segment_SKD2025-0003_0037 a minaret:TranscriptSegment ;
    minaret:endTime 460.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0038 ;
    minaret:sequenceIndex 37 ;
    minaret:startTime 450.52 ;
    minaret:text "تو پھر آپ سوچتے ہیں اچھا میں اب کیا کروں؟ کدھر جاؤں؟ پھر اس سے آپ कहें: \"अच्छा ادھر آؤ میں تمہیں بتاتی ہوں، اس کے علاوہ ایک دعائیں ایپ ہے،" .

minaret:Segment_SKD2025-0003_0038 a minaret:TranscriptSegment ;
    minaret:endTime 470.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0039 ;
    minaret:sequenceIndex 38 ;
    minaret:startTime 460.56 ;
    minaret:text "آپ سب اپنے پاس دعائیں ایپ ڈاؤن لوڈ کر لیں، یہ ساری دعائیں اور انشاء اللہ ان کے آڈیوز ہم اس پر اپلوڈ کر دیں گے، اس میں ڈال دیں گے۔\" پھر جو بیمار ہو،" .

minaret:Segment_SKD2025-0003_0039 a minaret:TranscriptSegment ;
    minaret:endTime 480.14 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0040 ;
    minaret:sequenceIndex 39 ;
    minaret:startTime 470.62 ;
    minaret:text "اس کو وہ ایپ ڈاؤن لوڈ کروا کے آپ نے کیا کرنا ہے؟ کہنا ہے یہ کھولیں اور اس کو پڑھنا شروع کریں۔ وہ کہے: \"میں نہیں پڑھ سکتی، مجھے نہیں پڑھنا آتا!\" پھر آپ کیا کہیں گے اس کو؟" .

minaret:Segment_SKD2025-0003_0040 a minaret:TranscriptSegment ;
    minaret:endTime 490.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0041 ;
    minaret:sequenceIndex 40 ;
    minaret:startTime 481.26 ;
    minaret:text "سن لیں! آڈیوز سن لیں! کچھ مریض ایسا ہوتا ہے—یہ نہیں کوئی بہانہ کر رہا ہو—نہیں پڑھ سکتے، ان کو کہیں سن لیں، یہ آپ کے پاس ریڈی ریفرنس ہے۔" .

minaret:Segment_SKD2025-0003_0041 a minaret:TranscriptSegment ;
    minaret:endTime 504.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0042 ;
    minaret:sequenceIndex 41 ;
    minaret:startTime 496.44 ;
    minaret:text "لوگوں کو مشکلات سے نکلنے کے لیے آپ نے مدد کرنی ہے۔ آپ میں سے ہر ایک دوسرے کی مدد کرے گا، اور جو دوسرے کی مدد کرتا ہے، اس کے لیے کیا ہوتا ہے؟" .

minaret:Segment_SKD2025-0003_0042 a minaret:TranscriptSegment ;
    minaret:endTime 515.92 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0043 ;
    minaret:sequenceIndex 42 ;
    minaret:startTime 505.98 ;
    minaret:text "اس کی مدد ہوتی है! ہو سکتا ہے آپ کسی کی تکلیف میں کام آئیں اور اللہ تعالیٰ آپ کی تقدیر سے وہ تکلیف مٹا دے، ختم کر دے۔" .

minaret:Segment_SKD2025-0003_0043 a minaret:TranscriptSegment ;
    minaret:endTime 525.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0044 ;
    minaret:sequenceIndex 43 ;
    minaret:startTime 515.92 ;
    minaret:text "تو پورے احساس کے ساتھ، درد کے ساتھ، اخلاص کے ساتھ، توجہ کے ساتھ اوروں کے کام آئیں۔ آپ کہیں گے: \"میری کیا ہستی؟ میں تو ایک چھوٹا سا جگنو ہوں!\"" .

minaret:Segment_SKD2025-0003_0044 a minaret:TranscriptSegment ;
    minaret:endTime 536.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0045 ;
    minaret:sequenceIndex 44 ;
    minaret:startTime 525.8 ;
    minaret:text "لیکن علامہ اقبال کیا بتاتے ہیں جگنو کی کہانی سے؟ کسی کو آتی ہے جگنو والی نظم؟ \"ہے لوگ وہی جہاں میں اچھے، آتے ہیں کام جو دوسروں کے!\"" .

minaret:Segment_SKD2025-0003_0045 a minaret:TranscriptSegment ;
    minaret:endTime 547.36 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0046 ;
    minaret:sequenceIndex 45 ;
    minaret:startTime 537.2 ;
    minaret:text "تو آپ نے اچھا بننا ہے۔ ہر شخص چاہتا ہے مجھے اچھا سمجھا جائے، میں کوئی برا انسان نہیں ہوں؛ لیکن اچھا بننے کے لیے کچھ کرنا پڑتا ہے، مفت میں کوئی اچھا نہیں بن سکتا۔" .

minaret:Segment_SKD2025-0003_0046 a minaret:TranscriptSegment ;
    minaret:endTime 557.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0047 ;
    minaret:sequenceIndex 46 ;
    minaret:startTime 547.36 ;
    minaret:text "لہٰذا آپ نے دوسروں کے کام آنا ہے۔ آپ ڈاکٹر نہیں بن سکتے—ہو سکتا ہے آپ میں سے کچھ کی وش ہو میں ڈاکٹر بنوں، وہ نہیں بن سکے اور انہیں یہاں آنا پڑ گیا—ہم ڈاکٹر نہیں بن سکتے،" .

minaret:Segment_SKD2025-0003_0047 a minaret:TranscriptSegment ;
    minaret:endTime 567.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0048 ;
    minaret:sequenceIndex 47 ;
    minaret:startTime 557.54 ;
    minaret:text "لیکن ہم کیا کر سکتے ہیں؟ شفا کا ایک اور متبادل ذریعہ ان کو بتا سکتے ہیں کہ یہ بھی آپ کریں گے۔ وہ ڈاکٹر کے پاس ضرور جائیں، لوگوں کو ڈاکٹر سے نہیں روکنا آپ نے،" .

minaret:Segment_SKD2025-0003_0048 a minaret:TranscriptSegment ;
    minaret:endTime 577.34 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0049 ;
    minaret:sequenceIndex 48 ;
    minaret:startTime 567.5 ;
    minaret:text "لیکن ان کو یہ بتائیں کہ شفا اللہ کے ہاتھ میں ہے، ٹھیک ہے؟ چلیے، اس کا مقدمہ دیکھتے ہیں:" .

minaret:Segment_SKD2025-0003_0049 a minaret:TranscriptSegment ;
    minaret:endTime 587.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0050 ;
    minaret:sequenceIndex 49 ;
    minaret:startTime 577.34 ;
    minaret:text "ہر انسان زندگی میں کسی نہ کسی بیماری سے دوچار ہوتا ہے، خواہ وہ جسمانی ہو، روحانی ہو، ذہنی ہو یا نفسیاتی۔ بیماری اللہ تعالیٰ کے اذن سے آتی ہے اور شفا بھی وہی دیتا ہے،" .

minaret:Segment_SKD2025-0003_0050 a minaret:TranscriptSegment ;
    minaret:endTime 597.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0051 ;
    minaret:sequenceIndex 50 ;
    minaret:startTime 587.5 ;
    minaret:text "جیسے کہ رسول اللہ صلی اللہ علیہ وسلم کا فرمان ہے: \"اللہ تعالیٰ نے کوئی بیماری ایسی نہیں اتاری جس کا علاج نہ اتارا ہو۔\" مومن اسی یقین کے ساتھ اللہ تعالیٰ سے اچھا گمان رکھتے ہوئے" .

minaret:Segment_SKD2025-0003_0051 a minaret:TranscriptSegment ;
    minaret:endTime 607.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0052 ;
    minaret:sequenceIndex 51 ;
    minaret:startTime 597.5 ;
    minaret:text "اس کی طرف رجوع करता है। وہ بیماری کو برا بھلا کہنے کی بجائے صبر اور رضا کے ساتھ اس کے فضل اور رحمت کا طلبگار होता है। وہ بیماری میں مایوس ہونے،" .

minaret:Segment_SKD2025-0003_0052 a minaret:TranscriptSegment ;
    minaret:endTime 617.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0053 ;
    minaret:sequenceIndex 52 ;
    minaret:startTime 607.52 ;
    minaret:text "طرح طرح کے وسوسوں سے بچنے کے لیے دعاؤں کو اپنا معمول بناتا ہے۔ مرض میں پرہیز، علاج اور صدقہ خیرات کے ساتھ ساتھ دعاؤں کا سہارا لینے" .

minaret:Segment_SKD2025-0003_0053 a minaret:TranscriptSegment ;
    minaret:endTime 627.48 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0054 ;
    minaret:sequenceIndex 53 ;
    minaret:startTime 617.52 ;
    minaret:text "سے انسان نہ صرف شکوہ و شکایت سے بچتا ہے، بلکہ صبر کے اجر پر نظر رکھ کر اللہ ہی کے سامنے اپنی تکلیف اور پریشانی کا اظہار کرتا ہے، کیونکہ" .

minaret:Segment_SKD2025-0003_0054 a minaret:TranscriptSegment ;
    minaret:endTime 637.42 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0055 ;
    minaret:sequenceIndex 54 ;
    minaret:startTime 627.48 ;
    minaret:text "وہی ہر تکلیف دور کرنے اور مدد کرنے پر قدرت रखता है। اسی مقصد کے پیش نظر \"شفا کی دعائیں\" کے نام سے یہ کتاب ترتیب دی گئی ہے، جس میں ہر طرح کے شر سے پناہ" .

minaret:Segment_SKD2025-0003_0055 a minaret:TranscriptSegment ;
    minaret:endTime 647.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0056 ;
    minaret:sequenceIndex 55 ;
    minaret:startTime 637.42 ;
    minaret:text "طلب کرنے اور خصوصاً نظر اور جادو کے اثرات کے علاج کے لیے مسنون دعاؤں کو بھی شامل کیا گیا ہے۔ اللہ تعالیٰ سے دعا ہے کہ یہ کتاب مریض کا اللہ تعالیٰ سے تعلق مضبوط" .

minaret:Segment_SKD2025-0003_0056 a minaret:TranscriptSegment ;
    minaret:endTime 657.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0057 ;
    minaret:sequenceIndex 56 ;
    minaret:startTime 647.62 ;
    minaret:text "کرنے اور بیماری سے شفا کے صبر آزما مرحلے میں مدد فراہم کرے، آمین! یعنی یہ ہے اس کتاب کے لکھنے کا مقصد۔" .

minaret:Segment_SKD2025-0003_0057 a minaret:TranscriptSegment ;
    minaret:endTime 670.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0058 ;
    minaret:sequenceIndex 57 ;
    minaret:startTime 657.56 ;
    minaret:text "اب اس میں جو ایک بات ہے کہ شکوہ شکایت سے بچے اور پریشانی کا اظہار اللہ سے کریں—یعنی شکوہ شکایت کرنے میں بھی ہمیں بولنا پڑتا ہے یا نہیں؟ بولنا پڑتا ہے نا؟ تو وہی جو الفاظ ہیں نا ان کو تبدیل کر لیں کس سے؟" .

minaret:Segment_SKD2025-0003_0058 a minaret:TranscriptSegment ;
    minaret:endTime 684.34 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 671.62 ;
    minaret:text "دعاؤں سے، اللہ سے بات کرنے سے۔ شکوہ شکایت جب کرتے ہیں تو کیا فائدہ ہوتا ہے؟ شیطان خوش ہوتا ہے اور مایوسی پھیلتی ہے، وہ آپ کو سامنے والا کچھ اور بتا دیتا ہے۔ بیماری کس کی طرف سے آتی ہے؟" .

minaret:Segment_SKD2025-0003_0059 a minaret:TranscriptSegment ;
    minaret:endTime 695.58 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0060 ;
    minaret:sequenceIndex 59 ;
    minaret:startTime 685.46 ;
    minaret:text "وہاں سے آتی ہے، امتحان! اللہ نے فرما دیا ہے کہ ضرور آزمائش کریں گے تمہاری۔ امتحان تو ہوتا ہے ہر ایک کا، تو کبھی بیماری کی شکل میں اور بیماری کی بھی مختلف شکلوں میں۔" .

minaret:Segment_SKD2025-0003_0060 a minaret:TranscriptSegment ;
    minaret:endTime 705.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0061 ;
    minaret:sequenceIndex 60 ;
    minaret:startTime 695.58 ;
    minaret:text "تو جب انسان اس بیماری کا شکوہ کرتا ہے تو بلاوجہ اپنی طاقت ضائع کرتا ہے، اور جب انسان اسی طاقت کو دعا کرنے میں استعمال کرتا ہے تو اس سے اس کی" .

minaret:Segment_SKD2025-0003_0061 a minaret:TranscriptSegment ;
    minaret:endTime 715.22 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0062 ;
    minaret:sequenceIndex 61 ;
    minaret:startTime 705.4 ;
    minaret:text "بیماری اور تکلیف دور ہو جاتی ہے یا کم از کم ہلکی ضرور ہو جاتی ہے، ٹھیک ہے؟ تو بات یہ ہے کہ دنیا جنت نہیں ہے، جنت کہیں اور ہے!" .

minaret:Segment_SKD2025-0003_0062 a minaret:TranscriptSegment ;
    minaret:endTime 725.26 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0063 ;
    minaret:sequenceIndex 62 ;
    minaret:startTime 715.22 ;
    minaret:text "دنیا کیا ہے؟ دار الامتحان ہے۔ تو جس طرح ایمان سے محروم انسان کو آزمائش میں مبتلا کیا جاتا ہے، اسی طرح صاحبِ ایمان" .

minaret:Segment_SKD2025-0003_0063 a minaret:TranscriptSegment ;
    minaret:endTime 736.44 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0064 ;
    minaret:sequenceIndex 63 ;
    minaret:startTime 725.26 ;
    minaret:text "کے لیے بھی آزمائش مقدر ہوتی ہے۔ یعنی آزمائش صرف نان مسلم، نان پریکٹسنگ کے لیے نہیں ہوتی، بلکہ کس کے لیے ہوتی ہے؟ مومن کے لیے بھی ہوتی ہے۔ سب سے زیادہ کس کو آزمایا گیا تھا؟ انبیاء کو!" .

minaret:Segment_SKD2025-0003_0064 a minaret:TranscriptSegment ;
    minaret:endTime 748.2 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0065 ;
    minaret:sequenceIndex 64 ;
    minaret:startTime 738.12 ;
    minaret:text "اللہ سبحانہ وتعالیٰ جس سے محبت کرتا ہے اس کو آزما لیتا ہے؛ لیکن اس وقت ہمیں اللہ کی محبت بھول جاتی ہے۔ تو بات یہ ہے کہ آپ کتنی بھی کیئر کر لیں، کتنا" .

minaret:Segment_SKD2025-0003_0065 a minaret:TranscriptSegment ;
    minaret:endTime 758.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0066 ;
    minaret:sequenceIndex 65 ;
    minaret:startTime 748.2 ;
    minaret:text "بھی خیال رکھیں ہر لحاظ سے، لیکن پھر بھی کہیں نہ کہیں سے بیماری آ جاتی ہے، کبھی جراثیم کی وجہ سے، وائرسز کی وجہ سے، اور کبھی آپ کے اپنے ذہنی" .

minaret:Segment_SKD2025-0003_0066 a minaret:TranscriptSegment ;
    minaret:endTime 768.14 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0067 ;
    minaret:sequenceIndex 66 ;
    minaret:startTime 758.3 ;
    minaret:text "سوچ اور رویے کی وجہ سے، آپ کے ان ہیلتی لائف سٹائل کی وجہ سے؛ یعنی سبب کوئی بھی بن جاتا ہے لیکن آتی ہے۔ کیا انبیاء کرام بیمار ہوئے؟ ہوئے!" .

minaret:Segment_SKD2025-0003_0067 a minaret:TranscriptSegment ;
    minaret:endTime 778.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0068 ;
    minaret:sequenceIndex 67 ;
    minaret:startTime 768.14 ;
    minaret:text "نبی صلی اللہ علیہ وسلم پر کبھی کوئی بیماری آئی؟ آئی! جب آپ کی وفات ہوئی تو آپ تقریباً کتنے دن بیمار رہے تھے؟ دو ہفتے تقریباً، چودہ دن!" .

minaret:Segment_SKD2025-0003_0068 a minaret:TranscriptSegment ;
    minaret:endTime 787.96 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0069 ;
    minaret:sequenceIndex 68 ;
    minaret:startTime 778.04 ;
    minaret:text "یعنی ایک طویل بیماری تھی اور پھر اس کے بعد آپ وفات پائے۔ عام طور پر مومن کے ساتھ یہی ہوتا ہے، بیماری آتی ہے اور پھر وہ آہستہ آہستہ گھلتا گھلتا اللہ کو جا ملتا ہے۔" .

minaret:Segment_SKD2025-0003_0069 a minaret:TranscriptSegment ;
    minaret:endTime 798.02 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0070 ;
    minaret:sequenceIndex 69 ;
    minaret:startTime 787.96 ;
    minaret:text "लेकिन بعض اوقات اچانک بھی موت آ جاتی है, تو بہرحال موت سے پہلے یا زندگی میں بھی بیماری آتی ہے مومن کو پاک کرنے کے لیے۔" .

minaret:Segment_SKD2025-0003_0070 a minaret:TranscriptSegment ;
    minaret:endTime 812.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0071 ;
    minaret:sequenceIndex 70 ;
    minaret:startTime 798.02 ;
    minaret:text "اس لیے بیماری آئے، کوئی بتائے \"میں بیمار ہو گیا\"، نبی صلی اللہ علیہ وسلم کیا دعا دیتے تھے؟ \"لا باس! کوئی بات نہیں، پھر کیا ہوا؟ طہور إن شاء الله! اچھی طرح پاک ہو جاؤ گے!\" (طہور فعول کے وزن پر، صاف ستھرے ہو جاؤ گے)۔" .

minaret:Segment_SKD2025-0003_0071 a minaret:TranscriptSegment ;
    minaret:endTime 823.82 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0072 ;
    minaret:sequenceIndex 71 ;
    minaret:startTime 813.8 ;
    minaret:text "انشاء اللہ! اگر اللہ نے چاہا تو بیماری کو کیا سمجھیں اپنے لیے خیر کا باعث سمجھیں، ایک نعمت ہوتی ہے جس میں انسان کے گناہوں کا کفارہ ہوتا ہے، درجات کی بلندی ہوتی ہے۔" .

minaret:Segment_SKD2025-0003_0072 a minaret:TranscriptSegment ;
    minaret:endTime 833.9 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0073 ;
    minaret:sequenceIndex 72 ;
    minaret:startTime 823.82 ;
    minaret:text "انسان نہ صرف یہ کہ اللہ کے ساتھ اپنا معاملہ درست करता है, بلکہ بندوں کے ساتھ بھی معاملہ درست करने لگتا ہے, کیونکہ کچھ بندے اس کی ٹیک کیر کرنے لگتے ہیں، اس کے لیے اس کے دل میں سافٹ کارنر پیدا ہو جاتا ہے۔" .

minaret:Segment_SKD2025-0003_0073 a minaret:TranscriptSegment ;
    minaret:endTime 843.86 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0074 ;
    minaret:sequenceIndex 73 ;
    minaret:startTime 833.9 ;
    minaret:text "ہسبنڈ وائف کے درمیان تعلقات میں بعض وقت کھچاؤ ہو جاتا ہے، بیوی بیمار پڑتی ہے، ہسبنڈ کو فکر لگ جاتی ہے بچے کون سنبھالے گا، کیا کرتا ہے؟" .

minaret:Segment_SKD2025-0003_0074 a minaret:TranscriptSegment ;
    minaret:endTime 853.82 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0075 ;
    minaret:sequenceIndex 74 ;
    minaret:startTime 843.86 ;
    minaret:text "وہی جو توجہ نہیں دے رہا تھا اب دوائی لا کے دے رہا ہے، ڈاکٹر کے پاس لے جا رہا ہے وغیرہ وغیرہ، ہو جاتا ہے۔ اب بیوی کو بھی ہوتا ہے میرے شوہر تو بہت ہی اچھے ہیں، میں ایسے ہی اس سے بدگمان رہتی تھی، یہ میری بہت کیر کرتا ہے۔" .

minaret:Segment_SKD2025-0003_0075 a minaret:TranscriptSegment ;
    minaret:endTime 863.7 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0076 ;
    minaret:sequenceIndex 75 ;
    minaret:startTime 853.82 ;
    minaret:text "تو آئی تکلیف، لیکن اس سے نکلی خیر! اسی طرح بیوی شوہر سے ناراض رہتی है \"یہ کچھ نہیں करता, یہ ایسا ویسا\"، پھر جب دیکھती है कि وہ بیمار ہو گیا—" .

minaret:Segment_SKD2025-0003_0076 a minaret:TranscriptSegment ;
    minaret:endTime 873.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0077 ;
    minaret:sequenceIndex 76 ;
    minaret:startTime 863.7 ;
    minaret:text "کیونکہ اللہ نے اس رشتے میں مودت اور رحمت رکھی ہے، اگر مودت نہ بھی ہو ना تو رحمت होती है, الا یہ کہ کسی کی فطرت ہی مسخ ہو گئی ہو، جن کے دل ہی اسٹون بن گئے ہوں تو پھر کچھ ان کا علاج نہیں۔" .

minaret:Segment_SKD2025-0003_0077 a minaret:TranscriptSegment ;
    minaret:endTime 883.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0078 ;
    minaret:sequenceIndex 77 ;
    minaret:startTime 873.74 ;
    minaret:text "لیکن عام لوگ جو چھوٹی موٹی مس انڈرسٹینڈنگ کا شکار رہتے ہیں وہ ختم ہو جاتی ہیں اور تعلقات بہتر ہو جاتے ہیں۔ تو بیماری کے ذریعے اللہ تعالیٰ سے تعلق بھی بہتر ہوتا है اور بندوں سے بھی تعلق بہتر ہوتا ہے۔" .

minaret:Segment_SKD2025-0003_0079 a minaret:TranscriptSegment ;
    minaret:endTime 914.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0080 ;
    minaret:sequenceIndex 79 ;
    minaret:startTime 903.86 ;
    minaret:text "ابو ہریرہ رضی اللہ عنہ سے روایت ਹੈ کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: \"مسلمان کو جو بھی مصیبت، بیماری، رنج و غم، تکلیف اور پریشانی آتی ہے،" .

minaret:Segment_SKD2025-0003_0080 a minaret:TranscriptSegment ;
    minaret:endTime 924.02 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0081 ;
    minaret:sequenceIndex 80 ;
    minaret:startTime 914.06 ;
    minaret:text "یہاں تک کہ اگر اسے کانٹا بھی چبھتا ہے، تو اللہ اس کے بدلے اس کے گناہ دور کر دیتا ہے۔\" یہ صحیح بخاری کی روایت ہے۔" .

minaret:Segment_SKD2025-0003_0081 a minaret:TranscriptSegment ;
    minaret:endTime 934.36 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0082 ;
    minaret:sequenceIndex 81 ;
    minaret:startTime 924.02 ;
    minaret:text "تو اس سے کیا پتہ چلا کہ بیماریاں گناہوں کا کفارہ ہیں! کانٹا بھی چبھتا ہے تو اس کے بدلے گناہ دور ہو جاتے۔" .

minaret:Segment_SKD2025-0003_0082 a minaret:TranscriptSegment ;
    minaret:endTime 954.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0083 ;
    minaret:sequenceIndex 82 ;
    minaret:startTime 934.36 ;
    minaret:text "اسی طرح صحیح مسلم کی روایت है (نیکسٹ): جابر بن عبداللہ رضی اللہ عنہما سے روایت ہے (یہ دونوں باپ بیٹا صحابی ہیں) کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: \"بخار کو برا نہ کہو! بخار کو برا نہ کہو! کیونکہ بخار بنی آدم کے گناہوں کو اس طرح دور کرتا ہے جس طرح بھٹی لوہے کے میل کچیل کو دور کر دیتی ہے۔\"" .

minaret:Segment_SKD2025-0003_0083 a minaret:TranscriptSegment ;
    minaret:endTime 964.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0084 ;
    minaret:sequenceIndex 83 ;
    minaret:startTime 954.3 ;
    minaret:text "ٹھیک ہے؟ تو بیماریاں جسمانی ہوں یا دل سے متعلق ہوں، جس کو بھی لگیں وہ اس کے لیے کیا ہیں؟ گناہوں کا کفارہ!" .

minaret:Segment_SKD2025-0003_0084 a minaret:TranscriptSegment ;
    minaret:endTime 974.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0085 ;
    minaret:sequenceIndex 84 ;
    minaret:startTime 964.3 ;
    minaret:text "یعنی اس کے گناہ مٹنے لگتے ہیں یا ان کے اثرات دور ہوتے ہیں۔ دونوں معنے: گناہ بھی چلے جاتے ہیں اور گناہوں کے جو اثرات زندگی میں ہو رہے ہوتے ہیں وہ بھی ختم ہوتے ہیں۔" .

minaret:Segment_SKD2025-0003_0085 a minaret:TranscriptSegment ;
    minaret:endTime 984.36 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0086 ;
    minaret:sequenceIndex 85 ;
    minaret:startTime 974.38 ;
    minaret:text "گناہوں کے اثرات! گناہوں کے اثرات کیا होते हैं? دوا الشافی کسی نے پڑھی ہے؟ اگر آپ کے پاس یہ کتاب ہے، تو اس میں آپ گناہوں کے اثرات، گناہوں کے نتائج یہ والے چیپٹر ذرا پڑھیں!" .

minaret:Segment_SKD2025-0003_0086 a minaret:TranscriptSegment ;
    minaret:endTime 990.7 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0087 ;
    minaret:sequenceIndex 86 ;
    minaret:startTime 984.36 ;
    minaret:text "ایک کے بعد ایک..." .

minaret:Segment_SKD2025-0003_0087 a minaret:TranscriptSegment ;
    minaret:endTime 1001.58 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0088 ;
    minaret:sequenceIndex 87 ;
    minaret:startTime 991.6 ;
    minaret:text "نقصان کیا کیا ہے گناہ کے؟ نقصان کیا؟ اگر واقعی انسان کو نظر آنے لگے اور اگر انسان کو اتنی عقل آ جائے کہ گناہ کے نتیجے میں کیا چیز سامنے آتی ہے" .

minaret:Segment_SKD2025-0003_0088 a minaret:TranscriptSegment ;
    minaret:endTime 1011.68 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0089 ;
    minaret:sequenceIndex 88 ;
    minaret:startTime 1001.58 ;
    minaret:text "اور اس کی زندگی میں کیا مصیبتیں آئیں ہیں، تو توبہ کر لے! سچی توبہ! کہ \"میں یہ گوارا نہیں کرتا کہ میری زندگی میں یہ مصیبتیں آئیں۔\"" .

minaret:Segment_SKD2025-0003_0089 a minaret:TranscriptSegment ;
    minaret:endTime 1021.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0090 ;
    minaret:sequenceIndex 89 ;
    minaret:startTime 1011.68 ;
    minaret:text "اب بیماری آ گئی، بندہ اللہ کی طرف راغب ہو گیا، اللہ کو پکارنے لگا، دعائیں مانگنے لگا، استغفار کرنے لگا، اب نتیجہ کیا ہوگا؟ وہ توبہ کیا کرتی ہے؟ گناہوں کو مٹاتی ہے اور" .

minaret:Segment_SKD2025-0003_0090 a minaret:TranscriptSegment ;
    minaret:endTime 1035.68 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0091 ;
    minaret:sequenceIndex 90 ;
    minaret:startTime 1021.62 ;
    minaret:text "اس کے جو نقصان ہیں ان سے بھی آئندہ کے لیے بچاتی ہے۔ تو پھر اسی طرح آپ دیکھیں کہ انسان گناہوں کی وجہ سے سزا کا مستحق ہوتا है, تو وہ اس سزا سے نکل آتا ہے۔ حسن بصری کہتے ہیں:" .

minaret:Segment_SKD2025-0003_0091 a minaret:TranscriptSegment ;
    minaret:endTime 1041.42 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0092 ;
    minaret:sequenceIndex 91 ;
    minaret:startTime 1036.42 ;
    minaret:text "\"خبردار! اللہ کی قسم! بیماریوں اور تکالیف کے دن مسلمان کے برے دن نہیں ہیں!\" یاد رہے گا؟" .

minaret:Segment_SKD2025-0003_0092 a minaret:TranscriptSegment ;
    minaret:endTime 1051.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0093 ;
    minaret:sequenceIndex 92 ;
    minaret:startTime 1041.96 ;
    minaret:text "بیماریوں اور تکلیفوں کے دن مسلمان کے لیے برے دن نہیں ہیں، ان میں اس کو یاد دہانی کروائی جاتی ہے وہ جو آخرت کے معاملات میں سے بھول جاتا ہے،" .

minaret:Segment_SKD2025-0003_0093 a minaret:TranscriptSegment ;
    minaret:endTime 1061.42 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0094 ;
    minaret:sequenceIndex 93 ;
    minaret:startTime 1051.98 ;
    minaret:text "اور ان کی وجہ سے اس کے گناہ مٹا دیے جاتے ہیں۔ اب آپ سوچ رہے ہوں گے کہ یہ باتیں آپ اچھا تھا کتاب میں لکھ دیتی ہیں اور ہم وہیں سے پڑھ لیتے، کیوں نہیں لکھیں؟" .

minaret:Segment_SKD2025-0003_0094 a minaret:TranscriptSegment ;
    minaret:endTime 1068.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0095 ;
    minaret:sequenceIndex 94 ;
    minaret:startTime 1062.0 ;
    minaret:text "کتاب بڑی ہو جاتی اور مریض اٹھا نہ سکتا! یہ سب سے بڑی ریسٹرکشن تھی۔ دل تو بہت کچھ چاہتا تھا، بھر دو اس کو!" .

minaret:Segment_SKD2025-0003_0095 a minaret:TranscriptSegment ;
    minaret:endTime 1089.2 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0096 ;
    minaret:sequenceIndex 95 ;
    minaret:startTime 1077.12 ;
    minaret:text "چھوٹی سے بھی بیماری ہوتی ہے، سب سے پہلے کیا یاد آئے گا؟ موت یاد آتی ہے۔ بخار چڑھ گیا، پتہ نہیں یہ اترے گا کہ نہیں، کہیں میں ماری نہ جاؤں اس میں! اب جونہی موت کا خیال آتا ہے تو اگلا خیال کیا آتا है?" .

minaret:Segment_SKD2025-0003_0096 a minaret:TranscriptSegment ;
    minaret:endTime 1100.24 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0097 ;
    minaret:sequenceIndex 96 ;
    minaret:startTime 1090.2 ;
    minaret:text "استغفار! دعائیں! اللہ کی طرف رجوع! اچھا وہ میں نے کئی دن سے صدقہ نہیں کیا تھا، صدقہ کرو۔ اچھا وہ میں نے فلاں کو تکلیف دی تھی اس سے معافی مانگ لو۔" .

minaret:Segment_SKD2025-0003_0097 a minaret:TranscriptSegment ;
    minaret:endTime 1110.2 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0098 ;
    minaret:sequenceIndex 97 ;
    minaret:startTime 1100.24 ;
    minaret:text "ابھی تو میں نے حج بھی نہیں کیا اس سال تو بس اب میں حج کر لوں گا، اور میرے تو قضا روزے بھی رمضان کے بھی رہتے ہیں، میں نے تو کچھ نمازیں بھی چھوڑی ہوئی ہیں۔ اب یہ ساری آندھی" .

minaret:Segment_SKD2025-0003_0098 a minaret:TranscriptSegment ;
    minaret:endTime 1120.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0099 ;
    minaret:sequenceIndex 98 ;
    minaret:startTime 1110.2 ;
    minaret:text "چلنے لگتی ہے اندر ہی اندر، جو ویسے تو کسی صورت آپ کو یاد نہیں آنی تھی کیونکہ آپ کی زندگی اتنی مصروف ہے کہ آپ کو اپنی موت یاد نہیں رہتی، آخرت یاد نہیں رہتی؛ لہٰذا" .

minaret:Segment_SKD2025-0003_0099 a minaret:TranscriptSegment ;
    minaret:endTime 1130.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0100 ;
    minaret:sequenceIndex 99 ;
    minaret:startTime 1120.32 ;
    minaret:text "اللہ تعالیٰ آپ کو بریک لگاتے ہیں: \"رکو یہاں ذرا! پڑھو بیمار اور لیٹو بستر پہ، چلو ہسپتال!\" اور وہاں جا کے سوچو زندگی میں کیا نہیں کیا اور کیا کرنا چاہیے۔" .

minaret:Segment_SKD2025-0003_0100 a minaret:TranscriptSegment ;
    minaret:endTime 1136.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0101 ;
    minaret:sequenceIndex 100 ;
    minaret:startTime 1130.32 ;
    minaret:text "پھر انسان ہوش میں آ جاتا ہے، تو بیماری کیا ہو گئی ہمارے لیے؟ خیر کا باعث ہو گئی!" .

minaret:Segment_SKD2025-0003_0101 a minaret:TranscriptSegment ;
    minaret:endTime 1147.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0102 ;
    minaret:sequenceIndex 101 ;
    minaret:startTime 1137.44 ;
    minaret:text "سمجھ آ گئی کہ نہیں؟ یہ کانسیپٹ سمجھنا ضروری ہے۔ ہم نے یہ تو کہا نا کہ بیماری اللہ کی طرف سے آتی ہے، تو کیا نعوذ باللہ اللہ تعالیٰ ظالم ہیں جو بیمار کر دیتے ہیں؟ نہیں، وہ ہمیں سبق" .

minaret:Segment_SKD2025-0003_0102 a minaret:TranscriptSegment ;
    minaret:endTime 1157.6 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0103 ;
    minaret:sequenceIndex 102 ;
    minaret:startTime 1147.5 ;
    minaret:text "سکھانا چاہتے ہیں جو ہم کتابوں سے نہیں سیکھ رہے، پھر وہ بیمار ہو کے سیکھتے ہیں۔ تو مسلمان کے لیے تکلیف کا آنا بھی ایک نعمت ہے! ابنِ تیمیہ رحمہ اللہ کہتے ہیں:" .

minaret:Segment_SKD2025-0003_0103 a minaret:TranscriptSegment ;
    minaret:endTime 1167.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0104 ;
    minaret:sequenceIndex 103 ;
    minaret:startTime 1157.6 ;
    minaret:text "\"اللہ کی اپنے مومن بندوں پر کامل نعمت میں سے ہے کہ ان پر وہ سختیاں اور تکلیفیں واقع ہوتی ہیں جو ان کو اللہ کی توحید کی طرف مجبور کر دیتی ہیں،" .

minaret:Segment_SKD2025-0003_0104 a minaret:TranscriptSegment ;
    minaret:endTime 1177.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0105 ;
    minaret:sequenceIndex 104 ;
    minaret:startTime 1167.56 ;
    minaret:text "وہ ایک اکیلے اللہ کی طرف متوجہ کر دیتی ہیں۔ پس وہ اخلاص کے ساتھ اللہ کے لیے عبادت کرتے ہوئے اسی سے دعائیں مانگتے ہیں، اور ان کے دل کسی اور کے ساتھ نہیں بلکہ" .

minaret:Segment_SKD2025-0003_0105 a minaret:TranscriptSegment ;
    minaret:endTime 1187.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0106 ;
    minaret:sequenceIndex 105 ;
    minaret:startTime 1177.56 ;
    minaret:text "صرف اللہ سے جڑ جاتے ہیں، تو ان کے لیے اللہ پر توکل اور اس کی بارگاہ کی طرف انابت حاصل ہوتی ہے، جو کہ ان پر سب سے بڑی نعمت ہے اس بات سے کہ ان کی بیماری دور" .

minaret:Segment_SKD2025-0003_0106 a minaret:TranscriptSegment ;
    minaret:endTime 1197.68 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0107 ;
    minaret:sequenceIndex 106 ;
    minaret:startTime 1187.54 ;
    minaret:text "ہو جائے یا ان کو آسانی حاصل ہو جائے۔\" اس موقع پر صحت یاب ہونا اتنی بڑی نعمت نہیں جتنا بیمار ہونا نعمت है! اس کا یہ مطلب है بیماری مانگیں؟ کیا خیال ہے؟ نہیں!" .

minaret:Segment_SKD2025-0003_0107 a minaret:TranscriptSegment ;
    minaret:endTime 1207.66 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0108 ;
    minaret:sequenceIndex 107 ;
    minaret:startTime 1197.68 ;
    minaret:text "بیماری کبھی نہ مانگیں، کیوں اس لیے کہ اللہ تعالیٰ کو بندے کے لیے کیا پسند है کہ وہ کیا مانگے؟ عافیت کی دعا مانگے! اللہ ہمیں عافیت میں رکھے" .

minaret:Segment_SKD2025-0003_0108 a minaret:TranscriptSegment ;
    minaret:endTime 1217.68 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0109 ;
    minaret:sequenceIndex 108 ;
    minaret:startTime 1207.66 ;
    minaret:text "اور بغیر کسی آزمائش میں ڈالے ہی ہماری غلطیاں ہمیں دکھا دے اور ہماری اصلاح فرما دے۔ لیکن اگر بیماری کے ذریعے اللہ تعالیٰ اصلاح کرے—کیونکہ اللہ تو زیادہ بہتر جانتا ہے اس کی حکمت اور مصلحت تو وہ" .

minaret:Segment_SKD2025-0003_0109 a minaret:TranscriptSegment ;
    minaret:endTime 1227.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0110 ;
    minaret:sequenceIndex 109 ;
    minaret:startTime 1217.68 ;
    minaret:text "جانتا ہے کہ اس کو کہاں سے سبق سکھانا ہے—مختلف لوگ مختلف طریقوں سے سبق سیکھتے ہیں نا، کوئی غلطیوں سے سیکھتا ہے، کوئی گناہوں سے سیکھتا ہے، کوئی بیماریوں سے" .

minaret:Segment_SKD2025-0003_0110 a minaret:TranscriptSegment ;
    minaret:endTime 1237.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0111 ;
    minaret:sequenceIndex 110 ;
    minaret:startTime 1227.54 ;
    minaret:text "سیکھتا ہے، بس سیکھنے والی نگاہ ہونی چاہیے، ٹھیک ہے؟ ابنِ قیم کہتے ہیں:" .

minaret:Segment_SKD2025-0003_0111 a minaret:TranscriptSegment ;
    minaret:endTime 1247.12 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0112 ;
    minaret:sequenceIndex 111 ;
    minaret:startTime 1237.3 ;
    minaret:text "\"بہت سی تکالیف صحت اور تندرستی کے اسباب ہوتی ہیں، اگر وہ تکلیفیں نہ ہوں تو صحت کے اسباب کھو جائیں، اور یہ جسموں کی بڑی بیماریوں کا حال ہے!" .

minaret:Segment_SKD2025-0003_0112 a minaret:TranscriptSegment ;
    minaret:endTime 1257.2 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0113 ;
    minaret:sequenceIndex 112 ;
    minaret:startTime 1247.12 ;
    minaret:text "بس اس بخار میں جسموں کے وہ فوائد ہیں جو ان کو اللہ کے سوا کوئی نہیں جانتا، اور ان بیماریوں سے فضلات یعنی ٹاکسنز پگھلا دیے جاتے ہیں،" .

minaret:Segment_SKD2025-0003_0113 a minaret:TranscriptSegment ;
    minaret:endTime 1267.14 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0114 ;
    minaret:sequenceIndex 113 ;
    minaret:startTime 1257.2 ;
    minaret:text "خام مواد کو پکا دیا جاتا ہے، نکال دیا جاتا ہے—یعنی جو فالتو چیزیں چربیاں وغیرہ چڑھی ہوتی ہیں نا جسم پر، یعنی جس کی ضرورت نہیں ہوتی ہمیں، پتلے بھی ہو جاتے ہیں پھر ہم—" .

minaret:Segment_SKD2025-0003_0114 a minaret:TranscriptSegment ;
    minaret:endTime 1277.9 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0115 ;
    minaret:sequenceIndex 114 ;
    minaret:startTime 1267.14 ;
    minaret:text "اور یہ کام کسی دوائی سے نہیں ہو سکتا۔ اور بہت سی بیماریاں ایسی ہوتی ہیں کہ جب اس آدمی کو بخار لاحق ہو جاتا है, تو ڈاکٹر اس بخار پر خوش ہوتا ہے کہ \"چلو اب یہ صحت کی طرف جائے گا!\"" .

minaret:Segment_SKD2025-0003_0115 a minaret:TranscriptSegment ;
    minaret:endTime 1288.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0116 ;
    minaret:sequenceIndex 115 ;
    minaret:startTime 1277.9 ;
    minaret:text "تو بہرحال، عقل مند ہی ان باتوں سے فائدہ اٹھاتے ہیں، عبرت حاصل करते हैं, نصیحت حاصل کرتے ہیں، اور آئندہ مستقبل میں ان چیزوں سے بچنے کی کوشش کرتے ہیں جو سبب بنی اس مصیبت کے لانے کا۔" .

minaret:Segment_SKD2025-0003_0116 a minaret:TranscriptSegment ;
    minaret:endTime 1296.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0117 ;
    minaret:sequenceIndex 116 ;
    minaret:startTime 1288.32 ;
    minaret:text "اچھا، ایک اور خوشخبری یہ ہے مومن کے لیے کہ جب وہ بیمار ہوتا ہے اور اس کے وہ اعمالِ یومیہ رک جاتے ہیں، نہیں کر پاتا،" .

minaret:Segment_SKD2025-0003_0117 a minaret:TranscriptSegment ;
    minaret:endTime 1307.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0118 ;
    minaret:sequenceIndex 117 ;
    minaret:startTime 1297.56 ;
    minaret:text "تو پھر کیا ہوتا ہے؟ سب لکھ دیے جاتے हैं! تو اس لیے خسارہ نہیں ہے، لیکن اس کے لیے آپ کو اچھی اچھی عادتوں پر پابندی ضروری ہے جو پابندی اختیار करता है ना," .

minaret:Segment_SKD2025-0003_0118 a minaret:TranscriptSegment ;
    minaret:endTime 1317.48 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0119 ;
    minaret:sequenceIndex 118 ;
    minaret:startTime 1307.4 ;
    minaret:text "مثلاً صبح شام کے اذکار کی—اب وہ بے ہوش پڑا ہے، اس کو ہوش ہی نہیں اور صبح شام کے اذکار کا وقت نکل رہا ہے—فرشتے اس کے اعمال نامے میں خود سے ہی لکھ دیں گے کہ یہ روز پڑھتا تھا، پابندی سے پڑھتا تھا، قرآن پڑھتا تھا، فجر کی نماز پڑھتا تھا، سبواب!" .

minaret:Segment_SKD2025-0003_0119 a minaret:TranscriptSegment ;
    minaret:endTime 1327.48 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0120 ;
    minaret:sequenceIndex 119 ;
    minaret:startTime 1317.48 ;
    minaret:text "ایسی اجرت کوئی دیتا ہے کہ آپ کام پر نہ جائیں اور تنخواہ آپ کے گھر پہنچتی رہے؟ یہ مہربانی صرف اللہ سبحانہ وتعالیٰ کرتا ہے کہ بندہ کام نہ بھی کرے تو اس کی جو سابقہ حسنات ہوتی ہیں،" .

minaret:Segment_SKD2025-0003_0120 a minaret:TranscriptSegment ;
    minaret:endTime 1340.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0121 ;
    minaret:sequenceIndex 120 ;
    minaret:startTime 1327.48 ;
    minaret:text "ان کو سامنے رکھ کر اس کے ساتھ بھلائی کا معاملہ کیا جاتا ہے۔ پیج نمبر 6، تکلیف آنے پر یہ دعا مانگیں:" .

minaret:Segment_SKD2025-0003_0122 a minaret:TranscriptSegment ;
    minaret:endTime 1369.48 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0123 ;
    minaret:sequenceIndex 122 ;
    minaret:startTime 1367.92 ;
    minaret:text "آپ سب پڑھیں دیکھ کے اس کو۔" .

minaret:Segment_SKD2025-0003_0123 a minaret:TranscriptSegment ;
    minaret:endTime 1419.26 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0124 ;
    minaret:sequenceIndex 123 ;
    minaret:startTime 1389.52 ;
    minaret:text "جزاک اللہ خیر۔ ام سلمہ رضی اللہ عنہا روایت करती हैं, کہتی हैं मैंने رسول اللہ صلی اللہ علیہ وسلم کو فرماتے ہوئے سنا: \"کوئی مسلمان نہیں جسے مصیبت پہنچے اور وہ وہی کچھ کہے جس کا اللہ نے اسے حکم دیا ہے: 'یقیناً ہم اللہ کے ہیں اور اسی کی طرف لوٹنے والے ہیں، اے اللہ! مجھے میری مصیبت پر اجر عطا فرما اور مجھے اس کا اس سے بہتر بدل عطا فرما'، مگر اللہ تعالیٰ اسے اس کا بہتر بدل عطا فرما دیتا ہے۔\"" .

minaret:Segment_SKD2025-0003_0124 a minaret:TranscriptSegment ;
    minaret:endTime 1429.12 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0125 ;
    minaret:sequenceIndex 124 ;
    minaret:startTime 1419.26 ;
    minaret:text "اب وہ اپنا واقعہ بتاتی ہیں کہ میرے شوہر ابو سلمہ فوت ہو گئے تو میں نے دل میں سوچا: کون سا مسلمان ابو سلمہ سے بہتر ہوگا؟ وہ پہلا گھرانہ ہے جس نے رسول اللہ صلی اللہ علیہ وسلم کی طرف ہجرت کی—" .

minaret:Segment_SKD2025-0003_0125 a minaret:TranscriptSegment ;
    minaret:endTime 1439.08 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0126 ;
    minaret:sequenceIndex 125 ;
    minaret:startTime 1429.12 ;
    minaret:text "یعنی اتنا زیادہ احکام پر عمل کرنے والے تھے؛ لیکن میں نے وہی کلمات کہے جو حکم دیا گیا تھا، تو اللہ تعالیٰ نے مجھے رسول اللہ صلی اللہ علیہ وسلم کی صورت میں اس کا بدل عطا فرما دیا!" .

minaret:Segment_SKD2025-0003_0126 a minaret:TranscriptSegment ;
    minaret:endTime 1449.08 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0127 ;
    minaret:sequenceIndex 126 ;
    minaret:startTime 1439.08 ;
    minaret:text "پھر ام سلمہ کی شادی حضور صلی اللہ علیہ وسلم سے ہو گئی۔ تو بعض وقت انسان کے وہم و گمان میں بھی نہیں ہوتا، لیکن اللہ پہ یقین ہوتا ہے: اگر اللہ کی طرف سے علم میرے لیے آیا نا، اور میں اس پر عمل کروں، تو اس میں یقیناً خیر ہوگی۔" .

minaret:Segment_SKD2025-0003_0127 a minaret:TranscriptSegment ;
    minaret:endTime 1466.6 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0128 ;
    minaret:sequenceIndex 127 ;
    minaret:startTime 1449.08 ;
    minaret:text "میرے رب نے فرمایا نا، بس کر لیتے ہیں، دیکھیں کچھ نہیں ہوتا، جیسے کہا ہے نا ایسے ہی ہوگا! حسنِ ظن! ٹھیک ہے؟ اچھا، ہم یہ دعا کب پڑھتے ہیں؟ جب کوئی فوت ہو جاتا ہے، کیونکہ وہ سب سے بڑی مصیبت ہے، اس کے بعد تو واپس نہیں آنا؛" .

minaret:Segment_SKD2025-0003_0128 a minaret:TranscriptSegment ;
    minaret:endTime 1477.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0129 ;
    minaret:sequenceIndex 128 ;
    minaret:startTime 1468.68 ;
    minaret:text "لیکن اس کے علاوہ بھی الحمدللہ اب اتنی اوئرنس ہو گئی ہے، لوگ لائٹ جاتی ہے تو سارے کچھ ٹوٹ جاتا ہے تو اِنَّا لِلَّهِ پڑھتے ہیں، چوٹ لگ جاتی ہے تو اِنَّا لِلَّهِ پڑھتے ہیں۔" .

minaret:Segment_SKD2025-0003_0129 a minaret:TranscriptSegment ;
    minaret:endTime 1487.94 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0130 ;
    minaret:sequenceIndex 129 ;
    minaret:startTime 1478.04 ;
    minaret:text "الحمدللہ! یہ دعا ہمارے عادات میں شامل ہو گئی ہے، لیکن یہ ہر مصیبت پر پڑھی جا सकती है, ہر تکلیف پر، سمیت بیماری کے۔" .

minaret:Segment_SKD2025-0003_0130 a minaret:TranscriptSegment ;
    minaret:endTime 1507.82 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0131 ;
    minaret:sequenceIndex 130 ;
    minaret:startTime 1487.94 ;
    minaret:text "اور مریض کو تو جونہی اس کے ڈائیگنوسس ہوں، جونہی اس کی بلڈ رپورٹ آ جائے، جونہی ڈاکٹر کی طرف سے بیماری کی خبر آ جائے—کیونکہ بعض اوقات انسان تھکاوٹ فیل کرتا تو کہتے ہیں چلو میں ٹیسٹ کروا لوں، تو جونہی ٹیسٹ کروا لو تو خوفناک بیماری نکل آتی ہے—اس کو سننا، اس کو جاننا بڑے حوصلے کا کام ہوتا ہے۔" .

minaret:Segment_SKD2025-0003_0131 a minaret:TranscriptSegment ;
    minaret:endTime 1517.92 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0132 ;
    minaret:sequenceIndex 131 ;
    minaret:startTime 1507.82 ;
    minaret:text "اس وقت دو میں سے ایک رسپانس होता है हमारा, یا ہم اِنَّا لِلَّهِ پڑھ لیتے ہیں، الحمدللہ کہہ دیتے ہیں (الحمدللہ علیٰ كل حال)، اور یا پھر ہم سخت پریشان ہو کے..." .

minaret:Segment_SKD2025-0003_0132 a minaret:TranscriptSegment ;
    minaret:endTime 1533.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0133 ;
    minaret:sequenceIndex 132 ;
    minaret:startTime 1518.58 ;
    minaret:text "\"اس کو کون! اس کو کون! یہ ہو गया میرے ساتھ! اور اب پتہ نہیں کیا ہوگا!\"—خاص طور پر جو بڑی ڈینجرس بیماریاں ہیں، آپ کے عزیزوں میں سے کسی کو کینسر ہونے کی خبر ملی، کیا ری ایکشن تھا ان کا؟ کچھ یاد ہے؟ جوہی پتہ چلا تو کیا ہوا؟" .

minaret:Segment_SKD2025-0003_0133 a minaret:TranscriptSegment ;
    minaret:endTime 1539.6 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0134 ;
    minaret:sequenceIndex 133 ;
    minaret:startTime 1534.22 ;
    minaret:text "استاذہ! میرے فادر کا فرسٹ سٹیج کا لیور کینسر ڈائیگنوز ہوا تھا..." .

minaret:Segment_SKD2025-0003_0134 a minaret:TranscriptSegment ;
    minaret:endTime 1549.02 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0135 ;
    minaret:sequenceIndex 134 ;
    minaret:startTime 1540.7 ;
    minaret:text "हमारे लिए एक बिलकुल नई चीज़ थी, ऐसे लगता है जैसे बस सिर्फ डिसअपॉइंटमेंट है।" .

minaret:Segment_SKD2025-0003_0135 a minaret:TranscriptSegment ;
    minaret:endTime 1558.7 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0136 ;
    minaret:sequenceIndex 135 ;
    minaret:startTime 1549.8 ;
    minaret:text "الحمدللہ! ہو گیا، میرے بھائی نے ٹرانسپلانٹ کیا اللہ کے فضل سے، لیکن اس ٹائم پہ الحمدللہ اتنی اوئرنس تھی کہ یہ دعا پڑھی تھی، الحمدللہ! ماشاء اللہ دونوں ٹھیک ہیں، اللہ کے فضل سے।" .

minaret:Segment_SKD2025-0003_0136 a minaret:TranscriptSegment ;
    minaret:endTime 1567.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0137 ;
    minaret:sequenceIndex 136 ;
    minaret:startTime 1560.32 ;
    minaret:text "الحمدللہ! کیونکہ صدمے کی پہلی چوٹ، پہلی دفعہ جب آپ کو خبر ملی، اس وقت آپ نے یہ پڑھنا ہے!" .

minaret:Segment_SKD2025-0003_0137 a minaret:TranscriptSegment ;
    minaret:endTime 1576.26 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0138 ;
    minaret:sequenceIndex 137 ;
    minaret:startTime 1568.32 ;
    minaret:text "(یعنی کہ ساری باتیں کر کے \"ہائے! ہائے! یہ کیا ہو گیا!\") رونا شروع کر دیں، اور پہلا خیال کس کا آیا؟ موت! اب تو نہیں بچنا!" .

minaret:Segment_SKD2025-0003_0138 a minaret:TranscriptSegment ;
    minaret:endTime 1586.68 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0139 ;
    minaret:sequenceIndex 138 ;
    minaret:startTime 1576.82 ;
    minaret:text "خوفناک بیماری ہے، اس میں زیادہ سروائیول نہیں ہوتا، خاص طور پر اگر ایڈوانس سٹیج پر پہنچ جائے۔ لیکن اس میں بھی کئی لوگوں کا فورتھ گریڈ میں بھی ریورس ہوا ہے، کیوں؟" .

minaret:Segment_SKD2025-0003_0139 a minaret:TranscriptSegment ;
    minaret:endTime 1601.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0140 ;
    minaret:sequenceIndex 139 ;
    minaret:startTime 1586.68 ;
    minaret:text "صرف علاج سے نہیں، پوزیٹیو تھنکنگ سے! \"میں ٹھیک ہو جاؤں گا، میں ٹھیک ہو جاؤں گی، اللہ خیر کرے گا، سب اچھا ہوگا!\" تو اللہ سے اچھا گمان رکھنا، زبان سے اچھے الفاظ نکالنا۔" .

minaret:Segment_SKD2025-0003_0140 a minaret:TranscriptSegment ;
    minaret:endTime 1612.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0141 ;
    minaret:sequenceIndex 140 ;
    minaret:startTime 1602.14 ;
    minaret:text "زبان سے اچھے الفاظ نکالنے ہیں آپ نے! اور ان سے اچھے الفاظ کون سے ہو سکتے ہیں؟ تو سب سے پہلے اللہ کی طرف رجوع، یہ دعا پڑھنی ہے، اللہ پہ توکل کرنا ہے،" .

minaret:Segment_SKD2025-0003_0141 a minaret:TranscriptSegment ;
    minaret:endTime 1621.94 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0142 ;
    minaret:sequenceIndex 141 ;
    minaret:startTime 1612.0 ;
    minaret:text "یاد رکھنا ہے کہ اللہ ہی الشافی ہے، وہ شفا دے سکتا ہے، وہ ہر چیز پہ قادر ہے؛ پھر دعا کرنی ہے: اَللّٰهُمَّ اشْفِنِیْ شِفَآءً لَّا یُغَادِرُ سَقَمًا،" .

minaret:Segment_SKD2025-0003_0143 a minaret:TranscriptSegment ;
    minaret:endTime 1642.12 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0144 ;
    minaret:sequenceIndex 143 ;
    minaret:startTime 1631.82 ;
    minaret:text "مایوس نہیں ہونا۔ مایوسی گناہ ہے! پھر بیماری کے بارے میں صحیح علم حاصل करना है کہ یہ بیماری ہے کیا اور اس کا علاج کیا होता है, اس کا مرحلہ کیا ہے،" .

minaret:Segment_SKD2025-0003_0144 a minaret:TranscriptSegment ;
    minaret:endTime 1651.94 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0145 ;
    minaret:sequenceIndex 144 ;
    minaret:startTime 1642.12 ;
    minaret:text "कहां पर पहुंची हुई है? ڈاکٹر سے پوچھیں، سیکنڈ اوپینین لیں، گھبرائیں نہیں، اور ساتھ ساتھ اللہ سبحانہ وتعالیٰ سے اچھی امید رکھیں کہ سب ٹھیک ہو جائے گا۔" .

minaret:Segment_SKD2025-0003_0145 a minaret:TranscriptSegment ;
    minaret:endTime 1661.9 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0146 ;
    minaret:sequenceIndex 145 ;
    minaret:startTime 1651.94 ;
    minaret:text "علاج کی طرف قدم بڑھائیں، دعا سے کام لیں، اور اس کے ساتھ ساتھ دعا کی طرف بھی جائیں۔ اور اگر دوا افورڈ نہیں کر سکتے..." .

minaret:Segment_SKD2025-0003_0146 a minaret:TranscriptSegment ;
    minaret:endTime 1671.82 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0147 ;
    minaret:sequenceIndex 146 ;
    minaret:startTime 1661.9 ;
    minaret:text "کچھ لوگ—آپ کو پتہ ہے نا کہ کئی کئی لاکھ کے ایک انجیکشن ہوتے ہیں بعض اوقات—نہیں افورڈ کر سکتے غریب لوگ جن کو کھانے کا نہیں ملتا، آپ کا کیا خیال ہے ایسے مہنگے علاج کروا سکتے ہیں؟" .

minaret:Segment_SKD2025-0003_0147 a minaret:TranscriptSegment ;
    minaret:endTime 1680.36 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0148 ;
    minaret:sequenceIndex 147 ;
    minaret:startTime 1671.82 ;
    minaret:text "لیکن اللہ تو رب ہے نا سب کا! اگر کوئی دوائی نہیں لے سکتا تو دعائیں تو بہت ہیں، سب کچھ چینج ہو سکتا ہے!" .

minaret:Segment_SKD2025-0003_0148 a minaret:TranscriptSegment ;
    minaret:endTime 1690.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0149 ;
    minaret:sequenceIndex 148 ;
    minaret:startTime 1680.9 ;
    minaret:text "لہٰذا مثبت رویہ اختیار کریں، روزانہ شکر گزاری کی مشق کریں، زندگی کی نعمتوں کو یاد کریں، ان کو محسوس کریں کہ اللہ نے اتنا کچھ دیا بھی تو ہے!" .

minaret:Segment_SKD2025-0003_0149 a minaret:TranscriptSegment ;
    minaret:endTime 1700.94 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0150 ;
    minaret:sequenceIndex 149 ;
    minaret:startTime 1690.98 ;
    minaret:text "\"میں نے اتنا انجوائے کر لیا، ادھر جسٹ ان کیس میری قسمت میں آگے جانا لکھا ہے تو کوئی بات نہیں، میں نے زندگی میں بہت کچھ کر لیا۔" .

minaret:Segment_SKD2025-0003_0150 a minaret:TranscriptSegment ;
    minaret:endTime 1710.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0151 ;
    minaret:sequenceIndex 150 ;
    minaret:startTime 1700.94 ;
    minaret:text "کئی لوگ ہیں جو پیدا ہوتے ہی فوت ہو جاتے ہیں، کچھ ماں کے پیٹ میں فوت ہو جاتے ہیں، کچھ بچپن میں فوت ہو جاتے ہیں، کوئی عین جوانی میں فوت ہو جاتے ہیں۔ اللہ نے مجھے اتنی عمر دی ہے تو مجھے اس پر شکر ادا کرنا ہے، مجھے اللہ سے کوئی گلہ شکوہ نہیں۔\"" .

minaret:Segment_SKD2025-0003_0151 a minaret:TranscriptSegment ;
    minaret:endTime 1721.2 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0152 ;
    minaret:sequenceIndex 151 ;
    minaret:startTime 1711.1 ;
    minaret:text "نعمتوں کو گننا شروع کر دیں: \"میرے پاس یہ بھی ہے، یہ بھی ہے، یہ بھی ہے!\" اور اس بیماری کو ایک چیلنج کے طور پر قبول کریں کہ میں نے اس سے نکلنا ہے، انشاء اللہ!" .

minaret:Segment_SKD2025-0003_0152 a minaret:TranscriptSegment ;
    minaret:endTime 1731.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0153 ;
    minaret:sequenceIndex 152 ;
    minaret:startTime 1721.2 ;
    minaret:text "پھر اسی طرح یہ ہے کہ اپنے پیاروں کے ساتھ اپنی بیماری آپ شیئر کر کے ان کو ساتھ لے سکتے ہیں تاکہ آپ کے علاج میں آپ کے مددگار ہوں، اس سے انسان کو کافی سپورٹ ہوتی ہے۔" .

minaret:Segment_SKD2025-0003_0153 a minaret:TranscriptSegment ;
    minaret:endTime 1741.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0154 ;
    minaret:sequenceIndex 153 ;
    minaret:startTime 1731.04 ;
    minaret:text "وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ—صبر کرنے کے لیے کوئی اور بھی ہونا چاہیے! انسان بعض اوقات اکیلا اپنی سوچوں میں غلطاں ہو کر ہمت ہار دیتا ہے؛" .

minaret:Segment_SKD2025-0003_0154 a minaret:TranscriptSegment ;
    minaret:endTime 1751.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0155 ;
    minaret:sequenceIndex 154 ;
    minaret:startTime 1741.0 ;
    minaret:text "لیکن کس سے بچنا ہے؟ نیگیٹو رسپانس سے! کیونکہ اس سے انسان کے اندر مایوسی آتی ہے، غصہ آتا ہے، بیزاری آتی ہے، تعلقات خراب ہوتے ہیں، اور پھر انسان بعض اوقات" .

minaret:Segment_SKD2025-0003_0155 a minaret:TranscriptSegment ;
    minaret:endTime 1767.2 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0156 ;
    minaret:sequenceIndex 155 ;
    minaret:startTime 1757.58 ;
    minaret:text "خود کو الگ کر لیتا ہے یا دوسروں پر بوجھ سمجھتا ہے—یہ سارے نیگیٹو رویے ہوتے ہیں، نیگیٹو بیہویئرز ہوتے ہیں، اس سے آپ نے بچنا ہے، ٹھیک ہے؟ اور کیا پڑھنا ہے؟" .

minaret:Segment_SKD2025-0003_0156 a minaret:TranscriptSegment ;
    minaret:endTime 1774.12 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0157 ;
    minaret:sequenceIndex 156 ;
    minaret:startTime 1767.2 ;
    minaret:text "اِنَّا لِلَّهِ! اچھا، یہ آپ دیکھیں اِنَّا لِلَّهِ—بندہ کیا کر رہا ہے اس میں؟ اپنے آپ کو" .

minaret:Segment_SKD2025-0003_0157 a minaret:TranscriptSegment ;
    minaret:endTime 1785.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0158 ;
    minaret:sequenceIndex 157 ;
    minaret:startTime 1775.36 ;
    minaret:text "اللہ کے سپرد کر رہا ہے کہ میرا مالک وہ ہے، میں اس کو مانتا ہوں کہ اللہ کے پاس سے میں آیا ہوں، وہی میرا خالق مالک ہے، ہم اسی کی ملکیت ہیں!" .

minaret:Segment_SKD2025-0003_0158 a minaret:TranscriptSegment ;
    minaret:endTime 1792.1 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0159 ;
    minaret:sequenceIndex 158 ;
    minaret:startTime 1785.38 ;
    minaret:text "وہ ہمارے ساتھ جو چاہے کر سکتا ہے۔ مثلاً آپ کی ملکیت میں کوئی چیز ہے، مثلاً کیا چیز؟ موبائل! ٹھیک ہے؟" .

minaret:Segment_SKD2025-0003_0159 a minaret:TranscriptSegment ;
    minaret:endTime 1800.64 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0160 ;
    minaret:sequenceIndex 159 ;
    minaret:startTime 1793.36 ;
    minaret:text "آپ اس کے ساتھ لوگوں کی مرضی کے مطابق چلتے ہیں یا اپنی؟ اپنی! کیوں؟" .

minaret:Segment_SKD2025-0003_0160 a minaret:TranscriptSegment ;
    minaret:endTime 1810.94 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0161 ;
    minaret:sequenceIndex 160 ;
    minaret:startTime 1801.74 ;
    minaret:text "\"میرا موبائل ہے، میں جو چاہوں کروں! چاہے تو آف کر دوں، چاہے تو استعمال کر لوں، چاہے تو رکھ دوں کہیں، چاہے تو بیچ دوں، چاہے کچھ بھی کروں!\" کر سکتے ہیں؟ کیوں؟" .

minaret:Segment_SKD2025-0003_0161 a minaret:TranscriptSegment ;
    minaret:endTime 1823.96 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0162 ;
    minaret:sequenceIndex 161 ;
    minaret:startTime 1813.84 ;
    minaret:text "تو ہم کس کے ہیں؟ اللہ کے! اِنَّا لِلَّهِ، ہم اللہ کے ہیں۔ لہٰذا جب ہم اللہ کے ہیں تو ہم پر اللہ کا جو بھی حکم، جو بھی فیصلہ آ رہا ہے وہ بالکل درست ہے،" .

minaret:Segment_SKD2025-0003_0162 a minaret:TranscriptSegment ;
    minaret:endTime 1834.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0163 ;
    minaret:sequenceIndex 162 ;
    minaret:startTime 1823.96 ;
    minaret:text "اور ہم اس میں بالکل ناراض نہیں ہوں گے، ہم اس فیصلے کو قبول کریں گے۔ اچھا، جب ہم ڈینائل فیز میں ہوتے ہیں کہ اب قبول نہیں کرتے، تو پھر بڑی مشکلات ہو جاتی ہیں۔" .

minaret:Segment_SKD2025-0003_0163 a minaret:TranscriptSegment ;
    minaret:endTime 1839.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0164 ;
    minaret:sequenceIndex 163 ;
    minaret:startTime 1834.04 ;
    minaret:text "اب مثلاً آپ کا کوئی پیارہ بیمار ہو گیا اور سخت بیماری کا شکار ہو گیا، یوں لگتا ہے بچنے والا نہیں۔" .

minaret:Segment_SKD2025-0003_0164 a minaret:TranscriptSegment ;
    minaret:endTime 1853.7 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0165 ;
    minaret:sequenceIndex 164 ;
    minaret:startTime 1843.84 ;
    minaret:text "\"نہیں ابھی نہیں اس کو مرنا چاہیے کیونکہ میری ذات کو اس سے بہت فائدہ پہنچ رہا ہے!\"—اللہ نے تو کوئی وقت لکھا ہے نا، اس نے تو جانا ہی ہے؛ وہ ایکسیپٹ نہیں کرتے۔ بعض لوگ تو فوت بھی ہو جائے تو اس کو بھی ایکسیپٹ نہیں کرتے۔" .

minaret:Segment_SKD2025-0003_0165 a minaret:TranscriptSegment ;
    minaret:endTime 1863.7 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0166 ;
    minaret:sequenceIndex 165 ;
    minaret:startTime 1853.7 ;
    minaret:text "اس کا نقصان کیا ہوتا ہے؟ اس کا نقصان یہ ہوتا है कि اس وقت کرنے के जो काम होते हैं بندہ وہ نہیں کر سکتا۔ کچھ لوگ بیمار ہوتے ہیں وہ مانتے ہی نہیں ہم بیمار ہیں، لہٰذا وہ علاج کرائیں گے نہیں!" .

minaret:Segment_SKD2025-0003_0166 a minaret:TranscriptSegment ;
    minaret:endTime 1872.84 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0167 ;
    minaret:sequenceIndex 166 ;
    minaret:startTime 1865.44 ;
    minaret:text "جی ہاں! یہ بھی ایک مسئلہ ہے۔ انشاء اللہ میرا ارادہ ہے اس کو بھی ڈیل کرنے کا کہ مریض کو بتانا ہے یا نہیں بتانا؟ آپ کیا کہتے ہیں؟" .

minaret:Segment_SKD2025-0003_0167 a minaret:TranscriptSegment ;
    minaret:endTime 1883.92 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0168 ;
    minaret:sequenceIndex 167 ;
    minaret:startTime 1873.9 ;
    minaret:text "بتانا ہے! تاکہ توبہ کرے، تاکہ وہ اپنی اصلاح کرے، اپنا علاج کرے! ایک بندہ دنیا سے جا रहा है आप उसे बता ہی نہیں رہے کہ تم جا رہے ہو اور ڈاکٹر نے تمہیں اتنے دن دیے ہیں—زندگی تو اللہ کے ہاتھ میں ہے،" .

minaret:Segment_SKD2025-0003_0168 a minaret:TranscriptSegment ;
    minaret:endTime 1893.96 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0169 ;
    minaret:sequenceIndex 168 ;
    minaret:startTime 1883.92 ;
    minaret:text "لیکن اکثر ان کے اندازے होते हैं کہ یہ شٹ ڈاؤن ہو रहा है अब اس کی باڈی میں तो यह اتنے دن میں چلا جائے گا—تو وہ اتنے دنوں میں کچھ کر لے، اللہ کی طرف رجوع کر لے!" .

minaret:Segment_SKD2025-0003_0169 a minaret:TranscriptSegment ;
    minaret:endTime 1905.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0170 ;
    minaret:sequenceIndex 169 ;
    minaret:startTime 1893.96 ;
    minaret:text "تو بہرحال، اس طرح جب ہم کہتے ہیں اِنَّا لِلَّهِ اور پھر اس کے بعد کہتے ہیں وَإِنَّا إِلَيْهِ رَاجِعُونَ، ہم ایکسیپٹ کر लेते हैं, ہم اس کی طرف واپس جانے والے ہیں، تو یہ اللہ کا فیصلہ ہے اور میں اس فیصلے کو مانتی ہوں۔" .

minaret:Segment_SKD2025-0003_0170 a minaret:TranscriptSegment ;
    minaret:endTime 1916.2 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0171 ;
    minaret:sequenceIndex 170 ;
    minaret:startTime 1906.16 ;
    minaret:text "اب دیکھیں ہم سب پر موت آنی ہے، ہمیں نہیں پتہ کس شکل میں آئے گی۔ اللہ خیر کا ہی وقت لائے ہم سب کے لیے، کیونکہ یہ ایک حقیقت ہے جس سے کوئی انکاری نہیں کر سکتا۔" .

minaret:Segment_SKD2025-0003_0171 a minaret:TranscriptSegment ;
    minaret:endTime 1926.2 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0172 ;
    minaret:sequenceIndex 171 ;
    minaret:startTime 1916.2 ;
    minaret:text "بعض لوگ تو اس کا ذکر کرنا ہی پسند نہیں کرتے، لیکن انسان کو ریالسٹک اپروچ اپنانی چاہیے، جو فیکٹس ہیں ना لائف کے، چیلنجز ہیں، ان کو ایکسیپٹ کرنا چاہیے۔ اچھا، جانا ہے!" .

minaret:Segment_SKD2025-0003_0172 a minaret:TranscriptSegment ;
    minaret:endTime 1935.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0173 ;
    minaret:sequenceIndex 172 ;
    minaret:startTime 1926.2 ;
    minaret:text "اب کسی ایسی بیماری میں مبتلا ہو گئے ہیں جو لے جانے کے لیے آئی ہے آپ کو اور لے جانے سے پہلے پاک کرنے کے لیے آئی ہے، تو اس وقت کیا کہیں؟ وَإِنَّا إِلَيْهِ رَاجِعُونَ، اِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ!" .

minaret:Segment_SKD2025-0003_0173 a minaret:TranscriptSegment ;
    minaret:endTime 1946.34 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0174 ;
    minaret:sequenceIndex 173 ;
    minaret:startTime 1936.44 ;
    minaret:text "اس سے پہلے کہ لوگ ہماری موت پر اِنَّا لِلَّهِ پڑھیں، ہم خود ہی پڑھ کے رکھ لیں! پڑھ کے رکھنے کے الفاظ اس لیے استعمال کیے کہ بعض لوگ कहते हैं अपने लिए کلمہ پڑھ کے رکھ لو—رکھنے والی چیز نہیں ہے وہ ساتھ چلنے والی ہے!" .

minaret:Segment_SKD2025-0003_0174 a minaret:TranscriptSegment ;
    minaret:endTime 1954.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0175 ;
    minaret:sequenceIndex 174 ;
    minaret:startTime 1946.34 ;
    minaret:text "ٹھیک ہے؟ آخری دم تک پڑھنا ہے۔" .

minaret:Segment_SKD2025-0003_0175 a minaret:TranscriptSegment ;
    minaret:endTime 1965.26 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0176 ;
    minaret:sequenceIndex 175 ;
    minaret:startTime 1955.18 ;
    minaret:text "اچھا، ہمارے پاس جو کچھ ہے نا یہ کیا ہے؟ یہ سب کچھ جو ہمیں ملا ہوا ہے یہ کیا ہے؟ امانت! ہم کیا سمجھتے ہیں؟ یہ تو ہمارا ہے؛" .

minaret:Segment_SKD2025-0003_0176 a minaret:TranscriptSegment ;
    minaret:endTime 1975.22 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0177 ;
    minaret:sequenceIndex 176 ;
    minaret:startTime 1965.26 ;
    minaret:text "تو جب ہم امانت سمجھیں گے—ہماری جان بھی امانت، ہمارا جسم بھی امانت، ہم نے واپس دینا ہے—تو پھر واپس دینا آسان ہو جائے گا۔ یاد ہے وہ قصہ امِ سلیم کا؟ جب ان کا بیٹا فوت ہو گیا" .

minaret:Segment_SKD2025-0003_0177 a minaret:TranscriptSegment ;
    minaret:endTime 1985.26 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0178 ;
    minaret:sequenceIndex 177 ;
    minaret:startTime 1975.22 ;
    minaret:text "تو انہوں نے کیا کیا؟ اپنے ہسبنڈ کو بتائی نہیں کیونکہ وہ سفر سے واپس آئے تھے، کھلایا پلایا، ان کے ساتھ رات گزاری، صبح اٹھ کے ان کو کہا کہ اچھا ہے مجھے آپ یہ بتائیں—" .

minaret:Segment_SKD2025-0003_0178 a minaret:TranscriptSegment ;
    minaret:endTime 1995.36 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0179 ;
    minaret:sequenceIndex 178 ;
    minaret:startTime 1985.26 ;
    minaret:text "بتانے کا طریقہ کتنا خوبصورت ہے! اچھا یہ بتائیں کہ اگر کوئی شخص آپ کے پاس امانت رکھ جائے اور پھر واپس لینے کے لیے آئے تو کیا آپ اس کو خوشی سے دیں گے یا ناراض ہوں گے؟" .

minaret:Segment_SKD2025-0003_0179 a minaret:TranscriptSegment ;
    minaret:endTime 2005.48 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0180 ;
    minaret:sequenceIndex 179 ;
    minaret:startTime 1995.36 ;
    minaret:text "کہا: \"خوشی سے دیں گے، وہ مالک ہے، اس نے ہمارے پاس چند دن کے لیے رکھی تھی، وہ واپس لے گا۔\" کہا: \"آپ کا بیٹا بھی اللہ نے آپ کو امانت دی تھی، وہ واپس لے لیا!\"" .

minaret:Segment_SKD2025-0003_0180 a minaret:TranscriptSegment ;
    minaret:endTime 2015.44 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0181 ;
    minaret:sequenceIndex 180 ;
    minaret:startTime 2005.48 ;
    minaret:text "اتنی عقل مند خاتون تھیں! مجھے تو ان کی ایموشنل انٹیلیجنس، جو آج اتنا بڑا سبجیکٹ بن چکا ہے اور اس پر پتہ نہیں ہزاروں کی فیس دے کے لوگ سیکھتے हैं" .

minaret:Segment_SKD2025-0003_0181 a minaret:TranscriptSegment ;
    minaret:endTime 2025.44 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0182 ;
    minaret:sequenceIndex 181 ;
    minaret:startTime 2015.44 ;
    minaret:text "کہ کس طرح بیہیو کرنا ہے ہم نے، کس سچویشن میں کیا کرنا ہے، ان صحابہ اور صحابیات کو یہ کس نے سکھا دیا تھا؟ یہ عقل کس نے دی تھی؟ یہ حکمت کس نے عطا کی تھی؟" .

minaret:Segment_SKD2025-0003_0182 a minaret:TranscriptSegment ;
    minaret:endTime 2036.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0183 ;
    minaret:sequenceIndex 182 ;
    minaret:startTime 2026.08 ;
    minaret:text "یعنی ماں—ماں تو بچے کی ذرا سی تکلیف نہیں دیکھ سکتی، وہ بچہ ماں کے ہاتھوں میں، ماں کی گود میں دم توڑ گیا ہے، اس نے سارا ٹراما دیکھا ہے، اتنی کمپوزڈ کہ اس نے شو ہی نہیں کیا!" .

minaret:Segment_SKD2025-0003_0183 a minaret:TranscriptSegment ;
    minaret:endTime 2043.44 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0184 ;
    minaret:sequenceIndex 183 ;
    minaret:startTime 2036.06 ;
    minaret:text "باپ واپس آیا، پوچھتا ہے: \"کیا حال ہے؟\" کہا: \"پہلے سے اچھا ہے!\" کیا وہ سخت دل مائیں تھیں یا عقل مند مائیں تھیں؟" .

minaret:Segment_SKD2025-0003_0184 a minaret:TranscriptSegment ;
    minaret:endTime 2054.94 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0185 ;
    minaret:sequenceIndex 184 ;
    minaret:startTime 2044.94 ;
    minaret:text "عقل مند! اور اگر وہ چیخنا شروع کر دیتیں، شوہر نے دروازہ کھولا اور وہ ہلا دوائی، چیخ پکار اور نہ کھانا پکا ہوا اور گھر میں ایک فساد کریٹ کر دیا،" .

minaret:Segment_SKD2025-0003_0185 a minaret:TranscriptSegment ;
    minaret:endTime 2065.12 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0186 ;
    minaret:sequenceIndex 185 ;
    minaret:startTime 2054.94 ;
    minaret:text "اور اگر شوہر نے ساتھ نہیں دیا تو اس کے پیچھے پڑ گئے کہ تمہیں تو دکھ درد ہے ہی نہیں، تم تو خوش ہو گئے کہ ہاں اچھا ہے چلا گیا، ہم ساتھ ہی طعنے بھی دینے لگتے ہیں۔ آپ میں سے کون کون یہ ارادہ کرتا ہے" .

minaret:Segment_SKD2025-0003_0186 a minaret:TranscriptSegment ;
    minaret:endTime 2073.72 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0187 ;
    minaret:sequenceIndex 186 ;
    minaret:startTime 2065.12 ;
    minaret:text "کہ زندگی کی کسی بھی دکھ تکلیف میں ہم نے امِ سلیم کے اسوۂ حسنہ کو سامنے رکھنا ہے، انشاء اللہ؟ دل میں آپ یہ نیت پکی کریں گے نا،" .

minaret:Segment_SKD2025-0003_0187 a minaret:TranscriptSegment ;
    minaret:endTime 2084.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0188 ;
    minaret:sequenceIndex 187 ;
    minaret:startTime 2074.42 ;
    minaret:text "انشاء اللہ! زندگی میں کچھ بھی مرحلے ہو سکتے ہیں، ضروری نہیں وہ بیٹا، باپ بھی ہو سکتا ہے، وہ دادا بھی ہو سکتا ہے، وہ کوئی پیارا انسان ہو سکتا ہے، وہ کوئی بھی ہو سکتا ہے؛ تو پھر ہم اس وقت بہت نارمل بیہیو کرتے ہیں۔" .

minaret:Segment_SKD2025-0003_0188 a minaret:TranscriptSegment ;
    minaret:endTime 2094.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0189 ;
    minaret:sequenceIndex 188 ;
    minaret:startTime 2084.46 ;
    minaret:text "ہمیں دکھ ہوتا ہے، ہماری آنکھیں آنسو بہاتی ہیں، ہماری روح بے چین ہوتی ہے، لیکن ہم زبان سے ایک لفظ نہیں نکالیں جو اللہ کو ناراض کرنے والا ہو،" .

minaret:Segment_SKD2025-0003_0191 a minaret:TranscriptSegment ;
    minaret:endTime 2130.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0192 ;
    minaret:sequenceIndex 191 ;
    minaret:startTime 2120.66 ;
    minaret:text "لِیَبْلُوَكُمْ اَیُّكُمْ اَحْسَنُ عَمَلًا، کہ موت کے مرحلے پر، موت کے فیصلے پر—کیونکہ اللہ نے بنائی ہے نا، اللہ نے دی ہے، اللہ کا فیصلہ آ گیا، اللہ نے بھیجا فرشتے کو \"جاؤ جان لے آؤ اس کی\"—" .

minaret:Segment_SKD2025-0003_0192 a minaret:TranscriptSegment ;
    minaret:endTime 2140.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0193 ;
    minaret:sequenceIndex 192 ;
    minaret:startTime 2130.56 ;
    minaret:text "تو اس پر ہم نے کیا کرنا ہے؟ تسلیم و رضا! \"اللہ میں راضی! إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ! یہ چلا گیا ہے،" .

minaret:Segment_SKD2025-0003_0193 a minaret:TranscriptSegment ;
    minaret:endTime 2150.34 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0194 ;
    minaret:sequenceIndex 193 ;
    minaret:startTime 2140.62 ;
    minaret:text "मुझे भी जाना है।\" ہم سمجھتے ہیں ہم تو ادھر ہیں عیش و عشرت کے لیے اور وہ ہمیں چھوڑ گیا، ہم سے جدا ہو گیا۔ تو یہ فراق اور جدائی جو ہے مومن کے لیے عارضی ہے،" .

minaret:Segment_SKD2025-0003_0194 a minaret:TranscriptSegment ;
    minaret:endTime 2161.02 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0195 ;
    minaret:sequenceIndex 194 ;
    minaret:startTime 2150.96 ;
    minaret:text "عارضی ہے نا! چند دن کی تو بات ہے پھر دوبارہ جا ملیں گے۔ لہٰذا اگر وہ اچھے تھے تو ہمیں بھی اچھے عمل کرنا چاہیے تاکہ عرش کے سائے تلے جا کے ملاقات ہو جائے؛" .

minaret:Segment_SKD2025-0003_0195 a minaret:TranscriptSegment ;
    minaret:endTime 2171.16 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0196 ;
    minaret:sequenceIndex 195 ;
    minaret:startTime 2161.02 ;
    minaret:text "یعنی وہ لوگ جن سے ہم اللہ کی خاطر محبت کرتے ہیں، وہ ہم سے جدا ہو جاتے ہیں، تو کیا چیز دل کو ڈھارس دیتی ہے؟ کہ قیامت کے دن جو لوگ اللہ کی خاطر محبت کرتے ہوں گے آپس" .

minaret:Segment_SKD2025-0003_0196 a minaret:TranscriptSegment ;
    minaret:endTime 2181.22 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0197 ;
    minaret:sequenceIndex 196 ;
    minaret:startTime 2171.16 ;
    minaret:text "میں، وہ عرشِ الہیٰ کے سائے تلے ہوں گے۔ لہٰذا اتنی اچھی جگہ ملے گی ملاقات کی، غم کس بات کا؟ جب ساری دنیا پریشان ہوگی تو اللہ ہمیں" .

minaret:Segment_SKD2025-0003_0197 a minaret:TranscriptSegment ;
    minaret:endTime 2191.34 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0198 ;
    minaret:sequenceIndex 197 ;
    minaret:startTime 2181.22 ;
    minaret:text "پریشانی سے انشاء اللہ بچائے گا: وَهُمْ مِنْ فَزَعٍ يَوْمَئِذٍ آمِنُونَ۔ لہٰذا کسی کی موت سے سبق لے کے، عبرت لے کے اپنی اصلاح کر لینی چاہیے، ٹھیک ہے؟" .

minaret:Segment_SKD2025-0003_0198 a minaret:TranscriptSegment ;
    minaret:endTime 2205.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0199 ;
    minaret:sequenceIndex 198 ;
    minaret:startTime 2191.34 ;
    minaret:text "تو ہوتا یہ ہے کہ جب ہم یہ سمجھتے ہیں کہ سب کچھ ادھار ہے ہمارے پاس، امانت ہے، تو پھر ہمارے لیے تکلیف سہنی آسان ہو جاتی ہے، اور جو اس دعا کے مطلب کو سمجھ کے پڑھتا ہے، اس کے لیے مشکل بہت ہلکی ہو جاتی ہے۔" .

minaret:Segment_SKD2025-0003_0199 a minaret:TranscriptSegment ;
    minaret:endTime 2215.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0200 ;
    minaret:sequenceIndex 199 ;
    minaret:startTime 2206.08 ;
    minaret:text "عموماً لوگ تکلیف کے وقت ایمان کھو دیتے ہیں! ایمان کھو دیتے हैं, ان کا اللہ تعالیٰ سے ٹرسٹ ختم ہو جاتا ہے، حسنِ ظن نہیں رکھتے؛" .

minaret:Segment_SKD2025-0003_0202 a minaret:TranscriptSegment ;
    minaret:endTime 2264.26 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0203 ;
    minaret:sequenceIndex 202 ;
    minaret:startTime 2257.1 ;
    minaret:text "بخششتا ہے، اور اللہ ہر چیز کو جاننے वाला है।\" اللہ کو سب پتہ چل جاتا ہے کون کیا سوچ رہا ہے۔" .

minaret:Segment_SKD2025-0003_0203 a minaret:TranscriptSegment ;
    minaret:endTime 2275.26 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0204 ;
    minaret:sequenceIndex 203 ;
    minaret:startTime 2265.12 ;
    minaret:text "لہٰذا کسی بھی تکلیف پر نا اپنا محاسبہ شروع کر دیں: \"میں کس طرح ری ایکٹ کر رہی ہوں؟ کیا سوچ रही ہوں؟ کس کیفیت کا شکار ہوں؟ کیا میرے دل کو ہدایت" .

minaret:Segment_SKD2025-0003_0204 a minaret:TranscriptSegment ;
    minaret:endTime 2285.3 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0205 ;
    minaret:sequenceIndex 204 ;
    minaret:startTime 2275.26 ;
    minaret:text "مل رہی ہے؟\" ہدایت ملنے کا مطلب है: \"میں راضی ہوں!\" اور وہ سمجھتا ہے یہ اللہ کی طرف سے ہے، یہ اللہ کا فیصلہ ہے۔ ایسا شخص پرسکون ہوگا یا نہیں؟" .

minaret:Segment_SKD2025-0003_0205 a minaret:TranscriptSegment ;
    minaret:endTime 2296.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0206 ;
    minaret:sequenceIndex 205 ;
    minaret:startTime 2285.3 ;
    minaret:text "آپ کچھ لوگوں کو دیکھتے ہیں بڑی سے بڑی مصیبت کے وقت پرسکون ہوتے ہیں، تو لوگ ان کو حیرانی سے دیکھتے हैं: \"بھئی ان کو کچھ ہو ہی نہیں رہا، یہ پریشان کیوں نہیں دکھائی دیتے؟ یہ اتنے سکون میں کیسے ہیں؟ ان کو نہیں خبر ہوئی اس مسئلے کی؟\"" .

minaret:Segment_SKD2025-0003_0206 a minaret:TranscriptSegment ;
    minaret:endTime 2311.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0207 ;
    minaret:sequenceIndex 206 ;
    minaret:startTime 2297.26 ;
    minaret:text "یہ سب ہے! اللہ کے حوالے کر دیا ਹੈ ना۔ کچھ چیزیں ہماری تقدیر کا حصہ ہیں اور وہ ہمیں پہنچ کے رہنی ہیں، لہٰذا کیا करना चाहिए? جو تکلیف پہنچے اس پر صبر۔ اللہ تعالیٰ فرماتے ہیں:" .

minaret:Segment_SKD2025-0003_0208 a minaret:TranscriptSegment ;
    minaret:endTime 2333.9 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0209 ;
    minaret:sequenceIndex 208 ;
    minaret:startTime 2324.2 ;
    minaret:text "وَاللَّهُ لاَ يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ۔ اللہ کسی بھی خود پسند اور فخر کرنے والے کو پسند نہیں करता। ہمارا رویہ کیا होता है? جب کچھ ملتا ہے तो हम کیا करते हैं?" .

minaret:Segment_SKD2025-0003_0209 a minaret:TranscriptSegment ;
    minaret:endTime 2344.08 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0210 ;
    minaret:sequenceIndex 209 ;
    minaret:startTime 2333.9 ;
    minaret:text "آپے سے باہر ہو جاتے ہیں، بڑے خوش ہو جاتے ہیں، ایکسائٹڈ ہو جاتے हैं, اور جب کچھ جاتا ہے تو کیا ہوتا ہے؟ ڈھہ پڑتے ہیں! ان رویوں سے باہر نکلنا ہے، یہ آپ کے ایمان کا ٹیسٹ ہے!" .

minaret:Segment_SKD2025-0003_0210 a minaret:TranscriptSegment ;
    minaret:endTime 2354.18 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0211 ;
    minaret:sequenceIndex 210 ;
    minaret:startTime 2344.08 ;
    minaret:text "اس سے آپ کو پتہ چلے گا کہ آپ ایمان کے کس درجے پر ہیں، تو اپنا ٹیسٹ خود ہی کرتے رہا کریں۔ پھر دعا करते हैं: اَللّٰهُمَّ أَجُرْنِيْ فِیْ مُصِیْبَتِیْ وَأَخْلِفْ لِيْ خَيْرًا مِنْهَا—" .

minaret:Segment_SKD2025-0003_0211 a minaret:TranscriptSegment ;
    minaret:endTime 2367.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0212 ;
    minaret:sequenceIndex 211 ;
    minaret:startTime 2354.18 ;
    minaret:text "\"اللہ! مجھے اجر اور اچھا بدلہ دے۔\" یعنی میں ایک چیز سے محروم ہو گیا ہوں، صحت سے محروم ہو گیا ہوں، اب آپ مجھے اس کا بدل عطا کریں۔ اب مختلف چیزوں کا بدل مختلف ہوتا ہے، ٹھیک ہے؟" .

minaret:Segment_SKD2025-0003_0212 a minaret:TranscriptSegment ;
    minaret:endTime 2383.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0213 ;
    minaret:sequenceIndex 212 ;
    minaret:startTime 2368.82 ;
    minaret:text "اگر کوئی فوت ہو جائے، مثلاً باپ فوت ہو جائے تو کیا کوئی باپ ملے گا؟ نہیں! پھر کیا ہو سکتا ہے؟ زندگی میں کوئی ایسا منٹور آ جائے آپ کے لیے، وہ کام کرے جو آپ کے باپ نے بھی نہیں کیا، آپ کو وہ سکھا دے، وہ تربیت کر دے، اس طرح پال دے جو آپ کا باپ نہیں پال سکتا تھا!" .

minaret:Segment_SKD2025-0003_0213 a minaret:TranscriptSegment ;
    minaret:endTime 2393.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0214 ;
    minaret:sequenceIndex 213 ;
    minaret:startTime 2384.06 ;
    minaret:text "کچھ لوگ یتیموں کو اڈاپٹ کرتے ہیں—میں دبئی میں ایک فیملی کو جانتی ہوں، ان کے اپنے بچے نہیں ہوئے تو انہوں نے چار بچے پاکستان سے لیے، اڈاپٹ کیے عیدی سے،" .

minaret:Segment_SKD2025-0003_0214 a minaret:TranscriptSegment ;
    minaret:endTime 2404.48 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0215 ;
    minaret:sequenceIndex 214 ;
    minaret:startTime 2394.48 ;
    minaret:text "چاروں کے چاروں اتنی زیادہ ان کو فیسیلٹیز، ریسورسز، نعمتیں ملیں، پڑھ کے کہاں سے کہاں پہنچے ہیں! کوئی ایوی ایشن میں ہے، کوئی جہاز چلا رہا ہے، کوئی کچھ کر رہا है!" .

minaret:Segment_SKD2025-0003_0215 a minaret:TranscriptSegment ;
    minaret:endTime 2414.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0216 ;
    minaret:sequenceIndex 215 ;
    minaret:startTime 2404.48 ;
    minaret:text "تو میں جب اس فیملی کو دیکھتی تھی، میں ان بچوں کو، میں حیران ہوتی ہوں، میں کہتی ہوں: \"یا اللہ! اللہ نے ان کے لیے ان کے ماں باپ نہیں رکھے تھے، لیکن ان کے لیے یہ چیزیں رکھی تھیں!\"" .

minaret:Segment_SKD2025-0003_0216 a minaret:TranscriptSegment ;
    minaret:endTime 2424.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0217 ;
    minaret:sequenceIndex 216 ;
    minaret:startTime 2414.52 ;
    minaret:text "یوسف علیہ السلام اگر فلسطین میں ہوتے تو وہ نہیں بن سکتے تھے جو مصر جا کر بنے! اللہ کا فیصلہ ہے، نعم البدل کسی اور شکل میں مل گیا، لیکن باقی رشتوں میں ایسا ہوتا ہے:" .

minaret:Segment_SKD2025-0003_0217 a minaret:TranscriptSegment ;
    minaret:endTime 2434.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0218 ;
    minaret:sequenceIndex 217 ;
    minaret:startTime 2424.5 ;
    minaret:text "کسی کی بیوی فوت ہو گئی یا شوہر فوت ہو گیا تو اس سے بہتر کوئی مل جائے، کوئی بیٹا فوت ہو جائے تو بعض اوقات اس کی اولاد آپ کے لیے بیٹے سے بھی زیادہ کیئرنگ ہوتی ہے!" .

minaret:Segment_SKD2025-0003_0218 a minaret:TranscriptSegment ;
    minaret:endTime 2444.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0219 ;
    minaret:sequenceIndex 218 ;
    minaret:startTime 2434.52 ;
    minaret:text "हो सकता है بیٹا زندہ ہوتا تو آپ کا خیال نہ رکھتا، لیکن وہ اپنے پیچھے ایک بیٹا چھوڑ گیا جو بڑا ہو کر آپ کا سہارا بنا ہوا ہے! اللہ تعالیٰ کسی کو محروم نہیں کرتا ہے، آپ" .

minaret:Segment_SKD2025-0003_0219 a minaret:TranscriptSegment ;
    minaret:endTime 2454.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0220 ;
    minaret:sequenceIndex 219 ;
    minaret:startTime 2444.74 ;
    minaret:text "اس سے اچھی ہی توقع رکھیں۔ جس کا مال چلا جائے، جس کی اولاد چلی جائے، جس کی صحت چلی جائے، تو ایسے لوگوں پر پھر اللہ کی رحمتیں ہوتی ہیں، انسان کے درجات بلند" .

minaret:Segment_SKD2025-0003_0220 a minaret:TranscriptSegment ;
    minaret:endTime 2464.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0221 ;
    minaret:sequenceIndex 220 ;
    minaret:startTime 2454.76 ;
    minaret:text "ہوتے ہیں، اور انسان اللہ کا محبوب بن جاتا ہے۔ عمر بن عبدالعزیز اپنے بیٹے عبدالملک سے کہتے थे: \"اللہ کی قسم! میں چاہتا ہوں تو مجھ سے پہلے فوت ہو جائے—" .

minaret:Segment_SKD2025-0003_0221 a minaret:TranscriptSegment ;
    minaret:endTime 2474.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0222 ;
    minaret:sequenceIndex 221 ;
    minaret:startTime 2464.8 ;
    minaret:text "ایسا کوئی کہہ सकता है? کوئی کہے گا؟ ہم میں سے تو کوئی نہیں کہہ سکتا—اللہ اس وجہ سے کہ میں تیرے فوت ہو جانے کی مصیبت کا اجر اللہ سے طلب کروں!\" اور ان کا بیٹا کہتا" .

minaret:Segment_SKD2025-0003_0222 a minaret:TranscriptSegment ;
    minaret:endTime 2480.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0223 ;
    minaret:sequenceIndex 222 ;
    minaret:startTime 2474.8 ;
    minaret:text "تھا: \"اے اباجان! اللہ کی قسم، جو چیز آپ پسند کرتے ہیں مجھے اس میں کوئی کراہت نہیں!" .

minaret:Segment_SKD2025-0003_0223 a minaret:TranscriptSegment ;
    minaret:endTime 2491.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0224 ;
    minaret:sequenceIndex 223 ;
    minaret:startTime 2480.96 ;
    minaret:text "(اسماعیل علیہ السلام والا رویہ)—کہ میں چاہتا ہوں تو ذبح کر دوں؟ کہا: يَا أَبَتِ افْعَلْ مَا تُؤْمَرُ—اباجان جو آپ کو حکم ملا है कर लीजिये, میں حاضر ہوں ذبح" .

minaret:Segment_SKD2025-0003_0224 a minaret:TranscriptSegment ;
    minaret:endTime 2500.96 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0225 ;
    minaret:sequenceIndex 224 ;
    minaret:startTime 2491.0 ;
    minaret:text "ہونے کے لیے!\" کیا اطاعت ہے؟ کیسا بیٹا ہے؟ اب یہ جملہ چھوٹا سا ہے (إِنَّا لِلَّهِ اور یہ دعا)، لیکن اس کے اثرات حیران کن ہیں، اور یہ اسی وقت ملتے ہیں" .

minaret:Segment_SKD2025-0003_0225 a minaret:TranscriptSegment ;
    minaret:endTime 2511.14 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0226 ;
    minaret:sequenceIndex 225 ;
    minaret:startTime 2500.96 ;
    minaret:text "جب انسان اللہ کے فیصلے پر راضی ہوتا ہے، انسان کو تسلی مل جاتی ہے۔ اور قرآن مجید میں جس آیت میں یہ آتا ہے وہاں تین طرح کا اجر بتایا گیا ਹੈ: صَلَوَاتٌ" .

minaret:Segment_SKD2025-0003_0226 a minaret:TranscriptSegment ;
    minaret:endTime 2521.28 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0227 ;
    minaret:sequenceIndex 226 ;
    minaret:startTime 2511.14 ;
    minaret:text "مِنْ رَبِّهِمْ وَرَحْمَةٌ وَأُولَئِكَ هُمُ الْمُهْتَدُونَ—اللہ کی مہربانیاں، رحمت اور ہدایت! تو یہ اللہ تعالیٰ کا اس امت پر بڑا احسان ہے کہ اللہ تعالیٰ" .

minaret:Segment_SKD2025-0003_0227 a minaret:TranscriptSegment ;
    minaret:endTime 2531.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0228 ;
    minaret:sequenceIndex 227 ;
    minaret:startTime 2521.28 ;
    minaret:text "اگر بندے سے کچھ لیتا ہے تو اس کے بدلے اس کو بہت کچھ دیتا है! جب لیتا ہے تو ہم سمجھتے ہیں اچھے نہیں کیا، چلا گیا سب کچھ، لیکن وہ بھول جاتے ہیں کہ اس کے بدلے میں کیا کچھ ملا۔" .

minaret:Segment_SKD2025-0003_0228 a minaret:TranscriptSegment ;
    minaret:endTime 2544.1 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0229 ;
    minaret:sequenceIndex 228 ;
    minaret:startTime 2531.32 ;
    minaret:text "تو کرنا کیا ہے ہم نے؟ صرف بے روح یہ آیت پر دعا نہیں پڑھ لینی بلکہ کیا کرنا ہے؟ اس کو نیکی کمانے، غنیمت حاصل کرنے، خیر و بھلائی کا ذریعہ سمجھنا ہے۔" .

minaret:Segment_SKD2025-0003_0229 a minaret:TranscriptSegment ;
    minaret:endTime 2555.2 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0230 ;
    minaret:sequenceIndex 229 ;
    minaret:startTime 2545.18 ;
    minaret:text "फिर अब लोग पता क्या कहते हैं? \"یہ آپ نے لکھا نہیں ہے، یہ ایک دفعہ پڑھنا ہے یا سو دفعہ پڑھنا ہے؟ کتنی دفعہ پڑھنا ہے؟\"" .

minaret:Segment_SKD2025-0003_0230 a minaret:TranscriptSegment ;
    minaret:endTime 2565.14 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0231 ;
    minaret:sequenceIndex 230 ;
    minaret:startTime 2555.2 ;
    minaret:text "خلوص کے ساتھ دل سے ایک دفعہ بھی پڑھنا کافی ہو جائے گا، لیکن اگر بار بار بھی پڑھے تو منع نہیں ہے، ٹھیک ہے؟ بس یقین ہونا چاہیے،" .

minaret:Segment_SKD2025-0003_0231 a minaret:TranscriptSegment ;
    minaret:endTime 2575.14 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0232 ;
    minaret:sequenceIndex 231 ;
    minaret:startTime 2565.14 ;
    minaret:text "اور یقین جو ہے یہ کوئی سائنسی آلہ نہیں ہے کہ اس کو ٹیسٹ کریں ہم کہ اس میں یقین کتنا ہے؛ یقین بالکل نہیں سے لے کر پختہ یقین تک کئی درجات ہیں اس کے، اور کچھ لوگوں کا میٹر وہ سو" .

minaret:Segment_SKD2025-0003_0232 a minaret:TranscriptSegment ;
    minaret:endTime 2580.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0233 ;
    minaret:sequenceIndex 232 ;
    minaret:startTime 2575.14 ;
    minaret:text "تک پہنچ جاتا ہے، اتنا یقین ان کو ہوتا ہے کہ جو میں نے پڑھا ہے نا اس کا نتیجہ مجھے مل کے ہی رہنا ہے۔" .

minaret:Segment_SKD2025-0003_0233 a minaret:TranscriptSegment ;
    minaret:endTime 2589.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0234 ;
    minaret:sequenceIndex 233 ;
    minaret:startTime 2580.46 ;
    minaret:text "اب سوال یہ پیدا ہوتا ہے: کیا اس دعا کو پڑھنا مصیبت پہنچتے ہی فائدہ دے گا یا جب یاد آئے پڑھ لے؟" .

minaret:Segment_SKD2025-0003_0234 a minaret:TranscriptSegment ;
    minaret:endTime 2599.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0235 ;
    minaret:sequenceIndex 234 ;
    minaret:startTime 2589.32 ;
    minaret:text "افضل تو اسی وقت پڑھے، لیکن اگر بھول گیا اس وقت تو جب یاد آئے یا بعد میں بھی بار بار تکلیف یاد آ رہی ہے تو بار بار پڑھ لے۔" .

minaret:Segment_SKD2025-0003_0235 a minaret:TranscriptSegment ;
    minaret:endTime 2609.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0236 ;
    minaret:sequenceIndex 235 ;
    minaret:startTime 2599.46 ;
    minaret:text "پہلی دفعہ پڑھنے پر صبر کا بھی اجر ملتا ہے، اور ثواب کی نیت سے پڑھتا ہے تو اس کا بھی بہت بڑا اجر ہے، کیونکہ صبر صدمے کی پہلی چوٹ پر ہوتا है," .

minaret:Segment_SKD2025-0003_0236 a minaret:TranscriptSegment ;
    minaret:endTime 2619.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0237 ;
    minaret:sequenceIndex 236 ;
    minaret:startTime 2609.5 ;
    minaret:text "اور وقت گزرنے کے ساتھ ساتھ تکلیف ہلکی بھی ہوتی ہے، یہ بھی اللہ کی بڑی رحمت ہے۔ تو دو طرح کے لوگ ہوتے हैं: ایک وہ جو اجر کی امید रखते हैं इसलिए صبر کرتے ہیں" .

minaret:Segment_SKD2025-0003_0237 a minaret:TranscriptSegment ;
    minaret:endTime 2629.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0238 ;
    minaret:sequenceIndex 237 ;
    minaret:startTime 2619.52 ;
    minaret:text "اور وہ سمجھتے ہیں کہ جزع فزع کا کوئی فائدہ نہیں، اور دوسرے وہ ہیں جو ایمان اور ثواب کی نیت سے صبر نہیں کرتے، بس مجبوراً چپ ہو جاتے ہیں،" .

minaret:Segment_SKD2025-0003_0238 a minaret:TranscriptSegment ;
    minaret:endTime 2639.82 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0239 ;
    minaret:sequenceIndex 238 ;
    minaret:startTime 2629.62 ;
    minaret:text "وہ آہستہ آہستہ تسلی پا लेते हैं (کہتے ہیں না টাইম از ہیلر، ٹائم کے ساتھ شفایاب ہو जाते हैं—ٹائم نہیں ہیل کرتا، اللہ ہی کرتا ہے)، لیکن بہرحال تو صابرین میں وہ شامل ہوتے ہیں جو صدمے کی پہلی چوٹ پر یہ سب کچھ کرتے ہیں،" .

minaret:Segment_SKD2025-0003_0239 a minaret:TranscriptSegment ;
    minaret:endTime 2649.9 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0240 ;
    minaret:sequenceIndex 239 ;
    minaret:startTime 2639.82 ;
    minaret:text "کیونکہ مصیبت پہنچتے ہی انسان کے اندر کمزوری آتی ہے، مصیبت انسان کو کمزور کرتی ہے، اللہ کا ذکر انسان کو کیا کرتا ہے؟ مضبوط کرتا ہے!" .

minaret:Segment_SKD2025-0003_0240 a minaret:TranscriptSegment ;
    minaret:endTime 2660.18 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0003_0241 ;
    minaret:sequenceIndex 240 ;
    minaret:startTime 2649.9 ;
    minaret:text "رونا دھونا انسان کو ویک کرتا ہے، اللہ کا ذکر انسان کو مضبوط करता है۔ لہٰذا فوراً پڑھے اور جب بھی تکلیف یاد آئے پھر پڑھے، غفلت کا شکار نہ ہو۔" .

minaret:Segment_SKD2025-0004_0001 a minaret:TranscriptSegment ;
    minaret:endTime 15.700000000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0002 ;
    minaret:sequenceIndex 1 ;
    minaret:startTime 9.96 ;
    minaret:text " الحمدللہ  نحمده و نصلي على رسوله الكریم  اما بعد" .

minaret:Segment_SKD2025-0004_0004 a minaret:TranscriptSegment ;
    minaret:endTime 40.2 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0005 ;
    minaret:sequenceIndex 4 ;
    minaret:startTime 33.26 ;
    minaret:text " ٹھیک ہے  ہر حال میں اللہ تعالی کی حمد و ثنا بیان کریں  حمد و ثنا" .

minaret:Segment_SKD2025-0004_0005 a minaret:TranscriptSegment ;
    minaret:endTime 46.08 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 40.2 ;
    minaret:text " اللہ کی تعریف  اور خاص طور پر بیماری کی حالت میں  تکلیف کی حالت میں" .

minaret:Segment_SKD2025-0004_0006 a minaret:TranscriptSegment ;
    minaret:endTime 52.120000000000005 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 46.08 ;
    minaret:text " اور بیماری سے مراد صرف جسمانی بیماری نہیں  بلکہ ذہنی  نفسیاتی" .

minaret:Segment_SKD2025-0004_0007 a minaret:TranscriptSegment ;
    minaret:endTime 56.260000000000005 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 52.120000000000005 ;
    minaret:text " روحانی  جسمانی  قلبی" .

minaret:Segment_SKD2025-0004_0008 a minaret:TranscriptSegment ;
    minaret:endTime 61.82 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 56.260000000000005 ;
    minaret:text " اخلاقی  کسی بھی مشکل میں گرفتار  اب ہم تکلیف میں اور آپ کہتے ہیں" .

minaret:Segment_SKD2025-0004_0009 a minaret:TranscriptSegment ;
    minaret:endTime 66.36 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 61.82 ;
    minaret:text " اللہ کی تعریف بیان کریں  وہ کیوں  اس لیے کہ اللہ سبحانہ و تعالی نے" .

minaret:Segment_SKD2025-0004_0010 a minaret:TranscriptSegment ;
    minaret:endTime 73.74000000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 66.36 ;
    minaret:text " ہمیں ان گنت نعمتیں عطا کی  اور کچھ نعمتیں وہ ہیں  جو ہمیں بظاہر زحمت محسوس ہوتی" .

minaret:Segment_SKD2025-0004_0013 a minaret:TranscriptSegment ;
    minaret:endTime 92.86 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0014 ;
    minaret:sequenceIndex 13 ;
    minaret:startTime 88.9 ;
    minaret:text " تو وہ بھی کیا ہے بظاہر  زحمت لیکن حقیقت میں  رحمت" .

minaret:Segment_SKD2025-0004_0014 a minaret:TranscriptSegment ;
    minaret:endTime 98.66 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0015 ;
    minaret:sequenceIndex 14 ;
    minaret:startTime 92.86 ;
    minaret:text " اور اس زحمت کی شکل میں بھی  دراصل ہمارے لیے کوئی بھلائی  اتاری گئی ہوتی ہے" .

minaret:Segment_SKD2025-0004_0015 a minaret:TranscriptSegment ;
    minaret:endTime 105.12 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0016 ;
    minaret:sequenceIndex 15 ;
    minaret:startTime 98.66 ;
    minaret:text " بظاہر ایک چیز  کھو رہی ہوتی ہے  لیکن ہم اس کے عوض بہت کچھ سیکھ رہے ہوتے ہیں" .

minaret:Segment_SKD2025-0004_0016 a minaret:TranscriptSegment ;
    minaret:endTime 113.58000000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0017 ;
    minaret:sequenceIndex 16 ;
    minaret:startTime 105.12 ;
    minaret:text " ہماری لرننگ ہو رہی ہوتی ہے  ایک علم وہ ہوتا ہے جو کتاب سے حاصل ہوتا ہے  اور ایک علم وہ ہوتا ہے جو تجربے سے حاصل ہوتا ہے" .

minaret:Segment_SKD2025-0004_0017 a minaret:TranscriptSegment ;
    minaret:endTime 118.42 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0018 ;
    minaret:sequenceIndex 17 ;
    minaret:startTime 113.58000000000001 ;
    minaret:text " ایکسپیرینئس سے حاصل ہوتا ہے  اور ایکسپیرینئس اچھا بھی ہو سکتا ہے  اور نہیں بھی ہو سکتا" .

minaret:Segment_SKD2025-0004_0018 a minaret:TranscriptSegment ;
    minaret:endTime 126.12 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0019 ;
    minaret:sequenceIndex 18 ;
    minaret:startTime 118.74000000000001 ;
    minaret:text " ہمارا پسندیدہ بھی ہو سکتا ہے  اور نا پسندیدہ بھی ہو سکتا ہے  لیکن بظاہر کھونے میں بھی دراصل پانا ہے" .

minaret:Segment_SKD2025-0004_0019 a minaret:TranscriptSegment ;
    minaret:endTime 132.92 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0020 ;
    minaret:sequenceIndex 19 ;
    minaret:startTime 126.12 ;
    minaret:text " اور جو پانے کا احساس رکھتا ہے  کہ میں اچیور ہوں  میں اس وقت کچھ پا رہا ہوں" .

minaret:Segment_SKD2025-0004_0020 a minaret:TranscriptSegment ;
    minaret:endTime 139.01999999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0021 ;
    minaret:sequenceIndex 20 ;
    minaret:startTime 132.92 ;
    minaret:text " مومن کو جب تکلیف آتی کانٹا بھی چبھے  تو کیا ہوتا ہے اس کے لئے کیا لکھا جا رہا ہوتا ہے  اجر تو وہ پا رہا ہے نا کچھ" .

minaret:Segment_SKD2025-0004_0021 a minaret:TranscriptSegment ;
    minaret:endTime 145.79999999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0022 ;
    minaret:sequenceIndex 21 ;
    minaret:startTime 139.01999999999998 ;
    minaret:text " تو جس کے اندر پانے کا احساس ہوتا ہے  کہ میں اس سیچویشن سے بھی کچھ پا رہا ہوں  تو اس کی زبان سے کیا نکلتا ہے" .

minaret:Segment_SKD2025-0004_0022 a minaret:TranscriptSegment ;
    minaret:endTime 150.7 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 145.79999999999998 ;
    minaret:text " الحمدللہ  الحمدللہ  اور بیماری تو آزمائش ہونے کے ساتھ" .

minaret:Segment_SKD2025-0004_0023 a minaret:TranscriptSegment ;
    minaret:endTime 156.29999999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 150.7 ;
    minaret:text " اللہ تعالیٰ کی ایک نعمت بھی ہے  کیونکہ اس میں بہت سے ہمارے لئے  فائدے بھی ہوتے ہیں" .

minaret:Segment_SKD2025-0004_0024 a minaret:TranscriptSegment ;
    minaret:endTime 163.26 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 156.29999999999998 ;
    minaret:text " تو بندہ مومن ہر حال میں  اللہ تعالیٰ کی حمد و ثنا کرتا ہے  اور اس طرح وہ اللہ تعالیٰ کے فیصلے پر" .

minaret:Segment_SKD2025-0004_0025 a minaret:TranscriptSegment ;
    minaret:endTime 168.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 163.26 ;
    minaret:text " رضا مندی کا اظہار کرتا ہے  کہ اللہ میں اس حال میں بھی آپ سے راضی ہوں  میں سمجھتا ہوں" .

minaret:Segment_SKD2025-0004_0026 a minaret:TranscriptSegment ;
    minaret:endTime 173.72 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 168.54 ;
    minaret:text " کہ آپ کے اس فیصلے میں  کہ مجھے اس امتحان سے گزارنا ہے  اس میں بھی خیر ہے" .

minaret:Segment_SKD2025-0004_0027 a minaret:TranscriptSegment ;
    minaret:endTime 180.38 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 173.72 ;
    minaret:text " آپ ہر نقص سے پاک ہیں  اگر مجھ پر کوئی مشکل آئی ہے  تو میرے اپنے ہی گناہوں کی وجہ سے ہوگی" .

minaret:Segment_SKD2025-0004_0028 a minaret:TranscriptSegment ;
    minaret:endTime 188.23999999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0029 ;
    minaret:sequenceIndex 28 ;
    minaret:startTime 180.38 ;
    minaret:text " یا پھر میرے درجات کی بلندی کے لئے ہوگی  تو جب اللہ تعالیٰ کسی کے درجے بلند کرنا چاہتا ہے  تو اس کو مشکل سے گزارتا ہے" .

minaret:Segment_SKD2025-0004_0029 a minaret:TranscriptSegment ;
    minaret:endTime 192.05999999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0030 ;
    minaret:sequenceIndex 29 ;
    minaret:startTime 188.23999999999998 ;
    minaret:text " تو اس پر بھی کیا ہے  اللہ ہی کی تعریف  الحمدللہ" .

minaret:Segment_SKD2025-0004_0030 a minaret:TranscriptSegment ;
    minaret:endTime 198.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0031 ;
    minaret:sequenceIndex 30 ;
    minaret:startTime 192.05999999999997 ;
    minaret:text " اور پھر آپ دیکھیں کہ  جب انسان تسبیح کرتا ہے  یعنی حمد و   ثنا تسبیح" .

minaret:Segment_SKD2025-0004_0031 a minaret:TranscriptSegment ;
    minaret:endTime 205.51999999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0032 ;
    minaret:sequenceIndex 31 ;
    minaret:startTime 198.04 ;
    minaret:text " اللہ تعالیٰ کی پاکی بیان کرتا ہے  تو اس کے صلے میں  انسان کو بڑی بڑی مشکلات سے نجات ملتی ہے" .

minaret:Segment_SKD2025-0004_0032 a minaret:TranscriptSegment ;
    minaret:endTime 215.2 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0033 ;
    minaret:sequenceIndex 32 ;
    minaret:startTime 208.14 ;
    minaret:text " اس رزق کو پانے کے لئے کیا کرنا ہے  حمد و ثنا اور تسبیح کرنی ہے  اور یہ اللہ تعالیٰ کے محبوب ترین کلمات بھی ہیں" .

minaret:Segment_SKD2025-0004_0033 a minaret:TranscriptSegment ;
    minaret:endTime 220.11999999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0034 ;
    minaret:sequenceIndex 33 ;
    minaret:startTime 215.2 ;
    minaret:text " اور یہ کلمات  میزان میں بھاری بھی بہت ہوتے ہیں  الحمدللہ" .

minaret:Segment_SKD2025-0004_0034 a minaret:TranscriptSegment ;
    minaret:endTime 226.76 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0035 ;
    minaret:sequenceIndex 34 ;
    minaret:startTime 220.11999999999998 ;
    minaret:text " افضل الدعا ہے  دعاوں میں سے افضل ترین دعا ہے  ایک سکالر سے کسی شاگر نے پوچھا" .

minaret:Segment_SKD2025-0004_0035 a minaret:TranscriptSegment ;
    minaret:endTime 233.33999999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0036 ;
    minaret:sequenceIndex 35 ;
    minaret:startTime 226.76 ;
    minaret:text " کہ آپ کی خاص دعا کیا  آپ سب سے زیادہ کس دعا کو پڑھتے ہیں  اور جب آپ کسی مشکل کا شکار ہوتے ہیں" .

minaret:Segment_SKD2025-0004_0036 a minaret:TranscriptSegment ;
    minaret:endTime 238.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0037 ;
    minaret:sequenceIndex 36 ;
    minaret:startTime 233.34 ;
    minaret:text " جب آپ کے لئے تکلیف دہ حالات ہو جاتے ہیں  جب آپ کے حالات تنگ ہو جاتے ہیں  تو آپ کیا پڑھتے ہیں" .

minaret:Segment_SKD2025-0004_0037 a minaret:TranscriptSegment ;
    minaret:endTime 242.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0038 ;
    minaret:sequenceIndex 37 ;
    minaret:startTime 238.56 ;
    minaret:text " وہ کون سا وظیفہ ہے آپ کا  تو انہوں نے کہا  الحمدللہ" .

minaret:Segment_SKD2025-0004_0038 a minaret:TranscriptSegment ;
    minaret:endTime 247.24 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0039 ;
    minaret:sequenceIndex 38 ;
    minaret:startTime 242.56 ;
    minaret:text " کہا الحمدللہ  یہ کیوں  کہا تمہیں نہیں پتا کہ حدیث میں" .

minaret:Segment_SKD2025-0004_0039 a minaret:TranscriptSegment ;
    minaret:endTime 253.18 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0040 ;
    minaret:sequenceIndex 39 ;
    minaret:startTime 247.24 ;
    minaret:text " اس کو افضل الدعا بتایا گیا  کہ ساری دعاوں سے افضل دعا ہے  کہ آپ اللہ تعالیٰ کے شکر گزار ہو جائیں" .

minaret:Segment_SKD2025-0004_0040 a minaret:TranscriptSegment ;
    minaret:endTime 257.16 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0041 ;
    minaret:sequenceIndex 40 ;
    minaret:startTime 253.18 ;
    minaret:text " ہر حال میں  اللہ سے راضی ہو جائیں  تو اللہ تعالیٰ بھی آپ کو" .

minaret:Segment_SKD2025-0004_0041 a minaret:TranscriptSegment ;
    minaret:endTime 261.97999999999996 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0042 ;
    minaret:sequenceIndex 41 ;
    minaret:startTime 257.16 ;
    minaret:text " راضی کر دے گا  آپ اللہ کی تعریف بیان کریں  اللہ سبحانہ وتعالی" .

minaret:Segment_SKD2025-0004_0042 a minaret:TranscriptSegment ;
    minaret:endTime 266.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0043 ;
    minaret:sequenceIndex 42 ;
    minaret:startTime 261.97999999999996 ;
    minaret:text " آپ کے لئے آسانی فرمائے گا  تو ہر حال میں  الحمدللہ" .

minaret:Segment_SKD2025-0004_0043 a minaret:TranscriptSegment ;
    minaret:endTime 269.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0044 ;
    minaret:sequenceIndex 43 ;
    minaret:startTime 266.46 ;
    minaret:text " کہنا سیکھیں  اور  الحمدللہ" .

minaret:Segment_SKD2025-0004_0044 a minaret:TranscriptSegment ;
    minaret:endTime 275.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0045 ;
    minaret:sequenceIndex 44 ;
    minaret:startTime 269.56 ;
    minaret:text " کلمہ شکر بھی ہے  کہ اللہ تعالیٰ ہم آپ کی ساری نعمتوں پر  اور یہ بھی ایک نعمت ہی ہے" .

minaret:Segment_SKD2025-0004_0045 a minaret:TranscriptSegment ;
    minaret:endTime 279.02 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0046 ;
    minaret:sequenceIndex 45 ;
    minaret:startTime 275.5 ;
    minaret:text " جو آپ نے بھیجی ہے  کہ اس سے بھی آپ مجھے بہت کچھ  عطا کرنے والے ہیں" .

minaret:Segment_SKD2025-0004_0046 a minaret:TranscriptSegment ;
    minaret:endTime 282.52 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0047 ;
    minaret:sequenceIndex 46 ;
    minaret:startTime 279.02 ;
    minaret:text " لہٰذا  میں آپ کا  شکر ادا کرتی ہوں" .

minaret:Segment_SKD2025-0004_0047 a minaret:TranscriptSegment ;
    minaret:endTime 288.35999999999996 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0048 ;
    minaret:sequenceIndex 47 ;
    minaret:startTime 282.52 ;
    minaret:text " میں آپ کی تعریف بیان کرتی ہوں  تو بیماری  حقیقت میں ایک نعمت ہے" .

minaret:Segment_SKD2025-0004_0048 a minaret:TranscriptSegment ;
    minaret:endTime 293.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0049 ;
    minaret:sequenceIndex 48 ;
    minaret:startTime 288.35999999999996 ;
    minaret:text " جو شکر کا تقاضا کرتی ہے  اس لئے اللہ تعالیٰ کی  تعریف بیان کرنی چاہیے" .

minaret:Segment_SKD2025-0004_0049 a minaret:TranscriptSegment ;
    minaret:endTime 298.11999999999995 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0050 ;
    minaret:sequenceIndex 49 ;
    minaret:startTime 293.46 ;
    minaret:text " انسان کے گناہ جھڑتے ہیں  درجے بلند ہوتے ہیں  رب کا قرب نصیب ہوتا ہے" .

minaret:Segment_SKD2025-0004_0050 a minaret:TranscriptSegment ;
    minaret:endTime 303.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0051 ;
    minaret:sequenceIndex 50 ;
    minaret:startTime 298.11999999999995 ;
    minaret:text " انسان کے جسم کے اندر  کئی اور چیزوں کی اصلاح ہو رہی ہوتی ہے  تو اس لئے" .

minaret:Segment_SKD2025-0004_0053 a minaret:TranscriptSegment ;
    minaret:endTime 322.46000000000004 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0054 ;
    minaret:sequenceIndex 53 ;
    minaret:startTime 317.38 ;
    minaret:text " کہ اللہ تعالیٰ جس کے ساتھ  خیر و بھلائی کا ارادہ کرتا ہے  اس کو مشکلات کا شکار کر دیتا ہے" .

minaret:Segment_SKD2025-0004_0055 a minaret:TranscriptSegment ;
    minaret:endTime 333.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0056 ;
    minaret:sequenceIndex 55 ;
    minaret:startTime 329.0 ;
    minaret:text " چار قسموں میں ہوتے ہیں  نمبر ایک  وہ جو مشکل میں ناخوش ہوتا ہے" .

minaret:Segment_SKD2025-0004_0056 a minaret:TranscriptSegment ;
    minaret:endTime 338.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0057 ;
    minaret:sequenceIndex 56 ;
    minaret:startTime 333.74 ;
    minaret:text " اور جو ناخوش ہوتا ہے  اللہ تعالیٰ بھی اس سے  کیا کرتا ہے" .

minaret:Segment_SKD2025-0004_0057 a minaret:TranscriptSegment ;
    minaret:endTime 343.8 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0058 ;
    minaret:sequenceIndex 57 ;
    minaret:startTime 338.74 ;
    minaret:text " جو ناراض ہوتا ہے  اللہ سے کسی مشکل پر  اللہ تعالیٰ بھی اس سے ناراض ہو جاتے ہیں" .

minaret:Segment_SKD2025-0004_0058 a minaret:TranscriptSegment ;
    minaret:endTime 349.46000000000004 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 343.8 ;
    minaret:text " اور یہ ناخوش ہے  اور اللہ سے ناراضگی  انسان کو اللہ تعالیٰ سے بہت دور کر دیتی" .

minaret:Segment_SKD2025-0004_0059 a minaret:TranscriptSegment ;
