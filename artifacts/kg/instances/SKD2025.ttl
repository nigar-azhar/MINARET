    minaret:precedesSegment minaret:Segment_SKD2025-0001_0458 ;
    minaret:sequenceIndex 457 ;
    minaret:startTime 2533.7599999999998 ;
    minaret:text " نیند کی خرابی ہو جاتی ہے  روئیے مختلف ہو جاتے ہیں  انسان دوسرے انسانوں کے ساتھ" .

minaret:Segment_SKD2025-0001_0458 a minaret:TranscriptSegment ;
    minaret:endTime 2543.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0459 ;
    minaret:sequenceIndex 458 ;
    minaret:startTime 2538.88 ;
    minaret:text " لڑنا جگڑنا شروع کر دیتا ہے  آپ نے دیکھا ہو گا  بیمار لوگ کتنے چڑچڑے ہو جاتے ہیں نا" .

minaret:Segment_SKD2025-0001_0459 a minaret:TranscriptSegment ;
    minaret:endTime 2554.92 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0460 ;
    minaret:sequenceIndex 459 ;
    minaret:startTime 2543.0 ;
    minaret:text " اور خاص طور پر جب ان کو یہ ہو  نہ اس دوا نے اثر کیانہ اس نے کیاتوپھر وہ کہتے کہ اب مجھ سے بات نہ کرو چلے جاؤ یہاں سے آپکو پتا کئی بیمار تو ڈاکٹر تک کو ڈانٹ رہے ہوتے ہیں  اور پھر اسی طرح بعض اوقات" .

minaret:Segment_SKD2025-0001_0460 a minaret:TranscriptSegment ;
    minaret:endTime 2558.56 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0461 ;
    minaret:sequenceIndex 460 ;
    minaret:startTime 2554.92 ;
    minaret:text " لوگ isolate ہو جاتے ہیں  آپ نے دیکھا ہوگا  جو لوگ depression میں جاتے ہیں" .

minaret:Segment_SKD2025-0001_0461 a minaret:TranscriptSegment ;
