    minaret:precedesSegment minaret:Segment_SKD2025-0001_0438 ;
    minaret:sequenceIndex 437 ;
    minaret:startTime 2445.46 ;
    minaret:text " نہیں ہو سکتی  اس پر میں ایک research پڑھ رہی تھی  اس کا خلاصہ یہ ہے" .

minaret:Segment_SKD2025-0001_0439 a minaret:TranscriptSegment ;
