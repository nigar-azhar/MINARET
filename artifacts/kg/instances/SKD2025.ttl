""" .

minaret:Segment_SKD2025-0002_0003 a minaret:TranscriptSegment ;
    minaret:endTime 11.86 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0002_0004 ;
    minaret:sequenceIndex 3 ;
    minaret:startTime 11.0 ;
