minaret:Topic_Healing_and_supplication a minaret:Topic ;
    minaret:descriptionEn "The prayer of Ayyub and the lecturer’s discussion of prayer alongside treatment." ;
    minaret:descriptionUr "ایوب علیہ السلام کی دعا اور علاج کے ساتھ دعا کے کردار پر مقررہ کی گفتگو۔" ;
    minaret:nameEn "Healing and supplication" ;
    minaret:nameUr "شفا اور دعا" ;
    skos:related minaret:Topic_Supplication_in_Islam_Ad_Du_a .

minaret:Topic_Hope_and_perseverance_in_supplication a minaret:Topic ;
    minaret:descriptionEn "Avoiding heedlessness and despair while persisting in prayer and accepting different outcomes." ;
