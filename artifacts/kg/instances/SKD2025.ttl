    minaret:precedesSegment minaret:Segment_SKD2025-0004_0122 ;
    minaret:sequenceIndex 121 ;
    minaret:startTime 623.84 ;
    minaret:text " دو لگاتی  ہاں کچھ لگاتی بھی ہے  لیکن" .

minaret:Segment_SKD2025-0004_0122 a minaret:TranscriptSegment ;
    minaret:endTime 629.28 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0123 ;
    minaret:sequenceIndex 122 ;
    minaret:startTime 626.98 ;
    minaret:text " ماں کی محبت  ایسے ہوتی ہے  وہ جوں جوں  بچہ روتا ہے" .

minaret:Segment_SKD2025-0004_0123 a minaret:TranscriptSegment ;
    minaret:endTime 632.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0124 ;
    minaret:sequenceIndex 123 ;
    minaret:startTime 629.28 ;
    minaret:text " تکلیف میں ہوتا ہے  وہ اور سینے سے لگاتی ہے  پیار کرتی ہے" .

minaret:Segment_SKD2025-0004_0124 a minaret:TranscriptSegment ;
    minaret:endTime 635.42 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0125 ;
    minaret:sequenceIndex 124 ;
    minaret:startTime 632.04 ;
    minaret:text " لاڈ کرتی ہے  کیوں کرتی ہے  محبت کی وجہ سے" .

minaret:Segment_SKD2025-0004_0125 a minaret:TranscriptSegment ;
    minaret:endTime 638.82 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0126 ;
    minaret:sequenceIndex 125 ;
    minaret:startTime 635.42 ;
    minaret:text " تو جس بندے کو  اللہ سے محبت ہوتی ہے  وہ" .

minaret:Segment_SKD2025-0004_0126 a minaret:TranscriptSegment ;
    minaret:endTime 641.72 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0127 ;
    minaret:sequenceIndex 126 ;
    minaret:startTime 638.82 ;
    minaret:text " محبت کے ساتھ  اللہ کی تعریف  حمد کا مطلب ہی ہے" .

minaret:Segment_SKD2025-0004_0127 a minaret:TranscriptSegment ;
