    minaret:sequenceIndex 441 ;
    minaret:startTime 2464.7 ;
    minaret:text " شیطان کیا کرتا ہے  الَّذِي يُوَسْوِسُ  فِي صُدُورِ النَّاسِ" .

minaret:Segment_SKD2025-0001_0442 a minaret:TranscriptSegment ;
    minaret:endTime 2472.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0443 ;
    minaret:sequenceIndex 442 ;
    minaret:startTime 2469.08 ;
    minaret:text " مِنَ الْجِنَّةِ وَٱلنَّاسِ  جن بھی ہوتے ہیں" .

minaret:Segment_SKD2025-0001_0443 a minaret:TranscriptSegment ;
    minaret:endTime 2478.36 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0444 ;
    minaret:sequenceIndex 443 ;
    minaret:startTime 2472.54 ;
    minaret:text " یعنی شیطان بھی ہوتے ہیں اور کچھ لوگ بھی ہوتے ہیں ہماری زندگی میں  وہ ہر بات کو  الٹا دیکھتے ہیں" .

minaret:Segment_SKD2025-0001_0495 a minaret:TranscriptSegment ;
    minaret:endTime 2710.32 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0496 ;
    minaret:sequenceIndex 495 ;
    minaret:startTime 2705.1 ;
    minaret:text " فرض نماز کے بعد  جمعہ کے دن خاص گھڑی  بارش کے وقت" .

minaret:Segment_SKD2025-0001_0496 a minaret:TranscriptSegment ;
    minaret:endTime 2716.14 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0497 ;
    minaret:sequenceIndex 496 ;
    minaret:startTime 2710.32 ;
    minaret:text " زمزم پیتے ہوئے  تلاوت قرآن کے بعد  اور آخر میں ایک حدیث سنا کے بس کروں گی" .

minaret:Segment_SKD2025-0001_0499 a minaret:TranscriptSegment ;
    minaret:endTime 2739.7999999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0500 ;
    minaret:sequenceIndex 499 ;
    minaret:startTime 2734.08 ;
    minaret:text " وہ بھی فائدہ دیتی ہے  اسی لئے ایک تو دعا مانگ رہے ہوتا ہے  اور باقی سب آمین کہہ رہے ہوتا ہے" .

minaret:Segment_SKD2025-0002_0002 a minaret:TranscriptSegment ;
