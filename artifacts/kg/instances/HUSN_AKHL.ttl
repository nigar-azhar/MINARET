    minaret:startTime 1126.8 .

minaret:HadithOccurrence_HUSN_AKHL-21590_0005_1686_0_AD_3646 a minaret:HadithOccurrence ;
    minaret:endTime 1699.18 ;
    minaret:evidenceText "خدا کی قسم جس کے قبضے میں میری جان ہے میری زبان سے حق کے سوا کچھ نہیں نکلتا، خواہ میں غصے میں ہوں، خواہ میں دوسری حالت میں ہوں لیکن اس زبان سے جو کچھ نکلتا ہے وہ درست نکلتا ہے، اور آپ نے ان کو لکھنے کی اجازت دی۔" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21590_1686_0_1699_18 ;
    minaret:refersTo minaret:Hadith_AD_3646 ;
    minaret:startTime 1686.0 .

minaret:HadithOccurrence_HUSN_AKHL-21590_0006_2109_6_AD_3641 a minaret:HadithOccurrence ;
    minaret:endTime 2117.22 ;
    minaret:evidenceText "پیغمبر مال تو نہیں چھوڑ کے جاتے، پیغمبر تو علم چھوڑ کے جاتے ہیں، اور جس نے اس علم کا حصہ پا لیا اس نے آپ کی وراثت کا حصہ پا لیا۔" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21590_2109_6_2117_22 ;
    minaret:refersTo minaret:Hadith_AD_3641 ;
    minaret:startTime 2109.6 .

