    minaret:endTime 1839.66 ;
    minaret:evidenceText "اِذَا اَرَادَ اللّٰهُ عَزَّ وَجَلَّ بِاَهْلِ بَیْتٍ خَیْرًا اَدْخَلَ عَلَیْهِمُ الرِّفْقَ" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_1819_66_1839_66 ;
    minaret:refersTo minaret:Hadith_Ahmad_24427 ;
    minaret:startTime 1819.66 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0001_1879_42_Ahmad_24427 a minaret:HadithOccurrence ;
    minaret:endTime 1899.34 ;
    minaret:evidenceText "جب اللہ تعالیٰ کسی خاندان کے لیے بھلائی چاہتے ہیں تو ان میں نرمی ڈال دیتے ہیں" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_1879_42_1899_34 ;
    minaret:refersTo minaret:Hadith_Ahmad_24427 ;
    minaret:startTime 1879.42 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0002_2673_26_JT_2013 a minaret:HadithOccurrence ;
    minaret:endTime 2689.68 ;
    minaret:evidenceText "مَنْ اُعْطِیَ حَظَّهٗ مِنَ الرِّفْقِ فَقَدْ اُعْطِیَ حَظَّهٗ مِنَ الْخَیْرِ، وَمَنْ حُرِمَ حَظَّهٗ مِنَ الرِّفْقِ فَقَدْ حُرِمَ حَظَّهٗ مِنَ الْخَیْرِ" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_2673_26_2689_68 ;
    minaret:refersTo minaret:Hadith_JT_2013 ;
    minaret:startTime 2673.26 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0003_2689_68_JT_2013 a minaret:HadithOccurrence ;
    minaret:endTime 2749.12 ;
    minaret:evidenceText "مَنْ، جو کوئی، اُعْطِیَ، دیا گیا، حَظَّهٗ، اپنا حصہ، مِنَ الرِّفْقِ، نرمی میں سے، فَقَدْ، پس تحقیق، اُعْطِیَ، دیا گیا، حَظَّهٗ، اپنا حصہ، مِنَ الْخَیْرِ، خیر میں سے، وَمَنْ حُرِمَ، اور جو محروم کیا گیا، حَظَّهٗ، اپنے حصے سے، مِنَ الرِّفْقِ، نرمی سے، فَقَدْ حُرِمَ، پس تحقیق وہ محروم کیا گیا، حَظَّهٗ، اپنے حصے سے، مِنَ الْخَیْرِ، خیر کے" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_2689_68_2749_12 ;
    minaret:refersTo minaret:Hadith_JT_2013 ;
    minaret:startTime 2689.68 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0004_2729_16_JT_2013 a minaret:HadithOccurrence ;
    minaret:endTime 2769.04 ;
    minaret:evidenceText "جس کو نرمی میں سے حصہ ملا تو اسے خیر میں سے حصہ ملا اور جو کوئی نرمی کے حصے سے محروم رہا وہ خیر سے محروم رہا" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_2729_16_2769_04 ;
    minaret:refersTo minaret:Hadith_JT_2013 ;
    minaret:startTime 2729.16 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0005_2789_0_SM_2592 a minaret:HadithOccurrence ;
    minaret:endTime 2808.74 ;
    minaret:evidenceText "مَنْ یُّحْرَمِ الرِّفْقَ یُحْرَمِ الْخَیْرَ" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_2789_0_2808_74 ;
    minaret:refersTo minaret:Hadith_SM_2592 ;
    minaret:startTime 2789.0 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0006_2789_0_SM_2592 a minaret:HadithOccurrence ;
    minaret:endTime 2808.74 ;
    minaret:evidenceText "جو محروم کر دیا گیا نرمی سے، وہ محروم کر دیا گیا خیر سے، بھلائی سے" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_2789_0_2808_74 ;
    minaret:refersTo minaret:Hadith_SM_2592 ;
    minaret:startTime 2789.0 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0007_2908_1_SM_2593 a minaret:HadithOccurrence ;
    minaret:endTime 2927.9 ;
    minaret:evidenceText "یَا عَائِشَةُ اِنَّ اللّٰهَ رَفِیْقٌ یُّحِبُّ الرِّفْقَ وَیُعْطِیْ عَلَی الرِّفْقِ مَا لَا یُعْطِیْ عَلَی الْعُنْفِ وَمَا لَا یُعْطِیْ عَلٰی مَا سِوَاهُ" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_2908_1_2927_9 ;
    minaret:refersTo minaret:Hadith_SM_2593 ;
    minaret:startTime 2908.1 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0008_2987_04_SM_2593 a minaret:HadithOccurrence ;
    minaret:endTime 3026.8 ;
    minaret:evidenceText "اے عائشہ! بے شک اللہ تعالیٰ نرمی کرنے والا ہے، نرمی کو پسند فرماتا ہے، نرمی پر وہ جو کچھ عطا فرماتا ہے وہ سختی پر اور اس کے علاوہ کسی چیز پر عطا نہیں فرماتا" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_2987_04_3026_8 ;
    minaret:refersTo minaret:Hadith_SM_2593 ;
    minaret:startTime 2987.04 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0009_3066_7_SB_6030 a minaret:HadithOccurrence ;
    minaret:endTime 3105.6 ;
    minaret:evidenceText "اَنَّ الْیَهُوْدَ اَتَوُا النَّبِیَّ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ فَقَالُوْا: اَلسَّامُ عَلَیْكَ، قَالَ: وَعَلَیْكُمْ، فَقَالَتْ عَائِشَةُ: اَلسَّامُ عَلَیْكُمْ وَلَعَنَكُمُ اللّٰهُ وَغَضِبَ عَلَیْكُمْ، فَقَالَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ: مَهْلًا یَا عَائِشَةُ، عَلَیْكِ بِالرِّفْقِ وَاِیَّاكِ وَالْعُنْفَ وَالْفَحْشَ" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_3066_7_3105_6 ;
    minaret:refersTo minaret:Hadith_SB_6030 ;
    minaret:startTime 3066.7 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0010_3244_18_SB_6030 a minaret:HadithOccurrence ;
    minaret:endTime 3283.86 ;
    minaret:evidenceText "یہود نبی کریم صلی اللہ علیہ وسلم کی خدمت میں حاضر ہوئے اور کہا: السام علیک۔ نبی کریم صلی اللہ علیہ وسلم نے فرمایا: وعلیکم۔ لیکن سیدہ عائشہ رضی اللہ عنہا نے کہا: السام علیکم ولعنکم اللہ وغضب علیکم۔ تو رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ٹھہرو عائشہ! نرم خوئی اختیار کرو اور سختی اور بدکلامی سے ہمیشہ پرہیز کرو" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_3244_18_3283_86 ;
    minaret:refersTo minaret:Hadith_SB_6030 ;
    minaret:startTime 3244.18 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0011_3303_0_SM_2594 a minaret:HadithOccurrence ;
    minaret:endTime 3342.9 ;
    minaret:evidenceText "اِنَّ الرِّفْقَ لَا یَكُوْنُ فِیْ شَیْءٍ اِلَّا زَانَهٗ، وَلَا یُنْزَعُ مِنْ شَیْءٍ اِلَّا شَانَهٗ" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_3303_0_3342_9 ;
    minaret:refersTo minaret:Hadith_SM_2594 ;
    minaret:startTime 3303.0 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0012_3323_0_SM_2594 a minaret:HadithOccurrence ;
    minaret:endTime 3362.8 ;
    minaret:evidenceText "جس چیز میں بھی نرمی ہوتی ہے وہ اسے زینت دار بنا دیتی ہے اور جس سے یہ نکال دی جاتی ہے اسے عیب دار کر دیتی ہے" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_3323_0_3362_8 ;
    minaret:refersTo minaret:Hadith_SM_2594 ;
    minaret:startTime 3323.0 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0013_3382_72_JT_2488 a minaret:HadithOccurrence ;
    minaret:endTime 3422.62 ;
    minaret:evidenceText "اَلَاۤ اُخْبِرُكُمْ بِمَنْ یَّحْرُمُ عَلَی النَّارِ وَبِمَنْ تَحْرُمُ عَلَیْهِ النَّارُ۔ عَلٰی كُلِّ قَرِیْبٍ هَیِّنٍ سَهْلٍ" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_3382_72_3422_62 ;
    minaret:refersTo minaret:Hadith_JT_2488 ;
    minaret:startTime 3382.72 .

minaret:HadithOccurrence_HUSN_AKHL-21592_0014_3402_64_JT_2488 a minaret:HadithOccurrence ;
    minaret:endTime 3442.52 ;
    minaret:evidenceText "کیا میں تمہیں ایسے لوگوں کی خبر نہ دوں جو جہنم کی آگ پر یا جہنم کی آگ ان پر حرام ہے؟ یہ ہر اس شخص پر حرام ہے جو لوگوں کے قریب رہنے والا، نرمی کرنے والا، آسانی کرنے والا ہے" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_3402_64_3442_52 ;
    minaret:refersTo minaret:Hadith_JT_2488 ;
    minaret:startTime 3402.64 .

minaret:HadithOccurrence_HUSN_AKHL-21593_0000_732_46_SM_2577 a minaret:HadithOccurrence ;
    minaret:endTime 752.04 ;
    minaret:evidenceText "اِنِّیْ حَرَّمْتُ الظُّلْمَ عَلٰی نَفْسِیْ وَجَعَلْتُهٗ بَیْنَكُمْ مُحَرَّمًا فَلَا تَظَالَمُوْا" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21593_732_46_752_04 ;
    minaret:refersTo minaret:Hadith_SM_2577 ;
    minaret:startTime 732.46 .

minaret:HadithOccurrence_HUSN_AKHL-21593_0001_830_66_SM_2577 a minaret:HadithOccurrence ;
    minaret:endTime 850.28 ;
    minaret:evidenceText "میں نے اپنے نفس پر ظلم کو حرام کیا ہے اور اپنے بندوں کے درمیان بھی اسے حرام قرار دیا ہے، تو تم آپس میں ظلم نہ کرو" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21593_830_66_850_28 ;
    minaret:refersTo minaret:Hadith_SM_2577 ;
    minaret:startTime 830.66 .

minaret:HadithOccurrence_HUSN_AKHL-21593_0002_870_1_SB_3513 a minaret:HadithOccurrence ;
    minaret:endTime 889.68 ;
    minaret:evidenceText "اے اللہ! غفار کو بخش دے اور بنو اسلم کو سلامت رکھ" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21593_870_1_889_68 ;
    minaret:refersTo minaret:Hadith_SB_3513 ;
    minaret:startTime 870.1 .

minaret:HadithOccurrence_HUSN_AKHL-21593_0003_1981_08_SB_5971 a minaret:HadithOccurrence ;
    minaret:endTime 2020.9 ;
    minaret:evidenceText "سب سے زیادہ حق کس کا ہے؟ تمہاری ماں کا ہے۔ ایک شخص آپ کے پاس آیا اور کہنے لگا کہ یا رسول اللہ صلی اللہ علیہ وسلم! سب سے زیادہ مجھے اچھا سلوک کس سے کرنا ہے؟ تو آپ نے فرمایا: اپنی ماں سے کرو۔ پھر تین دفعہ، چوتھی دفعہ کیا کہا؟ باپ سے" ;
    minaret:hasUsageType minaret:Paraphrase ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21593_1981_08_2020_9 ;
    minaret:refersTo minaret:Hadith_SB_5971 ;
    minaret:startTime 1981.08 .

minaret:HadithOccurrence_HUSN_AKHL-21593_0004_2000_98_JT_3895 a minaret:HadithOccurrence ;
    minaret:endTime 2020.9 ;
    minaret:evidenceText "تم میں سب سے اچھا وہ ہے جو اپنی بیوی کے حق میں اچھا ہے، اور میں تم میں سب سے زیادہ اپنی بیویوں کے حق میں اچھا ہوں" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21593_2000_98_2020_9 ;
    minaret:refersTo minaret:Hadith_JT_3895 ;
    minaret:startTime 2000.98 .

