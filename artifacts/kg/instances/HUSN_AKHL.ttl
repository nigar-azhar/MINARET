    minaret:endTime 2544.5 ;
    minaret:evidenceText "خَصْلَتَانِ لَا تَجْتَمِعَانِ فِیْ مُنَافِقٍ: حُسْنُ سَمْتٍ وَّلَا فِقْهٌ فِی الدِّیْنِ" ;
