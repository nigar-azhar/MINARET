minaret:DuaOccurrence_HUSN_AKHL-21592_0004_138_02_MasnoonDua-118 a minaret:DuaOccurrence ;
    minaret:endTime 177.4 ;
    minaret:evidenceText "اَللّٰهُمَّ، اے اللہ! كَمَا، جیسا کہ، حَسَّنْتَ، تُو نے اچھا بنایا خوبصورت بنایا، خَلْقِیْ، میری خلق کو میری صورت کو میری شکل کو، فَحَسِّنْ، تُو اچھا بنا دے خوبصورت بنا دے، خُلُقِیْ، میرے خلق کو میرے اخلاق کو میری عادات کو" ;
    minaret:hasExtentType minaret:CompleteCitation ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21592_138_02_177_4 ;
    minaret:refersTo minaret:Dua_MasnoonDua-118 ;
    minaret:startTime 138.02 .

