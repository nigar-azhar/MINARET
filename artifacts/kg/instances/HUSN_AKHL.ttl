    minaret:evidenceText "اے اللہ! میری سب سے اچھے اخلاق کی طرف رہنمائی فرما، تیرے سوا اچھے اخلاق کی راہ کوئی نہیں دکھا سکتا، اور برے اخلاق کو مجھ سے دور کر دے، انہیں تیرے سوا مجھ سے کوئی اور دور نہیں کر سکتا" ;
    minaret:hasExtentType minaret:CompleteCitation ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21593_273_66_313_38 ;
    minaret:refersTo minaret:Dua_MasnoonDua-163 ;
    minaret:startTime 273.66 .

minaret:DuaOccurrence_HUSN_AKHL-21593_0006_373_52_MasnoonDua-163 a minaret:DuaOccurrence ;
    minaret:endTime 453.12 ;
    minaret:evidenceText "وَاهْدِنِیْ لِاَحْسَنِ الْاَخْلَاقِ لَا یَهْدِیْ لِاَحْسَنِهَا اِلَّاۤ اَنْتَ، وَاصْرِفْ عَنِّیْ سَیِّئَهَا لَا یَصْرِفُ عَنِّیْ سَیِّئَهَا اِلَّاۤ اَنْتَ" ;
    minaret:hasExtentType minaret:CompleteCitation ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21593_373_52_453_12 ;
    minaret:refersTo minaret:Dua_MasnoonDua-163 ;
    minaret:startTime 373.52 .

minaret:DuaOccurrence_HUSN_AKHL-21593_0007_2660_12_MasnoonDua-159 a minaret:DuaOccurrence ;
    minaret:endTime 2685.36 ;
    minaret:evidenceText "سُبْحَانَكَ اللّٰهُمَّ وَبِحَمْدِكَ، نَشْهَدُ اَنْ لَّاۤ اِلٰهَ اِلَّاۤ اَنْتَ، نَسْتَغْفِرُكَ وَنَتُوْبُ اِلَیْكَ" ;
    minaret:hasExtentType minaret:CompleteCitation ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21593_2660_12_2685_36 ;
    minaret:refersTo minaret:Dua_MasnoonDua-159 ;
