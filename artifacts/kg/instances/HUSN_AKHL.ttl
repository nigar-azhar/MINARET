    minaret:containsSegment minaret:Segment_HUSN_AKHL-21593_0049 ;
    minaret:endTime 929.24 ;
    minaret:startTime 909.64 .

minaret:SegmentGroup_HUSN_AKHL-21593_989_34_1009_18 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_HUSN_AKHL-21593_0053 ;
    minaret:endTime 1009.18 ;
