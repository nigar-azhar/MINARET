    minaret:endTime 1126.8 ;
    minaret:evidenceText "كَانَ خُلُقُهُ الْقُرْاٰنَ" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HUSN_AKHL-21590_1123_76_1126_8 ;
    minaret:refersTo minaret:Hadith_SM_746 ;
