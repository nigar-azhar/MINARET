    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0283 ;
    minaret:sequenceIndex 282 ;
    minaret:startTime 2919.92 ;
    minaret:text "میں کسی کے لیے کیوں کرتا ہوں مثلاً آپ اب بتائیے گا کہ آپ کو کیا اچھا نہیں لگتا لوگوں کے رویوں میں کیا اچھا" .

minaret:Segment_HUSN_AKHL-21590_0283 a minaret:TranscriptSegment ;
    minaret:endTime 2939.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0284 ;
    minaret:sequenceIndex 283 ;
    minaret:startTime 2930.06 ;
    minaret:text "نہیں لگتا بالکل نیچرل باتیں کریں کوئی بہت زیادہ لمبی چوڑی کوٹیشنز دینے کی ضرورت نہیں روڈنس کسی کی یا کسی کا" .

minaret:Segment_HUSN_AKHL-21590_0284 a minaret:TranscriptSegment ;
    minaret:endTime 2952.14 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0285 ;
    minaret:sequenceIndex 284 ;
    minaret:startTime 2939.98 ;
    minaret:text "ایروگینس اچھی نہیں لگتی بدزبانی اچھی نہیں لگتی کوئی کسی کی چغلی کرے تو اچھا نہیں لگتا کوئی ہمارے خلاف بات کر دے جھوٹ اچھا نہیں لگتا الزام تراشی اچھی نہیں لگتی" .

minaret:Segment_HUSN_AKHL-21590_0285 a minaret:TranscriptSegment ;
    minaret:endTime 2965.06 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0286 ;
    minaret:sequenceIndex 285 ;
    minaret:startTime 2952.66 ;
    minaret:text "غصے والے لوگ اچھے نہیں لگتے دوغلا پن جب وہ کسی کی ریسپیکٹ نہیں کرتے طعنہ دینا اچھا نہیں لگتا اگر یہ ساری باتیں جمع کر لی جائیں تو ان سب کو ایک لفظ میں کیسے کہیں گے" .

minaret:Segment_HUSN_AKHL-21590_0286 a minaret:TranscriptSegment ;
    minaret:endTime 2974.94 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0287 ;
    minaret:sequenceIndex 286 ;
    minaret:startTime 2965.72 ;
    minaret:text "کیا اچھا نہیں لگتا بد اخلاقی اچھی نہیں لگتی ان سب کے اوپر کیا ہے ایک ہی ٹھپہ لگا سکتے ہیں کہ یہ سب کچھ بد اخلاقی ہے" .

minaret:Segment_HUSN_AKHL-21590_0287 a minaret:TranscriptSegment ;
    minaret:endTime 2981.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0288 ;
    minaret:sequenceIndex 287 ;
    minaret:startTime 2975.68 ;
    minaret:text "اچھا کیا لگتا ہے چلیے یہ بھی بتا دیجیے کیونکہ حدیث میں یہ آیا ہے کہ" .

minaret:Segment_HUSN_AKHL-21590_0288 a minaret:TranscriptSegment ;
    minaret:endTime 2996.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0289 ;
    minaret:sequenceIndex 288 ;
    minaret:startTime 2982.04 ;
    minaret:text "جو خود کو اچھا لگتا ہے وہی دوسرے کے لیے چاہو وہی دوسرے کے ساتھ کرو جو تم کو اچھا لگتا ہے تو کیا اچھا لگتا ہے تمیز سے بات کرنا اچھا لگتا ہے اور ریسپیکٹ ٹھیک ہے چلیے ہوم ورک دے دوں" .

minaret:Segment_HUSN_AKHL-21590_0289 a minaret:TranscriptSegment ;
    minaret:endTime 3007.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0290 ;
    minaret:sequenceIndex 289 ;
    minaret:startTime 2997.72 ;
    minaret:text "ایک ہفتے میں نوٹ کیجیے کہ آپ کو کس کی کیا کیا باتیں اچھی نہیں لگیں ٹھیک ہے تین ایسی باتیں جو" .

minaret:Segment_HUSN_AKHL-21590_0290 a minaret:TranscriptSegment ;
    minaret:endTime 3016.42 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0291 ;
    minaret:sequenceIndex 290 ;
    minaret:startTime 3007.64 ;
    minaret:text "آپ کو کسی کے اندر اچھی نہیں لگیں اس سے معاملہ کرتے وقت یعنی آپ نے کسی سے معاملہ کیا اور اس نے" .

minaret:Segment_HUSN_AKHL-21590_0291 a minaret:TranscriptSegment ;
    minaret:endTime 3024.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0292 ;
    minaret:sequenceIndex 291 ;
    minaret:startTime 3017.08 ;
    minaret:text "ایسا کام کیا جس نے آپ کو ہرٹ کر دیا کسی سے بات کرتے وقت کسی سے لین دین کرتے وقت کسی سے ملاقات کرتے وقت" .

minaret:Segment_HUSN_AKHL-21590_0292 a minaret:TranscriptSegment ;
    minaret:endTime 3032.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0293 ;
    minaret:sequenceIndex 292 ;
    minaret:startTime 3025.24 ;
    minaret:text "کسی کے اندر کوئی ایسی چیز دیکھی جس سے طبیعت خراب ہوئی دیکھ کے فرسٹ ہینڈ ایکسپیرینس اس ہفتے کے اندر" .

minaret:Segment_HUSN_AKHL-21590_0293 a minaret:TranscriptSegment ;
    minaret:endTime 3041.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0294 ;
    minaret:sequenceIndex 293 ;
    minaret:startTime 3033.58 ;
    minaret:text "ہوم ورک کی ڈائری بالکل الگ بنائیں اور نوٹس لکھنے کی چیز بھی الگ تاکہ کچھ بھی پیچھے دیکھنا پڑے تو فوراً آپ نکال لیں" .

minaret:Segment_HUSN_AKHL-21590_0294 a minaret:TranscriptSegment ;
    minaret:endTime 3052.72 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0295 ;
    minaret:sequenceIndex 294 ;
    minaret:startTime 3041.94 ;
    minaret:text "اور یہ جو ہوم ورک ڈائری ہے ان شاء اللہ اس ڈائری کے نمبر بھی ہیں اور جب آپ کا ٹیسٹ ہوگا تو آپ سب سے یہ ڈائریاں کلیکٹ کر لی جائیں گی اور اس میں دیکھا جائے گا کہ آپ نے کیا لکھا" .

minaret:Segment_HUSN_AKHL-21590_0295 a minaret:TranscriptSegment ;
    minaret:endTime 3063.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0296 ;
    minaret:sequenceIndex 295 ;
    minaret:startTime 3053.4 ;
    minaret:text "سائز وہ ہو ڈائری کا جو آپ کے ہینڈ بیگ میں آ جائے اگر کتاب جتنا رکھ لیں تو بھی ٹھیک ہے اگر اس سے چھوٹا جو بیگ میں آ جائے۔ آج کے لیے تمہیدی ہی کا دن تھا" .

minaret:Segment_HUSN_AKHL-21590_0296 a minaret:TranscriptSegment ;
    minaret:endTime 3073.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0297 ;
    minaret:sequenceIndex 296 ;
    minaret:startTime 3063.4 ;
    minaret:text "بیسیکلی اور ان شاء اللہ ہم اس سے یہیں سے کنٹینیو کریں گے اور اس سبجیکٹ کو ہم پریکٹیکل بنائیں گے ٹھیک ہے ان شاء اللہ۔ سوال پھر دہرا دیتی" .

minaret:Segment_HUSN_AKHL-21590_0297 a minaret:TranscriptSegment ;
    minaret:endTime 3080.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0298 ;
    minaret:sequenceIndex 297 ;
    minaret:startTime 3073.5 ;
    minaret:text "ہوں کہ اگلے ہفتے کے دوران آپ جائزہ لیں گے اور مجھے اس سے پہلے کہ میں کلاس شروع کروں فیڈ بیک دیں گے" .

minaret:Segment_HUSN_AKHL-21590_0298 a minaret:TranscriptSegment ;
    minaret:endTime 3092.42 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0299 ;
    minaret:sequenceIndex 298 ;
    minaret:startTime 3081.14 ;
    minaret:text "تین ایسی باتیں جو آپ کو کسی کے اندر اچھی نہیں لگی تاکہ اس کی روشنی میں ہم اپنا جائزہ لے سکیں کہ ہمیں پھر خود کو کیا نہیں کرنا" .

minaret:Segment_HUSN_AKHL-21590_0299 a minaret:TranscriptSegment ;
    minaret:endTime 3100.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0300 ;
    minaret:sequenceIndex 299 ;
    minaret:startTime 3093.62 ;
    minaret:text "ایک چیز آپ کو بتا دوں کہ مطلوب کیا ہے آپ سے ٹیسٹ کس طرح ہوگا احادیث کا لفظی ترجمہ آنا چاہیے آپ کو ٹھیک ہے" .

minaret:Segment_HUSN_AKHL-21590_0300 a minaret:TranscriptSegment ;
    minaret:endTime 3111.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0301 ;
    minaret:sequenceIndex 300 ;
    minaret:startTime 3101.08 ;
    minaret:text "انشاءاللہ ہمارے جو یہاں روزانہ کے گروپس ہوتے ہیں اس میں آپ سے ترجمہ بھی سنا جائے گا کیونکہ قرآن پاک کا ترجمہ یاد کرنے کے بعد ان احادیث کا ترجمہ" .

minaret:Segment_HUSN_AKHL-21590_0301 a minaret:TranscriptSegment ;
    minaret:endTime 3118.7 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0302 ;
    minaret:sequenceIndex 301 ;
    minaret:startTime 3111.1 ;
    minaret:text "یاد کرنا مشکل نہیں تو آپ اس کی بھی پریکٹس کریں گے اور ایک دوسرے کو سنائیں گے تاکہ آپ اس کو یاد کر سکیں" .

minaret:Segment_HUSN_AKHL-21590_0302 a minaret:TranscriptSegment ;
    minaret:endTime 3128.24 ;
    minaret:sequenceIndex 302 ;
    minaret:startTime 3119.74 ;
    minaret:text "سُبْحَانَكَ اللّٰهُمَّ وَبِحَمْدِكَ، نَشْهَدُ اَنْ لَّاۤ اِلٰهَ اِلَّاۤ اَنْتَ، نَسْتَغْفِرُكَ وَنَتُوْبُ اِلَیْكَ۔ اَلسَّلَامُ عَلَیْكُمْ وَرَحْمَةُ اللّٰهِ وَبَرَكَاتُهٗ۔" .

minaret:Segment_HUSN_AKHL-21591_0001 a minaret:TranscriptSegment ;
    minaret:endTime 39.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0002 ;
    minaret:sequenceIndex 1 ;
    minaret:startTime 19.12 ;
    minaret:text "ایک دفعہ درود شریف پڑھ لیجیے۔ اَللّٰهُمَّ صَلِّ عَلٰی مُحَمَّدٍ وَّعَلٰۤی اٰلِ مُحَمَّدٍ كَمَا صَلَّیْتَ عَلٰۤی اِبْرٰهِیْمَ وَعَلٰۤی اٰلِ اِبْرٰهِیْمَ اِنَّكَ حَمِیْدٌ مَّجِیْدٌ ؕ اَللّٰهُمَّ" .

minaret:Segment_HUSN_AKHL-21591_0003 a minaret:TranscriptSegment ;
    minaret:endTime 79.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0004 ;
    minaret:sequenceIndex 3 ;
    minaret:startTime 59.18 ;
    minaret:text "خوبصورت اخلاق عمدہ اخلاق جو ہم سب کو اچھا لگتا ہے جو ہمیں اپنے اندر اپنانا ہے اور جس کے لئے ہمیں کوشش کے ساتھ ساتھ اللہ تعالیٰ سے دعا بھی کرنی ہے وہ مسنون دعا یاد بھی کرنی ہے جو اللہ کے رسول صلی اللہ علیہ" .

minaret:Segment_HUSN_AKHL-21591_0005 a minaret:TranscriptSegment ;
    minaret:endTime 118.82 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 99.08 ;
    minaret:text "اسی طرح تُو میرا اخلاق بھی اچھا بنا دے اخلاق جس کا روٹ مادہ خ، ل، ق ہے اگر اسے خلق پڑھا جائے تو مانا ہوتا ہے پیدا کرنا صورت گری کرنا اور اگر اس کو" .

minaret:Segment_HUSN_AKHL-21591_0006 a minaret:TranscriptSegment ;
    minaret:endTime 138.74 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 118.82 ;
    minaret:text "خلق پڑھا جائے یا خلق پڑھا جائے تو مراد ہوتی ہے عادت طبیعت خصلت اسی مادے سے خَلُقَ اگر ہو تو مانا ہوتا ہے پرانا ہونا بوسیدہ ہونا ان تین لفظوں میں آپس میں" .

minaret:Segment_HUSN_AKHL-21591_0007 a minaret:TranscriptSegment ;
    minaret:endTime 158.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 138.74 ;
    minaret:text "کیا مماثلت ہے خلق پیدائش کے لئے کسی چیز کو عدم سے وجود ملانا خلق عادت اور اس کی ظاہری شکل و صورت اور بوسیدہ ہونا یا پرانا ہونا کیا مانے رکھتا ہے کہ انسان کی وہ" .

minaret:Segment_HUSN_AKHL-21591_0008 a minaret:TranscriptSegment ;
    minaret:endTime 177.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 158.18 ;
    minaret:text "عادات اور انسان کا مزاج جو مسلسل ایک کام کے بعد پختہ ہو جاتا ہے وہی دراصل اس کی عادت یا اس کا اخلاق بنتا ہے ہم میں سے ہر شخص خوبصورتی پسند کرتا ہے شاید دنیا میں کوئی بھی ایسا شخص نہ ملے آپ کو" .

minaret:Segment_HUSN_AKHL-21591_0009 a minaret:TranscriptSegment ;
    minaret:endTime 197.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 177.8 ;
    minaret:text "جو یہ کہے کہ مجھے خوبصورت چیز اچھی نہیں لگتی خواہ وہ کسی کی شکل و صورت میں ہو یا وہ پھولوں میں ہو یا کائنات کی کسی بھی چیز میں جو اس کو نظر آتی ہوں یہی وجہ ہے کہ ہم میں سے ہر شخص اپنی ذات اور اپنی شکل و صورت اور اپنے حال حلیے کے بارے میں" .

minaret:Segment_HUSN_AKHL-21591_0010 a minaret:TranscriptSegment ;
    minaret:endTime 217.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 197.4 ;
    minaret:text "بہت کانشَس ہوتا ہے یعنی اپنی شکل و صورت کو سجانے اور سنوارنے اور اچھا لگنے اور اچھا نظر آنے کے لیے بہت سی محنت اور کوشش اور مال وغیرہ بھی خرچ کیا جاتا ہے اور اس میں ہم دیکھتے ہیں کہ ہم ظاہری شکل و" .

minaret:Segment_HUSN_AKHL-21591_0011 a minaret:TranscriptSegment ;
    minaret:endTime 237.2 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0012 ;
    minaret:sequenceIndex 11 ;
    minaret:startTime 217.4 ;
    minaret:text "صورت جو کہ نظر آتی ہے ہمیں خود بھی آئینہ دیکھنے پر اور دوسروں کو بھی نظر آتی ہے تو اس میں ہم اپنی صفائی ستھرائی کا خیال بھی رکھتے ہیں اور پھر صرف صفائی ستھرائی نہیں بلکہ میک اپ بھی اور پھر لباس اور صرف اچھا لباس نہیں بلکہ استری شدہ لباس اور" .

minaret:Segment_HUSN_AKHL-21591_0012 a minaret:TranscriptSegment ;
    minaret:endTime 257.2 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0013 ;
    minaret:sequenceIndex 12 ;
    minaret:startTime 237.2 ;
    minaret:text "اچھی طرح میچنگ لباس اور اسی طرح ڈائٹ ایکسرسائز اور بہت سی چیزیں ان کے بارے میں ہم کانشَس ہوتے ہیں لیکن یاد رکھئے کہ کوئی انسان صرف ظاہری شکل و صورت کی خوبصورتی سے خوبصورت نہیں بنا کرتا ظاہری خوبصورتی اگرچہ اٹریکٹ" .

minaret:Segment_HUSN_AKHL-21591_0013 a minaret:TranscriptSegment ;
    minaret:endTime 277.14 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0014 ;
    minaret:sequenceIndex 13 ;
    minaret:startTime 257.2 ;
    minaret:text "کرتی ہے دوسروں کے لئے کشش کا باعث ہوتی ہے لیکن انسان کی اصل خوبصورتی اس کی آدات میں ہے اس کے اخلاق میں ہے اس کے رویے میں ہے اس کے معاملات میں ہے اس کے اس طرز عمل میں ہے وہ جو دوسروں کے ساتھ اختیار کرتا ہے اور یہ چیز ایک دن میں" .

minaret:Segment_HUSN_AKHL-21591_0014 a minaret:TranscriptSegment ;
    minaret:endTime 296.78 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0015 ;
    minaret:sequenceIndex 14 ;
    minaret:startTime 277.14 ;
    minaret:text "نہیں بنتی جیسے کہ میں نے آپ کو بتایا کہ خلقہ کمانا ہوتا پرانا ہونا یعنی آدات کس طرح بنتی ہیں ایک چیز کو بار بار کرنے سے جب وہ چیزیں ہمارے اندر راسخ ہو جاتی ہیں جب وہ ہماری پسند و ناپسند کی شکل اختیار کر لیتی ہیں" .

minaret:Segment_HUSN_AKHL-21591_0015 a minaret:TranscriptSegment ;
    minaret:endTime 316.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0016 ;
    minaret:sequenceIndex 15 ;
    minaret:startTime 296.78 ;
    minaret:text "تو پھر بے اختیار ہم سے صادر ہونے لگتی ہیں جو چیزیں ہمارے نفس اور ہماری ذات اور ہماری سوچ اور ہمارے خیالات کا حصہ بن جاتی ہے پھر اس کو ظاہر ہونے میں کچھ دیر نہیں لگتی تو گویا اچھے اخلاق کے لیے صرف" .

minaret:Segment_HUSN_AKHL-21591_0016 a minaret:TranscriptSegment ;
    minaret:endTime 335.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0017 ;
    minaret:sequenceIndex 16 ;
    minaret:startTime 316.22 ;
    minaret:text "مصنوعی آرٹیفِیشل ظاہری اور وقتی کوششیں فائدہ نہ دیں گی جب تک کہ ہمارا اندر نہیں سنورتا جب تک یہ چیزیں اندر راسخ نہیں ہوتی جب تک ان کی اندر بنیاد نہیں بنتی اور جب تک ہم ان کو بار بار" .

minaret:Segment_HUSN_AKHL-21591_0017 a minaret:TranscriptSegment ;
    minaret:endTime 355.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0018 ;
    minaret:sequenceIndex 17 ;
    minaret:startTime 335.86 ;
    minaret:text "کرتے نہیں رہتے اس لئے ہم دیکھتے ہیں کہ امام غزالی رحمت اللہ علیہ نے فرمایا تھا کہ خلق اندر کی ایک مستقل کیفیت کا نام ہے یعنی وہ اخلاق کو باہر کی چیز نہیں بتاتے بلکہ اندر کی چیز بتاتے ہیں کہ خلق اندر کی ایک مستقل کیفیت کا نام ہے" .

minaret:Segment_HUSN_AKHL-21591_0018 a minaret:TranscriptSegment ;
    minaret:endTime 375.04 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0019 ;
    minaret:sequenceIndex 18 ;
    minaret:startTime 355.08 ;
    minaret:text "جس کے مطابق ہمارے اعمال ہوتے ہیں یعنی ہمارے رویے ہمارے اندر کی کیفیت کے تابع ہوتے ہیں تو اس میں تو کوئی شک نہیں کہ اچھی چیز ہر ایک کو اچھی لگتی ہے اور آپ دیکھئے کہ مختلف چیزوں کا انسان کے علاوہ بہترین" .

minaret:Segment_HUSN_AKHL-21591_0019 a minaret:TranscriptSegment ;
    minaret:endTime 394.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0020 ;
    minaret:sequenceIndex 19 ;
    minaret:startTime 375.04 ;
    minaret:text "پہلو خوبصورت پہلو کیا ہوتا ہے مثلا ایک درخت کی خوبصورتی قسم ہے اس کی ہریالی میں اگر درخت گرین نہ ہو سبز نہ ہو تو کیسا لگتا ہے لیکن جب بہار آتی ہے تو یہی درخت کیسا نظارہ پیش کرتے ہیں" .

minaret:Segment_HUSN_AKHL-21591_0020 a minaret:TranscriptSegment ;
    minaret:endTime 414.72 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0021 ;
    minaret:sequenceIndex 20 ;
    minaret:startTime 395.26 ;
    minaret:text "بالکل ایک مختلف ایک پھول کی خوبصورتی کس میں ہوتی صرف اس کے رنگ میں نہیں اس کی خوشبو میں پانی کی خوبصورتی کس میں ہوتی اس کی روانی میں یا جب وہ آئس بند کے سڑکوں پر پھسلنے کا ذریعہ بن جائے اس کی روانی میں چلتا پانی" .

minaret:Segment_HUSN_AKHL-21591_0021 a minaret:TranscriptSegment ;
    minaret:endTime 431.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0022 ;
    minaret:sequenceIndex 21 ;
    minaret:startTime 414.72 ;
    minaret:text "بہتا پانی ہمیشہ انسان کو اپنی طرف کھینچتا ہے کبھی سمندر کے کنارے جانے کے اتفاق ہوا ہوگا کبھی کسی بہتے دریا کو دیکھا ہوگا کبھی آبشاروں کو گرتے تو گویا کوئی بھی خوبصورت چیز یا کسی بھی چیز" .

minaret:Segment_HUSN_AKHL-21591_0022 a minaret:TranscriptSegment ;
    minaret:endTime 449.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 431.5 ;
    minaret:text "کا خوبصورت پہلو، جو اس کا ایک مستقل حصہ ہوتا ہے اور وہی اس کی خوبصورتی ہوتی ہے، اس سے انسان کبھی نہیں اکتاتا۔ اسی طرح انسان کی زندگی کا خوبصورت ترین پہلو یا انسانیت کا اعلیٰ ترین درجہ اس کے اچھے اخلاق میں ہے،" .

minaret:Segment_HUSN_AKHL-21591_0023 a minaret:TranscriptSegment ;
    minaret:endTime 469.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 449.32 ;
    minaret:text "جس سے اس کے آس پاس والے لوگ کبھی بھی نہیں اکتاتے کبھی بھی نہیں تھکتے اور وہ کھنچ کھنچ کر اس کی طرف چلتے چلے جاتے اسی لئے ہم دیکھتے ہیں کہ آپ صلی اللہ علیہ وآلہ وسلم جو اخلاق کے آلہ ترین مرتبے پر تھے آپ کا کیا حال تھا لوگوں کا آپ کے ساتھ کیا معاملہ تھا" .

minaret:Segment_HUSN_AKHL-21591_0024 a minaret:TranscriptSegment ;
    minaret:endTime 489.56 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 469.82 ;
    minaret:text "دوست تو دوست دشمن بھی آپ کی طرف کھنچتے چلے جاتے تھے آپ کی طرف مائل ہوتے آپ کے قریب آتے تھے آپ سے دور نہیں بھاگتے تھے تو ہمیں ایسا انسان بننا ہے کہ جو اللہ کا محبوب بھی ہو اور بندوں کا محبوب بھی جو بندوں کے لئے بھی اپنے اندر" .

minaret:Segment_HUSN_AKHL-21591_0025 a minaret:TranscriptSegment ;
    minaret:endTime 496.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 489.56 ;
    minaret:text "ایک کشش رکھتا ہو۔ یہ نہیں کہ اسے دیکھتے ہی لوگ بھاگ نکلیں۔ کیونکہ بندوں کو تو وقتی طور پر بندے بے وقوف بھی" .

minaret:Segment_HUSN_AKHL-21591_0026 a minaret:TranscriptSegment ;
    minaret:endTime 516.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 496.96 ;
    minaret:text "ایک بنا سکتے لیکن اللہ کو کوئی دھوکہ نہیں دے سکتا تو بندوں سے بڑھ کر ہمیں اپنے رب کی نظر میں خوبصورت بننا ہے اور جو اپنے رب کی نظر میں خوبصورت ہو جاتا ہے وہ خود بخود بندوں کا محبوب ہو جاتا ہے وہ پھر سب کے لئے خوشی کا باعث" .

minaret:Segment_HUSN_AKHL-21591_0027 a minaret:TranscriptSegment ;
    minaret:endTime 536.72 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 516.86 ;
    minaret:text "بن جاتا ہے حدیث سے ہمیں پتہ چلتا ہے کہ اللہ تعالیٰ کو بندے کے اندر جو چیز مطلوب ہوتی ہے وہ اللہ کا ڈر تقوی اور اچھا اخلاق کہ اندرونی کیفیت اس کی کیا ہو کہ وہ اللہ سے ڈرتا ہو اور بیرونی کیفیت کیا ہو کہ اس کی عادات" .

minaret:Segment_HUSN_AKHL-21591_0028 a minaret:TranscriptSegment ;
    minaret:endTime 551.78 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0029 ;
    minaret:sequenceIndex 28 ;
    minaret:startTime 536.72 ;
    minaret:text "اچھی ہوں تو یاد رکھئے کہ اخلاق صرف دوسروں کے ساتھ اچھا معاملہ کرنے کا نام نہیں اخلاق خود اپنے اندر اچھی عادات ایٹیکیٹس مینرز اور اچھے رکھ رکھاؤ کا نام بھی ہے یعنی" .

minaret:Segment_HUSN_AKHL-21591_0029 a minaret:TranscriptSegment ;
    minaret:endTime 561.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0030 ;
    minaret:sequenceIndex 29 ;
    minaret:startTime 551.78 ;
    minaret:text "خواہ آپ کسی کے ساتھ معاملہ کریں یا تنہائی میں ہوں، اکیلے ہوں، کوئی آپ کو دیکھنے والا نہ ہو، تو جب بھی آپ اسی طرح اچھے ہوں۔" .

minaret:Segment_HUSN_AKHL-21591_0035 a minaret:TranscriptSegment ;
    minaret:endTime 675.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0036 ;
    minaret:sequenceIndex 35 ;
    minaret:startTime 655.82 ;
    minaret:text "رسول صلی اللہ علیہ وسلم لہذا اگر کوئی شخص یہ چاہتا ہو کہ اس کا اخلاق اچھا ہو جائے تو اس کے لئے کیا ضروری ہے کہ وہ آپ کی پیروی کرے آپ کے اسوۂ حسنہ کو دیکھے اور آپ کے طریقوں کے مطابق اپنی زندگی کا طریقہ طے کرے" .

minaret:Segment_HUSN_AKHL-21591_0039 a minaret:TranscriptSegment ;
    minaret:endTime 754.54 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0040 ;
    minaret:sequenceIndex 39 ;
    minaret:startTime 734.56 ;
    minaret:text "بھاگ نکلیں خوف زدہ ہوں زید بن حارثہ کا نام تو آپ نے سنا ہوگا کون تھے زید بن حارثہ حارثہ کے بیٹھے تھے قبیلہ قلب سے تعلق رکھتے تھے ان کی والدہ کا نام سعدیٰ تھا، جسے سعدیہ لکھتے ہیں نا سعدیٰ، جو قبیلہ تیہ کی" .

minaret:Segment_HUSN_AKHL-21591_0040 a minaret:TranscriptSegment ;
    minaret:endTime 774.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0041 ;
    minaret:sequenceIndex 40 ;
    minaret:startTime 754.54 ;
    minaret:text "ایک ایک اور قبیلہ نے حملہ کیا اور جو کچھ ان کے پاس تھا یعنی ان کے میکے والوں کے پاس سب لوٹ کے لے گئے اور ان لوٹ کی چیزوں میں حضرت زید بھی تھے" .

minaret:Segment_HUSN_AKHL-21591_0041 a minaret:TranscriptSegment ;
    minaret:endTime 794.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0042 ;
    minaret:sequenceIndex 41 ;
    minaret:startTime 774.12 ;
    minaret:text "اس کے بعد انہوں نے عکاظ کے میلے میں جا کے بیچ دیا اس زمانے میں انسان بھی ایسے بکا کرتے تھے توفہ تن" .

minaret:Segment_HUSN_AKHL-21591_0042 a minaret:TranscriptSegment ;
    minaret:endTime 813.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0043 ;
    minaret:sequenceIndex 42 ;
    minaret:startTime 794.0 ;
    minaret:text "دے دیا جب حضرت خدیجہ کا نکاح آپ صلی اللہ علیہ وسلم سے ہوا تو آپ کو انہوں نے حضرت زید ہبا کر دیئے یعنی تحفے میں دے دیئے اس وقت حضرت زید کی عمر پندرہ سال تھی کچھ عرصے کے بعد زید کے باپ کو" .

minaret:Segment_HUSN_AKHL-21591_0043 a minaret:TranscriptSegment ;
    minaret:endTime 833.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0044 ;
    minaret:sequenceIndex 43 ;
    minaret:startTime 813.92 ;
    minaret:text "پتا چلا کہ ہمارا بیٹا مکہ میں اور فلان گھرانے کے پاس تو وہ اپنے بھائی کے ساتھ مکہ آئے اور آ کر حضرت صلی اللہ علیہ وسلم سے ملے اور کہا کہ آپ جو فدیہ لینا چاہیں لے لیں ہمارا بچہ ہمیں واپس کر دیں اور کہ اپنے بچے کے" .

minaret:Segment_HUSN_AKHL-21591_0044 a minaret:TranscriptSegment ;
    minaret:endTime 853.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0045 ;
    minaret:sequenceIndex 44 ;
    minaret:startTime 833.9 ;
    minaret:text "لیے کوئی شخص کتنا حریص ہو سکتا ہے آپ نے فرمایا کہ مجھے کوئی فدیہ نہیں چاہیے آپ بچے سے بات کر لیں اگر بچہ ساتھ جانا چاہے آپ اسے لے جائیں آپ نے زید کو بلایا اور کہا کہ تم انہیں پہچانتے ہو انہوں نے کہا کہ ہاں یہ میرے باپ ہیں یہ میرے چچا ہیں کیونکہ آٹھ سال کا بچہ سب جانتا" .

minaret:Segment_HUSN_AKHL-21591_0045 a minaret:TranscriptSegment ;
    minaret:endTime 873.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0046 ;
    minaret:sequenceIndex 45 ;
    minaret:startTime 853.8 ;
    minaret:text "ہوتا ہے آپ نے فرمایا یہ لوگ تمہیں لے جانا چاہتے ہیں اگر تم چاہو تو اپنے گھر واپس جا سکتے اپنے والد اور چچا کے ساتھ تو زید نے کیا جواب دیا میں آپ کو چھوڑ کر کہیں نہیں جاؤں گا کسی دوسری جگہ" .

minaret:Segment_HUSN_AKHL-21591_0046 a minaret:TranscriptSegment ;
    minaret:endTime 894.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0047 ;
    minaret:sequenceIndex 46 ;
    minaret:startTime 874.74 ;
    minaret:text "یہ سن کر باپ اور چچا کا کیا حال ہو سکتا تھا وہ بہت ناراض گئے انہوں نے برا بلا بھی کہا کہ تم آزادی کو چھوڑ کر غلامی پسند کر رہے ہو اپنوں کو چھوڑ کر غیروں کے پاس رہنا چاہتے ہو تو زید نے کیا کہا کہ میں نے محمد صلی اللہ علیہ وسلم کی اندر جو خوبیاں دیکھی ہیں میں نے" .

minaret:Segment_HUSN_AKHL-21591_0047 a minaret:TranscriptSegment ;
    minaret:endTime 913.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0048 ;
    minaret:sequenceIndex 47 ;
    minaret:startTime 894.66 ;
    minaret:text "آپ کے اندر جو خوبیاں دیکھی ہیں ان کے بعد میں آپ پر کسی اور کو ترجیح نہیں دے سکتا حتیٰ کہ اپنے باپ اور چچا کو بھی نہیں دے سکتا میں آپ کے ساتھ نہیں جانا چاہتا میں محمد صلی اللہ علیہ وسلم کے پاس ہی رہوں گا اس پر آپ صلی اللہ علیہ وسلم نے ان کو آزاد کر کے" .

minaret:Segment_HUSN_AKHL-21591_0048 a minaret:TranscriptSegment ;
    minaret:endTime 933.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0049 ;
    minaret:sequenceIndex 48 ;
    minaret:startTime 913.86 ;
    minaret:text "اپنا منہ بولا بیٹا بنا لیا اور اگرچہ یہ واقعہ نبوت سے پہلے کا ہے لیکن یہ اس آیت کی بہترین تفسیر کرتا ہے کہ آپ کا اخلاق کیا تھا آپ کیسے تھے کہ جو ایک اجنبی کے لیے اپنے ماں باپ سے بھی" .

minaret:Segment_HUSN_AKHL-21591_0049 a minaret:TranscriptSegment ;
    minaret:endTime 952.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0050 ;
    minaret:sequenceIndex 49 ;
    minaret:startTime 933.64 ;
    minaret:text "زیادہ عزیز وہ کیا رویہ ہوگا وہ کیا اخلاق ہوگا وہ کیا طریقہ ہوگا کہ جس کی وجہ سے وہ آپ کو چھوڑ کر کہیں نہیں جانا چاہتے آج ہم اپنے بچوں سے پوچھیں کہ وہ ہمارے ساتھ کتنا رہنا چاہتے" .

minaret:Segment_HUSN_AKHL-21591_0050 a minaret:TranscriptSegment ;
    minaret:endTime 954.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0051 ;
    minaret:sequenceIndex 50 ;
    minaret:startTime 952.64 ;
    minaret:text "وہ ہمارے بارے میں کیا" .

minaret:Segment_HUSN_AKHL-21591_0051 a minaret:TranscriptSegment ;
    minaret:endTime 983.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0052 ;
    minaret:sequenceIndex 51 ;
    minaret:startTime 954.92 ;
    minaret:text "سوچتے ہیں؟ وہ ہمارے بارے میں کیا کہتے ہیں؟ ہم ان کی نظر میں کیسے ہیں؟ ایک شخص باہر کے لوگوں کی نظر میں تو ہیرو ہو سکتا ہے، اس کے دوست احباب اس کو چاہنے والے ہو سکتے ہیں، وہ ہر ایک کی آنکھوں کا تارا ہو سکتا ہے، لیکن وہ اصل میں کیا ہے، اس کی حقیقت کیا ہے، اس کا اخلاق کیا ہے، اس کا اصل فیصلہ کون کرتا ہے؟" .

minaret:Segment_HUSN_AKHL-21591_0052 a minaret:TranscriptSegment ;
    minaret:endTime 1003.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0053 ;
    minaret:sequenceIndex 52 ;
    minaret:startTime 983.5 ;
    minaret:text "سوچتے اس کے قریب ترین لوگ بچے شوہر یا پھر بچوں کے لئے ماں باپ کہ انسان ان کی نظر میں کیا مقام رکھتا ہے تو انشاءاللہ ہم اس پر بھی آئندہ ایکسرسائز کریں گے کہ ہمارے بچے" .

minaret:Segment_HUSN_AKHL-21591_0053 a minaret:TranscriptSegment ;
    minaret:endTime 1022.88 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0054 ;
    minaret:sequenceIndex 53 ;
    minaret:startTime 1003.12 ;
    minaret:text "ہمارے بارے میں کیا کہتے ہیں ماں باپ اور بچوں کے درمیان اللہ نے ایک عجیب سی محبت رکھی یہ رشتے ایسے ہیں کہ ایک دوسرے کے ساتھ کچھ بھی کریں پھر ان کے اندر ایک خون کی کشش ہوتی پھر جڑ جاتے لیکن اپنے بچوں کے بعد وہ لوگ جو قریب" .

minaret:Segment_HUSN_AKHL-21591_0054 a minaret:TranscriptSegment ;
    minaret:endTime 1042.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0055 ;
    minaret:sequenceIndex 54 ;
    minaret:startTime 1022.88 ;
    minaret:text "ترین ہیں مثلا رشتے داروں کے بچے یا ہماری مثلا بہو یا بھانجی بھتیجی یا اور کوئی بھی شخص جو ہمارے ساتھ رہتا ہو کیونکہ انسان کے زندگی میں مختلف لوگوں کا ساتھ ہوتا ہے ہمارے ساتھ کام کرنے والے اگر ہم کسی ایک" .

minaret:Segment_HUSN_AKHL-21591_0055 a minaret:TranscriptSegment ;
    minaret:endTime 1062.48 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0056 ;
    minaret:sequenceIndex 55 ;
    minaret:startTime 1042.58 ;
    minaret:text "ادارے میں کام کریں کسی سکول میں کام کریں کسی ورک پلیس پر تو وہ لوگ ہمارے بارے میں کیا کہتے ہیں جن کے ساتھ ہمارے دن کا ایک بڑا حصہ گزرتا ہے مختلف لوگ جو کہیں بھی اکٹھے رہتے ہیں کسی بھی وجہ سے خواہ کوئی ہاسٹل ہو خواہ کوئی گھر ہو خواہ کوئی ادارہ ہو وہ آپس میں ایک دوسرے کے" .

minaret:Segment_HUSN_AKHL-21591_0056 a minaret:TranscriptSegment ;
    minaret:endTime 1074.04 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0057 ;
    minaret:sequenceIndex 56 ;
    minaret:startTime 1062.48 ;
    minaret:text "بارے میں کیا سوچتے ہیں آپ کا اصل مقام وہ نہیں جو آپ اپنے لئے خود اپنی نگاہوں میں قائم کیے ہوئے اپنے آپ کو تو ہر شخص اچھا ہی کہتا خود کو تو آپ" .

minaret:Segment_HUSN_AKHL-21591_0057 a minaret:TranscriptSegment ;
    minaret:endTime 1086.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0058 ;
    minaret:sequenceIndex 57 ;
    minaret:startTime 1074.04 ;
    minaret:text "اچھا ہی سمجھیں گے۔ لیکن آپ کے ساتھی کیا کہتے ہیں؟ آپ کے دوست کیا کہتے ہیں؟ آپ کے شوہر کیا کہتے ہیں؟ آپ کے بچے کیا کہتے ہیں؟ اور اگر ان کی" .

minaret:Segment_HUSN_AKHL-21591_0058 a minaret:TranscriptSegment ;
    minaret:endTime 1106.36 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 1086.6 ;
    minaret:text "گواہ آپ کے حق میں مثبت ہو گئی تو انشاءاللہ اللہ کی نگاہ میں بھی مقام بن جائے کیونکہ اللہ کی نگاہ میں ہم کیا ہیں یہ تو کل ہمیں پتہ چلے گا آج نہیں پتہ چل سکتا حضرت زید جو تھے وہ غلام تھے خون کا رشتہ نہیں تھا لیکن آج جن" .

minaret:Segment_HUSN_AKHL-21591_0059 a minaret:TranscriptSegment ;
    minaret:endTime 1124.94 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0060 ;
    minaret:sequenceIndex 59 ;
    minaret:startTime 1106.36 ;
    minaret:text "گھروں میں ملازم ہیں جہاں جہاں بھی وہاں ان کا ملازموں کے ساتھ کیا روی ہے اور ملازم اپنے مالکوں کے بارے میں کیا کہتے ہیں تو ہم سب کے لیے ایک ٹیسٹ ہے کہ ہم قریب ترین لوگوں کے ساتھ کیسے ہیں" .

minaret:Segment_HUSN_AKHL-21591_0060 a minaret:TranscriptSegment ;
    minaret:endTime 1145.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0061 ;
    minaret:sequenceIndex 60 ;
    minaret:startTime 1125.9 ;
    minaret:text "کیونکہ یہاں آپ صلی اللہ علیہ وسلم کی جو خوبی بیان کی گئی ہے وہ کیا ہے اگر تم تندخو ہوتے سنگ دل ہوتے سخت دل ہوتے یہ سب تمہارے آس پاس سے چھٹ جاتے بھاگ جاتے تمہیں چھوڑ جاتے حدیث نمبر ایک:" .

minaret:Segment_HUSN_AKHL-21591_0063 a minaret:TranscriptSegment ;
    minaret:endTime 1198.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0064 ;
    minaret:sequenceIndex 63 ;
    minaret:startTime 1178.64 ;
    minaret:text "چیز بھی باقی نہ رہے گویا اچھا اخلاق اعلیٰ اخلاق اور پھر اخلاق بھی مکمل اخلاق دنیا کے مختلف مذاہب میں مختلف اقوام میں مختلف لوگوں کے ہاں اخلاق کے بارے میں بہت کچھ لکھا پڑھا اور" .

minaret:Segment_HUSN_AKHL-21591_0064 a minaret:TranscriptSegment ;
    minaret:endTime 1218.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0065 ;
    minaret:sequenceIndex 64 ;
    minaret:startTime 1198.46 ;
    minaret:text "کہا گیا ہے یعنی بیسک ہیومن ایتکس پڑھے لکھے ان پڑھ لوگوں جاہل عالم مشرق مغرب ملتا ہے یعنی کوئی بھی انسان اس تصور سے خالی نہیں ہے لیکن ادھوری باتیں ہیں" .

minaret:Segment_HUSN_AKHL-21591_0065 a minaret:TranscriptSegment ;
    minaret:endTime 1237.98 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0066 ;
    minaret:sequenceIndex 65 ;
    minaret:startTime 1218.16 ;
    minaret:text "کہیں سے بھی کچھ پڑھ لیجیے اگر اخلاق کی ایک جامع اور مکمل تصویر کہیں ملتی ہے تو وہ اللہ کے رسول کی اپنی زندگی میں اور آپ کی تعلیمات میں کیونکہ آپ کو بھیجا اس لئے گیا کہ آپ اچھے اخلاق کی تکمیل کر دیں کوئی ایک بات بھی اس میں سے نہ" .

minaret:Segment_HUSN_AKHL-21591_0066 a minaret:TranscriptSegment ;
    minaret:endTime 1257.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0067 ;
    minaret:sequenceIndex 66 ;
    minaret:startTime 1237.98 ;
    minaret:text "رہے باقی پورے کا پورا دے دیں کیونکہ آپ دیکھیں کہ کوئی بھی اچھی سے اچھی تصویر اگر ادھوری ہو تو کیسی لگتی کوئی بھی تصویر کوئی بھی چیز کوئی بھی کام مثلا آپ اپنا کمرہ سجا رہے اور ایک دیوار پہ پینٹ نہیں ہوا یا کوئی ایک چیز" .

minaret:Segment_HUSN_AKHL-21591_0067 a minaret:TranscriptSegment ;
    minaret:endTime 1276.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0068 ;
    minaret:sequenceIndex 67 ;
    minaret:startTime 1257.5 ;
    minaret:text "نہیں ہے تو آپ کسی کو دکھا رہے تو سب سے پہلے آپ کیا کریں گے آپ باقی دیکھئے اس کو نہ دیکھئے یہ ابھی ایک چیز رہ گئی ہے باقی یہ جلد ہو جائے گی اسی طرح کسی بھی چیز میں کوئی کمی رہ جائے تو ہم پہلے کمی والے حصے کو بیان کرنے لگتے ہیں کہ آپ اس کو چھوڑیں باقی دیکھیں" .

minaret:Segment_HUSN_AKHL-21591_0069 a minaret:TranscriptSegment ;
    minaret:endTime 1314.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0070 ;
    minaret:sequenceIndex 69 ;
    minaret:startTime 1297.5 ;
    minaret:text "نے بیان کی ہے انشاءاللہ جو ان احادیث میں راوی آئیں گے ان میں سے کچھ رواعت کے بارے میں بھی آپ کو بتا جائے گا کیونکہ اللہ کے رسول صلی اللہ علیہ وسلم کے بعد آپ کے صحابہ ہمارے لئے ایک بہترین نمونہ ہے کیونکہ آپ نے ان کے" .

minaret:Segment_HUSN_AKHL-21591_0070 a minaret:TranscriptSegment ;
    minaret:endTime 1343.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0071 ;
    minaret:sequenceIndex 70 ;
    minaret:startTime 1314.8 ;
    minaret:text "اخلاق کی تربیت کی، وہ آپ کے تربیت یافتہ ہیں، آپ کی پراڈکٹ ہیں۔ کیونکہ انسان اپنے بعد کس سے پہچانا جاتا ہے؟ اپنے کام سے، اپنی پراڈکٹ سے۔ کوئی شخص اپنی تحریر کے آئینے میں پہچانا جاتا ہے، کوئی اپنی شعر و شاعری کے آئینے میں، کوئی کسی اور انوینشن کے آئینے میں، کہ کون کیا ہے، اس کا کام کیا ہے، اس نے تیار کیا کیا ہے۔" .

minaret:Segment_HUSN_AKHL-21591_0071 a minaret:TranscriptSegment ;
    minaret:endTime 1363.3 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0072 ;
    minaret:sequenceIndex 71 ;
    minaret:startTime 1343.3799999999999 ;
    minaret:text "اخلاق تاہیے دیکھتے ہیں کہ وہ لوگ جو علم حنر سے آری تھے انہیں آپ نے کیا دیا آپ کا نام دور جاہلیت میں عبد شمس تھا۔ عبد شمس کا کیا معنی ہوتا ہے؟ شمس کا غلام۔ جب آپ مسلمان ہونے کے لئے آپ صلی اللہ علیہ وسلم کے پاس حاضر ہوئے تو" .

minaret:Segment_HUSN_AKHL-21591_0072 a minaret:TranscriptSegment ;
    minaret:endTime 1383.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0073 ;
    minaret:sequenceIndex 72 ;
    minaret:startTime 1363.3 ;
    minaret:text "آپ نے نام پوچھا عرض کیا فرمایا نہیں آج سے تمہارا نام عبد الرحمن ہے رحمان کا بندہ عرض کیا یا رسول اللہ صلی اللہ علیہ وسلم میرے ما باپ آپ پہ قربان آپ کا تجویز کردہ نام مجھے زیادہ پسند ہے یعنی فورا" .

minaret:Segment_HUSN_AKHL-21591_0073 a minaret:TranscriptSegment ;
    minaret:endTime 1402.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0074 ;
    minaret:sequenceIndex 73 ;
    minaret:startTime 1383.12 ;
    minaret:text "قبول کر لیا کنیت ابو حرارہ تھی یعنی نام ابو حرارہ نہیں کیا تھی کہ بچپن میں بلی سے بہت کھیلتے تھی تو ان کے ساتھی ان کو ابو حرارہ بلیوں کے باپ یہ" .

minaret:Segment_HUSN_AKHL-21591_0074 a minaret:TranscriptSegment ;
    minaret:endTime 1423.54 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0075 ;
    minaret:sequenceIndex 74 ;
    minaret:startTime 1403.72 ;
    minaret:text "کہا کرتے ہریرہ ہر سے ہے، ہر بلے کو کہتے ہیں اور پھر ہریرہ یعنی چھوٹا بلی کا بچونگڑا۔ آپ صلی اللہ علیہ وسلم کبھی کبھی ان کو پیار سے ابو حر کہتے ابو حرارہ کی بجے کیا کہتے ابو حر تو ان کو بھی اپنے لئے ابو حرارہ سے زیادہ" .

minaret:Segment_HUSN_AKHL-21591_0075 a minaret:TranscriptSegment ;
    minaret:endTime 1443.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0076 ;
    minaret:sequenceIndex 75 ;
    minaret:startTime 1423.54 ;
    minaret:text "ابو حر کہنا پسند تھا بھار حضرت طفیل بن عمرو الدوسی کی وساطت سے اسلام قبول کیا تھا دوس کے قبیلے سے تعلق رکھ دوس کہاں تھا یمن میں ہجرت کے چھ سال" .

minaret:Segment_HUSN_AKHL-21591_0076 a minaret:TranscriptSegment ;
    minaret:endTime 1458.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0077 ;
    minaret:sequenceIndex 76 ;
    minaret:startTime 1443.4 ;
    minaret:text "بعد تک وہ اپنے قبیلے میں ہی رہے آپ کے پاس نہیں آسکے پھر آپ کی قوم کا قبیلہ دوس کا ایک وفد آپ کے پاس آیا تو یہ اس وفد میں آپ کے پاس آئے اور پھر واپس نہیں گئے اور اپنے آپ" .

minaret:Segment_HUSN_AKHL-21591_0077 a minaret:TranscriptSegment ;
    minaret:endTime 1481.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0078 ;
    minaret:sequenceIndex 77 ;
    minaret:startTime 1458.32 ;
    minaret:text "کو رسول اللہ صلی اللہ علیہ وسلم کی خدمت کے لیے وقف کر دیا۔ ہر وقت دن رات مسجد میں رہتے تھے، اور مسجد سے مراد یہاں مسجد کا وہ حصہ جو صفہ کے نام سے مشہور تھا، اور اصحابِ صفہ میں حضرت ابو ہریرہ بھی شامل تھے۔ جب تک نبی صلی اللہ علیہ وسلم زندہ رہے آپ نے شادی نہیں کی۔" .

minaret:Segment_HUSN_AKHL-21591_0078 a minaret:TranscriptSegment ;
    minaret:endTime 1501.48 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0079 ;
    minaret:sequenceIndex 78 ;
    minaret:startTime 1481.58 ;
    minaret:text "آپ کے ساتھ آپ کی بڑی والدہ بھی تھی والدہ نے اسلام نہیں قبول کیا اور وہ حضرت ابو حرارہ کو بار بار اسی پہ اکساتی کہ تم واپس اپنے دین میں لوٹو اور بہت ناراض ہوتی اور ایک روز تو اتنا زیادہ برا بھلا کہا ابو حرارہ کو اسلام لانے پر کہ روتے ہوئے آپ کی خدمت پہ پہنچے اور آپ سے ارز کیا کہ اللہ کے" .

minaret:Segment_HUSN_AKHL-21591_0079 a minaret:TranscriptSegment ;
    minaret:endTime 1514.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0080 ;
    minaret:sequenceIndex 79 ;
    minaret:startTime 1501.48 ;
    minaret:text "رسول میری والدہ اسلام کے بارے میں بہت بری بری باتیں کرتی ہیں آپ ان کے لئے دعا کریں تو آپ صلی اللہ علیہ وسلم نے ان کی والدہ کے لئے دعا کی ابو حرارہ آپ کی مجلس سے" .

minaret:Segment_HUSN_AKHL-21591_0080 a minaret:TranscriptSegment ;
    minaret:endTime 1525.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0081 ;
    minaret:sequenceIndex 80 ;
    minaret:startTime 1514.08 ;
    minaret:text "سے اٹھ کر جب گھر واپس گئے تو پتہ چلا کہ والدہ غسل لے رہی ہیں۔ بہرحال جب کپڑے وغیرہ پہن کر سامنے آئیں تو خود ہی پکار اٹھیں: اَشْهَدُ اَنْ لَّاۤ اِلٰهَ اِلَّا اللّٰهُ وَاَشْهَدُ اَنَّ مُحَمَّدًا عَبْدُهٗ وَرَسُوْلُهٗ۔" .

minaret:Segment_HUSN_AKHL-21591_0081 a minaret:TranscriptSegment ;
    minaret:endTime 1540.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0082 ;
    minaret:sequenceIndex 81 ;
    minaret:startTime 1525.46 ;
    minaret:text "اٹھ حضرت ابو حرارہ اسی وقت الٹے پاؤں واپس جاتے ہیں اور آپ کو جا کر خوش خبری سناتے ہیں اور خوشی اور ایک جذبات کی شدت کے ساتھ رو رہے ہوتے پہلے روتے ہوئے نکلے تھے غم کے ساتھ اور اب روتے" .

minaret:Segment_HUSN_AKHL-21591_0082 a minaret:TranscriptSegment ;
    minaret:endTime 1553.94 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0083 ;
    minaret:sequenceIndex 82 ;
    minaret:startTime 1540.64 ;
    minaret:text "ہوئے نکلے خوشی کے ساتھ۔ حضرت ابو ہریرہ کی ایک خاص خوبی اور خصوصیت یہ تھی کہ وہ نبی صلی اللہ علیہ وسلم کو بے حد چاہتے تھے، بہت زیادہ آپ سے محبت کرتے تھے۔ اور سوائے اس کے کہ وہ آپ اپنے گھر میں" .

minaret:Segment_HUSN_AKHL-21591_0083 a minaret:TranscriptSegment ;
    minaret:endTime 1564.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0084 ;
    minaret:sequenceIndex 83 ;
    minaret:startTime 1553.94 ;
    minaret:text "ہوئے تشریف لاتے کسی وقت بھی آپ سے الگ نہیں ہوتے تھے کہ مسلسل آپ سے سیکھتے تھے جب آپ اپنے گھر تشریف لے جاتے تو اس وقت پھر وہ مذاکرہ کیا کرتے تھے جو کچھ سیکھا ہوتا تھا اس" .

minaret:Segment_HUSN_AKHL-21591_0084 a minaret:TranscriptSegment ;
    minaret:endTime 1583.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0085 ;
    minaret:sequenceIndex 84 ;
    minaret:startTime 1564.66 ;
    minaret:text "کو دہراتے تھے۔ اکثر فرمایا کرتے تھے کہ میں نے رسول اللہ صلی اللہ علیہ وسلم سے بڑھ کر حسین چہرہ کسی کا بھی نہیں دیکھا۔ اور ابو ہریرہ کے اکثر الفاظ یہ ہوا کرتے تھے: سب تعریفیں اللہ کے لیے جس نے ابو ہریرہ کو اسلام قبول کرنے کی توفیق دی، سب تعریفیں" .

minaret:Segment_HUSN_AKHL-21591_0085 a minaret:TranscriptSegment ;
    minaret:endTime 1603.78 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0086 ;
    minaret:sequenceIndex 85 ;
    minaret:startTime 1583.92 ;
    minaret:text "کو اس اللہ کے لیے جس نے ابو حرارہ کو قرآن مجید کا علم تا کیا سب تعریف میں اس اللہ کے لیے جس نے ابو حرارہ کو محمد صلی اللہ علیہ وسلم کا صحابی ہونے کا شرف بخش یعنی ان تین باتوں پر اپنے اسلام پر قرآن کے علم پر اور آپ کے ساتھی بننے پر بار" .

minaret:Segment_HUSN_AKHL-21591_0086 a minaret:TranscriptSegment ;
    minaret:endTime 1623.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0087 ;
    minaret:sequenceIndex 86 ;
    minaret:startTime 1603.78 ;
    minaret:text "بار شکر کیا کرتے تھے یعنی ان کا جیسے ایک ورد تھا یہ کہ ان نعمتوں پر سب سے زیادہ خوش ہوتے اور اسی وجہ سے آپ کے اندر دین کا علم حاصل کرنے کی ایک دھن سمائی ہوئی تھی حضرت زید بن ثابت بیان کرتے ہیں کہ میں ابو حریرہ اور ہمارے ایک اور ساتھ یہ" .

minaret:Segment_HUSN_AKHL-21591_0087 a minaret:TranscriptSegment ;
    minaret:endTime 1642.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0088 ;
    minaret:sequenceIndex 87 ;
    minaret:startTime 1623.8600000000001 ;
    minaret:text "بڑا دلچسپ واقعہ ہے ہم تینوں اللہ کے حضور بیٹھ کے دعائیں کر رہے تھے یعنی تینوں ساتھی بیٹھے ہوئے تھے باتیں کرتے کرتے دعا مانگنے لگے اچانک حضور صلی اللہ علیہ وسلم تشریف لے آئے اور وہ بھی ہمارے پاس بیٹھ گئے یعنی یہ تین دوست تھے اور آپ بھی آگئے ہم خاموش ہوگئے آپ" .

minaret:Segment_HUSN_AKHL-21591_0088 a minaret:TranscriptSegment ;
    minaret:endTime 1654.98 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0089 ;
    minaret:sequenceIndex 88 ;
    minaret:startTime 1642.6 ;
    minaret:text "کے ادب میں۔ آپ نے فرمایا: اپنا کام جاری رکھو، جو کر رہے تھے کرتے رہو۔ ابو ہریرہ رضی اللہ تعالیٰ عنہ سے پہلے ان دو ساتھیوں نے اپنی اپنی دعائیں کیں، خوب اچھی اچھی چیزیں مانگیں۔ اب دیکھیں کہ صحابہ کرام مل جل کے کیسی باتیں کرتے تھے اور کس قسم کی ان کی گفتگو ہوتی تھی۔ آخری باری یعنی تیسری باری جو تھی وہ حضرت ابو ہریرہ" .

minaret:Segment_HUSN_AKHL-21591_0089 a minaret:TranscriptSegment ;
    minaret:endTime 1674.88 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0090 ;
    minaret:sequenceIndex 89 ;
    minaret:startTime 1654.98 ;
    minaret:text "کی تو کہتے ہیں الہی میں تجھ سے وہی مانگتا ہوں جو میرے ان دو ساتھیوں نے مانگا اور اس سے زائد یہ کہ مجھے ایسا علم" .

minaret:Segment_HUSN_AKHL-21591_0090 a minaret:TranscriptSegment ;
    minaret:endTime 1694.54 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0091 ;
    minaret:sequenceIndex 90 ;
    minaret:startTime 1674.88 ;
    minaret:text "دے جو کبھی نہ بھولے یعنی جو کہ چنہ نہ مانگا میری بھی وہی دعا ہے وہ سب بھی میرا لیکن اس سے زائد مجھے یہ عطا کر دے رسول اللہ نے آمین کہا تو دوسرے دو ساتھی کہتے ہیں ہم بھی یہی دعا مانگتے ہیں جو ابو حریرہ نے" .

minaret:Segment_HUSN_AKHL-21591_0091 a minaret:TranscriptSegment ;
    minaret:endTime 1714.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0092 ;
    minaret:sequenceIndex 91 ;
    minaret:startTime 1694.54 ;
    minaret:text "مانگی تو آپ نے فرمایا یہ دوسی نوجوان تم سے آگے نکل گیا ہے کیونکہ انسان مانگتا بھی کیا ہے جس کی اس کے دل میں تڑپ ہوتی اور شوق ہوتا ہے جس سے آپ اندازہ لگا سکتے ہیں کہ اللہ رسول کی محبت نے ان کو کیا شوق دیئے ہم سب بھی دعویٰ" .

minaret:Segment_HUSN_AKHL-21591_0092 a minaret:TranscriptSegment ;
    minaret:endTime 1733.36 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0093 ;
    minaret:sequenceIndex 92 ;
    minaret:startTime 1714.5 ;
    minaret:text "کرتے ہیں کہ میں اللہ سے محبت ہے نبی صلی اللہ سے محبت ہے لیکن اس محبت کا نتیجہ اور خلاصہ کیا ہے کہ پھر ہماری دعائیں کس قسم کی بہرحال حضرت ابو حرارہ نے علم کے راستے میں اپنے مقصد کے لیے پھر تکلیفیں بھی بہت اٹھائیں اور سب سے وڑھ کر بھوک اور پیاس" .

minaret:Segment_HUSN_AKHL-21591_0093 a minaret:TranscriptSegment ;
    minaret:endTime 1753.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0094 ;
    minaret:sequenceIndex 93 ;
    minaret:startTime 1734.52 ;
    minaret:text "کیونکہ ان کے پاس کوئی وقت نہیں اور بعض وقت میرے پیٹ میں بھل پڑھ لگتے تو میں کسی سے کہہ نہیں سکتا تھا کہ میں بھوکا ہوں لیکن میں" .

minaret:Segment_HUSN_AKHL-21591_0096 a minaret:TranscriptSegment ;
    minaret:endTime 1786.42 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0097 ;
    minaret:sequenceIndex 96 ;
    minaret:startTime 1776.58 ;
    minaret:text "بے تاب ہو رہا تھا تو اتنے میں حضرت ابو بکر گزرے میں نے ان سے قرآن کی ایک آیت کا مطلب پوچھا تو وہ بتا کے چل دیئے انہوں نے میری طرف صحیح طرح دیکھا نہیں انہیں پتہ نہیں چلا کہ میں کیا" .

minaret:Segment_HUSN_AKHL-21591_0097 a minaret:TranscriptSegment ;
    minaret:endTime 1815.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0098 ;
    minaret:sequenceIndex 97 ;
    minaret:startTime 1786.42 ;
    minaret:text "چاہتا ہوں۔ عمر گزرے، ان سے میں نے پوچھا، وہ بھی بتا کے چل دیے۔ اتنے میں آپ صلی اللہ علیہ وسلم گزرے۔ جب میں نے آپ کو بتایا تو آپ نے پہچان لی میری کیفیت اور کہا کہ: ابو ہریرہ! میں نے کہا: لبیک یا رسول اللہ صلی اللہ علیہ وسلم! آپ نے فرمایا: میرے ساتھ چلو۔ یعنی آپ کو پتہ چل گیا کہ ابو ہریرہ اس وقت کس کیفیت میں ہیں۔ کہا میرے ساتھ چلو۔ ساتھ چل دیے۔ جب میں گھر داخل ہوا آپ کے ساتھ تو گھر میں دودھ کا صرف ایک پیالہ" .

minaret:Segment_HUSN_AKHL-21591_0098 a minaret:TranscriptSegment ;
    minaret:endTime 1834.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0099 ;
    minaret:sequenceIndex 98 ;
    minaret:startTime 1815.0 ;
    minaret:text "چاہتا تو مجھے کہتے کہ جاؤ صحاب صفحہ کو بلالو میں پریشان ہو گیا کہ ایک پیالہ سب کا کیا بنائے گا میں تو خود اتنا بھوکا ہوں خیر آپ نے سب کو بلا کے بٹھا لیا اور اس پیالے کو کہا ابو حرارہ سب کو دو ابو حرارہ نے ایک کے بعد ایک ایک سب کو گھمایا پھر" .

minaret:Segment_HUSN_AKHL-21591_0099 a minaret:TranscriptSegment ;
    minaret:endTime 1847.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0100 ;
    minaret:sequenceIndex 99 ;
    minaret:startTime 1834.92 ;
    minaret:text "اس کے بعد کہا ابو حرارہ خود پیو سب کو پلا کہا اب تم خود پیو اور جب خود پی رہے تھے تو کہا بس کہا نہیں اور پیو پھر میں نے پیا پھر کہا اور پیو میں نے" .

minaret:Segment_HUSN_AKHL-21591_0100 a minaret:TranscriptSegment ;
    minaret:endTime 1876.26 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0101 ;
    minaret:sequenceIndex 100 ;
    minaret:startTime 1847.68 ;
    minaret:text "پھر کہا: اور پیو، میں نے پھر پیا۔ پھر میں نے کہا کہ اے اللہ کے رسول صلی اللہ علیہ وسلم! اس سے زیادہ نہیں پی سکتا۔ پھر آپ نے خود پیا۔ یعنی سب کو پلانے کے بعد پھر اسی پیالے سے آپ نے خود دودھ پیا۔ اس وقت وہ جان گئے کہ واقعی آپ صلی اللہ علیہ وسلم کی دی ہوئی چیز میں کتنی برکت ہو سکتی ہے۔ بہرحال حضرت ابو ہریرہ نبی صلی اللہ علیہ وسلم کی زندگی میں تو اسی حال میں رہے لیکن آپ سب جانتے ہیں کہ جب حضرت عمر رضی اللہ تعالیٰ عنہ کا دور آیا تو اس وقت ہر طرف اسلامی فتوحات تھیں۔" .

minaret:Segment_HUSN_AKHL-21591_0101 a minaret:TranscriptSegment ;
    minaret:endTime 1896.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0102 ;
    minaret:sequenceIndex 101 ;
    minaret:startTime 1876.26 ;
    minaret:text "پھر اتنا زیادہ مال غنیمت مسلمانوں کے پاس آیا کہ ہر شخص خوش حال ہو گیا اور حضرت ابو حرارہ بھی انہی میں شامل تھے کیونکہ جو کچھ مدینہ آتا وہ تقسیم ہوتا تھا صحابہ کرام پر اور جب آپ کے پاس مال آیا تو پھر آپ نے شادی کی اور اس کے" .

minaret:Segment_HUSN_AKHL-21591_0102 a minaret:TranscriptSegment ;
    minaret:endTime 1915.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0103 ;
    minaret:sequenceIndex 102 ;
    minaret:startTime 1896.16 ;
    minaret:text "بعد آپ نے گھر کا ساز و سامان وغیر لیا آپ اکثر کہا کرتے تھے میں نے یتیمی کی حالت میں پرورش پائی اپنے بارے میں کیا کہتے میں نے یتیمی کی حالت میں پرورش پائی مسکینی کی حالت میں ہجرت کی یعنی میرے پاس کچھ نہیں تھا ایک خاتون کے ملازم تھے" .

minaret:Segment_HUSN_AKHL-21591_0103 a minaret:TranscriptSegment ;
    minaret:endTime 1935.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0104 ;
    minaret:sequenceIndex 103 ;
    minaret:startTime 1915.44 ;
    minaret:text "جو صرف دو وقت کی روٹی دیتی تھی کوئی پیسہ ویسا نہیں صرف دو وقت کا کھانا دیتی تھی جس کا نام بصرہ بنت غزوان تھا اور کام کیا تھا ان کا ڈیوٹی کیا تھی کہ جب وہ لوگ سفر پہ جاتے تو یہ ان کا سامان اٹھاتے چیزیں اٹھاتے ان کی سواریوں کو ہانکتے اور" .

minaret:Segment_HUSN_AKHL-21591_0104 a minaret:TranscriptSegment ;
    minaret:endTime 1954.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0105 ;
    minaret:sequenceIndex 104 ;
    minaret:startTime 1935.22 ;
    minaret:text "پھر ملا اتنے مالدار ہوئے کہ اسی عورت سے شادی کی وہ عورت جو آپ کی مالک تھی آج آپ اس کے شوہر تھے یہ ہے علم کی وہ دولت جو انسان کو" .

minaret:Segment_HUSN_AKHL-21591_0105 a minaret:TranscriptSegment ;
    minaret:endTime 1975.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0106 ;
    minaret:sequenceIndex 105 ;
    minaret:startTime 1955.52 ;
    minaret:text "ہر چیز سے بڑا مقام دیتی ہے مال و دولت کی کوئی حیثیت نہیں ہوتی وہ تو آنے جانے والی چیز ہے اصل چیز انسان کا علم ہے کردار ہے اخلاق ہے بہرحال اس کے بعد ان کو گورنر بنایا گیا یعنی صرف یہ نہیں تھا کہ سیکھنے سکھانے والے تھے بلکہ بہت بڑا منصب ان کو عطا کیا" .

minaret:Segment_HUSN_AKHL-21591_0106 a minaret:TranscriptSegment ;
    minaret:endTime 1995.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0107 ;
    minaret:sequenceIndex 106 ;
    minaret:startTime 1975.52 ;
    minaret:text "گیا لیکن شادی ہونے کے بعد بھی گورنر بننے کے بعد بھی مال و دولت آنے کے بعد بھی علم سیکھنے اور سکھانے کا شوق نہیں گیا اس کے ساتھ عبادت بھی بہت ذوق و شوق سے کرتے رات کے ایک حصے میں خود عبادت کرتے پھر خود سو جاتے بیوی کو اٹھا دیتے پھر وہ عبادت" .

minaret:Segment_HUSN_AKHL-21591_0117 a minaret:TranscriptSegment ;
    minaret:endTime 2213.36 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0118 ;
    minaret:sequenceIndex 117 ;
    minaret:startTime 2193.68 ;
    minaret:text "میں روتا ہوں کہ سفر بہت لمبا ہے اگلی منزل بہت طویل ہے زادِ راہ بہت تھوڑا ہے یہ امت کا وہ شخص ہے جس نے سب سے زیادہ حدیث روایت کی ہیں کہتا زادِ راہ بہت تھوڑا ہے اور یہ ساری حدیثیں انہیں زبانی یاد تھیں ایسا نہیں تھا کہ صرف دیکھ دیکھ کہ کہیں سے پڑھ کے سنا رہے تھے" .

minaret:Segment_HUSN_AKHL-21591_0118 a minaret:TranscriptSegment ;
    minaret:endTime 2234.24 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0119 ;
    minaret:sequenceIndex 118 ;
    minaret:startTime 2214.36 ;
    minaret:text "سب حفظ تھیں جو ان کے سینے میں ساتھ جا رہی تھی کتابیں تو نہیں ساتھ جاتیں نا وہ جاتا ہے جو ہمارے عمل میں ہو اور ہمارے سینے میں ہو اور کہتے ہیں کہ زادِ راہ بہت تھوڑا ہے میں اس راستے پہ کھڑا ہوں جو مجھے یا جنت میں لے جائے گا یا جہنم میں لے جائے گا میں نہیں جانتا میرا انجام" .

minaret:Segment_HUSN_AKHL-21591_0119 a minaret:TranscriptSegment ;
    minaret:endTime 2254.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0120 ;
    minaret:sequenceIndex 119 ;
    minaret:startTime 2234.24 ;
    minaret:text "کیا ہوگا پھر دعا کی یا اللہ مجھے تیری ملاقات کا شوق ہے تیری ملاقات مجھے محبوب ہے تو بھی میری ملاقات کو محبوب سمجھ اور مجھے جلد اپنے سے ملا اور تھوڑی ہی دیر گزری تھی کہ آپ کی وفات ہو گئی یہ ہیں وہ حضرت ابو ہریرہ" .

minaret:Segment_HUSN_AKHL-21591_0120 a minaret:TranscriptSegment ;
    minaret:endTime 2274.04 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0121 ;
    minaret:sequenceIndex 120 ;
    minaret:startTime 2254.22 ;
    minaret:text "جن کا نام آپ مختلف احادیث میں سنتے رہیں گے سب سے زیادہ احادیث کی روایت میں جس کا ذکر آتا ہے وہ ابو ہریرہ ہی ہیں وہ روایت کرتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا میں اچھے اخلاق کی تکمیل کے لئے بھیجا گیا ہوں" .

minaret:Segment_HUSN_AKHL-21591_0122 a minaret:TranscriptSegment ;
    minaret:endTime 2306.54 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0123 ;
    minaret:sequenceIndex 122 ;
    minaret:startTime 2294.86 ;
    minaret:text "اچھے اخلاق کے مالک تھے اور اسے سمجھنے کے لئے پھر یاد کیجئے کیا زیاد بن حارسہ کا آپ سے تعلق آپ کے اچھے اخلاق کی گواہی" .

minaret:Segment_HUSN_AKHL-21591_0123 a minaret:TranscriptSegment ;
    minaret:endTime 2319.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0124 ;
    minaret:sequenceIndex 123 ;
    minaret:startTime 2306.54 ;
    minaret:text "عَنْ اَبِیْ هُرَیْرَةَ قَالَ قَالَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ: اَكْمَلُ الْمُؤْمِنِیْنَ اِیْمَانًا اَحْسَنُهُمْ خُلُقًا، رَوَاهُ اَبُوْ دَاوُدَ كِتَابُ السُّنَّةِ۔" .

minaret:Segment_HUSN_AKHL-21591_0124 a minaret:TranscriptSegment ;
    minaret:endTime 2338.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0125 ;
    minaret:sequenceIndex 124 ;
    minaret:startTime 2319.58 ;
    minaret:text "سیدنا ابو ہریرہ رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اَكْمَلُ، کامل کی اسمِ تفضیل، سب سے زیادہ کامل، سب سے زیادہ مکمل، اِیْمَانًا ایمان میں کون ہے؟ اَحْسَنُهُمْ" .

minaret:Segment_HUSN_AKHL-21591_0125 a minaret:TranscriptSegment ;
    minaret:endTime 2358.84 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0126 ;
    minaret:sequenceIndex 125 ;
    minaret:startTime 2338.9 ;
    minaret:text "جو سب سے اچھے ہیں، خُلُقًا اخلاق میں۔ یعنی سب سے زیادہ ایمان ان کا مکمل ہے جن کا اخلاق سب سے اچھا ہے۔ تو اس سے کیا پتہ چلتا ہے؟ کیا سمجھ میں آتا ہے؟ کہ ایمان کی تکمیل بھی اخلاق کی تکمیل سے ہوتی ہے اور اخلاق کی" .

minaret:Segment_HUSN_AKHL-21591_0128 a minaret:TranscriptSegment ;
    minaret:endTime 2408.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0129 ;
    minaret:sequenceIndex 128 ;
    minaret:startTime 2388.94 ;
    minaret:text "اللّٰهُ عَنْهُ، کوئی بھی چیز یُّوْضَعُ جو رکھی جائے گی، وَضَعَ یَضَعُ سے، یُّوْضَعُ مجہول ہے" .

minaret:Segment_HUSN_AKHL-21591_0129 a minaret:TranscriptSegment ;
    minaret:endTime 2427.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0130 ;
    minaret:sequenceIndex 129 ;
    minaret:startTime 2408.9 ;
    minaret:text "فِی الْمِیْزَانِ میزان میں، اَثْقَلُ زیادہ وزنی، ثقیل، مِنْ حُسْنِ الْخُلُقِ حسنِ خلق سے، اچھے اخلاق سے۔ وَاِنَّ صَاحِبَ حُسْنِ الْخُلُقِ، اور بے شک صاحب، ساتھی، حسنِ خلق، اچھے اخلاق والا" .

minaret:Segment_HUSN_AKHL-21591_0130 a minaret:TranscriptSegment ;
    minaret:endTime 2447.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0131 ;
    minaret:sequenceIndex 130 ;
    minaret:startTime 2427.5 ;
    minaret:text "لَیَبْلُغُ البتہ پہنچ جاتا ہے۔ بَلَغَ یَبْلُغُ بلوغ پہنچنا، بالغ ہونا اسی سے ہے، یعنی ایک سرٹن ایج کو پہنچنا، بِهٖ ساتھ اس کے، کس کے؟ حسنِ خلق کے، اچھے اخلاق کے۔ اچھے اخلاق کے ذریعے پہنچ جاتا ہے ایک انسان" .

minaret:Segment_HUSN_AKHL-21591_0134 a minaret:TranscriptSegment ;
    minaret:endTime 2525.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0135 ;
    minaret:sequenceIndex 134 ;
    minaret:startTime 2506.56 ;
    minaret:text "گا تو اس سے آپ اندازہ لگا سکتے ہیں کہ حسنِ خلق کی ہماری زندگی میں کس قدر اہمیت ہے اور پھر یہ ہے کہ عبادات کا درجہ جو ہے وہ اپنی جگہ ہے لیکن اگر کوئی فرائض کے بعد اچھا اخلاق اور اچھا معاملہ رکھتا ہے تو وہ" .

minaret:Segment_HUSN_AKHL-21591_0135 a minaret:TranscriptSegment ;
    minaret:endTime 2546.06 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0136 ;
    minaret:sequenceIndex 135 ;
    minaret:startTime 2526.28 ;
    minaret:text "نوافل ادا کرنے سے بھی زیادہ انسان کو اللہ کے قریب کر دیتا ہے۔ اگلی حدیث: عَنْ اَبِیْ هُرَیْرَةَ قَالَ قَالَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ: خَصْلَتَانِ لَا تَجْتَمِعَانِ فِیْ مُنَافِقٍ: حُسْنُ سَمْتٍ وَّلَا فِقْهٌ فِی الدِّیْنِ، رَوَاهُ التِّرْمِذِیُّ" .

minaret:Segment_HUSN_AKHL-21591_0136 a minaret:TranscriptSegment ;
    minaret:endTime 2566.02 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0137 ;
    minaret:sequenceIndex 136 ;
    minaret:startTime 2546.06 ;
    minaret:text "كِتَابُ الْعِلْمِ۔ ابو ہریرہ رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: خَصْلَتَانِ، دو خصلتیں، دو عادتیں، اخلاق کی دو باتیں، لَا تَجْتَمِعَانِ، نہیں جمع ہو سکتیں، فِیْ مُنَافِقٍ، کسی منافق میں۔ کسی منافق میں" .

minaret:Segment_HUSN_AKHL-21591_0137 a minaret:TranscriptSegment ;
    minaret:endTime 2585.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0138 ;
    minaret:sequenceIndex 137 ;
    minaret:startTime 2566.02 ;
    minaret:text "یہ دو باتیں ہو ہی نہیں سکتیں: حُسْنُ سَمْتٍ، اچھی چال چلن، اچھا معاملہ، اچھا رویہ، اچھا اخلاق، وَلَا فِقْهٌ فِی الدِّیْنِ، اور نہ دین کی سمجھ۔ یعنی منافق کے اندر دو چیزیں نہیں ہوتیں: نہ اچھا اخلاق ہوتا ہے، بات کرتا ہے تو بدتمیزی سے" .

minaret:Segment_HUSN_AKHL-21591_0142 a minaret:TranscriptSegment ;
    minaret:endTime 2683.94 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0143 ;
    minaret:sequenceIndex 142 ;
    minaret:startTime 2664.28 ;
    minaret:text "عادتیں اچھی ہیں۔ اگلی حدیث ہے: عَنْ اَبِیْ ذَرٍّ قَالَ: قَالَ لِیْ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ: اِتَّقِ اللّٰهَ حَیْثُمَا كُنْتَ، وَاَتْبِعِ السَّیِّئَةَ الْحَسَنَةَ تَمْحُهَا، وَخَالِقِ النَّاسَ بِخُلُقٍ حَسَنٍ۔ ابو ذر رضی اللہ عنہ سے" .

minaret:Segment_HUSN_AKHL-21591_0145 a minaret:TranscriptSegment ;
    minaret:endTime 2743.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0146 ;
    minaret:sequenceIndex 145 ;
    minaret:startTime 2723.84 ;
    minaret:text "اس کا رواں ترجمہ: ابو ذر رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے مجھ سے فرمایا: تو جہاں کہیں بھی ہو اللہ سے ڈر، اور برائی کے پیچھے نیکی کر، نیکی برائی کو مٹا دے گی، اور لوگوں کے ساتھ اچھے اخلاق سے پیش آؤ۔ تین چیزیں اس حدیث میں" .

minaret:Segment_HUSN_AKHL-21591_0163 a minaret:TranscriptSegment ;
    minaret:endTime 3099.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0164 ;
    minaret:sequenceIndex 163 ;
    minaret:startTime 3080.06 ;
    minaret:text "عبادت ہے اچھا اخلاق کیا ہے؟ عبادت، اور عبادت کا بھی اعلیٰ ترین درجہ جس میں انسان نفلی عبادت سے بھی زیادہ وزنی نیکی کما لیتا ہے اچھے اخلاق کے ذریعے۔ اور اس میں آپ دیکھیے کہ پچھلے ہفتے آپ کو ایک اسائنمنٹ دی گئی تھی،" .

minaret:Segment_HUSN_AKHL-21591_0164 a minaret:TranscriptSegment ;
    minaret:endTime 3119.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0165 ;
    minaret:sequenceIndex 164 ;
    minaret:startTime 3099.86 ;
    minaret:text "ہوم ورک دیا گیا تھا۔ میں نے آپ سے یہ بھی ریکویسٹ کی تھی کہ سب لوگ ایک ڈائری بنا لیں اور وہ ڈائری ساتھ لایا کریں تاکہ یہیں بیٹھ کے ہم آپ سے کچھ چیزیں کرنے کو کہیں گے تو ساتھ ساتھ اسی میں ہی آپ لکھیں۔ تو اب آپ دیکھیے کہ آپ کو جو کام دیا گیا تھا وہ کیا تھا؟ کہ آپ کم از کم تین چیزیں ایسی لکھیں جو آپ کے فرسٹ ہینڈ" .

minaret:Segment_HUSN_AKHL-21591_0165 a minaret:TranscriptSegment ;
    minaret:endTime 3139.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0166 ;
    minaret:sequenceIndex 165 ;
    minaret:startTime 3119.68 ;
    minaret:text "ایکسپیرینس میں آئی ہوں، جو آپ کو کسی کی اچھی نہ لگی ہوں، اور آپ سب سے میں نے عرض کیا تھا کہ آپ اپنی ڈائریوں میں ان کو نوٹ کریں۔ اگلی بات یہ ہے کہ آپ کا اس موقع پر انسٹنٹ ری ایکشن کیا تھا؟ آپ نے کیا کیا؟ اس نے تو آپ کو ہرٹ" .

minaret:Segment_HUSN_AKHL-21591_0166 a minaret:TranscriptSegment ;
    minaret:endTime 3159.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0167 ;
    minaret:sequenceIndex 166 ;
    minaret:startTime 3139.66 ;
    minaret:text "کیا، اس نے تو اچھا نہیں کیا۔ وہ جو اس نے کیا تھا وہ تو اس کا اخلاق تھا، مگر آپ نے اس وقت کیا کیا؟ الحمد للہ جو آپ کی کلاس کی یہاں کی فیڈ بیک تھی اس کے کافی چیزوں کو میں نے کچھ پڑھوا کے سنا ہے، کچھ دیکھا ہے، پڑھا ہے اور اوور آل بہت میں نے اس کو انجوائے کیا ہے۔" .

minaret:Segment_HUSN_AKHL-21591_0167 a minaret:TranscriptSegment ;
    minaret:endTime 3179.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0168 ;
    minaret:sequenceIndex 167 ;
    minaret:startTime 3159.64 ;
    minaret:text "ایک مجھے بہت خوشی یہ ہوئی کہ آپ نے لکھا اور آپ نے دل کے حال بیان کیے اور آپ نے اپنے غموں کو شیئر کیا۔ جب کوئی ہرٹ کرتا ہے تو پھر انسان کو سمجھ نہیں آتی کہ میں کس سے کہوں۔ کیونکہ دل جب دکھی ہوتا ہے تو دل چاہتا ہے کسی کو سنائیں۔ سنائیں تو پھر ڈر لگتا ہے غیبت نہ ہو اور" .

minaret:Segment_HUSN_AKHL-21591_0168 a minaret:TranscriptSegment ;
    minaret:endTime 3199.48 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0169 ;
    minaret:sequenceIndex 168 ;
    minaret:startTime 3179.52 ;
    minaret:text "بات بڑھ جائے گی، صبر کر لیں۔ لیکن صبر کرنے کے ساتھ علاج بھی چاہتے ہیں، سلوشن بھی ہونا چاہیے۔ تو بہرحال بہت اچھا کیا آپ نے جو بھی لکھا۔ اور اب یہ ہے کہ نیکسٹ ویک بھی آپ یہی کریں گے: جو آپ کو کسی میں اچھا نہیں لگا وہ آپ لکھیں گے، بے شک نام نہیں لکھیں کیونکہ کہیں ایسا نہ ہو" .

minaret:Segment_HUSN_AKHL-21591_0169 a minaret:TranscriptSegment ;
    minaret:endTime 3219.48 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0170 ;
    minaret:sequenceIndex 169 ;
    minaret:startTime 3199.48 ;
    minaret:text "کسی اور کے ہاتھ ڈائری لگے اور یہ اصلاح کا پروگرام ادھورا ہی نہ رہ جائے۔ تو جو چیز آپ کو کسی کی اچھی نہیں لگی، اگلا کیا ہے؟ اس خرابی کو دیکھ کر، اس کی بدتمیزی کو دیکھ کر، بد اخلاقی کو دیکھ کر میرا ری ایکشن کیا تھا؟ ایک تو لکھنے" .

minaret:Segment_HUSN_AKHL-21591_0170 a minaret:TranscriptSegment ;
    minaret:endTime 3239.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0171 ;
    minaret:sequenceIndex 170 ;
    minaret:startTime 3219.48 ;
    minaret:text "سے آپ خود بھی اینالائز کرنے لگیں گے کہ یہ میں کیا لکھ رہی ہوں، اور لکھتے وقت آپ کو اپنا بھی خیال آئے گا کہ کہیں میں خود بھی تو یہ نہیں کرتی؟ اگر کسی کی بات مجھے ہرٹ کر رہی ہے تو میری بھی تو کسی کو کر سکتی ہے۔ لیکن کرنا یہ ہے کہ ہمیں اپنا انسٹنٹ ری ایکشن دیکھنا" .

minaret:Segment_HUSN_AKHL-21591_0171 a minaret:TranscriptSegment ;
    minaret:endTime 3259.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0172 ;
    minaret:sequenceIndex 171 ;
    minaret:startTime 3239.4 ;
    minaret:text "ہے کہ ہم نے اس وقت کیا کیا۔ کیونکہ ہمیں دراصل اپنی اصلاح کرنی ہے نا، اس ڈائری کا یا اس ایکسرسائز کا یا اس ہوم ورک کا مقصد لوگوں کے عیب چننا نہیں ہے۔ لوگوں کے اوپر انگلیاں اٹھانا نہیں ہے، لوگوں کی خرابیاں پوائنٹ آؤٹ کرنا نہیں ہے، اس سے مراد بھی اپنی اصلاح ہے۔ جب آپ" .

minaret:Segment_HUSN_AKHL-21591_0172 a minaret:TranscriptSegment ;
    minaret:endTime 3278.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0173 ;
    minaret:sequenceIndex 172 ;
    minaret:startTime 3259.22 ;
    minaret:text "لکھیں گے، اس کے بعد دیکھیں گے کہ میں نے کیا کیا۔ پھر اپنے عمل کو ایویلیویٹ کریں گے، وہ لکھیں گے آگے کہ میرا فوری ری ایکشن کیا تھا۔ اس کے تین درجے ہیں: نمبر ایک، جو دوسرے نے کیا کیا میں نے بھی وہی کیا؟ ایسے کو تیسا کیا؟ یا" .

minaret:Segment_HUSN_AKHL-21591_0173 a minaret:TranscriptSegment ;
    minaret:endTime 3298.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0174 ;
    minaret:sequenceIndex 173 ;
    minaret:startTime 3278.52 ;
    minaret:text "اس کے جواب میں اچھا کیا؟ کسی نے آپ کو بہت سخت بات سنائی، آپ نے کیا کیا؟ ویسی سنا دی، عدلہ بدلہ ہو گیا، حق ہے آپ کو سنا سکتے ہیں، ایک کے بدلے میں ایک کر سکتے ہیں۔ اس سے بھی برا کیا؟ ایک کی دو لگائیں۔ یا یہ ہے کہ اچھا کیا،" .

minaret:Segment_HUSN_AKHL-21591_0174 a minaret:TranscriptSegment ;
    minaret:endTime 3317.94 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0175 ;
    minaret:sequenceIndex 174 ;
    minaret:startTime 3298.16 ;
    minaret:text "یعنی تین آپشنز ہیں آپ کے پاس: جیسا اس نے کیا میں نے بھی ویسا ہی کیا، نمبر دو: اس سے بھی برا کیا، جو اس نے کیا میں نے اس سے دگنا کیا، یہ possibility ہے، کر کے یاد آتا ہے ہمیں کہ اوہو پھسل گئے تھے۔ اور تیسرا کیا ہے کہ جس نے برا کیا میں نے اس" .

minaret:Segment_HUSN_AKHL-21591_0175 a minaret:TranscriptSegment ;
    minaret:endTime 3337.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0176 ;
    minaret:sequenceIndex 175 ;
    minaret:startTime 3317.94 ;
    minaret:text "وقت یا تو صبر کیا، یا احسن طریقے سے جواب دیا، یعنی میرا رویہ کیا تھا۔ اب آپ اپنے آپ کو خود مارک کر دیں۔ آپ کا اخلاق کیا ہے؟ یہ دوسروں کے آئینے میں خود کو دیکھنا ہے۔ کیونکہ دو طرفہ معاملہ ہے نا، کہ ٹھیک ہے دوسرا تو ہے ہی خراب لیکن میں کیا" .

minaret:Segment_HUSN_AKHL-21591_0176 a minaret:TranscriptSegment ;
    minaret:endTime 3357.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0177 ;
    minaret:sequenceIndex 176 ;
    minaret:startTime 3337.86 ;
    minaret:text "ہوں؟ مجھے تو اپنے بارے میں سوچنا ہے۔ اور اگر میں اچھی ہوں تو ان شاء اللہ دوسرے بھی اچھے ہو جائیں گے۔ بہت سی چیزیں انسان اپنے اخلاق سے سکھاتا ہے۔ ٹھیک ہے؟ اب آپ دیکھیے کہ دو چیزیں ہوتی ہیں: ایک ہوتا ہے کسی کام یا بات یا" .

minaret:Segment_HUSN_AKHL-21591_0177 a minaret:TranscriptSegment ;
    minaret:endTime 3376.74 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0178 ;
    minaret:sequenceIndex 177 ;
    minaret:startTime 3357.5 ;
    minaret:text "معاملے کا آپ کی طرف سے آغاز۔ مثلاً آپ اپنے گھر میں ایک ماں کی حیثیت سے یا بڑی بہن کی حیثیت سے اپنے سے چھوٹوں سے کیا معاملہ کرتی ہیں؟ حکم دیتی ہیں؟ یا اپنے ساتھیوں سے کیا معاملہ کرتے ہیں؟ جب آپ بات کرتے ہیں، حاکمانہ انداز ہوتا ہے" .

minaret:Segment_HUSN_AKHL-21591_0179 a minaret:TranscriptSegment ;
    minaret:endTime 3417.2 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0180 ;
    minaret:sequenceIndex 179 ;
    minaret:startTime 3397.38 ;
    minaret:text "کہ اے فرعون تم سیدھے ہو جاؤ، میں اللہ کا رسول ہوں اور مجھے اللہ نے اتنی طاقت دی ہے، دیکھو تو سہی میرا عصا اب کیا بنے گا! اور دیکھو کہ میرے پاس کیسے بڑی بڑی طاقت ہے کوئی دھوس نہیں جمائی اتنی طاقت کے باوجود بھی کہ وہ عصا جو سانپ بن جاتا تھا، وہ تو اسی وقت بدلہ لے سکتے تھے کہ فوراً ہی عصا پھینکتے اور" .

minaret:Segment_HUSN_AKHL-21591_0184 a minaret:TranscriptSegment ;
    minaret:endTime 3500.38 ;
    minaret:sequenceIndex 184 ;
    minaret:startTime 3496.38 ;
    minaret:text "نَسْتَغْفِرُكَ وَنَتُوبُ إِلَيْكَ۔ اَلسَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهٗ۔" .

minaret:Segment_HUSN_AKHL-21592_0001 a minaret:TranscriptSegment ;
    minaret:endTime 39.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0002 ;
    minaret:sequenceIndex 1 ;
    minaret:startTime 19.86 ;
    minaret:text "اَللّٰهُمَّ صَلِّ عَلٰی مُحَمَّدٍ وَّعَلٰی اٰلِ مُحَمَّدٍ كَمَا صَلَّیْتَ عَلٰی اِبْرَاهِیْمَ وَعَلٰی اٰلِ اِبْرَاهِیْمَ اِنَّكَ حَمِیْدٌ مَّجِیْدٌ۔ اَللّٰهُمَّ بَارِكْ عَلٰی" .

minaret:Segment_HUSN_AKHL-21592_0003 a minaret:TranscriptSegment ;
    minaret:endTime 78.26 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0004 ;
    minaret:sequenceIndex 3 ;
    minaret:startTime 58.92 ;
    minaret:text "چھوٹے سے کاغذ پر اس دعا کو لکھیں اور آئینے کے اوپر لگا دیں۔ ہوم ورک کی ڈائری نکالیے اور لکھیے اس پر۔ اس سے کیا ہوگا؟ ہفتہ بھر میں آئینہ تو دیکھیں گے یا نہیں؟ ہر ایک کو دیکھنا ہی پڑتا ہے۔ تو اگر آپ وہاں اسے لگا لیں گے تو جب بھی اپنی شکل دیکھیں گے تو اس وقت آپ" .

minaret:Segment_HUSN_AKHL-21592_0005 a minaret:TranscriptSegment ;
    minaret:endTime 118.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 98.18 ;
    minaret:text "یہ ہے کہ جو کچھ ہم سیکھیں اس پر عمل بھی کریں۔ اگر ہم عمل کریں گے تو سیکھنے کا فائدہ ہوگا اور اگر عمل نہ کیا تو کیا ہوگا؟ مزید بوجھ جمع ہوتا جائے گا۔ سب نے اپنا ہوم ورک نوٹ کر لیا کہ اپنے آئینے کے اوپر یہ دعا لکھ کر" .

minaret:Segment_HUSN_AKHL-21592_0012 a minaret:TranscriptSegment ;
    minaret:endTime 236.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0013 ;
    minaret:sequenceIndex 12 ;
    minaret:startTime 216.72 ;
    minaret:text "اچھی گفتگو کا نام ہے اور اچھی عادات میں سب سے اچھی چیز اور ابتدائی چیز نرمی ہے۔ نرمی کے لیے عربی میں لفظ استعمال ہوتا ہے: اَلرِّفْقُ، اور روٹ کیا ہے؟ را، فا، قاف۔ رفق کہتے ہیں" .

minaret:Segment_HUSN_AKHL-21592_0013 a minaret:TranscriptSegment ;
    minaret:endTime 255.28 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0014 ;
    minaret:sequenceIndex 13 ;
    minaret:startTime 236.64 ;
    minaret:text "کسی کو نفع پہنچانا، کسی کو فائدہ دینا۔ اور رفق کہتے ہیں نرم، آسان اور مہربانی کے برتاؤ کو۔ اسی طرح رفق لفظ اس چیز کے لیے بھی استعمال ہوتا ہے جس سے مدد لی جائے یعنی فائدہ مند ہو۔" .

minaret:Segment_HUSN_AKHL-21592_0014 a minaret:TranscriptSegment ;
    minaret:endTime 276.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0015 ;
    minaret:sequenceIndex 14 ;
    minaret:startTime 256.2 ;
    minaret:text "رفق کہتے ہیں ساتھیوں کی جماعت کو۔ اور ساتھی بھی اکٹھے کب رہتے ہیں؟ ساتھی یا دوست کب بنتے ہیں؟ جب آپ نرم ہوتے ہیں۔ تو آپ دیکھیے کہ ایک لفظ دوسرے سے کس طرح جڑا ہوا ہے۔ رافقہ کہتے ہیں لطف و مہربانی کو، بہتر سلوک کو۔" .

minaret:Segment_HUSN_AKHL-21592_0015 a minaret:TranscriptSegment ;
    minaret:endTime 296.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0016 ;
    minaret:sequenceIndex 15 ;
    minaret:startTime 276.12 ;
    minaret:text "تو رفق کہتے ہیں نرمی کو اور رفیق کا لفظ آپ نے سنا ہوگا۔ رفیق کس کو کہتے ہیں؟ ساتھی کو، دوست کو۔ اور دوست دوست کے لیے کیا ہوتا ہے؟ نرم، خوب مہربان، اچھا سلوک کرنے والا۔ مرفق عربی" .

minaret:Segment_HUSN_AKHL-21592_0018 a minaret:TranscriptSegment ;
    minaret:endTime 354.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0019 ;
    minaret:sequenceIndex 18 ;
    minaret:startTime 335.0 ;
    minaret:text "چہرہ نہیں رکھ سکتے۔ تو مرفقہ وہ چھوٹا تکیہ جو آپ کے گال کے نیچے ہوتا ہے اور تکیہ نرم چیز ہوتی ہے۔ تو مرتفق کہتے ہیں بیسکلی تکیہ لگانے کی جگہ۔ جنت کو بھی مرتفق کہا گیا اور جہنم کو بھی مرتفق کہا گیا،" .

minaret:Segment_HUSN_AKHL-21592_0019 a minaret:TranscriptSegment ;
    minaret:endTime 374.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0020 ;
    minaret:sequenceIndex 19 ;
    minaret:startTime 354.6 ;
    minaret:text "اور جنت حَسُنَتْ مُرْتَفَقًا ہے اور جہنم سَآءَتْ مُرْتَفَقًا ہے۔ بہترین ٹھکانا، بہترین جگہ جنت، جہاں جنت کی عام فضا یا عام مزاج جو ہے اس میں کیا چیز غالب ہوگی؟ نرمی۔ تو دنیا" .

minaret:Segment_HUSN_AKHL-21592_0020 a minaret:TranscriptSegment ;
    minaret:endTime 394.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0021 ;
    minaret:sequenceIndex 20 ;
    minaret:startTime 374.44 ;
    minaret:text "میں بھی جن لوگوں میں نرمی ہوتی ہے یا جس گھرانے میں نرمی ہوتی ہے وہاں فضا جنت کی طرح ہو جاتی ہے، دنیا بھی جنت بن جاتی ہے جن لوگوں کے باہم معاملات نرمی پر مبنی ہوتے ہیں۔ اور وہ دنیا بھی جہنم بن جاتی ہے جہاں" .

minaret:Segment_HUSN_AKHL-21592_0021 a minaret:TranscriptSegment ;
    minaret:endTime 413.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0022 ;
    minaret:sequenceIndex 21 ;
    minaret:startTime 394.4 ;
    minaret:text "لوگوں کے درمیان یا لوگوں کے مزاج میں سختی پائی جاتی ہے۔ اور بخاری اور مسلم کی ایک صحیح حدیث میں مومن کی مثال ایسے پودے سے دی گئی ہے کہ جسے ہوا کا جھونکا گرا دیتا ہے اور دوسرا جھونکا اٹھا دیتا ہے۔" .

minaret:Segment_HUSN_AKHL-21592_0022 a minaret:TranscriptSegment ;
    minaret:endTime 433.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 414.02 ;
    minaret:text "کبھی آپ کسی کھلے میدان میں گئے ہوں یا کسی پودے کو آپ نے دیکھا ہوگا کہ ہوا چلتی ہے تو اس کا مزاج کیسے ہوتا ہے یا وہ کیسے نظر آتا ہے۔ آندھی ہو طوفان ہو اس میں کون سے پودے سروائیو کر سکتے ہیں؟ جن میں نرمی ہوتی ہے کیونکہ وہ آگے سے جھک جاتے ہیں اور جب ہوا آندھی" .

minaret:Segment_HUSN_AKHL-21592_0023 a minaret:TranscriptSegment ;
    minaret:endTime 453.62 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 433.8 ;
    minaret:text "طوفان ختم ہوتا ہے تو وہ پھر کھڑے ہو جاتے ہیں۔ تو اسی طرح وہ لوگ جو لوگوں کے ساتھ معاملہ کرتے وقت نرم ہوں تو کیا ہوتا ہے؟ جب ان کی طرف سے بد مزاجی بد اخلاقی کا سامنا کرنا پڑتا ہے تو وہ اس کو سہہ جاتے ہیں اور پھر جب وہ طوفانی دور" .

minaret:Segment_HUSN_AKHL-21592_0024 a minaret:TranscriptSegment ;
    minaret:endTime 473.42 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 453.62 ;
    minaret:text "ختم ہوتا ہے تو دوبارہ اپنی اصل حالت پہ آ جاتے ہیں۔ تو حدیث کے الفاظ کا ترجمہ ہے مومن کی مثال ایک زرعی پودے کی طرح ہے جس کو ہوائیں ہلاتی رہتی ہیں۔ کیونکہ اس دنیا میں کچھ بھی سموتھ نہیں، کبھی مشرقی ہوا ہے تو کبھی مغربی اور کبھی شمالی ہے تو کبھی جنوبی۔ کبھی ایک" .

minaret:Segment_HUSN_AKHL-21592_0025 a minaret:TranscriptSegment ;
    minaret:endTime 493.24 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 473.42 ;
    minaret:text "طرف سے ہوا آئے گی اور کبھی دوسری طرف سے۔ کبھی یہ نہیں ہو سکتا کہ حالات خاموش رہیں اور سٹل رہیں، ساکت رہیں، جامد رہیں اور آپ صبح سے شام اس طرح بسر کریں کہ کوئی ہلچل نہ ہو۔ کہیں بھی جس سے واسطہ پڑے گا وہاں نرمی گرمی ہوگی۔ لیکن ایسے میں آپ" .

minaret:Segment_HUSN_AKHL-21592_0026 a minaret:TranscriptSegment ;
    minaret:endTime 512.78 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 493.24 ;
    minaret:text "ہوا نہیں روک سکتے۔ کیا کسی کے کنٹرول میں ہے ہوا کو روکنا؟ نہیں ہے۔ ہاں، آپ اپنے رویے کو، اپنے معاملے کو اکارڈنگلی ایڈجسٹ کر سکتے ہیں سروائیو کرنے کے لیے۔ تو حدیث کے الفاظ ہمیں کیا بتاتے ہیں یا اس سے پتا کیا چلتا ہے کہ مومن میں" .

minaret:Segment_HUSN_AKHL-21592_0027 a minaret:TranscriptSegment ;
    minaret:endTime 532.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 512.78 ;
    minaret:text "اکڑ نہیں ہوتی۔ مومن اکڑ والا نہیں ہوتا، اکڑ ایمان کے منافی ہے۔ اکڑ کیا چیز ہوتی ہے؟ کسی بھی چیز کو اکڑا ہوا جب پاتے ہیں تو کیا ہوتا ہے؟ یعنی سٹفنس کسی بھی چیز کے لیے نقصان دہ ہوتی" .

minaret:Segment_HUSN_AKHL-21592_0028 a minaret:TranscriptSegment ;
    minaret:endTime 552.42 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0029 ;
    minaret:sequenceIndex 28 ;
    minaret:startTime 532.68 ;
    minaret:text "ہے، اس کو توڑ دیتی ہے، ٹوٹ جاتا ہے وہ، ختم ہو جاتا ہے۔ ہمارے جسم کے اندر کتنی لچک ہے! اللہ تعالیٰ نے مضبوط ہڈیوں کے بیچ میں کیا رکھے ہیں؟ جوڑ، کہ جو ہمیں موڑ دیتے ہیں اکارڈنگلی جہاں جہاں ہمیں مڑنے کی ضرورت ہوتی ہے۔ اور اگر ہمارے ہاتھ اکڑے ہوئے ہوتے، سیدھے، مثلاً" .

minaret:Segment_HUSN_AKHL-21592_0029 a minaret:TranscriptSegment ;
    minaret:endTime 572.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0030 ;
    minaret:sequenceIndex 29 ;
    minaret:startTime 552.42 ;
    minaret:text "انگلیاں سٹف ہو جاتیں ہم کسی کام کے قابل نہ رہتے۔ اگر ہماری ٹانگیں اکڑی ہوئی ہوتیں یا کمر اکڑی ہوئی ہوتی تو کیا ہوتا؟ ہم اٹھنے بیٹھنے کے قابل نہ رہتے۔ اسی طرح پودوں میں اگر آپ دیکھیے کہ ایک تنا اگر سنبھالے ہوئے ہے اس کو تو باقی شاخوں کے اندر کتنی نرمی اور لچک ہوتی ہے اور وہ لچک ہی" .

minaret:Segment_HUSN_AKHL-21592_0046 a minaret:TranscriptSegment ;
    minaret:endTime 890.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0047 ;
    minaret:sequenceIndex 46 ;
    minaret:startTime 870.62 ;
    minaret:text "عمارت نہیں بن سکتی۔ انسانی تعلقات بھی اسی طرح ہیں۔ انسان اپنے معاملے میں اپنی ذات کی اصلاح کے لیے اینٹ بنے لیکن جب اس کو دوسرے کے ساتھ معاملہ کرنا ہے تو بیچ میں ایسا ایریا آئے گا کہ جو دونوں کے درمیان نرمی پیدا کر کے دونوں کو جوڑ سکے گا۔ جب بھی دو چیزوں" .

minaret:Segment_HUSN_AKHL-21592_0047 a minaret:TranscriptSegment ;
    minaret:endTime 910.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0048 ;
    minaret:sequenceIndex 47 ;
    minaret:startTime 890.58 ;
    minaret:text "کو آپس میں ایک دوسرے میں فکس کرنا ہوتا ہے تو پھر اگر ایک دوسرے کو راہ نہیں دیتا تو وہ چیز فکس نہیں ہو سکتی۔ اگر دو لوگ آپس میں کسی بھی معاملے میں اکٹھے کام کر رہے ہیں تو یہ نہیں ہو سکتا کہ صرف ایک ہی کی مانی جائے اور پھر وہ کام صحیح بھی ہو جائے۔ کبھی ایک جھکے گا اور کبھی دوسرا جھکے گا، کبھی ایک سنے گا" .

minaret:Segment_HUSN_AKHL-21592_0048 a minaret:TranscriptSegment ;
    minaret:endTime 930.02 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0049 ;
    minaret:sequenceIndex 48 ;
    minaret:startTime 910.5 ;
    minaret:text "اور کبھی دوسرا سنے گا تب جا کر گزارا ہوگا۔ لیکن عام طور پر لوگوں کو کیا چیز نہیں جھکنے دیتی؟ انا، انا نہیں جھکنے دیتی۔ اکڑ اور انا کی وجہ کیا ہوتی ہے؟ تکبر، اپنے آپ کو بڑی چیز سمجھنا،" .

minaret:Segment_HUSN_AKHL-21592_0049 a minaret:TranscriptSegment ;
    minaret:endTime 949.82 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0050 ;
    minaret:sequenceIndex 49 ;
    minaret:startTime 930.02 ;
    minaret:text "خود پرستی، خود کو بڑی چیز سمجھنا اور کہیں بھی تھوڑا سا اختلاف ہو جائے تو اس کو انا کا مسئلہ بنا لینا، عزت کا مسئلہ بنا لینا کہ اس شخص نے میری بے عزتی کر دی، اس نے میری بات نہیں مانی یا میں نے اس کی نہیں مانی، تو اب اگر میں اس کی مان لوں گا تو کیا ہوگا؟ میں تو اس کے" .

minaret:Segment_HUSN_AKHL-21592_0050 a minaret:TranscriptSegment ;
    minaret:endTime 969.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0051 ;
    minaret:sequenceIndex 50 ;
    minaret:startTime 949.82 ;
    minaret:text "سامنے چھوٹا ہو جاؤں گا، میں تو گر جاؤں گا اس کے سامنے، میں تو چھوٹا بن جاؤں گا اور پھر یہ تو مجھے چبا دے گا اور یہ تو مجھے تر نوالہ بنا دے گا اور مجھے تو اپنے اصول پر قائم رہنا ہے اس لیے مجھے وہ کرنا ہے جو مجھے کرنا ہے۔ یہ ضد اور ہٹ دھرمی کا" .

minaret:Segment_HUSN_AKHL-21592_0051 a minaret:TranscriptSegment ;
    minaret:endTime 988.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0052 ;
    minaret:sequenceIndex 51 ;
    minaret:startTime 969.5 ;
    minaret:text "دوسرا نام ہے۔ جب آپ کو دوسروں کے ساتھ مل کے چلنا ہے تو اس میں آپ کو جھکنا پڑے گا، ٹوٹنا پڑے گا اور اگر آپ نہیں ٹوٹتے خود تو آپ کو توڑا جائے گا۔ آپ وہ فائدے نہیں اٹھا سکیں گے جو آپ اٹھا سکتے ہیں۔ کیا چیز انسان کے اندر نرمی لا سکتی ہے؟" .

minaret:Segment_HUSN_AKHL-21592_0052 a minaret:TranscriptSegment ;
    minaret:endTime 1008.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0053 ;
    minaret:sequenceIndex 52 ;
    minaret:startTime 989.52 ;
    minaret:text "انسان کا یہ احساس کہ میں بندہ ہوں، بڑا صرف اللہ ہے۔ کہیں بھی یہ خیال آ جائے کہ میں بڑا ہوں اور فلاں نے میری بڑائی کو چیلنج کر دیا ہے اور میری بات نہیں سنی یا میری نہیں مانی یا میری بڑائی کو ٹھیس پہنچا دی ہے تو پھر" .

minaret:Segment_HUSN_AKHL-21592_0053 a minaret:TranscriptSegment ;
    minaret:endTime 1028.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0054 ;
    minaret:sequenceIndex 53 ;
    minaret:startTime 1008.64 ;
    minaret:text "فوراً جو خیال آپ کو ٹھنڈا کر دے گا وہ یہ کہ بڑائی تو اللہ کے لیے ہے، بڑا تو صرف اللہ ہے، میں تو بڑی نہیں۔ خواہ آپ کسی کے مقابلے میں واقعی بڑے ہوں بھی عمر کے اعتبار سے، کیونکہ اللہ نے سب کو ایک جیسا نہیں بنایا، بہت چیزوں میں" .

minaret:Segment_HUSN_AKHL-21592_0054 a minaret:TranscriptSegment ;
    minaret:endTime 1048.36 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0055 ;
    minaret:sequenceIndex 54 ;
    minaret:startTime 1028.58 ;
    minaret:text "فرق رکھا ہے۔ انسان کنگھی کے دندانوں کی طرح نہیں ہیں بلکہ انگلیوں کی طرح ہیں، سائز میں بڑے چھوٹے ہیں، فزیکلی بھی، عمر کے اعتبار سے بھی، مال کے اعتبار سے بھی، عقل کے اعتبار سے بھی، علم کے اعتبار سے بھی۔ ہے یہ فرق یا نہیں؟ یہ فرق ہے۔" .

minaret:Segment_HUSN_AKHL-21592_0055 a minaret:TranscriptSegment ;
    minaret:endTime 1068.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0056 ;
    minaret:sequenceIndex 55 ;
    minaret:startTime 1048.36 ;
    minaret:text "اس فرق کو آپ ختم نہیں کر سکتے۔ لہٰذا یقینی طور پر گھر میں کوئی تو بڑا ہوگا۔ اب آپ اگر گھر میں بڑے ہیں تو بہت دفعہ ایسا ہو سکتا ہے کہ جب آپ کی بڑائی کو نہ مانا جائے جیسے بچے بعض اوقات اپنی من مانی کرتے ہیں تو کیا کرتے ہیں؟ دراصل ہماری بڑائی کی نفی کر" .

minaret:Segment_HUSN_AKHL-21592_0056 a minaret:TranscriptSegment ;
    minaret:endTime 1088.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0057 ;
    minaret:sequenceIndex 56 ;
    minaret:startTime 1068.34 ;
    minaret:text "رہے ہوتے ہیں یا ہمیں چیلنج کر رہے ہوتے ہیں۔ ہماری بڑائی کی نفی کر رہے ہوتے ہیں یا ہمیں چیلنج کر رہے ہوتے ہیں۔ اسی طرح مثلاً آپ استاد ہیں تو اپنے شاگرد کے مقابلے میں تب ہی استاد ہیں کہ آپ کو اللہ نے علم زیادہ دیا ہے لیکن بہت دفعہ شاگرد آپ کی بات نہیں مانتے تو کیا ہوگا؟ آپ کی بڑائی" .

minaret:Segment_HUSN_AKHL-21592_0057 a minaret:TranscriptSegment ;
    minaret:endTime 1107.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0058 ;
    minaret:sequenceIndex 57 ;
    minaret:startTime 1088.18 ;
    minaret:text "چیلنج ہو جائے گی۔ اسی طرح آپ کے پاس مال ہے یا آپ سمجھدار زیادہ ہیں اور دوسرا جو آپ سے معاملہ کر رہا ہے وہ انتہائی ناسمجھ ہے، بے وقوف ہے اور وہ اپنی بے وقوفی کی وجہ سے آپ کی بات نہیں مان رہا، تو اب اس میں کیا ہو گیا؟ آپ کو اس نے چیلنج کیا ایک طرح سے یا آپ کی بڑائی کو ٹھیس پہنچائی۔" .

minaret:Segment_HUSN_AKHL-21592_0058 a minaret:TranscriptSegment ;
    minaret:endTime 1127.48 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 1107.6 ;
    minaret:text "ایسے میں کیا ہوگا کہ آپ ضرور غصہ کریں گے، غصہ نہیں تو غم۔ کیونکہ غصہ کس پہ آتا ہے؟ اپنے سے چھوٹے پر، اور غم کس کے مقابلے میں ہوتا ہے؟ جو اپنے سے بڑا ہوتا ہے۔ جب ہم ری ایکٹ نہیں کر سکتے تو پھر ہم اپنے اندر ہی غم رکھ کے کھاتے ہیں خود کو۔" .

minaret:Segment_HUSN_AKHL-21592_0059 a minaret:TranscriptSegment ;
    minaret:endTime 1148.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0060 ;
    minaret:sequenceIndex 59 ;
    minaret:startTime 1128.16 ;
    minaret:text "بہرحال اب کیا ہے کہ ایسے موقع پر جہاں آپ دیکھیں کہ آپ کی انا کو ٹھیس لگ گئی ہے اور آپ کو کسی نے غصہ دلا دیا ہے یا آپ کو کسی نے رنجیدہ کر دیا ہے یا آپ کو کسی نے ہرٹ کر دیا ہے جس پر آپ خود بھی واچ کر رہے ہیں اور جائزہ لے رہے ہیں کہ کیا کیا باتیں آپ کو لوگوں کی تکلیف دے رہی" .

minaret:Segment_HUSN_AKHL-21592_0060 a minaret:TranscriptSegment ;
    minaret:endTime 1168.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0061 ;
    minaret:sequenceIndex 60 ;
    minaret:startTime 1148.1 ;
    minaret:text "ہیں یا دی ہیں، ایسے مواقع پر پھر پلٹ کر تکلیف دینے والے کے ساتھ اچھا بننا، دکھ دینے والے کے ساتھ بھلائی کرنا، کسی کی سختی کے جواب میں نرمی کرنا صرف اس وقت ممکن ہو سکتا ہے جب انسان فوراً اپنے آپ کو یہ سمجھائے کہ بڑا تو صرف اللہ ہے، میں تو بڑی نہیں۔" .

minaret:Segment_HUSN_AKHL-21592_0061 a minaret:TranscriptSegment ;
    minaret:endTime 1187.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0062 ;
    minaret:sequenceIndex 61 ;
    minaret:startTime 1168.1 ;
    minaret:text "جوں ہی یہ خیال دل سے نکلے گا اپنی بڑائی کا تو ہر چیز آسان ہو جائے گی۔ کیونکہ جو اپنی بڑائی کا خیال ہے یہ ایسے ہے جیسے غبارے میں پھونک بھری ہوئی ہوتی ہے تو اس میں کیا ہو جاتا ہے؟ اکڑ ہو جاتی ہے۔ جتنا زیادہ وہ پھولا ہوا ہوگا تو وہ اتنا ہی اکڑا ہوا ہوگا" .

minaret:Segment_HUSN_AKHL-21592_0062 a minaret:TranscriptSegment ;
    minaret:endTime 1207.14 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0063 ;
    minaret:sequenceIndex 62 ;
    minaret:startTime 1187.22 ;
    minaret:text "اور جوں ہی اس میں سے پھونک نکلے گی تو کیا ہوگا؟ نرم ہو جائے گا۔ تو ہمارے اندر جب تک انا کی پھونک بھری ہوئی ہوتی ہے، اکڑ بھری ہوئی ہوتی ہے، سختی ہوتی ہے اور ہم سمجھتے ہیں ہم بڑی چیز ہیں تو پھر کبھی بھی انسان دوسرے کے ساتھ اچھا اخلاق نہیں برت سکتا۔" .

minaret:Segment_HUSN_AKHL-21592_0065 a minaret:TranscriptSegment ;
    minaret:endTime 1266.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0066 ;
    minaret:sequenceIndex 65 ;
    minaret:startTime 1246.98 ;
    minaret:text "ہیں، کوئی سختی کر رہا ہے، آپ بھی سختی کر رہے ہیں، اینٹ کا جواب پتھر سے دے رہے ہیں، کیا ہوگا؟ اور زیادہ فساد اور خرابی پیدا ہوگی۔ اور خاص طور پر ایسے لوگوں کے ساتھ کہ جن کے اندر کوئی خوفِ خدا نہیں اور کوئی حیا نہیں اور کچھ نہیں وہاں کبھی بھی اصلاح نہیں ہو سکتی۔ اس" .

minaret:Segment_HUSN_AKHL-21592_0066 a minaret:TranscriptSegment ;
    minaret:endTime 1286.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0067 ;
    minaret:sequenceIndex 66 ;
    minaret:startTime 1266.92 ;
    minaret:text "میں آپ دیکھیے کہ جب آپ اکڑ کے معاملہ کرتے ہیں تو لوگوں کی انا جگا دیتے ہیں، آپ دوسروں کی انا ہٹ کر دیتے ہیں۔ اور جب انا جاگ جاتی ہے تو پھر نتیجہ کیا ہوتا ہے؟ مسئلہ بڑھتا ہے، مسئلہ بڑھ جاتا ہے۔ اور اگر آپ نرمی سے کام لیتے ہیں تو آپ لوگوں کے" .

minaret:Segment_HUSN_AKHL-21592_0067 a minaret:TranscriptSegment ;
    minaret:endTime 1306.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0068 ;
    minaret:sequenceIndex 67 ;
    minaret:startTime 1286.58 ;
    minaret:text "ضمیر کو جگاتے ہیں۔ کس کو جگاتے ہیں؟ ضمیر کو جگاتے ہیں۔ اور جب آپ کسی کا ضمیر جگا دیں تو پھر کیا ہوتا ہے؟ جب کسی کا ضمیر جاگ جائے تو پھر آپ اس سے بدلہ نہ بھی لیں تو کیا ہوگا؟ وہ صحیح کرے گا اور وہ خود شرمندہ ہوگا، وہ خود ریلائز" .

minaret:Segment_HUSN_AKHL-21592_0068 a minaret:TranscriptSegment ;
    minaret:endTime 1326.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0069 ;
    minaret:sequenceIndex 68 ;
    minaret:startTime 1306.58 ;
    minaret:text "کرے گا کہ اس کی غلطی ہے۔ اور اگر دیکھا جائے تو نرمی ایک بہت بڑا ہتھیار ہے اس دنیا میں کامیابی کے لیے، اور آخرت میں کامیابی کے لیے نرم رویہ بہت بڑا ہتھیار ہے۔ یہی وہ چیز ہے جس سے آپ کسی کا دل جیت سکتے ہیں۔ سختی سے کسی کا دل نہیں" .

minaret:Segment_HUSN_AKHL-21592_0069 a minaret:TranscriptSegment ;
    minaret:endTime 1346.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0070 ;
    minaret:sequenceIndex 69 ;
    minaret:startTime 1326.46 ;
    minaret:text "جیت سکتے اور اصل فاتح کون ہوتا ہے جو دل جیتے؟ اصل کامیاب وہ ہے، اصل فاتح وہ ہے جو دوسروں کے دل جیت لے اور یہ ایسا نہیں کہ کوئی آپ کے ساتھ نرم ہے اور آپ بھی نرم ہیں، کوئی ہنس رہا ہے تو آپ بھی ہنس رہے ہیں، تو آپ سمجھیں کہ آپ نے کسی کا دل جیت لیا۔ نہیں، یہ دل جیتنا نہیں" .

minaret:Segment_HUSN_AKHL-21592_0070 a minaret:TranscriptSegment ;
    minaret:endTime 1365.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0071 ;
    minaret:sequenceIndex 70 ;
    minaret:startTime 1346.44 ;
    minaret:text "ہوتا۔ دل جیتنا کیا ہے کہ کوئی آپ کے ساتھ اچھا ہے تو بھی اور برا ہے تو بھی آپ اپنا کام کروا سکیں جو آپ چاہتے ہیں۔ اور اس میں ہم دیکھتے ہیں کہ نبی صلی اللہ علیہ وسلم نے کس طرح لوگوں کو وہ سب سکھا دیا جو آپ سکھانا چاہتے تھے" .

minaret:Segment_HUSN_AKHL-21592_0073 a minaret:TranscriptSegment ;
    minaret:endTime 1424.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0074 ;
    minaret:sequenceIndex 73 ;
    minaret:startTime 1404.96 ;
    minaret:text "میسج دینا آسان ہو گیا۔ آپ دیکھیے کہ جب آپ سختی کرتے ہیں تو یہ ایسے ہی جیسے آپ کانٹے بو رہے ہیں اپنے لیے۔ اس سے لڑے، اس سے جھگڑے، اس کو ڈانٹا، اس پہ چیخے، اس کے ساتھ بدتمیزی کی، اس پہ چلائے، نتیجہ کیا ہوا؟ چاروں طرف لوگوں کو اپنا دشمن بنا لیا۔ تو آپ پھر" .

minaret:Segment_HUSN_AKHL-21592_0074 a minaret:TranscriptSegment ;
    minaret:endTime 1444.56 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0075 ;
    minaret:sequenceIndex 74 ;
    minaret:startTime 1424.8 ;
    minaret:text "خود کس میں جیتے ہیں جب آپ نے اس کو بھی چھیڑ لیا، اس کو بھی اپنے خلاف کر لیا، اس کو بھی کر لیا، اس کو بھی، اس کو بھی، ہر ایک کے دل میں اپنی نفرت کے بیج بو لیے۔ تو خواہ کوئی ڈر کے مارے آپ کے سامنے بول نہیں سکتا، خواہ کوئی ڈر کے مارے آپ کو کچھ جواب نہیں بھی دے سکتا لیکن کبھی جھانک کے دیکھیے اپنے آپ میں" .

minaret:Segment_HUSN_AKHL-21592_0075 a minaret:TranscriptSegment ;
    minaret:endTime 1464.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0076 ;
    minaret:sequenceIndex 75 ;
    minaret:startTime 1444.56 ;
    minaret:text "کہ اس کے دل میں آپ کی عزت کتنی ہے، وہ کتنی خوشی سے آپ کی بات مانتا ہے، کس خوشی سے آپ کا کام کرنا چاہتا ہے، کس خوشی سے آپ کی بات سننا چاہتا ہے! اور یہی وجہ ہے کہ آج ہمارا دین اور دین کا جو اثر ہے وہ بڑھتا نہیں کیونکہ دین" .

minaret:Segment_HUSN_AKHL-21592_0076 a minaret:TranscriptSegment ;
    minaret:endTime 1483.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0077 ;
    minaret:sequenceIndex 76 ;
    minaret:startTime 1464.08 ;
    minaret:text "سکھانے والوں میں اور دین پھیلانے والوں میں وہ پیغمبرانہ اخلاق نہیں رہا۔ دین صرف باتیں کرنے سے نہیں پھیلتا، دین رویے اور معاملے سے پھیلتا ہے۔ اور اسی لیے آپ دیکھتے ہیں کہ بعض اوقات وہ سب سے بڑا ری ایکشن خود اپنے قریب کے لوگوں میں ہوتا ہے کہ آپ" .

minaret:Segment_HUSN_AKHL-21592_0077 a minaret:TranscriptSegment ;
    minaret:endTime 1503.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0078 ;
    minaret:sequenceIndex 77 ;
    minaret:startTime 1483.96 ;
    minaret:text "اپنے بچوں کو کچھ سکھانا چاہتے ہیں وہ سننے کا نام ہی نہیں لیتے، کیوں؟ اس لیے کہ آپ کا رویہ ان کے ساتھ وہ نہیں کہ جس سے وہ آپ کی طرف کھنچیں۔ اگرچہ قدرتی طور پر ماں باپ کے دل میں محبت ہوتی ہے بچوں کے لیے، لیکن پھر بھی جب تک ایکسٹرا کیئر اور ایکسٹرا ایفرٹ کے ساتھ آپ ان کو قریب نہیں کرتے" .

minaret:Segment_HUSN_AKHL-21592_0078 a minaret:TranscriptSegment ;
    minaret:endTime 1523.36 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0079 ;
    minaret:sequenceIndex 78 ;
    minaret:startTime 1503.46 ;
    minaret:text "ان کی جہالت اور نادانیوں کو برداشت کرتے ہوئے، تو پھر کیا ہوتا ہے؟ گھروں میں دین کے خلاف ری ایکشن ہو جاتا ہے، گھر والے سپورٹیو نہیں رہتے اور جس کے گھر سے تعاون نہ رہے وہ پھر آگے نہیں بڑھ سکتا، وہ زیادہ کچھ نہیں کر سکتا۔ تو بات یہ ہے کہ" .

minaret:Segment_HUSN_AKHL-21592_0079 a minaret:TranscriptSegment ;
    minaret:endTime 1542.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0080 ;
    minaret:sequenceIndex 79 ;
    minaret:startTime 1523.36 ;
    minaret:text "جب آپ دوسروں کے ساتھ نرمی کا رویہ اختیار کرتے ہیں تو دوسرے لازماً آپ کی عزت کرتے ہیں، ان کے دلوں میں آپ کے لیے محبت پیدا ہو جاتی ہے۔ اور جب دلوں میں محبت پیدا ہو جاتی ہے تو وہ ہر قیمت پر آپ سے تعاون کرنے کو تیار ہو جاتے ہیں، آپ کے مددگار بن جاتے ہیں، آپ کے لیے سہولت پیدا کر دیتے ہیں، ورنہ" .

minaret:Segment_HUSN_AKHL-21592_0080 a minaret:TranscriptSegment ;
    minaret:endTime 1562.42 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0081 ;
    minaret:sequenceIndex 80 ;
    minaret:startTime 1542.5 ;
    minaret:text "ہر چیز بنی بنائی بھی ختم ہو جاتی ہے اور آسان کام بھی مشکل ہو جاتے ہیں۔ تو خلاصہ یہ ہے کہ اگر آپ چاہتے ہیں کہ آپ کی زندگی آسان ہو اور مشکلات کم ہوں تو اس کے لیے پتھر نہیں پھول بننا ہوگا، سخت نہیں نرم بننا ہوگا۔ اور" .

minaret:Segment_HUSN_AKHL-21592_0081 a minaret:TranscriptSegment ;
    minaret:endTime 1582.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0082 ;
    minaret:sequenceIndex 81 ;
    minaret:startTime 1562.42 ;
    minaret:text "پھر آپ دیکھیں کہ اسی زندگی میں آپ اس سے کئی گنا زیادہ کام کر سکتے ہیں، لیکن آف کورس اللہ کی مدد کے بغیر کوئی چیز ہو نہیں سکتی۔ تو پھر جب تک بندے کا معاملہ اللہ تعالیٰ سے درست نہ ہو تو کچھ بھی درست نہیں ہو سکتا۔ تو حسنِ اخلاق کی بنیاد کیا" .

minaret:Segment_HUSN_AKHL-21592_0082 a minaret:TranscriptSegment ;
    minaret:endTime 1602.3 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0083 ;
    minaret:sequenceIndex 82 ;
    minaret:startTime 1582.38 ;
    minaret:text "ہے؟ اللہ کا ڈر، تنہائی میں بھی اور لوگوں کے سامنے بھی۔ ایسا ڈر کہ خود کو ہم خود ہی سزا دے سکیں اس سے پہلے کہ لوگ ہم سے نفرت کریں اور لوگوں کی نظر میں ہم گریں، ہم خود کو خود اپنی نظروں سے دیکھ کر اپنی اصلاح" .

minaret:Segment_HUSN_AKHL-21592_0092 a minaret:TranscriptSegment ;
    minaret:endTime 1780.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0093 ;
    minaret:sequenceIndex 92 ;
    minaret:startTime 1760.5 ;
    minaret:text "ماں باپ کے لیے جھکنے کا حکم تو دوسری جگہ ہے ہی کہ ماں باپ کے لیے کیا کرو؟ عاجزی سے پیش آؤ، کندھے جھکا کے۔ تو وہاں کیا ہے؟ بڑے کے سامنے چھوٹے کا جھکنا اور یہاں چھوٹوں کے سامنے بڑے کا جھکنا۔ گویا سب کے لیے یہ جھکنے کا حکم ہے۔ قَالَ اللّٰهُ تَعَالٰی:" .

minaret:Segment_HUSN_AKHL-21592_0094 a minaret:TranscriptSegment ;
    minaret:endTime 1819.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0095 ;
    minaret:sequenceIndex 94 ;
    minaret:startTime 1799.98 ;
    minaret:text "والوں کے مقابلے میں بھی نرم اور ساتھ والوں، برابر والوں کے لیے بھی نرم۔ کیا دلیل ہے؟ بڑوں کے سامنے جھکنے کی، ماں باپ کے سامنے جھکنے کا قرآن نے حکم دیا۔ چھوٹوں کے سامنے جھکنے کی، نبی کریم صلی اللہ علیہ وسلم کو حکم دیا گیا" .

minaret:Segment_HUSN_AKHL-21592_0096 a minaret:TranscriptSegment ;
    minaret:endTime 1859.56 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0097 ;
    minaret:sequenceIndex 96 ;
    minaret:startTime 1839.66 ;
    minaret:text "بَیْتٍ خَیْرًا اَدْخَلَ عَلَیْهِمُ الرِّفْقَ۔ رَوَاهُ اَحْمَدُ۔ عَنْ عَائِشَةَ، عائشہ رضی اللہ تعالیٰ عنہا سے روایت ہے، اَنَّهَا قَالَتْ، کہتی ہیں، قَالَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ، کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اِذَا اَرَادَ اللّٰهُ،" .

minaret:Segment_HUSN_AKHL-21592_0097 a minaret:TranscriptSegment ;
    minaret:endTime 1879.42 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0098 ;
    minaret:sequenceIndex 97 ;
    minaret:startTime 1859.56 ;
    minaret:text "جب ارادہ کرتا ہے اللہ تعالیٰ عزوجل، بِاَهْلِ بَیْتٍ، کسی گھر والوں کے ساتھ، بیت گھر کو کہتے ہیں اور اہلِ بیت گھر والے، کسی گھرانے کے ساتھ، خَیْرًا، بھلائی کا، یعنی جب اللہ چاہتا ہے کہ کسی گھر پہ یا کسی گھرانے پہ بھلائی ہو، اَدْخَلَ،" .

minaret:Segment_HUSN_AKHL-21592_0099 a minaret:TranscriptSegment ;
    minaret:endTime 1918.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0100 ;
    minaret:sequenceIndex 99 ;
    minaret:startTime 1899.34 ;
    minaret:text "کے اندر جو چیز پریویل کرتی ہے، جو اس گھرانے کا ایک عام اصول ہے یا اس گھر کے افراد کے آپس کے تعلقات نرمی پر مبنی ہیں تو وہاں خیر ہی خیر ہے، برکت ہی برکت ہے، بھلائیاں ہی بھلائیاں ہیں۔ گویا ان کے لیے" .

minaret:Segment_HUSN_AKHL-21592_0100 a minaret:TranscriptSegment ;
    minaret:endTime 1938.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0101 ;
    minaret:sequenceIndex 100 ;
    minaret:startTime 1918.96 ;
    minaret:text "بھلائیوں کے دروازے کھل جاتے ہیں۔ حدیث کی راویہ عائشہ رضی اللہ عنہا ہیں جو کہ خود اپنی زندگی میں اپنے گھرانے میں، والد کے گھر بھی اور نبی صلی اللہ علیہ وسلم کے گھر بھی نرمی اور شفقت کو دیکھتی رہیں اور پھر آپ کے اپنے اخلاق اور" .

minaret:Segment_HUSN_AKHL-21592_0101 a minaret:TranscriptSegment ;
    minaret:endTime 1958.78 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0102 ;
    minaret:sequenceIndex 101 ;
    minaret:startTime 1938.92 ;
    minaret:text "مزاج کے اندر بھی وہ نظر آتی ہے۔ کون تھیں حضرت عائشہ؟ نبی صلی اللہ علیہ وسلم کی اہلیہ تھیں۔ ان کا جو نسب بیان کیا جاتا ہے: ام المؤمنین سیدہ عائشہ بنتِ ابی بکر صدیق، قریشیہ تیمیہ مکیہ۔ ان کو ام المؤمنین" .

minaret:Segment_HUSN_AKHL-21592_0102 a minaret:TranscriptSegment ;
    minaret:endTime 1978.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0103 ;
    minaret:sequenceIndex 102 ;
    minaret:startTime 1958.78 ;
    minaret:text "کہا جاتا ہے۔ نام عائشہ ہے، ابو بکر کی بیٹی ہیں، قریشیہ ہیں یعنی خاندانِ قریش سے تعلق رکھتی ہیں، تیمیہ ہیں یعنی قبیلہ تیم کی طرف ان کی نسبت ہے، اور مکیہ ہیں کیونکہ مکہ میں پیدا ہوئیں۔ والد اور والدہ دونوں ہی صحابی تھے، دادا کو بھی یہ سعادت نصیب ہوئی۔" .

minaret:Segment_HUSN_AKHL-21592_0103 a minaret:TranscriptSegment ;
    minaret:endTime 1999.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0104 ;
    minaret:sequenceIndex 103 ;
    minaret:startTime 1979.18 ;
    minaret:text "حضرت فاطمہ سے آٹھ سال چھوٹی تھیں، مکہ میں پیدا ہوئیں اور اس وقت جبکہ آپ صلی اللہ علیہ وسلم کی نبوت کا اعلان ہو چکا تھا، یعنی مسلمان خاندان میں پیدا ہوئیں یعنی حضرت ابو بکر اسلام لا چکے تھے۔ آپ نبی صلی اللہ علیہ وسلم کی کتنی" .

minaret:Segment_HUSN_AKHL-21592_0104 a minaret:TranscriptSegment ;
    minaret:endTime 2018.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0105 ;
    minaret:sequenceIndex 104 ;
    minaret:startTime 1999.0 ;
    minaret:text "محبوب تھیں اس کے بارے میں آپ اندازہ لگا سکتے ہیں کہ عمرو بن العاص جو آٹھ ہجری میں مسلمان ہوئے انہوں نے نبی صلی اللہ علیہ وسلم سے پوچھا کہ یا رسول اللہ صلی اللہ علیہ وسلم! لوگوں میں سب سے زیادہ آپ کو پیارا کون ہے؟ فرمایا: عائشہ۔ انہوں نے پوچھا: مردوں میں سے؟ فرمایا: اس کا باپ۔ اور" .

minaret:Segment_HUSN_AKHL-21592_0105 a minaret:TranscriptSegment ;
    minaret:endTime 2038.82 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0106 ;
    minaret:sequenceIndex 105 ;
    minaret:startTime 2018.92 ;
    minaret:text "صحابہ کرام کو یہ بات بہت اچھی طرح پتا تھی کہ آپ حضرت عائشہ سے کتنی محبت کرتے ہیں۔ لہٰذا روایات میں آتا ہے کہ جس دن آپ حضرت عائشہ کے گھر ہوتے صحابہ کثرت سے آپ کے ہاں تحائف بھیجتے تاکہ آپ کی خوشی حاصل کر سکیں اور متعدد واقعات ہمیں ملتے ہیں۔ جب" .

minaret:Segment_HUSN_AKHL-21592_0106 a minaret:TranscriptSegment ;
    minaret:endTime 2057.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0107 ;
    minaret:sequenceIndex 106 ;
    minaret:startTime 2038.82 ;
    minaret:text "آپ صلی اللہ علیہ وسلم کے ہاں حضرت عائشہ آ گئیں یعنی رخصتی ہو گئی جو کہ جنگِ بدر کے بعد ہوئی جیسا کہ آپ جانتے ہیں کہ بدر کا موقع جو تھا مسلمانوں کے لیے بہت خوشی کا موقع تھا۔ تو اس کے بعد پھر حضرت عائشہ کی رخصتی ہوئی اور شوال ہی میں نکاح ہوا تھا اور شوال ہی میں رخصتی ہوئی تھی تو ان کو شوال کا مہینہ بہت پسند تھا۔" .

minaret:Segment_HUSN_AKHL-21592_0107 a minaret:TranscriptSegment ;
    minaret:endTime 2074.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0108 ;
    minaret:sequenceIndex 107 ;
    minaret:startTime 2058.68 ;
    minaret:text "بہرحال آپ اس وقت عمر میں چھوٹی تھیں اور کھیلنے سے دلچسپی تھی۔ وہ اپنے بارے میں خود کہتی ہیں کہ آپ صلی اللہ علیہ وسلم جب گھر تشریف لاتے تو میں سہیلیوں کے ساتھ گڑیوں کے ساتھ کھیلتی تھی اور جب آپ تشریف لاتے تو میری سہیلیاں ادھر ادھر چھپ جاتیں۔" .

minaret:Segment_HUSN_AKHL-21592_0108 a minaret:TranscriptSegment ;
    minaret:endTime 2080.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0109 ;
    minaret:sequenceIndex 108 ;
    minaret:startTime 2074.22 ;
    minaret:text "تو آپ ایک ایک کو ڈھونڈتے اور کہتے کہ تم کھیلو، یعنی کھیلنے کو انکریج کرتے۔" .

minaret:Segment_HUSN_AKHL-21592_0109 a minaret:TranscriptSegment ;
    minaret:endTime 2100.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0110 ;
    minaret:sequenceIndex 109 ;
    minaret:startTime 2080.52 ;
    minaret:text "اب آپ دیکھیے کہ آپ ایک نبی ہیں اور آپ کا گھرانہ جو ہے وہ دنیا بھر کے لیے ایک روشنی کا ذریعہ ہے، لیکن عمر کی رعایت رکھتے ہوئے کہ اس عمر میں ایک بچی کے شوق کیا ہو سکتے ہیں اور یہ بالکل ابتدائی دنوں کی بات ہے کہ ظاہر ہے کہ باپ کے گھر سے آئی ہیں اور ابھی طبیعت" .

minaret:Segment_HUSN_AKHL-21592_0110 a minaret:TranscriptSegment ;
    minaret:endTime 2120.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0111 ;
    minaret:sequenceIndex 110 ;
    minaret:startTime 2100.44 ;
    minaret:text "میں وہ سنجیدگی نہیں ہے، بچپن سے انتہائی ذہین تھیں لیکن یہاں آپ نبی صلی اللہ علیہ وسلم کی نرمی اور شفقت کو دیکھ سکتے ہیں کہ وہ مزاج کا کتنا اعتبار کرتے ہوئے، رعایت کرتے ہوئے ان کو اور نہ صرف یہ کہ ان کو بلکہ ان کی دوستوں کو بھی انکریج کرتے ہیں۔ اسی طرح وہ واقعہ بھی آپ کو یاد ہو گا جب" .

minaret:Segment_HUSN_AKHL-21592_0111 a minaret:TranscriptSegment ;
    minaret:endTime 2140.24 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0112 ;
    minaret:sequenceIndex 111 ;
    minaret:startTime 2120.4 ;
    minaret:text "ایک موقع پر ایک وفد مسجد نبوی میں آیا اور حبشیوں کا تماشا تھا، تو حضرت عائشہ رضی اللہ تعالیٰ عنہا کہتی ہیں کہ میں آپ کے کندھے پر سر رکھ کر دیکھتی رہی۔ اس وقت تک آپ کھڑے رہے جب تک میں تھک نہ گئی، جب تک میں نے نہ کہا کہ ہاں اب بس۔ خود بھی آپ نے دیکھا اس کھیل کو اور حضرت عائشہ کو بھی دکھایا اور یہ بخاری کی روایت ہے۔ پھر اسی طرح آپ" .

minaret:Segment_HUSN_AKHL-21592_0112 a minaret:TranscriptSegment ;
    minaret:endTime 2160.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0113 ;
    minaret:sequenceIndex 112 ;
    minaret:startTime 2140.24 ;
    minaret:text "دیکھتے ہیں کہ ایک اور موقع جب حضرت ابو بکر رضی اللہ تعالیٰ عنہ آپ کے گھر تشریف لاتے ہیں تو حضرت عائشہ اور حضور کے درمیان کچھ بات چل رہی ہے اور حضرت عائشہ غصے سے بول رہی ہیں تو حضرت ابو بکر دیکھتے ہی حضرت عائشہ کی طرف دوڑتے ہیں کہ ان کو ایک لگائیں اور حضور صلی اللہ علیہ وسلم فوراً آگے آ جاتے ہیں اور پھر حضرت ابو بکر واپس چلے" .

minaret:Segment_HUSN_AKHL-21592_0113 a minaret:TranscriptSegment ;
    minaret:endTime 2179.36 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0114 ;
    minaret:sequenceIndex 113 ;
    minaret:startTime 2160.22 ;
    minaret:text "جاتے ہیں، تو آپ صلی اللہ علیہ وسلم فرماتے ہیں: دیکھو عائشہ! میں نے تمہیں کیسے بچایا۔ اب یہ ہے نرم مزاجی کا ایک بہترین نمونہ۔ بہت ابتدائی عمر میں آپ سے نکاح ہو گیا تھا اور پھر شادی ہوئی تو براہِ راست آپ سے بہت کچھ سیکھنے کا انہیں موقع ملا اور یہ وجہ ہے کہ بعد کی زندگی میں" .

minaret:Segment_HUSN_AKHL-21592_0114 a minaret:TranscriptSegment ;
    minaret:endTime 2199.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0115 ;
    minaret:sequenceIndex 114 ;
    minaret:startTime 2180.04 ;
    minaret:text "آپ لوگوں کے لیے ایک بہترین معلمہ تھیں۔ حضرت عائشہ رضی اللہ تعالیٰ عنہا کے علم کے بارے میں مختلف صحابہ کرام اور جو آپ کے شاگرد ہیں وہ اپنا اوپینین کیا دیتے ہیں یا آپ کے بارے میں کیا کہتے ہیں؟ عروہ بن زبیر جو ہیں، یہ مدینہ کے مفتی رہے ہیں" .

minaret:Segment_HUSN_AKHL-21592_0115 a minaret:TranscriptSegment ;
    minaret:endTime 2219.7 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0116 ;
    minaret:sequenceIndex 115 ;
    minaret:startTime 2199.96 ;
    minaret:text "آگے جا کر، آپ کے بھانجے بھی ہیں، انہوں نے سب کچھ حضرت عائشہ سے سیکھا بنیادی طور پر، یعنی حضرت عائشہ ان کی معلمہ تھیں۔ وہ کہتے ہیں کہ میں سیدہ عائشہ کی صحبت میں رہا یعنی کہ کئی سال تک میں ان کے پاس رہا، میں نے کبھی کسی کو کسی آیت، کسی فریضے، کسی سنت، کسی" .

minaret:Segment_HUSN_AKHL-21592_0116 a minaret:TranscriptSegment ;
    minaret:endTime 2238.84 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0117 ;
    minaret:sequenceIndex 116 ;
    minaret:startTime 2219.7 ;
    minaret:text "شعر، کسی لڑائی، کسی حسب نسب میں، کسی فیصلے یا طب میں آپ سے بڑا عالم یا روایت کرنے والا نہیں دیکھا۔ یہ ان کے بھانجے کہتے ہیں کہ جتنا آپ کا علم تھا، آپ سے بڑھ کے میں نے کسی اور میں اتنا علم نہیں دیکھا۔ میں نے پوچھا: خالہ جان! طب کہاں سے سیکھی آپ نے؟" .

minaret:Segment_HUSN_AKHL-21592_0117 a minaret:TranscriptSegment ;
    minaret:endTime 2256.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0118 ;
    minaret:sequenceIndex 117 ;
    minaret:startTime 2239.72 ;
    minaret:text "فرمایا: میں بیمار ہو جاتی میرے علاج کے لیے کوئی چیز بیان کی جاتی یا کوئی اور بیمار ہو جاتا اس کے لیے کوئی دوائی بیان کرتا، میں لوگوں سے سنتی کہ بعض بعض کو دوائی وغیرہ بتا رہے ہیں تو میں ان سب چیزوں کو زبانی یاد کر لیتی تھی۔ لکھنے پڑھنے کے لیے اتنی کاپیاں تو نہیں تھیں" .

minaret:Segment_HUSN_AKHL-21592_0118 a minaret:TranscriptSegment ;
    minaret:endTime 2263.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0119 ;
    minaret:sequenceIndex 118 ;
    minaret:startTime 2256.44 ;
    minaret:text "کہ ہماری طرح بھر بھر کے رکھ دیتے اور پھر اس کے بعد یاد کچھ بھی نہیں ہوتا اور جب عمل کا وقت آئے تو سب غائب۔" .

minaret:Segment_HUSN_AKHL-21592_0119 a minaret:TranscriptSegment ;
    minaret:endTime 2283.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0120 ;
    minaret:sequenceIndex 119 ;
    minaret:startTime 2263.22 ;
    minaret:text "تو وہ کہتی ہیں کہ مجھے کوئی علاج بتاتا، کسی اور کو بتاتا یا لوگ آپس میں ایک دوسرے کو بتاتے، تو اس میں آپ دیکھیں کہ ان کی لسننگ کیسی تھی۔ صرف سنتی نہیں تھیں، سن کے پھر اس کو محفوظ کر لیتی تھیں۔ عروہ بن زبیر فرماتے ہیں کہ میں نے آپ کے بہت سے علم کے بارے میں کوئی سوال ہی نہیں کیا یعنی اتنا کچھ" .

minaret:Segment_HUSN_AKHL-21592_0120 a minaret:TranscriptSegment ;
    minaret:endTime 2303.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0121 ;
    minaret:sequenceIndex 120 ;
    minaret:startTime 2283.22 ;
    minaret:text "سیکھا کہ بہت کچھ مجھ سے پوچھنا بھی نہ پڑا۔ امام مسروق جو ہیں انہوں نے حضرت عائشہ سے بہت سی احادیث روایت کی ہیں، ان سے پوچھا گیا: کیا حضرت عائشہ میراث کا علم اچھی طرح جانتی تھیں یعنی علمِ وراثت؟ تو مسروق کہتے ہیں: اللہ کی قسم! میں نے بڑے بڑے صحابہ کرام کو دیکھا کہ" .

minaret:Segment_HUSN_AKHL-21592_0121 a minaret:TranscriptSegment ;
    minaret:endTime 2322.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0122 ;
    minaret:sequenceIndex 121 ;
    minaret:startTime 2303.08 ;
    minaret:text "وہ میراث کے بارے میں سیدہ عائشہ سے سوال کیا کرتے تھے۔ وہ کہتے ہیں کہ میں نے بزرگ صحابہ کرام کو دیکھا یعنی عمر میں بھی بڑے اور علم میں بھی بڑے کہ وہ ان سے میراث کے بارے میں پوچھتے تھے۔ ابو موسیٰ اشعری روایت کرتے ہیں: ہم اصحابِ محمد صلی اللہ علیہ وسلم کو جب کسی مسئلے میں کوئی مشکل" .

minaret:Segment_HUSN_AKHL-21592_0122 a minaret:TranscriptSegment ;
    minaret:endTime 2342.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0123 ;
    minaret:sequenceIndex 122 ;
    minaret:startTime 2322.96 ;
    minaret:text "پیش آتی اور ہم نے اس مسئلے کے بارے میں سیدہ عائشہ سے پوچھا تو ہم نے اس مسئلے کا علم ان کے پاس پایا۔ کبھی ہمیں محرومی نہیں ہوئی کہ ہم جائیں کچھ پوچھنے کے لیے اور وہ کہیں کہ میں نہیں جانتی۔ کہا جاتا ہے کہ اگر سیدہ عائشہ کے علم کا تمام عورتوں سے موازنہ کیا جائے" .

minaret:Segment_HUSN_AKHL-21592_0123 a minaret:TranscriptSegment ;
    minaret:endTime 2362.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0124 ;
    minaret:sequenceIndex 123 ;
    minaret:startTime 2342.68 ;
    minaret:text "تو ان کا علم بڑھ کر ہوگا یعنی دورِ نبوت کی جتنی بھی خواتین تھیں یا بعد کے زمانوں میں بھی دین کا علم جتنی بھی عورتوں کے پاس ہے ان سب کو اکٹھا کر لیا جائے تو اس پر حضرت عائشہ کا علم جو ہے وہ حاوی ہوگا، بھاری ہوگا۔ پھر اسی طرح عطاء بن ابی رباح، وہ ایک تابعی ہیں، وہ" .

minaret:Segment_HUSN_AKHL-21592_0124 a minaret:TranscriptSegment ;
    minaret:endTime 2382.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0125 ;
    minaret:sequenceIndex 124 ;
    minaret:startTime 2362.68 ;
    minaret:text "کہتے ہیں کہ سیدہ عائشہ سب لوگوں سے زیادہ فقیہ اور عام مسائل میں سب لوگوں سے زیادہ اچھی رائے رکھنے والی تھیں۔ پھر اسی طرح یہ ہے کہ نہ صرف یہ کہ علم میں بہت آگے تھیں، عمل میں بھی بہت آگے تھیں یعنی جو کچھ پاس ہوتا وہ صدقہ کر دیتی تھیں۔ سیدنا عروہ بن زبیر کہتے ہیں: میں نے" .

minaret:Segment_HUSN_AKHL-21592_0125 a minaret:TranscriptSegment ;
    minaret:endTime 2402.2 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0126 ;
    minaret:sequenceIndex 125 ;
    minaret:startTime 2382.6 ;
    minaret:text "سیدہ عائشہ کو دیکھا کہ وہ ستر ہزار تقسیم کر رہی ہیں۔ اب یہاں درہم دینار کا لفظ نہیں اس لیے میں کچھ ایڈ نہیں کر سکتی کہ ستر ہزار تقسیم کر رہی ہیں اور خود اپنی قمیص کے گریبان کو پیوند لگا رکھا ہے، یعنی دینے میں اتنی آگے تھیں اور اپنی ذات پہ خرچ کرنا بھول جاتیں۔" .

minaret:Segment_HUSN_AKHL-21592_0126 a minaret:TranscriptSegment ;
    minaret:endTime 2422.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0127 ;
    minaret:sequenceIndex 126 ;
    minaret:startTime 2402.2 ;
    minaret:text "ایک دفعہ معاویہ بن ابی سفیان نے حضرت عائشہ کے پاس ایک لاکھ درہم بھیجے۔ عروہ کہتے ہیں کیونکہ بھانجے ہیں پاس ہی رہتے تھے، عروہ کہتے ہیں: اللہ کی قسم! شام نہ پڑنے دی کہ سب تقسیم کر دیے، آپ کی کنیز نے کہا: کاش اگر آپ ایک درہم کا ہمارے لیے گوشت خرید لیتیں تو انہوں نے" .

minaret:Segment_HUSN_AKHL-21592_0127 a minaret:TranscriptSegment ;
    minaret:endTime 2442.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0128 ;
    minaret:sequenceIndex 127 ;
    minaret:startTime 2422.1 ;
    minaret:text "کہا: اگر تو یہ بات نہ کہتی تو کیا ہوتا ہے؟ یعنی اب جو ہونا تھا وہ ہو گیا یا اگر کہنا تھا تو جب پہلے کہتی، اب جب دے چکے تو دے دیا، کیا پچھتانا۔ اور بہت سے واقعات ہیں ان کی سخاوت کے۔ پھر اسی طرح روزے کثرت سے رکھتی تھیں، حج کا بھی بہت شوق تھا اور ان کے مقام کا اندازہ اس سے لگا" .

minaret:Segment_HUSN_AKHL-21592_0128 a minaret:TranscriptSegment ;
    minaret:endTime 2461.56 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0129 ;
    minaret:sequenceIndex 128 ;
    minaret:startTime 2442.0 ;
    minaret:text "سکتے ہیں کہ یہ بخاری کی روایت ہے، رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اے عائشہ! یہ جبریل آپ کو سلام کہتے ہیں۔ کہتی ہیں کہ انہیں بھی سلام ہو اور اللہ کی رحمت ہو ان پر، یا رسول اللہ صلی اللہ علیہ وسلم آپ جو کچھ دیکھتے ہیں ہم نہیں دیکھ پاتے یعنی آپ تو ان کو دیکھ رہے ہیں کیونکہ جبریل پاس تھے۔" .

minaret:Segment_HUSN_AKHL-21592_0129 a minaret:TranscriptSegment ;
    minaret:endTime 2481.74 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0130 ;
    minaret:sequenceIndex 129 ;
    minaret:startTime 2462.08 ;
    minaret:text "انہوں نے سلام دیا تو پھر آپ نے آگے پہنچایا اور پھر بہت اچھی طرح جواب دیا۔ آپ دیکھیں کہ انہوں نے کہا کہ: هٰذَا جِبْرِیْلُ یَقْرَاُ عَلَیْكِ السَّلَامَ، قَالَتْ: وَعَلَیْهِ السَّلَامُ وَرَحْمَةُ اللّٰهِ۔ زیادہ احسن انداز میں جواب دیا اور کہا جو آپ دیکھتے ہیں وہ ہم نہیں دیکھ سکتے اور پھر" .

minaret:Segment_HUSN_AKHL-21592_0130 a minaret:TranscriptSegment ;
    minaret:endTime 2501.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0131 ;
    minaret:sequenceIndex 130 ;
    minaret:startTime 2481.74 ;
    minaret:text "ہم دیکھتے ہیں کہ بہت فصیح اللسان تھیں یعنی بولنے میں بہت اچھی تھیں اور ان کے بارے میں معاویہ بن ابی سفیان کہتے ہیں کہ: وَاللّٰهِ مَا سَمِعْتُ قَطُّ اَبْلَغَ مِنْ عَائِشَةَ، اللہ کی قسم! میں نے سیدہ عائشہ سے بڑھ کر کسی کو فصیح و بلیغ کلام کرتے ہوئے نہیں سنا۔ احنف بن قیس جو خود ایک" .

minaret:Segment_HUSN_AKHL-21592_0131 a minaret:TranscriptSegment ;
    minaret:endTime 2521.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0132 ;
    minaret:sequenceIndex 131 ;
    minaret:startTime 2501.68 ;
    minaret:text "بہت بڑے فصیح و بلیغ انسان ہیں وہ کہتے ہیں: میں نے ابوبکر، عمر، عثمان، علی رضی اللہ عنہم اور ان کے بعد آنے والے خلفاء کے خطبے سنے ہیں، میں نے اللہ کی مخلوق کے منہ سے سیدہ عائشہ سے بڑھ کر فصیح و بلیغ کلام نہیں سنا۔ یعنی میں نے خلفاء کے" .

minaret:Segment_HUSN_AKHL-21592_0132 a minaret:TranscriptSegment ;
    minaret:endTime 2541.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0133 ;
    minaret:sequenceIndex 132 ;
    minaret:startTime 2521.4 ;
    minaret:text "خطبے بھی سنے اور رضی اللہ تعالیٰ کا کلام بھی سنا ہے لیکن جو کلام عائشہ رضی اللہ تعالیٰ عنہا کا تھا وہ کسی اور کا نہیں تھا اور حافظہ اتنا اچھا تھا کہ بعض اوقات مسلسل اشعار سنایا کرتی تھیں جو مختلف قصائد کے تھے اور وہ کہتی ہیں کہ میں نے لبید بن ربیعہ کے ایک ہزار شعر یاد کیے ہیں،" .

minaret:Segment_HUSN_AKHL-21592_0133 a minaret:TranscriptSegment ;
    minaret:endTime 2561.04 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0134 ;
    minaret:sequenceIndex 133 ;
    minaret:startTime 2541.16 ;
    minaret:text "یعنی حضرت عائشہ کو بے شمار شعر یاد تھے اور پھر لوگوں کو تلقین کرتی تھیں کہ لوگو! اپنے بچوں کو شعر سکھاؤ، اپنے بچوں کو شعر سے سیراب کرو، اس سے ان کی زبانوں میں مٹھاس پیدا ہوگی یعنی بہترین عربی زبان جب آئے گی جب عربی کلام ان کو آئے گا یعنی وکیبلری بڑھے" .

minaret:Segment_HUSN_AKHL-21592_0134 a minaret:TranscriptSegment ;
    minaret:endTime 2580.84 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0135 ;
    minaret:sequenceIndex 134 ;
    minaret:startTime 2561.04 ;
    minaret:text "گی۔ آج آپ دیکھیں کہ بچوں کو ابتدا میں کیا سکھاتے ہیں؟ پوئٹری سکھاتے ہیں، نرسری رائمز اور ابتدا میں نظمیں وغیرہ بچوں کو یاد کراتے ہیں۔ پھر اسی طرح عروہ بن زبیر فرماتے ہیں کہ سیدہ عائشہ کو کوئی چیز درپیش آتی تو فوراً شعر سے جواب دیتیں یعنی باتوں میں بھی ان کے بہت سے شعر" .

minaret:Segment_HUSN_AKHL-21592_0135 a minaret:TranscriptSegment ;
    minaret:endTime 2600.62 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0136 ;
    minaret:sequenceIndex 135 ;
    minaret:startTime 2580.84 ;
    minaret:text "ہوتے اور اسی طرح جب کوئی عورت شادی ہو کر آتی تو اس کو بھی نصیحت کرتی تھیں، جو رشتے کی تلاش میں ہوتا اس کو بھی نصیحت کرتی تھیں۔ ایک موقع پہ کہتی ہیں کہ نکاح ایک بندھن ہے، تم میں سے ہر ایک کو خوب دیکھ لینا چاہیے کہ اپنی بچی کو وہ کس کے ساتھ باندھ رہا ہے،" .

minaret:Segment_HUSN_AKHL-21592_0136 a minaret:TranscriptSegment ;
    minaret:endTime 2620.28 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0137 ;
    minaret:sequenceIndex 136 ;
    minaret:startTime 2600.62 ;
    minaret:text "اور اسی طرح یہ بھی کہتیں کہ چھوٹی عمر کی بچی کی دلچسپی کا لحاظ رکھو اور اندازہ لگایا کرو جو کھیل کود میں دلچسپی رکھتی ہے یعنی اس کے لیے ویسا ہی ماحول فراہم کرو۔ اسی طرح شادی شدہ خواتین کو بھی نصیحت کرتیں کہ تم اپنے خاوندوں کے لیے" .

minaret:Segment_HUSN_AKHL-21592_0137 a minaret:TranscriptSegment ;
    minaret:endTime 2640.28 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0138 ;
    minaret:sequenceIndex 137 ;
    minaret:startTime 2620.28 ;
    minaret:text "دل میں گھر کر جانے والی خوشبو استعمال کیا کرو۔ پھر اسی طرح آپ صلی اللہ علیہ وسلم سے یہ حدیث بھی روایت کرتی ہیں، آپ نے جو حدیث فرمائی ہے کہ دنیا ایک ساز و سامان ہے اور بہترین چیز اس میں نیک عورت ہے۔ پھر اسی طرح رزق کے بارے میں لوگوں کو کہتیں کہ دنیا کے کونوں میں رزق تلاش کرو یعنی" .

minaret:Segment_HUSN_AKHL-21592_0138 a minaret:TranscriptSegment ;
    minaret:endTime 2659.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0139 ;
    minaret:sequenceIndex 138 ;
    minaret:startTime 2640.28 ;
    minaret:text "ایک جگہ بیٹھے نہ رہو، اگر ایک جگہ نہیں ہے تو اس کے لیے کہیں اور چلے جاؤ۔ یہ حضرت عائشہ کا قول ہے کہ دنیا کے کونوں میں رزق تلاش کرو۔ پھر اسی طرح اور بھی آپ کے بہت سے زریں اقوال ہیں جس سے یہ پتہ چلتا ہے کہ حضرت عائشہ رضی اللہ عنہا بے پناہ ذہین اور صاحبِ علم خاتون تھیں۔" .

minaret:Segment_HUSN_AKHL-21592_0145 a minaret:TranscriptSegment ;
    minaret:endTime 2789.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0146 ;
    minaret:sequenceIndex 145 ;
    minaret:startTime 2769.04 ;
    minaret:text "اردگرد کانٹے بوتا ہے، اپنے لیے خود مشکلات کھڑی کرتا ہے اور اس میں آپ اپنے گھر میں بھی دیکھ سکتے ہیں، آپ جہاں کہیں بھی لوگوں کے ساتھ ہیں۔ حضرت جریر نبی صلی اللہ علیہ وسلم سے روایت کرتے ہیں، نبی صلی" .

minaret:Segment_HUSN_AKHL-21592_0147 a minaret:TranscriptSegment ;
    minaret:endTime 2828.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0148 ;
    minaret:sequenceIndex 147 ;
    minaret:startTime 2808.74 ;
    minaret:text "اوقات جب ہمیں کوئی خیر نہیں ملتی یا خیر ہم سے دور ہوتی ہے تو ہم بعض اوقات دوسروں کو بلیم کرتے ہیں۔ سے محروم ہوتے ہیں تو ہم سب اپنا اپنا جائزہ لیں کہ کن کن چیزوں سے مجھے محرومی نظر آتی ہے، کیا چیزیں ہیں میری زندگی میں جو میں چاہتی ہوں کہ مجھے ملیں، پھر" .

minaret:Segment_HUSN_AKHL-21592_0148 a minaret:TranscriptSegment ;
    minaret:endTime 2848.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0149 ;
    minaret:sequenceIndex 148 ;
    minaret:startTime 2828.66 ;
    minaret:text "آپ اندازہ کریں خود ہی، اینالائز کریں کہ یہ چیز مجھے کیوں نہیں مل پا رہی۔ بعض اوقات ہم کہتے ہیں: تقدیر میں نہیں، قسمت، سب باتیں اپنی جگہ ہیں لیکن جیسا کہ میں نے آپ کو پہلے بھی بتایا تھا کہ تقدیر ہمارے اوپر اثر ضرور کرتی ہے لیکن اس کا حصہ دس فیصد ہے اور باقی نوے فیصد حصہ جو ہے اللہ" .

minaret:Segment_HUSN_AKHL-21592_0150 a minaret:TranscriptSegment ;
    minaret:endTime 2888.42 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0151 ;
    minaret:sequenceIndex 150 ;
    minaret:startTime 2868.42 ;
    minaret:text "کہ ہماری بہت سی محرومیاں جن کو ہم صرف تقدیر کا حصہ کہہ دیتے ہیں اس میں ہمارا اخلاق بھی شامل ہوتا ہے۔ تو ہم سب اپنے اوپر خود غور کریں کہ کہیں ایسا تو نہیں کہ ایک خیر جو مجھے ملنے والی تھی صرف اس لیے مجھ سے" .

minaret:Segment_HUSN_AKHL-21592_0151 a minaret:TranscriptSegment ;
    minaret:endTime 2908.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0152 ;
    minaret:sequenceIndex 151 ;
    minaret:startTime 2888.42 ;
    minaret:text "دور ہو گئی یا رہ گئی کہ میں نے اس وقت اچھے اخلاق کا مظاہرہ نہیں کیا یا اخلاق جو ہے اس میں کمی کی؟ اور اخلاق کا پہلا سبق یعنی نرمی ہے۔ عَنْ عَائِشَةَ زَوْجِ النَّبِیِّ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ اَنَّ رَسُوْلَ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ قَالَ:" .

minaret:Segment_HUSN_AKHL-21592_0152 a minaret:TranscriptSegment ;
    minaret:endTime 2927.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0153 ;
    minaret:sequenceIndex 152 ;
    minaret:startTime 2908.1 ;
    minaret:text "یَا عَائِشَةُ اِنَّ اللّٰهَ رَفِیْقٌ یُّحِبُّ الرِّفْقَ وَیُعْطِیْ عَلَی الرِّفْقِ مَا لَا یُعْطِیْ عَلَی الْعُنْفِ وَمَا لَا یُعْطِیْ عَلٰی مَا سِوَاهُ۔ رَوَاهُ مُسْلِمٌ، كِتَابُ الْبِرِّ وَالصِّلَةِ۔ عَنْ عَائِشَةَ، حضرت عائشہ سے روایت ہے، زَوْجِ النَّبِیِّ،" .

minaret:Segment_HUSN_AKHL-21592_0156 a minaret:TranscriptSegment ;
    minaret:endTime 3006.88 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0157 ;
    minaret:sequenceIndex 156 ;
    minaret:startTime 2987.04 ;
    minaret:text "عنہا نبی کریم صلی اللہ علیہ وسلم کی زوجہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اے عائشہ! بے شک اللہ تعالیٰ نرمی کرنے والا ہے، نرمی کو پسند فرماتا ہے، نرمی پر وہ جو کچھ عطا فرماتا ہے وہ سختی پر اور اس کے علاوہ کسی چیز پر" .

minaret:Segment_HUSN_AKHL-21592_0157 a minaret:TranscriptSegment ;
    minaret:endTime 3026.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0158 ;
    minaret:sequenceIndex 157 ;
    minaret:startTime 3006.88 ;
    minaret:text "عطا نہیں فرماتا۔ یعنی انسان کو نرمی کے ذریعے وہ کچھ مل سکتا ہے جو نرمی کے علاوہ کسی دوسرے طریقے سے مل ہی نہیں سکتا، پا ہی نہیں سکتے۔ تو ہم سب کو پانے کے لیے، اس زندگی میں اور آخرت تو پھر آخرت ہے، آخرت میں بھی پانے کے لیے کچھ بھی" .

minaret:Segment_HUSN_AKHL-21592_0162 a minaret:TranscriptSegment ;
    minaret:endTime 3124.82 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0163 ;
    minaret:sequenceIndex 162 ;
    minaret:startTime 3105.6 ;
    minaret:text "عَنْ عَائِشَةَ رَضِیَ اللّٰهُ عَنْهَا، حضرت عائشہ رضی اللہ عنہا کہتی ہیں، اَنَّ الْیَهُوْدَ، بے شک یہود، اَتَوُا النَّبِیَّ، نبی صلی اللہ علیہ وسلم کے پاس آئے، فَقَالُوْا، تو وہ کہنے لگے: اَلسَّامُ عَلَیْكَ، آپ پر موت ہو، قَالَ،" .

minaret:Segment_HUSN_AKHL-21592_0163 a minaret:TranscriptSegment ;
    minaret:endTime 3144.56 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0164 ;
    minaret:sequenceIndex 163 ;
    minaret:startTime 3124.82 ;
    minaret:text "فرمایا نبی صلی اللہ علیہ وسلم نے: وَعَلَیْكُمْ، اور تم پر بھی۔ فَقَالَتْ عَائِشَةُ، تو کہنے لگیں عائشہ: اَلسَّامُ عَلَیْكُمْ، یعنی نبی صلی اللہ علیہ وسلم نے تو وعلیکم کہہ کے خاموشی اختیار کر لی، حضرت عائشہ نے خوب جواب دیا: اَلسَّامُ عَلَیْكُمْ، تم پر موت ہو، وَلَعَنَكُمُ" .

minaret:Segment_HUSN_AKHL-21592_0164 a minaret:TranscriptSegment ;
    minaret:endTime 3164.56 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0165 ;
    minaret:sequenceIndex 164 ;
    minaret:startTime 3144.56 ;
    minaret:text "اللّٰهُ، تم پر اللہ کی لعنت ہو، وَغَضِبَ عَلَیْكُمْ، تم پر اللہ کا غضب ٹوٹے۔ فَقَالَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ، تو رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: مَهْلًا، ٹھہر جاؤ، یَا عَائِشَةُ، اے عائشہ! ٹھہر جاؤ ٹھہر جاؤ، رک جاؤ، عَلَیْكِ بِالرِّفْقِ، تم" .

minaret:Segment_HUSN_AKHL-21592_0165 a minaret:TranscriptSegment ;
    minaret:endTime 3184.26 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0166 ;
    minaret:sequenceIndex 165 ;
    minaret:startTime 3164.56 ;
    minaret:text "پر لازم ہے نرمی۔ اب ہونا تو یہ چاہیے تھا کہ آپ اور داد دیتے، خوب سنائیں، بہت اچھا کیا، منہ توڑ جواب دیا، ایسے ہی کرنا چاہیے تھا۔ نہیں، اب آپ دیکھیے کہ آپ بیچ میں پڑ کے کہتے ہیں: عائشہ! رک جاؤ، نہیں، نرمی نرمی۔ بجائے اس کے کہ ان کو کچھ کہیں جنہوں نے غلط" .

minaret:Segment_HUSN_AKHL-21592_0166 a minaret:TranscriptSegment ;
    minaret:endTime 3204.26 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0167 ;
    minaret:sequenceIndex 166 ;
    minaret:startTime 3184.26 ;
    minaret:text "زبانی اختیار کی آپ اپنے گھر کی خبر لیتے ہیں اور کہتے ہیں: نہیں، نرمی، عَلَیْكِ بِالرِّفْقِ وَاِیَّاكِ، اور بچو تم، وَالْعُنْفَ، اور سختی سے، وَالْفَحْشَ، اور فحش سے یعنی بے حیائی سے۔ بے حیائی اس میں کیا تھی؟ لعنت اور غضب کی بات۔ قَالَتْ، کہنے لگیں، اول" .

minaret:Segment_HUSN_AKHL-21592_0167 a minaret:TranscriptSegment ;
    minaret:endTime 3224.24 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0168 ;
    minaret:sequenceIndex 167 ;
    minaret:startTime 3204.26 ;
    minaret:text "جسٹفیکیشن دینے لگیں: کیا آپ نے سنا نہیں، مَا قَالُوْا، جو انہوں نے کہا ہے؟ اے اللہ کے رسول صلی اللہ علیہ وسلم! آپ نے سنا نہیں جو کہہ رہے تھے؟ قَالَ، آپ نے فرمایا: اَوَلَمْ تَسْمَعِیْ، کیا تو نے نہیں سنا، مَا قُلْتُ، جو میں نے کہا ہے؟ تمہیں ان کی بات تو سنائی دی میری نہیں سنائی دی؟ رَدَدْتُ عَلَیْهِمْ، میں" .

minaret:Segment_HUSN_AKHL-21592_0168 a minaret:TranscriptSegment ;
    minaret:endTime 3243.56 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0169 ;
    minaret:sequenceIndex 168 ;
    minaret:startTime 3224.24 ;
    minaret:text "نے ان کو جواب دے دیا، فَیُسْتَجَابُ لِیْ، تو دعا قبول کی جاتی ہے میرے لیے، فِیْهِمْ، ان کے معاملے میں، وَلَا یُسْتَجَابُ لَهُمْ فِیَّ، اور نہیں دعا قبول کی جاتی ان کی میرے معاملے میں۔ جو انہوں نے مجھے بددعا دی وہ قبول نہیں ہوگی، ہاں جو میں نے جواب میں کہا وہ قبول ہو جائے گا،" .

minaret:Segment_HUSN_AKHL-21592_0171 a minaret:TranscriptSegment ;
    minaret:endTime 3303.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0172 ;
    minaret:sequenceIndex 171 ;
    minaret:startTime 3283.86 ;
    minaret:text "جواب دیا؟ میں نے ان کی بات انہی پر لوٹا دی۔ میری ان کے بارے میں دعا قبول کی گئی اور ان کی میرے بارے میں قبول نہیں کی گئی۔ حضرت عائشہ نبی صلی اللہ علیہ وسلم کی زوجہ فرماتی ہیں، نبی صلی اللہ علیہ وسلم" .

minaret:Segment_HUSN_AKHL-21592_0172 a minaret:TranscriptSegment ;
    minaret:endTime 3323.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0173 ;
    minaret:sequenceIndex 172 ;
    minaret:startTime 3303.0 ;
    minaret:text "سے روایت کرتی ہیں، قَالَ، کہ آپ نے فرمایا: اِنَّ الرِّفْقَ لَا یَكُوْنُ فِیْ شَیْءٍ، بے شک نرمی نہیں ہوتی کسی چیز میں، اِلَّا زَانَهٗ، مگر اسے خوبصورت بنا دیتی ہے، وَلَا یُنْزَعُ مِنْ شَیْءٍ، اور نہیں نکالی" .

minaret:Segment_HUSN_AKHL-21592_0174 a minaret:TranscriptSegment ;
    minaret:endTime 3362.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0175 ;
    minaret:sequenceIndex 174 ;
    minaret:startTime 3342.9 ;
    minaret:text "بھی نرمی ہوتی ہے وہ اسے زینت دار بنا دیتی ہے اور جس سے یہ نکال دی جاتی ہے اسے عیب دار کر دیتی ہے۔ یعنی جہاں نرمی ہوگی وہاں خوبصورتی ہوگی، رنگ و خوشبو ہوگی، اور جہاں سے نکل جائے گی وہ چیز جیسے پھول سوکھ جاتا ہے اور ٹوٹ پھوٹ جاتا ہے،" .

minaret:Segment_HUSN_AKHL-21592_0179 a minaret:TranscriptSegment ;
    minaret:endTime 3462.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0180 ;
    minaret:sequenceIndex 179 ;
    minaret:startTime 3442.52 ;
    minaret:text "حاصل ہوتا ہے وہ کیا ہے کہ جہنم کی آگ اس پر حرام ہے اور وہ جہنم پر حرام ہے۔ یعنی جہنم کی آگ اسے جلا ہی نہیں سکتی، اسے چھو ہی نہیں سکتی اور وہ جہنم کی آگ میں جا ہی نہیں سکتا۔ یعنی ایک بات کو تاکید کے ساتھ دو انداز میں کہا گیا: وہ جہنم پر حرام ہے، آگ اس پر حرام ہے۔ اور وہ کون" .

minaret:Segment_HUSN_AKHL-21592_0180 a minaret:TranscriptSegment ;
    minaret:endTime 3481.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0181 ;
    minaret:sequenceIndex 180 ;
    minaret:startTime 3462.38 ;
    minaret:text "ہے؟ جو قریب ہے یعنی آپ اس کے پاس ہوں یا وہ آپ کے پاس ہو تو آپ میں اور اس میں ایسا ڈسٹنس نہ ہو کہ آپ اپنے دل کی بات اسے نہ کہہ سکیں یا وہ آپ کو نہ کہہ سکے، یعنی قربت محسوس ہو۔ اور اس کے ساتھ نرم ہو اور پھر" .

minaret:Segment_HUSN_AKHL-21592_0181 a minaret:TranscriptSegment ;
    minaret:endTime 3501.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0182 ;
    minaret:sequenceIndex 181 ;
    minaret:startTime 3481.8 ;
    minaret:text "لوگوں کے لیے آسانی کرے، مشکلات نہ پیدا کرے۔ بعض اوقات ہوتا یہ ہے کہ چھوٹی سی بات ہوتی ہے، چھوٹا سا کام ہوتا ہے لیکن انتہائی مشکل بن جاتا ہے، چھوٹا سا معاملہ ہوتا ہے لیکن وہ بہت بڑا ایشو بن جاتا ہے۔ تو اس میں کرنے کی چیز کیا ہے کہ انسان دوسروں کے لیے آسانی پیدا" .

minaret:Segment_HUSN_AKHL-21592_0182 a minaret:TranscriptSegment ;
    minaret:endTime 3521.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0183 ;
    minaret:sequenceIndex 182 ;
    minaret:startTime 3501.5 ;
    minaret:text "کرنے والا ہو، معاملے میں نرمی کرنے والا ہو اور لوگوں کے لیے قریب ہو یعنی ایک ریپلشن نہ ہو اس کے اندر لوگوں کے لیے اور وہ لوگوں کو اپنے سے بھگانے والا نہ ہو۔ اس میں آپ دیکھیں کہ پچھلا ہوم ورک جو آپ کا تھا کہ تین ایسی باتیں لکھیں جو دوسروں میں آپ کو اچھی نہ لگیں،" .

minaret:Segment_HUSN_AKHL-21592_0187 a minaret:TranscriptSegment ;
    minaret:endTime 3620.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0188 ;
    minaret:sequenceIndex 187 ;
    minaret:startTime 3600.86 ;
    minaret:text "پتا ہوں گی تو فوراً آپ باقی چیزیں خود ریلیٹ کر لیں گے۔ ہر ایک اپنی اپنی زندگی میں پھر ان کو اپنے اپنے اعتبار سے ریلیٹ کر سکتا ہے۔ صرف ڈیفینیشن لکھا کریں گے اور ہوم ورک لکھیں گے، یہ پرسنل گرومنگ کا ایجنڈا ہے۔ سُبْحَانَكَ اللّٰهُمَّ وَبِحَمْدِكَ، نَشْهَدُ اَنْ لَّاۤ اِلٰهَ اِلَّاۤ اَنْتَ، نَسْتَغْفِرُكَ وَنَتُوْبُ اِلَیْكَ۔" .

minaret:Segment_HUSN_AKHL-21593_0005 a minaret:TranscriptSegment ;
    minaret:endTime 95.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0006 ;
    minaret:sequenceIndex 5 ;
    minaret:startTime 75.6 ;
    minaret:text "ضروری ہے۔ اور جب کوئی چیز انسان کے ارادے میں بدل جاتی ہے تو انسان کو پھر اس کی تڑپ لگ جاتی ہے اور پھر انسان اس کے لیے دوڑ دھوپ کرنے لگتا ہے، کوشش کرنے لگتا ہے، اور صرف کوشش پر ہی بس نہیں، دعاؤں کے ساتھ اللہ کا سہارا لیتا" .

minaret:Segment_HUSN_AKHL-21593_0006 a minaret:TranscriptSegment ;
    minaret:endTime 114.48 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 95.46 ;
    minaret:text "ہے اور خوب خوب دعائیں مانگتا ہے۔ اگر ہمیں واقعی اس بات کا احساس ہو جائے کہ حسنِ اخلاق، اچھا اخلاق میزان میں سب سے بھاری نیکی ہے تو یقیناً ہم اس کے پیچھے دوڑیں گے اور پھر اس کے لیے نہ صرف یہ کہ کوشش کریں گے بلکہ" .

minaret:Segment_HUSN_AKHL-21593_0007 a minaret:TranscriptSegment ;
    minaret:endTime 134.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 114.48 ;
    minaret:text "اللہ سے مانگیں گے بھی۔ چلیے، اس کتاب میں لکھی آخری دعا کو ایک دفعہ پڑھتے ہیں۔ یہ دعا ایک طویل دعا کا ایک حصہ ہے۔ اگر آپ کی نظر الفاظ پر ہو تو آپ زیادہ بہتر طور پر یاد کریں گے۔ اس کتاب کے آخری صفحے پر ہے، نظر آ گئی سب" .

minaret:Segment_HUSN_AKHL-21593_0014 a minaret:TranscriptSegment ;
    minaret:endTime 253.74 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0015 ;
    minaret:sequenceIndex 14 ;
    minaret:startTime 233.86 ;
    minaret:text "مجھے وہ راستہ دکھا جو بہترین اخلاق کی طرف لے جاتا ہو۔ لَا یَهْدِیْ، نہیں رہنمائی کر سکتا، لِاَحْسَنِهَا، اس کے بہترین کی طرف یعنی اخلاق کے بہترین حصے کی طرف، اِلَّاۤ اَنْتَ، مگر تُو ہی۔ یعنی" .

minaret:Segment_HUSN_AKHL-21593_0015 a minaret:TranscriptSegment ;
    minaret:endTime 273.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0016 ;
    minaret:sequenceIndex 15 ;
    minaret:startTime 253.74 ;
    minaret:text "یہ طاقت تیرے ہی پاس ہے، تُو ہی مجھے راستہ دکھا سکتا ہے۔ وَاصْرِفْ عَنِّیْ، اور پھیر دے مجھ سے، دور کر دے مجھ سے، سَیِّئَهَا، اس کے برے حصے کو یعنی اخلاق کے برے حصے کو، بری عادات کو۔ لَا یَصْرِفُ عَنِّیْ،" .

minaret:Segment_HUSN_AKHL-21593_0018 a minaret:TranscriptSegment ;
    minaret:endTime 333.2 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0019 ;
    minaret:sequenceIndex 18 ;
    minaret:startTime 314.02 ;
    minaret:text "کیونکہ ایک روایت سے ہمیں یہ بھی پتا چلتا ہے کہ اگر کوئی یہ کہے کہ پہاڑ اپنی جگہ سے ٹل گیا ہے، ہل گیا ہے تو مان لو، لیکن اگر کوئی یہ کہے کہ کسی نے اپنی عادت چھوڑ دی ہے تو اس کو نہ مانو۔ یعنی بری عادتیں چھوڑنا، برے اخلاق کو ترک کرنا" .

minaret:Segment_HUSN_AKHL-21593_0019 a minaret:TranscriptSegment ;
    minaret:endTime 353.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0020 ;
    minaret:sequenceIndex 19 ;
    minaret:startTime 333.76 ;
    minaret:text "آسان کام نہیں۔ یہ پہاڑ کو اپنی جگہ سے ہلانے سے بھی زیادہ مشکل کام ہے کیونکہ پہاڑ تو زمین میں گڑے ہوئے ہیں، لیکن بری عادتیں ہماری رگ و پے میں سرایت کی ہوئی ہیں، ہماری روح اور جسم اور جان کا حصہ بنی پڑی ہیں، ان میں گھلی ملی ہوئی،" .

minaret:Segment_HUSN_AKHL-21593_0020 a minaret:TranscriptSegment ;
    minaret:endTime 373.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0021 ;
    minaret:sequenceIndex 20 ;
    minaret:startTime 353.58 ;
    minaret:text "گندھی ہوئی ہیں ان میں۔ ان کو ان سے نکالنا اور چھڑانا اور باہر نکال کے پھینکنا آسان نہیں، اللہ کی مدد کے بغیر یہ کام نہیں ہو سکتا۔ اس لیے اللہ سے دعا کرنے کے ساتھ ساتھ کوشش بہت ضروری ہے۔ پھر اس شعور اور احساس کے" .

minaret:Segment_HUSN_AKHL-21593_0021 a minaret:TranscriptSegment ;
    minaret:endTime 393.26 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0022 ;
    minaret:sequenceIndex 21 ;
    minaret:startTime 373.52 ;
    minaret:text "ساتھ مانگیے: وَاهْدِنِیْ لِاَحْسَنِ الْاَخْلَاقِ، وَاهْدِنِیْ لِاَحْسَنِ الْاَخْلَاقِ، وَاهْدِنِیْ لِاَحْسَنِ الْاَخْلَاقِ، وَاهْدِنِیْ لِاَحْسَنِ الْاَخْلَاقِ، وَاهْدِنِیْ لِاَحْسَنِ الْاَخْلَاقِ،" .

minaret:Segment_HUSN_AKHL-21593_0022 a minaret:TranscriptSegment ;
    minaret:endTime 413.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 393.26 ;
    minaret:text "لَا یَهْدِیْ لِاَحْسَنِهَا اِلَّاۤ اَنْتَ، لَا یَهْدِیْ لِاَحْسَنِهَا اِلَّاۤ اَنْتَ، لَا یَهْدِیْ لِاَحْسَنِهَا اِلَّاۤ اَنْتَ، لَا یَهْدِیْ" .

minaret:Segment_HUSN_AKHL-21593_0023 a minaret:TranscriptSegment ;
    minaret:endTime 414.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 413.18 ;
    minaret:text "لِاَحْسَنِهَا" .

minaret:Segment_HUSN_AKHL-21593_0024 a minaret:TranscriptSegment ;
    minaret:endTime 435.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 414.46 ;
    minaret:text "اِلَّاۤ اَنْتَ۔ وَاصْرِفْ عَنِّیْ سَیِّئَهَا، وَاصْرِفْ عَنِّیْ سَیِّئَهَا، وَاصْرِفْ عَنِّیْ سَیِّئَهَا، لَا یَصْرِفُ عَنِّیْ سَیِّئَهَا" .

minaret:Segment_HUSN_AKHL-21593_0025 a minaret:TranscriptSegment ;
    minaret:endTime 453.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 435.8 ;
    minaret:text "اَنْتَ، لَا یَصْرِفُ عَنِّیْ سَیِّئَهَا اِلَّاۤ اَنْتَ، لَا یَصْرِفُ عَنِّیْ سَیِّئَهَا اِلَّاۤ اَنْتَ۔" .

minaret:Segment_HUSN_AKHL-21593_0026 a minaret:TranscriptSegment ;
    minaret:endTime 477.26 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 457.96 ;
    minaret:text "آج ہم پڑھتے ہیں نیا سبق: اَلظُّلْمُ، ظلم، Injustice۔ ظلم کا لفظ عربی میں کسی چیز کو اس کی جگہ سے ہٹا کر کسی دوسری جگہ رکھنے کا ہے، بے موقع رکھنا۔ ظَلَمَ کا معنی ہوتا ہے" .

minaret:Segment_HUSN_AKHL-21593_0027 a minaret:TranscriptSegment ;
    minaret:endTime 497.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 477.26 ;
    minaret:text "کسی بات کو، کسی چیز کو بے موقع رکھنا۔ ہر چیز کا ایک مقام ہے، ایک وقت ہے، ایک موقع ہے، ایک تقاضا ہے، اس کو اس سے ہٹا دینا اور کہیں اور رکھنا، یہ ظلم ہے۔ اگر حق کے لیے استعمال ہو، مثلاً یہ کہا" .

minaret:Segment_HUSN_AKHL-21593_0028 a minaret:TranscriptSegment ;
    minaret:endTime 516.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0029 ;
    minaret:sequenceIndex 28 ;
    minaret:startTime 497.22 ;
    minaret:text "جائے 'ظَلَمَهُ حَقَّهُ' تو معنی ہوتا ہے گھٹانا، کسی کو اس کا حق کم دینا۔ 'ظَلَمَ الْبَعِيرَ' کا مطلب ہوتا ہے، بعیر کس کو کہتے ہیں؟ اونٹ کو۔ 'ظَلَمَ الْبَعِيرَ' کا معنی کیا جاتا ہے: بغیر کسی مرض اور علت کے اس کو ذبح کر دینا۔" .

minaret:Segment_HUSN_AKHL-21593_0029 a minaret:TranscriptSegment ;
    minaret:endTime 536.24 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0030 ;
    minaret:sequenceIndex 29 ;
    minaret:startTime 516.46 ;
    minaret:text "یعنی گھر میں اچھا بھلا اونٹ تھا، بغیر کسی وجہ کے اس کو ذبح کر دیا، تو یہ کیا کیا؟ اس نے اونٹ پر ظلم کیا۔ اسی طرح ہر وہ کام جس کو وقت سے پہلے کیا جائے اس پہ ظلم کا اطلاق ہوتا ہے۔ ہر وہ کام جو وقت سے" .

minaret:Segment_HUSN_AKHL-21593_0030 a minaret:TranscriptSegment ;
    minaret:endTime 556.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0031 ;
    minaret:sequenceIndex 30 ;
    minaret:startTime 536.24 ;
    minaret:text "پہلے کیا جائے وہ کیا ہے؟ ظلم۔ اور اگر یہ لفظ 'ظَلِمَ' پڑھا جائے تو اس کا معنی ہوتا ہے رات کا تاریک ہونا۔ رات کا تاریک ہونا، تاریک ہونے کا کیا معنی ہے؟ اندھیرا ہونا۔ اسی لیے ہم اردو میں بھی ظلم کو اندھیر سے تعبیر کرتے ہیں، 'یہ تو" .

minaret:Segment_HUSN_AKHL-21593_0031 a minaret:TranscriptSegment ;
    minaret:endTime 575.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0032 ;
    minaret:sequenceIndex 31 ;
    minaret:startTime 556.1 ;
    minaret:text "بڑا اندھیر ہو گیا'۔ تو ظلم میں اندھیرے اور تاریکی کا معنی بھی ہے، اسی لیے 'ظَلَام' کہتے ہیں تاریکی کو اور 'ظُلَام' کہتے ہیں بے انصافی کو۔ ظلم کے ان لغوی معنوں کو سامنے رکھتے ہوئے جو بات ذہن میں آتی ہے وہ کیا ہے کہ ظلم" .

minaret:Segment_HUSN_AKHL-21593_0032 a minaret:TranscriptSegment ;
    minaret:endTime 594.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0033 ;
    minaret:sequenceIndex 32 ;
    minaret:startTime 575.86 ;
    minaret:text "صرف کسی کی مار پٹائی کا نام نہیں، یا صرف کسی کا مال چھیننے یا کسی کے ساتھ زیادتی کرنے، گالی گلوچ کرنے کا نام ہی نہیں، بلکہ ظلم اس سے وسیع تر معنی رکھتا ہے۔ ظلم خالق کے ساتھ بھی ہوتا ہے جس نے ہمیں پیدا کیا،" .

minaret:Segment_HUSN_AKHL-21593_0033 a minaret:TranscriptSegment ;
    minaret:endTime 615.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0034 ;
    minaret:sequenceIndex 33 ;
    minaret:startTime 595.64 ;
    minaret:text "ظلم مخلوق کے ساتھ بھی ہوتا ہے۔ خالق کا حق نہ پہچاننا، خالق کی قدر نہ پہچاننا، خالق کو نہ ماننا، یہ ظلم ہے جسے ہم عام طور پر شرک سے یا کفر سے تعبیر کرتے ہیں۔ اسی طرح مخلوق کے ساتھ بھی" .

minaret:Segment_HUSN_AKHL-21593_0034 a minaret:TranscriptSegment ;
    minaret:endTime 635.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0035 ;
    minaret:sequenceIndex 34 ;
    minaret:startTime 615.46 ;
    minaret:text "کسی قسم کی حق تلفی یا زیادتی کرنا، انہیں ان کا حق نہ دینا، یا کسی چیز کے ساتھ بے موقع، بے محل معاملہ کرنا، یہ سب ظلم میں آتا ہے۔ ظلم انسانوں کے ساتھ بھی ہو سکتا ہے، ظلم حیوانوں کے ساتھ بھی ہو سکتا ہے،" .

minaret:Segment_HUSN_AKHL-21593_0041 a minaret:TranscriptSegment ;
    minaret:endTime 771.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0042 ;
    minaret:sequenceIndex 41 ;
    minaret:startTime 752.04 ;
    minaret:text "کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا، فِیْمَا یَرْوِیْ عَنْ رَّبِّهٖ، اس میں جو وہ روایت کرتے ہیں اپنے رب سے، کون روایت کرتے ہیں؟ رسول اللہ صلی اللہ علیہ وسلم، عَزَّ وَجَلَّ، اللہ عزوجل سے روایت کرتے ہیں۔ ایسی حدیث کو جسے" .

minaret:Segment_HUSN_AKHL-21593_0042 a minaret:TranscriptSegment ;
    minaret:endTime 791.28 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0043 ;
    minaret:sequenceIndex 42 ;
    minaret:startTime 771.92 ;
    minaret:text "رسول اللہ صلی اللہ علیہ وسلم اللہ تعالیٰ سے روایت کریں، کیا کہتے ہیں؟ حدیثِ قدسی۔ حدیثِ قدسی اور قرآنِ مجید میں کیا فرق ہے؟ حدیثِ قدسی میں کلام اللہ کا ہوتا ہے لیکن الفاظ رسول اللہ صلی اللہ علیہ وسلم کے ہوتے ہیں،" .

minaret:Segment_HUSN_AKHL-21593_0043 a minaret:TranscriptSegment ;
    minaret:endTime 811.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0044 ;
    minaret:sequenceIndex 43 ;
    minaret:startTime 791.28 ;
    minaret:text "اور قرآنِ مجید لفظاً اور معناً، یعنی اس کے الفاظ اور کلام سب اللہ ہی کی طرف سے ہے۔ تو اللہ تعالیٰ نے کیا فرمایا: اِنِّیْ حَرَّمْتُ، بے شک میں نے حرام قرار دیا ہے، عَلٰی نَفْسِیْ، اپنی ذات پر، الظُّلْمَ، ظلم کرنا،" .

minaret:Segment_HUSN_AKHL-21593_0044 a minaret:TranscriptSegment ;
    minaret:endTime 830.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0045 ;
    minaret:sequenceIndex 44 ;
    minaret:startTime 811.16 ;
    minaret:text "وَعَلٰی عِبَادِیْ، اور اپنے بندوں پر، فَلَا تَظَالَمُوْا، پس نہ تم ایک دوسرے پر ظلم کرو۔ اسے مسلم نے روایت کیا ہے۔ سیدنا ابو ذر رضی اللہ عنہ روایت کرتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے اپنے رب سے یہ نقل کیا،" .

minaret:Segment_HUSN_AKHL-21593_0046 a minaret:TranscriptSegment ;
    minaret:endTime 870.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0047 ;
    minaret:sequenceIndex 46 ;
    minaret:startTime 850.28 ;
    minaret:text "ابو ذر غفاری رضی اللہ عنہ ہیں۔ آپ میں سے کون حضرت ابو ذر کا نام جانتا ہے؟ کیا نام تھا؟ ابو ذر تو ان کی کنیت تھی، ذر ان کے بیٹے کا نام تھا۔ غفاری قبیلے کی طرف نسبت ہے۔ غفار اس کا نام تھا جس کے لیے نبی صلی اللہ علیہ وسلم نے دعا کی کہ اے" .

minaret:Segment_HUSN_AKHL-21593_0048 a minaret:TranscriptSegment ;
    minaret:endTime 909.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0049 ;
    minaret:sequenceIndex 48 ;
    minaret:startTime 889.68 ;
    minaret:text "تھا، جندب۔ یہ نام بھی الگ سے آپ نے کہیں ضرور سنا پڑھا ہوگا۔ والدہ کا نام رملہ بنتِ ربیعہ تھا۔ رملہ۔ مکہ میں رہتے تھے یا مدینہ میں؟ یہ نہ مکہ میں رہتے تھے، نہ مدینہ میں رہتے تھے۔ صحابہ کے بارے میں پڑھا کیجیے اور اپنے بچوں کو یہ" .

minaret:Segment_HUSN_AKHL-21593_0050 a minaret:TranscriptSegment ;
    minaret:endTime 949.2 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0051 ;
    minaret:sequenceIndex 50 ;
    minaret:startTime 929.24 ;
    minaret:text "کیا کرتے تھے، کیا نہیں کرتے تھے، ان کی زندگیاں کیسی تھیں۔ بہرحال ابو ذر غفاری رضی اللہ عنہ بدر کے قریب ایک جگہ تھی، وَدَّان نامی ایک بستی تھی جو راستے پر پڑتی تھی، تجارتی شاہراہ پر تھی، یعنی مکہ کے لوگ جب شام کی طرف" .

minaret:Segment_HUSN_AKHL-21593_0051 a minaret:TranscriptSegment ;
    minaret:endTime 968.98 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0052 ;
    minaret:sequenceIndex 51 ;
    minaret:startTime 949.2 ;
    minaret:text "سفر کر کے جاتے، تجارت کرتے تو راستے میں یہ بستی آتی۔ ان کا قبیلہ جو تھا وہ ڈاکہ زنی کے لیے مشہور تھا، یہ ڈاکو لوگ تھے۔ اور ان کا کام کیا تھا کہ جب بھی کوئی مسافر وہاں سے گزرے، بستی میں قیام کرے، تجارت کر کے یا آ رہے ہوتے تھے یا جا رہے ہوتے تھے، ان کے وہاں خرچ" .

minaret:Segment_HUSN_AKHL-21593_0052 a minaret:TranscriptSegment ;
    minaret:endTime 988.62 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0053 ;
    minaret:sequenceIndex 52 ;
    minaret:startTime 968.98 ;
    minaret:text "کریں، یعنی ان سے بھی کچھ لین دین کریں۔ یہی ان کا ذریعۂ آمدنی تھا، اور اگر کچھ نہ دیں لیں تو پھر یہ ان کو لوٹ کے اپنا کام چلائیں۔ یہ ان لوگوں سے تعلق رکھتے تھے۔ جب رسول اللہ صلی اللہ علیہ وسلم نے اسلام کی دعوت دی، لوگوں کو اپنی نبوت کا دعویٰ کیا تو" .

minaret:Segment_HUSN_AKHL-21593_0054 a minaret:TranscriptSegment ;
    minaret:endTime 1029.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0055 ;
    minaret:sequenceIndex 54 ;
    minaret:startTime 1009.18 ;
    minaret:text "تجارت کرتے تھے۔ بہرحال اب جب یہ تجارت کر کے باہر کو جاتے، ادھر ادھر نکلتے تو راستے میں بھی باتیں ہوتیں۔ راستے میں جو قبیلے آتے، جو لوگ ملتے ان کو بھی بتاتے۔ جو لوگ مکہ میں حج یا عمرے پہ آتے ان کو بھی پتا چلتا کہ یہاں ایک شخص نے نبوت کا دعویٰ کر دیا ہے۔ ایک ہاٹ ٹاپک تھا، ہر ایک تک پہنچ گیا چونکہ" .

minaret:Segment_HUSN_AKHL-21593_0055 a minaret:TranscriptSegment ;
    minaret:endTime 1048.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0056 ;
    minaret:sequenceIndex 55 ;
    minaret:startTime 1029.1 ;
    minaret:text "مکہ کی پوزیشن بہت سینٹرل تھی اس لیے میسج بہت جلدی ادھر ادھر سپریڈ ہوا۔ اب اس بستی میں بھی پتا چلا، حضرت ابو ذر غفاری کو معلوم ہوا کہ ایک شخص نے مکہ میں اس طرح کا دعویٰ کیا ہے تو ان کو تجسس ہوا۔ اپنے بھائی کو بھیجا جو کہ شاعر تھے، ان کا نام انیس تھا، ان کو بھیجا کہ جاؤ اور تم پتا کرو کہ وہ شخص کیا" .

minaret:Segment_HUSN_AKHL-21593_0056 a minaret:TranscriptSegment ;
    minaret:endTime 1068.84 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0057 ;
    minaret:sequenceIndex 56 ;
    minaret:startTime 1048.86 ;
    minaret:text "کہتا ہے۔ وہ گئے اور انہوں نے جا کے ان کی کچھ باتیں وغیرہ سنیں، اور چونکہ مکہ والے آپ کے بہت خلاف تھے تو کچھ اچھا امپریشن نہیں لے کر گئے۔ واپس گئے تو بتایا کہ مکہ والے یہ کہتے ہیں، ہاں میں نے جو کچھ سنا ہے ان کا وہ یہ ہے کہ نیکی کا حکم دیتے ہیں اور برائی سے روکتے ہیں، وہ خود یہ کرتے ہیں اور لوگ ان" .

minaret:Segment_HUSN_AKHL-21593_0057 a minaret:TranscriptSegment ;
    minaret:endTime 1088.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0058 ;
    minaret:sequenceIndex 57 ;
    minaret:startTime 1068.84 ;
    minaret:text "کے بارے میں یہ کہتے ہیں۔ تو ان کی تسلی نہیں ہوئی، یہ خود سفر کر کے گئے۔ لیکن چونکہ ماحول آپ کے خلاف تھا تو کسی سے پوچھنا گوارا نہیں کیا یا پوچھا نہیں، اور مسجدِ حرام چونکہ ایک مرکزی جگہ تھی وہیں پر کئی دن رہے۔ آخر حضرت علی نے ان کو دیکھا اور کہا کہ یہ" .

minaret:Segment_HUSN_AKHL-21593_0058 a minaret:TranscriptSegment ;
    minaret:endTime 1108.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 1088.76 ;
    minaret:text "کہاں سے آیا ہوا شخص ہے اور کیوں آیا ہے، اور روز یہی ہوتا ہے۔ تو ان کو اپنے ساتھ لے گئے، گھر پہ کھانا وانا کھلایا، پوچھا کہ تم یہاں کیوں آئے ہو؟ تو کہا کہ ایک شخص ہے جس نے یہاں نبوت کا دعویٰ کیا ہے، تو وہ کیا کہتا ہے اس کے بارے میں معلوم کرنے کے لیے آیا ہوں۔ انہوں نے کہا کہ ان تک پہنچنا آسان نہیں کیونکہ ان لوگوں کو اگر پتا چل گیا کہ تم" .

minaret:Segment_HUSN_AKHL-21593_0059 a minaret:TranscriptSegment ;
    minaret:endTime 1128.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0060 ;
    minaret:sequenceIndex 59 ;
    minaret:startTime 1108.68 ;
    minaret:text "ان سے ملنے کے لیے آئے ہو تو تمہاری خیر نہیں۔ ہاں، ایسے کرو چپکے چپکے میرے پیچھے آؤ، اگر کہیں خطرہ ہوا تو ادھر ادھر ہو جانا، ورنہ جہاں میں جاؤں گا میرے پیچھے پیچھے آتے جانا، اور جہاں میں پہنچوں وہیں اللہ کے رسول صلی اللہ علیہ وسلم سے تم ملاقات کر سکو گے۔ بہرحال یہ چھپتے چھپاتے وہاں پر پہنچے اور دیکھتے ہی کہتے ہیں: اَلسَّلَامُ عَلَیْكَ یَا رَسُوْلَ اللّٰهِ۔ یعنی" .

minaret:Segment_HUSN_AKHL-21593_0060 a minaret:TranscriptSegment ;
    minaret:endTime 1148.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0061 ;
    minaret:sequenceIndex 60 ;
    minaret:startTime 1128.44 ;
    minaret:text "دیکھتے ہی پہچان گئے کہ یہ اللہ کے رسول ہی ہیں اور یہ شخص جھوٹا شخص نہیں ہو سکتا، اور فوراً ہی اسلام قبول کیا۔ اور یہ پانچویں چھٹے مسلمان تھے، یعنی بہت ابتدائی دور میں۔ ابتدا میں حضرت ابوبکر، حضرت عبد الرحمن بن عوف تک مسلمان ہوئے، اور اس کے بعد ایک طرح سے لوگ چھپے چھپے دل ہی دل میں مسلمان تو تھے لیکن" .

minaret:Segment_HUSN_AKHL-21593_0061 a minaret:TranscriptSegment ;
    minaret:endTime 1168.2 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0062 ;
    minaret:sequenceIndex 61 ;
    minaret:startTime 1148.34 ;
    minaret:text "اظہار نہیں کرتے تھے۔ بہرحال انہوں نے اسلام قبول کیا اور واپس جانے لگے، چند دن آپ کے پاس رہے، چند بنیادی باتیں آپ سے سیکھیں۔ تب نبی صلی اللہ علیہ وسلم نے ان کو ایک نصیحت کی کہ جاؤ، جو کچھ سیکھا ہے اپنے قبیلے کو سکھاؤ، اور ہاں مکہ والوں کو پتا نہ چلے ورنہ تمہاری شامت آ" .

minaret:Segment_HUSN_AKHL-21593_0062 a minaret:TranscriptSegment ;
    minaret:endTime 1188.14 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0063 ;
    minaret:sequenceIndex 62 ;
    minaret:startTime 1168.2 ;
    minaret:text "جائے گی۔ اور ایک بات یہ ہے کہ تم اس وقت تک اپنے قبیلے کے پاس ہی رہو جب تک کہ تمہیں یہ خبر نہ ملے کہ اللہ نے مجھے غلبہ عطا کیا ہے، تم وہیں رہنا۔ کیونکہ بہادر تو تھے، جس قبیلے سے تعلق رکھتے تھے تو وہ نڈر قسم کا قبیلہ تھا، [انہوں نے سوچا] کہ کیوں نہ میں اپنے اسلام کا اظہار کر کے جاؤں۔ اعلان کیا" .

minaret:Segment_HUSN_AKHL-21593_0063 a minaret:TranscriptSegment ;
    minaret:endTime 1208.14 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0064 ;
    minaret:sequenceIndex 63 ;
    minaret:startTime 1188.14 ;
    minaret:text "اور ہوا وہی جو ہونا تھا، لوگوں نے اتنا مارا کہ ان کی جان کے لالے پڑ گئے۔ تو آخر کسی نے کہا: تمہیں معلوم ہے یہ کس قبیلے کا شخص ہے؟ جہاں سے تم گزرتے ہو، تمہارا کوئی قافلہ سلامت نہیں گزرے گا اگر تم نے اس کو کچھ کیا۔ کہا جاتا ہے کہ حضرت عباس بیچ میں آئے تھے اور انہوں نے ان کو چھڑایا۔ بہرحال یہ اپنے قبیلے" .

minaret:Segment_HUSN_AKHL-21593_0064 a minaret:TranscriptSegment ;
    minaret:endTime 1227.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0065 ;
    minaret:sequenceIndex 64 ;
    minaret:startTime 1208.14 ;
    minaret:text "میں واپس گئے۔ واپس جا کر انہوں نے اسلام کی تبلیغ شروع کی، ان کی والدہ بھی مسلمان ہو گئیں، بھائی بھی مسلمان ہو گئے اور ان کی کوششوں سے چند لوگوں کے سوا سارا قبیلہ مسلمان ہوا اور نماز باجماعت کا بھی وہاں اہتمام شروع ہوا۔ اور غزوۂ خندق تک یہ اپنے قبیلے میں ہی رہے،" .

minaret:Segment_HUSN_AKHL-21593_0065 a minaret:TranscriptSegment ;
    minaret:endTime 1247.48 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0066 ;
    minaret:sequenceIndex 65 ;
    minaret:startTime 1227.52 ;
    minaret:text "اس کے بعد نبی صلی اللہ علیہ وسلم کو جب اللہ تعالیٰ نے قوت دی تو یہ مدینہ چلے گئے اور اس وقت ان کے باقی سارے قبیلے نے اسلام قبول کر لیا۔ مدینہ جانے کے بعد انہوں نے دن رات اپنے سیکھنے میں صرف کیے، بہت کچھ سیکھا، اس لیے آپ دیکھیں گے" .

minaret:Segment_HUSN_AKHL-21593_0066 a minaret:TranscriptSegment ;
    minaret:endTime 1267.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0067 ;
    minaret:sequenceIndex 66 ;
    minaret:startTime 1247.48 ;
    minaret:text "کہ یہ ان صحابہ میں سے ہیں جن کی احادیث کافی تعداد میں روایت ہوئی ہیں۔ ان کی ایک خاص خصوصیت یہ تھی کہ انہیں دنیا کی دولت اور دنیا کے مال سے کوئی دلچسپی نہ تھی، اور آپ صلی اللہ علیہ وسلم کے زمانے میں تو بہرحال سیکھنے سکھانے میں مشغول رہے لیکن جب آپ کی وفات ہوئی تو مدینہ میں ان کا دل نہیں" .

minaret:Segment_HUSN_AKHL-21593_0067 a minaret:TranscriptSegment ;
    minaret:endTime 1287.28 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0068 ;
    minaret:sequenceIndex 67 ;
    minaret:startTime 1267.34 ;
    minaret:text "لگتا تھا۔ شام کی طرف سفر کر گئے، وہاں پر امیر معاویہ رضی اللہ تعالیٰ عنہ کی حکومت تھی، ان کے ساتھ ان کے کچھ اختلافات ہوئے، اور یہ دیکھتے تھے کہ لوگوں کے اندر دین سے زیادہ دنیا کی دلچسپی بڑھتی چلی جا رہی ہے تو ان کی بنتی نہیں تھی کسی سے۔ حضرت عثمان رضی اللہ تعالیٰ عنہ نے" .

minaret:Segment_HUSN_AKHL-21593_0068 a minaret:TranscriptSegment ;
    minaret:endTime 1306.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0069 ;
    minaret:sequenceIndex 68 ;
    minaret:startTime 1287.28 ;
    minaret:text "ان کو واپس مدینہ بلایا۔ جب مدینہ آئے تو دیکھا کہ وہاں بھی وہ دن نہیں ہے، وہ منظر نہیں ہے جو اللہ کے رسول صلی اللہ علیہ وسلم کے زمانے میں تھا۔ لوگوں پر کھلم کھلا تنقید کرتے تھے کہ تم لوگ دنیا کی محبت میں مبتلا ہو گئے ہو۔ جب حضرت عثمان نے دیکھا کہ لوگ ان کی وجہ سے" .

minaret:Segment_HUSN_AKHL-21593_0069 a minaret:TranscriptSegment ;
    minaret:endTime 1326.54 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0070 ;
    minaret:sequenceIndex 69 ;
    minaret:startTime 1306.64 ;
    minaret:text "پریشان ہوتے ہیں اور یہ لوگوں کی وجہ سے پریشان ہوتے ہیں، تو ان کو مشورہ دیا کہ آپ ربذہ نام کی ایک بستی میں چلے جائیں۔ یہ اور ان کی ایک بیٹی جن کا نام لیلیٰ تھا، بیوی اور بیٹی کے ساتھ یہ مدینہ سے باہر ایک گاؤں میں زندگی بسر کرنے لگے کہ میں دنیا کے فتنوں میں نہیں رہ سکتا۔ اللہ تعالیٰ نے" .

minaret:Segment_HUSN_AKHL-21593_0070 a minaret:TranscriptSegment ;
    minaret:endTime 1346.48 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0071 ;
    minaret:sequenceIndex 70 ;
    minaret:startTime 1326.54 ;
    minaret:text "ہر ایک کی طبیعت بنائی ہے اور ہر ایک کا مزاج الگ ہے۔ بہرحال وہیں رہتے، اپنی عبادت کرتے اور اللہ اللہ کرتے۔ ہوا یہ کہ عبد اللہ بن مسعود ایک قافلے کے ساتھ گزر رہے تھے تو راستے میں پتا چلا کہ ان پر نزع کا عالم ہے، وفات کے قریب ہیں۔ ان کے سامنے ہی فوت ہوئے،" .

minaret:Segment_HUSN_AKHL-21593_0071 a minaret:TranscriptSegment ;
    minaret:endTime 1366.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0072 ;
    minaret:sequenceIndex 71 ;
    minaret:startTime 1346.48 ;
    minaret:text "انہوں نے نمازِ جنازہ پڑھائی اور دفن کیا وہیں پر۔ اور دفن کرنے کے بعد ان کی بیوی اور بیٹی کو واپس مدینہ لے آئے اور پھر جب تک وہ زندہ رہیں، حضرت عثمان رضی اللہ تعالیٰ عنہ نے اور بعد میں جو بھی خلیفہ تھے انہوں نے ان کو لک آفٹر کیا۔ ایک دفعہ کہا جاتا ہے کہ ان کے گھر پہ کوئی گیا تو دیکھا کہ" .

minaret:Segment_HUSN_AKHL-21593_0072 a minaret:TranscriptSegment ;
    minaret:endTime 1385.36 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0073 ;
    minaret:sequenceIndex 72 ;
    minaret:startTime 1366.4 ;
    minaret:text "کوئی سامان نہیں ہے۔ چاروں طرف دیکھا اور کہا کہ سامان نہیں ہے تمہارا؟ کہا: وہ دوسرے گھر بھیج دیا ہے، سامان دوسرے گھر بھیج دیا ہے۔ وہ شخص پھر نہیں سمجھا، کہا: نہیں، کچھ تو یہاں بھی ہونا چاہیے تھا۔ کہا کہ وہ گھر کا مالک ہمیں یہاں رہنے نہیں دے گا، یہاں کس لیے رکھنا ہے۔ کتنی گہری بات تھی!" .

minaret:Segment_HUSN_AKHL-21593_0073 a minaret:TranscriptSegment ;
    minaret:endTime 1406.7 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0074 ;
    minaret:sequenceIndex 73 ;
    minaret:startTime 1386.78 ;
    minaret:text "نبی صلی اللہ علیہ وسلم ان سے بے حد محبت کرتے تھے۔ جب آپ مرض الموت میں تھے، یعنی نبی صلی اللہ علیہ وسلم کی وفات سے پہلے، آپ نے ان کو خاص طور پر بلوایا، ان کا ہاتھ پکڑا اور اپنے جسم سے لگایا۔ انہیں خلیلِ رسول کہا جاتا ہے، یعنی آپ کے گہرے دوست۔ جب تک زندہ رہے کچھ" .

minaret:Segment_HUSN_AKHL-21593_0074 a minaret:TranscriptSegment ;
    minaret:endTime 1426.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0075 ;
    minaret:sequenceIndex 74 ;
    minaret:startTime 1406.7 ;
    minaret:text "نہیں رکھا اپنے پاس اور ساری فکر آخرت ہی کی کی اور بالاخر اپنے آخری ٹھکانے پہ جا پہنچے۔ انہیں مسیح الاسلام بھی کہا جاتا ہے ان کے بے حد زہد، تقویٰ اور دنیا سے بے رغبتی کی وجہ سے۔ مال و متاع میں سے تو کچھ نہیں چھوڑا، ہاں" .

minaret:Segment_HUSN_AKHL-21593_0075 a minaret:TranscriptSegment ;
    minaret:endTime 1446.06 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0076 ;
    minaret:sequenceIndex 75 ;
    minaret:startTime 1426.32 ;
    minaret:text "جو چھوڑا وہ علم کا ورثہ تھا جس سے آج بھی ہم مستفید ہو رہے ہیں۔ یہ ہیں ابو ذر رضی اللہ تعالیٰ عنہ۔ انہوں نے روایت کی رسول اللہ صلی اللہ علیہ وسلم سے اور رسول اللہ صلی اللہ علیہ وسلم اللہ تعالیٰ سے روایت کرتے ہیں: کہا اے میرے" .

minaret:Segment_HUSN_AKHL-21593_0076 a minaret:TranscriptSegment ;
    minaret:endTime 1466.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0077 ;
    minaret:sequenceIndex 76 ;
    minaret:startTime 1446.06 ;
    minaret:text "بندو! میں نے اپنے اوپر ظلم کو حرام کر رکھا ہے، یعنی اللہ تعالیٰ کسی پر ظلم نہیں کرتا، لَیْسَ بِظَلَّامٍ لِّلْعَبِیْدِ، تو تم بھی آپس میں ایک دوسرے پر ظلم نہ کرو، ایک دوسرے کے ساتھ زیادتی نہ کرو۔ کیا ہے ظلم؟ وَضْعُ الشَّیْءِ فِیْ غَیْرِ مَحَلِّهٖ،" .

minaret:Segment_HUSN_AKHL-21593_0077 a minaret:TranscriptSegment ;
    minaret:endTime 1485.74 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0078 ;
    minaret:sequenceIndex 77 ;
    minaret:startTime 1466.0 ;
    minaret:text "کسی چیز کو اس کی اصل جگہ سے ہٹا دینا، بے موقع رکھنا، اپنی حد سے تجاوز کرنا، اپنی حد سے آگے بڑھنا، اپنے حق سے زیادہ طلب کرنا کیا ہے؟ ظلم۔ اپنے حق سے زیادہ" .

minaret:Segment_HUSN_AKHL-21593_0078 a minaret:TranscriptSegment ;
    minaret:endTime 1505.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0079 ;
    minaret:sequenceIndex 78 ;
    minaret:startTime 1485.74 ;
    minaret:text "لینا، زیادہ مانگنا، اپنے فائدے کے لیے دوسرے کا نقصان کرنا۔ اللہ تعالیٰ نے اس کائنات کو ظلم پہ نہیں عدل پہ قائم کیا ہے۔ یہ دنیا یعنی یہ پوری کائنات کس پہ قائم ہے؟ عدل پہ، انصاف پر۔ ہر چیز" .

minaret:Segment_HUSN_AKHL-21593_0080 a minaret:TranscriptSegment ;
    minaret:endTime 1543.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0081 ;
    minaret:sequenceIndex 80 ;
    minaret:startTime 1524.58 ;
    minaret:text "ہیں؟ اپنی باؤنڈری کے اندر کام کر رہے ہیں، اسی لیے ان میں ٹکراؤ نہیں ہوتا۔ اگر وہ اپنی باؤنڈری، اپنا راستہ، اپنی لین چھوڑ دیں تو کیا ہوگا؟ کیا یہ سب کچھ باقی رہ سکتا ہے؟ نہیں، ٹکراؤ، اور ٹکراؤ کے نتیجے میں" .

minaret:Segment_HUSN_AKHL-21593_0081 a minaret:TranscriptSegment ;
    minaret:endTime 1563.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0082 ;
    minaret:sequenceIndex 81 ;
    minaret:startTime 1543.58 ;
    minaret:text "فساد اور ہر چیز کا خاتمہ، امن درہم برہم ہو جائے گا۔ لیکن افسوس یہ کہ جن انسانوں کے لیے یہ سب کچھ بنا ہے وہ یہ سب بھول گئے ہیں۔ آج اگر ہم اپنے آپ کو دیکھیں تو ہم میں سے کتنے لوگ اپنے دائرے میں رہ کے" .

minaret:Segment_HUSN_AKHL-21593_0087 a minaret:TranscriptSegment ;
    minaret:endTime 1683.06 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0088 ;
    minaret:sequenceIndex 87 ;
    minaret:startTime 1663.36 ;
    minaret:text "اللہ سبحانہ و تعالیٰ نے صاف فرمایا: فَلَا تَظَالَمُوْا، لوگو! ایک دوسرے پر ظلم نہ کرو۔ دوسروں پر زیادتی، یہ ظلم کس کس قسم کا ہوتا ہے؟ یعنی دوسروں پر ظلم کی قسمیں کیا ہو سکتی ہیں؟ مثلاً دوسروں کی جان پر ظلم، مال پہ" .

minaret:Segment_HUSN_AKHL-21593_0088 a minaret:TranscriptSegment ;
    minaret:endTime 1703.04 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0089 ;
    minaret:sequenceIndex 88 ;
    minaret:startTime 1683.06 ;
    minaret:text "ظلم، عزت پہ ظلم، حقوق پہ ظلم۔ یعنی ہم دوسروں پر کہاں کہاں ظلم کرتے ہیں؟ بعض وقت دوسروں کو جسمانی تکلیف پہنچاتے ہیں، مثلاً کیا کیا جسمانی تکلیفیں ہیں جو ہم دوسروں کو دیتے ہیں؟ جیسے کسی کا خون بہانا،" .

minaret:Segment_HUSN_AKHL-21593_0089 a minaret:TranscriptSegment ;
    minaret:endTime 1722.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0090 ;
    minaret:sequenceIndex 89 ;
    minaret:startTime 1703.04 ;
    minaret:text "یہ سب سے بڑی قسم ہے، کسی کی جان لینا۔ پھر اسی طرح کسی کو مارنا، ہٹ کرنا۔ پھر اسی طرح جسمانی تکلیف، کس کس قسم کی ہم جسمانی تکلیف دوسروں کو دیتے ہیں؟ کسی سے بہت زیادہ کام لینا، اس کی وسعت اور طاقت سے بڑھ کر اس پہ بوجھ ڈالنا۔" .

minaret:Segment_HUSN_AKHL-21593_0090 a minaret:TranscriptSegment ;
    minaret:endTime 1742.76 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0091 ;
    minaret:sequenceIndex 90 ;
    minaret:startTime 1723.0 ;
    minaret:text "پھر اسی طرح دوسروں کے جذبات کو نقصان دینا، دوسروں کے جذبات کو مجروح کرنا، یہ جذباتی ظلم ہے، یعنی کسی کو مینٹلی یا ایموشنلی ٹارچر کرنا۔ ایک ہے فزیکلی ٹارچر کرنا یعنی کسی کو ہٹ کرنا، مارنا" .

minaret:Segment_HUSN_AKHL-21593_0091 a minaret:TranscriptSegment ;
    minaret:endTime 1761.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0092 ;
    minaret:sequenceIndex 91 ;
    minaret:startTime 1742.76 ;
    minaret:text "پیٹنا یا جان سے ہی مار دینا، یہ تو ہے جسمانی۔ اور بعض اوقات کیا ہوتا ہے کہ جسمانی طور پر نہیں مارا جاتا لیکن دوسرے کو ذہنی طور پر اذیت دی جاتی ہے، ذہنی طور پر دوسرے کا سکون درہم برہم کر دیا جاتا ہے، دوسرے کو مینٹل ٹارچر دیا جاتا ہے" .

minaret:Segment_HUSN_AKHL-21593_0092 a minaret:TranscriptSegment ;
    minaret:endTime 1781.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0093 ;
    minaret:sequenceIndex 92 ;
    minaret:startTime 1761.9 ;
    minaret:text "یا دوسرے کو ایموشنلی لیٹ ڈاؤن کیا جاتا ہے اور اس کو پریشان کیا جاتا ہے۔ تو مینٹل ٹارچر میں کیا کیا چیزیں آتی ہیں؟ مثلاً کسی کو طنز کرنا، کسی کا مذاق اڑانا، طعنے دینا، تہمت لگانا، الزام تراشی کرنا، وربل ابیوز،" .

minaret:Segment_HUSN_AKHL-21593_0093 a minaret:TranscriptSegment ;
    minaret:endTime 1801.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0094 ;
    minaret:sequenceIndex 93 ;
    minaret:startTime 1781.86 ;
    minaret:text "گالی گلوچ کرنا، برے ناموں سے کسی کو پکارنا، مذاق اڑانا، کسی کے سامنے یا پیٹھ پیچھے دونوں طرح اس کو رسوا کرنا، کسی کی پیٹھ پیچھے اس کی برائی کر کے اس کو نقصان پہنچانا، اس کی عزت اور شہرت کو داغدار کرنا،" .

minaret:Segment_HUSN_AKHL-21593_0094 a minaret:TranscriptSegment ;
    minaret:endTime 1821.76 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0095 ;
    minaret:sequenceIndex 94 ;
    minaret:startTime 1801.86 ;
    minaret:text "غیبت، چغلی کے ذریعے کسی کی کمزوری یا ویکنس کو بار بار بیان کرنا، تو یہ تمام چیزیں کیا ہیں؟ یہ بھی ظلم میں آتی ہیں۔ کسی کو کسی اور کے سامنے نیچا دکھانے کی کوشش کرنا، غصے سے بات کرنا، یعنی کوئی بھی ایسا طریقہ کہ جس سے دوسرے" .

minaret:Segment_HUSN_AKHL-21593_0095 a minaret:TranscriptSegment ;
    minaret:endTime 1841.7 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0096 ;
    minaret:sequenceIndex 95 ;
    minaret:startTime 1821.76 ;
    minaret:text "کو ایموشنل یا مینٹل ٹارچر ملے، یعنی ایسے کام کرنا کہ جس سے دوسرا اذیت میں مبتلا ہو۔ اور جان بوجھ کے ایسے کام کرنا جب پتا بھی ہو کہ دوسرے شخص کو یہ چیز پسند نہیں تو بلا وجہ اس کو ستانے کے لیے، اس" .

minaret:Segment_HUSN_AKHL-21593_0096 a minaret:TranscriptSegment ;
    minaret:endTime 1861.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0097 ;
    minaret:sequenceIndex 96 ;
    minaret:startTime 1841.7 ;
    minaret:text "کو پریشان کرنے کے لیے صرف مزے کی خاطر، کیونکہ کچھ لوگوں کی عادت یہ ہوتی ہے کہ وہ دوسروں کو ستا کے اس سے مزا لیتے ہیں، دوسروں کو پریشان کر کے اس پہ خوش ہوتے ہیں، تو یہ بھی ظلم میں شامل ہو جاتا ہے۔ پھر اسی طرح حقوق نہ دینا، ہر ایک کا اللہ" .

minaret:Segment_HUSN_AKHL-21593_0097 a minaret:TranscriptSegment ;
    minaret:endTime 1881.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0098 ;
    minaret:sequenceIndex 97 ;
    minaret:startTime 1861.6 ;
    minaret:text "نے حق رکھا ہے، مثلاً بندوں کے حقوق کیا ہیں؟ ماں باپ کے حقوق ہیں، اولاد کے حقوق ہیں، شوہر کے حقوق ہیں، بیوی کے حقوق ہیں، رشتہ داروں کے حقوق ہیں۔ یہ حقوق نہ دینا، اور جیسا کہ پیچھے آپ دیکھیں ہم نے پڑھا ظلم میں کہ بعض اوقات اپنا" .

minaret:Segment_HUSN_AKHL-21593_0098 a minaret:TranscriptSegment ;
    minaret:endTime 1901.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0099 ;
    minaret:sequenceIndex 98 ;
    minaret:startTime 1881.6 ;
    minaret:text "حق تو لے لینا لیکن دوسرے کا حق نہ دینا، اور اپنے حق پہ کہیں نہ رکنا، اتنی ڈیمانڈز کرنا کہ دوسرا شخص عاجز آ جائے، یہ بھی دوسرے پہ ظلم ہے، ناجائز مطالبات۔ پھر آپ دیکھیں کہ بعض اوقات کسی ایک حق کو" .

minaret:Segment_HUSN_AKHL-21593_0099 a minaret:TranscriptSegment ;
    minaret:endTime 1921.36 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0100 ;
    minaret:sequenceIndex 99 ;
    minaret:startTime 1901.58 ;
    minaret:text "اتنا زیادہ بڑھا چڑھا کے پیش کرنا کہ دوسرے حق بھول ہی جائیں۔ مثلاً آپ دیکھیے کہ ظلم جو ہے نا یہ عدل کے خلاف ہے یا اعتدال کے خلاف ہے۔ ہمارے معاشرے میں اس کی بہت سی مثالیں ملتی ہیں۔ ہر شخص اپنا حق مانگنے کی فکر میں ہے لیکن کوئی بھی حق" .

minaret:Segment_HUSN_AKHL-21593_0100 a minaret:TranscriptSegment ;
    minaret:endTime 1941.28 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0101 ;
    minaret:sequenceIndex 100 ;
    minaret:startTime 1921.36 ;
    minaret:text "دینے کی فکر میں نہیں، ہر شخص ڈیمانڈ کر رہا ہے، کوئی بھی دینے کی طرف توجہ نہیں کر رہا۔ ہر شخص دوسروں کے رویے پہ نظر رکھے ہوئے ہے اور اپنے رویے کو بھول چکا ہے۔ اور ہم بعض اوقات کیا کرتے ہیں؟ اپنے حق کے حق میں خوب" .

minaret:Segment_HUSN_AKHL-21593_0101 a minaret:TranscriptSegment ;
    minaret:endTime 1961.2 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0102 ;
    minaret:sequenceIndex 101 ;
    minaret:startTime 1941.28 ;
    minaret:text "دلائل دیں گے، حدیث سنائیں گے، قرآن کی آیتیں پڑھیں گے اور دوسرے کو مجرم قرار دیں گے کہ دیکھو تم اس پر عمل نہیں کر رہے نا، میں قیامت کے دن تم سے اپنا حق لے لوں گا۔ بلیک میل بھی کرتے ہیں دوسروں کو: میں چھوڑوں گا نہیں، میں معاف نہیں کروں گا، کل تو دینا ہی پڑے گا۔ یہ بلیک میل کرنا بھی" .

minaret:Segment_HUSN_AKHL-21593_0102 a minaret:TranscriptSegment ;
    minaret:endTime 1981.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0103 ;
    minaret:sequenceIndex 102 ;
    minaret:startTime 1961.2 ;
    minaret:text "ہے، اور اس وقت انسان یہ نہ سوچے کہ وہ خود کیا کر رہا ہے۔ اور پھر ظلم اس چیز کا نام بھی نہیں کہ صرف اپنا حق مانگنا اور دوسرے کا نہ دینا، بلکہ سب کے حقوق میں بیلنس رکھنا بھی ضروری ہے۔ بعض اوقات ہم ایک کا حق دینے لگتے ہیں اور دوسروں کے حق بھول جاتے ہیں۔ مثال کے طور" .

minaret:Segment_HUSN_AKHL-21593_0105 a minaret:TranscriptSegment ;
    minaret:endTime 2039.74 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0106 ;
    minaret:sequenceIndex 105 ;
    minaret:startTime 2020.9 ;
    minaret:text "اگر ماں ایک حدیث لے لے اور بیوی دوسری لے لے تو کیا ہوگا؟ بچے کی شامت آ جائے گی! اب ہمیں عدل کیا سکھاتا ہے کہ ماں کا حق بھی دو اور بیوی کا بھی دو، بیلنس۔ جب تک یہ بیلنس نہ ہو تو ظلم ختم نہیں ہو سکتا۔" .

minaret:Segment_HUSN_AKHL-21593_0106 a minaret:TranscriptSegment ;
    minaret:endTime 2059.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0107 ;
    minaret:sequenceIndex 106 ;
    minaret:startTime 2040.56 ;
    minaret:text "اب اگر ہر وقت بیوی یہی سناتی رہے کہ دیکھو حضور صلی اللہ علیہ وسلم جو تھے وہ سب سے زیادہ اپنی بیوی کے حق میں اچھے تھے لہٰذا میرا حق زیادہ ہے، اور دوسری طرف ماں یہ سناتی رہے کہ سب سے زیادہ حق جو ہے وہ ماں کا ہے، تو کیا ہوگا نتیجہ؟ یاد یہ رکھیے کہ ایک کا حق" .

minaret:Segment_HUSN_AKHL-21593_0108 a minaret:TranscriptSegment ;
    minaret:endTime 2100.82 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0109 ;
    minaret:sequenceIndex 108 ;
    minaret:startTime 2080.82 ;
    minaret:text "اسی لیے دوسری کی طلاق کا مطالبہ کرنا، کہ بعض وقت ہمارے معاشرے میں یہ بھی ہوتا ہے کہ اگر ایک شخص نے دوسری شادی کی تو کیا ہوتا ہے؟ دوسری بیوی کیا مطالبہ کر دیتی ہے کہ جب تک پہلی کو طلاق نہ دو گے تو میں نہیں بسوں گی۔ اسی طرح ماں باپ بعض وقت مطالبہ کر دیتے ہیں: جب تک تم اس بیوی کو طلاق نہیں دو گے تم" .

minaret:Segment_HUSN_AKHL-21593_0109 a minaret:TranscriptSegment ;
    minaret:endTime 2120.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0110 ;
    minaret:sequenceIndex 109 ;
    minaret:startTime 2100.82 ;
    minaret:text "ہماری شکل نہ دیکھنا، یعنی بیٹے کو کہہ دیتے ہیں: ہمارے لیے تم مر چکے، اور اس گھر میں اس وقت قدم رکھنا جب بیوی کو چھوڑ چکو۔ تو یہ عدم توازن جو معاشرے کے اندر پایا جاتا ہے یہ درست نہیں۔ اسی طرح آپ دیکھیے کہ بعض وقت بہن بھائیوں کا خیال رکھتے رکھتے کیا ہوتا ہے" .

minaret:Segment_HUSN_AKHL-21593_0110 a minaret:TranscriptSegment ;
    minaret:endTime 2140.54 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0111 ;
    minaret:sequenceIndex 110 ;
    minaret:startTime 2120.58 ;
    minaret:text "کہ اپنے بچوں کو لوگ بھول جاتے ہیں۔ اب اللہ تعالیٰ نے بچوں کے اوپر خرچ کرنا فرض قرار دیا ہے اور دوسری طرف رشتہ داروں کا خیال رکھنا بھی۔ کہیں بھی قرآن پاک میں الگ سے بہن بھائیوں کا نام لے کے حق دینے کا ذکر نہیں آیا، بہن بھائیوں کو کس کیٹیگری میں شامل کیا گیا؟ ذوی القربیٰ، جس" .

minaret:Segment_HUSN_AKHL-21593_0111 a minaret:TranscriptSegment ;
    minaret:endTime 2160.42 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0112 ;
    minaret:sequenceIndex 111 ;
    minaret:startTime 2140.54 ;
    minaret:text "طرح باقی خالہ، ماموں، چچا، پھوپھی، دیگر رشتہ دار ہیں، اسی طرح بہن بھائی۔ تو اس میں جو نکتہ میں سمجھانا چاہ رہی ہوں وہ کیا ہے کہ ہمارے معاشرے میں ظلم کی جو قسمیں پائی جاتی ہیں کہ بعض اوقات ایک فریق ایک بندے کا حق اتنا زیادہ یاد کراتا ہے کہ اس کے نتیجے میں دوسرے کا حق ختم ہو" .

minaret:Segment_HUSN_AKHL-21593_0112 a minaret:TranscriptSegment ;
    minaret:endTime 2180.3 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0113 ;
    minaret:sequenceIndex 112 ;
    minaret:startTime 2160.42 ;
    minaret:text "جاتا ہے، یہاں ظلم کی کیفیت پیدا ہو جاتی ہے۔ بہن بھائیوں کا خیال رکھنا، رشتہ داروں کا خیال رکھنا، باقی لوگوں کا خیال رکھنا ضروری ہے لیکن اس کے ساتھ ساتھ جو اور فرائض ہیں ان کی طرف توجہ دینا بھی ضروری ہے۔ یعنی اس کے ساتھ ساتھ بہن بھائیوں کے اپنے" .

minaret:Segment_HUSN_AKHL-21593_0113 a minaret:TranscriptSegment ;
    minaret:endTime 2200.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0114 ;
    minaret:sequenceIndex 113 ;
    minaret:startTime 2180.3 ;
    minaret:text "بچوں کا خیال رکھنا بھی ضروری۔ بعض لوگ اس کے برعکس کرتے ہیں، وہ اپنے بچوں پر ہی ہر چیز خرچ کرنا اپنا فرض سمجھتے ہیں اور قریب کا بہن بھائی بھوکا بھی مر رہا ہو تو اس کا خیال ہی نہیں کرتے۔ میں پھر ظلم کی [تعریف] دہراتی ہوں تاکہ یہ یاد رہے کہ ظلم ہے" .

minaret:Segment_HUSN_AKHL-21593_0115 a minaret:TranscriptSegment ;
    minaret:endTime 2240.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0116 ;
    minaret:sequenceIndex 115 ;
    minaret:startTime 2220.34 ;
    minaret:text "اپنے فائدے کے لیے دوسروں کا نقصان کر دینا۔ اسی طرح دوسروں کے کام میں مداخلت، یہ ظلم کی ایک عام قسم ہے ہمارے معاشرے میں۔ کوئی لکھ رہا ہو: 'کیا لکھ رہے ہو تم؟ ذرا مجھے دکھاؤ، میں بھی پڑھوں'۔ مجھے نہیں معلوم، یہاں تو خیر آپ کے پاس وقت نہیں ہوگا اس طرح کرنے کا، لیکن بعض وقت" .

minaret:Segment_HUSN_AKHL-21593_0116 a minaret:TranscriptSegment ;
    minaret:endTime 2260.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0117 ;
    minaret:sequenceIndex 116 ;
    minaret:startTime 2240.12 ;
    minaret:text "جہاں لوگ اکٹھے رہتے ہیں، اب وہ اگر بیٹھ کے کوئی کام کر رہی ہیں، کچھ پڑھ رہی ہیں تو ان کو بعض وقت یوں لگتا ہے کہ جیسے کسی شخص کی کوئی پرائیویسی ہے ہی نہیں، اس پر فرض عائد ہوتا ہے کہ وہ اپنی ہر چیز، کچھ لکھے یا کچھ کرے، ہر چیز دوسروں کو بتائے۔ کوئی فون آیا" .

minaret:Segment_HUSN_AKHL-21593_0117 a minaret:TranscriptSegment ;
    minaret:endTime 2279.94 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0118 ;
    minaret:sequenceIndex 117 ;
    minaret:startTime 2260.1 ;
    minaret:text "تو لازمی بتائے کس کا فون آیا تھا، کچھ لکھا ہے تو لازمی بتائے، گھر سے واپس آیا تو لازمی بتائے کہ گھر میں کیا ہوا تھا، یعنی دوسرے کی ہر بات میں مداخلت، کیا کھایا اس نے۔ یہ تجسس کی جو قسم ہے نا: کیا چیز کہاں سے آئی ہے، یہ کیا ہو رہا ہے، وہ کیا ہو رہا ہے،" .

minaret:Segment_HUSN_AKHL-21593_0118 a minaret:TranscriptSegment ;
    minaret:endTime 2299.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0119 ;
    minaret:sequenceIndex 118 ;
    minaret:startTime 2279.94 ;
    minaret:text "ان سب چیزوں میں دوسرے کی ذاتی زندگی میں مداخلت، یہ بھی ظلم کی قسم ہے، یہ اپنے دائرے سے باہر قدم رکھنا ہے۔ اسی طرح بعض وقت اپنا کام چھوڑ دینا، دوسرے کا شروع کر دینا۔ اس کو آپ اس مثال سے اگر سمجھیں کہ سارے ستارے سیارے کیا کر رہے ہیں؟" .

minaret:Segment_HUSN_AKHL-21593_0119 a minaret:TranscriptSegment ;
    minaret:endTime 2319.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0120 ;
    minaret:sequenceIndex 119 ;
    minaret:startTime 2299.16 ;
    minaret:text "اپنے راستے پہ چل رہے ہیں۔ مثلاً خدمتِ خلق بہت اچھی بات ہے، دوسروں کے کام آنا بہت نیکی کا کام ہے، بہت بہترین، اعلیٰ درجے کی بات ہے، لیکن اپنا بچہ بیمار ہو، اپنی [اولاد] بیمار ہو اسے ہسپتال نہ لے کے جائیں اور آپ ہمسایوں" .

minaret:Segment_HUSN_AKHL-21593_0120 a minaret:TranscriptSegment ;
    minaret:endTime 2339.06 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0121 ;
    minaret:sequenceIndex 120 ;
    minaret:startTime 2319.08 ;
    minaret:text "اور رشتہ داروں کے بچوں کو دیکھنے کے لیے چل دیں، یہ ظلم ہے۔ کیوں؟ اس لیے کہ ان کی ذمہ داری سے زیادہ آپ کی ذمہ داری کیا ہے؟ اپنے بچے کو دیکھنا۔ اسی طرح صدقہ خیرات، دوسرے پہ صدقہ خیرات کرنا بہت اچھی بات ہے لیکن اگر آپ کے اپنے بچے بھوکے ہیں جن کو" .

minaret:Segment_HUSN_AKHL-21593_0121 a minaret:TranscriptSegment ;
    minaret:endTime 2358.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0122 ;
    minaret:sequenceIndex 121 ;
    minaret:startTime 2339.06 ;
    minaret:text "کھلانا فرض ہے، بیوی بچوں کا نان نفقہ فرض ہے، اگر اس کو چھوڑ کے آپ کسی اور کو کھلا رہے ہیں صدقہ کی نیت سے تو یہ بھی کیا ہو گیا؟ ظلم۔ تو درجوں میں اور حقوق میں جو ترجیحات ہیں ان میں کمی بیشی کرنا جو ہے یہ بھی ظلم ہو" .

minaret:Segment_HUSN_AKHL-21593_0122 a minaret:TranscriptSegment ;
    minaret:endTime 2378.88 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0123 ;
    minaret:sequenceIndex 122 ;
    minaret:startTime 2358.96 ;
    minaret:text "جاتا ہے، یعنی کسی کو پھلانگ جانا۔ اسی طرح بعض اوقات کسی دفتر میں اگر لوگ اکٹھے کام کر رہے ہیں، ہر ایک کی اپنی اپنی ڈیوٹی ہے۔ اب اگر کوئی شخص اپنی ڈیوٹی چھوڑ دیتا ہے، مثلاً اگر کوئی شخص کہیں چوکیدار ہے، گارڈ ہے، وہ وہاں سے چھوڑ کے اپنا کام اور آ کے ٹیلی فون ڈیسک پہ" .

minaret:Segment_HUSN_AKHL-21593_0123 a minaret:TranscriptSegment ;
    minaret:endTime 2392.48 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0124 ;
    minaret:sequenceIndex 123 ;
    minaret:startTime 2378.88 ;
    minaret:text "کھڑے ہو کے ٹیلی فون اٹینڈ کرنا شروع کر دے تو یہ کیا ہے؟ یہ نیکی نہیں ہے۔ بعض لوگ اس کو کیا سمجھتے ہیں کہ ہم ہر فن مولا ہیں اور دوسروں کے کام کرنا جو ہے یہ تو بہت خدمتِ خلق ہے، اور یہ بھول جاتے ہیں" .

minaret:Segment_HUSN_AKHL-21593_0124 a minaret:TranscriptSegment ;
    minaret:endTime 2398.78 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0125 ;
    minaret:sequenceIndex 124 ;
    minaret:startTime 2392.48 ;
    minaret:text "کہ ان کی اپنی ڈیوٹی کیا تھی، انہیں کہاں ہونا چاہیے تھا؟ تو یہ بھی زیادتی ہے۔" .

minaret:Segment_HUSN_AKHL-21593_0125 a minaret:TranscriptSegment ;
    minaret:endTime 2418.36 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0126 ;
    minaret:sequenceIndex 125 ;
    minaret:startTime 2398.78 ;
    minaret:text "پھر اسی طرح حقوق اللہ کی ادائیگی اپنی جگہ اور حقوق العباد کی اپنی جگہ۔ یہ نہیں کہ اللہ کے حقوق کی ادائیگی میں آپ ساری رات نفل پڑھتے رہیں اور گھر والے بھوکے بیٹھے رہیں، یہ بھی زیادتی ہو جائے گی۔ تو ظلم جو ہے عدل سے ہٹنے کا نام ہے، چیزوں کو بے موقع رکھنے کا نام ہے،" .

minaret:Segment_HUSN_AKHL-21593_0126 a minaret:TranscriptSegment ;
    minaret:endTime 2439.3 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0127 ;
    minaret:sequenceIndex 126 ;
    minaret:startTime 2419.3 ;
    minaret:text "دوسروں کو تکلیف دینے کا نام ہے۔ اسی طرح انسانوں کے ساتھ کچھ اور ظلم بھی ہم کرتے ہیں، مثلاً کسی کا وقت ضائع کرنا۔ یہ کتنا بڑا ظلم ہے کہ ایک شخص کو مثلاً نماز پڑھنا ہے، ہم عین اس وقت کسی کو فون کال کر دیتے ہیں اور اس کو کیا کہتے ہیں کہ تم مجھے اس وقت کھانے کی ریسپی بتاؤ!" .

minaret:Segment_HUSN_AKHL-21593_0127 a minaret:TranscriptSegment ;
    minaret:endTime 2460.78 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0128 ;
    minaret:sequenceIndex 127 ;
    minaret:startTime 2440.88 ;
    minaret:text "بعض وقت ایک جگہ سے دوسری جگہ پر ٹائمنگز کے فرق ہوتے ہیں۔ اب اگر نماز کے وقت میں آپ خدمتِ خلق سمجھتے ہوئے کہ ہم کسی کا دل نہیں توڑ سکتے، اس وقت آپ اس کی مدد کرنا لازم [سمجھیں]، اپنی نماز قضا کر دیں مغرب کی مثلاً، اور دوسرے کو آپ کھانا پکانے کی ترکیب سکھاتے رہیں تو یہ کیا ہے؟ ظلم" .

minaret:Segment_HUSN_AKHL-21593_0128 a minaret:TranscriptSegment ;
    minaret:endTime 2479.84 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0129 ;
    minaret:sequenceIndex 128 ;
    minaret:startTime 2460.78 ;
    minaret:text "ہے۔ اسی طرح بے کار کی باتوں میں دوسروں کو الجھا کے ان کا وقت ضائع کرنا کیا ہے؟ یہ بھی ظلم ہے، زیادتی ہے۔ یعنی کسی کا مال چھیننا ہی زیادتی نہیں، کسی کی عزت چھیننا ہی زیادتی نہیں، کسی کا وقت اور اس کی صلاحیتوں کو ضائع کرنا یہ بھی زیادتی ہے۔" .

minaret:Segment_HUSN_AKHL-21593_0129 a minaret:TranscriptSegment ;
    minaret:endTime 2500.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0130 ;
    minaret:sequenceIndex 129 ;
    minaret:startTime 2480.4 ;
    minaret:text "پھر اسی طرح اس میں کیا ہوتا ہے، یعنی دوسروں کا وقت ضائع کرنے کی، کہ یہ کس میں آپ دیکھ سکتے ہیں، مثلاً آپ کیا سمجھتے ہیں کہ آپ کا وقت کب ضائع ہوتا ہے؟ مثلاً یعنی بے موقع، بے وقت کسی کے گھر چلے جانا اور وہ اگر نماز کے لیے جا رہا ہے تو اس کو طعنہ دینا کہ ہم آئے ہیں اور ہماری پروا نہیں۔ اور اس طرح پھر ہم لوگوں کے ڈر سے" .

minaret:Segment_HUSN_AKHL-21593_0130 a minaret:TranscriptSegment ;
    minaret:endTime 2519.74 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0131 ;
    minaret:sequenceIndex 130 ;
    minaret:startTime 2500.38 ;
    minaret:text "کیا کرتے ہیں؟ کبھی اللہ کا حق مارتے ہیں، کبھی بندوں کا مارتے ہیں، کبھی اس کا، کبھی اس کا، اور وہ ایک پورا سرکل چلا ہوا ہے کہ ہر ایک دوسرے پر پھر کسی نہ کسی درجے میں آ کر زیادتی کا مرتکب ہو جاتا ہے۔ پہلے شاید اتنا احساس نہیں تھا ہمیں، کیونکہ احساس نہیں تھا نا کہ زندگی کتنی قیمتی چیز ہے۔" .

minaret:Segment_HUSN_AKHL-21593_0131 a minaret:TranscriptSegment ;
    minaret:endTime 2540.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0132 ;
    minaret:sequenceIndex 131 ;
    minaret:startTime 2520.24 ;
    minaret:text "اب وقت کے ساتھ ساتھ ہم سب کو احساس ہوتا چلا جا رہا ہے کہ وقت جو ہے، پتا ہی ہے، تھوڑی زندگی ہے، زیادہ کام ہے، اور پھر جوں جوں فرائض کا احساس ہونا شروع ہوتا ہے کہ یہ بھی فرض ہے، یہ بھی ذمہ داری ہے، یہ بھی کرنا ہے، تو اس میں اگر تھوڑا سا بھی وقت کوئی بے کار میں ضائع ہوتا ہے تو پھر وہ زیادہ تکلیف ہو جاتی ہے۔ بعض اوقات ضروری بات کے" .

minaret:Segment_HUSN_AKHL-21593_0132 a minaret:TranscriptSegment ;
    minaret:endTime 2559.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0133 ;
    minaret:sequenceIndex 132 ;
    minaret:startTime 2540.08 ;
    minaret:text "ساتھ اتنی غیر ضروری چیزیں اور شروع ہو جاتی ہیں کہ جس سے بہت سا وقت ضائع ہو جاتا ہے۔ پھر اسی طرح ہم دوسروں کے اوپر اور کیا ظلم کرتے ہیں، ان کو اپنی ذات سے کیسے تکلیف دیتے ہیں؟ جیسے نہاتے نہیں یا گندے کپڑے پہن کے دوسروں کے پاس بیٹھ جاتے ہیں، اپنی سمیل سے، پیاز لہسن کھا کے بیٹھ جاتے ہیں،" .

minaret:Segment_HUSN_AKHL-21593_0133 a minaret:TranscriptSegment ;
    minaret:endTime 2580.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0134 ;
    minaret:sequenceIndex 133 ;
    minaret:startTime 2560.56 ;
    minaret:text "اس سے کیا ہے کہ اپنی سانس سے دوسروں کو اذیت دینا، ان کے لیے بیٹھنا جینا دوبھر کر دینا۔ پھر اسی طرح اپنی چیزوں پر ظلم، ریسورسز کا غلط استعمال کرنا۔ چونکہ موضوع طویل ہے اس لیے ان شاء اللہ ہم آج کی بات یہیں مکمل کرتے ہیں اس ایک حدیث پر،" .

minaret:Segment_HUSN_AKHL-21593_0134 a minaret:TranscriptSegment ;
    minaret:endTime 2600.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0135 ;
    minaret:sequenceIndex 134 ;
    minaret:startTime 2580.94 ;
    minaret:text "اور اگلے ہفتے پھر ان شاء اللہ اسی موضوع کے ساتھ ہم کنٹینیو کریں گے۔ اس دوران آپ اپنا جائزہ لیجیے کہ اپنی زندگی میں توازن لانے کی آپ نے کہاں کہاں کوشش کی اور کہاں کہاں زیادتی ہوئی، اس کو سامنے رکھ کے آپ دیکھیے" .

minaret:Segment_HUSN_AKHL-21593_0135 a minaret:TranscriptSegment ;
    minaret:endTime 2620.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0136 ;
    minaret:sequenceIndex 135 ;
    minaret:startTime 2600.9 ;
    minaret:text "کہ ہم دوسروں پر کس طرح ظلم کرتے ہیں: والدین کے ساتھ، بچوں کے ساتھ، کیونکہ بچوں کے ساتھ زیادتی کی ایک اور طویل داستان ہے کہ ہم کہاں کہاں ان کے ساتھ ظلم کرتے ہیں، شوہر کے ساتھ، پھر اسی طرح اپنے ساتھیوں کے ساتھ، کھانے پینے کی چیزوں کے ساتھ، پھر ماحول کے ساتھ،" .

minaret:Segment_HUSN_AKHL-21593_0136 a minaret:TranscriptSegment ;
    minaret:endTime 2640.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0137 ;
    minaret:sequenceIndex 136 ;
    minaret:startTime 2620.4 ;
    minaret:text "خود اپنے ساتھ۔ تو ان شاء اللہ کم از کم اس میں ایک ایک چیز اوریجنل اپنی سوچ سے لکھیے، اپنی سوچ سے، نقالی نہیں، کسی سے پوچھنا نہیں، کیونکہ آپ جب اپنی سوچ استعمال کریں گے تو اس سے کیا ہوگا؟ احساس زیادہ ہوگا۔ اور پھر جب یہ یاد رہے" .

minaret:Segment_HUSN_AKHL-21593_0137 a minaret:TranscriptSegment ;
    minaret:endTime 2660.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0138 ;
    minaret:sequenceIndex 137 ;
    minaret:startTime 2640.4 ;
    minaret:text "کہ جو کچھ ہم کسی کے ساتھ زیادتی کرتے ہیں وہ قیامت کے دن عمل کی شکل میں دینا پڑے گی۔ دنیا میں تو سیو کر دیتے ہیں اور ہرجانہ بھر لیتے ہیں، لیکن قیامت کے دن بھی بہت سے سیو کرنے والے کھڑے ہیں جو یہاں کچھ نہیں کہہ سکتے اور وہاں خوب خوب اپنا حق وصول کریں گے۔ ان شاء اللہ تعالیٰ" .

minaret:Dua_MasnoonDua-159 a minaret:Dua ;
    minaret:duaTypeEn "Masnoon Dua" ;
    minaret:duaTypeUr "مسنون دعاء" ;
    minaret:reference "MasnoonDua-159" ;
    minaret:translationEn "You are free from imperfection, O Allah, and all praise is to You. I bear witness that there is no god but You. I seek your forgiveness and turn to You in repentance." ;
    minaret:translationUr "اے اللہ تو پاک ہے اور تیری ہی تعریف ہے میں گوائی دیتا ہوں کہ تیرے سوا کوئی معبود نہیں میں تجھ سے بخش مانگتا ہوں اور تیری طرف توبہ کرتا ہوں" ;
    minaret:transliteration "" .

minaret:Dua_QuranicDua-08 a minaret:Dua ;
    minaret:duaTypeEn "Qurani Dua" ;
    minaret:duaTypeUr "قرآنى دعاء‎" ;
    minaret:reference "QuranicDua-08" ;
    minaret:translationEn "O My Lord, expand for me my chest. And ease for me my task. And untie the knot from my tongue. That they may understand my speech." ;
    minaret:translationUr "اے میرے رب! میرا سینہ کھول دے اور میرا کام آسان کر دے اور میری زبان کی گرہ کھول دے تاکہ وہ میری بات سمجھ سکیں" ;
    minaret:transliteration "Rabbi ishrah li sadri wa yassir li amri wahlul 'uqdatan min lisaani yafqahu qawli" .

minaret:QuranVerse_20_25 a minaret:QuranVerse ;
    minaret:juz 16 ;
    minaret:surahNumber 20 ;
    minaret:textClean "قال رب اشرح لي صدري" ;
    minaret:textIndopak "قَالَ رَبِّ اشْرَحْ لِیْ صَدْرِیْ ۟ۙ" ;
    minaret:textUthmani "قَالَ رَبِّ ٱشۡرَحۡ لِي صَدۡرِي" ;
    minaret:translationEn "[Moses] said, \"My Lord, expand for me my breast [with assurance]" ;
    minaret:translationUr "" ;
    minaret:verseNumber 25 ;
    skos:exactMatch qur:quran20-25,
        tafsir:V020_025 .

minaret:QuranVerse_20_26 a minaret:QuranVerse ;
    minaret:juz 16 ;
    minaret:surahNumber 20 ;
    minaret:textClean "ويسر لي أمري" ;
    minaret:textIndopak "وَیَسِّرْ لِیْۤ اَمْرِیْ ۟ۙ" ;
    minaret:textUthmani "وَيَسِّرۡ لِيٓ أَمۡرِي" ;
    minaret:translationEn "And ease for me my task" ;
    minaret:translationUr "" ;
    minaret:verseNumber 26 ;
    skos:exactMatch qur:quran20-26,
        tafsir:V020_026 .

minaret:QuranVerse_20_27 a minaret:QuranVerse ;
    minaret:juz 16 ;
    minaret:surahNumber 20 ;
    minaret:textClean "واحلل عقدة من لساني" ;
    minaret:textIndopak "وَاحْلُلْ عُقْدَةً مِّنْ لِّسَانِیْ ۟ۙ" ;
    minaret:textUthmani "وَٱحۡلُلۡ عُقۡدَةً مِّن لِّسَانِي" ;
    minaret:translationEn "And untie the knot from my tongue" ;
    minaret:translationUr "" ;
    minaret:verseNumber 27 ;
    skos:exactMatch qur:quran20-27,
        tafsir:V020_027 .

minaret:QuranVerse_20_28 a minaret:QuranVerse ;
    minaret:juz 16 ;
    minaret:surahNumber 20 ;
    minaret:textClean "يفقهوا قولي" ;
    minaret:textIndopak "یَفْقَهُوْا قَوْلِیْ ۪۟" ;
    minaret:textUthmani "يَفۡقَهُواْ قَوۡلِي" ;
    minaret:translationEn "That they may understand my speech." ;
    minaret:translationUr "" ;
    minaret:verseNumber 28 ;
    skos:exactMatch qur:quran20-28,
        tafsir:V020_028 .

minaret:QuranVerse_3_159 a minaret:QuranVerse ;
    minaret:juz 4 ;
    minaret:surahNumber 3 ;
    minaret:textClean "فبما رحمة من الله لنت لهم ۖ ولو كنت فظا غليظ القلب لانفضوا من حولك ۖ فاعف عنهم واستغفر لهم وشاورهم في الأمر ۖ فإذا عزمت فتوكل على الله ۚ إن الله يحب المتوكلين" ;
    minaret:textIndopak "فَبِمَا رَحْمَةٍ مِّنَ اللّٰهِ لِنْتَ لَهُمْ ۚ وَلَوْ كُنْتَ فَظًّا غَلِیْظَ الْقَلْبِ لَانْفَضُّوْا مِنْ حَوْلِكَ ۪ فَاعْفُ عَنْهُمْ وَاسْتَغْفِرْ لَهُمْ وَشَاوِرْهُمْ فِی الْاَمْرِ ۚ فَاِذَا عَزَمْتَ فَتَوَكَّلْ عَلَی اللّٰهِ ؕ اِنَّ اللّٰهَ یُحِبُّ الْمُتَوَكِّلِیْنَ ۟" ;
    minaret:textUthmani "فَبِمَا رَحۡمَةٍ مِّنَ ٱللَّهِ لِنتَ لَهُمۡۖ وَلَوۡ كُنتَ فَظًّا غَلِيظَ ٱلۡقَلۡبِ لَٱنفَضُّواْ مِنۡ حَوۡلِكَۖ فَٱعۡفُ عَنۡهُمۡ وَٱسۡتَغۡفِرۡ لَهُمۡ وَشَاوِرۡهُمۡ فِي ٱلۡأَمۡرِۖ فَإِذَا عَزَمۡتَ فَتَوَكَّلۡ عَلَى ٱللَّهِۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُتَوَكِّلِينَ" ;
    minaret:translationEn "So by mercy from Allah, [O Muhammad], you were lenient with them. And if you had been rude [in speech] and harsh in heart, they would have disbanded from about you. So pardon them and ask forgiveness for them and consult them in the matter. And when you have decided, then rely upon Allah. Indeed, Allah loves those who rely [upon Him]." ;
    minaret:translationUr "" ;
    minaret:verseNumber 159 ;
    skos:exactMatch qur:quran3-159,
        tafsir:V003_159 .

minaret:QuranVerse_59_7 a minaret:QuranVerse ;
    minaret:juz 28 ;
    minaret:surahNumber 59 ;
    minaret:textClean "ما أفاء الله على رسوله من أهل القرى فلله وللرسول ولذي القربى واليتامى والمساكين وابن السبيل كي لا يكون دولة بين الأغنياء منكم ۚ وما آتاكم الرسول فخذوه وما نهاكم عنه فانتهوا ۚ واتقوا الله ۖ إن الله شديد العقاب" ;
    minaret:textIndopak "مَاۤ اَفَآءَ اللّٰهُ عَلٰی رَسُوْلِهٖ مِنْ اَهْلِ الْقُرٰی فَلِلّٰهِ وَلِلرَّسُوْلِ وَلِذِی الْقُرْبٰی وَالْیَتٰمٰی وَالْمَسٰكِیْنِ وَابْنِ السَّبِیْلِ ۙ كَیْ لَا یَكُوْنَ دُوْلَةً بَیْنَ الْاَغْنِیَآءِ مِنْكُمْ ؕ وَمَاۤ اٰتٰىكُمُ الرَّسُوْلُ فَخُذُوْهُ ۗ وَمَا نَهٰىكُمْ عَنْهُ فَانْتَهُوْا ۚ وَاتَّقُوا اللّٰهَ ؕ اِنَّ اللّٰهَ شَدِیْدُ الْعِقَابِ ۟ۘ" ;
    minaret:textUthmani "مَّآ أَفَآءَ ٱللَّهُ عَلَىٰ رَسُولِهِۦ مِنۡ أَهۡلِ ٱلۡقُرَىٰ فَلِلَّهِ وَلِلرَّسُولِ وَلِذِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَٱبۡنِ ٱلسَّبِيلِ كَيۡ لَا يَكُونَ دُولَةَۢ بَيۡنَ ٱلۡأَغۡنِيَآءِ مِنكُمۡۚ وَمَآ ءَاتَىٰكُمُ ٱلرَّسُولُ فَخُذُوهُ وَمَا نَهَىٰكُمۡ عَنۡهُ فَٱنتَهُواْۚ وَٱتَّقُواْ ٱللَّهَۖ إِنَّ ٱللَّهَ شَدِيدُ ٱلۡعِقَابِ" ;
    minaret:translationEn "And what Allah restored to His Messenger from the people of the towns - it is for Allah and for the Messenger and for [his] near relatives and orphans and the [stranded] traveler - so that it will not be a perpetual distribution among the rich from among you. And whatever the Messenger has given you - take; and what he has forbidden you - refrain from. And fear Allah; indeed, Allah is severe in penalty." ;
    minaret:translationUr "" ;
    minaret:verseNumber 7 ;
    skos:exactMatch qur:quran59-7,
        tafsir:V059_007 .

minaret:Segment_HUSN_AKHL-21590_0007 a minaret:TranscriptSegment ;
    minaret:endTime 90.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 81.6 ;
    minaret:text "لَاُحَدِّثَنَّكَ حَدِیْثًا میں تمہیں ضرور حدیث بیان کروں گا حَدَّثَنِیْهِ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ" .

minaret:Segment_HUSN_AKHL-21590_0008 a minaret:TranscriptSegment ;
    minaret:endTime 104.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 91.68 ;
    minaret:text "جسے مجھ سے رسول اللہ صلی اللہ علیہ وسلم نے بیان کیا ہے عَقَلْتَهٗ وَعَلِمْتَهٗ جس کو میں نے آپ سے سمجھا اور اس کو جانا اور یہ کہہ کر" .

minaret:Segment_HUSN_AKHL-21590_0009 a minaret:TranscriptSegment ;
    minaret:endTime 111.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 105.32 ;
    minaret:text "ثُمَّ نَشَغَ اَبُوْ هُرَیْرَةَ نَشْغَةً، نشغہ کہتے ہیں سسکی لینے کو" .

minaret:Segment_HUSN_AKHL-21590_0010 a minaret:TranscriptSegment ;
    minaret:endTime 122.62 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 111.96 ;
    minaret:text "یعنی ایک غم اور حسرت اور دل کے دکھ کا اظہار اور ایسا اظہار کہ جس کے نتیجے میں بے ہوشی طاری ہو جائے ایسی سسکی ایسی آہ" .

minaret:Segment_HUSN_AKHL-21590_0011 a minaret:TranscriptSegment ;
    minaret:endTime 134.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0012 ;
    minaret:sequenceIndex 11 ;
    minaret:startTime 123.26 ;
    minaret:text "کہ وہ ایک طرح سے بے ہوش ہو گئے۔ نشغہ لمبی سانس لینے کو یعنی ایک لمبی سانس لی ایک سسکی لی اور یوں لگا جیسے گم ہو گئے" .

minaret:Segment_HUSN_AKHL-21590_0012 a minaret:TranscriptSegment ;
    minaret:endTime 149.74 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0013 ;
    minaret:sequenceIndex 12 ;
    minaret:startTime 135.18 ;
    minaret:text "چیخ مار کے بے ہوش ہو گئے۔ فَمَكَثْنَا قَلِیْلًا تو ہم تھوڑی دیر رکے رہے کہ اب یہ کیا ہوتا ہے ثُمَّ اَفَاقَ پھر تھوڑی دیر میں آپ کو افاقہ ہوا یعنی آپ ٹھیک ہو گئے فَقَالَ پھر بولے" .

minaret:Segment_HUSN_AKHL-21590_0013 a minaret:TranscriptSegment ;
    minaret:endTime 163.62 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0014 ;
    minaret:sequenceIndex 13 ;
    minaret:startTime 151.38 ;
    minaret:text "لَاُحَدِّثَنَّكَ حَدِیْثًا حَدَّثَنِیْهِ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ میں ضرور تمہیں حدیث سناؤں گا جسے مجھ سے رسول اللہ صلی اللہ علیہ وسلم نے بیان کیا ہے" .

minaret:Segment_HUSN_AKHL-21590_0014 a minaret:TranscriptSegment ;
    minaret:endTime 174.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0015 ;
    minaret:sequenceIndex 14 ;
    minaret:startTime 164.48 ;
    minaret:text "اَنَا وَهُوَ فِیْ هٰذَا الْبَیْتِ جبکہ میں اور وہ اس گھر میں تھے یعنی کوئی تیسرا نہیں تھا مَا مَعَنَا" .

minaret:Segment_HUSN_AKHL-21590_0015 a minaret:TranscriptSegment ;
    minaret:endTime 184.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0016 ;
    minaret:sequenceIndex 15 ;
    minaret:startTime 174.44 ;
    minaret:text "مَا مَعَنَا اَحَدٌ غَیْرِیْ وَغَیْرُهٗ ہمارے ساتھ کوئی تیسرا غیری یعنی میرے علاوہ وغیرہ اور اس کے علاوہ یعنی آپ صلی اللہ علیہ وسلم کے علاوہ کوئی" .

minaret:Segment_HUSN_AKHL-21590_0016 a minaret:TranscriptSegment ;
    minaret:endTime 196.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0017 ;
    minaret:sequenceIndex 16 ;
    minaret:startTime 184.58 ;
    minaret:text "اور موجود نہ تھا اور یہ کہہ کر ثُمَّ نَشَغَ اَبُوْ هُرَیْرَةَ نَشْغَةً اُخْرٰی ابو ہریرہ پہ پھر وہی کیفیت طاری ہو گئی پھر اسی طرح" .

minaret:Segment_HUSN_AKHL-21590_0017 a minaret:TranscriptSegment ;
    minaret:endTime 208.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0018 ;
    minaret:sequenceIndex 17 ;
    minaret:startTime 196.86 ;
    minaret:text "سسکی لی آہ بھری اور بے ہوش ہو گئے۔ ثُمَّ اَفَاقَ پھر افاقہ ہوا وَمَسَحَ عَنْ وَجْهِهٖ اور انہوں نے اپنے چہرے سے" .

minaret:Segment_HUSN_AKHL-21590_0018 a minaret:TranscriptSegment ;
    minaret:endTime 218.26 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0019 ;
    minaret:sequenceIndex 18 ;
    minaret:startTime 209.04 ;
    minaret:text "مسح کیا یعنی اپنا چہرہ پونچھا پسینہ ہو گا یا جو بھی ان کے دل کی کیفیت ان کے چہرے پر تھی اس کو صاف کیا فَقَالَ پھر فرمایا" .

minaret:Segment_HUSN_AKHL-21590_0019 a minaret:TranscriptSegment ;
    minaret:endTime 228.26 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0020 ;
    minaret:sequenceIndex 19 ;
    minaret:startTime 218.92 ;
    minaret:text "اَفْعَلُ میں کروں گا میں حدیث بیان کروں گا لَاُحَدِّثَنَّكَ حَدِیْثًا حَدَّثَنِیْهِ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ" .

minaret:Segment_HUSN_AKHL-21590_0020 a minaret:TranscriptSegment ;
    minaret:endTime 239.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0021 ;
    minaret:sequenceIndex 20 ;
    minaret:startTime 229.2 ;
    minaret:text "ایسی حدیث کہ جسے مجھ سے رسول اللہ صلی اللہ علیہ وسلم نے بیان کیا اَنَا وَهُوَ فِیْ هٰذَا الْبَیْتِ میں اور" .

minaret:Segment_HUSN_AKHL-21590_0021 a minaret:TranscriptSegment ;
    minaret:endTime 249.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0022 ;
    minaret:sequenceIndex 21 ;
    minaret:startTime 239.44 ;
    minaret:text "وہ یعنی آپ صلی اللہ علیہ وسلم تھے اس گھر میں مَا مَعَنَا اَحَدٌ غَیْرِیْ وَغَیْرُهٗ ہمارے ساتھ کوئی تیسرا نہ تھا ثُمَّ نَشَغَ أَبُوْ" .

minaret:Segment_HUSN_AKHL-21590_0022 a minaret:TranscriptSegment ;
    minaret:endTime 259.24 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0023 ;
    minaret:sequenceIndex 22 ;
    minaret:startTime 249.52 ;
    minaret:text "ثُمَّ نَشَغَ اَبُوْ هُرَیْرَةَ نَشْغَةً اُخْرٰی پھر ایک اور بار حضرت ابو ہریرہ چیخ مار کر لمبی سسکی لیتے ہوئے بے ہوش ہو گئے" .

minaret:Segment_HUSN_AKHL-21590_0023 a minaret:TranscriptSegment ;
    minaret:endTime 265.04 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0024 ;
    minaret:sequenceIndex 23 ;
    minaret:startTime 259.24 ;
    minaret:text "ثُمَّ اَفَاقَ وَمَسَحَ عَنْ وَجْهِهٖ پھر افاقہ ہوا اور اپنے چہرے کو پونچھا" .

minaret:Segment_HUSN_AKHL-21590_0024 a minaret:TranscriptSegment ;
    minaret:endTime 276.72 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0025 ;
    minaret:sequenceIndex 24 ;
    minaret:startTime 266.66 ;
    minaret:text "فَقَالَ: اَفْعَلُ، لَاُحَدِّثَنَّكَ حَدِیْثًا حَدَّثَنِیْهِ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ اَنَا وَهُوَ فِیْ هٰذَا" .

minaret:Segment_HUSN_AKHL-21590_0025 a minaret:TranscriptSegment ;
    minaret:endTime 283.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0026 ;
    minaret:sequenceIndex 25 ;
    minaret:startTime 276.72 ;
    minaret:text "الْبَيْتِ مَا مَعَنَا اَحَدٌ غَیْرِیْ وَغَیْرُهٗ ثُمَّ نَشَغَ أَبُوْ حُرَيْرَتَ" .

minaret:Segment_HUSN_AKHL-21590_0026 a minaret:TranscriptSegment ;
    minaret:endTime 290.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0027 ;
    minaret:sequenceIndex 26 ;
    minaret:startTime 285.04 ;
    minaret:text "ثُمَّ نَشَغَ اَبُوْ هُرَیْرَةَ نَشْغَةً شَدِیْدَةً پھر ابو ہریرہ اسی طرح بے ہوش ہوئے اور شدید قسم کے حال سے" .

minaret:Segment_HUSN_AKHL-21590_0027 a minaret:TranscriptSegment ;
    minaret:endTime 301.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0028 ;
    minaret:sequenceIndex 27 ;
    minaret:startTime 291.66 ;
    minaret:text "ثُمَّ مَالَ خَآرًّا پھر وہ جھکے گرتے ہوئے یعنی بے ہوش ہوتے ہوتے جیسے جھکے اور یوں لگتا تھا کہ اب نیچے گر" .

minaret:Segment_HUSN_AKHL-21590_0028 a minaret:TranscriptSegment ;
    minaret:endTime 309.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0029 ;
    minaret:sequenceIndex 28 ;
    minaret:startTime 301.58 ;
    minaret:text "پڑیں گے عَلٰی وَجْهِهٖ اپنے چہرے کے بل فَاَسْنَدْتُّهٗ طَوِیْلًا تو میں نے آپ کو تھام لیا سند ہوتا تکیہ دینا سہارا دینا" .

minaret:Segment_HUSN_AKHL-21590_0029 a minaret:TranscriptSegment ;
    minaret:endTime 321.88 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0030 ;
    minaret:sequenceIndex 29 ;
    minaret:startTime 311.02 ;
    minaret:text "تو میں نے آپ کو سنبھالا دیا طَوِیْلًا کافی دیر تک ثُمَّ اَفَاقَ پھر افاقہ ہوا اب وہ دل کی کیفیت کچھ ہلکی ہوئی" .

minaret:Segment_HUSN_AKHL-21590_0094 a minaret:TranscriptSegment ;
    minaret:endTime 1011.06 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0095 ;
    minaret:sequenceIndex 94 ;
    minaret:startTime 1003.16 ;
    minaret:text "اس لیے کہ خود قرآن نے ہمیں کہا: وَمَاۤ اٰتٰىكُمُ الرَّسُوْلُ فَخُذُوْهُ ۗ، کیا معنی اس کا؟" .

minaret:Segment_HUSN_AKHL-21590_0095 a minaret:TranscriptSegment ;
    minaret:endTime 1022.24 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0096 ;
    minaret:sequenceIndex 95 ;
    minaret:startTime 1011.06 ;
    minaret:text "کہ جو تمہیں رسول دے رہے ہیں وہ لے لو اگر ہم وہ نہیں لیتے جو ہمیں رسول اللہ صلی اللہ علیہ وسلم دیں تو ہم کس کی نافرمانی کر رہے ہیں؟" .

minaret:Segment_HUSN_AKHL-21590_0101 a minaret:TranscriptSegment ;
    minaret:endTime 1081.62 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0102 ;
    minaret:sequenceIndex 101 ;
    minaret:startTime 1072.86 ;
    minaret:text "کرتے آپ اپنی مرضی اور اپنی پسند و ناپسند سے باتیں نہیں کرتے بلکہ جو کچھ آپ لوگوں کو بتاتے ہیں وہ دراصل کیا ہے؟" .

minaret:Segment_HUSN_AKHL-21590_0102 a minaret:TranscriptSegment ;
    minaret:endTime 1091.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0103 ;
    minaret:sequenceIndex 102 ;
    minaret:startTime 1081.62 ;
    minaret:text "اِنْ هُوَ اِلَّا وَحْیٌ یُّوْحٰی ۟ۙ وہ وہی ہے جو آپ کی طرف اللہ کی طرف سے القا کی گئی ہے بھیجی گئی ہے اگر قرآن" .

minaret:Segment_HUSN_AKHL-21590_0107 a minaret:TranscriptSegment ;
    minaret:endTime 1138.88 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0108 ;
    minaret:sequenceIndex 107 ;
    minaret:startTime 1129.38 ;
    minaret:text "قرآن کا چلتا پھرتا نمونہ اگر کوئی شخص یہ چاہتا ہو کہ قرآن پر عمل کرے تو یہ ممکن نہیں کہ پھر" .

minaret:Segment_HUSN_AKHL-21590_0161 a minaret:TranscriptSegment ;
    minaret:endTime 1691.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0162 ;
    minaret:sequenceIndex 161 ;
    minaret:startTime 1681.18 ;
    minaret:text "اجازت لو تو اس پر آپ صلی اللہ علیہ وسلم سے انہوں نے اجازت لی اور آپ نے فرمایا کہ خدا کی قسم جس کے قبضے میں میری جان ہے میری زبان سے حق کے سوا کچھ نہیں نکلتا خواہ میں غصے" .

minaret:Segment_HUSN_AKHL-21590_0162 a minaret:TranscriptSegment ;
    minaret:endTime 1699.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0163 ;
    minaret:sequenceIndex 162 ;
    minaret:startTime 1691.16 ;
    minaret:text "میں ہوں خواہ میں دوسری حالت میں ہوں لیکن اس زبان سے جو کچھ نکلتا ہے وہ درست نکلتا ہے اور آپ نے ان کو لکھنے کی اجازت دی" .

minaret:Segment_HUSN_AKHL-21590_0204 a minaret:TranscriptSegment ;
    minaret:endTime 2117.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0205 ;
    minaret:sequenceIndex 204 ;
    minaret:startTime 2110.2 ;
    minaret:text "پیغمبر تو علم چھوڑ کے جاتے ہیں اور جس نے اس علم کا حصہ پا لیا اس نے آپ کی وراثت کا حصہ پا لیا" .

minaret:Segment_HUSN_AKHL-21590_0249 a minaret:TranscriptSegment ;
    minaret:endTime 2583.8 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0250 ;
    minaret:sequenceIndex 249 ;
    minaret:startTime 2575.18 ;
    minaret:text "مَّجِیْدٌ ۟۔ اَعُوْذُ بِاللّٰهِ مِنَ الشَّیْطٰنِ الرَّجِیْمِ، بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ۔ کتاب کا نام ہے ’حسنِ اخلاق‘، عربی میں کہتے ہیں حُسْنُ الْخُلُقِ۔" .

minaret:Segment_HUSN_AKHL-21590_0260 a minaret:TranscriptSegment ;
    minaret:endTime 2701.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0261 ;
    minaret:sequenceIndex 260 ;
    minaret:startTime 2696.46 ;
    minaret:text "صلی اللہ علیہ وسلم یقول اَللّٰهُمَّ حَسَّنْتَ خَلْقِیْ فَاَحْسِنْ خُلُقِیْ" .

minaret:Segment_HUSN_AKHL-21590_0262 a minaret:TranscriptSegment ;
    minaret:endTime 2722.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0263 ;
    minaret:sequenceIndex 262 ;
    minaret:startTime 2712.56 ;
    minaret:text "اخلاق کو بھی اچھا کر دے اور یہ دعا آپ کہاں پڑھا کرتے تھے کب آئینہ دیکھتے ہوئے کیونکہ اس وقت انسان کو" .

minaret:Segment_HUSN_AKHL-21590_0278 a minaret:TranscriptSegment ;
    minaret:endTime 2889.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0279 ;
    minaret:sequenceIndex 278 ;
    minaret:startTime 2879.0 ;
    minaret:text "ایک مشہور حدیث ہے کہ خدا کی قسم کوئی شخص اس وقت تک مومن نہیں ہو سکتا جب تک کہ وہ دوسرے کے لیے وہ نہ" .

minaret:Segment_HUSN_AKHL-21590_0279 a minaret:TranscriptSegment ;
    minaret:endTime 2897.56 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0280 ;
    minaret:sequenceIndex 279 ;
    minaret:startTime 2889.0 ;
    minaret:text "چاہے جو وہ اپنے لیے چاہتا ہے تو بہترین اخلاق اور بہترین معاملہ کسی کے ساتھ بھی کیا معاملہ ہے" .

minaret:Segment_HUSN_AKHL-21591_0002 a minaret:TranscriptSegment ;
    minaret:endTime 58.3 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0003 ;
    minaret:sequenceIndex 2 ;
    minaret:startTime 39.08 ;
    minaret:text "بَارِكْ عَلٰی مُحَمَّدٍ وَّعَلٰۤی اٰلِ مُحَمَّدٍ كَمَا بَارَكْتَ عَلٰۤی اِبْرٰهِیْمَ وَعَلٰۤی اٰلِ اِبْرٰهِیْمَ اِنَّكَ حَمِیْدٌ مَّجِیْدٌ ۟۔ حسن اخلاق اچھا اخلاق" .

minaret:Segment_HUSN_AKHL-21591_0004 a minaret:TranscriptSegment ;
    minaret:endTime 99.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0005 ;
    minaret:sequenceIndex 4 ;
    minaret:startTime 79.1 ;
    minaret:text "وسلم آئینے کو دیکھ کر اپنے لئے مانگا کرتے تھے اور آپ کے طریقے میں ہمارے لئے نمونہ ہے کیا دعا ہے اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ فَحَسِّنْ خُلُقِیْ اے اللہ جس طرح تُو نے میری صورت اچھی بنائی" .

minaret:Segment_HUSN_AKHL-21591_0030 a minaret:TranscriptSegment ;
    minaret:endTime 581.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0031 ;
    minaret:sequenceIndex 30 ;
    minaret:startTime 561.5 ;
    minaret:text "اور پھر یہ کہ آپ کا معاملہ صرف بندوں کے ساتھ نہیں کائنات کی باقی چیزوں کے ساتھ بھی اچھا ہو خواہ آپ جانوروں سے معاملہ کریں خواہ آپ پودوں سے معاملہ کریں خواہ آپ زمین سے معاملہ کریں اچھے بندوں کی صفت قرآن پاک میں کیا بتائی گئی ہے وَعِبَادُ الرَّحْمٰنِ الَّذِیْنَ" .

minaret:Segment_HUSN_AKHL-21591_0032 a minaret:TranscriptSegment ;
    minaret:endTime 621.14 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0033 ;
    minaret:sequenceIndex 32 ;
    minaret:startTime 601.34 ;
    minaret:text "اکڑیں وہ پہاڑوں کی بلندی کو نہیں پہنچ سکتے لہٰذا ان کے رویے میں عاجزی اور انکساری ہوتی ہے تو اس تمہید کے بعد اب ہم کتاب شروع کرتے ہیں انشاءاللہ تاکہ پھر ان احادیث ہی کی روشنی میں ہم اپنا جائزہ لے سکیں تو پہلا" .

minaret:Segment_HUSN_AKHL-21591_0033 a minaret:TranscriptSegment ;
    minaret:endTime 636.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0034 ;
    minaret:sequenceIndex 33 ;
    minaret:startTime 621.14 ;
    minaret:text "چیپٹر ہے: حُسْنُ الْخُلُقِ، اردو میں کہتے ہیں حسنِ اخلاق، اور انگریزی میں Good Character۔" .

minaret:Segment_HUSN_AKHL-21591_0034 a minaret:TranscriptSegment ;
    minaret:endTime 655.82 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0035 ;
    minaret:sequenceIndex 34 ;
    minaret:startTime 636.12 ;
    minaret:text "قَالَ اللّٰهُ تَعَالٰی: وَاِنَّكَ لَعَلٰی خُلُقٍ عَظِیْمٍ ۟، سورۃ القلم۔ اللہ سبحانہ و تعالیٰ فرماتے ہیں: اور بے شک تم اخلاق کے بڑے مرتبے پر ہو۔ کس سے خطاب ہے رسول اللہ صلی اللہ علیہ وسلم سے کہ دنیا میں سب سے بلند اور آلہ ترین اخلاق کے مالک اللہ کی" .

minaret:Segment_HUSN_AKHL-21591_0036 a minaret:TranscriptSegment ;
    minaret:endTime 695.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0037 ;
    minaret:sequenceIndex 36 ;
    minaret:startTime 675.82 ;
    minaret:text "اس میں آپ دیکھئے کہ ایک اور آیت کا حوالہ بھی دیا گیا ہے کہ آپ کا معاملہ لوگوں کے ساتھ کیسا معاملہ تھا یا آپ کا اخلاق کس چیز پر مبنی تھا قال اللہ تعالی فَبِمَا رَحْمَةٍ مِّنَ اللّٰهِ لِنْتَ لَهُمْ ۚ وَلَوْ كُنْتَ فَظًّا غَلِیْظَ" .

minaret:Segment_HUSN_AKHL-21591_0038 a minaret:TranscriptSegment ;
    minaret:endTime 734.56 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0039 ;
    minaret:sequenceIndex 38 ;
    minaret:startTime 715.08 ;
    minaret:text "تندخو اور سنگ دل ہوتے تو یہ سب تمہارے گرد و پیش سے چھٹ جاتے سب بھاگ جاتے تو اس سے کیا پتہ چلتا ہے کہ بہترین اخلاق کی علامت کیا ہے کہ انسان کا کردار اور اس کی شخصیت ایسی ہو کہ لوگ اس کی طرف کھچتے چلے آئیں نہ کہ" .

minaret:Segment_HUSN_AKHL-21591_0061 a minaret:TranscriptSegment ;
    minaret:endTime 1158.78 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0062 ;
    minaret:sequenceIndex 61 ;
    minaret:startTime 1145.0 ;
    minaret:text "عَنْ اَبِیْ هُرَیْرَةَ اَنَّ رَسُوْلَ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ قَالَ: اِنَّمَا بُعِثْتُ لِاُتَمِّمَ صَالِحَ الْاَخْلَاقِ، رَوَاهُ الْبُخَارِیُّ فِی الْاَدَبِ الْمُفْرَدِ۔" .

minaret:Segment_HUSN_AKHL-21591_0062 a minaret:TranscriptSegment ;
    minaret:endTime 1178.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0063 ;
    minaret:sequenceIndex 62 ;
    minaret:startTime 1158.7800000000002 ;
    minaret:text "سیدنا ابو ہریرہ رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: بے شک میں اچھے اخلاق کی تکمیل کے لیے بھیجا گیا ہوں۔ یعنی آپ کی آمد کا مقصد کیا تھا کہ خوبصورت اخلاق کو مکمل کر دیا جائے اس میں سے کوئی" .

minaret:Segment_HUSN_AKHL-21591_0068 a minaret:TranscriptSegment ;
    minaret:endTime 1297.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0069 ;
    minaret:sequenceIndex 68 ;
    minaret:startTime 1277.58 ;
    minaret:text "لیکن اللہ کے رسول کی زندگی میں کچھ بھی چھٹا ہوا نہیں ہے سب مکمل ہے ابو ہریرہ رضی اللہ عنہ" .

minaret:Segment_HUSN_AKHL-21591_0094 a minaret:TranscriptSegment ;
    minaret:endTime 1764.84 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0095 ;
    minaret:sequenceIndex 94 ;
    minaret:startTime 1753.9 ;
    minaret:text "اپنے ساتھیوں سے اس طرح بات کرتا حالانکہ مجھے اس بات کی ضرورت نہیں ہوتی تاکہ وہ میری قیفیت پہچانے اسے قرآن میں آتا تَعْرِفُهُمْ بِسِيْمٰهُمْۚ لَا یَسْـَٔلُوْنَ النَّاسَ اِلْحَافًا ؕ" .

minaret:Segment_HUSN_AKHL-21591_0107 a minaret:TranscriptSegment ;
    minaret:endTime 2015.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0108 ;
    minaret:sequenceIndex 107 ;
    minaret:startTime 1995.4 ;
    minaret:text "کرتی وہ سو جاتی بیٹی کو اٹھا دیتے یعنی جہاں ایک طرف علم سے تعلق تھا وہاں دوسری طرف اللہ کی عبادت بھی ان کی زندگی کا حصہ تھی پھر اسی طرح اپنی والدہ کے ساتھ ان کا جو سلوک تھا اس میں بھی آپ دیکھیں گے کہ حسنِ اخلاق کے نمونے آپ دیکھئے ماں کے ساتھ سلوک ہم سب دیکھیں کبھی" .

minaret:Segment_HUSN_AKHL-21591_0108 a minaret:TranscriptSegment ;
    minaret:endTime 2035.24 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0109 ;
    minaret:sequenceIndex 108 ;
    minaret:startTime 2015.34 ;
    minaret:text "ہم نے اپنی ماں کے ساتھ ایسا رویہ کیا زندگی بھر ماں کے فرماں بردار اور خدمت گزار رہے جب گھر سے باہر جاتے تو ماں کے دروازے پہ آکے کھڑے ہو جاتے سلام کرتے ماں جواب دیتی فرماتے اماں جان اللہ آپ پر اسی طرح نوازشات کی برکھا برسائے اللہ آپ کے اوپر" .

minaret:Segment_HUSN_AKHL-21591_0109 a minaret:TranscriptSegment ;
    minaret:endTime 2055.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0110 ;
    minaret:sequenceIndex 109 ;
    minaret:startTime 2035.24 ;
    minaret:text "رحمتوں کی بارش کرے جس طرح آپ نے بچپن میں میری پرورش کی وہ جواب میں کہتی اللہ تم پہ اپنی رحمتیں کرے جس طرح تم بڑھاپے میں میری خدمت کر رہے ہو اور پھر اس کے بعد وہ گھر سے نکلتے یہ ان کا روزانہ کا معمول تھا ہم میں سے کتنے لوگ اپنے ماں باپ کے قدردان ہیں اور ان کو" .

minaret:Segment_HUSN_AKHL-21591_0110 a minaret:TranscriptSegment ;
    minaret:endTime 2073.88 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0111 ;
    minaret:sequenceIndex 110 ;
    minaret:startTime 2055.22 ;
    minaret:text "کبھی منہ بھر کے منہ سے بول کے یا لکھ کے یا کسی بھی طرح یہ کہنے کی جرات کریں کہ اللہ آپ پر رحمتیں کرے کہ آپ نے میری پرورش کی اور میری تعلیم و تربیت کی تو اچھا اخلاق کیا ہے سب سے پہلے شکر گزار ہونا کس کا شکر گزار ہونا" .

minaret:Segment_HUSN_AKHL-21591_0113 a minaret:TranscriptSegment ;
    minaret:endTime 2133.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0114 ;
    minaret:sequenceIndex 113 ;
    minaret:startTime 2114.06 ;
    minaret:text "پریشان ہیں لیکن اس کے باوجود ان کی خدمت اور ان کے ساتھ شکر گزاری کے جو الفاظ ہیں وہ آپ کا معمول ہے سلام اور اس کے ساتھ شکر گزاری اور پھر گھر سے نکلنا اور یہی تلقین وہ دوسروں کو بھی کرتے تھے ایک روز کہیں جا رہے تھے تو راستے میں آپ نے" .

minaret:Segment_HUSN_AKHL-21591_0114 a minaret:TranscriptSegment ;
    minaret:endTime 2153.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0115 ;
    minaret:sequenceIndex 114 ;
    minaret:startTime 2133.96 ;
    minaret:text "دیکھا کہ دو لوگ جا رہے ہیں تو ایک سے پوچھا کہ یہ دوسرے کون ہیں کہا کہ یہ میرے والد ہے کہنے لگے کہ کبھی ان کا نام نہیں بلانا کبھی ان کے آگے نہیں چلنا کبھی ان سے پہلے نہیں بیٹھنا یہ ہیں مینرز ماں باپ کے ساتھ باپ ہیں نام سے نہیں بلانا اور کیا نہیں کرنا" .

minaret:Segment_HUSN_AKHL-21591_0115 a minaret:TranscriptSegment ;
    minaret:endTime 2174.04 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0116 ;
    minaret:sequenceIndex 115 ;
    minaret:startTime 2154.22 ;
    minaret:text "ان سے پہلے نہیں بیٹھنا وہ بیٹھیں تو بیٹھنا یہی اسلام کے اخلاق اور آداب یہی ہیں بچپن میں یہی ہمیں سکھایا گیا ہے لیکن خاص طور پر مغربی معاشرے میں ہمارے بچے جہاں پل بڑھ رہے ہیں یا جو کچھ پڑھ سیکھ رہے ہیں وہاں یہ اخلاق اور مینرز آزادی کے نام پر اور تعلیم کے" .

minaret:Segment_HUSN_AKHL-21591_0116 a minaret:TranscriptSegment ;
    minaret:endTime 2193.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0117 ;
    minaret:sequenceIndex 116 ;
    minaret:startTime 2174.04 ;
    minaret:text "نام پر سب ختم ہو گئے ہیں اور پھر آپ دیکھیں کہ جب مرض الموت یعنی وفات ہوئی تو اس وقت رو رہے تھے زار و قطار رو رہے تھے پوچھا گیا آپ کیوں رو رہے ہیں کہنے لگے میں تمہاری اس دنیا پر آنسو نہیں بہاتا کہ میں دنیا چھوڑ کے جا رہا ہوں اور اتنا کچھ ہے میرے پاس اور اتنے عہدے اور سب" .

minaret:Segment_HUSN_AKHL-21591_0126 a minaret:TranscriptSegment ;
    minaret:endTime 2377.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0127 ;
    minaret:sequenceIndex 126 ;
    minaret:startTime 2358.84 ;
    minaret:text "خوبصورتی سے ہوتی ہے۔ عَنْ اَبِی الدَّرْدَآءِ قَالَ سَمِعْتُ رَسُوْلَ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ یَقُوْلُ: مَا مِنْ شَیْءٍ یُّوْضَعُ فِی الْمِیْزَانِ اَثْقَلُ مِنْ حُسْنِ الْخُلُقِ، وَاِنَّ صَاحِبَ حُسْنِ الْخُلُقِ لَیَبْلُغُ بِهٖ" .

minaret:Segment_HUSN_AKHL-21591_0127 a minaret:TranscriptSegment ;
    minaret:endTime 2388.94 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0128 ;
    minaret:sequenceIndex 127 ;
    minaret:startTime 2377.92 ;
    minaret:text "دَرَجَةَ صَاحِبِ الصَّوْمِ وَالصَّلٰوةِ، رَوَاهُ التِّرْمِذِیُّ كِتَابُ الْبِرِّ وَالصِّلَةِ۔ عَنْ اَبِی الدَّرْدَآءِ رَضِیَ" .

minaret:Segment_HUSN_AKHL-21591_0131 a minaret:TranscriptSegment ;
    minaret:endTime 2466.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0132 ;
    minaret:sequenceIndex 131 ;
    minaret:startTime 2447.32 ;
    minaret:text "کہاں؟ دَرَجَةَ درجے کو، کس کے؟ صَاحِبِ الصَّوْمِ وَالصَّلٰوةِ روزے اور نماز والے کے۔ یعنی ایک شخص جو ساری رات نماز پڑھے اور ہر روز روزہ رکھے، تو جتنا ثواب وہ پا سکتا ہے اتنا ثواب کس کو مل جاتا ہے اچھے اخلاق والے کو" .

minaret:Segment_HUSN_AKHL-21591_0132 a minaret:TranscriptSegment ;
    minaret:endTime 2486.98 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0133 ;
    minaret:sequenceIndex 132 ;
    minaret:startTime 2466.98 ;
    minaret:text "اگرچہ وہ ساری رات نماز نہ بھی پڑھ سکے اور ہر روز روزہ نہ بھی رکھ سکے تو سیدنا ابو درداء رضی اللہ عنہ کی روایت ہے کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے ہوئے بھی سنا، یعنی یہ انہوں نے براہِ راست آپ سے سنی تھی بات، کہ میزان میں، اور میزان سے مراد کیا ہے؟ قیامت کے دن انسان کا نامہ اعمال" .

minaret:Segment_HUSN_AKHL-21591_0133 a minaret:TranscriptSegment ;
    minaret:endTime 2506.56 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0134 ;
    minaret:sequenceIndex 133 ;
    minaret:startTime 2486.98 ;
    minaret:text "جہاں تولا جائے گا اس میں جو نیکی سب سے زیادہ وزنی ہوگی وہ حسنِ اخلاق ہوگا یعنی باقی چیزوں کا بھی وزن ہے لیکن سب سے بھاری باٹ اور سب سے بھاری تول جو بظاہر دیکھنے میں چھوٹا سا بھی ہو لیکن جوں ہی وہ رکھا جائے گا تو میزان جھک جائے" .

minaret:Segment_HUSN_AKHL-21591_0139 a minaret:TranscriptSegment ;
    minaret:endTime 2624.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0140 ;
    minaret:sequenceIndex 139 ;
    minaret:startTime 2605.0 ;
    minaret:text "کی روایت ہے: قَالُوْا: یَا رَسُوْلَ اللّٰهِ! مَا خَیْرُ مَاۤ اُعْطِیَ النَّاسُ؟ وہ کون سی بھلائی ہے جو سب سے زیادہ بہتر ہے جو لوگوں کو دی گئی؟ یعنی لوگوں کو سب سے اچھی چیز کیا ملی ہے؟ یعنی انسان کو کیا کچھ ملتا ہے؟ ایک انسان کے پاس مال، دولت، اولاد، گھر بار، کاروبار، علم" .

minaret:Segment_HUSN_AKHL-21591_0140 a minaret:TranscriptSegment ;
    minaret:endTime 2644.48 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0141 ;
    minaret:sequenceIndex 140 ;
    minaret:startTime 2624.64 ;
    minaret:text "ڈگریاں، معلوم نہیں کیا کیا چیزیں انسان نے اکٹھی کی ہوتی ہیں۔ لیکن ان سب کے اندر سے سب سے بہترین چیز کیا ہے جو انسان کو مل جاتی ہے؟ تو آپ نے فرمایا: اِنَّ النَّاسَ لَمْ یُعْطَوْا شَیْئًا خَیْرًا مِّنْ خُلُقٍ حَسَنٍ، کہ انسانوں کو اچھے اخلاق سے بڑھ کر کوئی بھی" .

minaret:Segment_HUSN_AKHL-21591_0141 a minaret:TranscriptSegment ;
    minaret:endTime 2664.28 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0142 ;
    minaret:sequenceIndex 141 ;
    minaret:startTime 2644.48 ;
    minaret:text "چیز اچھی نہیں ملی۔ یعنی سب سے زیادہ بہترین چیز اگر کسی کو ملی ہے تو وہ کیا ہے؟ اچھا اخلاق۔ یعنی منافق کو اچھا اخلاق نہیں ملتا، اور مومن کو ملنے والی چیزوں میں سب سے بہترین چیز اچھا اخلاق ہے۔ تو گویا خوش قسمت ہے وہ شخص جس کی" .

minaret:Segment_HUSN_AKHL-21591_0180 a minaret:TranscriptSegment ;
    minaret:endTime 3436.98 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0181 ;
    minaret:sequenceIndex 180 ;
    minaret:startTime 3417.2 ;
    minaret:text "سب کو وہ ڈرا کے رکھ دیتا اور سب چپ ہو جاتے۔ لیکن انہوں نے ایسا کوئی ہتھیار اختیار نہیں کیا، بلکہ کیا کہا گیا تھا؟ فَقُلْ هَلْ لَكَ إِلَى أَنْ تَزَكَّى ۟ۙ، سوالیہ انداز تھا۔ کیا آپ چاہتے ہیں کہ میں آپ کو ایسی بات بتاؤں جس سے آپ کا تزکیہ ہو؟ کیا آپ تزکیہ اختیار کرنا چاہیں گے؟ یہ ہے" .

minaret:Segment_HUSN_AKHL-21591_0181 a minaret:TranscriptSegment ;
    minaret:endTime 3456.26 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0182 ;
    minaret:sequenceIndex 181 ;
    minaret:startTime 3436.98 ;
    minaret:text "اس حکم پر عمل کا طریقہ۔ ایک ہے کسی سے کام کرانا دھونس جما کے، دوسرا یہ ہے روکھے پھیکے انداز سے، اور تیسرا یہ ہے کہ ایک اچھے انداز سے۔ تو جب آپ کسی سے معاملہ کرتے ہیں تو آپ اپنے گفتگو میں دیکھئے کہ" .

minaret:Segment_HUSN_AKHL-21591_0182 a minaret:TranscriptSegment ;
    minaret:endTime 3476.26 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0183 ;
    minaret:sequenceIndex 182 ;
    minaret:startTime 3456.26 ;
    minaret:text "کسی کو کوئی بات کہتے ہیں تو کیا کہتے ہیں، کس طرح کہتے ہیں۔ دوسرا یہ ہے کہ جب کوئی آپ کے ساتھ برا کرتا ہے، کیونکہ جب کوئی ہمارے ساتھ اچھا کرتا ہے تو ہم جواب میں کیا کرتے ہیں؟ اچھا کر دیتے ہیں۔ نہیں کرتا تو ہم بھی ویسے ہی ہو جاتے ہیں۔ تو آپ صلی اللہ علیہ وسلم نے فرمایا کہ تم لوگوں" .

minaret:Segment_HUSN_AKHL-21592_0002 a minaret:TranscriptSegment ;
    minaret:endTime 58.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0003 ;
    minaret:sequenceIndex 2 ;
    minaret:startTime 39.12 ;
    minaret:text "مُحَمَّدٍ وَّعَلٰی اٰلِ مُحَمَّدٍ كَمَا بَارَكْتَ عَلٰی اِبْرَاهِیْمَ وَعَلٰی اٰلِ اِبْرَاهِیْمَ اِنَّكَ حَمِیْدٌ مَّجِیْدٌ۔ حسن اخلاق کی دعا مانگیے جو آئینہ دیکھتے ہوئے پڑھتے ہیں، ایک" .

minaret:Segment_HUSN_AKHL-21592_0004 a minaret:TranscriptSegment ;
    minaret:endTime 98.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0005 ;
    minaret:sequenceIndex 4 ;
    minaret:startTime 78.26 ;
    minaret:text "صرف ظاہری شکل نہیں بلکہ اپنی حقیقی شکل سنوارنے کے لیے بھی دعا کریں گے۔ تو چلیے پڑھیے: اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ، اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ فَحَسِّنْ خُلُقِیْ۔ اہم ترین چیز" .

minaret:Segment_HUSN_AKHL-21592_0006 a minaret:TranscriptSegment ;
    minaret:endTime 138.02 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0007 ;
    minaret:sequenceIndex 6 ;
    minaret:startTime 118.08 ;
    minaret:text "لگانی ہے کیونکہ قلم کے استعمال کے بغیر نہ علم بڑھ سکتا ہے اور نہ ہی عمل۔ چلیے پڑھیے: اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ، اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ فَحَسِّنْ خُلُقِیْ، فَحَسِّنْ خُلُقِیْ۔ ترجمہ" .

minaret:Segment_HUSN_AKHL-21592_0007 a minaret:TranscriptSegment ;
    minaret:endTime 157.7 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0008 ;
    minaret:sequenceIndex 7 ;
    minaret:startTime 138.02 ;
    minaret:text "بھی دوبارہ دہرا دیتی ہوں۔ اَللّٰهُمَّ، اے اللہ! كَمَا، جیسا کہ، حَسَّنْتَ، تُو نے اچھا بنایا خوبصورت بنایا، خَلْقِیْ، میری خلق کو میری صورت کو میری شکل کو، فَحَسِّنْ، تُو اچھا بنا دے" .

minaret:Segment_HUSN_AKHL-21592_0009 a minaret:TranscriptSegment ;
    minaret:endTime 184.1 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 177.4 ;
    minaret:text "كَمَا حَسَّنْتَ خَلْقِیْ، اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ فَحَسِّنْ خُلُقِیْ۔" .

minaret:Segment_HUSN_AKHL-21592_0010 a minaret:TranscriptSegment ;
    minaret:endTime 196.76 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 184.1 ;
    minaret:text "اب پوری روح سے دعا مانگیں، سوچ سمجھ کے، صرف الفاظ پہ نہیں معنی پہ توجہ رکھتے ہوئے، اپنی شکل یاد کرتے ہوئے اور پھر اپنی عادتیں۔ اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ، اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ" .

minaret:Segment_HUSN_AKHL-21592_0011 a minaret:TranscriptSegment ;
    minaret:endTime 216.72 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0012 ;
    minaret:sequenceIndex 11 ;
    minaret:startTime 196.76 ;
    minaret:text "فَحَسِّنْ خُلُقِیْ، اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ فَحَسِّنْ خُلُقِیْ۔ آج کا ہمارا ٹاپک ہے، یہ چیپٹر ہے نرمی کے بارے میں۔ اچھے اخلاق اچھی عادات کا نام ہے، اچھے مزاج کا نام ہے،" .

minaret:Segment_HUSN_AKHL-21592_0016 a minaret:TranscriptSegment ;
    minaret:endTime 315.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0017 ;
    minaret:sequenceIndex 16 ;
    minaret:startTime 296.08 ;
    minaret:text "میں کہتے ہیں کہنی کو، کہنی۔ اور کہنی کس لیے استعمال کی جاتی ہے؟ ٹیک لگانے کے لیے جس سے سہارا لیا جاتا ہے۔ اور اسی طرح مرتفق کا لفظ آپ پڑھ چکے ہیں قرآن پاک میں: وَسَآءَتْ مُرْتَفَقًا، وَحَسُنَتْ" .

minaret:Segment_HUSN_AKHL-21592_0017 a minaret:TranscriptSegment ;
    minaret:endTime 335.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0018 ;
    minaret:sequenceIndex 17 ;
    minaret:startTime 315.5 ;
    minaret:text "مُرْتَفَقًا، سہولت کا سامان، سہولت کی جگہ۔ اور مِرْفَقَہ کہتے ہیں اس چھوٹے تکیے کو جو سوتے وقت منہ کے نیچے رکھا جاتا ہے، گال کے نیچے رکھا جاتا ہے۔ یعنی گال کے نیچے کیسی چیز رکھیں گے جو بہت سافٹ ہو، نرم ہو۔ اب اصلاً کسی اینٹ پہ آپ" .

minaret:Segment_HUSN_AKHL-21592_0071 a minaret:TranscriptSegment ;
    minaret:endTime 1385.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0072 ;
    minaret:sequenceIndex 71 ;
    minaret:startTime 1365.8 ;
    minaret:text "کس وجہ سے؟ نرمی کی وجہ سے۔ اسی لیے ہم دیکھتے ہیں کہ آپ صلی اللہ علیہ وسلم کے بارے میں اللہ تعالیٰ فرماتے ہیں: فَبِمَا رَحْمَةٍ مِّنَ اللّٰهِ لِنْتَ لَهُمْ ۚ وَلَوْ كُنْتَ فَظًّا غَلِیْظَ الْقَلْبِ لَانْفَضُّوْا مِنْ حَوْلِكَ۔ کہ اگر آپ سخت ہوتے، بد خلق" .

minaret:Segment_HUSN_AKHL-21592_0072 a minaret:TranscriptSegment ;
    minaret:endTime 1404.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0073 ;
    minaret:sequenceIndex 72 ;
    minaret:startTime 1385.52 ;
    minaret:text "ہوتے، سخت مزاج ہوتے تو یہ سب آپ سے بھاگ جاتے۔ تو یہ اللہ کی خاص رحمت ہے آپ پر کہ آپ لوگوں کے لیے نرم واقع ہوئے ہیں۔ آپ کی نرمی کی وجہ سے آپ کے دشمنوں کے بھی ضمیر جاگے، انا نہیں جاگی، ضمیر جاگے۔ جب ضمیر اور کانشس جاگ گئے ان کے تو پھر پیغام ڈالنا،" .

minaret:Segment_HUSN_AKHL-21592_0085 a minaret:TranscriptSegment ;
    minaret:endTime 1661.78 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0086 ;
    minaret:sequenceIndex 85 ;
    minaret:startTime 1641.98 ;
    minaret:text "آپ پر ایمان لا رہے ہیں، ظاہر ہے کہ آپ پیغمبر ہیں، آپ کا مقام اور مرتبہ بڑا ہے اور باقی سب آپ کے فالوورز ہیں، اپنے فالوورز کے ساتھ، گویا اپنے سے چھوٹوں کے ساتھ کیا کریں؟ ان کے سامنے اپنے کندھے جھکا کے رکھیں۔ بڑوں کے سامنے تو" .

minaret:Segment_HUSN_AKHL-21592_0086 a minaret:TranscriptSegment ;
    minaret:endTime 1681.74 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0087 ;
    minaret:sequenceIndex 86 ;
    minaret:startTime 1661.78 ;
    minaret:text "مجبوراً بھی جھکانے پڑتے ہیں، یعنی اگر آپ کے سامنے کوئی بڑا ہے تو آپ کو جھکنا پڑے گا۔ لیکن یہاں کس کے آگے جھکنے کو کہا جا رہا ہے؟ کیا سمجھ میں آتی ہے بات؟ دنیا کا سب سے بڑا انسان ہے محمد صلی اللہ علیہ وسلم، آپ سے کہا جا" .

minaret:Segment_HUSN_AKHL-21592_0087 a minaret:TranscriptSegment ;
    minaret:endTime 1701.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0088 ;
    minaret:sequenceIndex 87 ;
    minaret:startTime 1681.74 ;
    minaret:text "رہا ہے، یعنی آپ کے مرتبے اور مقام سے بڑا کسی کا مقام نہیں ہے انسانوں میں سے، ان سے کہا جا رہا ہے کہ آپ اپنے سے چھوٹوں کے ساتھ کیسے پیش آئیں؟ کندھے جھکا کے رکھیں۔ جناح کس کو کہتے ہیں؟ کندھا، بازو، ونگ، پر، اپنے پر" .

minaret:Segment_HUSN_AKHL-21592_0088 a minaret:TranscriptSegment ;
    minaret:endTime 1721.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0089 ;
    minaret:sequenceIndex 88 ;
    minaret:startTime 1701.32 ;
    minaret:text "جھکا دیں کس کے لیے؟ اپنے پیروکاروں کے لیے، اپنے ساتھیوں کے لیے۔ کیا سبق ہے ہم سب کے لیے! ہم میں سے جو جس بھی بڑائی کے مقام پر ہے خواہ ماں ہیں یا بڑی بہن ہیں یا استاد ہے یا کوئی لیڈر ہے یا واٹ ایور" .

minaret:Segment_HUSN_AKHL-21592_0089 a minaret:TranscriptSegment ;
    minaret:endTime 1740.94 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0090 ;
    minaret:sequenceIndex 89 ;
    minaret:startTime 1721.0 ;
    minaret:text "کچھ بھی، کیا اس کے لیے نمونہ ہے محمد صلی اللہ علیہ وسلم کی زندگی میں! کیا کریں؟ اکڑنے والے تو یہ نہیں کر سکتے، پھر ہم کس سنت کی پیروی کے دعوے کرتے ہیں؟ ہم گردن اکڑا کے کیوں رکھتے ہیں کہ اگر ہم نے نیچے کر دی تو کیا ہوگا؟ اندر کی آواز" .

minaret:Segment_HUSN_AKHL-21592_0090 a minaret:TranscriptSegment ;
    minaret:endTime 1755.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0091 ;
    minaret:sequenceIndex 90 ;
    minaret:startTime 1740.94 ;
    minaret:text "کہتی ہے: چھوٹے ہو جاؤ گے۔ شیطان کیا وسوسہ ڈالتا ہے: لوگوں کے لیے تر نوالہ بن جاؤ گے۔ اب یہاں تو تمہیں حق ہے نا کہ تم بڑے بن کے دکھاؤ۔ بڑا بننا صرف اکڑنا نہیں ہے، بڑے بننے کے لیے اور بہت سی چیزیں" .

minaret:Segment_HUSN_AKHL-21592_0091 a minaret:TranscriptSegment ;
    minaret:endTime 1760.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0092 ;
    minaret:sequenceIndex 91 ;
    minaret:startTime 1755.38 ;
    minaret:text "وَاخْفِضْ جَنَاحَكَ لِمَنِ اتَّبَعَكَ مِنَ الْمُؤْمِنِیْنَ۔" .

minaret:Segment_HUSN_AKHL-21592_0093 a minaret:TranscriptSegment ;
    minaret:endTime 1799.98 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0094 ;
    minaret:sequenceIndex 93 ;
    minaret:startTime 1780.1 ;
    minaret:text "اَذِلَّةٍ عَلَی الْمُؤْمِنِیْنَ اَعِزَّةٍ عَلَی الْكٰفِرِیْنَ۔ اللہ تعالیٰ کا ارشاد ہے جو مومنوں پر نرم اور کفار پر سخت ہوں گے۔ یہ صحابہ کرام کی خصوصیت قرآن پاک میں بتائی گئی ہے۔ تو گویا اوپر والوں کے مقابلے میں بھی نرم، نیچے" .

minaret:Segment_HUSN_AKHL-21592_0095 a minaret:TranscriptSegment ;
    minaret:endTime 1839.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0096 ;
    minaret:sequenceIndex 95 ;
    minaret:startTime 1819.66 ;
    minaret:text "اور ساتھیوں کے لیے، ساتھ برابر والوں کے لیے صحابہ کرام کی مثال دی گئی کہ آپس میں ایک دوسرے کے لیے نرم ہیں۔ عَنْ عَائِشَةَ اَنَّهَا قَالَتْ قَالَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ: اِذَا اَرَادَ اللّٰهُ عَزَّ وَجَلَّ بِاَهْلِ" .

minaret:Segment_HUSN_AKHL-21592_0098 a minaret:TranscriptSegment ;
    minaret:endTime 1899.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0099 ;
    minaret:sequenceIndex 98 ;
    minaret:startTime 1879.42 ;
    minaret:text "داخل کر دیتا ہے، عَلَیْهِمُ، ان پر، اَلرِّفْقَ، نرمی۔ سیدہ عائشہ رضی اللہ عنہا سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جب اللہ تعالیٰ کسی خاندان کے لیے بھلائی چاہتے ہیں تو ان میں نرمی ڈال دیتے ہیں۔ یعنی اس گھرانے" .

minaret:Segment_HUSN_AKHL-21592_0140 a minaret:TranscriptSegment ;
    minaret:endTime 2689.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0141 ;
    minaret:sequenceIndex 140 ;
    minaret:startTime 2673.26 ;
    minaret:text "عَنْ اَبِی الدَّرْدَاءِ عَنِ النَّبِیِّ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ قَالَ: مَنْ اُعْطِیَ حَظَّهٗ مِنَ الرِّفْقِ فَقَدْ اُعْطِیَ حَظَّهٗ مِنَ الْخَیْرِ، وَمَنْ حُرِمَ حَظَّهٗ مِنَ الرِّفْقِ فَقَدْ حُرِمَ حَظَّهٗ مِنَ الْخَیْرِ۔" .

minaret:Segment_HUSN_AKHL-21592_0141 a minaret:TranscriptSegment ;
    minaret:endTime 2709.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0142 ;
    minaret:sequenceIndex 141 ;
    minaret:startTime 2689.68 ;
    minaret:text "رَوَاهُ التِّرْمِذِیُّ، عَنْ اَبِی الدَّرْدَاءِ، ابو الدرداء رضی اللہ عنہ سے روایت ہے، اَنَّ النَّبِیَّ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ قَالَ: نبی صلی اللہ علیہ وسلم نے فرمایا: مَنْ، جو کوئی، اُعْطِیَ، دیا گیا، حَظَّهٗ، اپنا حصہ، مِنَ الرِّفْقِ، نرمی میں سے،" .

minaret:Segment_HUSN_AKHL-21592_0142 a minaret:TranscriptSegment ;
    minaret:endTime 2729.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0143 ;
    minaret:sequenceIndex 142 ;
    minaret:startTime 2709.16 ;
    minaret:text "فَقَدْ، پس تحقیق، اُعْطِیَ، دیا گیا، حَظَّهٗ، اپنا حصہ، مِنَ الْخَیْرِ، خیر میں سے، وَمَنْ حُرِمَ، اور جو محروم کیا گیا، حَظَّهٗ، اپنے حصے سے، مِنَ الرِّفْقِ، نرمی سے، فَقَدْ حُرِمَ، پس تحقیق" .

minaret:Segment_HUSN_AKHL-21592_0144 a minaret:TranscriptSegment ;
    minaret:endTime 2769.04 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0145 ;
    minaret:sequenceIndex 144 ;
    minaret:startTime 2749.12 ;
    minaret:text "خیر میں سے حصہ ملا اور جو کوئی نرمی کے حصے سے محروم رہا وہ خیر سے محروم رہا۔ جیسے پہلے بھی میں نے عرض کیا کہ جب انسان دوسروں کے ساتھ نرمی کا معاملہ کرتا ہے تو وہ اپنے اردگرد پھول اگاتا ہے اور اگر انسان لوگوں کے ساتھ سختی کا رویہ اختیار کرتا ہے تو وہ اپنے" .

minaret:Segment_HUSN_AKHL-21592_0146 a minaret:TranscriptSegment ;
    minaret:endTime 2808.74 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0147 ;
    minaret:sequenceIndex 146 ;
    minaret:startTime 2789.0 ;
    minaret:text "اللہ علیہ وسلم نے فرمایا: مَنْ یُّحْرَمِ الرِّفْقَ یُحْرَمِ الْخَیْرَ، جو محروم کر دیا گیا نرمی سے، وہ محروم کر دیا گیا خیر سے، بھلائی سے۔ تو اس سے کیا پتا چلتا ہے کہ جو شخص نرمی سے محروم رہا وہ خیر سے محروم رہا۔ یعنی دنیا میں بعض" .

minaret:Segment_HUSN_AKHL-21592_0149 a minaret:TranscriptSegment ;
    minaret:endTime 2868.42 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0150 ;
    minaret:sequenceIndex 149 ;
    minaret:startTime 2848.46 ;
    minaret:text "تعالیٰ نے تدبیر کے لیے رکھا ہے، بندوں کو آزادی دی ہے اور ان کے عمل اس میں اثر رکھتے ہیں۔ اور کہتے ہیں نا کہ: وَكُلَّ اِنْسَانٍ اَلْزَمْنٰهُ طٰٓىِٕرَهٗ فِیْ عُنُقِهٖ، ہر انسان کا شگون اس کی گردن میں لٹک رہا ہے۔ کیا مطلب؟" .

minaret:Segment_HUSN_AKHL-21592_0160 a minaret:TranscriptSegment ;
    minaret:endTime 3086.7 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0161 ;
    minaret:sequenceIndex 160 ;
    minaret:startTime 3066.7 ;
    minaret:text "جب کسی کے ساتھ بات کرتے ہیں تو کیا طریقہ اختیار کرتے ہیں۔ عَنْ عَائِشَةَ رَضِیَ اللّٰهُ عَنْهَا اَنَّ الْیَهُوْدَ اَتَوُا النَّبِیَّ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ فَقَالُوْا: اَلسَّامُ عَلَیْكَ، قَالَ: وَعَلَیْكُمْ، فَقَالَتْ عَائِشَةُ: اَلسَّامُ عَلَیْكُمْ وَلَعَنَكُمُ اللّٰهُ وَغَضِبَ عَلَیْكُمْ، فَقَالَ رَسُوْلُ" .

minaret:Segment_HUSN_AKHL-21592_0161 a minaret:TranscriptSegment ;
    minaret:endTime 3105.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0162 ;
    minaret:sequenceIndex 161 ;
    minaret:startTime 3086.7 ;
    minaret:text "اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ: مَهْلًا یَا عَائِشَةُ، عَلَیْكِ بِالرِّفْقِ وَاِیَّاكِ وَالْعُنْفَ وَالْفَحْشَ، قَالَتْ: اَوَلَمْ تَسْمَعْ مَا قَالُوْا؟ قَالَ: اَوَلَمْ تَسْمَعِیْ مَا قُلْتُ؟ رَدَدْتُ عَلَیْهِمْ فَیُسْتَجَابُ لِیْ فِیْهِمْ وَلَا یُسْتَجَابُ لَهُمْ فِیَّ۔ رَوَاهُ الْبُخَارِیُّ۔" .

minaret:Segment_HUSN_AKHL-21592_0169 a minaret:TranscriptSegment ;
    minaret:endTime 3264.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0170 ;
    minaret:sequenceIndex 169 ;
    minaret:startTime 3244.18 ;
    minaret:text "یعنی جو کسی کے لیے برا کرتا ہے دراصل اپنے لیے کر رہا ہوتا ہے۔ تو اسے بخاری نے روایت کیا۔ سیدہ عائشہ رضی اللہ عنہا سے روایت ہے کہ یہود نبی کریم صلی اللہ علیہ وسلم کی خدمت میں حاضر ہوئے اور کہا: السام علیک۔ نبی کریم صلی اللہ علیہ وسلم نے فرمایا: وعلیکم۔ لیکن سیدہ عائشہ رضی اللہ عنہا نے کہا:" .

minaret:Segment_HUSN_AKHL-21592_0170 a minaret:TranscriptSegment ;
    minaret:endTime 3283.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0171 ;
    minaret:sequenceIndex 170 ;
    minaret:startTime 3264.0 ;
    minaret:text "السام علیکم ولعنکم اللہ وغضب علیکم۔ تو رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ٹھہرو عائشہ! نرم خوئی اختیار کرو اور سختی اور بدکلامی سے ہمیشہ پرہیز کرو۔ انہوں نے کہا کہ آپ نے نہیں سنا کہ یہود کیا کہہ رہے تھے؟ نبی کریم صلی اللہ علیہ وسلم نے فرمایا: تم نے نہیں سنا کہ میں نے انہیں کیا" .

minaret:Segment_HUSN_AKHL-21592_0173 a minaret:TranscriptSegment ;
    minaret:endTime 3342.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0174 ;
    minaret:sequenceIndex 173 ;
    minaret:startTime 3323.0 ;
    minaret:text "جاتی کسی چیز سے، اِلَّا شَانَهٗ، مگر اس کو بدنما بنا دیتی ہے عیب دار کر دیتی ہے۔ رَوَاهُ مُسْلِمٌ، كِتَابُ الْبِرِّ وَالصِّلَةِ۔ سیدہ عائشہ رضی اللہ عنہا نبی کریم صلی اللہ علیہ وسلم کی زوجہ سے روایت ہے کہ نبی کریم صلی اللہ علیہ وسلم نے فرمایا: جس چیز میں" .

minaret:Segment_HUSN_AKHL-21592_0176 a minaret:TranscriptSegment ;
    minaret:endTime 3402.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0177 ;
    minaret:sequenceIndex 176 ;
    minaret:startTime 3382.72 ;
    minaret:text "اللہ علیہ وسلم نے فرمایا: اَلَاۤ اُخْبِرُكُمْ، کیا میں نہ خبر دوں تم کو، بِمَنْ، اس کے بارے میں جو، یَّحْرُمُ، حرام ہے، عَلَی النَّارِ، آگ پر، وَبِمَنْ، اور ساتھ اس کے جو، تَحْرُمُ، حرام ہے، عَلَیْهِ" .

minaret:Segment_HUSN_AKHL-21592_0178 a minaret:TranscriptSegment ;
    minaret:endTime 3442.52 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0179 ;
    minaret:sequenceIndex 178 ;
    minaret:startTime 3422.62 ;
    minaret:text "کی خبر نہ دوں جو جہنم کی آگ پر یا جہنم کی آگ ان پر حرام ہے؟ یہ ہر اس شخص پر حرام ہے جو لوگوں کے قریب رہنے والا، نرمی کرنے والا، آسانی کرنے والا ہے۔ گویا دنیا کے فائدے تو نرمی سے ملتے ہی ہیں، آخرت کا بہت بڑا فائدہ نرمی سے جو" .

minaret:Segment_HUSN_AKHL-21593_0001 a minaret:TranscriptSegment ;
    minaret:endTime 22.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0002 ;
    minaret:sequenceIndex 1 ;
    minaret:startTime 2.98 ;
    minaret:text "نَحْمَدُهٗ وَنُصَلِّيْ عَلٰی رَسُوْلِہِ الْکَرِیْمِ، اَمَّا بَعْدُ! فَاَعُوْذُ بِاللّٰهِ مِنَ الشَّیْطٰنِ الرَّجِیْمِ، بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ۔ رَبِّ اشْرَحْ لِي صَدْرِي وَيَسِّرْ لِي أَمْرِي وَاحْلُلْ عُقْدَةً مِّن لِّسَانِي يَفْقَهُوا قَوْلِي۔ ایک دفعہ درود شریف پڑھ لیجیے۔" .

minaret:Segment_HUSN_AKHL-21593_0002 a minaret:TranscriptSegment ;
    minaret:endTime 44.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0003 ;
    minaret:sequenceIndex 2 ;
    minaret:startTime 22.0 ;
    minaret:text "اَللّٰھُمَّ صَلِّ عَلٰی مُحَمَّدٍ وَّعَلٰٓی اٰلِ مُحَمَّدٍ کَمَا صَلَّیْتَ عَلٰٓی اِبْرٰھِیْمَ وَعَلٰٓی اٰلِ اِبْرٰھِیْمَ اِنَّکَ حَمِیْدٌ مَّجِیْدٌ۔ اَللّٰھُمَّ بَارِکْ عَلٰی مُحَمَّدٍ وَّعَلٰٓی اٰلِ مُحَمَّدٍ کَمَا بَارَکْتَ عَلٰٓی اِبْرٰھِیْمَ وَعَلٰٓی اٰلِ اِبْرٰھِیْمَ اِنَّکَ حَمِیْدٌ مَّجِیْدٌ۔" .

minaret:Segment_HUSN_AKHL-21593_0003 a minaret:TranscriptSegment ;
    minaret:endTime 55.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0004 ;
    minaret:sequenceIndex 3 ;
    minaret:startTime 44.0 ;
    minaret:text "دعا پڑھیے: اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِيْ فَحَسِّنْ خُلُقِيْ۔ اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِيْ فَحَسِّنْ خُلُقِيْ۔" .

minaret:Segment_HUSN_AKHL-21593_0004 a minaret:TranscriptSegment ;
    minaret:endTime 75.6 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0005 ;
    minaret:sequenceIndex 4 ;
    minaret:startTime 55.86 ;
    minaret:text "اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ فَحَسِّنْ خُلُقِیْ۔ یاد رکھیے کہ کسی بھی کام کے کرنے کے لیے ارادہ بہت ضروری ہے، اور پختہ ارادہ" .

minaret:Segment_HUSN_AKHL-21593_0008 a minaret:TranscriptSegment ;
    minaret:endTime 149.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 134.32 ;
    minaret:text "کو؟ وَاهْدِنِیْ لِاَحْسَنِ الْاَخْلَاقِ، وَاهْدِنِیْ لِاَحْسَنِ الْاَخْلَاقِ، لَا یَهْدِیْ لِاَحْسَنِهَا" .

minaret:Segment_HUSN_AKHL-21593_0009 a minaret:TranscriptSegment ;
    minaret:endTime 154.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0010 ;
    minaret:sequenceIndex 9 ;
    minaret:startTime 149.32 ;
    minaret:text "لَا یَهْدِیْ لِاَحْسَنِهَا اِلَّاۤ اَنْتَ۔" .

minaret:Segment_HUSN_AKHL-21593_0010 a minaret:TranscriptSegment ;
    minaret:endTime 172.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0011 ;
    minaret:sequenceIndex 10 ;
    minaret:startTime 154.32 ;
    minaret:text "لَا یَهْدِیْ لِاَحْسَنِهَا، لَا یَهْدِیْ لِاَحْسَنِهَا اِلَّاۤ اَنْتَ، وَاصْرِفْ عَنِّیْ سَیِّئَ..." .

minaret:Segment_HUSN_AKHL-21593_0011 a minaret:TranscriptSegment ;
    minaret:endTime 191.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0012 ;
    minaret:sequenceIndex 11 ;
    minaret:startTime 175.46 ;
    minaret:text "'سَیِّئَ' ہے، ٹھیک ہے؟ سَیِّئَهَا، وَاصْرِفْ عَنِّیْ سَیِّئَهَا، لَا یَصْرِفُ عَنِّیْ" .

minaret:Segment_HUSN_AKHL-21593_0012 a minaret:TranscriptSegment ;
    minaret:endTime 213.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0013 ;
    minaret:sequenceIndex 12 ;
    minaret:startTime 194.12 ;
    minaret:text "سَیِّئَهَا اِلَّاۤ اَنْتَ، لَا یَصْرِفُ عَنِّیْ سَیِّئَهَا اِلَّاۤ اَنْتَ، لَا یَصْرِفُ عَنِّیْ سَیِّئَهَا اِلَّاۤ اَنْتَ، لَا یَصْرِفُ عَنِّیْ سَیِّئَهَا اِلَّاۤ اَنْتَ، لَا" .

minaret:Segment_HUSN_AKHL-21593_0013 a minaret:TranscriptSegment ;
    minaret:endTime 233.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0014 ;
    minaret:sequenceIndex 13 ;
    minaret:startTime 213.86 ;
    minaret:text "یَصْرِفُ عَنِّیْ سَیِّئَهَا اِلَّاۤ اَنْتَ۔ وَاهْدِنِیْ، اور ہدایت دے مجھے یا رہنمائی کر میری، لِاَحْسَنِ الْاَخْلَاقِ، بہترین اخلاق کی طرف۔ یعنی اے اللہ! تُو مجھے بہترین اخلاق کی طرف رہنمائی عطا کر،" .

minaret:Segment_HUSN_AKHL-21593_0016 a minaret:TranscriptSegment ;
    minaret:endTime 293.66 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0017 ;
    minaret:sequenceIndex 16 ;
    minaret:startTime 273.66 ;
    minaret:text "نہیں دور کر سکتا مجھ سے، سَیِّئَهَا، اس کا برا، اِلَّاۤ اَنْتَ، مگر تُو ہی۔ اے اللہ! میری سب سے اچھے اخلاق کی طرف رہنمائی فرما، تیرے سوا اچھے اخلاق کی راہ کوئی نہیں دکھا سکتا، اور برے اخلاق کو مجھ سے دور" .

minaret:Segment_HUSN_AKHL-21593_0017 a minaret:TranscriptSegment ;
    minaret:endTime 313.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0018 ;
    minaret:sequenceIndex 17 ;
    minaret:startTime 293.66 ;
    minaret:text "کر دے، انہیں تیرے سوا مجھ سے کوئی اور دور نہیں کر سکتا۔ اور یہ بہت بڑی حقیقت ہے، ہمیں اس بات کا اعتراف کرنا ہوگا کہ ہماری جتنی بھی خراب عادتیں ہیں ان کو اللہ کے سوا کوئی بھی نہیں ہٹا سکتا۔ کسی انسان کے بس میں نہیں، کسی کی مجال نہیں، کسی کی طاقت نہیں،" .

minaret:Segment_HUSN_AKHL-21593_0035 a minaret:TranscriptSegment ;
    minaret:endTime 655.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0036 ;
    minaret:sequenceIndex 35 ;
    minaret:startTime 635.74 ;
    minaret:text "اور ظلم دیگر مخلوق کے ساتھ بھی ہو سکتا ہے۔ تو آئیے دیکھتے ہیں کہ احادیث سے ہمیں ظلم کے بارے میں کیا بات پتہ چلتی ہے۔ پہلے قرآنی آیات کچھ، پھر اس کے بعد احادیث۔ قَالَ اللّٰهُ تَعَالٰی: ﴿وَاللّٰهُ لَا یَهْدِی الْقَوْمَ الظّٰلِمِیْنَ﴾۔" .

minaret:Segment_HUSN_AKHL-21593_0036 a minaret:TranscriptSegment ;
    minaret:endTime 665.54 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0037 ;
    minaret:sequenceIndex 36 ;
    minaret:startTime 656.26 ;
    minaret:text "اللہ تعالیٰ کا ارشاد ہے کہ اللہ ظالموں کو ہدایت نہیں دیا کرتا۔ قَالَ اللّٰهُ تَعَالٰی، اللہ" .

minaret:Segment_HUSN_AKHL-21593_0037 a minaret:TranscriptSegment ;
    minaret:endTime 690.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0038 ;
    minaret:sequenceIndex 37 ;
    minaret:startTime 665.54 ;
    minaret:text "تَعَالٰی: ﴿اَلَا لَعْنَةُ اللّٰهِ عَلَی الظّٰلِمِیْنَ﴾، اللہ تعالیٰ کا ارشاد ہے: سنو! خدا کی لعنت ہے ظالموں پر۔ قَالَ اللّٰهُ تَعَالٰی: ﴿وَاللّٰهُ لَا یُحِبُّ الظّٰلِمِیْنَ﴾، اللہ تعالیٰ کا ارشاد ہے کہ اللہ ظالموں سے محبت نہیں کرتا، ایسے لوگ اللہ کو پسند نہیں۔ قَالَ اللّٰهُ تَعَالٰی: ﴿اَلَاۤ اِنَّ الظّٰلِمِیْنَ فِیْ عَذَابٍ مُّقِیْمٍ﴾" .

minaret:Segment_HUSN_AKHL-21593_0039 a minaret:TranscriptSegment ;
    minaret:endTime 732.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0040 ;
    minaret:sequenceIndex 39 ;
    minaret:startTime 713.32 ;
    minaret:text "ہوگا اور نہ کوئی سفارش کرنے والا جس کی بات مانی جائے۔ یعنی قیامت کے دن کوئی بھی ظالموں کا ساتھ نہیں دے گا۔ عَنْ اَبِیْ ذَرٍّ قَالَ: قَالَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ فِیْمَا یَرْوِیْ عَنْ رَّبِّهٖ عَزَّ وَجَلَّ:" .

minaret:Segment_HUSN_AKHL-21593_0040 a minaret:TranscriptSegment ;
    minaret:endTime 752.04 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0041 ;
    minaret:sequenceIndex 40 ;
    minaret:startTime 732.46 ;
    minaret:text "اِنِّیْ حَرَّمْتُ الظُّلْمَ عَلٰی نَفْسِیْ وَجَعَلْتُهٗ بَیْنَكُمْ مُحَرَّمًا فَلَا تَظَالَمُوْا (or فَلَا تَظَالَمُوْ)۔ رَوَاهُ مُسْلِمٌ، كِتَابُ الْبِرِّ وَالصِّلَةِ۔ عَنْ اَبِیْ ذَرٍّ، ابو ذر رضی اللہ عنہ سے روایت ہے، قَالَ، کہتے ہیں، قَالَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ،" .

minaret:Segment_HUSN_AKHL-21593_0045 a minaret:TranscriptSegment ;
    minaret:endTime 850.28 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0046 ;
    minaret:sequenceIndex 45 ;
    minaret:startTime 830.66 ;
    minaret:text "نقل کیا سے مراد روایت کی، کہ میں نے اپنے نفس پر ظلم کو حرام کیا ہے اور اپنے بندوں کے درمیان بھی اسے حرام قرار دیا ہے، تو تم آپس میں ظلم نہ کرو۔ نہ خالق پر ظلم کرو اور نہ ہی مخلوق پر ظلم کرو۔ اس حدیث کے راوی حضرت" .

minaret:Segment_HUSN_AKHL-21593_0047 a minaret:TranscriptSegment ;
    minaret:endTime 889.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0048 ;
    minaret:sequenceIndex 47 ;
    minaret:startTime 870.1 ;
    minaret:text "اللہ! غفار کو بخش دے، کیونکہ غفار کا روٹ جو ہے وہ بھی بخشش ہے، اور بنو اسلم کو سلامت رکھ۔ ایک اور قبیلے کے لیے سلامتی کی دعا کی اور غفار کے لیے بخشش کی۔ نام کیا تھا ان کا؟ ان کا نام جندب بن جنادہ" .

minaret:Segment_HUSN_AKHL-21593_0049 a minaret:TranscriptSegment ;
    minaret:endTime 929.24 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0050 ;
    minaret:sequenceIndex 49 ;
    minaret:startTime 909.64 ;
    minaret:text "بتایا کیجیے کیونکہ یہ ہماری تاریخ ہے، یہ وہ لوگ ہیں جن کے لیے ہم ہر روز کھڑے ہو کے دعا مانگتے ہیں: صِرَاطَ الَّذِیْنَ اَنْعَمْتَ عَلَیْهِمْ، ہمیں انہی کے راستے پہ چلا جن پہ تو نے انعام کیا۔ ان کا راستہ کیا تھا؟ وہ ہمیں خود ہی نہیں پتا، تو ہمیں ان کا راستہ معلوم کرنا ہے کہ وہ کون تھے،" .

minaret:Segment_HUSN_AKHL-21593_0053 a minaret:TranscriptSegment ;
    minaret:endTime 1009.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0054 ;
    minaret:sequenceIndex 53 ;
    minaret:startTime 989.34 ;
    minaret:text "مکہ کی چونکہ ایک مرکزی حیثیت تھی تو یہ بہت جلد ادھر ادھر چرچا ہو گیا۔ مکہ کے لوگ تاجر لوگ تھے، کچھ اور زراعت وغیرہ تو نہیں تھا وہاں، تو ان کا آمدنی کا ذریعہ کیا تھا؟ تجارت۔ ﴿اٖلٰفِهِمْ رِحْلَةَ الشِّتَآءِ وَالصَّیْفِ﴾، تو گرمیوں میں شام کی طرف اور سردیوں میں یمن کی طرف یہ سفر کرتے تھے اور" .

minaret:Segment_HUSN_AKHL-21593_0079 a minaret:TranscriptSegment ;
    minaret:endTime 1524.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0080 ;
    minaret:sequenceIndex 79 ;
    minaret:startTime 1505.38 ;
    minaret:text "اپنے دائرۂ کار میں کام کر رہی ہے، ہر چیز اپنے دائرۂ کار میں کام کر رہی ہے، ﴿كُلٌّ فِیْ فَلَكٍ یَّسْبَحُوْنَ﴾۔ کوئی چیز اپنے دائرے سے باہر نہیں نکلتی، مثلاً ستاروں سیاروں کو دیکھیں، سورج کو دیکھیں، چاند کو دیکھیں، سب کیا کر رہے" .

minaret:Segment_HUSN_AKHL-21593_0103 a minaret:TranscriptSegment ;
    minaret:endTime 2000.98 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0104 ;
    minaret:sequenceIndex 103 ;
    minaret:startTime 1981.08 ;
    minaret:text "پر آپ دیکھیے کہ ہمارے ہاں عموماً گھروں میں لڑائی فساد کیوں ہوتے ہیں؟ مثلاً ساس بہو کا جھگڑا ہی آپ دیکھیں۔ ایک حدیث کہتی ہے کہ تم پر سب سے زیادہ حق کس کا ہے؟ تمہاری ماں کا ہے۔ ایک شخص آپ کے پاس آیا اور کہنے لگا کہ یا رسول اللہ صلی اللہ علیہ وسلم! سب سے زیادہ مجھے اچھا سلوک" .

minaret:Segment_HUSN_AKHL-21593_0107 a minaret:TranscriptSegment ;
    minaret:endTime 2080.0 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0108 ;
    minaret:sequenceIndex 107 ;
    minaret:startTime 2060.12 ;
    minaret:text "دوسرے کا حق دینے سے روکے نہیں۔ عدم توازن بھی ظلم پیدا کرتا ہے کہ ایک کا حق دینے میں آپ اتنے جھک جائیں کہ دوسرا بالکل لٹک جائے، حتیٰ کہ دو بیویوں کے درمیان بھی کیا کہا کہ ایک کی طرف اس طرح مت جھکو کہ دوسری وہ دوسری لٹکی رہ جائے۔" .

minaret:Segment_HUSN_AKHL-21593_0138 a minaret:TranscriptSegment ;
    minaret:endTime 2679.94 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0139 ;
    minaret:sequenceIndex 138 ;
    minaret:startTime 2660.12 ;
    minaret:text "اسی موضوع پر مزید گفتگو کریں گے، اور ہم سب اپنا حساب کریں، اپنا جائزہ لیں کہ ہماری زندگی میں دوسروں کے ساتھ زیادتی کے کون کون سے ایسے کام ہیں جو ہمیں چھوڑنے ہیں۔ سُبْحَانَكَ اللّٰهُمَّ وَبِحَمْدِكَ، نَشْهَدُ اَنْ لَّاۤ اِلٰهَ" .

minaret:Segment_HUSN_AKHL-21593_0139 a minaret:TranscriptSegment ;
    minaret:endTime 2685.36 ;
    minaret:sequenceIndex 139 ;
    minaret:startTime 2679.94 ;
    minaret:text "اِلَّاۤ اَنْتَ، نَسْتَغْفِرُكَ وَنَتُوْبُ اِلَیْكَ۔ اَلسَّلَامُ عَلَیْكُمْ وَرَحْمَةُ اللّٰهِ وَبَرَكَاتُهٗ۔" .

minaret:Speaker_dr_farhat_hashmi a minaret:Speaker ;
    minaret:nameEn "Dr. Farhat Hashmi" ;
    minaret:nameUr "ڈاکٹر فرحت ہاشمی" ;
    minaret:speakerCode "dr_farhat_hashmi" .

minaret:Urdu a minaret:Language ;
    minaret:label "Urdu" ;
    minaret:languageCode "ur" .

minaret:SegmentGroup_HUSN_AKHL-21592_0_0_19_86 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_HUSN_AKHL-21592_0000 ;
    minaret:endTime 19.86 ;
    minaret:startTime 0.0 .

minaret:SegmentGroup_HUSN_AKHL-21593_2_98_22_0 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_HUSN_AKHL-21593_0001 ;
    minaret:endTime 22.0 ;
    minaret:startTime 2.98 .

minaret:SegmentGroup_HUSN_AKHL-21593_665_54_690_08 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_HUSN_AKHL-21593_0037 ;
    minaret:endTime 690.08 ;
    minaret:startTime 665.54 .

minaret:Segment_HUSN_AKHL-21590_0030 a minaret:TranscriptSegment ;
    minaret:endTime 335.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0031 ;
    minaret:sequenceIndex 30 ;
    minaret:startTime 322.82 ;
    minaret:text "فَقَالَ تو فرمایا حَدَّثَنِیْ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ مجھ سے رسول اللہ صلی اللہ علیہ وسلم نے حدیث بیان کی کیا حدیث؟" .

minaret:Segment_HUSN_AKHL-21590_0099 a minaret:TranscriptSegment ;
    minaret:endTime 1062.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0100 ;
    minaret:sequenceIndex 99 ;
    minaret:startTime 1055.08 ;
    minaret:text "وَمَا نَهٰىكُمْ عَنْهُ فَانْتَهُوْا ۚ اور جس چیز سے آپ روکیں اس سے رک بھی جاؤ کیوں؟" .

minaret:Segment_HUSN_AKHL-21590_0106 a minaret:TranscriptSegment ;
    minaret:endTime 1129.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0107 ;
    minaret:sequenceIndex 106 ;
    minaret:startTime 1123.76 ;
    minaret:text "كَانَ خُلُقُهُ الْقُرْاٰنَ، وہ قرآن ہی تھا۔ گویا آپ کی عملی زندگی کیا تھی؟" .

minaret:Segment_HUSN_AKHL-21590_0261 a minaret:TranscriptSegment ;
    minaret:endTime 2712.56 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0262 ;
    minaret:sequenceIndex 261 ;
    minaret:startTime 2702.52 ;
    minaret:text "فَاَحْسِنْ خُلُقِیْ اے اللہ تو نے میری صورت اچھی بنائی تو نے میری شکل و صورت خوبصورت بنائی تو میرے" .

minaret:Segment_HUSN_AKHL-21591_0031 a minaret:TranscriptSegment ;
    minaret:endTime 601.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0032 ;
    minaret:sequenceIndex 31 ;
    minaret:startTime 581.38 ;
    minaret:text "یَمْشُوْنَ عَلَی الْاَرْضِ هَوْنًا کہ رحمان کے بندے زمین پر آیستگی سے چلتے ہیں وہ زمین کو بھی اس کا حق دیتے ہوئے چلتے ہیں پاؤں مار کے نہیں چلتے کیونکہ انہیں معلوم ہے کہ ہمارے پاؤں مارنے سے زمین پھٹ نہیں سکتی اکڑ کے نہیں چلتے کیونکہ نے معلوم ہے کہ وہ جتنا بھی" .

minaret:Segment_HUSN_AKHL-21591_0037 a minaret:TranscriptSegment ;
    minaret:endTime 715.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0038 ;
    minaret:sequenceIndex 37 ;
    minaret:startTime 695.68 ;
    minaret:text "الْقَلْبِ لَانْفَضُّوْا مِنْ حَوْلِكَ ۪، آلِ عمران: 159۔ اللہ تعالی کا ارشاد ہے کہ اے پیغمبر صلی اللہ علیہ وسلم یہ اللہ کی بڑی رحمت ہے کہ تم ان لوگوں کے لئے بہت نرم مزاج واقع ہوئے ہو ورنہ اگر کہیں تم" .

minaret:Segment_HUSN_AKHL-21591_0095 a minaret:TranscriptSegment ;
    minaret:endTime 1776.58 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0096 ;
    minaret:sequenceIndex 95 ;
    minaret:startTime 1764.84 ;
    minaret:text "تم انہیں ان کے چہروں سے پہچانو گے، وہ لوگوں کے پیچھے پڑ کے نہیں مانگا کرتے۔ کہتے ہیں کہ میں بھوک سے" .

minaret:Segment_HUSN_AKHL-21591_0112 a minaret:TranscriptSegment ;
    minaret:endTime 2114.06 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0113 ;
    minaret:sequenceIndex 112 ;
    minaret:startTime 2094.12 ;
    minaret:text "میں اپنے والدہ کا شکر گزار کہ جس نے میری بچپن میں تربیت کی حالانکہ آپ جانتے ہیں کہ والدہ کون تھی جو ان کی سب سے بڑی دشمن تھی اسلام قبول کرنے پر اور اتنا برا بھلا کہتی کہ رو پڑتے کہ یارب یہ کیا ہو رہا ہے ایک طرف ماں سے محبت ہے اور دوسری طرف ان کے کفر سے" .

minaret:Segment_HUSN_AKHL-21591_0121 a minaret:TranscriptSegment ;
    minaret:endTime 2294.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0122 ;
    minaret:sequenceIndex 121 ;
    minaret:startTime 2274.98 ;
    minaret:text "حدیث نمبر دو: عَنْ اَنَسِ بْنِ مَالِكٍ قَالَ: كَانَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ اَحْسَنَ النَّاسِ خُلُقًا، رَوَاهُ مُسْلِمٌ كِتَابُ الْفَضَائِلِ۔ سیدنا انس رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم لوگوں میں سب سے زیادہ" .

minaret:Segment_HUSN_AKHL-21591_0183 a minaret:TranscriptSegment ;
    minaret:endTime 3495.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0184 ;
    minaret:sequenceIndex 183 ;
    minaret:startTime 3476.26 ;
    minaret:text "کے تابع نہ بنو۔ یہ نہ کہو کہ لوگ اچھا کریں گے تو ہم بھی اچھا کریں گے اور اگر برا کریں گے تو ہم بھی برا کریں گے، بلکہ کیا کہو؟ اگر وہ ہمارے ساتھ اچھا کریں گے تو بھی اچھا کریں گے اور اگر وہ برا کریں گے تو بھی اچھا کریں گے۔ یہ ہے۔ معیار۔ سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ، نَشْهَدُ أَنْ لَا إِلٰهَ إِلَّا أَنْتَ،" .

minaret:Segment_HUSN_AKHL-21592_0008 a minaret:TranscriptSegment ;
    minaret:endTime 177.4 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0009 ;
    minaret:sequenceIndex 8 ;
    minaret:startTime 157.7 ;
    minaret:text "خوبصورت بنا دے، خُلُقِیْ، میرے خلق کو میرے اخلاق کو میری عادات کو۔ اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ، اَللّٰهُمَّ كَمَا حَسَّنْتَ خَلْقِیْ فَحَسِّنْ خُلُقِیْ۔ اَللّٰهُمَّ" .

minaret:Segment_HUSN_AKHL-21592_0083 a minaret:TranscriptSegment ;
    minaret:endTime 1622.2 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0084 ;
    minaret:sequenceIndex 83 ;
    minaret:startTime 1602.3 ;
    minaret:text "کر لیں۔ تو رفق جو ہے نرمی اور جینٹلنس اور اچھے معاملے کا نام ہے۔ اب آپ کتاب کھول لیجیے اس تمہید کے بعد۔ قَالَ اللّٰهُ تَعَالٰی: وَاخْفِضْ جَنَاحَكَ لِمَنِ اتَّبَعَكَ مِنَ الْمُؤْمِنِیْنَ، سُوْرَةُ" .

minaret:Segment_HUSN_AKHL-21592_0084 a minaret:TranscriptSegment ;
    minaret:endTime 1641.98 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0085 ;
    minaret:sequenceIndex 84 ;
    minaret:startTime 1622.2 ;
    minaret:text "الشُّعَرَاءِ۔ اللہ تعالیٰ کا ارشاد ہے: اور ایمان لانے والوں میں سے جو لوگ تمہاری پیروی اختیار کریں ان کے ساتھ تواضع سے پیش آؤ، نرمی سے پیش آؤ۔ یہ کس کو کہا جا رہا ہے؟ محمد رسول اللہ صلی اللہ علیہ وسلم کو۔ کیا کہ جو" .

minaret:Segment_HUSN_AKHL-21592_0143 a minaret:TranscriptSegment ;
    minaret:endTime 2749.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0144 ;
    minaret:sequenceIndex 143 ;
    minaret:startTime 2729.16 ;
    minaret:text "وہ محروم کیا گیا، حَظَّهٗ، اپنے حصے سے، مِنَ الْخَیْرِ، خیر کے۔ رَوَاهُ التِّرْمِذِیُّ، اسے ترمذی نے روایت کیا، كِتَابُ الْبِرِّ وَالصِّلَةِ۔ سیدنا ابو الدرداء رضی اللہ عنہ سے روایت ہے کہ نبی کریم صلی اللہ علیہ وسلم نے فرمایا: جس کو نرمی میں سے حصہ ملا تو اسے" .

minaret:Segment_HUSN_AKHL-21592_0177 a minaret:TranscriptSegment ;
    minaret:endTime 3422.62 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21592_0178 ;
    minaret:sequenceIndex 177 ;
    minaret:startTime 3402.64 ;
    minaret:text "اس پر، اَلنَّارُ، آگ۔ عَلٰی كُلِّ قَرِیْبٍ هَیِّنٍ سَهْلٍ۔ سیدنا عبداللہ بن مسعود رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: کیا میں تمہیں ایسے لوگوں" .

minaret:Segment_HUSN_AKHL-21593_0038 a minaret:TranscriptSegment ;
    minaret:endTime 713.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0039 ;
    minaret:sequenceIndex 38 ;
    minaret:startTime 693.46 ;
    minaret:text "اللہ تعالیٰ کا ارشاد ہے: خبردار رہو، ظالم لوگ مستقل عذاب میں ہوں گے، یعنی ان کا انجام اچھا نہ ہوگا۔ قَالَ اللّٰهُ تَعَالٰی: ﴿مَا لِلظّٰلِمِیْنَ مِنْ حَمِیْمٍ وَّلَا شَفِیْعٍ یُّطَاعُ﴾، اللہ تعالیٰ کا ارشاد ہے: ظالموں کا نہ کوئی مشفق دوست" .

minaret:Segment_HUSN_AKHL-21593_0104 a minaret:TranscriptSegment ;
    minaret:endTime 2020.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0105 ;
    minaret:sequenceIndex 104 ;
    minaret:startTime 2000.98 ;
    minaret:text "کس سے کرنا ہے؟ اس سے پتہ یہ چلتا ہے کہ ماں کا حق بہرحال زیادہ ہے۔ ایک دوسری حدیث ہمیں یہ کہتی ہے کہ تم میں سب سے اچھا وہ ہے جو اپنی بیوی کے حق میں اچھا ہے، اور میں تم میں سب سے زیادہ اپنی بیویوں کے حق میں اچھا ہوں۔ اب" .

minaret:Segment_HUSN_AKHL-21590_0031 a minaret:TranscriptSegment ;
    minaret:endTime 344.92 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0032 ;
    minaret:sequenceIndex 31 ;
    minaret:startTime 335.46 ;
    minaret:text "اَنَّ اللّٰهَ تَبَارَكَ وَتَعَالٰی کہ بے شک اللہ تبارک و تعالی اِذَا كَانَ یَوْمُ الْقِیٰمَةِ جب قیامت کا دن ہوگا" .

minaret:Segment_HUSN_AKHL-21590_0032 a minaret:TranscriptSegment ;
    minaret:endTime 354.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0033 ;
    minaret:sequenceIndex 32 ;
    minaret:startTime 344.92 ;
    minaret:text "یَنْزِلُ اِلَی الْعِبَادِ نازل ہوگا بندوں کی طرف یعنی بندوں کی طرف جلوہ فرما ہوں گے تشریف لائیں گے" .

minaret:Segment_HUSN_AKHL-21590_0033 a minaret:TranscriptSegment ;
    minaret:endTime 365.16 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0034 ;
    minaret:sequenceIndex 33 ;
    minaret:startTime 354.96 ;
    minaret:text "لِیَقْضِیَ بَیْنَهُمْ کہ ان کے درمیان فیصلہ کریں یعنی آپ سوچئے کہ پوری دنیا کے لوگ جمع ہیں ایک جگہ انتظار میں ہیں کہ فیصلہ ہو حساب" .

minaret:Segment_HUSN_AKHL-21590_0038 a minaret:TranscriptSegment ;
    minaret:endTime 412.3 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0039 ;
    minaret:sequenceIndex 38 ;
    minaret:startTime 402.32 ;
    minaret:text "تو پہلا شخص جسے پکارا جائے گا وہ شخص ہوگا جس نے قرآن جمع کیا جمع کرنے سے مراد سیکھا حفظ کیا علم" .

minaret:Segment_HUSN_AKHL-21590_0039 a minaret:TranscriptSegment ;
    minaret:endTime 426.04 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0040 ;
    minaret:sequenceIndex 39 ;
    minaret:startTime 412.3 ;
    minaret:text "حاصل کیا اور اس کو خوب خوب سمیٹا خوب پڑھا جَمَعَ الْقُرْاٰنَ وَرَجُلٌ قُتِلَ فِیْ سَبِیْلِ اللّٰهِ اور وہ شخص جو اللہ کے راستے میں مارا گیا شہید" .

minaret:Segment_HUSN_AKHL-21590_0040 a minaret:TranscriptSegment ;
    minaret:endTime 437.14 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0041 ;
    minaret:sequenceIndex 40 ;
    minaret:startTime 427.16 ;
    minaret:text "وَرَجُلٌ كَثِیْرُ الْمَالِ اور وہ شخص جس کے پاس بہت مال تھا فَیَقُوْلُ اللّٰهُ عَزَّ وَجَلَّ لِلْقَارِئِ تو اللہ سبحان و تعالیٰ قرآن" .

minaret:Segment_HUSN_AKHL-21590_0041 a minaret:TranscriptSegment ;
    minaret:endTime 443.08 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0042 ;
    minaret:sequenceIndex 41 ;
    minaret:startTime 437.14 ;
    minaret:text "پڑھنے والے سے کہیں گے اَلَمْ اُعَلِّمْكَ کیا میں نے تجھ سکھایا نہ تھا" .

minaret:Segment_HUSN_AKHL-21590_0042 a minaret:TranscriptSegment ;
    minaret:endTime 458.22 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0043 ;
    minaret:sequenceIndex 42 ;
    minaret:startTime 443.88 ;
    minaret:text "مَاۤ اَنْزَلْتُ عَلٰی رَسُوْلِیْ؟ جو میں نے اپنے رسول پہ اتارا قَالَ: بَلٰی یَا رَبِّ وہ اقرار کرے گا اعتراف کرے گا ہاں اے رب قَالَ: فَمَا عَمِلْتَ فِیْمَا عَلِمْتَ؟ تو تُو نے عمل کیا کیا جس کو تُو نے جانا" .

minaret:Segment_HUSN_AKHL-21590_0043 a minaret:TranscriptSegment ;
    minaret:endTime 469.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0044 ;
    minaret:sequenceIndex 43 ;
    minaret:startTime 459.24 ;
    minaret:text "جتنا تجھے معلوم ہوا اس پر تیرا عمل کیا تھا؟ قَالَ تو وہ کہے گا كُنْتُ اَقُوْمُ بِهٖۤ اٰنَآءَ الَّیْلِ وَاٰنَآءَ النَّهَارِ کہ میں اس کے ساتھ کھڑا" .

minaret:Segment_HUSN_AKHL-21590_0044 a minaret:TranscriptSegment ;
    minaret:endTime 478.06 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0045 ;
    minaret:sequenceIndex 44 ;
    minaret:startTime 469.38 ;
    minaret:text "ہوتا تھا رات کی گھڑیوں میں یعنی تہجد بھی پڑھتا تھا اور دن کے اوقات میں بھی اس کو لے کے کھڑا ہوتا یعنی اسے لوگوں کو سکھاتا یا خود پڑھتا" .

minaret:Segment_HUSN_AKHL-21590_0045 a minaret:TranscriptSegment ;
    minaret:endTime 491.42 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0046 ;
    minaret:sequenceIndex 45 ;
    minaret:startTime 478.74 ;
    minaret:text "فَیَقُوْلُ اللّٰهُ عَزَّ وَجَلَّ لَهٗ: كَذَبْتَ اللَّهُ تعالیٰ فرمائے گا تُو نے جھوٹ کہا وَتَقُوْلُ لَهُ الْمَلٰٓئِكَةُ: كَذَبْتَ، اور فرشتے بھی اس کو کہیں گے: كَذَبْتَ تُو نے جھوٹ کہا" .

minaret:Segment_HUSN_AKHL-21590_0046 a minaret:TranscriptSegment ;
    minaret:endTime 502.36 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0047 ;
    minaret:sequenceIndex 46 ;
    minaret:startTime 492.38 ;
    minaret:text "وَیَقُوْلُ اللّٰهُ تَبَارَكَ وَتَعَالٰی اور اللَّهُ تَبَارَكُ وَتَعَالَى فرمائیں گے بَلْ اَرَدْتَّ، بلکہ تو نے تو ارادہ کیا یا چاہا، اَنْ یُّقَالَ کہ کہا جائے: فُلَانٌ قَارِئٌ، کہ فلاں قاری ہے" .

minaret:Segment_HUSN_AKHL-21590_0047 a minaret:TranscriptSegment ;
    minaret:endTime 512.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0048 ;
    minaret:sequenceIndex 47 ;
    minaret:startTime 502.36 ;
    minaret:text "کہ کہا جائے فُلَانٌ قَارِئُن کے فُلَان قَاری ہے بہت اچھی قرات کرتا ہے بہت بڑا قرآن کا عالم ہے بہت نامور اسکالر ہے" .

minaret:Segment_HUSN_AKHL-21590_0048 a minaret:TranscriptSegment ;
    minaret:endTime 521.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0049 ;
    minaret:sequenceIndex 48 ;
    minaret:startTime 512.34 ;
    minaret:text "وَقَدْ قِیْلَ ذٰلِكَ اور یہ تو کہہ دیا گیا تمہیں دنیا میں یہ سارے ریوارڈز اور ایوارڈز مل گئے وَیُؤْتٰی بِصَاحِبِ الْمَالِ" .

minaret:Segment_HUSN_AKHL-21590_0049 a minaret:TranscriptSegment ;
    minaret:endTime 532.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0050 ;
    minaret:sequenceIndex 49 ;
    minaret:startTime 522.23 ;
    minaret:text "وَیُؤْتٰی بِصَاحِبِ الْمَالِ، پھر صاحبِ مال کو لایا جائے گا۔ فَیَقُوْلُ اللّٰهُ عَزَّ وَجَلَّ: اَلَمْ اُوَسِّعْ عَلَیْكَ اللَّهُ تعالیٰ فرمائے گا کہ کیا میں نے تجھ پر وسعت نہیں کی تھی یعنی" .

minaret:Segment_HUSN_AKHL-21590_0050 a minaret:TranscriptSegment ;
    minaret:endTime 537.7 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0051 ;
    minaret:sequenceIndex 50 ;
    minaret:startTime 532.18 ;
    minaret:text "تجھے بہت بہت مال نہیں دیا تھا حَتّٰی لَمْ اَدَعْكَ تَحْتَاجُ اِلٰی اَحَدٍ؟" .

minaret:Segment_HUSN_AKHL-21590_0051 a minaret:TranscriptSegment ;
    minaret:endTime 548.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0052 ;
    minaret:sequenceIndex 51 ;
    minaret:startTime 538.28 ;
    minaret:text "یہاں تک کہ میں نے تجھے کسی کا بھی محتاج نہیں کیا یعنی تجھے کسی کا بھی ضرورت مند نہیں چھوڑا قَالَ: بَلٰی یَا رَبِّ کہے گا کیوں نہیں اے رب قَالَ" .

minaret:Segment_HUSN_AKHL-21590_0052 a minaret:TranscriptSegment ;
    minaret:endTime 558.46 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0053 ;
    minaret:sequenceIndex 52 ;
    minaret:startTime 548.5 ;
    minaret:text "فَمَاذَا عَمِلْتَ فِیْمَاۤ اٰتَیْتُكَ؟ تو اللہ تعالیٰ پوچھے گا پھر تُو نے عمل کیا کیا اس میں جو میں نے تجھے دیا تھا قَالَ: كُنْتُ اَصِلُ الرَّحِمَ کہے گا میں" .

minaret:Segment_HUSN_AKHL-21590_0053 a minaret:TranscriptSegment ;
    minaret:endTime 568.5 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0054 ;
    minaret:sequenceIndex 53 ;
    minaret:startTime 558.46 ;
    minaret:text "رشتوں کو جوڑتا تھا انہیں رشتہ داروں پر مال خرچ کرتا وَاَتَصَدَّقُ، اور میں صدقہ بھی کرتا۔ فَیَقُوْلُ اللّٰهُ لَهٗ، تو اللہ تعالیٰ اس سے فرمائے گا: كَذَبْتَ" .

minaret:Segment_HUSN_AKHL-21590_0054 a minaret:TranscriptSegment ;
    minaret:endTime 578.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0055 ;
    minaret:sequenceIndex 54 ;
    minaret:startTime 568.5 ;
    minaret:text "تُو نے جھوٹ کہا وَتَقُوْلُ الْمَلٰٓئِكَةُ: كَذَبْتَ، سارے فرشتے بھی کہیں گے تو نے جھوٹ کہا۔ وَیَقُوْلُ اللّٰهُ تَبَارَكَ وَتَعَالٰی اور اللہ" .

minaret:Segment_HUSN_AKHL-21590_0055 a minaret:TranscriptSegment ;
    minaret:endTime 591.36 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0056 ;
    minaret:sequenceIndex 55 ;
    minaret:startTime 578.44 ;
    minaret:text "تَبَارَكَ وَتَعَالَى فرمائے گا بَلْ اَرَدْتَّ اَنْ یُّقَالَ، بلکہ تو نے تو چاہا کہ کہا جائے: فُلَانٌ جَوَادٌ، فلاں تو بہت سخی ہے، وَقَدْ قِیْلَ ذٰلِكَ تو یہ تو کہہ دیا گیا" .

minaret:Segment_HUSN_AKHL-21590_0056 a minaret:TranscriptSegment ;
    minaret:endTime 602.7 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0057 ;
    minaret:sequenceIndex 56 ;
    minaret:startTime 592.66 ;
    minaret:text "وَیُؤْتٰی بِالَّذِیْ قُتِلَ فِیْ سَبِیْلِ اللّٰهِ، پھر لایا جائے گا وہ شخص جو اللہ کی راہ میں مارا گیا۔ فَیَقُوْلُ اللّٰهُ لَهٗ، تو اللہ تعالیٰ اس سے فرمائے گا: فِیْ مَاذَا قُتِلْتَ؟" .

minaret:Segment_HUSN_AKHL-21590_0057 a minaret:TranscriptSegment ;
    minaret:endTime 609.26 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0058 ;
    minaret:sequenceIndex 57 ;
    minaret:startTime 602.7 ;
    minaret:text "فِیْ مَاذَا قُتِلْتَ؟ تُو کس چیز میں مارا گیا تھا فَیَقُوْلُ: اَیْ رَبِّ کہے گا اے میرے رب" .

minaret:Segment_HUSN_AKHL-21590_0058 a minaret:TranscriptSegment ;
    minaret:endTime 620.04 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0059 ;
    minaret:sequenceIndex 58 ;
    minaret:startTime 610.06 ;
    minaret:text "اُمِرْتُ بِالْجِهَادِ فِیْ سَبِیْلِكَ، مجھے تیرے راستے میں جہاد کا حکم دیا گیا تھا، فَقَاتَلْتُ حَتّٰی قُتِلْتُ تو میں نے جنگ کی یہاں تک کہ میں مارا گیا" .

minaret:Segment_HUSN_AKHL-21590_0059 a minaret:TranscriptSegment ;
    minaret:endTime 631.28 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0060 ;
    minaret:sequenceIndex 59 ;
    minaret:startTime 621.24 ;
    minaret:text "فَیَقُوْلُ اللّٰهُ لَهٗ: كَذَبْتَ تو اللہ تعالی اس سے فرمائے گا تُو نے جھوٹ کہا وَتَقُولُ الْمَلَائِكَةُ كَذَبْتَ سب فرشتے بھی کہیں گے تُو جھوٹا ہے" .

minaret:Segment_HUSN_AKHL-21590_0060 a minaret:TranscriptSegment ;
    minaret:endTime 640.98 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0061 ;
    minaret:sequenceIndex 60 ;
    minaret:startTime 631.28 ;
    minaret:text "تُو نے جھوٹ کہا وَیَقُوْلُ اللّٰهُ، اور اللہ تعالیٰ فرمائے گا: بَلْ اَرَدْتَّ اَنْ یُّقَالَ، بلکہ تو نے تو چاہا تھا کہ کہا جائے:" .

minaret:Segment_HUSN_AKHL-21590_0061 a minaret:TranscriptSegment ;
    minaret:endTime 646.78 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0062 ;
    minaret:sequenceIndex 61 ;
    minaret:startTime 640.98 ;
    minaret:text "فُلَانٌ جَرِیْٓءٌ، فلاں بڑا بہادر ہے، فَقَدْ قِیْلَ ذٰلِكَ تو یہ سب کہہ دیا گیا" .

minaret:Segment_HUSN_AKHL-21590_0062 a minaret:TranscriptSegment ;
    minaret:endTime 657.34 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0063 ;
    minaret:sequenceIndex 62 ;
    minaret:startTime 647.46 ;
    minaret:text "ثُمَّ ضَرَبَ رَسُوْلُ اللّٰهِ صَلَّی اللّٰهُ عَلَیْهِ وَسَلَّمَ عَلٰی رُكْبَتَیَّ پھر اللہ کے رسول صلی اللہ علیہ وسلم نے میرے دونوں گھٹنوں پہ ہاتھ مارا یعنی ابو" .

minaret:Segment_HUSN_AKHL-21590_0063 a minaret:TranscriptSegment ;
    minaret:endTime 667.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0064 ;
    minaret:sequenceIndex 63 ;
    minaret:startTime 657.34 ;
    minaret:text "ہریرہ کے فَقَالَ: یَا اَبَا هُرَیْرَةَ، پھر فرمایا: اے ابو ہریرہ! اُولٰٓئِكَ الثَّلٰثَةُ، یہ تین لوگ ہوں گے، اَوَّلُ خَلْقِ اللّٰهِ" .

minaret:Segment_HUSN_AKHL-21590_0064 a minaret:TranscriptSegment ;
    minaret:endTime 677.32 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0065 ;
    minaret:sequenceIndex 64 ;
    minaret:startTime 667.32 ;
    minaret:text "اللہ کی مخلوق میں سے پہلے تُسَعَّرُ بِهِمُ النَّارُ یَوْمَ الْقِیٰمَةِ جن کے ذریعے جہنم کی آگ قیامت کے دن بھڑکائی جائے گی" .

minaret:Segment_HUSN_AKHL-21590_0100 a minaret:TranscriptSegment ;
    minaret:endTime 1072.86 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0101 ;
    minaret:sequenceIndex 100 ;
    minaret:startTime 1062.91 ;
    minaret:text "اس لیے کہ قرآن نے ہمیں بتایا: وَمَا یَنْطِقُ عَنِ الْهَوٰی ۟ؕ اِنْ هُوَ اِلَّا وَحْیٌ یُّوْحٰی ۟ۙ کہ آپ اپنی خواہش نفس سے باتیں نہیں" .

minaret:Segment_HUSN_AKHL-21591_0000 a minaret:TranscriptSegment ;
    minaret:endTime 19.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0001 ;
    minaret:sequenceIndex 0 ;
    minaret:startTime 0.0 ;
    minaret:text "نَحْمَدُهٗ وَنُصَلِّیْ عَلٰی رَسُوْلِهِ الْكَرِیْمِ، اَمَّا بَعْدُ، فَاَعُوْذُ بِاللّٰهِ مِنَ الشَّیْطٰنِ الرَّجِیْمِ، بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ، رَبِّ اشْرَحْ لِیْ صَدْرِیْ ۟ۙ وَیَسِّرْ لِیْۤ اَمْرِیْ ۟ۙ وَاحْلُلْ عُقْدَةً مِّنْ لِّسَانِیْ ۟ۙ یَفْقَهُوْا قَوْلِیْ ۪۟" .

minaret:Segment_HUSN_AKHL-21591_0111 a minaret:TranscriptSegment ;
    minaret:endTime 2094.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0112 ;
    minaret:sequenceIndex 111 ;
    minaret:startTime 2074.68 ;
    minaret:text "جنہوں نے ہم پر سب سے زیادہ احسان کیا ہو ان کے عام جملے کیا ہوتے تھے اللہ کا شکر جس نے مجھے اسلام دیا اللہ کا شکر جس نے قرآن دیا اللہ کا شکر جس نے حضور صلی اللہ علیہ وسلم کا ساتھی بنایا اور پھر اَنِ اشْكُرْ لِیْ وَلِوَالِدَیْكَ ؕ" .

minaret:Segment_HUSN_AKHL-21591_0178 a minaret:TranscriptSegment ;
    minaret:endTime 3397.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21591_0179 ;
    minaret:sequenceIndex 178 ;
    minaret:startTime 3377.38 ;
    minaret:text "یا پھر سجیسٹیو ہوتا ہے کہ آپ مشورہ دینے کے انداز میں؟ کیونکہ فرعون کے پاس جب موسیٰ علیہ السلام اور ہارون علیہ السلام کو بھیجا گیا تو کیا کہا گیا تھا؟ فَقُولَا لَهُ قَوْلًا لَيِّنًا ۟، نرم بات کرنا۔ اور پھر: فَقُلْ هَلْ لَكَ إِلَى أَنْ تَزَكَّى ۟ۙ، یہ نہیں کہا تھا" .

minaret:Segment_HUSN_AKHL-21590_0001 a minaret:TranscriptSegment ;
    minaret:endTime 17.3 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0002 ;
    minaret:sequenceIndex 1 ;
    minaret:startTime 11.12 ;
    minaret:text "لِیْ صَدْرِیْ ۟ۙ وَیَسِّرْ لِیْۤ اَمْرِیْ ۟ۙ وَاحْلُلْ عُقْدَةً مِّنْ لِّسَانِیْ ۟ۙ یَفْقَهُوْا قَوْلِیْ ۪۟" .

minaret:Segment_HUSN_AKHL-21590_0034 a minaret:TranscriptSegment ;
    minaret:endTime 379.68 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0035 ;
    minaret:sequenceIndex 34 ;
    minaret:startTime 365.16 ;
    minaret:text "کتاب ختم ہو یا شروع ہو تو جب اللہ تعالی تشریف لائیں گے تاکہ بندوں کا فیصلہ کیا جائے وَكُلُّ اُمَّةٍ جَاثِیَةً ۚ یہ قرآن میں بھی آتا ہے ہر امت ہر گروہ اور امت کیا ہوتی؟" .

minaret:Segment_HUSN_AKHL-21590_0035 a minaret:TranscriptSegment ;
    minaret:endTime 385.38 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0036 ;
    minaret:sequenceIndex 35 ;
    minaret:startTime 379.68 ;
    minaret:text "ایک نظریہ اور ایک دور کے لوگ یعنی ایک گروہ کُلُّ امَّتِنْ ہر امت ہر نیشن ہر قوم" .

minaret:Segment_HUSN_AKHL-21590_0037 a minaret:TranscriptSegment ;
    minaret:endTime 401.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0038 ;
    minaret:sequenceIndex 37 ;
    minaret:startTime 389.44 ;
    minaret:text "لوگوں کی سب اکڑ اور سب تکبر ختم ہو چکا ہوگا اور سب جھکے ہوئے ہوں گے ایسے میں فَاَوَّلُ مَنْ یُّدْعٰی بِهٖ رَجُلٌ جَمَعَ الْقُرْاٰنَ" .

minaret:Segment_HUSN_AKHL-21590_0036 a minaret:TranscriptSegment ;
    minaret:endTime 389.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0037 ;
    minaret:sequenceIndex 36 ;
    minaret:startTime 385.38 ;
    minaret:text "جَاثِیَةً، گھٹنوں کے بل جھکی ہوئی ہوگی۔ یعنی" .

minaret:Dua_MasnoonDua-118 a minaret:Dua ;
    minaret:duaTypeEn "Masnoon Dua" ;
    minaret:duaTypeUr "مسنون دعاء" ;
    minaret:reference "MasnoonDua-118" ;
    minaret:translationEn "O Allah You have made my creation perfect, so make my moral characteristics also be the best." ;
    minaret:translationUr "یااللہ تو نے میری صورت اچھی بنائی ہے ایسے ہی میری سیرت بھی اچھی بنا دے" ;
    minaret:transliteration "" .

