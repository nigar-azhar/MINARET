    minaret:sequenceIndex 269 ;
    minaret:startTime 2784.36 ;
    minaret:text "جسمانی خوبصورتی کے لیے بھی انسان کو تگ و دو کرنی پڑتی ہے کوشش کرنی پڑتی محنت کرنی پڑتی اسی طرح" .

minaret:Segment_HUSN_AKHL-21590_0270 a minaret:TranscriptSegment ;
    minaret:endTime 2804.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0271 ;
    minaret:sequenceIndex 270 ;
    minaret:startTime 2794.4 ;
    minaret:text "باطنی خوبصورتی کے لیے اخلاق کی خوبصورتی کے لیے بھی انسان کو کوشش کرنا پڑتی ہے اس کے لئے بھی محنت ضروری ہے اب دیکھا یہ جائے گا" .

minaret:Segment_HUSN_AKHL-21590_0271 a minaret:TranscriptSegment ;
    minaret:endTime 2811.18 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0272 ;
    minaret:sequenceIndex 271 ;
    minaret:startTime 2804.44 ;
    minaret:text "کہ وہ کیا چیزیں ہیں کہ جو انسان کو خوبصورت بناتی ہے یعنی اخلاق کس چیز کا نام ہے" .

minaret:Segment_HUSN_AKHL-21590_0272 a minaret:TranscriptSegment ;
    minaret:endTime 2821.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0273 ;
    minaret:sequenceIndex 272 ;
    minaret:startTime 2812.66 ;
    minaret:text "اخلاق کو مختلف الفاظ میں آپ ڈیفائن کر سکتے ہیں عربی اصل تو آپ نے دیکھی لی خلق کی جمع ہے اخلاق" .

minaret:Segment_HUSN_AKHL-21590_0273 a minaret:TranscriptSegment ;
    minaret:endTime 2835.44 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0274 ;
    minaret:sequenceIndex 273 ;
    minaret:startTime 2823.02 ;
    minaret:text "عادات معاملات باہمی سلوک برتاؤ جو روز مرہ کی زندگی میں ایک آدمی دوسرے سے کرتا ہے دوسرے لفظوں میں آپ یوں کہیے" .

minaret:Segment_HUSN_AKHL-21590_0274 a minaret:TranscriptSegment ;
    minaret:endTime 2843.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0275 ;
    minaret:sequenceIndex 274 ;
    minaret:startTime 2836.1 ;
    minaret:text "کہ حقوق العباد کی ادائیگی کا بہترین طریقہ انسانوں کے ساتھ رہنے کا بہترین طریقہ" .

minaret:Segment_HUSN_AKHL-21590_0275 a minaret:TranscriptSegment ;
    minaret:endTime 2854.9 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0276 ;
    minaret:sequenceIndex 275 ;
    minaret:startTime 2844.94 ;
    minaret:text "کسی بھی چیز کو بہترین کب کہا جائے گا وہ بہترین کب ہوتی ہے اسلام کی نظر میں احسن عمل کی تعریف کیا ہے" .

minaret:Segment_HUSN_AKHL-21590_0276 a minaret:TranscriptSegment ;
    minaret:endTime 2868.64 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0277 ;
    minaret:sequenceIndex 276 ;
    minaret:startTime 2855.68 ;
    minaret:text "جو اندر سے بھی اچھا ہو اور باہر سے بھی اچھا ہو نیت بھی اچھی اور طریقہ بھی اچھا ہو اور طریقہ اچھا ہو کس بنیاد پر نبی صلی اللہ علیہ وسلم کے طریقے کی بنیاد پر تو پھر ہم دیکھیں گے کہ آپ نے" .

minaret:Segment_HUSN_AKHL-21590_0277 a minaret:TranscriptSegment ;
    minaret:endTime 2878.12 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0278 ;
    minaret:sequenceIndex 277 ;
    minaret:startTime 2869.38 ;
    minaret:text "اچھے معاملے اور اچھے سلوک اور اچھے تعلق کے لیے کیا اصول دیا ہے ہمیں" .

minaret:Segment_HUSN_AKHL-21590_0280 a minaret:TranscriptSegment ;
    minaret:endTime 2908.96 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21590_0281 ;
    minaret:sequenceIndex 280 ;
    minaret:startTime 2898.34 ;
    minaret:text "کہ آپ دوسرے کے لیے کیا چاہیں جو اپنے لیے چاہیں اور اگر آپ اس اصول کو ذہن میں رکھیں تو آپ دیکھیں گے کہ آپ اگر بہت زیادہ" .

minaret:Segment_HUSN_AKHL-21590_0281 a minaret:TranscriptSegment ;
    minaret:endTime 2919.92 ;
