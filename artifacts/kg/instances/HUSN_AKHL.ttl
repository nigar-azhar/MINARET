    minaret:reference "SM_2577" ;
    skos:exactMatch hadith:SM-HD2577 .

minaret:Hadith_SM_2592 a minaret:Hadith ;
    minaret:expandedReference "Sahih Muslim, Book of Virtue, Enjoining Good Manners, and Joining of the Ties of Kinship (Kitab al-Birr wa al-Silah), Chapter: The Virtue of Gentleness, Hadith 2592" ;
    minaret:reference "SM_2592" ;
    skos:exactMatch hadith:SM-HD2592 .

minaret:Hadith_SM_2593 a minaret:Hadith ;
    minaret:expandedReference "Sahih Muslim, Book of Virtue, Enjoining Good Manners, and Joining of the Ties of Kinship (Kitab al-Birr wa al-Silah), Chapter: The Virtue of Gentleness, Hadith 2593" ;
    minaret:reference "SM_2593" ;
    skos:exactMatch hadith:SM-HD2593 .

minaret:Hadith_SM_2594 a minaret:Hadith ;
    minaret:expandedReference "Sahih Muslim, Book of Virtue, Enjoining Good Manners, and Joining of the Ties of Kinship (Kitab al-Birr wa al-Silah), Chapter: The Virtue of Gentleness, Hadith 2594" ;
    minaret:reference "SM_2594" ;
