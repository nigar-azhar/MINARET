minaret:VerseOccurrence_HUSN_AKHL-21590_0006_379_68_45_28 a minaret:VerseOccurrence ;
    minaret:endTime 401.44 ;
    minaret:evidenceText "ہر امت، ہر گروہ، اور امت کیا ہوتی؟ ایک نظریہ اور ایک دور کے لوگ، یعنی ایک گروہ۔ ہر امت، ہر نیشن، ہر قوم، گھٹنوں کے بل جھکی ہوئی ہوگی۔ یعنی لوگوں کی سب اکڑ اور سب تکبر ختم ہو چکا ہوگا اور سب جھکے ہوئے ہوں گے۔" ;
    minaret:hasExtentType minaret:PartialCitation ;
