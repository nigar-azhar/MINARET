minaret:HadithOccurrence_HAJJLT22-7038_0000_422_0_SB_1773 a minaret:HadithOccurrence ;
    minaret:endTime 435.5 ;
    minaret:evidenceText "The performance of Umrah is an expiation for the sins committed between one Umrah and the next, and the reward of Hajj Mabroor is nothing except Jannah" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7038_422_0_435_5 ;
    minaret:refersTo minaret:Hadith_SB_1773 ;
    minaret:startTime 422.0 .

minaret:HadithOccurrence_HAJJLT22-7038_0001_612_0_SN_3140 a minaret:HadithOccurrence ;
    minaret:endTime 625.5 ;
    minaret:evidenceText "A man came to Rasulullah and said: 'What do you think of a man who fights seeking reward and fame, what will he have?' Rasulullah said: 'He will not have anything.'" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7038_612_0_625_5 ;
    minaret:refersTo minaret:Hadith_SN_3140 ;
    minaret:startTime 612.0 .

minaret:HadithOccurrence_HAJJLT22-7038_0002_1449_0_SB_6307 a minaret:HadithOccurrence ;
    minaret:endTime 1456.76 ;
    minaret:evidenceText "Rasulullah, he also would ask Allah to forgive him 70 to 100 times a day" ;
    minaret:hasUsageType minaret:Paraphrase ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7038_1449_0_1456_76 ;
    minaret:refersTo minaret:Hadith_SB_6307 ;
    minaret:startTime 1449.0 .

