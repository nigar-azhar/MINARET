minaret:HadithOccurrence_HAJJLT22-7038_0005_3028_0_AD_1721 a minaret:HadithOccurrence ;
    minaret:endTime 3048.0 ;
    minaret:evidenceText "Ibn Abbas said that he asked Rasulullah: 'Ya Rasulullah, Hajj is to be performed annually or only once?' Rasulullah said: 'Only once, and if anyone performs it more often, he performs a nafl'" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7038_3028_0_3048_0 ;
    minaret:refersTo minaret:Hadith_AD_1721 ;
    minaret:startTime 3028.0 .

minaret:HadithOccurrence_HAJJLT22-7038_0006_3079_26_Ahmad_2867 a minaret:HadithOccurrence ;
    minaret:endTime 3082.44 ;
    minaret:evidenceText "تَعَجَّلُوا إِلَى الْحَجِّ" ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7038_3079_26_3082_44 ;
    minaret:refersTo minaret:Hadith_Ahmad_2867 ;
    minaret:startTime 3079.26 .

minaret:HadithOccurrence_HAJJLT22-7038_0007_3082_44_Ahmad_2867 a minaret:HadithOccurrence ;
    minaret:endTime 3089.0 ;
    minaret:evidenceText "Hasten to do Hajj, for no one of you knows what will happen to him" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7038_3082_44_3089_0 ;
    minaret:refersTo minaret:Hadith_Ahmad_2867 ;
    minaret:startTime 3082.44 .

minaret:HadithOccurrence_HAJJLT22-7038_0008_3113_0_AD_1732 a minaret:HadithOccurrence ;
    minaret:endTime 3123.5 ;
    minaret:evidenceText "Whoever intends to perform Hajj, let him hasten to do so, for he may fall sick, lose his mount, or be faced with some need." ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7038_3113_0_3123_5 ;
    minaret:refersTo minaret:Hadith_AD_1732 ;
    minaret:startTime 3113.0 .

minaret:HadithOccurrence_HAJJLT22-7038_0009_3138_3_JT_810 a minaret:HadithOccurrence ;
    minaret:endTime 3147.0 ;
    minaret:evidenceText "when we perform Hajj and Umrah, then what happens? We don't become poor, that's a Hadith" ;
    minaret:hasUsageType minaret:Paraphrase ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7038_3138_3_3147_0 ;
    minaret:refersTo minaret:Hadith_JT_810 ;
    minaret:startTime 3138.3 .

minaret:HadithOccurrence_HAJJLT22-7038_0010_3159_0_AD_1798 a minaret:HadithOccurrence ;
    minaret:endTime 3205.0 ;
    minaret:evidenceText "I came to Umar and said to him: I was a Christian Bedouin and I have embraced Islam. I am eager to do jihad, and I found that both Hajj and Umrah were due from me... Umar said: 'You have been guided to the practice of your Prophet.'" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7038_3159_0_3205_0 ;
    minaret:refersTo minaret:Hadith_AD_1798 ;
    minaret:startTime 3159.0 .

minaret:HadithOccurrence_HAJJLT22-7039_0000_767_7199999999999_SM_520 a minaret:HadithOccurrence ;
    minaret:endTime 790.24 ;
    minaret:evidenceText "Rasulullah was asked about the masjid which was first set up on the earth. He responded: It was Al-Masjid al-Haram, then Al-Masjid al-Aqsa" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7039_767_7199999999999_790_24 ;
    minaret:refersTo minaret:Hadith_SM_520 ;
    minaret:startTime 767.7199999999999 .

