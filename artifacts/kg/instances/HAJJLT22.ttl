minaret:HadithOccurrence_HAJJLT22-7040_0000_491_42_SB_3364 a minaret:HadithOccurrence ;
    minaret:endTime 560.84 ;
    minaret:evidenceText "May Allah bestow mercy on Ismail's mother. Had she let the Zamzam flow without trying to control it, Zamzam would have been a stream flowing on the surface of the earth..." ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7040_491_42_560_84 ;
