minaret:VerseOccurrence_HAJJLT22-7040_0013_152_24_22_30 a minaret:VerseOccurrence ;
    minaret:endTime 175.74 ;
    minaret:evidenceText "ذٰلِكَ ؕ وَمَنْ یُّعَظِّمْ حُرُمٰتِ اللّٰهِ فَهُوَ خَیْرٌ لَّهٗ عِنْدَ رَبِّهٖ ؕ وَاُحِلَّتْ لَكُمُ الْاَنْعَامُ اِلَّا مَا یُتْلٰی عَلَیْكُمْ فَاجْتَنِبُوا الرِّجْسَ مِنَ الْاَوْثَانِ وَاجْتَنِبُوْا قَوْلَ الزُّوْرِ ۟ۙ" ;
    minaret:hasExtentType minaret:CompleteCitation ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7040_152_24_175_74 ;
    minaret:refersTo minaret:QuranVerse_22_30 ;
    minaret:startTime 152.24 .

