    minaret:endTime 2977.0 ;
    minaret:evidenceText "قَدْ فَرَضَ اللّٰهُ عَلَيْكُمُ الْحَجَّ فَحُجُّوا" ;
    minaret:hasUsageType minaret:Quotation ;
