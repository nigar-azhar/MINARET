minaret:Segment_HAJJLT22-7039_0000 a minaret:TranscriptSegment ;
    minaret:endTime 14.0 ;
    minaret:precedesSegment minaret:Segment_HAJJLT22-7039_0001 ;
    minaret:sequenceIndex 0 ;
    minaret:startTime 0.0 ;
    minaret:text "لَبَّیْكَ اَللّٰهُمَّ لَبَّیْكَ، لَبَّیْكَ لَا شَرِیْكَ لَكَ لَبَّیْكَ، اِنَّ الْحَمْدَ، وَالنِّعْمَةَ لَكَ وَالْمُلْكَ، لَاشَرِیْكَ لَكَ۔" .

minaret:Segment_HAJJLT22-7040_0000 a minaret:TranscriptSegment ;
    minaret:endTime 9.68 ;
    minaret:precedesSegment minaret:Segment_HAJJLT22-7040_0001 ;
    minaret:sequenceIndex 0 ;
    minaret:startTime 0.0 ;
    minaret:text "As-salamu alaykum wa rahmatullahi wa barakatuh everyone. Alhamdulillah, welcome back to the course. Good to see all of you here. Alhamdulillah, let's Insha'Allah begin properly." .

minaret:Topic_Avoiding_Falsehood_Ijtinab_az_Zoor a minaret:Topic ;
    minaret:descriptionEn "Strict prohibition of mendacity, deceit, and false testimony, alongside the denunciation of idols." ;
    minaret:descriptionUr "بت پرستی کے ساتھ ساتھ جھوٹ، فریب اور جھوٹی گواہی سے سخت ممانعت۔" ;
    minaret:nameEn "Avoiding Falsehood (Ijtinab az-Zoor)" ;
    minaret:nameUr "اجتناب از جھوٹ" .

minaret:Topic_Calling_to_Good_Da_wah a minaret:Topic ;
    minaret:descriptionEn "The Prophetic proclamation of pilgrimage by Ibrahim, calling people to the Hajj." ;
    minaret:descriptionUr "سیدنا ابراہیم علیہ السلام کی حج کی طرف بلانے کی اذان۔" ;
    minaret:nameEn "Calling to Good (Da'wah)" ;
    minaret:nameUr "دعوتِ خیر (دعوہ)" .

minaret:Topic_Charity_Sadaqah a minaret:Topic ;
    minaret:descriptionEn "Distributing monetary charity and sharing food and Zamzam with pilgrims in need." ;
    minaret:descriptionUr "مالی صدقہ کرنا اور بھوکوں کو کھانا کھلانا۔" ;
    minaret:nameEn "Charity (Sadaqah)" ;
    minaret:nameUr "صدقہ" .

minaret:Topic_Ease_and_Moderation_in_Worship_Rifq_Yusr a minaret:Topic ;
    minaret:descriptionEn "Avoiding self-imposed hardship and utilizing permissible conveyances in religious devotion." ;
    minaret:descriptionUr "عبادت میں خود ساختہ مشقت سے بچنا اور شرعی رخصتوں و سواریوں سے فائدہ اٹھانا۔" ;
    minaret:nameEn "Ease and Moderation in Worship (Rifq & Yusr)" ;
    minaret:nameUr "دین میں آسانی اور بے جا مشقت کی ممانعت" .

minaret:Topic_Etiquettes_and_Prohibitions_of_Pilgrimage_Ijtinab_ar_Rafath_wal_Fusuq a minaret:Topic ;
    minaret:descriptionEn "Strict prohibition of obscenity, sinful misconduct, and contentious disputes throughout the sacred journey." ;
    minaret:descriptionUr "حج کے دوران شہوانی گفتگو، گناہوں، جھگڑے اور فضول بحث و تکرار سے سختی سے بچنا۔" ;
    minaret:nameEn "Etiquettes and Prohibitions of Pilgrimage (Ijtinab ar-Rafath wal-Fusuq)" ;
    minaret:nameUr "آدابِ حج: رفث، فسوق اور جدال سے ممانعت" .

minaret:Topic_Excellence_and_Rewards_of_Pilgrimage a minaret:Topic ;
    minaret:descriptionEn "The spiritual superiority of Hajj, expiation of past sins, removal of poverty, and being counted among Allah's delegations." ;
    minaret:descriptionUr "حج کی عظمت، گناہوں کا کفارہ، فقر کا خاتمہ اور حجاج کا اللہ کا وفد ہونا۔" ;
    minaret:nameEn "Excellence and Rewards of Pilgrimage" ;
    minaret:nameUr "حج کے فضائل اور درجات" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Feeding_the_Needy_Sadaqah a minaret:Topic ;
    minaret:descriptionEn "The mandate to feed the destitute and impoverished from the sacrifice." ;
    minaret:descriptionUr "قربانی کے گوشت میں سے مساکین و محتاجوں کو کھلانے کا حکم۔" ;
    minaret:nameEn "Feeding the Needy (Sadaqah)" ;
    minaret:nameUr "فقراء کی امداد" .

minaret:Topic_Fulfilling_Vows_and_Legal_Pledges_Al_Wafa_bil_Nadhr a minaret:Topic ;
    minaret:descriptionEn "The mandatory fulfillment of personal religious vows undertaken for the sake of Allah." ;
    minaret:descriptionUr "اللہ کے نام کی مانی گئی جائز نذروں اور منتوں کو شرعاً پورا کرنے کی پابندی۔" ;
    minaret:nameEn "Fulfilling Vows and Legal Pledges (Al-Wafa bil-Nadhr)" ;
    minaret:nameUr "نذر اور عہد کو پورا کرنا" .

minaret:Topic_Hastening_to_Good_Deeds_Al_Mubadarah_ilal_Khayrat a minaret:Topic ;
    minaret:descriptionEn "Performing obligatory Hajj promptly without delaying for marriage, worldly accumulation, or old age, given life's uncertainties." ;
    minaret:descriptionUr "صحت اور مال کے میسر آتے ہی بغیر تاخیر حج ادا کرنا اور دنیاوی حیلوں یا بڑھاپے کے انتظار سے اجتناب کرنا۔" ;
    minaret:nameEn "Hastening to Good Deeds (Al-Mubadarah ilal-Khayrat)" ;
    minaret:nameUr "نیکیوں میں جلدی (المبادرۃ الی الخیرات)" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Ihsan a minaret:Topic ;
    minaret:descriptionEn "Going beyond the minimum for fellow pilgrims -- caring for the elderly and gifting authentic educational literature." ;
    minaret:descriptionUr "معمر حجاج کا خاص خیال رکھنا اور مستند دعاؤں و طریقۂ حج کی کتب بطور تحفہ دینا۔" ;
    minaret:nameEn "Ihsan" ;
    minaret:nameUr "ایثار" .

minaret:Topic_Jurisprudence_of_Ihsar_Impediments_to_Pilgrimage a minaret:Topic ;
    minaret:descriptionEn "Rules governing pilgrims prevented from completing Hajj or Umrah due to sickness, injury, or hostility." ;
    minaret:descriptionUr "بیماری، دشمن یا مجبوری کی بنا پر حج یا عمرہ سے رک جانے والے کے لیے شرعی احکام اور دمِ احصار۔" ;
    minaret:nameEn "Jurisprudence of Ihsar (Impediments to Pilgrimage)" ;
    minaret:nameUr "احصار اور رکاوٹ کے شرعی احکام" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Jurisprudence_of_Pilgrimage_Modalities_Fiqh_al_Hajj a minaret:Topic ;
    minaret:descriptionEn "Legal criteria, timelines, and procedural distinctions between Hajj Tamattu', Qiran, and Ifrad." ;
    minaret:descriptionUr "حج تمتع، قران اور افراد کی شرعی شرائط، اوقات اور افضلیت کے فقہی احکام۔" ;
    minaret:nameEn "Jurisprudence of Pilgrimage Modalities (Fiqh al-Hajj)" ;
    minaret:nameUr "مناسک و اقسامِ حج کی فقہ" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Monotheism_and_Sincerity_Tawheed a minaret:Topic ;
    minaret:descriptionEn "Foundational establishment of pure Tawheed at the Kaaba, shunning all forms of idolatry and shirk." ;
    minaret:descriptionUr "بیت اللہ کی بنیاد خالص توحید پر قائم کرنے اور ہر قسم کے شرک اور بت پرستی کی نفی۔" ;
    minaret:nameEn "Monotheism and Sincerity (Tawheed)" ;
    minaret:nameUr "خالص توحید اور اخلاص" ;
    skos:closeMatch hadith:Tauhid .

minaret:Topic_Patience_Sabr a minaret:Topic ;
    minaret:descriptionEn "Enduring travel hardships with emotional resilience and remaining steadfast in obedience." ;
    minaret:descriptionUr "سفر کی مشکلات پر صبر اور اطاعت میں ثابت قدمی۔" ;
    minaret:nameEn "Patience (Sabr)" ;
    minaret:nameUr "صبر" .

minaret:Topic_Pilgrimage_Modalities_and_Fasting_Expiation_Tamattu_Siyam a minaret:Topic ;
    minaret:descriptionEn "The legitimacy of Hajj Tamattu' and the substitution of ten fasts when sacrificial livestock cannot be procured." ;
    minaret:descriptionUr "حج تمتع کا شرعی ثبوت اور قربانی کی استطاعت نہ ہونے پر دس روزوں (تین حج میں، سات گھر واپسی پر) کی ادائیگی۔" ;
    minaret:nameEn "Pilgrimage Modalities and Fasting Expiation (Tamattu' & Siyam)" ;
    minaret:nameUr "اقسامِ حج اور قربانی کے بدل کے روزے" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Prophetic_Authority_and_Ritual_Adherence_Manasik a minaret:Topic ;
    minaret:descriptionEn "The command of Rasulullah to learn pilgrimage rites directly from his practice without human innovation." ;
    minaret:descriptionUr "رسول اللہ صلی اللہ علیہ وسلم کا فرمان کہ مناسکِ حج مجھ سے سیکھو اور من گھڑت طریقوں سے اجتناب کرو۔" ;
    minaret:nameEn "Prophetic Authority and Ritual Adherence (Manasik)" ;
    minaret:nameUr "اتباعِ سنت اور مناسکِ حج کی ادائیگی" .

minaret:Topic_Remembrance_of_Allah_Dhikrullah a minaret:Topic ;
    minaret:descriptionEn "Continuous glorification of Allah during the first ten days of Dhul-Hijjah and the days of Tashreeq." ;
    minaret:descriptionUr "عشرہ ذوالحجہ اور ایام تشریق میں تکبیر، تحمید اور تسبیح کے ذریعے کثرت سے اللہ کا ذکر۔" ;
    minaret:nameEn "Remembrance of Allah (Dhikrullah)" ;
    minaret:nameUr "کثرتِ ذکرِ الٰہی" .

minaret:Topic_Sacrifice_Hady a minaret:Topic ;
    minaret:descriptionEn "Ritual slaughter of sacrificial livestock during Hajj." ;
    minaret:descriptionUr "حج کے دوران قربانی کے جانور ذبح کرنا۔" ;
    minaret:nameEn "Sacrifice (Hady)" ;
    minaret:nameUr "قربانی" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Sacrificial_Animals_and_Fidya_for_Violations_Hady_Kaffarah a minaret:Topic ;
    minaret:descriptionEn "Compensatory ransoms of fasting, charity, or sacrifice for shaving or committing unavoidable Ihram infractions." ;
    minaret:descriptionUr "عذر کی بنا پر احرام کی پابندی ٹوٹنے پر روزہ، صدقہ یا ذبح کی صورت میں فدیہ ادا کرنا۔" ;
    minaret:nameEn "Sacrificial Animals and Fidya for Violations (Hady & Kaffarah)" ;
    minaret:nameUr "قربانی اور احرام کے ممنوعات کا فدیہ" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Sanctity_and_Cleanliness_of_Sacred_Spaces_Taharah a minaret:Topic ;
    minaret:descriptionEn "Inward spiritual purification from sins and outward cleanliness of the House of Allah for worshippers." ;
    minaret:descriptionUr "گناہوں اور معصیت سے باطنی پاکیزگی اور نمازیوں و طواف کرنے والوں کے لیے مسجد کی ظاہری صفائی۔" ;
    minaret:nameEn "Sanctity and Cleanliness of Sacred Spaces (Taharah)" ;
    minaret:nameUr "شعائر و مساجد کی ظاہری و باطنی طہارت" .

minaret:Topic_Sanctity_and_Virtues_of_Makkah a minaret:Topic ;
    minaret:descriptionEn "The sacred status of Makkah as Al-Balad al-Amin, its blessings, security, and multiplication of rewards." ;
    minaret:descriptionUr "مکہ مکرمہ کی حرمت، امن و سلامتی، برکات اور وہاں نیکیوں پر اجر کی کثرت کا بیان۔" ;
    minaret:nameEn "Sanctity and Virtues of Makkah" ;
    minaret:nameUr "مکہ مکرمہ کا احترام اور فضائل" .

minaret:Topic_Seeking_Forgiveness_Istighfar_Tawbah a minaret:Topic ;
    minaret:descriptionEn "Maintaining constant repentance morning and evening, reflecting upon personal shortcomings, and adhering to the Prophetic tradition of istighfar." ;
    minaret:descriptionUr "صبح و شام کثرت سے استغفار کرنا، اپنی کوتاہیوں کا اعتراف اور روزانہ کثرت سے توبہ کی نبوی سنت پر عمل پیرا ہونا۔" ;
    minaret:nameEn "Seeking Forgiveness (Istighfar & Tawbah)" ;
    minaret:nameUr "استغفار اور توبہ" .

minaret:Topic_Seeking_Islamic_Knowledge_Talab_al_Ilm a minaret:Topic ;
    minaret:descriptionEn "Preparing for worship through authentic Quranic and Sunnah knowledge, personal day-planners, and studying verified religious guides." ;
    minaret:descriptionUr "حج کے ارکان کو سنت کے مطابق ادا کرنے کے لیے پیشگی علم حاصل کرنا، نوٹس بنانا اور غلطیوں سے حفاظت کی تیاری۔" ;
    minaret:nameEn "Seeking Islamic Knowledge (Talab al-'Ilm)" ;
    minaret:nameUr "طلبِ علمِ دین" .

minaret:Topic_Sincerity_and_Exclusivity_of_Devotion_Ikhlas a minaret:Topic ;
    minaret:descriptionEn "Undertaking pilgrimage solely for the pleasure of Allah, completely free of ostentation, pride, or worldly gain." ;
    minaret:descriptionUr "حج و عمرہ کو خالص اللہ کی رضا کے لیے ادا کرنا اور ریا، شہرت اور نمائش سے مکمل بچنا۔" ;
    minaret:nameEn "Sincerity and Exclusivity of Devotion (Ikhlas)" ;
    minaret:nameUr "اخلاصِ نیت اور ریاکاری کی ممانعت" .

minaret:Topic_Sincerity_in_Worship_Ikhlas a minaret:Topic ;
    minaret:descriptionEn "Fulfilling pilgrimage rites purely for the pleasure and approval of Allah, guarding against ostentation, fame, and double intentions." ;
    minaret:descriptionUr "ریاکاری، نام ونمود اور دوہری نیت سے بچتے ہوئے حج اور تمام عبادات کو خالصتاً رضائے الٰہی کے لیے ادا کرنا۔" ;
    minaret:nameEn "Sincerity in Worship (Ikhlas)" ;
    minaret:nameUr "اخلاص فی العبادت" .

minaret:Topic_The_Islamic_Will_Al_Wasiyyah a minaret:Topic ;
    minaret:descriptionEn "The legal and spiritual necessity of drafting a binding Islamic will to settle all debts and moral responsibilities before departing." ;
    minaret:descriptionUr "سفرِ حج پر روانگی سے قبل مالی و شرعی حقوق کی ادائیگی اور ایک قانونی و شرعی وصیت نامہ تحریر کرنے کی اہمیت۔" ;
    minaret:nameEn "The Islamic Will (Al-Wasiyyah)" ;
    minaret:nameUr "وصیت نامہ (الوصیہ)" .

minaret:Topic_Truthfulness_Sidq a minaret:Topic ;
    minaret:descriptionEn "The virtue and command of speaking truthfully." ;
    minaret:descriptionUr "سچ بولنے کی فضیلت اور حکم۔" ;
    minaret:nameEn "Truthfulness (Sidq)" ;
    minaret:nameUr "سچائی" .

minaret:Topic_Veneration_of_Divine_Symbols_Ta_dheem_Sha_air_Allah a minaret:Topic ;
    minaret:descriptionEn "Honoring sacred places, sacrificial beasts, and pilgrimage ordinances as evidence of piety in the heart." ;
    minaret:descriptionUr "مقدس مقامات، قربانی کے جانوروں اور مناسک کی تعظیم جو دلوں کے تقویٰ کی علامت ہے۔" ;
    minaret:nameEn "Veneration of Divine Symbols (Ta'dheem Sha'air Allah)" ;
    minaret:nameUr "شعائرِ الٰہی کی تعظیم" .

minaret:Topic_Virtues_of_Hajj_and_Umrah a minaret:Topic ;
    minaret:descriptionEn "Expiation of sins through consecutive Umrahs and the guaranteed reward of Paradise (Jannah) for an accepted Hajj (Hajj Mabroor)." ;
    minaret:descriptionUr "پے در پے عمروں کے ذریعے گناہوں کا کفارہ اور حج مبرور کے بدلے جنت کی قطعی بشارت۔" ;
    minaret:nameEn "Virtues of Hajj and Umrah" ;
    minaret:nameUr "فضائل حج و عمرہ" ;
    skos:closeMatch hadith:PillarsOfIslam .

