    minaret:endTime 1029.5 ;
    minaret:evidenceText "Perform Hajj and Umrah one after the other, for performing them one after the other removes poverty and sin as the bellows removes impurity from iron" ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7039_1014_34_1029_5 ;
    minaret:refersTo minaret:Hadith_IbnMajah_2898 ;
    minaret:startTime 1014.34 .

