minaret:VerseOccurrence_HAJJLT22-7040_0009_91_76_22_28 a minaret:VerseOccurrence ;
    minaret:endTime 135.54 ;
    minaret:evidenceText "لِّیَشْهَدُوْا مَنَافِعَ لَهُمْ وَیَذْكُرُوا اسْمَ اللّٰهِ فِیْۤ اَیَّامٍ مَّعْلُوْمٰتٍ عَلٰی مَا رَزَقَهُمْ مِّنْۢ بَهِیْمَةِ الْاَنْعَامِ ۚ فَكُلُوْا مِنْهَا وَاَطْعِمُوا الْبَآىِٕسَ الْفَقِیْرَ ۟" ;
    minaret:hasExtentType minaret:CompleteCitation ;
    minaret:hasUsageType minaret:Quotation ;
    minaret:occursIn minaret:SegmentGroup_HAJJLT22-7040_91_76_135_54 ;
    minaret:refersTo minaret:QuranVerse_22_28 ;
    minaret:startTime 91.76 .

