    minaret:precedesSegment minaret:Segment_SKD2025-0004_0141 ;
    minaret:sequenceIndex 140 ;
    minaret:startTime 684.66 ;
    minaret:text " ادراک ہے  نعمت  منعم کے ادراک" .

minaret:Segment_SKD2025-0004_0141 a minaret:TranscriptSegment ;
