minaret:asrModel a owl:DatatypeProperty ;
    rdfs:domain minaret:Transcript ;
    rdfs:range xsd:string .

minaret:belongsToSeries a owl:ObjectProperty ;
    rdfs:label "belongs to series" ;
    rdfs:domain minaret:Recording ;
    rdfs:range minaret:AudioSeries ;
    owl:inverseOf minaret:hasRecording .

minaret:category a owl:DatatypeProperty ;
    rdfs:comment "Parent/top-level category only, assigned manually per series (e.g. Quran for TQ2005, Hadith for HUSN_AKHL). Replaces the earlier separate Domain class -- one field, not two parallel representations of the same fact." ;
    rdfs:domain minaret:AudioSeries ;
    rdfs:range xsd:string .

minaret:categoryId a owl:DatatypeProperty ;
    rdfs:comment "The publisher's raw category_id, kept for provenance/joinback only -- not elaborated into a class hierarchy." ;
    rdfs:domain minaret:AudioSeries ;
    rdfs:range xsd:integer .

minaret:correctionModel a owl:DatatypeProperty ;
    rdfs:domain minaret:Transcript ;
    rdfs:range xsd:string .

minaret:correctionPromptVersion a owl:DatatypeProperty ;
    rdfs:domain minaret:Transcript ;
    rdfs:range xsd:string .

minaret:datePublication a owl:DatatypeProperty ;
    rdfs:comment "Used on both AudioSeries (series-level) and Recording (per-recording, from the publisher's upload date where available)." ;
    rdfs:range xsd:date .

minaret:descriptionEn a owl:DatatypeProperty ;
    rdfs:domain minaret:Topic ;
    rdfs:range xsd:string .

minaret:descriptionUr a owl:DatatypeProperty ;
    rdfs:domain minaret:Topic ;
    rdfs:range xsd:string .

minaret:duaTypeEn a owl:DatatypeProperty ;
    rdfs:domain minaret:Dua ;
    rdfs:range xsd:string .

minaret:duaTypeUr a owl:DatatypeProperty ;
    rdfs:domain minaret:Dua ;
    rdfs:range xsd:string .

minaret:durationSeconds a owl:DatatypeProperty ;
    rdfs:comment "The source duration is a formatted string (H:MM:SS); parse to seconds on ingestion." ;
    rdfs:domain minaret:Audio ;
    rdfs:range xsd:decimal .

minaret:endTime a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

minaret:evidenceText a owl:DatatypeProperty ;
    rdfs:comment "Domain: VerseOccurrence, HadithOccurrence, DuaOccurrence. The as-spoken text supporting this occurrence." ;
    rdfs:range xsd:string .

minaret:expandedReference a owl:DatatypeProperty ;
    rdfs:domain minaret:Hadith ;
    rdfs:range xsd:string .

minaret:followsSegment a owl:ObjectProperty ;
    rdfs:label "follows segment" ;
    rdfs:domain minaret:TranscriptSegment ;
    rdfs:range minaret:TranscriptSegment ;
    owl:inverseOf minaret:precedesSegment .

minaret:groupId a owl:DatatypeProperty ;
    rdfs:domain minaret:SegmentGroup ;
    rdfs:range xsd:string .

minaret:hasOccurrence a owl:ObjectProperty ;
    rdfs:label "has occurrence" ;
    rdfs:comment "Range: VerseOccurrence, HadithOccurrence, or DuaOccurrence." ;
    rdfs:domain minaret:SegmentGroup ;
    owl:inverseOf minaret:occursIn .

minaret:isAudioOfRecording a owl:ObjectProperty ;
    rdfs:label "is audio of recording" ;
    rdfs:domain minaret:Audio ;
    rdfs:range minaret:Recording ;
    owl:inverseOf minaret:hasAudio .

minaret:isContainedInSegmentGroup a owl:ObjectProperty ;
    rdfs:label "is contained in segment group" ;
    rdfs:domain minaret:TranscriptSegment ;
    rdfs:range minaret:SegmentGroup ;
    owl:inverseOf minaret:containsSegment .

minaret:isDiscussedIn a owl:ObjectProperty ;
    rdfs:label "is discussed in" ;
    rdfs:domain minaret:Topic ;
    rdfs:range minaret:SegmentGroup ;
    owl:inverseOf minaret:discussesTopic .

minaret:isExtentTypeOf a owl:ObjectProperty ;
    rdfs:label "is extent type of" ;
    rdfs:domain minaret:CitationExtent ;
    owl:inverseOf minaret:hasExtentType .

minaret:isHeadingOfRecording a owl:ObjectProperty ;
    rdfs:label "is heading of recording" ;
    rdfs:domain minaret:Heading ;
    rdfs:range minaret:Recording ;
    owl:inverseOf minaret:hasHeading .

minaret:isLanguageOfRecording a owl:ObjectProperty ;
    rdfs:label "is language of recording" ;
    rdfs:domain minaret:Language ;
    rdfs:range minaret:Recording ;
    owl:inverseOf minaret:hasLanguage .

minaret:isPrimaryLanguageOfRecording a owl:ObjectProperty ;
    rdfs:label "is primary language of recording" ;
    rdfs:domain minaret:Language ;
    rdfs:range minaret:Recording ;
    owl:inverseOf minaret:hasPrimaryLanguage .

minaret:isPrimarySpeakerOfRecording a owl:ObjectProperty ;
    rdfs:label "is primary speaker of recording" ;
    rdfs:domain minaret:Speaker ;
    rdfs:range minaret:Recording ;
    owl:inverseOf minaret:hasPrimarySpeaker .

minaret:isReferencedBy a owl:ObjectProperty ;
    rdfs:label "is referenced by" ;
    rdfs:comment "Domain: QuranVerse, Hadith, or Dua. Range: VerseOccurrence, HadithOccurrence, or DuaOccurrence respectively." ;
    owl:inverseOf minaret:refersTo .

minaret:isSegmentOfTranscript a owl:ObjectProperty ;
    rdfs:label "is segment of transcript" ;
    rdfs:domain minaret:TranscriptSegment ;
    rdfs:range minaret:Transcript ;
    owl:inverseOf minaret:hasSegment .

minaret:isSpeakerOfRecording a owl:ObjectProperty ;
