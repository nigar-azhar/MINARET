    minaret:sequenceIndex 444 ;
    minaret:startTime 2478.36 ;
    minaret:text " ہر چیز کو negative دیکھتے ہیں  وہ صرف اس negativity کو  اپنے تک نہیں رکھتے" .

minaret:Segment_SKD2025-0001_0445 a minaret:TranscriptSegment ;
