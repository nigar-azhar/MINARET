    minaret:sequenceIndex 452 ;
    minaret:startTime 2511.6 ;
    minaret:text " اور بےاعتمادی پیدا ہوتی ہے confidence loseکر جاتا ہے انسان  اور کہتے ہیں کہ" .

minaret:Segment_SKD2025-0001_0453 a minaret:TranscriptSegment ;
