    minaret:startTime 2270.64 ;
    minaret:text " ایک دروازہ بند ہوئے  تو دوسرے کسی دروازے سے  آپ کہاں پہنچنے والے ہیں" .

minaret:Segment_SKD2025-0001_0406 a minaret:TranscriptSegment ;
    minaret:endTime 2279.2799999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0407 ;
    minaret:sequenceIndex 406 ;
    minaret:startTime 2274.56 ;
    minaret:text " لیکن یہ ہے کہ اگر ہم چاہتے ہیں  کہ اللہ سبحانہ وتعالی ہماری دعائیں  قبول کرے" .

minaret:Segment_SKD2025-0001_0407 a minaret:TranscriptSegment ;
    minaret:endTime 2284.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0408 ;
    minaret:sequenceIndex 407 ;
    minaret:startTime 2279.2799999999997 ;
    minaret:text " تو پھر پورے اخلاص کے ساتھ  توجہ کے ساتھ  قبولیت کے یقین کے ساتھ" .

minaret:Segment_SKD2025-0001_0408 a minaret:TranscriptSegment ;
    minaret:endTime 2289.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0409 ;
    minaret:sequenceIndex 408 ;
    minaret:startTime 2284.74 ;
    minaret:text " خُشُوع و خُضُوع کے ساتھ  عاجزی کے ساتھ  تکرار اور اسرار کے ساتھ دعائیں کریں" .

minaret:Segment_SKD2025-0001_0413 a minaret:TranscriptSegment ;
    minaret:endTime 2314.66 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0414 ;
    minaret:sequenceIndex 413 ;
    minaret:startTime 2308.0 ;
    minaret:text " مٹھی بند کر کے دعا کر رہے   پھر دعا کے آداب بھی ہمیں پتہ ہونے چاہیے  اسماء حسنہ کو وسیلہ بنا کے دعا کریں" .

minaret:Segment_SKD2025-0001_0414 a minaret:TranscriptSegment ;
    minaret:endTime 2318.84 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0415 ;
    minaret:sequenceIndex 414 ;
    minaret:startTime 2314.66 ;
    minaret:text " اس سے بھی قبولیت ہوتی ہے  أبو الدرداءؓ جو تھے  وہ کہتے ہیں کہ" .

minaret:Segment_SKD2025-0001_0415 a minaret:TranscriptSegment ;
    minaret:endTime 2324.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0416 ;
    minaret:sequenceIndex 415 ;
    minaret:startTime 2318.84 ;
    minaret:text " اللہ مومنوں پر رحم فرمائے  اور اس کے بعد صرف کہتے تھے  ربنا ربنا ربنا" .

minaret:Segment_SKD2025-0001_0416 a minaret:TranscriptSegment ;
    minaret:endTime 2327.62 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0417 ;
    minaret:sequenceIndex 416 ;
    minaret:startTime 2324.04 ;
    minaret:text " بس  دعا کرنے کے بعد  ایک دفعہ مانگ لیتے" .

minaret:Segment_SKD2025-0001_0417 a minaret:TranscriptSegment ;
    minaret:endTime 2333.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0418 ;
    minaret:sequenceIndex 417 ;
    minaret:startTime 2327.62 ;
    minaret:text " کہ ربنا ربنا ربنا  صرف اللہ کا نام پکارتے رہتے ہیں  کوئی بھی نام آپ پکار سکتے ہیں" .

minaret:Segment_SKD2025-0001_0421 a minaret:TranscriptSegment ;
    minaret:endTime 2361.1 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0422 ;
    minaret:sequenceIndex 421 ;
    minaret:startTime 2356.38 ;
    minaret:text " دعا کی ایک تاثیر  اس لحاظ سے بھی بہت ہوتی ہے  کہ اس میں انسان" .

minaret:Segment_SKD2025-0001_0422 a minaret:TranscriptSegment ;
    minaret:endTime 2365.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0423 ;
    minaret:sequenceIndex 422 ;
    minaret:startTime 2361.1 ;
    minaret:text " مثبت جملے بولتا ہے  مثبت بات کرتا ہے  آپ کوپتا ہے جو الفاظ" .

minaret:Segment_SKD2025-0001_0423 a minaret:TranscriptSegment ;
    minaret:endTime 2368.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0424 ;
    minaret:sequenceIndex 423 ;
    minaret:startTime 2365.4 ;
    minaret:text " ہمارےمنہ سے نکلتے ہیں  ان کی تاثیر ہوتی ہے  کوئی آپ کو" .

minaret:Segment_SKD2025-0001_0424 a minaret:TranscriptSegment ;
    minaret:endTime 2374.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0425 ;
    minaret:sequenceIndex 424 ;
    minaret:startTime 2368.98 ;
    minaret:text " ایک اچھا سا خوبصورت جملہ بولتا ہے  اچھی سے کوئی بات کرتا ہے  poetry پر آپ کیوں اتنی واہ واہ کرتے ہیں" .

minaret:Segment_SKD2025-0001_0425 a minaret:TranscriptSegment ;
    minaret:endTime 2381.2599999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0426 ;
    minaret:sequenceIndex 425 ;
    minaret:startTime 2374.5 ;
    minaret:text " کیونکہ وہ ایک ہی بات کہنے کا انداز بڑا خوبصورت ہوتا ہے  تو ایک معمولی سی بات  اگر خوبصورت انداز میں کہی جائے" .

minaret:Segment_SKD2025-0001_0426 a minaret:TranscriptSegment ;
    minaret:endTime 2386.2599999999998 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0427 ;
    minaret:sequenceIndex 426 ;
    minaret:startTime 2381.2599999999998 ;
    minaret:text " تو اس کی value بڑھ جاتی ہے  ٹھیک ہے نا  تو ابھی جیسے میں پاکستان آئی ہوں نا" .

minaret:Segment_SKD2025-0001_0427 a minaret:TranscriptSegment ;
    minaret:endTime 2390.94 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0428 ;
    minaret:sequenceIndex 427 ;
    minaret:startTime 2386.2599999999998 ;
    minaret:text " تو surprise دیا تھا میں نے  کہ چلیں سب کو خوش کروں گی  کچھ لوگ تو بہت خوش ہوئے" .

minaret:Segment_SKD2025-0001_0428 a minaret:TranscriptSegment ;
    minaret:endTime 2396.7999999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0429 ;
    minaret:sequenceIndex 428 ;
    minaret:startTime 2390.94 ;
    minaret:text " تو بہت اچھا کیا  لیکن کچھ جملے negative بھی تھے  انہوں نے بم پھوڑا آکے" .

minaret:Segment_SKD2025-0001_0429 a minaret:TranscriptSegment ;
    minaret:endTime 2403.8599999999997 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0430 ;
    minaret:sequenceIndex 429 ;
    minaret:startTime 2396.7999999999997 ;
    minaret:text " یہ مثبت جملہ یا منفی  منفی ہے نا  کیا واقعی میں نے بم پھوڑا آکے" .

minaret:Segment_SKD2025-0001_0430 a minaret:TranscriptSegment ;
    minaret:endTime 2409.72 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0431 ;
    minaret:sequenceIndex 430 ;
    minaret:startTime 2403.8599999999997 ;
    minaret:text " یعنی کہ بے سوچے سمجھے  منہ سے نکالتے ہیں نا  بات تو surprise کی تھی" .

minaret:Segment_SKD2025-0001_0431 a minaret:TranscriptSegment ;
    minaret:endTime 2418.1 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0432 ;
    minaret:sequenceIndex 431 ;
    minaret:startTime 2409.72 ;
    minaret:text " بات تو surprise کی تھی  لیکن ہم کسی بھی surprise پر ایسے باتیں کرتے ہیں  ہمیں اپنے گفتگو کا انداز بدلنا ہے" .

minaret:Segment_SKD2025-0001_0432 a minaret:TranscriptSegment ;
    minaret:endTime 2425.1000000000004 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0433 ;
    minaret:sequenceIndex 432 ;
    minaret:startTime 2418.1 ;
    minaret:text " منفی سے مثبت کی طرف آنا ہے  ساری زندگی میں  دعاوں کی تاثیر کب زیادہ ہوتی ہیں" .

minaret:Segment_SKD2025-0001_0433 a minaret:TranscriptSegment ;
