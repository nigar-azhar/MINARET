    minaret:precedesSegment minaret:Segment_SKD2025-0004_0140 ;
    minaret:sequenceIndex 139 ;
    minaret:startTime 681.16 ;
    minaret:text " نعمت کی معرفت  حقیقت میں  منعم حقیقی کا" .

minaret:Segment_SKD2025-0004_0140 a minaret:TranscriptSegment ;
