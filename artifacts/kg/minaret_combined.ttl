    minaret:precedesSegment minaret:Segment_SKD2025-0004_0157 ;
    minaret:sequenceIndex 156 ;
    minaret:startTime 731.62 ;
    minaret:text " دل  یا اس کی گواہی دے رہا ہوتا  یا نہیں دے رہا ہوتا" .

minaret:Segment_SKD2025-0004_0157 a minaret:TranscriptSegment ;
    minaret:endTime 738.84 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0158 ;
    minaret:sequenceIndex 157 ;
    minaret:startTime 734.64 ;
    minaret:text " اچھا کچھ لوگ صرف عادتا کہتے ہیں  الحمدللہ  آپ پوچھتے کیا حال ہے" .

minaret:Segment_SKD2025-0004_0158 a minaret:TranscriptSegment ;
    minaret:endTime 741.92 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0159 ;
    minaret:sequenceIndex 158 ;
    minaret:startTime 738.84 ;
    minaret:text " الحمدللہ  اور  سب ٹھیک ہے نا" .

minaret:Segment_SKD2025-0004_0159 a minaret:TranscriptSegment ;
