minaret:containsSegment a owl:ObjectProperty ;
    rdfs:label "contains segment" ;
    rdfs:comment "Materialized once at graph-construction time from timestamp overlap. Never authored by hand." ;
    rdfs:domain minaret:SegmentGroup ;
    rdfs:range minaret:TranscriptSegment .

minaret:discussesTopic a owl:ObjectProperty ;
    rdfs:label "discusses topic" ;
    rdfs:domain minaret:SegmentGroup ;
    rdfs:range minaret:Topic .

minaret:hasAudio a owl:ObjectProperty ;
    rdfs:label "has audio" ;
    rdfs:domain minaret:Recording ;
    rdfs:range minaret:Audio .

minaret:hasHeading a owl:ObjectProperty ;
    rdfs:label "has heading" ;
    rdfs:domain minaret:Recording ;
    rdfs:range minaret:Heading .

minaret:hasLanguage a owl:ObjectProperty ;
    rdfs:label "has language" ;
    rdfs:comment "For secondary/code-switched languages beyond the primary. Currently unused." ;
    rdfs:domain minaret:Recording ;
    rdfs:range minaret:Language .

minaret:hasPrimaryLanguage a owl:ObjectProperty ;
    rdfs:label "has primary language" ;
    rdfs:domain minaret:Recording ;
    rdfs:range minaret:Language .

minaret:hasPrimarySpeaker a owl:ObjectProperty ;
    rdfs:label "has primary speaker" ;
    rdfs:domain minaret:Recording ;
    rdfs:range minaret:Speaker .

minaret:hasRecording a owl:ObjectProperty ;
    rdfs:label "has recording" ;
    rdfs:domain minaret:AudioSeries ;
    rdfs:range minaret:Recording .

minaret:hasSegment a owl:ObjectProperty ;
    rdfs:label "has segment" ;
    rdfs:domain minaret:Transcript ;
    rdfs:range minaret:TranscriptSegment .

minaret:hasSpeaker a owl:ObjectProperty ;
    rdfs:label "has speaker" ;
    rdfs:comment "For co-speakers beyond the primary. Currently unused -- no built series has more than one speaker." ;
    rdfs:domain minaret:Recording ;
    rdfs:range minaret:Speaker .

minaret:hasTranscript a owl:ObjectProperty ;
    rdfs:label "has transcript" ;
    rdfs:domain minaret:Recording ;
    rdfs:range minaret:Transcript .

minaret:precedesSegment a owl:ObjectProperty ;
    rdfs:label "precedes segment" ;
    rdfs:comment "Adjacent-pair link within one Transcript, in sequenceIndex order (sequenceIndex(a)+1 = sequenceIndex(b)). Redundant with sequenceIndex/startTime for query purposes -- SPARQL can already order/filter on those -- but sequenceIndex is a literal, so it never renders as a graph edge in tools like GraphDB's Visual Graph. This makes segment order directly navigable/visible there." ;
    rdfs:domain minaret:TranscriptSegment ;
    rdfs:range minaret:TranscriptSegment .

minaret:Dua_MasnoonDua-205 a minaret:Dua ;
    minaret:duaTypeEn "Masnoon Dua" ;
    minaret:duaTypeUr "مسنون دعاء" ;
    minaret:reference "MasnoonDua-205" ;
    minaret:translationEn "O Allah, bestow Your Mercy upon Muhammad and upon the family of Muhammad, as You bestowed Your Mercy upon Ibrahim and on the family of Ibrahim, for You are the Most Praise-worthy, the Most Glorious. O Allah, bestow Your Blessings upon Muhammad and upon the family of Muhammad, as You bestowed your Blessings upon Ibrahim and upon the family of Ibraheem. Indeed You are the Most Praise-worthy, the Most Glorious." ;
    minaret:translationUr "اے اللہ! محمد ﷺ اور آلِ محمد ﷺ پر اسی طرح رحمت نازل فرما جس طرح تو نے ابراہیم علیہ السلام اور آلِ ابراہیم پر رحمت نازل فرمائی۔ بے شک تو بہت تعریف والا بہت بزرگی والاہے، اے اللہ! محمد ﷺ اور آلِ محمد ﷺ پر اسی طرح برکت نازل فرما جس طرح تو نے ابراہیم (علیہ السلام ) اور آلِ ابراہیم پر برکت نازل فرمائی بے شک تو بہت تعریف والا بہت بزرگی والا ہے۔" ;
    minaret:transliteration "" .

minaret:Dua_QuranicDua-09 a minaret:Dua ;
    minaret:duaTypeEn "Qurani Dua" ;
    minaret:duaTypeUr "قرآنى دعاء‎" ;
    minaret:reference "QuranicDua-09" ;
    minaret:translationEn "My Lord, increase me in knowledge." ;
    minaret:translationUr "اے میرے رب ! میرے علم میں اضافہ فرما" ;
    minaret:transliteration "Rabbi zidni ilma" .

minaret:Dua_QuranicDua-46 a minaret:Dua ;
    minaret:duaTypeEn "Qurani Dua" ;
    minaret:duaTypeUr "قرآنى دعاء‎" ;
    minaret:reference "QuranicDua-46" ;
    minaret:translationEn "Indeed, adversity has touched me, and you are the most merciful of the merciful." ;
    minaret:translationUr "(اے رب! ) بے شک مجھے تکلیف پہنچی ہے اور تو رحم کرنے والوں میں سب سے بڑھ کر رحم کرنے والا ہے" ;
    minaret:transliteration "Anni massaniya al-durru wa anta arhamu al-rahimeen" .

minaret:Hadith_AD_4682 a minaret:Hadith ;
    minaret:expandedReference "Sunan Abi Dawud, Book 42 (Model Behavior of the Prophet / Kitab As-Sunnah), Chapter: Degree of Faith, Hadith 4682" ;
    minaret:reference "AD_4682" ;
    minaret:textUthmani "حَدَّثَنَا  أَحْمَدُ بْنُ حَنْبَلٍ  ، حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ  ، عَنْ  مُحَمَّدِ بْنِ عَمْرٍو  ، عَنْ  أَبِي سَلَمَةَ  ، عَنْ  أَبِي هُرَيْرَةَ  ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَكْمَلُ الْمُؤْمِنِينَ إِيمَانًا أَحْسَنُهُمْ خُلُقًا \" ." ;
    minaret:translationEn "Narrated Abu Hurairah: The Prophet ﷺ said: The most perfect believer in respect of faith is he who is best of them in manners." ;
    minaret:translationUr "´ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ` رسول اللہ صلی اللہ علیہ وسلم نے فرمایا : ” مومنوں میں سب سے کامل ایمان والا وہ ہے جو ان میں سب سے بہتر اخلاق والا ہے “ ۔" ;
    skos:exactMatch hadith:SD-HD4682 .

minaret:Hadith_Ahmad_24392 a minaret:Hadith ;
    minaret:expandedReference "Musnad Ahmad, Musnad al-Ansar, Hadith of Sayyidah Aisha, Hadith 24392" ;
    minaret:reference "Ahmad_24392" .

minaret:Hadith_Ahmad_24427 a minaret:Hadith ;
    minaret:expandedReference "Musnad Ahmad ibn Hanbal, Baqi Musnad al-Ansar, Hadith Sayyidah 'Aisha (RA), Hadith 24427" ;
    minaret:reference "Ahmad_24427" .

minaret:Hadith_Ahmad_2867 a minaret:Hadith ;
    minaret:expandedReference "Musnad Ahmad, Musnad Bani Hashim, Hadith of Abdullah ibn Abbas, Hadith 2867" ;
    minaret:reference "Ahmad_2867" .

minaret:Hadith_Ahmad_8952 a minaret:Hadith ;
    minaret:expandedReference "Musnad Ahmad, Musnad Abi Hurairah, Hadith 8952 (also Al-Adab Al-Mufrad 273)" ;
    minaret:reference "Ahmad_8952" .

minaret:Hadith_IM_3436 a minaret:Hadith ;
    minaret:expandedReference "Sunan Ibn Majah, Book 31 (Chapters on Medicine), Chapter 1: Medicine and Healing, Hadith 3436" ;
    minaret:reference "IM_3436" ;
    minaret:textUthmani "حَدَّثَنَا   أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ   ,   وَهِشَامُ ابْنُ عَمَّارٍ   , قَالَا ، حَدَّثَنَا   سُفْيَانُ بْنُ عُيَيْنَةَ   , عَنْ   زِيَادِ بْنِ عِلَاقَةَ   , عَنْ   أُسَامَةَ بْنِ شَرِيكٍ   , قَالَ : شَهِدْتُ الْأَعْرَابَ يَسْأَلُونَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَعَلَيْنَا حَرَجٌ فِي كَذَا ؟ أَعَلَيْنَا حَرَجٌ فِي كَذَا ؟ فَقَالَ لَهُمْ : \" عِبَادَ اللَّهِ ,وَضَعَ اللَّهُ الْحَرَجَ إِلَّا مَنِ اقْتَرَضَ مِنْ عِرْضِ أَخِيهِ شَيْئًا , فَذَاكَ الَّذِي حَرِجَ \" , فَقَالُوا : يَا رَسُولَ اللَّهِ , هَلْ عَلَيْنَا جُنَاحٌ أَنْ لَا نَتَدَاوَى ؟ قَالَ : \" تَدَاوَوْا عِبَادَ اللَّهِ , فَإِنَّ اللَّهَ سُبْحَانَهُ لَمْ يَضَعْ دَاءً إِلَّا وَضَعَ مَعَهُ شِفَاءً , إِلَّا الْهَرَمَ \" , قَالُوا : يَا رَسُولَ اللَّهِ , مَا خَيْرُ مَا أُعْطِيَ الْعَبْدُ ؟ قَالَ : \" خُلُقٌ حَسَنٌ \" ." ;
    minaret:translationUr "´اسامہ بن شریک رضی اللہ عنہ کہتے ہیں کہ` میں نے اعرابیوں کو نبی اکرم صلی اللہ علیہ وسلم سے سوال کرتے دیکھا کہ کیا فلاں معاملے میں ہم پر گناہ ہے ؟ کیا فلاں معاملے میں ہم پر گناہ ہے ؟ تو آپ صلی اللہ علیہ وسلم نے فرمایا : ” اللہ کے بندو ! ان میں سے کسی میں بھی اللہ تعالیٰ نے گناہ نہیں رکھا سوائے اس کے کہ کوئی اپنے بھائی کی عزت سے کچھ بھی کھیلے ، تو دراصل یہی گناہ ہے “ ، انہوں نے کہا : اللہ کے رسول ! اگر ہم دوا علاج نہ کریں تو اس میں بھی گناہ ہے ؟ آپ صلی اللہ علیہ وسلم نے فرمایا : ” اللہ کے بندو ! دوا علاج کرو ، اس لیے کہ اللہ تعالیٰ نے کوئی ایسا مرض نہیں بنایا جس کی شفاء اس کے ساتھ نہ بنائی ہو سوائے بڑھاپے کے “ ، انہوں نے عرض کیا : اللہ کے رسول ! بندے کو جو چیزیں اللہ تعالیٰ نے عطا کی ہیں ان میں سے سب بہتر چیز کیا ہے ؟ آپ صلی اللہ علیہ وسلم نے ارشاد فرمایا : ” حسن اخلاق “ ۔" ;
    skos:exactMatch hadith:IM-HD3436 .

minaret:Hadith_JT_1987 a minaret:Hadith ;
    minaret:expandedReference "Jami` at-Tirmidhi, Book 27 (Chapters on Righteousness and Maintaining Good Relations), Chapter 55: Fear of Allah and Good Conduct, Hadith 1987" ;
    minaret:reference "JT_1987" ;
    minaret:translationUr "´ابوذر رضی الله عنہ کہتے ہیں کہ` رسول اللہ صلی اللہ علیہ وسلم نے فرمایا : ” جہاں بھی رہو اللہ سے ڈرو ، برائی کے بعد ( جو تم سے ہو جائے ) بھلائی کرو جو برائی کو مٹا دے ۱؎ اور لوگوں کے ساتھ حسن اخلاق سے پیش آؤ “ ۔ © امام ترمذی کہتے ہیں : ¤ ۱- یہ حدیث حسن صحیح ہے ، ¤ ۲- اس باب میں ابوہریرہ رضی الله عنہ سے بھی روایت ہے ۔" ;
    skos:exactMatch hadith:JT-HD1987 .

minaret:Hadith_JT_2003 a minaret:Hadith ;
    minaret:expandedReference "Jami` at-Tirmidhi, Book 27 (Chapters on Righteousness and Maintaining Good Relations), Chapter 62: Good Character, Hadith 2003" ;
    minaret:reference "JT_2003" ;
    minaret:translationUr "´ابو الدرداء رضی الله عنہ کہتے ہیں کہ` میں نے نبی اکرم صلی اللہ علیہ وسلم کو فرماتے ہوئے سنا : ” میزان میں رکھی جانے والی چیزوں میں سے اخلاق حسنہ ( اچھے اخلاق ) سے بڑھ کر کوئی چیز وزنی نہیں ہے ، اور اخلاق حسنہ کا حامل اس کی بدولت روزہ دار اور نمازی کے درجہ تک پہنچ جائے گا “ ۔ © امام ترمذی کہتے ہیں : ¤ یہ حدیث اس سند سے غریب ہے ۔" ;
    skos:exactMatch hadith:JT-HD2003 .

minaret:Hadith_JT_2317 a minaret:Hadith ;
    minaret:expandedReference "Jāmiʿ at-Tirmidhī, Kitāb az-Zuhd (Book 36: Asceticism), Bāb 11, Hadith 2317" ;
    minaret:reference "JT_2317" ;
    minaret:translationUr "´ابوہریرہ رضی الله عنہ کہتے ہیں کہ` رسول اللہ صلی اللہ علیہ وسلم نے فرمایا : ” کسی شخص کے اسلام کی خوبی یہ ہے کہ وہ لایعنی اور فضول باتوں کو چھوڑ دے “ ۱؎ ۔ © امام ترمذی کہتے ہیں : ¤ ۱- یہ حدیث غریب ہے ، ¤ ۲- ہم اس حدیث کو ابوسلمہ کی روایت سے جسے وہ ابوہریرہ رضی الله عنہ سے اور ابوہریرہ رضی الله عنہ نبی اکرم صلی اللہ علیہ وسلم سے روایت کرتے ہیں صرف اسی سند سے جانتے ہیں ۔" ;
    skos:exactMatch hadith:JT-HD2317 .

minaret:Hadith_JT_2382 a minaret:Hadith ;
    minaret:expandedReference "Jami` at-Tirmidhi, Book 36 (Chapters on Zuhd), Chapter 48: Regarding Riya' and Seeking Fame, Hadith 2382" ;
    minaret:reference "JT_2382" ;
    minaret:translationUr "´عقبہ بن مسلم سے شفیا اصبحی نے بیان کیا کہ` ایک مرتبہ وہ مدینہ میں داخل ہوئے ، اچانک ایک آدمی کو دیکھا جس کے پاس کچھ لوگ جمع تھے ، انہوں نے پوچھا کہ یہ کون ہیں ؟ لوگوں نے جواباً عرض کیا : یہ ابوہریرہ رضی الله عنہ ہیں ، شفیا اصبحی کا بیان ہے کہ میں ان کے قریب ہوا یہاں تک کہ ان کے سامنے بیٹھ گیا اور وہ لوگوں سے حدیث بیان کر رہے تھے ، جب وہ حدیث بیان کر چکے اور تنہا رہ گئے تو میں نے ان سے کہا : میں آپ سے اللہ کا باربار واسطہ دے کر پوچھ رہا ہوں کہ آپ مجھ سے ایسی حدیث بیان کیجئے جسے آپ نے رسول اللہ صلی اللہ علیہ وسلم سے سنا ہو اور اسے اچھی طرح جانا اور سمجھا ہو ۔ ابوہریرہ رضی الله عنہ نے فرمایا : ٹھیک ہے ، یقیناً میں تم سے ایسی حدیث بیان کروں گا جسے مجھ سے رسول اللہ صلی اللہ علیہ وسلم نے بیان کیا ہے اور میں نے اسے اچھی طرح جانا اور سمجھا ہے ۔ پھر ابوہریرہ نے زور کی چیخ ماری اور بیہوش ہو گئے ، تھوڑی دیر بعد جب افاقہ ہوا تو فرمایا : یقیناً میں تم سے وہ حدیث بیان کروں گا جسے رسول اللہ صلی اللہ علیہ وسلم نے مجھ سے اسی گھر میں بیان کیا تھا جہاں میرے سوا کوئی نہیں تھا ، پھر دوبارہ ابوہریرہ نے چیخ ماری اور بیہوش ہو گئے ، پھر جب افاقہ ہوا تو اپنے چہرے کو پونچھا اور فرمایا : ضرور میں تم سے وہ حدیث بیان کروں گا جسے رسول اللہ صلی اللہ علیہ وسلم نے مجھ سے بیان کیا ہے اور اس گھر میں میرے اور آپ کے سوا کوئی نہیں تھا ، پھر ابوہریرہ نے زور کی چیخ ماری اور بیہوش ہو گئے ، اپنے چہرے کو پونچھا اور پھر جب افاقہ ہوا تو فرمایا : ضرور میں تم سے وہ حدیث بیان کروں گا جسے رسول اللہ صلی اللہ علیہ وسلم نے مجھ سے بیان کیا ہے اور اس گھر میں میرے اور آپ کے سوا کوئی نہیں تھا ، پھر ابوہریرہ نے زور کی چیخ ماری اور بیہوش ہو کر منہ کے بل زمین پر گر پڑے ، میں نے بڑی دیر تک انہیں اپنا سہارا دیئے رکھا پھر جب افاقہ ہوا تو فرمایا : رسول اللہ صلی اللہ علیہ وسلم نے مجھ سے یہ حدیث بیان کی ہے : ” قیامت کے دن جب ہر امت گھٹنوں کے بل پڑی ہو گی تو اللہ تعالیٰ اپنے بندوں کے درمیان فیصلے کے لیے نزول فرمائے گا ، پھر اس وقت فیصلہ کے لیے سب سے پہلے ایسے شخص کو بلایا جائے گا جو قرآن کا حافظ ہو گا ، دوسرا شہید ہو گا اور تیسرا مالدار ہو گا ، اللہ تعالیٰ حافظ قرآن سے کہے گا : کیا میں نے تجھے اپنے رسول پر نازل کردہ کتاب کی تعلیم نہیں دی تھی ؟ وہ کہے گا : یقیناً اے میرے رب ! اللہ تعالیٰ فرمائے گا جو علم تجھے سکھایا گیا اس کے مطابق تو نے کیا عمل کیا ؟ وہ کہے گا : میں اس قرآن کے ذریعے راتوں دن تیری عبادت کرتا تھا ، اللہ تعالیٰ فرمائے گا : تو نے جھوٹ کہا اور فرشتے بھی اس سے کہیں گے کہ تو نے جھوٹ کہا ، پھر اللہ تعالیٰ کہے گا : ( قرآن سیکھنے سے ) تیرا مقصد یہ تھا کہ لوگ تجھے قاری کہیں ، سو تجھے کہا گیا ، پھر صاحب مال کو پیش کیا جائے گا اور اللہ تعالیٰ اس سے پوچھے گا : کیا میں نے تجھے ہر چیز کی وسعت نہ دے رکھی تھی ، یہاں تک کہ تجھے کسی کا محتاج نہیں رکھا ؟ وہ عرض کرے گا : یقیناً میرے رب ! اللہ تعالیٰ فرمائے گا : میں نے تجھے جو چیزیں دی تھیں اس میں کیا عمل کیا ؟ وہ کہے گا : صلہ رحمی کرتا تھا اور صدقہ و خیرات کرتا تھا ، اللہ تعالیٰ فرمائے گا : تو نے جھوٹ کہا اور فرشتے بھی اسے جھٹلائیں گے ، پھر اللہ تعالیٰ فرمائے گا : بلکہ تم یہ چاہتے تھے کہ تمہیں سخی کہا جائے ، سو تمہیں سخی کہا گیا ، اس کے بعد شہید کو پیش کیا جائے گا ، اللہ تعالیٰ اس سے پوچھے گا : تجھے کس لیے قتل کیا گیا ؟ وہ عرض کرے گا : مجھے تیری راہ میں جہاد کا حکم دیا گیا چنانچہ میں نے جہاد کیا یہاں تک کہ شہید ہو گیا ، اللہ تعالیٰ اس سے کہے گا : تو نے جھوٹ کہا ، فرشتے بھی اسے جھٹلائیں گے ، پھر اللہ تعالیٰ فرمائے گا : تیرا مقصد یہ تھا کہ تجھے بہادر کہا جائے سو تجھے کہا گیا “ ، پھر رسول اللہ صلی اللہ علیہ وسلم نے میرے زانو پر اپنا ہاتھ مار کر فرمایا : ابوہریرہ ! یہی وہ پہلے تین شخص ہیں جن سے قیامت کے دن جہنم کی آگ بھڑکائی جائے گی “ ۔ © امام ترمذی کہتے ہیں : ¤ ولید ابوعثمان کہتے ہیں : عقبہ بن مسلم نے مجھے خبر دی کہ شفیا اصبحی ہی نے معاویہ رضی الله عنہ کے پاس جا کر انہیں اس حدیث سے باخبر کیا تھا ۔ ابوعثمان کہتے ہیں : علاء بن ابی حکیم نے مجھ سے بیان کیا کہ وہ معاویہ رضی الله عنہ کے جلاد تھے ، پھر معاویہ کے پاس ایک آدمی پہنچا اور ابوہریرہ رضی الله عنہ کے واسطہ سے اس حدیث سے انہیں باخبر کیا تو معاویہ نے کہا : ان تینوں کے ساتھ ایسا معاملہ ہوا تو باقی لوگوں کے ساتھ کیا ہو گا ، یہ کہہ کر معاویہ زار و قطار رونے لگے یہاں تک کہ ہم نے سمجھا کہ وہ زندہ نہیں بچیں گے ، اور ہم لوگوں نے یہاں تک کہہ ڈالا کہ یہ شخص شر لے کر آیا ہے ، پھر جب معاویہ رضی الله عنہ کو افاقہ ہوا تو انہوں نے اپنے چہرے کو صاف کیا اور فرمایا : ” یقیناً اللہ اور اس کے رسول نے سچ فرمایا ہے اور اس آیت کریمہ کی تلاوت کی «من كان يريد الحياة الدنيا وزينتها نوف إليهم أعمالهم فيها وهم فيها لا يبخسون أولئك الذين ليس لهم في الآخرة إلا النار وحبط ما صنعوا فيها وباطل ما كانوا يعملون» ” جو شخص دنیاوی زندگی اور اس کی زیب و زینت کو چاہے گا تو ہم دنیا ہی میں اس کے اعمال کا پورا پورا بدلہ دے دیں گے اور کوئی کمی نہیں کریں گے ، یہ وہی لوگ ہیں جن کا آخرت میں جہنم کے علاوہ اور کوئی حصہ نہیں ہے اور دنیا کے اندر ہی ان کے سارے اعمال ضائع اور باطل ہو گئے “ ( سورۃ ہود : ۱۶ ) ۔ © امام ترمذی کہتے ہیں : ¤ یہ حدیث حسن غریب ہے ۔" ;
    skos:exactMatch hadith:JT-HD2382 .

minaret:Hadith_JT_2488 a minaret:Hadith ;
    minaret:expandedReference "Jami' at-Tirmidhi, Chapters on the Description of the Day of Judgement (Sifat al-Qiyamah), Hadith 2488" ;
    minaret:reference "JT_2488" ;
    minaret:translationUr "´عبداللہ بن مسعود رضی الله عنہ کہتے ہیں کہ` رسول اللہ صلی اللہ علیہ وسلم نے فرمایا : ” کیا میں تمہیں ایسے لوگوں کی خبر نہ دوں جو جہنم کی آگ پر یا جہنم کی آگ ان پر حرام ہے ؟ جہنم کی آگ لوگوں کے قریب رہنے والے ، آسانی کرنے والے ، اور نرم اخلاق والے پر حرام ہے “ ۱؎ ۔ © امام ترمذی کہتے ہیں : ¤ یہ حدیث حسن غریب ہے ۔" ;
    skos:exactMatch hadith:JT-HD2488 .

minaret:Hadith_JT_2517 a minaret:Hadith ;
    minaret:expandedReference "Jami at-Tirmidhi; Book 37, Description of the Day of Judgement, Ar-Riqaq and Al-Wara; chapter 60, Tie it and rely upon Allah; hadith 2517" ;
    minaret:reference "JT_2517" ;
    minaret:translationUr "´انس بن مالک رضی الله عنہ کہتے ہیں کہ` ایک شخص نے عرض کیا : اللہ کے رسول ! کیا میں اونٹ کو پہلے باندھ دوں پھر اللہ پر توکل کروں یا چھوڑ دوں پھر توکل کروں ؟ آپ نے فرمایا : ” اسے باندھ دو ، پھر توکل کرو “ ۔ عمرو بن علی الفلاس کہتے ہیں : یحییٰ بن سعید القطان نے کہا کہ ہمارے نزدیک یہ حدیث منکر ہے ۔ © امام ترمذی کہتے ہیں : ¤ ۱- یہ حدیث انس کی روایت سے غریب ہے ، اسے ہم صرف اسی سند سے جانتے ہیں ۔ ¤ ۲- اسی طرح سے یہ حدیث عمرو بن امیہ ضمری کے واسطہ سے بھی نبی اکرم صلی اللہ علیہ وسلم سے مروی ہے ۔" ;
    skos:exactMatch hadith:JT-HD2517 .

minaret:Hadith_JT_2684 a minaret:Hadith ;
    minaret:expandedReference "Jami` at-Tirmidhi, Book 41 (Chapters on Knowledge), Chapter 19: What Has Been Related Regarding Understanding the Religion, Hadith 2684" ;
    minaret:reference "JT_2684" ;
    minaret:translationUr "´ابوہریرہ رضی الله عنہ کہتے ہیں کہ` رسول اللہ صلی اللہ علیہ وسلم نے فرمایا : ” منافق میں دو خصلتیں ( صفتیں ) جمع نہیں ہو سکتی ہیں : حسن اخلاق اور دین کی سمجھ “ ۔ © امام ترمذی کہتے ہیں : ¤ ۱- یہ حدیث غریب ہے ، ¤ ۲- ہم عوف کی اس حدیث کو صرف شیخ خلف بن ایوب عامری کی روایت سے جانتے ہیں ، اور ابوکریب محمد بن علاء کے سوا کسی کو ہم نہیں جانتے جس نے خلف بن ایوب عامری سے روایت کی ہے ، اور ہم نہیں جانتے کہ وہ کیسے شخص ہیں ۔" ;
    skos:exactMatch hadith:JT-HD2684 .

minaret:Hadith_JT_810 a minaret:Hadith ;
    minaret:expandedReference "Jami at-Tirmidhi; Book 9, Hajj; chapter 2, Rewards for Hajj and Umrah; hadith 810",
        "Jami` at-Tirmidhi, Book on Hajj, Chapter: What Has Been Related About Combining Hajj and 'Umrah, Hadith 810" ;
    minaret:reference "JT_810" ;
    minaret:translationUr "´عبداللہ بن مسعود رضی الله عنہ کہتے ہیں کہ` رسول اللہ صلی اللہ علیہ وسلم نے فرمایا : ” حج اور عمرہ ایک کے بعد دوسرے کو ادا کرو اس لیے کہ یہ دونوں فقر اور گناہوں کو اس طرح مٹا دیتے ہیں جیسے بھٹی لوہے ، سونے اور چاندی کے میل کو مٹا دیتی ہے اور حج مبرور ۱؎ کا بدلہ صرف جنت ہے “ ۔ © امام ترمذی کہتے ہیں : ¤ ۱- ابن مسعود کی حدیث حسن ہے ، اور ابن مسعود کی روایت سے غریب ہے ، ¤ ۲- اس باب میں عمر ، عامر بن ربیعہ ، ابوہریرہ ، عبداللہ بن حبشی ، ام سلمہ اور جابر رضی الله عنہم سے بھی احادیث آئی ہیں ۔" ;
    skos:exactMatch hadith:JT-HD0810 .

minaret:Hadith_SB_1773 a minaret:Hadith ;
    minaret:expandedReference "Sahih al-Bukhari, Book of Umrah, Chapter: The Obligation of 'Umrah and Its Virtues, Hadith 1773" ;
    minaret:reference "SB_1773" ;
    minaret:textUthmani "حَدَّثَنَا  عَبْدُ اللَّهِ بْنُ يُوسُفَ  ، أَخْبَرَنَا  مَالِكٌ  ، عَنْ  سُمَيٍّ  مَوْلَى أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ  أَبِي صَالِحٍ السَّمَّانِ  ، عَنْ  أَبِي هُرَيْرَةَ  رَضِيَ اللَّهُ عَنْهُ ، \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : الْعُمْرَةُ إِلَى الْعُمْرَةِ كَفَّارَةٌ لِمَا بَيْنَهُمَا ، وَالْحَجُّ الْمَبْرُورُ لَيْسَ لَهُ جَزَاءٌ إِلَّا الْجَنَّةُ \" ." ;
    minaret:translationEn "Narrated Abu Huraira: Allah's Apostle said, \"(The performance of) `Umra is an expiation for the sins committed (between it and the previous one). And the reward of Hajj Mabrur (the one accepted by Allah) is nothing except Paradise.\"" ;
    minaret:translationUr "´ہم سے عبداللہ بن یوسف نے بیان کیا ، انہوں نے کہا کہ ہم کو امام مالک نے خبر دی ، انہیں ابوبکر بن عبدالرحمٰن کے غلام سمی نے خبر دی ، انہیں ابوصالح سمان نے خبر دی اور انہیں ابوہریرہ رضی اللہ عنہ نے کہ` رسول اللہ صلی اللہ علیہ وسلم نے فرمایا ایک عمرہ کے بعد دوسرا عمرہ دونوں کے درمیان کے گناہوں کا کفارہ ہے اور حج مبرور کی جزا جنت کے سوا اور کچھ نہیں ہے ۔" ;
    skos:exactMatch hadith:SB-HD1773 .

minaret:Hadith_SB_5089 a minaret:Hadith ;
    minaret:expandedReference "Sahih al-Bukhari, Book of Wedlock, Chapter: The Condition Made by a Woman Who Fearing Sickness at Ihram, Hadith 5089" ;
    minaret:reference "SB_5089" ;
    minaret:textUthmani "حَدَّثَنَا  عُبَيْدُ بْنُ إِسْمَاعِيلَ  ، حَدَّثَنَا  أَبُو أُسَامَةَ  ، عَنْ  هِشَامٍ  ، عَنْ  أَبِيهِ  ، عَنْ  عَائِشَةَ  ، قَالَتْ : \" دَخَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى ضُبَاعَةَ بِنْتِ الزُّبَيْرِ ، فَقَالَ لَهَا : لَعَلَّكِ أَرَدْتِ الْحَجَّ ؟ قَالَتْ : وَاللَّهِ لَا أَجِدُنِي إِلَّا وَجِعَةً ، فَقَالَ لَهَا : حُجِّي وَاشْتَرِطِي ، وَقُولِي : اللَّهُمَّ مَحِلِّي حَيْثُ حَبَسْتَنِي \"، وَكَانَتْ تَحْتَ الْمِقْدَادِ بْنِ الْأَسْوَدِ ." ;
    minaret:translationEn "Narrated `Aisha: Allah's Apostle entered upon Dubaa bint Az-Zubair and said to her, \"Do you have a desire to perform the Hajj?\" She replied, \"By Allah, I feel sick.\" He said to her, \"Intend to perform Hajj and stipulate something by saying, 'O Allah, I will finish my Ihram at any place where You stop me (i.e. I am unable to go further).\" She was the wife of Al-Miqdad bin Al-Aswad." ;
    minaret:translationUr "´ہم سے عبید بن اسماعیل نے بیان کیا ، کہا ہم سے ابواسامہ نے بیان کیا ان سے ہشام بن عروہ نے ، ان سے ان کے والد نے اور ان سے عائشہ رضی اللہ عنہا نے بیان کیا کہ` رسول اللہ صلی اللہ علیہ وسلم ضباعہ بنت زبیر رضی اللہ عنہما کے پاس گئے ( یہ زبیر عبدالمطلب کے بیٹے اور نبی کریم صلی اللہ علیہ وسلم کے چچا تھے ) اور ان سے فرمایا شاید تمہارا ارادہ حج کا ہے ؟ انہوں نے عرض کیا : اللہ کی قسم ! میں تو اپنے آپ کو بیمار پاتی ہوں نبی کریم صلی اللہ علیہ وسلم نے ان سے فرمایا کہ پھر بھی حج کا احرام باندھ لے ۔ البتہ شرط لگا لینا اور یہ کہہ لینا کہ اے اللہ ! میں اس وقت حلال ہو جاؤں گی جب تو مجھے ( مرض کی وجہ سے ) روک لے گا ۔ اور ( ضباعہ بنت زبیر قریشی رضی اللہ عنہا ) مقداد بن اسود رضی اللہ عنہ کے نکاح میں تھیں ۔" ;
    skos:exactMatch hadith:SB-HD5089 .

minaret:Hadith_SB_6030 a minaret:Hadith ;
    minaret:expandedReference "Sahih al-Bukhari, Book of Good Manners (Kitab al-Adab), Chapter: Gentleness in All Matters, Hadith 6030" ;
    minaret:reference "SB_6030" ;
    minaret:textUthmani "حَدَّثَنَا   مُحَمَّدُ بْنُ سَلَامٍ  ، أَخْبَرَنَا   عَبْدُ الْوَهَّابِ  ، عَنْ   أَيُّوبَ  ، عَنْ   عَبْدِ اللَّهِ بْنِ أَبِي مُلَيْكَةَ  ، عَنْ   عَائِشَةَ  رَضِيَ اللَّهُ عَنْهَا ، أَنَّ يَهُودَ أَتَوْا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالُوا : السَّامُ عَلَيْكُمْ ، فَقَالَتْ عَائِشَةُ : عَلَيْكُمْ وَلَعَنَكُمُ اللَّهُ وَغَضِبَ اللَّهُ عَلَيْكُمْ ، قَالَ : \" مَهْلًا يَا عَائِشَةُ عَلَيْكِ بِالرِّفْقِ وَإِيَّاكِ وَالْعُنْفَ وَالْفُحْشَ \" قَالَتْ : أَوَلَمْ تَسْمَعْ مَا قَالُوا ! قَالَ : \" أَوَلَمْ تَسْمَعِي مَا قُلْتُ ، رَدَدْتُ عَلَيْهِمْ فَيُسْتَجَابُ لِي فِيهِمْ ، وَلَا يُسْتَجَابُ لَهُمْ فِيَّ \" ." ;
    minaret:translationEn "Narrated `Abdullah bin Mulaika: `Aisha said that the Jews came to the Prophet and said, \"As-Samu 'Alaikum\" (death be on you). `Aisha said (to them), \"(Death) be on you, and may Allah curse you and shower His wrath upon you!\" The Prophet said, \"Be calm, O `Aisha ! You should be kind and lenient, and beware of harshness and Fuhsh (i.e. bad words).\" She said (to the Prophet), \"Haven't you heard what they (Jews) have said?\" He said, \"Haven't you heard what I have said (to them)? I said the same to them, and my invocation against them will be accepted while theirs against me will be rejected (by Allah). \"" ;
    minaret:translationUr "´ہم سے محمد بن سلام نے بیان کیا ، کہا ہم کو عبدالوہاب ثقفی نے خبر دی ، انہیں ایوب سختیانی نے ، انہیں عبداللہ بن ابی ملیکہ نے اور انہیں عائشہ رضی اللہ عنہا نے کہ` کچھ یہودی رسول اللہ صلی اللہ علیہ وسلم کے یہاں آئے اور کہا «السام عليكم‏.‏» ( تم پر موت آئے ) اس پر عائشہ رضی اللہ عنہا نے کہا «عليكم ،‏‏‏‏ ولعنكم الله ،‏‏‏‏ وغضب الله عليكم‏.‏» کہ تم پر بھی موت آئے اور اللہ کی تم پر لعنت ہو اور اس کا غضب تم پر نازل ہو ۔ لیکن نبی کریم صلی اللہ علیہ وسلم نے فرمایا ، ( ٹھہرو ) عائشہ ! تمہیں نرم خوئی اختیار کرنے چاہیے سختی اور بد زبانی سے بچنا چاہیئے ۔ عائشہ رضی اللہ عنہا نے عرض کیا : یا رسول اللہ ! آپ نے ان کی بات نہیں سنی ، نبی کریم صلی اللہ علیہ وسلم نے فرمایا کہ تم نے انہیں میرا جواب نہیں سنا ، میں نے ان کی بات انہیں پر لوٹا دی اور ان کے حق میں میری بددعا قبول ہو جائے گی ۔ لیکن میرے حق میں ان کی بددعا قبول ہی نہ ہو گی ۔" ;
    skos:exactMatch hadith:SB-HD6030 .

minaret:Hadith_SB_723 a minaret:Hadith ;
    minaret:expandedReference "Ṣaḥīḥ al-Bukhārī, Kitāb al-Adhān (Book 10: Call to Prayers), Bāb 74, Hadith 723" ;
    minaret:reference "SB_723" ;
    minaret:textUthmani "حَدَّثَنَا  أَبُو الْوَلِيدِ  ، قَالَ : حَدَّثَنَا  شُعْبَةُ  ، عَنْ  قَتَادَةَ  ، عَنْ  أَنَسٍ  ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" سَوُّوا صُفُوفَكُمْ فَإِنَّ تَسْوِيَةَ الصُّفُوفِ مِنْ إِقَامَةِ الصَّلَاةِ \" ." ;
    minaret:translationEn "Narrated Anas bin Malik: The Prophet said, \"Straighten your rows as the straightening of rows is essential for a perfect and correct prayer. \"" ;
    minaret:translationUr "´ہم سے ابوالولید ہشام بن عبدالملک نے بیان کیا ، کہا کہ ہم کو شعبہ نے قتادہ کے واسطہ سے خبر دی ، انہوں نے انس رضی اللہ عنہ سے کہ` نبی کریم صلی اللہ علیہ وسلم نے فرمایا کہ صفیں برابر رکھو کیونکہ صفوں کا برابر رکھنا نماز کے قائم کرنے میں داخل ہے ۔" ;
    skos:exactMatch hadith:SB-HD0723 .

minaret:Hadith_SM_2310 a minaret:Hadith ;
    minaret:expandedReference "Sahih Muslim, Book 43 (The Book of Virtues), Chapter 13: His Good Character, Hadith 2310" ;
    minaret:reference "SM_2310" ;
    skos:exactMatch hadith:SM-HD2310 .

minaret:Hadith_SM_2577 a minaret:Hadith ;
    minaret:expandedReference "Sahih Muslim, Book of Virtue, Enjoining Good Manners, and Joining of the Ties of Kinship (Kitab al-Birr wa al-Silah), Chapter: The Prohibition of Injustice, Hadith 2577" ;
    minaret:reference "SM_2577" ;
    skos:exactMatch hadith:SM-HD2577 .

minaret:Hadith_SM_2592 a minaret:Hadith ;
    minaret:expandedReference "Sahih Muslim, Book of Virtue, Enjoining Good Manners, and Joining of the Ties of Kinship (Kitab al-Birr wa al-Silah), Chapter: The Virtue of Gentleness, Hadith 2592" ;
    minaret:reference "SM_2592" ;
    skos:exactMatch hadith:SM-HD2592 .

minaret:Hadith_SM_2593 a minaret:Hadith ;
    minaret:expandedReference "Sahih Muslim, Book of Virtue, Enjoining Good Manners, and Joining of the Ties of Kinship (Kitab al-Birr wa al-Silah), Chapter: The Virtue of Gentleness, Hadith 2593" ;
    minaret:reference "SM_2593" ;
    skos:exactMatch hadith:SM-HD2593 .

minaret:Hadith_SM_2594 a minaret:Hadith ;
    minaret:expandedReference "Sahih Muslim, Book of Virtue, Enjoining Good Manners, and Joining of the Ties of Kinship (Kitab al-Birr wa al-Silah), Chapter: The Virtue of Gentleness, Hadith 2594" ;
    minaret:reference "SM_2594" ;
    skos:exactMatch hadith:SM-HD2594 .

minaret:Hadith_SM_746 a minaret:Hadith ;
    minaret:expandedReference "Sahih Muslim, Book 4 (The Book of Prayer - Travelers), Chapter: Night Prayer and Recitation, Hadith 746a" ;
    minaret:reference "SM_746" ;
    minaret:textUthmani "وحَدَّثَنِيهِ   أَحْمَدُ الدَّارِمِيُّ  ، حَدَّثَنَا   زَكَرِيَّاءُ بْنُ عَدِيٍّ  ، حَدَّثَنَا   يَزِيدُ يَعْنِي ابْنَ زُرَيْعٍ  ، عَنْ   رَوْحِ بْنِ الْقَاسِمِ  ، حَدَّثَنَا   أَيُّوبُ بْنُ مُوسَى  ، بِهَذَا الإِسْنَادِ ، وَقَالَ : أَفَأَحُلُّهُ ، فَأَغْسِلُهُ مِنَ الْجَنَابَةِ ، وَلَمْ يَذْكُرِ : الْحَيْضَةَ ." ;
    minaret:translationUr "‏‏‏‏ اس سند سے بھی وہی حدیث آئی ہے کچھ الفاظ کی تبدیلی کے ساتھ۔" ;
    skos:exactMatch hadith:SM-HD0746 .

minaret:Hadith_SM_919 a minaret:Hadith ;
    minaret:expandedReference "Sahih Muslim; Book 11, Funerals; chapter 3, What to say in the presence of the sick and dying; hadith 919" ;
    minaret:reference "SM_919" ;
    minaret:textUthmani "حَدَّثَنَا   مُحَمَّدُ بْنُ رَافِعٍ  ، حَدَّثَنَا   عَبْدُ الرَّزَّاقِ  ، حَدَّثَنَا   مَعْمَرٌ  ، عَنْ   هَمَّامِ بْنِ مُنَبِّهٍ  ، عَنْ   أَبِي هُرَيْرَةَ  ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، بِمِثْلِهِ ." ;
    minaret:translationUr "‏‏‏‏ سیدنا ابوہریرہ رضی اللہ عنہ سے یہی حدیث دوسری سند سے بھی مروی ہے ۔" ;
    skos:exactMatch hadith:SM-HD0919 .

minaret:QuranVerse_106_2 a minaret:QuranVerse ;
    minaret:juz 30 ;
    minaret:surahNumber 106 ;
    minaret:textClean "إيلافهم رحلة الشتاء والصيف" ;
    minaret:textIndopak "اٖلٰفِهِمْ رِحْلَةَ الشِّتَآءِ وَالصَّیْفِ ۟ۚ" ;
    minaret:textUthmani "إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ" ;
    minaret:translationEn "Their accustomed security [in] the caravan of winter and summer -" ;
    minaret:translationUr "" ;
    minaret:verseNumber 2 ;
    skos:exactMatch qur:quran106-2,
        tafsir:V106_002 .

minaret:QuranVerse_11_18 a minaret:QuranVerse ;
    minaret:juz 12 ;
    minaret:surahNumber 11 ;
    minaret:textClean "ومن أظلم ممن افترى على الله كذبا ۚ أولئك يعرضون على ربهم ويقول الأشهاد هؤلاء الذين كذبوا على ربهم ۚ ألا لعنة الله على الظالمين" ;
    minaret:textIndopak "وَمَنْ اَظْلَمُ مِمَّنِ افْتَرٰی عَلَی اللّٰهِ كَذِبًا ؕ اُولٰٓىِٕكَ یُعْرَضُوْنَ عَلٰی رَبِّهِمْ وَیَقُوْلُ الْاَشْهَادُ هٰۤؤُلَآءِ الَّذِیْنَ كَذَبُوْا عَلٰی رَبِّهِمْ ۚ اَلَا لَعْنَةُ اللّٰهِ عَلَی الظّٰلِمِیْنَ ۟ۙ" ;
    minaret:textUthmani "وَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبًاۚ أُوْلَٰٓئِكَ يُعۡرَضُونَ عَلَىٰ رَبِّهِمۡ وَيَقُولُ ٱلۡأَشۡهَٰدُ هَٰٓؤُلَآءِ ٱلَّذِينَ كَذَبُواْ عَلَىٰ رَبِّهِمۡۚ أَلَا لَعۡنَةُ ٱللَّهِ عَلَى ٱلظَّٰلِمِينَ" ;
    minaret:translationEn "And who is more unjust than he who invents a lie about Allah? Those will be presented before their Lord, and the witnesses will say, \"These are the ones who lied against their Lord.\" Unquestionably, the curse of Allah is upon the wrongdoers." ;
    minaret:translationUr "" ;
    minaret:verseNumber 18 ;
    skos:exactMatch qur:quran11-18,
        tafsir:V011_018 .

minaret:QuranVerse_15_42 a minaret:QuranVerse ;
    minaret:juz 14 ;
    minaret:surahNumber 15 ;
    minaret:textClean "إن عبادي ليس لك عليهم سلطان إلا من اتبعك من الغاوين" ;
    minaret:textIndopak "اِنَّ عِبَادِیْ لَیْسَ لَكَ عَلَیْهِمْ سُلْطٰنٌ اِلَّا مَنِ اتَّبَعَكَ مِنَ الْغٰوِیْنَ ۟" ;
    minaret:textUthmani "إِنَّ عِبَادِي لَيۡسَ لَكَ عَلَيۡهِمۡ سُلۡطَٰنٌ إِلَّا مَنِ ٱتَّبَعَكَ مِنَ ٱلۡغَاوِينَ" ;
    minaret:translationEn "Indeed, My servants - no authority will you have over them, except those who follow you of the deviators." ;
    minaret:translationUr "" ;
    minaret:verseNumber 42 ;
    skos:exactMatch qur:quran15-42,
        tafsir:V015_042 .

minaret:QuranVerse_15_87 a minaret:QuranVerse ;
    minaret:juz 14 ;
    minaret:surahNumber 15 ;
    minaret:textClean "ولقد آتيناك سبعا من المثاني والقرآن العظيم" ;
    minaret:textIndopak "وَلَقَدْ اٰتَیْنٰكَ سَبْعًا مِّنَ الْمَثَانِیْ وَالْقُرْاٰنَ الْعَظِیْمَ ۟" ;
    minaret:textUthmani "وَلَقَدۡ ءَاتَيۡنَٰكَ سَبۡعًا مِّنَ ٱلۡمَثَانِي وَٱلۡقُرۡءَانَ ٱلۡعَظِيمَ" ;
    minaret:translationEn "And We have certainly given you, [O Muhammad], seven of the often repeated [verses] and the great Qur'an." ;
    minaret:translationUr "" ;
    minaret:verseNumber 87 ;
    skos:exactMatch qur:quran15-87,
        tafsir:V015_087 .

minaret:QuranVerse_16_98 a minaret:QuranVerse ;
    minaret:juz 14 ;
    minaret:surahNumber 16 ;
    minaret:textClean "فإذا قرأت القرآن فاستعذ بالله من الشيطان الرجيم" ;
    minaret:textIndopak "فَاِذَا قَرَاْتَ الْقُرْاٰنَ فَاسْتَعِذْ بِاللّٰهِ مِنَ الشَّیْطٰنِ الرَّجِیْمِ ۟" ;
    minaret:textUthmani "فَإِذَا قَرَأۡتَ ٱلۡقُرۡءَانَ فَٱسۡتَعِذۡ بِٱللَّهِ مِنَ ٱلشَّيۡطَٰنِ ٱلرَّجِيمِ" ;
    minaret:translationEn "So when you recite the Qur'an, [first] seek refuge in Allah from Satan, the expelled [from His mercy]." ;
    minaret:translationUr "" ;
    minaret:verseNumber 98 ;
    skos:exactMatch qur:quran16-98,
        tafsir:V016_098 .

minaret:QuranVerse_17_13 a minaret:QuranVerse ;
    minaret:juz 15 ;
    minaret:surahNumber 17 ;
    minaret:textClean "وكل إنسان ألزمناه طائره في عنقه ۖ ونخرج له يوم القيامة كتابا يلقاه منشورا" ;
    minaret:textIndopak "وَكُلَّ اِنْسَانٍ اَلْزَمْنٰهُ طٰٓىِٕرَهٗ فِیْ عُنُقِهٖ ؕ وَنُخْرِجُ لَهٗ یَوْمَ الْقِیٰمَةِ كِتٰبًا یَّلْقٰىهُ مَنْشُوْرًا ۟" ;
    minaret:textUthmani "وَكُلَّ إِنسَٰنٍ أَلۡزَمۡنَٰهُ طَٰٓئِرَهُۥ فِي عُنُقِهِۦۖ وَنُخۡرِجُ لَهُۥ يَوۡمَ ٱلۡقِيَٰمَةِ كِتَٰبًا يَلۡقَىٰهُ مَنشُورًا" ;
    minaret:translationEn "And [for] every person We have imposed his fate upon his neck, and We will produce for him on the Day of Resurrection a record which he will encounter spread open." ;
    minaret:translationUr "" ;
    minaret:verseNumber 13 ;
    skos:exactMatch qur:quran17-13,
        tafsir:V017_013 .

minaret:QuranVerse_19_4 a minaret:QuranVerse ;
    minaret:juz 16 ;
    minaret:surahNumber 19 ;
    minaret:textClean "قال رب إني وهن العظم مني واشتعل الرأس شيبا ولم أكن بدعائك رب شقيا" ;
    minaret:textIndopak "قَالَ رَبِّ اِنِّیْ وَهَنَ الْعَظْمُ مِنِّیْ وَاشْتَعَلَ الرَّاْسُ شَیْبًا وَّلَمْ اَكُنْ بِدُعَآىِٕكَ رَبِّ شَقِیًّا ۟" ;
    minaret:textUthmani "قَالَ رَبِّ إِنِّي وَهَنَ ٱلۡعَظۡمُ مِنِّي وَٱشۡتَعَلَ ٱلرَّأۡسُ شَيۡبًا وَلَمۡ أَكُنۢ بِدُعَآئِكَ رَبِّ شَقِيًّا" ;
    minaret:translationEn "He said, \"My Lord, indeed my bones have weakened, and my head has filled with white, and never have I been in my supplication to You, my Lord, unhappy." ;
    minaret:translationUr "" ;
    minaret:verseNumber 4 ;
    skos:exactMatch qur:quran19-4,
        tafsir:V019_004 .

minaret:QuranVerse_20_44 a minaret:QuranVerse ;
    minaret:juz 16 ;
    minaret:surahNumber 20 ;
    minaret:textClean "فقولا له قولا لينا لعله يتذكر أو يخشى" ;
    minaret:textIndopak "فَقُوْلَا لَهٗ قَوْلًا لَّیِّنًا لَّعَلَّهٗ یَتَذَكَّرُ اَوْ یَخْشٰی ۟" ;
    minaret:textUthmani "فَقُولَا لَهُۥ قَوۡلًا لَّيِّنًا لَّعَلَّهُۥ يَتَذَكَّرُ أَوۡ يَخۡشَىٰ" ;
    minaret:translationEn "And speak to him with gentle speech that perhaps he may be reminded or fear [Allah].\"" ;
    minaret:translationUr "" ;
    minaret:verseNumber 44 ;
    skos:exactMatch qur:quran20-44,
        tafsir:V020_044 .

minaret:QuranVerse_21_88 a minaret:QuranVerse ;
    minaret:juz 17 ;
    minaret:surahNumber 21 ;
    minaret:textClean "فاستجبنا له ونجيناه من الغم ۚ وكذلك ننجي المؤمنين" ;
    minaret:textIndopak "فَاسْتَجَبْنَا لَهٗ ۙ وَنَجَّیْنٰهُ مِنَ الْغَمِّ ؕ وَكَذٰلِكَ نُـجِی الْمُؤْمِنِیْنَ ۟" ;
    minaret:textUthmani "فَٱسۡتَجَبۡنَا لَهُۥ وَنَجَّيۡنَٰهُ مِنَ ٱلۡغَمِّۚ وَكَذَٰلِكَ نُـۨجِي ٱلۡمُؤۡمِنِينَ" ;
    minaret:translationEn "So We responded to him and saved him from the distress. And thus do We save the believers." ;
    minaret:translationUr "" ;
    minaret:verseNumber 88 ;
    skos:exactMatch qur:quran21-88,
        tafsir:V021_088 .

minaret:QuranVerse_22_26 a minaret:QuranVerse ;
    minaret:juz 17 ;
    minaret:surahNumber 22 ;
    minaret:textClean "وإذ بوأنا لإبراهيم مكان البيت أن لا تشرك بي شيئا وطهر بيتي للطائفين والقائمين والركع السجود" ;
    minaret:textIndopak "وَاِذْ بَوَّاْنَا لِاِبْرٰهِیْمَ مَكَانَ الْبَیْتِ اَنْ لَّا تُشْرِكْ بِیْ شَیْـًٔا وَّطَهِّرْ بَیْتِیَ لِلطَّآىِٕفِیْنَ وَالْقَآىِٕمِیْنَ وَالرُّكَّعِ السُّجُوْدِ ۟" ;
    minaret:textUthmani "وَإِذۡ بَوَّأۡنَا لِإِبۡرَٰهِيمَ مَكَانَ ٱلۡبَيۡتِ أَن لَّا تُشۡرِكۡ بِي شَيۡـًٔا وَطَهِّرۡ بَيۡتِيَ لِلطَّآئِفِينَ وَٱلۡقَآئِمِينَ وَٱلرُّكَّعِ ٱلسُّجُودِ" ;
    minaret:translationEn "And [mention, O Muhammad], when We designated for Abraham the site of the House, [saying], \"Do not associate anything with Me and purify My House for those who perform Tawaf and those who stand [in prayer] and those who bow and prostrate." ;
    minaret:translationUr "" ;
    minaret:verseNumber 26 ;
    skos:exactMatch qur:quran22-26,
        tafsir:V022_026 .

minaret:QuranVerse_22_28 a minaret:QuranVerse ;
    minaret:juz 17 ;
    minaret:surahNumber 22 ;
    minaret:textClean "ليشهدوا منافع لهم ويذكروا اسم الله في أيام معلومات على ما رزقهم من بهيمة الأنعام ۖ فكلوا منها وأطعموا البائس الفقير" ;
    minaret:textIndopak "لِّیَشْهَدُوْا مَنَافِعَ لَهُمْ وَیَذْكُرُوا اسْمَ اللّٰهِ فِیْۤ اَیَّامٍ مَّعْلُوْمٰتٍ عَلٰی مَا رَزَقَهُمْ مِّنْ بَهِیْمَةِ الْاَنْعَامِ ۚ فَكُلُوْا مِنْهَا وَاَطْعِمُوا الْبَآىِٕسَ الْفَقِیْرَ ۟ؗ" ;
    minaret:textUthmani "لِّيَشۡهَدُواْ مَنَٰفِعَ لَهُمۡ وَيَذۡكُرُواْ ٱسۡمَ ٱللَّهِ فِيٓ أَيَّامٍ مَّعۡلُومَٰتٍ عَلَىٰ مَا رَزَقَهُم مِّنۢ بَهِيمَةِ ٱلۡأَنۡعَٰمِۖ فَكُلُواْ مِنۡهَا وَأَطۡعِمُواْ ٱلۡبَآئِسَ ٱلۡفَقِيرَ" ;
    minaret:translationEn "That they may witness benefits for themselves and mention the name of Allah on known days over what He has provided for them of [sacrificial] animals. So eat of them and feed the miserable and poor." ;
    minaret:translationUr "" ;
    minaret:verseNumber 28 ;
    skos:exactMatch qur:quran22-28,
        tafsir:V022_028 .

minaret:QuranVerse_23_29 a minaret:QuranVerse ;
    minaret:juz 18 ;
    minaret:surahNumber 23 ;
    minaret:textClean "وقل رب أنزلني منزلا مباركا وأنت خير المنزلين" ;
    minaret:textIndopak "وَقُلْ رَّبِّ اَنْزِلْنِیْ مُنْزَلًا مُّبٰرَكًا وَّاَنْتَ خَیْرُ الْمُنْزِلِیْنَ ۟" ;
    minaret:textUthmani "وَقُل رَّبِّ أَنزِلۡنِي مُنزَلًا مُّبَارَكًا وَأَنتَ خَيۡرُ ٱلۡمُنزِلِينَ" ;
    minaret:translationEn "And say, 'My Lord, let me land at a blessed landing place, and You are the best to accommodate [us].' \"" ;
    minaret:translationUr "" ;
    minaret:verseNumber 29 ;
    skos:exactMatch qur:quran23-29,
        tafsir:V023_029 .

minaret:QuranVerse_25_63 a minaret:QuranVerse ;
    minaret:juz 19 ;
    minaret:surahNumber 25 ;
    minaret:textClean "وعباد الرحمن الذين يمشون على الأرض هونا وإذا خاطبهم الجاهلون قالوا سلاما" ;
    minaret:textIndopak "وَعِبَادُ الرَّحْمٰنِ الَّذِیْنَ یَمْشُوْنَ عَلَی الْاَرْضِ هَوْنًا وَّاِذَا خَاطَبَهُمُ الْجٰهِلُوْنَ قَالُوْا سَلٰمًا ۟" ;
    minaret:textUthmani "وَعِبَادُ ٱلرَّحۡمَٰنِ ٱلَّذِينَ يَمۡشُونَ عَلَى ٱلۡأَرۡضِ هَوۡنًا وَإِذَا خَاطَبَهُمُ ٱلۡجَٰهِلُونَ قَالُواْ سَلَٰمًا" ;
    minaret:translationEn "And the servants of the Most Merciful are those who walk upon the earth easily, and when the ignorant address them [harshly], they say [words of] peace," ;
    minaret:translationUr "" ;
    minaret:verseNumber 63 ;
    skos:exactMatch qur:quran25-63,
        tafsir:V025_063 .

minaret:QuranVerse_27_62 a minaret:QuranVerse ;
    minaret:juz 20 ;
    minaret:surahNumber 27 ;
    minaret:textClean "أمن يجيب المضطر إذا دعاه ويكشف السوء ويجعلكم خلفاء الأرض ۗ أإله مع الله ۚ قليلا ما تذكرون" ;
    minaret:textIndopak "اَمَّنْ یُّجِیْبُ الْمُضْطَرَّ اِذَا دَعَاهُ وَیَكْشِفُ السُّوْٓءَ وَیَجْعَلُكُمْ خُلَفَآءَ الْاَرْضِ ؕ ءَاِلٰهٌ مَّعَ اللّٰهِ ؕ قَلِیْلًا مَّا تَذَكَّرُوْنَ ۟ؕ" ;
    minaret:textUthmani "أَمَّن يُجِيبُ ٱلۡمُضۡطَرَّ إِذَا دَعَاهُ وَيَكۡشِفُ ٱلسُّوٓءَ وَيَجۡعَلُكُمۡ خُلَفَآءَ ٱلۡأَرۡضِۗ أَءِلَٰهٌ مَّعَ ٱللَّهِۚ قَلِيلًا مَّا تَذَكَّرُونَ" ;
    minaret:translationEn "Is He [not best] who responds to the desperate one when he calls upon Him and removes evil and makes you inheritors of the earth? Is there a deity with Allah? Little do you remember." ;
    minaret:translationUr "" ;
    minaret:verseNumber 62 ;
    skos:exactMatch qur:quran27-62,
        tafsir:V027_062 .

minaret:QuranVerse_2_273 a minaret:QuranVerse ;
    minaret:juz 3 ;
    minaret:surahNumber 2 ;
    minaret:textClean "للفقراء الذين أحصروا في سبيل الله لا يستطيعون ضربا في الأرض يحسبهم الجاهل أغنياء من التعفف تعرفهم بسيماهم لا يسألون الناس إلحافا ۗ وما تنفقوا من خير فإن الله به عليم" ;
    minaret:textIndopak "لِلْفُقَرَآءِ الَّذِیْنَ اُحْصِرُوْا فِیْ سَبِیْلِ اللّٰهِ لَا یَسْتَطِیْعُوْنَ ضَرْبًا فِی الْاَرْضِ ؗ یَحْسَبُهُمُ الْجَاهِلُ اَغْنِیَآءَ مِنَ التَّعَفُّفِ ۚ تَعْرِفُهُمْ بِسِيْمٰهُمْۚ لَا یَسْـَٔلُوْنَ النَّاسَ اِلْحَافًا ؕ وَمَا تُنْفِقُوْا مِنْ خَیْرٍ فَاِنَّ اللّٰهَ بِهٖ عَلِیْمٌ ۟۠" ;
    minaret:textUthmani "لِلۡفُقَرَآءِ ٱلَّذِينَ أُحۡصِرُواْ فِي سَبِيلِ ٱللَّهِ لَا يَسۡتَطِيعُونَ ضَرۡبًا فِي ٱلۡأَرۡضِ يَحۡسَبُهُمُ ٱلۡجَاهِلُ أَغۡنِيَآءَ مِنَ ٱلتَّعَفُّفِ تَعۡرِفُهُم بِسِيمَٰهُمۡ لَا يَسۡـَٔلُونَ ٱلنَّاسَ إِلۡحَافًاۗ وَمَا تُنفِقُواْ مِنۡ خَيۡرٍ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٌ" ;
    minaret:translationEn "[Charity is] for the poor who have been restricted for the cause of Allah, unable to move about in the land. An ignorant [person] would think them self-sufficient because of their restraint, but you will know them by their [characteristic] sign. They do not ask people persistently [or at all]. And whatever you spend of good - indeed, Allah is Knowing of it." ;
    minaret:translationUr "صدقات خصوصاً) ان فقراء کے لیے ہیں جو اللہ کے راستے میں گھیر لیے گئے جو زمین میں(اپنی معاش کے لیے) چلنے پھرنے کی استطاعت نہیں رکھتے ،ایک ناواقف حال ان کے  سوال نہ کرنے کی وجہ سے انہیں مالدار سمجھتا ہے۔ آپ انہیں ان کے چہرے کی علامت سے پہچان لیں گے،وہ لوگوں سے لپٹ کر سوال نہیں کرتے اورجو کچھ بھی تم اپنے مال میں سے خرچ کرو گے تو یقیناً اللہ اس کو خوب جاننے والا ہے۔" ;
    minaret:verseNumber 273 ;
    skos:exactMatch qur:quran2-273,
        tafsir:V002_273 .

minaret:QuranVerse_31_14 a minaret:QuranVerse ;
    minaret:juz 21 ;
    minaret:surahNumber 31 ;
    minaret:textClean "ووصينا الإنسان بوالديه حملته أمه وهنا على وهن وفصاله في عامين أن اشكر لي ولوالديك إلي المصير" ;
    minaret:textIndopak "وَوَصَّیْنَا الْاِنْسَانَ بِوَالِدَیْهِ ۚ حَمَلَتْهُ اُمُّهٗ وَهْنًا عَلٰی وَهْنٍ وَّفِصٰلُهٗ فِیْ عَامَیْنِ اَنِ اشْكُرْ لِیْ وَلِوَالِدَیْكَ ؕ اِلَیَّ الْمَصِیْرُ ۟" ;
    minaret:textUthmani "وَوَصَّيۡنَا ٱلۡإِنسَٰنَ بِوَٰلِدَيۡهِ حَمَلَتۡهُ أُمُّهُۥ وَهۡنًا عَلَىٰ وَهۡنٍ وَفِصَٰلُهُۥ فِي عَامَيۡنِ أَنِ ٱشۡكُرۡ لِي وَلِوَٰلِدَيۡكَ إِلَيَّ ٱلۡمَصِيرُ" ;
    minaret:translationEn "And We have enjoined upon man [care] for his parents. His mother carried him, [increasing her] in weakness upon weakness, and his weaning is in two years. Be grateful to Me and to your parents; to Me is the [final] destination." ;
    minaret:translationUr "" ;
    minaret:verseNumber 14 ;
    skos:exactMatch qur:quran31-14,
        tafsir:V031_014 .

minaret:QuranVerse_3_57 a minaret:QuranVerse ;
    minaret:juz 3 ;
    minaret:surahNumber 3 ;
    minaret:textClean "وأما الذين آمنوا وعملوا الصالحات فيوفيهم أجورهم ۗ والله لا يحب الظالمين" ;
    minaret:textIndopak "وَاَمَّا الَّذِیْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ فَیُوَفِّیْهِمْ اُجُوْرَهُمْ ؕ وَاللّٰهُ لَا یُحِبُّ الظّٰلِمِیْنَ ۟" ;
    minaret:textUthmani "وَأَمَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَيُوَفِّيهِمۡ أُجُورَهُمۡۗ وَٱللَّهُ لَا يُحِبُّ ٱلظَّٰلِمِينَ" ;
    minaret:translationEn "But as for those who believed and did righteous deeds, He will give them in full their rewards, and Allah does not like the wrongdoers." ;
    minaret:translationUr "" ;
    minaret:verseNumber 57 ;
    skos:exactMatch qur:quran3-57,
        tafsir:V003_057 .

minaret:QuranVerse_3_64 a minaret:QuranVerse ;
    minaret:juz 3 ;
    minaret:surahNumber 3 ;
    minaret:textClean "قل يا أهل الكتاب تعالوا إلى كلمة سواء بيننا وبينكم ألا نعبد إلا الله ولا نشرك به شيئا ولا يتخذ بعضنا بعضا أربابا من دون الله ۚ فإن تولوا فقولوا اشهدوا بأنا مسلمون" ;
    minaret:textIndopak "قُلْ یٰۤاَهْلَ الْكِتٰبِ تَعَالَوْا اِلٰی كَلِمَةٍ سَوَآءٍۭ بَیْنَنَا وَبَیْنَكُمْ اَلَّا نَعْبُدَ اِلَّا اللّٰهَ وَلَا نُشْرِكَ بِهٖ شَیْـًٔا وَّلَا یَتَّخِذَ بَعْضُنَا بَعْضًا اَرْبَابًا مِّنْ دُوْنِ اللّٰهِ ؕ فَاِنْ تَوَلَّوْا فَقُوْلُوا اشْهَدُوْا بِاَنَّا مُسْلِمُوْنَ ۟" ;
    minaret:textUthmani "قُلۡ يَٰٓأَهۡلَ ٱلۡكِتَٰبِ تَعَالَوۡاْ إِلَىٰ كَلِمَةٍ سَوَآءِۢ بَيۡنَنَا وَبَيۡنَكُمۡ أَلَّا نَعۡبُدَ إِلَّا ٱللَّهَ وَلَا نُشۡرِكَ بِهِۦ شَيۡـًٔا وَلَا يَتَّخِذَ بَعۡضُنَا بَعۡضًا أَرۡبَابًا مِّن دُونِ ٱللَّهِۚ فَإِن تَوَلَّوۡاْ فَقُولُواْ ٱشۡهَدُواْ بِأَنَّا مُسۡلِمُونَ" ;
    minaret:translationEn "Say, \"O People of the Scripture, come to a word that is equitable between us and you - that we will not worship except Allah and not associate anything with Him and not take one another as lords instead of Allah.\" But if they turn away, then say, \"Bear witness that we are Muslims [submitting to Him].\"" ;
    minaret:translationUr "" ;
    minaret:verseNumber 64 ;
    skos:exactMatch qur:quran3-64,
        tafsir:V003_064 .

minaret:QuranVerse_3_86 a minaret:QuranVerse ;
    minaret:juz 3 ;
    minaret:surahNumber 3 ;
    minaret:textClean "كيف يهدي الله قوما كفروا بعد إيمانهم وشهدوا أن الرسول حق وجاءهم البينات ۚ والله لا يهدي القوم الظالمين" ;
    minaret:textIndopak "كَیْفَ یَهْدِی اللّٰهُ قَوْمًا كَفَرُوْا بَعْدَ اِیْمَانِهِمْ وَشَهِدُوْۤا اَنَّ الرَّسُوْلَ حَقٌّ وَّجَآءَهُمُ الْبَیِّنٰتُ ؕ وَاللّٰهُ لَا یَهْدِی الْقَوْمَ الظّٰلِمِیْنَ ۟" ;
    minaret:textUthmani "كَيۡفَ يَهۡدِي ٱللَّهُ قَوۡمًا كَفَرُواْ بَعۡدَ إِيمَٰنِهِمۡ وَشَهِدُوٓاْ أَنَّ ٱلرَّسُولَ حَقٌّ وَجَآءَهُمُ ٱلۡبَيِّنَٰتُۚ وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّٰلِمِينَ" ;
    minaret:translationEn "How shall Allah guide a people who disbelieved after their belief and had witnessed that the Messenger is true and clear signs had come to them? And Allah does not guide the wrongdoing people." ;
    minaret:translationUr "" ;
    minaret:verseNumber 86 ;
    skos:exactMatch qur:quran3-86,
        tafsir:V003_086 .

minaret:QuranVerse_3_96 a minaret:QuranVerse ;
    minaret:juz 4 ;
    minaret:surahNumber 3 ;
    minaret:textClean "إن أول بيت وضع للناس للذي ببكة مباركا وهدى للعالمين" ;
    minaret:textIndopak "اِنَّ اَوَّلَ بَیْتٍ وُّضِعَ لِلنَّاسِ لَلَّذِیْ بِبَكَّةَ مُبٰرَكًا وَّهُدًی لِّلْعٰلَمِیْنَ ۟ۚ" ;
    minaret:textUthmani "إِنَّ أَوَّلَ بَيۡتٍ وُضِعَ لِلنَّاسِ لَلَّذِي بِبَكَّةَ مُبَارَكًا وَهُدًى لِّلۡعَٰلَمِينَ" ;
    minaret:translationEn "Indeed, the first House [of worship] established for mankind was that at Makkah - blessed and a guidance for the worlds." ;
    minaret:translationUr "" ;
    minaret:verseNumber 96 ;
    skos:exactMatch qur:quran3-96,
        tafsir:V003_096 .

minaret:QuranVerse_40_16 a minaret:QuranVerse ;
    minaret:juz 24 ;
    minaret:surahNumber 40 ;
    minaret:textClean "يوم هم بارزون ۖ لا يخفى على الله منهم شيء ۚ لمن الملك اليوم ۖ لله الواحد القهار" ;
    minaret:textIndopak "یَوْمَ هُمْ بٰرِزُوْنَ ۚ۬ لَا یَخْفٰی عَلَی اللّٰهِ مِنْهُمْ شَیْءٌ ؕ لِمَنِ الْمُلْكُ الْیَوْمَ ؕ لِلّٰهِ الْوَاحِدِ الْقَهَّارِ ۟" ;
    minaret:textUthmani "يَوۡمَ هُم بَٰرِزُونَۖ لَا يَخۡفَىٰ عَلَى ٱللَّهِ مِنۡهُمۡ شَيۡءٌۚ لِّمَنِ ٱلۡمُلۡكُ ٱلۡيَوۡمَۖ لِلَّهِ ٱلۡوَٰحِدِ ٱلۡقَهَّارِ" ;
    minaret:translationEn "The Day they come forth nothing concerning them will be concealed from Allah. To whom belongs [all] sovereignty this Day? To Allah, the One, the Prevailing." ;
    minaret:translationUr "" ;
    minaret:verseNumber 16 ;
    skos:exactMatch qur:quran40-16,
        tafsir:V040_016 .

minaret:QuranVerse_40_17 a minaret:QuranVerse ;
    minaret:juz 24 ;
    minaret:surahNumber 40 ;
    minaret:textClean "اليوم تجزى كل نفس بما كسبت ۚ لا ظلم اليوم ۚ إن الله سريع الحساب" ;
    minaret:textIndopak "اَلْیَوْمَ تُجْزٰی كُلُّ نَفْسٍ بِمَا كَسَبَتْ ؕ لَا ظُلْمَ الْیَوْمَ ؕ اِنَّ اللّٰهَ سَرِیْعُ الْحِسَابِ ۟" ;
    minaret:textUthmani "ٱلۡيَوۡمَ تُجۡزَىٰ كُلُّ نَفۡسِۢ بِمَا كَسَبَتۡۚ لَا ظُلۡمَ ٱلۡيَوۡمَۚ إِنَّ ٱللَّهَ سَرِيعُ ٱلۡحِسَابِ" ;
    minaret:translationEn "This Day every soul will be recompensed for what it earned. No injustice today! Indeed, Allah is swift in account." ;
    minaret:translationUr "" ;
    minaret:verseNumber 17 ;
    skos:exactMatch qur:quran40-17,
        tafsir:V040_017 .

minaret:QuranVerse_40_18 a minaret:QuranVerse ;
    minaret:juz 24 ;
    minaret:surahNumber 40 ;
    minaret:textClean "وأنذرهم يوم الآزفة إذ القلوب لدى الحناجر كاظمين ۚ ما للظالمين من حميم ولا شفيع يطاع" ;
    minaret:textIndopak "وَاَنْذِرْهُمْ یَوْمَ الْاٰزِفَةِ اِذِ الْقُلُوْبُ لَدَی الْحَنَاجِرِ كٰظِمِیْنَ ؕ۬ مَا لِلظّٰلِمِیْنَ مِنْ حَمِیْمٍ وَّلَا شَفِیْعٍ یُّطَاعُ ۟ؕ" ;
    minaret:textUthmani "وَأَنذِرۡهُمۡ يَوۡمَ ٱلۡأٓزِفَةِ إِذِ ٱلۡقُلُوبُ لَدَى ٱلۡحَنَاجِرِ كَٰظِمِينَۚ مَا لِلظَّٰلِمِينَ مِنۡ حَمِيمٍ وَلَا شَفِيعٍ يُطَاعُ" ;
    minaret:translationEn "And warn them, [O Muhammad], of the Approaching Day, when hearts are at the throats, filled [with distress]. For the wrongdoers there will be no devoted friend and no intercessor [who is] obeyed." ;
    minaret:translationUr "" ;
    minaret:verseNumber 18 ;
    skos:exactMatch qur:quran40-18,
        tafsir:V040_018 .

minaret:QuranVerse_42_45 a minaret:QuranVerse ;
    minaret:juz 25 ;
    minaret:surahNumber 42 ;
    minaret:textClean "وتراهم يعرضون عليها خاشعين من الذل ينظرون من طرف خفي ۗ وقال الذين آمنوا إن الخاسرين الذين خسروا أنفسهم وأهليهم يوم القيامة ۗ ألا إن الظالمين في عذاب مقيم" ;
    minaret:textIndopak "وَتَرٰىهُمْ یُعْرَضُوْنَ عَلَیْهَا خٰشِعِیْنَ مِنَ الذُّلِّ یَنْظُرُوْنَ مِنْ طَرْفٍ خَفِیٍّ ؕ وَقَالَ الَّذِیْنَ اٰمَنُوْۤا اِنَّ الْخٰسِرِیْنَ الَّذِیْنَ خَسِرُوْۤا اَنْفُسَهُمْ وَاَهْلِیْهِمْ یَوْمَ الْقِیٰمَةِ ؕ اَلَاۤ اِنَّ الظّٰلِمِیْنَ فِیْ عَذَابٍ مُّقِیْمٍ ۟" ;
    minaret:textUthmani "وَتَرَىٰهُمۡ يُعۡرَضُونَ عَلَيۡهَا خَٰشِعِينَ مِنَ ٱلذُّلِّ يَنظُرُونَ مِن طَرۡفٍ خَفِيٍّۗ وَقَالَ ٱلَّذِينَ ءَامَنُوٓاْ إِنَّ ٱلۡخَٰسِرِينَ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُمۡ وَأَهۡلِيهِمۡ يَوۡمَ ٱلۡقِيَٰمَةِۗ أَلَآ إِنَّ ٱلظَّٰلِمِينَ فِي عَذَابٍ مُّقِيمٍ" ;
    minaret:translationEn "And you will see them being exposed to the Fire, humbled from humiliation, looking from [behind] a covert glance. And those who had believed will say, \"Indeed, the [true] losers are the ones who lost themselves and their families on the Day of Resurrection. Unquestionably, the wrongdoers are in an enduring punishment.\"" ;
    minaret:translationUr "" ;
    minaret:verseNumber 45 ;
    skos:exactMatch qur:quran42-45,
        tafsir:V042_045 .

minaret:QuranVerse_53_3 a minaret:QuranVerse ;
    minaret:juz 27 ;
    minaret:surahNumber 53 ;
    minaret:textClean "وما ينطق عن الهوى" ;
    minaret:textIndopak "وَمَا یَنْطِقُ عَنِ الْهَوٰی ۟ؕ" ;
    minaret:textUthmani "وَمَا يَنطِقُ عَنِ ٱلۡهَوَىٰٓ" ;
    minaret:translationEn "Nor does he speak from [his own] inclination." ;
    minaret:translationUr "" ;
    minaret:verseNumber 3 ;
    skos:exactMatch qur:quran53-3,
        tafsir:V053_003 .

minaret:QuranVerse_53_4 a minaret:QuranVerse ;
    minaret:juz 27 ;
    minaret:surahNumber 53 ;
    minaret:textClean "إن هو إلا وحي يوحى" ;
    minaret:textIndopak "اِنْ هُوَ اِلَّا وَحْیٌ یُّوْحٰی ۟ۙ" ;
    minaret:textUthmani "إِنۡ هُوَ إِلَّا وَحۡيٌ يُوحَىٰ" ;
    minaret:translationEn "It is not but a revelation revealed," ;
    minaret:translationUr "" ;
    minaret:verseNumber 4 ;
    skos:exactMatch qur:quran53-4,
        tafsir:V053_004 .

minaret:QuranVerse_54_17 a minaret:QuranVerse ;
    minaret:juz 27 ;
    minaret:surahNumber 54 ;
    minaret:textClean "ولقد يسرنا القرآن للذكر فهل من مدكر" ;
    minaret:textIndopak "وَلَقَدْ یَسَّرْنَا الْقُرْاٰنَ لِلذِّكْرِ فَهَلْ مِنْ مُّدَّكِرٍ ۟" ;
    minaret:textUthmani "وَلَقَدۡ يَسَّرۡنَا ٱلۡقُرۡءَانَ لِلذِّكۡرِ فَهَلۡ مِن مُّدَّكِرٍ" ;
    minaret:translationEn "And We have certainly made the Qur'an easy for remembrance, so is there any who will remember?" ;
    minaret:translationUr "" ;
    minaret:verseNumber 17 ;
    skos:exactMatch qur:quran54-17,
        tafsir:V054_017 .

minaret:QuranVerse_59_21 a minaret:QuranVerse ;
    minaret:juz 28 ;
    minaret:surahNumber 59 ;
    minaret:textClean "لو أنزلنا هذا القرآن على جبل لرأيته خاشعا متصدعا من خشية الله ۚ وتلك الأمثال نضربها للناس لعلهم يتفكرون" ;
    minaret:textIndopak "لَوْ اَنْزَلْنَا هٰذَا الْقُرْاٰنَ عَلٰی جَبَلٍ لَّرَاَیْتَهٗ خَاشِعًا مُّتَصَدِّعًا مِّنْ خَشْیَةِ اللّٰهِ ؕ وَتِلْكَ الْاَمْثَالُ نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ یَتَفَكَّرُوْنَ ۟" ;
    minaret:textUthmani "لَوۡ أَنزَلۡنَا هَٰذَا ٱلۡقُرۡءَانَ عَلَىٰ جَبَلٍ لَّرَأَيۡتَهُۥ خَٰشِعًا مُّتَصَدِّعًا مِّنۡ خَشۡيَةِ ٱللَّهِۚ وَتِلۡكَ ٱلۡأَمۡثَٰلُ نَضۡرِبُهَا لِلنَّاسِ لَعَلَّهُمۡ يَتَفَكَّرُونَ" ;
    minaret:translationEn "If We had sent down this Qur'an upon a mountain, you would have seen it humbled and coming apart from fear of Allah. And these examples We present to the people that perhaps they will give thought." ;
    minaret:translationUr "" ;
    minaret:verseNumber 21 ;
    skos:exactMatch qur:quran59-21,
        tafsir:V059_021 .

minaret:QuranVerse_5_54 a minaret:QuranVerse ;
    minaret:juz 6 ;
    minaret:surahNumber 5 ;
    minaret:textClean "يا أيها الذين آمنوا من يرتد منكم عن دينه فسوف يأتي الله بقوم يحبهم ويحبونه أذلة على المؤمنين أعزة على الكافرين يجاهدون في سبيل الله ولا يخافون لومة لائم ۚ ذلك فضل الله يؤتيه من يشاء ۚ والله واسع عليم" ;
    minaret:textIndopak "یٰۤاَیُّهَا الَّذِیْنَ اٰمَنُوْا مَنْ یَّرْتَدَّ مِنْكُمْ عَنْ دِیْنِهٖ فَسَوْفَ یَاْتِی اللّٰهُ بِقَوْمٍ یُّحِبُّهُمْ وَیُحِبُّوْنَهٗۤ ۙ اَذِلَّةٍ عَلَی الْمُؤْمِنِیْنَ اَعِزَّةٍ عَلَی الْكٰفِرِیْنَ ؗ یُجَاهِدُوْنَ فِیْ سَبِیْلِ اللّٰهِ وَلَا یَخَافُوْنَ لَوْمَةَ لَآىِٕمٍ ؕ ذٰلِكَ فَضْلُ اللّٰهِ یُؤْتِیْهِ مَنْ یَّشَآءُ ؕ وَاللّٰهُ وَاسِعٌ عَلِیْمٌ ۟" ;
    minaret:textUthmani "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ مَن يَرۡتَدَّ مِنكُمۡ عَن دِينِهِۦ فَسَوۡفَ يَأۡتِي ٱللَّهُ بِقَوۡمٍ يُحِبُّهُمۡ وَيُحِبُّونَهُۥٓ أَذِلَّةٍ عَلَى ٱلۡمُؤۡمِنِينَ أَعِزَّةٍ عَلَى ٱلۡكَٰفِرِينَ يُجَٰهِدُونَ فِي سَبِيلِ ٱللَّهِ وَلَا يَخَافُونَ لَوۡمَةَ لَآئِمٍۚ ذَٰلِكَ فَضۡلُ ٱللَّهِ يُؤۡتِيهِ مَن يَشَآءُۚ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ" ;
    minaret:translationEn "O you who have believed, whoever of you should revert from his religion - Allah will bring forth [in place of them] a people He will love and who will love Him [who are] humble toward the believers, powerful against the disbelievers; they strive in the cause of Allah and do not fear the blame of a critic. That is the favor of Allah; He bestows it upon whom He wills. And Allah is all-Encompassing and Knowing." ;
    minaret:translationUr "" ;
    minaret:verseNumber 54 ;
    skos:exactMatch qur:quran5-54,
        tafsir:V005_054 .

minaret:QuranVerse_68_4 a minaret:QuranVerse ;
    minaret:juz 29 ;
    minaret:surahNumber 68 ;
    minaret:textClean "وإنك لعلى خلق عظيم" ;
    minaret:textIndopak "وَاِنَّكَ لَعَلٰی خُلُقٍ عَظِیْمٍ ۟" ;
    minaret:textUthmani "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ" ;
    minaret:translationEn "And indeed, you are of a great moral character." ;
    minaret:translationUr "" ;
    minaret:verseNumber 4 ;
    skos:exactMatch qur:quran68-4,
        tafsir:V068_004 .

minaret:QuranVerse_79_18 a minaret:QuranVerse ;
    minaret:juz 30 ;
    minaret:surahNumber 79 ;
    minaret:textClean "فقل هل لك إلى أن تزكى" ;
    minaret:textIndopak "فَقُلْ هَلْ لَّكَ اِلٰۤی اَنْ تَزَكّٰی ۟ۙ" ;
    minaret:textUthmani "فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ" ;
    minaret:translationEn "And say to him, 'Would you [be willing to] purify yourself" ;
    minaret:translationUr "" ;
    minaret:verseNumber 18 ;
    skos:exactMatch qur:quran79-18,
        tafsir:V079_018 .

minaret:QuranVerse_86_13 a minaret:QuranVerse ;
    minaret:juz 30 ;
    minaret:surahNumber 86 ;
    minaret:textClean "إنه لقول فصل" ;
    minaret:textIndopak "اِنَّهٗ لَقَوْلٌ فَصْلٌ ۟ۙ" ;
    minaret:textUthmani "إِنَّهُۥ لَقَوۡلٌ فَصۡلٌ" ;
    minaret:translationEn "Indeed, the Qur'an is a decisive statement," ;
    minaret:translationUr "" ;
    minaret:verseNumber 13 ;
    skos:exactMatch qur:quran86-13,
        tafsir:V086_013 .

minaret:QuranVerse_86_14 a minaret:QuranVerse ;
    minaret:juz 30 ;
    minaret:surahNumber 86 ;
    minaret:textClean "وما هو بالهزل" ;
    minaret:textIndopak "وَّمَا هُوَ بِالْهَزْلِ ۟ؕ" ;
    minaret:textUthmani "وَمَا هُوَ بِٱلۡهَزۡلِ" ;
    minaret:translationEn "And it is not amusement." ;
    minaret:translationUr "" ;
    minaret:verseNumber 14 ;
    skos:exactMatch qur:quran86-14,
        tafsir:V086_014 .

minaret:QuranVerse_92_5 a minaret:QuranVerse ;
    minaret:juz 30 ;
    minaret:surahNumber 92 ;
    minaret:textClean "فأما من أعطى واتقى" ;
    minaret:textIndopak "فَاَمَّا مَنْ اَعْطٰی وَاتَّقٰی ۟ۙ" ;
    minaret:textUthmani "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ" ;
    minaret:translationEn "As for he who gives and fears Allah" ;
    minaret:translationUr "" ;
    minaret:verseNumber 5 ;
    skos:exactMatch qur:quran92-5,
        tafsir:V092_005 .

minaret:QuranVerse_92_6 a minaret:QuranVerse ;
    minaret:juz 30 ;
    minaret:surahNumber 92 ;
    minaret:textClean "وصدق بالحسنى" ;
    minaret:textIndopak "وَصَدَّقَ بِالْحُسْنٰی ۟ۙ" ;
    minaret:textUthmani "وَصَدَّقَ بِٱلۡحُسۡنَىٰ" ;
    minaret:translationEn "And believes in the best [reward]," ;
    minaret:translationUr "" ;
    minaret:verseNumber 6 ;
    skos:exactMatch qur:quran92-6,
        tafsir:V092_006 .

minaret:QuranVerse_92_7 a minaret:QuranVerse ;
    minaret:juz 30 ;
    minaret:surahNumber 92 ;
    minaret:textClean "فسنيسره لليسرى" ;
    minaret:textIndopak "فَسَنُیَسِّرُهٗ لِلْیُسْرٰی ۟ؕ" ;
    minaret:textUthmani "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ" ;
    minaret:translationEn "We will ease him toward ease." ;
    minaret:translationUr "" ;
    minaret:verseNumber 7 ;
    skos:exactMatch qur:quran92-7,
        tafsir:V092_007 .

minaret:SegmentGroup_HAJJLT22-7038_1804_0_1806_74 a minaret:SegmentGroup ;
    minaret:containsSegment minaret:Segment_HAJJLT22-7038_0179 ;
    minaret:endTime 1806.74 ;
    minaret:startTime 1804.0 .

