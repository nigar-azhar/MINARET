    minaret:sequenceIndex 141 ;
    minaret:startTime 687.42 ;
    minaret:text " کے بغیر کوئی چیز نہیں  یعنی  جس نے نعمت دی ہے" .

minaret:Segment_SKD2025-0004_0142 a minaret:TranscriptSegment ;
