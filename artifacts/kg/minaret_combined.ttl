    minaret:sequenceIndex 146 ;
    minaret:startTime 702.0799999999999 ;
    minaret:text " بعض کہتے ہیں  کہ  تھوڑا سا فرق ہے" .

minaret:Segment_SKD2025-0004_0147 a minaret:TranscriptSegment ;
