    minaret:sequenceIndex 455 ;
    minaret:startTime 2526.12 ;
    minaret:text "cortisol hormone جو ہے  دباؤ پیدا کرنے والا stress hormone" .

minaret:Segment_SKD2025-0001_0456 a minaret:TranscriptSegment ;
