    minaret:precedesSegment minaret:Segment_SKD2025-0001_0330 ;
    minaret:sequenceIndex 329 ;
    minaret:startTime 1822.5800000000002 ;
    minaret:text " اس خاص طرح سورة الانبیاء  اور ایک کے بعد ایک دعا  اس کی بھی دعا قبول کر لی" .

minaret:Segment_SKD2025-0001_0330 a minaret:TranscriptSegment ;
