    minaret:precedesSegment minaret:Segment_SKD2025-0004_0160 ;
    minaret:sequenceIndex 159 ;
    minaret:startTime 741.92 ;
    minaret:text " بس کچھ نہ پوچھیں  ابھی تو آپ کہہ رہے تھے  الحمدللہ" .

minaret:Segment_SKD2025-0004_0160 a minaret:TranscriptSegment ;
    minaret:endTime 748.9399999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0161 ;
    minaret:sequenceIndex 160 ;
    minaret:startTime 745.12 ;
    minaret:text " ابھی آپ کہہ رہے ہیں  کوئی حال نہیں  ان کا دل نہیں کہہ رہا ہوتا شکر" .

minaret:Segment_SKD2025-0004_0161 a minaret:TranscriptSegment ;
    minaret:endTime 752.3199999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0162 ;
    minaret:sequenceIndex 161 ;
    minaret:startTime 748.9399999999999 ;
    minaret:text " ان کا دل سے تعریف نہیں نکل رہی ہوتا  زبان کہہ رہا ہوتا  رسما" .

minaret:Segment_SKD2025-0004_0162 a minaret:TranscriptSegment ;
    minaret:endTime 756.24 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0163 ;
    minaret:sequenceIndex 162 ;
    minaret:startTime 752.3199999999999 ;
    minaret:text " جیسے مادی ہوگے نا  رسما لوگوں کو کچھ آمد کرنے پر  تو پھر اللہ کے ساتھ بھی" .

minaret:Segment_SKD2025-0004_0163 a minaret:TranscriptSegment ;
    minaret:endTime 770.06 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0164 ;
    minaret:sequenceIndex 163 ;
    minaret:startTime 764.64 ;
    minaret:text " محبت سے تعریف کریں گے  اندر سے کریں گے  اور پھر عمل اس کے مطابق کریں گے" .

minaret:Segment_SKD2025-0004_0164 a minaret:TranscriptSegment ;
    minaret:endTime 773.8199999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0165 ;
    minaret:sequenceIndex 164 ;
    minaret:startTime 770.06 ;
    minaret:text " تو یہ ہے اصل میں  محبت کا اظہار  اچھا میں نے عرض کیا تھا" .

minaret:Segment_SKD2025-0004_0165 a minaret:TranscriptSegment ;
    minaret:endTime 776.74 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0166 ;
    minaret:sequenceIndex 165 ;
    minaret:startTime 773.8199999999999 ;
    minaret:text " کہ  اللہ کی تعریف کرنا  ہمیں فائدہ دیتا ہے" .

minaret:Segment_SKD2025-0004_0166 a minaret:TranscriptSegment ;
    minaret:endTime 781.14 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0167 ;
    minaret:sequenceIndex 166 ;
    minaret:startTime 776.74 ;
    minaret:text " اللہ کو نہیں دیتا  وہ ہمیں کیا فائدہ ملتا ہے  آپ میں سے کوئی بتائے گا" .

minaret:Segment_SKD2025-0004_0167 a minaret:TranscriptSegment ;
    minaret:endTime 784.92 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0168 ;
    minaret:sequenceIndex 167 ;
    minaret:startTime 781.14 ;
    minaret:text " ہمیں کیا فائدہ ملتا ہے  ییس  دل کا اطمینان" .

minaret:Segment_SKD2025-0004_0168 a minaret:TranscriptSegment ;
    minaret:endTime 790.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0169 ;
    minaret:sequenceIndex 168 ;
    minaret:startTime 784.92 ;
    minaret:text " دل کی راحت  ایمان بھی پختہ ہوتا ہے  اور دل کو راحت بھی ملتی ہے" .

minaret:Segment_SKD2025-0004_0169 a minaret:TranscriptSegment ;
    minaret:endTime 793.72 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0170 ;
    minaret:sequenceIndex 169 ;
    minaret:startTime 790.0 ;
    minaret:text " اللہ کی رضا حاصل ہوتی ہے  پھر اللہ تعالیٰ کا وعدہ ہے  کہ" .

minaret:Segment_SKD2025-0004_0171 a minaret:TranscriptSegment ;
    minaret:endTime 802.96 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0172 ;
    minaret:sequenceIndex 171 ;
    minaret:startTime 798.56 ;
    minaret:text " اور جلد ملے گی  اور جو نعمتیں ہم سے چلی گئی  مسئلہ صحت چلی گئی" .

minaret:Segment_SKD2025-0004_0172 a minaret:TranscriptSegment ;
    minaret:endTime 806.86 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0173 ;
    minaret:sequenceIndex 172 ;
    minaret:startTime 802.96 ;
