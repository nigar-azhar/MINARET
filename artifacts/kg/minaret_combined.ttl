    minaret:evidenceText "«صِرَاطَ» راستہ، «الَّذِیْنَ» ان کا، «اَنْعَمْتَ» انعام کیا تو نے، «عَلَیْهِمْ» جن پر، «غَیْرِ» نہ، «الْمَغْضُوْبِ» ان کا جو غضب کیا گیا، «عَلَیْهِمْ» جن پر، «وَ» اور، «لَا» نہ، «الضَّآلِّیْنَ» ان کا جو گمراہ ہیں۔" ;
    minaret:hasExtentType minaret:CompleteCitation ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_TQ2005-0316_74_26_106_36 ;
    minaret:refersTo minaret:QuranVerse_1_7 ;
    minaret:startTime 74.26 .

