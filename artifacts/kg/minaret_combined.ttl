minaret:Segment_SKD2025-0004_0173 a minaret:TranscriptSegment ;
    minaret:endTime 810.54 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0174 ;
    minaret:sequenceIndex 173 ;
    minaret:startTime 806.86 ;
