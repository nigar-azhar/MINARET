minaret:Segment_HAJJLT22-7039_0000 a minaret:TranscriptSegment ;
    minaret:endTime 14.0 ;
    minaret:precedesSegment minaret:Segment_HAJJLT22-7039_0001 ;
    minaret:sequenceIndex 0 ;
    minaret:startTime 0.0 ;
    minaret:text "لَبَّیْكَ اَللّٰهُمَّ لَبَّیْكَ، لَبَّیْكَ لَا شَرِیْكَ لَكَ لَبَّیْكَ، اِنَّ الْحَمْدَ، وَالنِّعْمَةَ لَكَ وَالْمُلْكَ، لَاشَرِیْكَ لَكَ۔" .

minaret:Segment_HAJJLT22-7040_0000 a minaret:TranscriptSegment ;
    minaret:endTime 9.68 ;
    minaret:precedesSegment minaret:Segment_HAJJLT22-7040_0001 ;
    minaret:sequenceIndex 0 ;
    minaret:startTime 0.0 ;
    minaret:text "As-salamu alaykum wa rahmatullahi wa barakatuh everyone. Alhamdulillah, welcome back to the course. Good to see all of you here. Alhamdulillah, let's Insha'Allah begin properly." .

minaret:Segment_HUSN_AKHL-21593_0000 a minaret:TranscriptSegment ;
    minaret:endTime 2.98 ;
    minaret:precedesSegment minaret:Segment_HUSN_AKHL-21593_0001 ;
    minaret:sequenceIndex 0 ;
    minaret:startTime 0.0 ;
    minaret:text "اَلسَّلَامُ عَلَیْكُمْ وَرَحْمَةُ اللّٰهِ وَبَرَكَاتُهٗ۔" .

minaret:Topic_Acceptance_of_Divine_Decree_and_Contentment_Rida a minaret:Topic ;
    minaret:descriptionEn "Embracing trials with absolute trust, avoiding despair, and recognizing tests as part of the earthly trial (Dar al-Imtihan)." ;
    minaret:descriptionUr "دنیا کو دار الامتحان سمجھتے ہوئے اللہ کے فیصلوں پر راضی رہنا اور مایوسی سے بچنا۔" ;
    minaret:nameEn "Acceptance of Divine Decree and Contentment (Rida)" ;
    minaret:nameUr "تقدیر پر رضا اور تسلیم و تسلیم" .

minaret:Topic_Active_Self_Testing_and_Memorization_Discipline_Hifz_wa_Tamrin a minaret:Topic ;
    minaret:descriptionEn "Techniques for learning vocabulary independently, shielding translations to test recall, and group recitation standards." ;
    minaret:descriptionUr "الفاظ کو خود سے سیکھنے کے طریقے، یادداشت جانچنے کے لیے ترجمہ چھپانا، اور اجتماعی تلاوت کے معیارات۔" ;
    minaret:nameEn "Active Self-Testing and Memorization Discipline (Hifz wa Tamrin)" ;
    minaret:nameUr "فعال خود آزمائی اور حفظ کی مشق (حفظ و تمرین)" .

minaret:Topic_Al_Shafi_The_Divine_Attribute_of_Healing a minaret:Topic ;
    minaret:descriptionEn "Understanding Allah as Al-Shafi, recognizing that true healing comes exclusively from Him." ;
    minaret:descriptionUr "اللہ تعالیٰ کے نام الشافی کی معرفت اور اس بات کا یقین کہ شفا صرف اللہ دیتا ہے۔" ;
    minaret:nameEn "Al-Shafi: The Divine Attribute of Healing" ;
    minaret:nameUr "الشافی: اللہ تعالیٰ کا نام اور شفایابی" .

minaret:Topic_Asceticism_Zuhd_and_Universal_Divine_Justice_Adl a minaret:Topic ;
    minaret:descriptionEn "The detached lifestyle of Abu Dharr (RA) in al-Rabadhah contrasted with the cosmos operating upon pristine, balanced justice." ;
    minaret:descriptionUr "حضرت ابو ذرؓ کی دنیا سے بے رغبتی اور کائنات کے فلکیاتی نظام کا عدل و انصاف پر قائم رہنے کا فلسفہ۔" ;
    minaret:nameEn "Asceticism (Zuhd) and Universal Divine Justice (Adl)" ;
    minaret:nameUr "سیدنا ابو ذرؓ کا فقیرانہ زہد اور کائناتی نظامِ عدل" .

minaret:Topic_Authority_and_Preservation_of_Sunnah_Hujjiyyat_wa_Tadwin_al_Hadith a minaret:Topic ;
    minaret:descriptionEn "The theological status of the Prophet's Sunnah as divine revelation (Wahy Ghayr Matlu), the living Quran, and the historical reality of its written preservation from the Prophetic era." ;
    minaret:descriptionUr "سنتِ نبوی کی دینی و تشریعی حیثیت بطور وحیِ غیر متلو اور عہدِ رسالت و صحابہ سے تحریری صحیفوں کے ذریعے حدیث کی حفاظت کی تاریخ۔" ;
    minaret:nameEn "Authority and Preservation of Sunnah / Hujjiyyat wa Tadwin al-Hadith" ;
    minaret:nameUr "حجیت و تدوینِ حدیث" .

minaret:Topic_Avoiding_Falsehood_Ijtinab_az_Zoor a minaret:Topic ;
    minaret:descriptionEn "Strict prohibition of mendacity, deceit, and false testimony, alongside the denunciation of idols." ;
    minaret:descriptionUr "بت پرستی کے ساتھ ساتھ جھوٹ، فریب اور جھوٹی گواہی سے سخت ممانعت۔" ;
    minaret:nameEn "Avoiding Falsehood (Ijtinab az-Zoor)" ;
    minaret:nameUr "اجتناب از جھوٹ" .

minaret:Topic_Awakening_Moral_Conscience_Through_Gentleness a minaret:Topic ;
    minaret:descriptionEn "Choosing gentle responses to disarm adversaries and stimulate personal conscience rather than instigating arrogant defense." ;
    minaret:descriptionUr "سختی کے بجائے نرمی کا رویہ اپنا کر دوسروں کی انا کو ٹھیس پہنچانے کے بجائے ان کے باطنی ضمیر کو بیدار کرنا۔" ;
    minaret:nameEn "Awakening Moral Conscience Through Gentleness" ;
    minaret:nameUr "نرمی کے ذریعے ضمیر کی بیداری اور محاسبہ" .

minaret:Topic_Blessings_and_Expiation_of_Sins_in_Illness a minaret:Topic ;
    minaret:descriptionEn "How physical and mental sufferings, even a prick of a thorn or fever, serve as expiation for sins and elevate ranks." ;
    minaret:descriptionUr "کانٹے کے چبھنے یا بخار جیسی بیماریوں کے ذریعے گناہوں کے مٹنے اور کفارے کا بیان۔" ;
    minaret:nameEn "Blessings and Expiation of Sins in Illness" ;
    minaret:nameUr "بیماری میں گناہوں کا کفارہ اور درجات کی بلندی" .

minaret:Topic_Categories_of_Injustice_Physical_Abuse_and_Emotional_Torture a minaret:Topic ;
    minaret:descriptionEn "Analysis of verbal abuse, character assassination, backbiting, ridicule, and psychological harm as severe forms of oppression." ;
    minaret:descriptionUr "مار پیٹ کے علاوہ طنز، مذاق، تحقیر، کردار کشی اور غیبت کے ذریعے دوسروں کو پہنچائی جانے والی ذہنی اذیت کی مذمت۔" ;
    minaret:nameEn "Categories of Injustice: Physical Abuse and Emotional Torture" ;
    minaret:nameUr "ظلم کی اقسام: جسمانی ضرر رسانی اور ذہنی و نفسیاتی ایذا" .

minaret:Topic_Charity_Sadaqah a minaret:Topic ;
    minaret:descriptionEn "Distributing monetary charity and sharing food and Zamzam with pilgrims in need." ;
    minaret:descriptionUr "مالی صدقہ کرنا اور بھوکوں کو کھانا کھلانا۔" ;
    minaret:nameEn "Charity (Sadaqah)" ;
    minaret:nameUr "صدقہ" .

minaret:Topic_Companions_of_the_Prophet_Sahabah a minaret:Topic ;
    minaret:descriptionEn "The life, profound dedication to Hadith, piety, filial devotion, and poverty of Abu Hurairah under the Prophet's tutelage." ;
    minaret:descriptionUr "حضرت ابو ہریرہؓ کی طلبِ حدیث، فقر و فاقہ، اصحابِ صفہ کا دور اور خلوصِ نیت کی سیرت۔" ;
    minaret:nameEn "Companions of the Prophet / Sahabah" ;
    minaret:nameUr "صحابہ کرام اور سیرتِ ابو ہریرہؓ" .

minaret:Topic_Comprehension_and_Contemplation_Fahm_wa_Tadabbur a minaret:Topic ;
    minaret:descriptionEn "Direct engagement with the text, leveraging linguistic affinity with Urdu, and daily practice." ;
    minaret:descriptionUr "اردو زبان سے قرابت داری کے ذریعے قرآن سے براہِ راست فکری تعلق اور عملی اتباع۔" ;
    minaret:nameEn "Comprehension and Contemplation (Fahm wa Tadabbur)" ;
    minaret:nameUr "فہم، تدبر اور عمل" .

minaret:Topic_Curbing_Pride_Ego_and_Obstinacy_Takabbur_wa_al_Ana a minaret:Topic ;
    minaret:descriptionEn "Overcoming relational rigidity, stubborn self-righteousness, and recognizing supreme greatness solely for Allah." ;
    minaret:descriptionUr "انسانی تعلقات میں رکاوٹ بننے والی انا اور جھوٹی بڑائی کا خاتمہ اور اللہ کی کبریائی کا دل سے اقرار۔" ;
    minaret:nameEn "Curbing Pride, Ego, and Obstinacy (Takabbur wa al-Ana)" ;
    minaret:nameUr "تکبر، انا اور ہٹ دھرمی کا خاتمہ اور کبرِ نفس کا علاج" .

minaret:Topic_Dialogue_with_People_of_the_Book_Mukalamah a minaret:Topic ;
    minaret:descriptionEn "Establishing common grounds in communication and acknowledging prior scriptures." ;
    minaret:descriptionUr "اہلِ کتاب سے مشترکہ بنیادوں پر مکالمہ اور سابقہ کتبِ سماویہ کی تصدیق۔" ;
    minaret:nameEn "Dialogue with People of the Book (Mukalamah)" ;
    minaret:nameUr "دعوت اور مکالمۂ بین المذاہب" .

minaret:Topic_Divine_Mercy_and_Compassion_Rahmah a minaret:Topic ;
    minaret:descriptionEn "The invocation of Allah's name and His attributes of all-encompassing Mercy (Ar-Rahman, Ar-Rahim)." ;
    minaret:descriptionUr "اللہ کے بابرکت نام سے آغاز اور اس کی وسیع اور کامل رحمت کی صفات کا اقرار۔" ;
    minaret:nameEn "Divine Mercy and Compassion (Rahmah)" ;
    minaret:nameUr "رحمتِ الٰہی: رحمن و رحیم" .

minaret:Topic_Divine_Nurturing_and_Cosmic_Lordship_Ar_Rububiyyah a minaret:Topic ;
    minaret:descriptionEn "Gradual elevation of creation from nothingness to perfection, maternal care, and the sign of 'Alam." ;
    minaret:descriptionUr "عدم سے وجود اور ذرے سے کمال تک پہنچانے کی صفات، رب کا مفہوم اور عالم بطورِ علامتِ معرفت۔" ;
    minaret:nameEn "Divine Nurturing and Cosmic Lordship (Ar-Rububiyyah)" ;
    minaret:nameUr "ربوبیتِ کاملہ اور عوالم کی پرورش" .

minaret:Topic_Divine_Sovereignty_on_the_Day_of_Judgment_Malik_Yawm_ad_Din a minaret:Topic ;
    minaret:descriptionEn "Accountability, the absolute manifestation of divine kingship, and retribution on the Last Day." ;
    minaret:descriptionUr "حشر کے دن کی بے پردگی، للہ الواحد القہار کی پکار اور انسان کے اعمال کا کامل بدلہ۔" ;
    minaret:nameEn "Divine Sovereignty on the Day of Judgment (Malik Yawm ad-Din)" ;
    minaret:nameUr "مالکِ روزِ جزا اور اخروی جوابدہی" ;
    skos:closeMatch hadith:ArticlesOfFaith .

minaret:Topic_Domestic_Harmony_and_Family_Prosperity_Through_Rifq a minaret:Topic ;
    minaret:descriptionEn "Authentic Hadith of Aisha (RA) declaring that when Allah intends goodness for a household, He infuses gentleness among them." ;
    minaret:descriptionUr "مسند احمد کی حدیث کہ جب اللہ تعالیٰ کسی گھرانے پر بھلائی چاہتا ہے تو ان کے معاملات میں نرمی داخل فرما دیتا ہے۔" ;
    minaret:nameEn "Domestic Harmony and Family Prosperity Through Rifq" ;
    minaret:nameUr "گھریلو امن اور خاندان میں نرمی کی برکات" .

minaret:Topic_Ease_and_Moderation_in_Worship_Rifq_Yusr a minaret:Topic ;
    minaret:descriptionEn "Avoiding self-imposed hardship and utilizing permissible conveyances in religious devotion." ;
    minaret:descriptionUr "عبادت میں خود ساختہ مشقت سے بچنا اور شرعی رخصتوں و سواریوں سے فائدہ اٹھانا۔" ;
    minaret:nameEn "Ease and Moderation in Worship (Rifq & Yusr)" ;
    minaret:nameUr "دین میں آسانی اور بے جا مشقت کی ممانعت" .

minaret:Topic_Etiquettes_and_Prohibitions_of_Pilgrimage_Ijtinab_ar_Rafath_wal_Fusuq a minaret:Topic ;
    minaret:descriptionEn "Strict prohibition of obscenity, sinful misconduct, and contentious disputes throughout the sacred journey." ;
    minaret:descriptionUr "حج کے دوران شہوانی گفتگو، گناہوں، جھگڑے اور فضول بحث و تکرار سے سختی سے بچنا۔" ;
    minaret:nameEn "Etiquettes and Prohibitions of Pilgrimage (Ijtinab ar-Rafath wal-Fusuq)" ;
    minaret:nameUr "آدابِ حج: رفث، فسوق اور جدال سے ممانعت" .

minaret:Topic_Etymology_and_Root_Words_of_Divine_Names_Ishtiq_q a minaret:Topic ;
    minaret:descriptionEn "Linguistic derivation of Bism, Allah, Ar-Rahman, Ar-Rahim, and the superlative weight of Fa'lan." ;
    minaret:descriptionUr "بسم، اللہ اور رحمٰن و رحیم کے مادہ اشتقاق، اوزان اور مبالغہ کے صیغوں کی لغوی تفہیم۔" ;
    minaret:nameEn "Etymology and Root-Words of Divine Names (Ishtiqāq)" ;
    minaret:nameUr "اسمائے حسنیٰ کا لغوی و اشتقاقی تجزیہ" .

minaret:Topic_Excellence_and_Rewards_of_Pilgrimage a minaret:Topic ;
    minaret:descriptionEn "The spiritual superiority of Hajj, expiation of past sins, removal of poverty, and being counted among Allah's delegations." ;
    minaret:descriptionUr "حج کی عظمت، گناہوں کا کفارہ، فقر کا خاتمہ اور حجاج کا اللہ کا وفد ہونا۔" ;
    minaret:nameEn "Excellence and Rewards of Pilgrimage" ;
    minaret:nameUr "حج کے فضائل اور درجات" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Exclusive_Reliance_and_Divine_Guidance_Al_Isti_anah_wal_Hidayah a minaret:Topic ;
    minaret:descriptionEn "Seeking help solely from Allah and navigating the threefold stages of Hidayah: pathfinding, traversing, and arriving." ;
    minaret:descriptionUr "فقط ذاتِ باری سے استعانت کا عہد، اور ہدایت کے تین مراحل: راستہ پانا، اس پر چلنا اور منزل تک پہنچنا۔" ;
    minaret:nameEn "Exclusive Reliance and Divine Guidance (Al-Isti'anah wal-Hidayah)" ;
    minaret:nameUr "توحیدِ استعانت اور طلبِ ہدایت" .

minaret:Topic_Exclusive_Worship_and_Reliance_Tawhid_al_Ibadah a minaret:Topic ;
    minaret:descriptionEn "Direct covenant reserving all acts of worship and ultimate reliance to Allah alone." ;
    minaret:descriptionUr "صرف اللہ تعالیٰ کی بندگی اور ہر معاملے میں صرف اسی سے مدد طلب کرنے کا عہد۔" ;
    minaret:nameEn "Exclusive Worship and Reliance (Tawhid al-'Ibadah)" ;
    minaret:nameUr "توحیدِ عبادت و استعانت" .

minaret:Topic_Exemplary_Companionship_Biography_and_Conversion_of_Abu_Dharr_RA a minaret:Topic ;
    minaret:descriptionEn "Historical account of Abu Dharr al-Ghifari's truth-seeking journey from Banu Ghifar to Makkah, early conversion, and unyielding courage." ;
    minaret:descriptionUr "قبیلہ غفار سے تعلق رکھنے والے جلیل القدر صحابی حضرت ابو ذرؓ کا تلاشِ حق میں مکہ آنا، ایمان لانا اور حق کا علی الاعلان اظہار۔" ;
    minaret:nameEn "Exemplary Companionship: Biography and Conversion of Abu Dharr (RA)" ;
    minaret:nameUr "سیدنا ابو ذر غفاریؓ: سیرت، قبولِ اسلام اور ابتدائی دعوت" .

minaret:Topic_Feeding_the_Needy_Sadaqah a minaret:Topic ;
    minaret:descriptionEn "The mandate to feed the destitute and impoverished from the sacrifice." ;
    minaret:descriptionUr "قربانی کے گوشت میں سے مساکین و محتاجوں کو کھلانے کا حکم۔" ;
    minaret:nameEn "Feeding the Needy (Sadaqah)" ;
    minaret:nameUr "فقراء کی امداد" .

minaret:Topic_Filial_Piety_Birr_al_Walidayn a minaret:Topic ;
    minaret:descriptionEn "Devotion, daily supplication, respectful manners, and service towards parents even when faced with religious opposition." ;
    minaret:descriptionUr "والدین کی قدر، ادب کے اصول، روزانہ دعائیہ سلام اور مخالفت کے باوجود احسان کا برتاؤ۔" ;
    minaret:nameEn "Filial Piety / Birr al-Walidayn" ;
    minaret:nameUr "والدین کی قدر، ادب کے اصول، روزانہ دعائیہ سلام اور مخالفت کے باوجود احسان کا برتاؤ۔" .

minaret:Topic_Fulfilling_Mutual_Rights_and_Maintaining_Family_Balance a minaret:Topic ;
    minaret:descriptionEn "Synthesizing parental rights with spousal obligations without imbalance, unjustified favoritism, or coercive ultimatums." ;
    minaret:descriptionUr "ماں کے احسانات اور بیوی کے واجبات کو باہم عدل کے ساتھ ادا کرنا تاکہ حقوق کا عدم توازن ظلم کا سبب نہ بنے۔" ;
    minaret:nameEn "Fulfilling Mutual Rights and Maintaining Family Balance" ;
    minaret:nameUr "گھریلو حقوق میں توازن اور عدل کی پاسداری" .

minaret:Topic_Fulfilling_Vows_and_Legal_Pledges_Al_Wafa_bil_Nadhr a minaret:Topic ;
    minaret:descriptionEn "The mandatory fulfillment of personal religious vows undertaken for the sake of Allah." ;
    minaret:descriptionUr "اللہ کے نام کی مانی گئی جائز نذروں اور منتوں کو شرعاً پورا کرنے کی پابندی۔" ;
    minaret:nameEn "Fulfilling Vows and Legal Pledges (Al-Wafa bil-Nadhr)" ;
    minaret:nameUr "نذر اور عہد کو پورا کرنا" .

minaret:Topic_Good_expectations_and_protection_from_whisperings a minaret:Topic ;
    minaret:descriptionEn "Discussion of negative thoughts, harmful speech, hope and Quranic recitation." ;
    minaret:descriptionUr "منفی خیالات، نقصان دہ گفتگو، امید اور تلاوتِ قرآن پر گفتگو۔" ;
    minaret:nameEn "Good expectations and protection from whisperings" ;
    minaret:nameUr "حسنِ ظن اور وسوسوں سے حفاظت" .

minaret:Topic_Good_speech_and_ruqyah a minaret:Topic ;
    minaret:descriptionEn "Encouraging constructive speech and recitation rather than discouraging the sick." ;
    minaret:descriptionUr "مریض کو مایوس کرنے کے بجائے اچھی بات کہنے اور کلامِ الٰہی پڑھنے کی ترغیب۔" ;
    minaret:nameEn "Good speech and ruqyah" ;
    minaret:nameUr "حسنِ کلام اور رقیہ" .

minaret:Topic_Gratitude_Shukr a minaret:Topic ;
    minaret:descriptionEn "Gratitude for Islam, life and health, and using health for worship and service." ;
    minaret:descriptionUr "اسلام، زندگی اور صحت کی نعمتوں پر شکر اور صحت کو عبادت و خدمت میں استعمال کرنا۔" ;
    minaret:nameEn "Gratitude (Shukr)" ;
    minaret:nameUr "شکر" .

minaret:Topic_Hamd_and_Shukr_in_Times_of_Affliction a minaret:Topic ;
    minaret:descriptionEn "Praising and thanking Allah in every circumstance, viewing trials as disguised mercies rather than burdens." ;
    minaret:descriptionUr "ہر حال میں اللہ کی تعریف اور شکر گزاری، اور مصائب کو بظاہر زحمت مگر باطن میں رحمت سمجھنا۔" ;
    minaret:nameEn "Hamd and Shukr in Times of Affliction" ;
    minaret:nameUr "آزمائش میں حمد و شکر کا مقام" .

minaret:Topic_Hastening_to_Good_Deeds_Al_Mubadarah_ilal_Khayrat a minaret:Topic ;
    minaret:descriptionEn "Performing obligatory Hajj promptly without delaying for marriage, worldly accumulation, or old age, given life's uncertainties." ;
    minaret:descriptionUr "صحت اور مال کے میسر آتے ہی بغیر تاخیر حج ادا کرنا اور دنیاوی حیلوں یا بڑھاپے کے انتظار سے اجتناب کرنا۔" ;
    minaret:nameEn "Hastening to Good Deeds (Al-Mubadarah ilal-Khayrat)" ;
    minaret:nameUr "نیکیوں میں جلدی (المبادرۃ الی الخیرات)" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Humility_Tawadu_and_Lowering_the_Wings_of_Mercy a minaret:Topic ;
    minaret:descriptionEn "Quranic mandate to lower one's wings in kindness towards disciples, juniors, and maintaining warmth across all social tiers." ;
    minaret:descriptionUr "قرآنی حکم کے مطابق اپنے ماتحتوں، ساتھیوں اور سب مومنین کے سامنے عاجزی اور انکساری کا برتاؤ کرنا۔" ;
    minaret:nameEn "Humility (Tawadu') and Lowering the Wings of Mercy" ;
    minaret:nameUr "تواضع اور اہل ایمان کے لیے شفقت کا بازو جھکانا" .

minaret:Topic_Idiomatic_Translation_and_Word_Analysis_Tafhim_al_Alfaz a minaret:Topic ;
    minaret:descriptionEn "Sentence-level meaning of Surah Al-Fatihah, grammatical particles (lam, wa), and roots of core vocabulary." ;
    minaret:descriptionUr "سورۃ الفاتحہ کا جملہ وار فہم، قرآنی حروف و ضمائر کا استعمال اور روزمرہ اردو سے ہم آہنگی۔" ;
    minaret:nameEn "Idiomatic Translation and Word Analysis (Tafhim al-Alfaz)" ;
    minaret:nameUr "بامحاورہ ترجمہ اور لغوی فہم" .

minaret:Topic_Ihsan a minaret:Topic ;
    minaret:descriptionEn "Going beyond the minimum for fellow pilgrims -- caring for the elderly and gifting authentic educational literature." ;
    minaret:descriptionUr "معمر حجاج کا خاص خیال رکھنا اور مستند دعاؤں و طریقۂ حج کی کتب بطور تحفہ دینا۔" ;
    minaret:nameEn "Ihsan" ;
    minaret:nameUr "ایثار" .

minaret:Topic_Immunity_from_Hellfire_for_the_Lenient_and_Gentle_Believer a minaret:Topic ;
    minaret:descriptionEn "Canonical tradition from Ibn Mas'ud affirming that Jahannam is forbidden for every accessible, gentle, and accommodating person." ;
    minaret:descriptionUr "حضرت ابن مسعودؓ کی روایت کہ جہنم کی آگ ہر اس انسان پر حرام ہے جو لوگوں سے قریب، نرم خو اور آسان ہو۔" ;
    minaret:nameEn "Immunity from Hellfire for the Lenient and Gentle Believer" ;
    minaret:nameUr "نرم مزاج اور ملنسار مومن پر جہنم کی آگ کی قطعی حرمت" .

minaret:Topic_Inner_Nature_of_Hamd_and_Sincere_Love_for_Allah a minaret:Topic ;
    minaret:descriptionEn "Understanding hamd as praise rooted in deep love, gratitude, and recognition of the Benefactor (Al-Mun'im)." ;
    minaret:descriptionUr "حمد کو محبت کے ساتھ تعریف سمجھنا اور منعمِ حقیقی کا دلی ادراک و شکر۔" ;
    minaret:nameEn "Inner Nature of Hamd and Sincere Love for Allah" ;
    minaret:nameUr "حمد کی روح اور محبتِ الہی" .

minaret:Topic_Intellect_Aql a minaret:Topic ;
    minaret:descriptionEn "Intellect as a divine trust and test, the faculty distinguishing humans from animals, and purposeful living." ;
    minaret:descriptionUr "عقل بطور امانتِ الٰہی اور آزمائش، وہ صلاحیت جو انسان کو حیوانات سے ممتاز کرتی ہے، اور بامقصد زندگی۔" ;
    minaret:nameEn "Intellect ('Aql)" ;
    minaret:nameUr "عقل" .

minaret:Topic_Internalization_of_Knowledge_Ilm_wa_Amal a minaret:Topic ;
    minaret:descriptionEn "The necessity of digesting and practicing knowledge rather than merely accumulating passive information." ;
    minaret:descriptionUr "علم کو محض جمع کرنے کے بجائے اسے ہضم کرنے اور عمل میں لانے کی ضرورت۔" ;
    minaret:nameEn "Internalization of Knowledge ('Ilm wa 'Amal)" ;
    minaret:nameUr "علم و عمل کا حقیقی حصول" .

minaret:Topic_Invasion_of_Privacy_Breach_of_Duty_and_Time_Theft a minaret:Topic ;
    minaret:descriptionEn "Treating meddling in others' personal space, abandoning primary vocational duties, and carelessly wasting people's valuable time as injustice." ;
    minaret:descriptionUr "دوسروں کی نجی زندگی میں بلاوجہ دخل اندازی، سرکاری یا پیشہ ورانہ ذمہ داریوں سے انحراف اور دوسروں کا قیمتی وقت چرانا۔" ;
    minaret:nameEn "Invasion of Privacy, Breach of Duty, and Time Theft" ;
    minaret:nameUr "پرائیویسی کی پامالی، فرائض سے غفلت اور وقت کا ضیاع" .

minaret:Topic_Isti_adhah_Protection_from_Whispers_Al_Isti_adhah a minaret:Topic ;
    minaret:descriptionEn "Seeking divine sanctuary from Satan upon commencing recitation and understanding demonic vulnerability." ;
    minaret:descriptionUr "قرآنی تلاوت کے آغاز میں پناہ طلبی، شیطانی حربوں کا توڑ اور اخلاص کا حصار۔" ;
    minaret:nameEn "Isti'adhah: Protection from Whispers (Al-Isti'adhah)" ;
    minaret:nameUr "استعاذہ اور شیطانی وسوسوں سے پناہ" .

minaret:Topic_Jurisprudence_of_Ihsar_Impediments_to_Pilgrimage a minaret:Topic ;
    minaret:descriptionEn "Rules governing pilgrims prevented from completing Hajj or Umrah due to sickness, injury, or hostility." ;
    minaret:descriptionUr "بیماری، دشمن یا مجبوری کی بنا پر حج یا عمرہ سے رک جانے والے کے لیے شرعی احکام اور دمِ احصار۔" ;
    minaret:nameEn "Jurisprudence of Ihsar (Impediments to Pilgrimage)" ;
    minaret:nameUr "احصار اور رکاوٹ کے شرعی احکام" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Jurisprudence_of_Pilgrimage_Modalities_Fiqh_al_Hajj a minaret:Topic ;
    minaret:descriptionEn "Legal criteria, timelines, and procedural distinctions between Hajj Tamattu', Qiran, and Ifrad." ;
    minaret:descriptionUr "حج تمتع، قران اور افراد کی شرعی شرائط، اوقات اور افضلیت کے فقہی احکام۔" ;
    minaret:nameEn "Jurisprudence of Pilgrimage Modalities (Fiqh al-Hajj)" ;
    minaret:nameUr "مناسک و اقسامِ حج کی فقہ" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Jurisprudence_of_Recitation_and_Handling_the_Mushaf_Ahkam_al_Mushaf a minaret:Topic ;
    minaret:descriptionEn "Rulings on reciting without touching the Mushaf during menses, using barriers/gloves, and distinguishing menses from junub." ;
    minaret:descriptionUr "حالتِ حیض میں تلاوتِ قرآن کا جواز، مسِ مصحف کے لیے حائل (دستانے/کپڑے) کا استعمال اور فقہی دلائل۔" ;
    minaret:nameEn "Jurisprudence of Recitation and Handling the Mushaf (Ahkam al-Mushaf)" ;
    minaret:nameUr "تلاوت اور مصحف کو چھونے کے فقہی احکام (احکام المصحف)" .

minaret:Topic_Knowledge_of_Allah_and_certainty a minaret:Topic ;
    minaret:descriptionEn "Strengthening faith through Quran, divine names, reflection on creation and good company." ;
    minaret:descriptionUr "قرآن، اسمائے الٰہی، کائنات میں غور و فکر اور اچھی صحبت سے یقین مضبوط کرنا۔" ;
    minaret:nameEn "Knowledge of Allah and certainty" ;
    minaret:nameUr "معرفتِ الٰہی اور یقین" .

minaret:Topic_Linguistic_Roots_and_Essence_of_Gentleness_Al_Rifq a minaret:Topic ;
    minaret:descriptionEn "Detailed analysis of the root Ra-Fa-Qaf, signifying compassion, ease, assistance, mutual friendship, and pleasant companionship." ;
    minaret:descriptionUr "مادہ 'ر ف ق' کی تشریح جس سے نفع رسانی، نرمی، باہمی سہولت، رفاقت اور دوستی کے معانی نکلتے ہیں۔" ;
    minaret:nameEn "Linguistic Roots and Essence of Gentleness (Al-Rifq)" ;
    minaret:nameUr "رفق کے لغوی و اصطلاحی مفاہیم اور بنیادی روٹ" .

minaret:Topic_Linguistic_and_Conceptual_Definition_of_Shifa a minaret:Topic ;
    minaret:descriptionEn "Etymological and practical meanings of Shifa (healing/cure) and its contrast with literal boundaries." ;
    minaret:descriptionUr "شفا کے لغوی معنی، صحت و تندرستی، اور اس کے مختلف استعمالات۔" ;
    minaret:nameEn "Linguistic and Conceptual Definition of Shifa" ;
    minaret:nameUr "شفا کا لغوی اور اصطلاحی مفہوم" .

minaret:Topic_Majesty_of_the_Quran_Azmat_e_Quran a minaret:Topic ;
    minaret:descriptionEn "The transcendent weight, solemnity, and decisive nature of divine revelation." ;
    minaret:descriptionUr "قرآنِ کریم کی روحانی ہیبت، عظمت اور فیصلہ کن کلام ہونے کی حقیقت۔" ;
    minaret:nameEn "Majesty of the Quran (Azmat-e-Quran)" ;
    minaret:nameUr "عظمتِ قرآن" .

minaret:Topic_Minding_One_s_Affairs_Tark_Ma_La_Ya_nih a minaret:Topic ;
    minaret:descriptionEn "Excellence in faith demonstrated by self-restraint and avoiding unnecessary interference in what does not concern one." ;
    minaret:descriptionUr "کامل ایمان کی نشانی یہ ہے کہ انسان اپنے نفس پر قابو رکھے اور غیر ضروری امور میں دخل اندازی سے گریز کرے۔" ;
    minaret:nameEn "Minding One's Affairs (Tark Ma La Ya'nih)" ;
    minaret:nameUr "اپنے معاملات میں مشغولیت (ترکِ ما لا یعنیہ)" .

minaret:Topic_Miraculous_Nature_of_the_Quran_I_jaz a minaret:Topic ;
    minaret:descriptionEn "Textual invariance across fourteen centuries and alignment with scientific realities." ;
    minaret:descriptionUr "چودہ سو سالہ تحریری و لغوی حفاظت اور جدید سائنسی اکتشافات سے ہم آہنگی۔" ;
    minaret:nameEn "Miraculous Nature of the Quran (I'jaz)" ;
    minaret:nameUr "اعجازِ قرآن اور سائنسی حقائق" .

minaret:Topic_Monotheism_and_Sincerity_Tawheed a minaret:Topic ;
    minaret:descriptionEn "Foundational establishment of pure Tawheed at the Kaaba, shunning all forms of idolatry and shirk." ;
    minaret:descriptionUr "بیت اللہ کی بنیاد خالص توحید پر قائم کرنے اور ہر قسم کے شرک اور بت پرستی کی نفی۔" ;
    minaret:nameEn "Monotheism and Sincerity (Tawheed)" ;
    minaret:nameUr "خالص توحید اور اخلاص" ;
    skos:closeMatch hadith:Tauhid .

minaret:Topic_Names_and_attributes_of_Allah a minaret:Topic ;
    minaret:descriptionEn "Divine nearness and response to prayer, as explained through Al-Qarib and Al-Mujib." ;
    minaret:descriptionUr "القریب اور المجیب کے مفہوم کے ذریعے اللہ کے قرب اور دعا کی قبولیت کی وضاحت۔" ;
    minaret:nameEn "Names and attributes of Allah" ;
    minaret:nameUr "اللہ کے اسماء و صفات" ;
    skos:closeMatch hadith:ArticlesOfFaith .

minaret:Topic_Obedience_and_certainty_of_faith a minaret:Topic ;
    minaret:descriptionEn "Connecting acceptance of supplication with obedience and trust in Allah." ;
    minaret:descriptionUr "دعا کی قبولیت کو اللہ کی اطاعت اور اس پر یقین سے جوڑنا۔" ;
    minaret:nameEn "Obedience and certainty of faith" ;
    minaret:nameUr "اطاعت اور یقین" .

minaret:Topic_Oneness_of_Allah_Tawhid a minaret:Topic ;
    minaret:descriptionEn "The lecturer argues for directing supplication to Allah alone and critiques appeals to the dead." ;
    minaret:descriptionUr "مقررہ صرف اللہ سے دعا کرنے کی تاکید اور مردوں کو پکارنے پر تنقید کرتی ہیں۔" ;
    minaret:nameEn "Oneness of Allah (Tawhid)" ;
    minaret:nameUr "توحید" ;
    skos:closeMatch hadith:Tauhid .

minaret:Topic_Ontology_and_Linguistic_Definition_of_Injustice_Al_Zulm a minaret:Topic ;
    minaret:descriptionEn "Linguistic root and theological reality of Zulm as placing something outside its rightful place, darkness, and exceeding boundaries." ;
    minaret:descriptionUr "لفظِ ظلم کے مادہ و اشتقاق کی تشریح کہ کسی چیز کو اس کے اصل مقام سے ہٹا دینا اور اعتدال سے تجاوز کرنا ظلم کہلاتا ہے۔" ;
    minaret:nameEn "Ontology and Linguistic Definition of Injustice (Al-Zulm)" ;
    minaret:nameUr "ظلم کی حقیقت، لغوی تعریف اور شرعی مفہوم" .

minaret:Topic_Oral_Tradition_and_Recitation_Qira_at a minaret:Topic ;
    minaret:descriptionEn "The preservation of phonetics, tajweed, and oral transmission alongside calligraphy." ;
    minaret:descriptionUr "تجوید، مخارج، حفاظتی قراءت اور خطاطی کے ذریعے قرآن کی صوتی و بصری حفاظت۔" ;
    minaret:nameEn "Oral Tradition and Recitation (Qira'at)" ;
    minaret:nameUr "فنِ قراءت اور صوتی روایت" .

minaret:Topic_Patience_Sabr a minaret:Topic ;
    minaret:descriptionEn "Enduring travel hardships with emotional resilience and remaining steadfast in obedience." ;
    minaret:descriptionUr "سفر کی مشکلات پر صبر اور اطاعت میں ثابت قدمی۔" ;
    minaret:nameEn "Patience (Sabr)" ;
    minaret:nameUr "صبر" .

minaret:Topic_Patience_and_the_Sunnah_Du_a_upon_Calamity a minaret:Topic ;
    minaret:descriptionEn "The etiquettes of reacting to calamities with 'Inna Lillahi wa inna ilaihi raji'un' and seeking a better substitute from Allah." ;
    minaret:descriptionUr "صدمے کے وقت 'إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ' پڑھنے اور بہتر نعم البدل کی دعا کرنے کا حکم۔" ;
    minaret:nameEn "Patience and the Sunnah Du'a upon Calamity" ;
    minaret:nameUr "مصیبت پر صبر اور مسنون دعا" .

minaret:Topic_Personal_Hygiene_Resource_Stewardship_and_Eschatological_Accounting a minaret:Topic ;
    minaret:descriptionEn "Nuisance caused by foul odors, wastage of communal resources, and the inevitability of surrendering good deeds on the Day of Resurrection." ;
    minaret:descriptionUr "بدبو اور گندگی سے دوسروں کو ستانا، وسائل کا غیر دانشمندانہ استعمال اور قیامت کے دن ظالموں سے نیکیوں کی وصولی کا خوف۔" ;
    minaret:nameEn "Personal Hygiene, Resource Stewardship, and Eschatological Accounting" ;
    minaret:nameUr "جسمانی نظافت، وسائل کا بے جا استعمال اور اخروی محاسبہ" .

minaret:Topic_Pilgrimage_Modalities_and_Fasting_Expiation_Tamattu_Siyam a minaret:Topic ;
    minaret:descriptionEn "The legitimacy of Hajj Tamattu' and the substitution of ten fasts when sacrificial livestock cannot be procured." ;
    minaret:descriptionUr "حج تمتع کا شرعی ثبوت اور قربانی کی استطاعت نہ ہونے پر دس روزوں (تین حج میں، سات گھر واپسی پر) کی ادائیگی۔" ;
    minaret:nameEn "Pilgrimage Modalities and Fasting Expiation (Tamattu' & Siyam)" ;
    minaret:nameUr "اقسامِ حج اور قربانی کے بدل کے روزے" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Praise_and_Divine_Sovereignty_Hamd_wa_Rububiyyah a minaret:Topic ;
    minaret:descriptionEn "All absolute praise belonging to Allah, the Lord and Sustainer of all creations and realms." ;
    minaret:descriptionUr "تمام کائنات کے پروردگار اور رب العالمین کے لیے تمام تر حمد و ثنا کا اعتراف۔" ;
    minaret:nameEn "Praise and Divine Sovereignty (Hamd wa Rububiyyah)" ;
    minaret:nameUr "حمد اور ربوبیتِ الٰہی" .

minaret:Topic_Prayer_and_Discipline_Salah a minaret:Topic ;
    minaret:descriptionEn "Straightening and aligning rows in prayer as an integral element of worship and communal order." ;
    minaret:descriptionUr "نماز میں صفیں سیدھی اور برابر رکھنا عبادت اور اجتماعی نظم کا لازمی حصہ ہے۔" ;
    minaret:nameEn "Prayer and Discipline (Salah)" ;
    minaret:nameUr "نماز اور نظم و ضبط" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Prophetic_Authority_and_Ritual_Adherence_Manasik a minaret:Topic ;
    minaret:descriptionEn "The command of Rasulullah to learn pilgrimage rites directly from his practice without human innovation." ;
    minaret:descriptionUr "رسول اللہ صلی اللہ علیہ وسلم کا فرمان کہ مناسکِ حج مجھ سے سیکھو اور من گھڑت طریقوں سے اجتناب کرو۔" ;
    minaret:nameEn "Prophetic Authority and Ritual Adherence (Manasik)" ;
    minaret:nameUr "اتباعِ سنت اور مناسکِ حج کی ادائیگی" .

minaret:Topic_Prophetic_Examples_of_Shifa_Through_Du_a a minaret:Topic ;
    minaret:descriptionEn "Examples of healing without material medicine from the lives of Ayyub, Ya'qub, Zakariyya, and prophetic traditions." ;
    minaret:descriptionUr "حضرت ایوب، یعقوب، اور زکریا علیہم السلام کے واقعات کے ذریعے دعا کی تاثیر۔" ;
    minaret:nameEn "Prophetic Examples of Shifa Through Du'a" ;
    minaret:nameUr "انبیاء کرام کے واقعات اور دعا سے شفا" .

minaret:Topic_Prophetic_Exemplar_Uswah_Hasanah a minaret:Topic ;
    minaret:descriptionEn "The sublime moral perfection of Prophet Muhammad as witnessed by his companions, servant Zayd ibn Harithah, and family." ;
    minaret:descriptionUr "نبی اکرم صلی اللہ علیہ وسلم کے اخلاقِ عالیہ، رحمدلی اور حضرت زید بن حارثہؓ کا رسول اللہ سے قلبی تعلق۔" ;
    minaret:nameEn "Prophetic Exemplar / Uswah Hasanah" ;
    minaret:nameUr "اسوۂ حسنہ اور رحمتِ نبوی" .

minaret:Topic_Prophetic_Forbearance_Hilm_in_Responding_to_Hostility a minaret:Topic ;
    minaret:descriptionEn "The Prophet's dignified composure in answering the verbal abuse of the Jews, enjoining gentleness and forbidding obscenity." ;
    minaret:descriptionUr "یہود کی بددعا پر رسول اللہ صلی اللہ علیہ وسلم کا متانت بھرا جواب اور حضرت عائشہؓ کو نرمی کی تلقین۔" ;
    minaret:nameEn "Prophetic Forbearance (Hilm) in Responding to Hostility" ;
    minaret:nameUr "ایذا رسانی پر حلمِ نبوی اور بدکلامی سے اجتناب کی تلقین" .

minaret:Topic_Prophetic_Gentleness_in_Da_wah_and_Interpersonal_Ties a minaret:Topic ;
    minaret:descriptionEn "Reflecting on Surah Ali 'Imran:159 detailing how divine mercy made the Prophet gentle, attracting hearts toward Islam." ;
    minaret:descriptionUr "سورۃ آل عمران (159) کی روشنی میں رسول اللہ صلی اللہ علیہ وسلم کے نرم مزاج اور قلوب کو جوڑنے والی رحمت کا بیان۔" ;
    minaret:nameEn "Prophetic Gentleness in Da'wah and Interpersonal Ties" ;
    minaret:nameUr "دعوت میں پیغمبرانہ شفقت اور نبی کریمؐ کا اسوۂ حسنہ" .

minaret:Topic_Psychological_and_Neurobiological_Benefits_of_Gratitude a minaret:Topic ;
    minaret:descriptionEn "The healing effects of active gratitude journaling, positive self-talk, and brain re-wiring via Hebbian learning." ;
    minaret:descriptionUr "مثبت سوچ، شکر گزاری کی مشق اور ہیبین اصول کے تحت ذہنی سکون اور شفا کا حصول۔" ;
    minaret:nameEn "Psychological and Neurobiological Benefits of Gratitude" ;
    minaret:nameUr "شکر گزاری کے نفسیاتی اور دماغی فوائد" .

minaret:Topic_Purifying_the_Soul_from_Vices_Tazkiyat_al_Nafs a minaret:Topic ;
    minaret:descriptionEn "The profound personal struggle required to purge deep-seated vices and bad habits from oneself, needing sustained effort and divine aid." ;
    minaret:descriptionUr "برائیوں اور بری عادات کو اپنے نفس سے نکالنے کی گہری ذاتی جدوجہد، جس کے لیے مسلسل کوشش اور اللہ کی مدد درکار ہے۔" ;
    minaret:nameEn "Purifying the Soul from Vices (Tazkiyat al-Nafs)" ;
    minaret:nameUr "تزکیہ نفس اور بری عادات کا خاتمہ" .

minaret:Topic_Quranic_Verses_on_Healing_Shifa a minaret:Topic ;
    minaret:descriptionEn "Detailed examination of the six Quranic references mentioning Shifa in various contexts." ;
    minaret:descriptionUr "قرآن مجید میں شفا کے حوالے سے وارد ہونے والی چھ آیات کا تفصیلی جائزہ۔" ;
    minaret:nameEn "Quranic Verses on Healing (Shifa)" ;
    minaret:nameUr "قرآن کریم میں شفا کا بیان" .

minaret:Topic_Reliance_on_Allah_vs_Material_Causes_At_Tawakkul a minaret:Topic ;
    minaret:descriptionEn "True reliance versus mere reliance on material means and beginning all affairs with the Basmalah." ;
    minaret:descriptionUr "اسباب کے دائرے میں رہ کر مسبب الاسباب پر بھروسہ اور تسمیہ کے ساتھ ہر کام کی ابتدا۔" ;
    minaret:nameEn "Reliance on Allah vs Material Causes (At-Tawakkul)" ;
    minaret:nameUr "توکل علی اللہ بمقابلہ اسباب پرستی" .

minaret:Topic_Sacrifice_Hady a minaret:Topic ;
    minaret:descriptionEn "Ritual slaughter of sacrificial livestock during Hajj." ;
    minaret:descriptionUr "حج کے دوران قربانی کے جانور ذبح کرنا۔" ;
    minaret:nameEn "Sacrifice (Hady)" ;
    minaret:nameUr "قربانی" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Sacrificial_Animals_and_Fidya_for_Violations_Hady_Kaffarah a minaret:Topic ;
    minaret:descriptionEn "Compensatory ransoms of fasting, charity, or sacrifice for shaving or committing unavoidable Ihram infractions." ;
    minaret:descriptionUr "عذر کی بنا پر احرام کی پابندی ٹوٹنے پر روزہ، صدقہ یا ذبح کی صورت میں فدیہ ادا کرنا۔" ;
    minaret:nameEn "Sacrificial Animals and Fidya for Violations (Hady & Kaffarah)" ;
    minaret:nameUr "قربانی اور احرام کے ممنوعات کا فدیہ" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_Sanctity_and_Cleanliness_of_Sacred_Spaces_Taharah a minaret:Topic ;
    minaret:descriptionEn "Inward spiritual purification from sins and outward cleanliness of the House of Allah for worshippers." ;
    minaret:descriptionUr "گناہوں اور معصیت سے باطنی پاکیزگی اور نمازیوں و طواف کرنے والوں کے لیے مسجد کی ظاہری صفائی۔" ;
    minaret:nameEn "Sanctity and Cleanliness of Sacred Spaces (Taharah)" ;
    minaret:nameUr "شعائر و مساجد کی ظاہری و باطنی طہارت" .

minaret:Topic_Sanctity_and_Virtues_of_Makkah a minaret:Topic ;
    minaret:descriptionEn "The sacred status of Makkah as Al-Balad al-Amin, its blessings, security, and multiplication of rewards." ;
    minaret:descriptionUr "مکہ مکرمہ کی حرمت، امن و سلامتی، برکات اور وہاں نیکیوں پر اجر کی کثرت کا بیان۔" ;
    minaret:nameEn "Sanctity and Virtues of Makkah" ;
    minaret:nameUr "مکہ مکرمہ کا احترام اور فضائل" .

minaret:Topic_Seeking_Forgiveness_Istighfar_Tawbah a minaret:Topic ;
    minaret:descriptionEn "Maintaining constant repentance morning and evening, reflecting upon personal shortcomings, and adhering to the Prophetic tradition of istighfar." ;
    minaret:descriptionUr "صبح و شام کثرت سے استغفار کرنا، اپنی کوتاہیوں کا اعتراف اور روزانہ کثرت سے توبہ کی نبوی سنت پر عمل پیرا ہونا۔" ;
    minaret:nameEn "Seeking Forgiveness (Istighfar & Tawbah)" ;
    minaret:nameUr "استغفار اور توبہ" .

minaret:Topic_Seeking_Islamic_Knowledge_Talab_al_Ilm a minaret:Topic ;
    minaret:descriptionEn "Preparing for worship through authentic Quranic and Sunnah knowledge, personal day-planners, and studying verified religious guides." ;
    minaret:descriptionUr "حج کے ارکان کو سنت کے مطابق ادا کرنے کے لیے پیشگی علم حاصل کرنا، نوٹس بنانا اور غلطیوں سے حفاظت کی تیاری۔" ;
    minaret:nameEn "Seeking Islamic Knowledge (Talab al-'Ilm)" ;
    minaret:nameUr "طلبِ علمِ دین" .

minaret:Topic_Seeking_the_Straight_Path_Al_Hidayah a minaret:Topic ;
    minaret:descriptionEn "Supplication for divine guidance to the straight path trodden by the blessed, avoiding divine wrath and astray paths." ;
    minaret:descriptionUr "سیدھے راستے کی دعا، جو انعام یافتہ بندوں کا راستہ ہے، اور گمراہی و غضب کے راستوں سے پناہ۔" ;
    minaret:nameEn "Seeking the Straight Path (Al-Hidayah)" ;
    minaret:nameUr "طلبِ ہدایت اور صراطِ مستقیم" .

minaret:Topic_Sincerity_Willpower_and_Overcoming_Learning_Barriers_Al_Ikhlas a minaret:Topic ;
    minaret:descriptionEn "The transformative miracle of the Quran across ages, language backgrounds, and the role of sincere intention." ;
    minaret:descriptionUr "عمر اور زبان کی قید سے بالاتر قرآنی اعجاز، اخلاصِ نیت اور حصولِ علم کے لیے سچی لگن۔" ;
    minaret:nameEn "Sincerity, Willpower, and Overcoming Learning Barriers (Al-Ikhlas)" ;
    minaret:nameUr "اخلاص، عزم اور تعلیمی رکاوٹوں پر قابو پانا (اخلاص)" .

minaret:Topic_Sincerity_and_Exclusivity_of_Devotion_Ikhlas a minaret:Topic ;
    minaret:descriptionEn "Undertaking pilgrimage solely for the pleasure of Allah, completely free of ostentation, pride, or worldly gain." ;
    minaret:descriptionUr "حج و عمرہ کو خالص اللہ کی رضا کے لیے ادا کرنا اور ریا، شہرت اور نمائش سے مکمل بچنا۔" ;
    minaret:nameEn "Sincerity and Exclusivity of Devotion (Ikhlas)" ;
    minaret:nameUr "اخلاصِ نیت اور ریاکاری کی ممانعت" .

minaret:Topic_Spiritual_Forfeiture_Incurred_by_Lacking_Gentleness a minaret:Topic ;
    minaret:descriptionEn "Prophetic traditions warning that being deprived of gentleness is synonymous with being barred from all comprehensive goodness." ;
    minaret:descriptionUr "احادیثِ نبویہ کی تنبیہ کہ جس شخص کو نرمی کی دولت نہ ملی وہ دارین کی ہر خیر و برکت سے محروم رہ گیا۔" ;
    minaret:nameEn "Spiritual Forfeiture Incurred by Lacking Gentleness" ;
    minaret:nameUr "نرمی سے محرومی پر تمام بھلائیوں سے محرومی کی وعید" .

minaret:Topic_Spiritual_Remedies_and_the_Power_of_Remembrance a minaret:Topic ;
    minaret:descriptionEn "The impact of Quranic recitation, dhikr, and positive mental/spiritual conditioning on health and disease." ;
    minaret:descriptionUr "قرآن کی تلاوت، ذکر، اور مثبت سوچ کے جسمانی اور ذہنی صحت پر اثرات۔" ;
    minaret:nameEn "Spiritual Remedies and the Power of Remembrance" ;
    minaret:nameUr "روحانی علاج اور ذکرِ الہی کے اثرات" .

minaret:Topic_Tasbeeh_and_Divine_Transcendence_in_Tribulations a minaret:Topic ;
    minaret:descriptionEn "How glorification (subhan Allah wa bihamdihi) removes anxiety and brings deliverance, illustrated by Prophet Yunus and the celestial hosts." ;
    minaret:descriptionUr "تسبیح کے فضائل، اللہ کو ہر عیب سے پاک جاننا اور حضرت یونس علیہ السلام کے واقعے سے رہنمائی۔" ;
    minaret:nameEn "Tasbeeh and Divine Transcendence in Tribulations" ;
    minaret:nameUr "تسبیح اور آزمائشوں میں نجات" .

minaret:Topic_The_Covenant_of_Worship_and_the_Hadith_of_Dividing_Salah_Al_Ahd a minaret:Topic ;
    minaret:descriptionEn "The sacred dialogue between Allah and the servant in prayer through Surah Al-Fatihah." ;
    minaret:descriptionUr "نماز کو رب اور بندے کے درمیان تقسیم کرنے کی حدیثِ قدسی اور سجدۂ بندگی کی حقیقت۔" ;
    minaret:nameEn "The Covenant of Worship and the Hadith of Dividing Salah (Al-'Ahd)" ;
    minaret:nameUr "عہدِ عبودیت اور حدیثِ تقسیمِ نماز" ;
    skos:closeMatch hadith:PillarsOfIslam .

minaret:Topic_The_Day_of_Recompense_Yawm_ad_Din a minaret:Topic ;
    minaret:descriptionEn "Affirmation of Allah's absolute ownership and judgment on the Day of Resurrection and accountability." ;
    minaret:descriptionUr "قیامت کے دن کی حاکمیت اور جزا و سزا کے نظام پر ایمان۔" ;
    minaret:nameEn "The Day of Recompense (Yawm ad-Din)" ;
    minaret:nameUr "مالکِ روزِ جزا" .

minaret:Topic_The_Distressed_Supplicant_Al_Mudhtarr a minaret:Topic ;
    minaret:descriptionEn "Definition of Al-Mudhtarr (the distressed) and how sincere du'a in extreme hardship invokes divine relief." ;
    minaret:descriptionUr "مضطر کی تعریف اور شدید تکلیف میں خلوصِ دل سے دعا کرنے کے ذریعے غیبی مدد کا حصول۔" ;
    minaret:nameEn "The Distressed Supplicant (Al-Mudhtarr)" ;
    minaret:nameUr "مضطر (بے قرار پکارنے والا)" .

minaret:Topic_The_Essence_of_Worship_Humility_and_Love_Al_Ibadah a minaret:Topic ;
    minaret:descriptionEn "The lexical definition of 'Ubudiyyah combining total submission (Khudu') and utmost love (Kamal al-Hubb)." ;
    minaret:descriptionUr "لسان العرب کی روشنی میں عبودیت کی حقیقت: خضوع و تذلل اور انتہائی عاجزی و محبت کا ملاپ۔" ;
    minaret:nameEn "The Essence of Worship: Humility and Love (Al-'Ibadah)" ;
    minaret:nameUr "روحِ عبادت: کمالِ عاجزی اور کمالِ محبت" .

minaret:Topic_The_Four_Spiritual_Stations_of_Calamity a minaret:Topic ;
    minaret:descriptionEn "Categorization of human responses to hardship: discontentment, patience (sabr), contentment (rida), and gratitude (shukr)." ;
    minaret:descriptionUr "مصیبت کے وقت انسان کے چار باطنی درجات: ناراضگی، صبر، رضا بالقضاء، اور شکر۔" ;
    minaret:nameEn "The Four Spiritual Stations of Calamity" ;
    minaret:nameUr "آزمائش پر ردِ عمل کے چار درجات" .

minaret:Topic_The_Islamic_Will_Al_Wasiyyah a minaret:Topic ;
    minaret:descriptionEn "The legal and spiritual necessity of drafting a binding Islamic will to settle all debts and moral responsibilities before departing." ;
    minaret:descriptionUr "سفرِ حج پر روانگی سے قبل مالی و شرعی حقوق کی ادائیگی اور ایک قانونی و شرعی وصیت نامہ تحریر کرنے کی اہمیت۔" ;
    minaret:nameEn "The Islamic Will (Al-Wasiyyah)" ;
    minaret:nameUr "وصیت نامہ (الوصیہ)" .

minaret:Topic_The_Meaning_of_Ad_Din_and_Divine_Judgment_Al_Jaza a minaret:Topic ;
    minaret:descriptionEn "Examining the specific Quranic usage of 'Ad-Din' as retribution, recompense, and accountability on the Last Day." ;
    minaret:descriptionUr "قرآن میں لفظِ دین کا روزِ جزا و سزا اور اخروی حساب کتاب کے مفہوم میں اختصاصی استعمال۔" ;
    minaret:nameEn "The Meaning of Ad-Din and Divine Judgment (Al-Jaza')" ;
    minaret:nameUr "لفظِ دین کا مفہوم اور جزا و سزا (الجزاء)" .

minaret:Topic_The_Parable_of_the_Believer_and_Ethical_Resilience a minaret:Topic ;
    minaret:descriptionEn "The prophetic metaphor comparing the believer to an adaptable plant bending gracefully under life's storms without snapping." ;
    minaret:descriptionUr "حدیثِ نبوی میں مومن کی مثال ایک زرعی پودے سے جو تیز ہوا کے سامنے لچک دکھا کر ٹوٹنے سے محفوظ رہتا ہے۔" ;
    minaret:nameEn "The Parable of the Believer and Ethical Resilience" ;
    minaret:nameUr "مومن کی تمثیل بطور لچکدار پودا اور حوادث میں استقامت" .

minaret:Topic_The_Prohibition_of_Injustice_in_Sacred_Texts_Tahrim_al_Zulm a minaret:Topic ;
    minaret:descriptionEn "Quranic condemnations of oppressors and the solemn Hadith Qudsi where Allah declares injustice forbidden upon Himself and His servants." ;
    minaret:descriptionUr "ظالموں کے انجام پر قرآنی انتباہ اور حدیثِ قدسی کی صراحت کہ اللہ نے اپنی ذات اور بندوں پر ظلم کو قطعی حرام قرار دیا ہے۔" ;
    minaret:nameEn "The Prohibition of Injustice in Sacred Texts (Tahrim al-Zulm)" ;
    minaret:nameUr "قرآن و سنت میں ظلم کی حرمت اور وعید" .

minaret:Topic_The_Scales_of_Judgment_Mizan a minaret:Topic ;
    minaret:descriptionEn "Good character weighing heavier than any deed on the Scales of the Hereafter, elevating a believer to the rank of those who continuously fast and pray." ;
    minaret:descriptionUr "قیامت کے دن میزان میں حُسنِ اخلاق کی سب سے بھاری نیکی اور روزہ دار و شب بیدار کے درجے کا حصول۔" ;
    minaret:nameEn "The Scales of Judgment / Mizan" ;
    minaret:nameUr "میزانِ عمل اور اخلاق کا وزن" ;
    skos:closeMatch hadith:ArticlesOfFaith .

minaret:Topic_The_Spiritual_Map_Sirat_al_Mustaqim_and_Human_Categories_As_Sirat a minaret:Topic ;
    minaret:descriptionEn "The righteous path of prophets and martyrs contrasted with knowledge without action and action without knowledge." ;
    minaret:descriptionUr "انبیاء و صالحین کا سیدھا راستہ بمقابلہ علم کے باوجود بے عملی (مغضوب) اور بے علم بھٹکنے والے (ضالین)۔" ;
    minaret:nameEn "The Spiritual Map: Sirat al-Mustaqim and Human Categories (As-Sirat)" ;
    minaret:nameUr "صراطِ مستقیم کا نقشہ اور انسانی گروہ" .

minaret:Topic_The_Straight_Path_and_the_Trial_of_the_Pul_Sirat_As_Sirat a minaret:Topic ;
    minaret:descriptionEn "The earthly and heavenly bridges of Sirat, satanic detours, steadfastness, and avoiding the paths of wrath and error." ;
    minaret:descriptionUr "دنیا و آخرت کے پل صراط کی مشابہت، شیطانی راستوں سے بچاؤ اور انعام یافتہ بندوں کی راہ پر استقامت۔" ;
    minaret:nameEn "The Straight Path and the Trial of the Pul-Sirat (As-Sirat)" ;
    minaret:nameUr "صراطِ مستقیم، فتنوں سے حفاظت اور پل صراط کی آزمائش" .

minaret:Topic_Trials_as_Means_of_Purification_and_Sincerity a minaret:Topic ;
    minaret:descriptionEn "Understanding why Allah tests believers with hardships to strip away reliance on others and foster pure sincerity (ikhlas)." ;
    minaret:descriptionUr "بندے کو آزمائشوں میں ڈالنے کی الہی حکمت تا کہ اس کا دل غیر اللہ سے کٹ کر خالص ہو جائے۔" ;
    minaret:nameEn "Trials as Means of Purification and Sincerity" ;
    minaret:nameUr "آزمائشیں بطورِ تطہیر اور اخلاص" .

minaret:Topic_Truthfulness_Sidq a minaret:Topic ;
    minaret:descriptionEn "The virtue and command of speaking truthfully." ;
    minaret:descriptionUr "سچ بولنے کی فضیلت اور حکم۔" ;
    minaret:nameEn "Truthfulness (Sidq)" ;
    minaret:nameUr "سچائی" .

minaret:Topic_Veneration_of_Divine_Symbols_Ta_dheem_Sha_air_Allah a minaret:Topic ;
    minaret:descriptionEn "Honoring sacred places, sacrificial beasts, and pilgrimage ordinances as evidence of piety in the heart." ;
    minaret:descriptionUr "مقدس مقامات، قربانی کے جانوروں اور مناسک کی تعظیم جو دلوں کے تقویٰ کی علامت ہے۔" ;
    minaret:nameEn "Veneration of Divine Symbols (Ta'dheem Sha'air Allah)" ;
    minaret:nameUr "شعائرِ الٰہی کی تعظیم" .

minaret:Topic_Virtues_and_Scholarly_Eminence_of_Mother_of_the_Believers_Aisha_RA a minaret:Topic ;
    minaret:descriptionEn "Highlighting Aisha's legal jurisprudence, inheritance expertise, medicine, memory, and unparalleled charity." ;
    minaret:descriptionUr "سیدہ عائشہؓ کا تبحرِ علمی، وراثت و طب میں مہارت، فصاحت و بلاغت اور بے مثل سخاوت و ایثار۔" ;
    minaret:nameEn "Virtues and Scholarly Eminence of Mother of the Believers Aisha (RA)" ;
    minaret:nameUr "ام المؤمنین سیدہ عائشہ رضی اللہ عنہا کے مناقب اور علمی فضیلت" .

minaret:Topic_Virtues_and_Unique_Status_of_Surah_Al_Fatihah_Fada_il_al_Fatihah a minaret:Topic ;
    minaret:descriptionEn "Revelation of the two lights, greatest Surah, cure (Shifa), and mother of the book (Umm al-Kitab)." ;
    minaret:descriptionUr "دو نوروں کی بشارت، سب سے عظیم سورت، سبع مثانی اور شفاء و رقیہ کے فضائل۔" ;
    minaret:nameEn "Virtues and Unique Status of Surah Al-Fatihah (Fada'il al-Fatihah)" ;
    minaret:nameUr "فضائل و خصوصیاتِ سورۃ الفاتحہ" .

minaret:Topic_Virtues_of_Hajj_and_Umrah a minaret:Topic ;
    minaret:descriptionEn "Expiation of sins through consecutive Umrahs and the guaranteed reward of Paradise (Jannah) for an accepted Hajj (Hajj Mabroor)." ;
    minaret:descriptionUr "پے در پے عمروں کے ذریعے گناہوں کا کفارہ اور حج مبرور کے بدلے جنت کی قطعی بشارت۔" ;
    minaret:nameEn "Virtues of Hajj and Umrah" ;
    minaret:nameUr "فضائل حج و عمرہ" ;
    skos:closeMatch hadith:PillarsOfIslam .

