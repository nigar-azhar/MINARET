minaret:QuranVerse_20_28 a minaret:QuranVerse ;
    minaret:juz 16 ;
    minaret:surahNumber 20 ;
    minaret:textClean "يفقهوا قولي" ;
    minaret:textIndopak "یَفْقَهُوْا قَوْلِیْ ۪۟" ;
    minaret:textUthmani "يَفۡقَهُواْ قَوۡلِي" ;
    minaret:translationEn "That they may understand my speech." ;
    minaret:translationUr "" ;
    minaret:verseNumber 28 ;
    skos:exactMatch qur:quran20-28,
        tafsir:V020_028 .

minaret:QuranVerse_2_196 a minaret:QuranVerse ;
    minaret:juz 2 ;
    minaret:surahNumber 2 ;
    minaret:textClean "وأتموا الحج والعمرة لله ۚ فإن أحصرتم فما استيسر من الهدي ۖ ولا تحلقوا رءوسكم حتى يبلغ الهدي محله ۚ فمن كان منكم مريضا أو به أذى من رأسه ففدية من صيام أو صدقة أو نسك ۚ فإذا أمنتم فمن تمتع بالعمرة إلى الحج فما استيسر من الهدي ۚ فمن لم يجد فصيام ثلاثة أيام في الحج وسبعة إذا رجعتم ۗ تلك عشرة كاملة ۗ ذلك لمن لم يكن أهله حاضري المسجد الحرام ۚ واتقوا الله واعلموا أن الله شديد العقاب" ;
    minaret:textIndopak "وَاَتِمُّوا الْحَجَّ وَالْعُمْرَةَ لِلّٰهِ ؕ فَاِنْ اُحْصِرْتُمْ فَمَا اسْتَیْسَرَ مِنَ الْهَدْیِ ۚ وَلَا تَحْلِقُوْا رُءُوْسَكُمْ حَتّٰی یَبْلُغَ الْهَدْیُ مَحِلَّهٗ ؕ فَمَنْ كَانَ مِنْكُمْ مَّرِیْضًا اَوْ بِهٖۤ اَذًی مِّنْ رَّاْسِهٖ فَفِدْیَةٌ مِّنْ صِیَامٍ اَوْ صَدَقَةٍ اَوْ نُسُكٍ ۚ فَاِذَاۤ اَمِنْتُمْ ۥ فَمَنْ تَمَتَّعَ بِالْعُمْرَةِ اِلَی الْحَجِّ فَمَا اسْتَیْسَرَ مِنَ الْهَدْیِ ۚ فَمَنْ لَّمْ یَجِدْ فَصِیَامُ ثَلٰثَةِ اَیَّامٍ فِی الْحَجِّ وَسَبْعَةٍ اِذَا رَجَعْتُمْ ؕ تِلْكَ عَشَرَةٌ كَامِلَةٌ ؕ ذٰلِكَ لِمَنْ لَّمْ یَكُنْ اَهْلُهٗ حَاضِرِی الْمَسْجِدِ الْحَرَامِ ؕ وَاتَّقُوا اللّٰهَ وَاعْلَمُوْۤا اَنَّ اللّٰهَ شَدِیْدُ الْعِقَابِ ۟۠" ;
    minaret:textUthmani "وَأَتِمُّواْ ٱلۡحَجَّ وَٱلۡعُمۡرَةَ لِلَّهِۚ فَإِنۡ أُحۡصِرۡتُمۡ فَمَا ٱسۡتَيۡسَرَ مِنَ ٱلۡهَدۡيِۖ وَلَا تَحۡلِقُواْ رُءُوسَكُمۡ حَتَّىٰ يَبۡلُغَ ٱلۡهَدۡيُ مَحِلَّهُۥۚ فَمَن كَانَ مِنكُم مَّرِيضًا أَوۡ بِهِۦٓ أَذًى مِّن رَّأۡسِهِۦ فَفِدۡيَةٌ مِّن صِيَامٍ أَوۡ صَدَقَةٍ أَوۡ نُسُكٍۚ فَإِذَآ أَمِنتُمۡ فَمَن تَمَتَّعَ بِٱلۡعُمۡرَةِ إِلَى ٱلۡحَجِّ فَمَا ٱسۡتَيۡسَرَ مِنَ ٱلۡهَدۡيِۚ فَمَن لَّمۡ يَجِدۡ فَصِيَامُ ثَلَٰثَةِ أَيَّامٍ فِي ٱلۡحَجِّ وَسَبۡعَةٍ إِذَا رَجَعۡتُمۡۗ تِلۡكَ عَشَرَةٌ كَامِلَةٌۗ ذَٰلِكَ لِمَن لَّمۡ يَكُنۡ أَهۡلُهُۥ حَاضِرِي ٱلۡمَسۡجِدِ ٱلۡحَرَامِۚ وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ شَدِيدُ ٱلۡعِقَابِ" ;
    minaret:translationEn "And complete the Hajj and 'umrah for Allah. But if you are prevented, then [offer] what can be obtained with ease of sacrificial animals. And do not shave your heads until the sacrificial animal has reached its place of slaughter. And whoever among you is ill or has an ailment of the head [making shaving necessary must offer] a ransom of fasting [three days] or charity or sacrifice. And when you are secure, then whoever performs 'umrah [during the Hajj months] followed by Hajj [offers] what can be obtained with ease of sacrificial animals. And whoever cannot find [or afford such an animal] - then a fast of three days during Hajj and of seven when you have returned [home]. Those are ten complete [days]. This is for those whose family is not in the area of al-Masjid al-Haram. And fear Allah and know that Allah is severe in penalty." ;
    minaret:translationUr "اور حج اور عمرہ کو اللہ ہی کے لیے پورا کرو پھر اگر تم روک دئیے جاؤ تو قربانی میں سے جو میسر ہو کر دو اور اپنےسر نہ منڈواؤ جب تک قربانی اپنے ٹھکانے پر نہ پہنچ جائے، پھر تم میں سے جو بیما ر   ہو یا اس کے سر میں کسی طرح کی تکلیف ہو(اور وہ سر منڈوا  لے) تو روزے یا صدقے یا قربانی میں سے کوئی ایک فدیہ دے دے۔ پھر جب تم امن میں آ جاؤ، تو جو کوئی حج (کے دنوں) تک عمرے کا فائدہ اٹھائے تو جو قربانی میسر ہو کر لے ۔ پھر جو (قربانی) نہ پائےتوتین دن کے روزے حج کے دوران اور سات دن کے اس وقت رکھے جب تم (گھروں کو) واپس  جاؤ، یہ پورے دس ہیں۔ یہ (حکم) اس شخص کے لیے ہے جس کے اہل و عیال مسجد حرام (مکہ)کے رہنے والے نہ ہوںاور اللہ سے ڈرتے رہو اور جان لو کہ بے شک اللہ سخت سزا والا ہے ۔" ;
    minaret:verseNumber 196 ;
    skos:exactMatch qur:quran2-196,
        tafsir:V002_196 .

minaret:Topic_Supplication_in_Islam_Ad_Du_a a minaret:Topic ;
    minaret:descriptionEn "Engaging in continuous supplication, systematically compiling spiritual and life goals into a dedicated personal du'a diary." ;
    minaret:descriptionUr "دعا کو عبادت کی روح سمجھنا اور اپنی تمام دینی و دنیاوی تمناؤں کو باقاعدہ ڈائری میں لکھ کر مانگنا۔" ;
    minaret:nameEn "Supplication in Islam (Ad-Du'a)" ;
    minaret:nameUr "دعا اور تضرع" ;
    skos:altLabel "Supplication (Du'a)" ;
    skos:related minaret:Topic_Contentment_and_etiquette_of_supplication,
        minaret:Topic_Healing_and_supplication,
        minaret:Topic_Hope_and_perseverance_in_supplication,
        minaret:Topic_Supplication_and_humility,
        minaret:Topic_Supplication_and_reliance_on_Allah,
        minaret:Topic_Supplication_and_visiting_the_sick,
        minaret:Topic_Supplication_as_worship .

minaret:AudioSeries a owl:Class ;
    rdfs:label "Audio series" ;
    rdfs:comment "A named lecture series, e.g. TQ2005 (Talim al-Qur'an 2005). Sourced from the publisher's series catalogue." .

minaret:Dua_MasnoonDua-118 a minaret:Dua ;
    minaret:duaTypeEn "Masnoon Dua" ;
    minaret:duaTypeUr "مسنون دعاء" ;
    minaret:reference "MasnoonDua-118" ;
    minaret:translationEn "O Allah You have made my creation perfect, so make my moral characteristics also be the best." ;
    minaret:translationUr "یااللہ تو نے میری صورت اچھی بنائی ہے ایسے ہی میری سیرت بھی اچھی بنا دے" ;
    minaret:transliteration "" .

minaret:QuranVerse_1_2 a minaret:QuranVerse ;
    minaret:juz 1 ;
    minaret:surahNumber 1 ;
    minaret:textClean "الحمد لله رب العالمين" ;
    minaret:textIndopak "اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِیْنَ ۟ۙ" ;
    minaret:textUthmani "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ" ;
    minaret:translationEn "[All] praise is [due] to Allah, Lord of the worlds -" ;
    minaret:translationUr "سب تعریف اللہ ہی کےلیے ہے جو تمام جہانوں کا رب ہے ۔" ;
    minaret:verseNumber 2 ;
    skos:exactMatch qur:quran1-2,
        tafsir:V001_002 .

minaret:QuranVerse_1_7 a minaret:QuranVerse ;
    minaret:juz 1 ;
    minaret:surahNumber 1 ;
    minaret:textClean "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين" ;
    minaret:textIndopak "صِرَاطَ الَّذِیْنَ اَنْعَمْتَ عَلَیْهِمْ ۙ۬ۦ غَیْرِ الْمَغْضُوْبِ عَلَیْهِمْ وَلَا الضَّآلِّیْنَ ۟۠" ;
    minaret:textUthmani "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَ لَا ٱلضَّآلِّينَ" ;
    minaret:translationEn "The path of those upon whom You have bestowed favor, not of those who have evoked [Your] anger or of those who are astray." ;
    minaret:translationUr "ان لوگوں کا راستہ جن پر تو نے انعام کیا ،ان کا نہیں جن پر (تیرا ) غضب ہوا اور نہ گمراہ ہونے والوں کا۔" ;
    minaret:verseNumber 7 ;
    skos:exactMatch qur:quran1-7,
        tafsir:V001_007 .

minaret:QuranVerse_1_5 a minaret:QuranVerse ;
    minaret:juz 1 ;
    minaret:surahNumber 1 ;
    minaret:textClean "إياك نعبد وإياك نستعين" ;
    minaret:textIndopak "اِیَّاكَ نَعْبُدُ وَاِیَّاكَ نَسْتَعِیْنُ ۟ؕ" ;
    minaret:textUthmani "إِيَّاكَ نَعۡبُدُ وَ إِيَّاكَ نَسۡتَعِينُ" ;
    minaret:translationEn "It is You we worship and You we ask for help." ;
    minaret:translationUr "ہم صرف تیری ہی عبادت کرتے ہیں اورصرف تجھ ہی سے مدد چاہتے ہیں ۔" ;
    minaret:verseNumber 5 ;
    skos:exactMatch qur:quran1-5,
        tafsir:V001_005 .

minaret:Speaker_dr_farhat_hashmi a minaret:Speaker ;
    minaret:nameEn "Dr. Farhat Hashmi" ;
    minaret:nameUr "ڈاکٹر فرحت ہاشمی" ;
    minaret:speakerCode "dr_farhat_hashmi" .

minaret:Urdu a minaret:Language ;
    minaret:label "Urdu" ;
    minaret:languageCode "ur" .

minaret:QuranVerse_2_186 a minaret:QuranVerse ;
    minaret:juz 2 ;
    minaret:surahNumber 2 ;
    minaret:textClean "وإذا سألك عبادي عني فإني قريب ۖ أجيب دعوة الداع إذا دعان ۖ فليستجيبوا لي وليؤمنوا بي لعلهم يرشدون" ;
    minaret:textIndopak "وَاِذَا سَاَلَكَ عِبَادِیْ عَنِّیْ فَاِنِّیْ قَرِیْبٌ ؕ اُجِیْبُ دَعْوَةَ الدَّاعِ اِذَا دَعَانِ ۙ فَلْیَسْتَجِیْبُوْا لِیْ وَلْیُؤْمِنُوْا بِیْ لَعَلَّهُمْ یَرْشُدُوْنَ ۟" ;
    minaret:textUthmani "وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌۖ أُجِيبُ دَعۡوَةَ ٱلدَّاعِ إِذَا دَعَانِۖ فَلۡيَسۡتَجِيبُواْ لِي وَلۡيُؤۡمِنُواْ بِي لَعَلَّهُمۡ يَرۡشُدُونَ" ;
    minaret:translationEn "And when My servants ask you, [O Muhammad], concerning Me - indeed I am near. I respond to the invocation of the supplicant when he calls upon Me. So let them respond to Me [by obedience] and believe in Me that they may be [rightly] guided." ;
    minaret:translationUr "اور جب میرے بندے آپ سے میرے بارے میں سوال کریں تو(کہہ دیجئے) بے شک میں قریب ہوں، میں پکارنے والے کی پکار کا جواب دیتا ہوںجب بھی وہ مجھے پکارے تو ان کو چاہیے کہ وہ بھی میرا حکم مانیں اور مجھ پر ایمان رکھیں تاکہ وہ ہدایت پائیں ۔" ;
    minaret:verseNumber 186 ;
    skos:exactMatch qur:quran2-186,
        tafsir:V002_186 .

minaret:Audio a owl:Class ;
    rdfs:label "Audio" ;
    rdfs:comment "The physical audio file for a Recording. Mirrors one row of the publisher's audio catalogue. 1:1 with Recording." .

minaret:Transcript a owl:Class ;
    rdfs:label "Transcript" ;
    rdfs:comment "Holds only the final validated (V3 / Golden Transcript) text and pipeline provenance. V0-V2 are not represented in the graph." .

minaret:Dua a owl:Class ;
    rdfs:label "Dua" ;
    rdfs:comment "Canonical, reusable. Sourced from data/DBs/duas.csv, keyed by duaId (matches the 'reference' field already present in entity JSON, e.g. QuranicDua-08)." .

minaret:Paraphrase a minaret:CitationUsage ;
    minaret:label "Paraphrase" ;
    rdfs:comment "Restated in the speaker's own words. Covers source data's occasional 'explicit paraphrase' wording -- same value, not a distinct 4th type." .

minaret:Recording a owl:Class ;
    rdfs:label "Recording" ;
    rdfs:comment "One audio recording = one content-split unit (e.g. the 'Recap' part of a lesson). recordingId is the publisher's audio code, e.g. TQ2005_U001_S002_0001. Not the same as a pedagogical 'lesson' -- a lesson may be split across several Recordings." .

minaret:DuaOccurrence a owl:Class ;
    rdfs:label "Dua occurrence" ;
    rdfs:comment "One grounded mention of a dua within a SegmentGroup." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty minaret:hasUsageType ;
            owl:someValuesFrom minaret:CitationUsage ],
        [ a owl:Restriction ;
            owl:onProperty minaret:hasExtentType ;
            owl:someValuesFrom minaret:CitationExtent ],
        [ a owl:Restriction ;
            owl:onProperty minaret:occursIn ;
            owl:someValuesFrom minaret:SegmentGroup ],
        [ a owl:Restriction ;
            owl:onProperty minaret:refersTo ;
            owl:someValuesFrom minaret:Dua ] .

minaret:Hadith a owl:Class ;
    rdfs:label "Hadith" ;
    rdfs:comment "Always our own instance -- HadithOccurrence.refersTo never points directly at an external hadith: individual, so its range stays uniform regardless of external coverage. When resolvable against the SemanticHadith KG (six collections in the current data dump), the instance additionally carries skos:exactMatch to the external hadith:{PREFIX}-HDxxxx individual and is populated with its fullHadithText. When not resolvable (e.g. Musnad Ahmad references), the instance holds only reference + expandedReference as extracted, with no skos link -- absence of a skos:exactMatch/closeMatch is itself the queryable 'not yet externally grounded' signal. Like QuranVerse and Dua, it has no class-level tie to an external ontology: own node always, skos link only when resolvable. Deliberately does NOT store an authenticity/transmission-chain grade (SemanticHadith's own HadithType, e.g. marfu) -- MINARET has no way to verify or maintain that classification itself; a consumer who needs it follows skos:exactMatch to the external SemanticHadith KG, which is authoritative for it." .

minaret:HadithOccurrence a owl:Class ;
    rdfs:label "Hadith occurrence" ;
    rdfs:comment "One grounded mention of a hadith within a SegmentGroup. hasUsageType frequently 'Translation' or 'Paraphrase' rather than verbatim quotation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty minaret:occursIn ;
            owl:someValuesFrom minaret:SegmentGroup ],
        [ a owl:Restriction ;
            owl:onProperty minaret:refersTo ;
            owl:someValuesFrom minaret:Hadith ],
        [ a owl:Restriction ;
            owl:onProperty minaret:hasUsageType ;
            owl:someValuesFrom minaret:CitationUsage ] .

minaret:Topic a owl:Class ;
    rdfs:label "Topic" ;
    rdfs:comment "Canonical, deduplicated (see README section 7 -- alias/merge dictionary, tracked via E3). NOT typed as a subclass of any SemanticHadith Topic concept (PillarsOfIslam/ArticlesOfFaith/Crime) -- that would be a stronger ontological commitment than agreed. Where a topic instance corresponds to such a concept, a skos:closeMatch or skos:exactMatch annotation is added instead, on the instance, logged in E3." .

minaret:Heading a owl:Class ;
    rdfs:label "Heading" ;
    rdfs:comment "A coarse structural marker within a Recording (navigation only, not part of the concept taxonomy). Deliberately lightweight: own startTime/endTime only, no SegmentGroup / containsSegment linkage." .

minaret:QuranVerse a owl:Class ;
    rdfs:label "Quran verse" ;
    rdfs:comment "Canonical, reusable across the entire lecture archive. Content sourced from data/DBs/quran.csv (Uthmani/Indopak/clean text, en_sahih, ur_farhat, juz) -- not from the external Quran ontology. Every instance additionally carries skos:exactMatch to the external qur:quran{surah}-{ayah} individual (quranontology.com), computed directly from surahNumber/verseNumber -- see README section 6b. Renamed from QuranAyah for consistency with SemanticHadith's own 'Verse' terminology (see VerseOccurrence comment)." .

minaret:PartialCitation a minaret:CitationExtent ;
    minaret:label "Partial" ;
    rdfs:comment "Only part of the verse/dua text is cited." .

minaret:Translation a minaret:CitationUsage ;
    minaret:label "Translation" ;
    rdfs:comment "Rendered into another language rather than recited verbatim." .

minaret:CompleteCitation a minaret:CitationExtent ;
    minaret:label "Complete" ;
    rdfs:comment "The full verse/dua text is cited." .

minaret:Quotation a minaret:CitationUsage ;
    minaret:label "Quotation" ;
    rdfs:comment "Verbatim recitation of the source text." .

minaret:VerseOccurrence a owl:Class ;
    rdfs:label "Verse occurrence" ;
    rdfs:comment "One grounded mention of a Quranic verse within a SegmentGroup. Renamed from QuranOccurrence, then from AyaOccurrence -- the latter for consistency with SemanticHadith's own ontology (data/DBs/SemanticHadithOntology.owl, same author's prior published work), which uses 'Verse' as the class name for the equivalent concept, not 'Ayah'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty minaret:occursIn ;
            owl:someValuesFrom minaret:SegmentGroup ],
        [ a owl:Restriction ;
            owl:onProperty minaret:refersTo ;
            owl:someValuesFrom minaret:QuranVerse ],
        [ a owl:Restriction ;
            owl:onProperty minaret:hasUsageType ;
            owl:someValuesFrom minaret:CitationUsage ],
        [ a owl:Restriction ;
            owl:onProperty minaret:hasExtentType ;
            owl:someValuesFrom minaret:CitationExtent ] .

minaret:SegmentGroup a owl:Class ;
    rdfs:label "Segment group" ;
    rdfs:comment "A contiguous run of TranscriptSegments materialized at graph-construction time as the anchor for one entity occurrence or one topic assignment. Flat -- never contains another SegmentGroup. Always used, even for a single-segment span." .

minaret:TranscriptSegment a owl:Class ;
    rdfs:label "Transcript segment" ;
    rdfs:comment "A ~10-second fixed transcript window, V3 text only. Stable id/order/count across V0-V3." .

