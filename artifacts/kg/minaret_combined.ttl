    minaret:sequenceIndex 450 ;
    minaret:startTime 2503.64 ;
    minaret:text " ہمارے جسم پر بھی ہوتا ہے  منفی سوچوں سے  بیماریاں بڑھتی ہیں" .

minaret:Segment_SKD2025-0001_0451 a minaret:TranscriptSegment ;
