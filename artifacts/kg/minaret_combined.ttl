    minaret:precedesSegment minaret:Segment_SKD2025-0004_0154 ;
    minaret:sequenceIndex 153 ;
    minaret:startTime 722.34 ;
    minaret:text " اللہ کا شکر  زبان سے بھی ہوتا ہے  دل سے بھی ہوتا ہے" .

minaret:Segment_SKD2025-0004_0154 a minaret:TranscriptSegment ;
    minaret:endTime 728.3000000000001 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0155 ;
    minaret:sequenceIndex 154 ;
    minaret:startTime 726.1600000000001 ;
    minaret:text " اور  عمل سے بھی ہوتا ہے  ٹھیک ہے" .

minaret:Segment_SKD2025-0004_0155 a minaret:TranscriptSegment ;
