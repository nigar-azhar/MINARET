    minaret:sequenceIndex 445 ;
    minaret:startTime 2483.2 ;
    minaret:text " کیا کرتے ہیں  اس نے تومر ہی جانا ہے  یہ تو ٹھیک نہیں ہونے والا" .

minaret:Segment_SKD2025-0001_0446 a minaret:TranscriptSegment ;
    minaret:endTime 2490.5 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0447 ;
    minaret:sequenceIndex 446 ;
    minaret:startTime 2486.62 ;
    minaret:text " یہ بیماری لا علاج ہے  مریضوں کے پاس جا کے  ایسی باتیں کر رہے ہوتے ہیں" .

minaret:Segment_SKD2025-0001_0447 a minaret:TranscriptSegment ;
    minaret:endTime 2494.78 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0448 ;
    minaret:sequenceIndex 447 ;
    minaret:startTime 2490.5 ;
    minaret:text " تو اللہ ایسے انسانوں سے  ہمیں بچا کے رکھے  پناہ میں رکھے" .

minaret:Segment_SKD2025-0001_0448 a minaret:TranscriptSegment ;
    minaret:endTime 2497.98 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0449 ;
    minaret:sequenceIndex 448 ;
    minaret:startTime 2494.78 ;
    minaret:text " جو ہمارے ذہن میں  کوئی بھی  منفی بات ڈالیں" .

minaret:Segment_SKD2025-0001_0449 a minaret:TranscriptSegment ;
    minaret:endTime 2503.64 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0450 ;
    minaret:sequenceIndex 449 ;
    minaret:startTime 2497.98 ;
    minaret:text " کیونکہ اس کا نقصان  ہمارے روئیوں پر  ہمارے ذہن پر" .

minaret:Segment_SKD2025-0001_0450 a minaret:TranscriptSegment ;
