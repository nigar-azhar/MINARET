    minaret:precedesSegment minaret:Segment_SKD2025-0001_0434 ;
    minaret:sequenceIndex 433 ;
    minaret:startTime 2425.1000000000004 ;
    minaret:text " جب اس میں ہم  مثبت انداز اختیار کرتے ہیں  یعنی بیمار پر" .

minaret:Segment_SKD2025-0001_0434 a minaret:TranscriptSegment ;
    minaret:endTime 2434.36 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0435 ;
    minaret:sequenceIndex 434 ;
    minaret:startTime 2429.5800000000004 ;
    minaret:text " دعا کا فائدہ کیا ہوتا ہے  کیونکہ وہ مثبت چیز بار بار  خود بول رہا ہوتا ہے" .

minaret:Segment_SKD2025-0001_0435 a minaret:TranscriptSegment ;
    minaret:endTime 2440.6800000000003 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0436 ;
    minaret:sequenceIndex 435 ;
    minaret:startTime 2434.36 ;
    minaret:text " یا کوئی اس کے اوپر دم کر رہا ہوتا ہے  اب جب کوئی رقیہ کرتا ہے آپ کا  تو وہ کیا کر رہا ہوتا ہے" .

minaret:Segment_SKD2025-0001_0436 a minaret:TranscriptSegment ;
    minaret:endTime 2445.46 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0001_0437 ;
    minaret:sequenceIndex 436 ;
    minaret:startTime 2440.6800000000003 ;
