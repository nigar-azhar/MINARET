    minaret:containsSegment minaret:Segment_HAJJLT22-7039_0015,
        minaret:Segment_HAJJLT22-7039_0016,
        minaret:Segment_HAJJLT22-7039_0017,
        minaret:Segment_HAJJLT22-7039_0018,
        minaret:Segment_HAJJLT22-7039_0019,
        minaret:Segment_HAJJLT22-7039_0020,
        minaret:Segment_HAJJLT22-7039_0021,
        minaret:Segment_HAJJLT22-7039_0022,
