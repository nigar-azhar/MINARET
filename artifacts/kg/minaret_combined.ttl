    rdfs:domain minaret:Speaker ;
    rdfs:range minaret:Recording ;
    owl:inverseOf minaret:hasSpeaker .

minaret:isTranscriptOfRecording a owl:ObjectProperty ;
    rdfs:label "is transcript of recording" ;
    rdfs:domain minaret:Transcript ;
    rdfs:range minaret:Recording ;
    owl:inverseOf minaret:hasTranscript .

minaret:isUsageTypeOf a owl:ObjectProperty ;
    rdfs:label "is usage type of" ;
    rdfs:domain minaret:CitationUsage ;
    owl:inverseOf minaret:hasUsageType .

