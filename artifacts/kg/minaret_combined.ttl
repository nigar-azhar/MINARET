    minaret:precedesSegment minaret:Segment_SKD2025-0004_0134 ;
    minaret:sequenceIndex 133 ;
    minaret:startTime 659.64 ;
    minaret:text " اگر ہم تعریف  کرتے ہیں  تو ہمیں نعمت مل جاتی ہیں" .

minaret:Segment_SKD2025-0004_0134 a minaret:TranscriptSegment ;
    minaret:endTime 666.0 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0135 ;
    minaret:sequenceIndex 134 ;
    minaret:startTime 663.02 ;
    minaret:text " اگر نہیں کرتے  تو ہمیں فرق پڑتا ہے  ہماری تکلیف" .

minaret:Segment_SKD2025-0004_0135 a minaret:TranscriptSegment ;
    minaret:endTime 670.24 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0136 ;
    minaret:sequenceIndex 135 ;
    minaret:startTime 666.0 ;
    minaret:text " اور بڑھ جاتی ہے  غم مناتے رہنے سے  غم کم نہیں ہوا کرتے" .

minaret:Segment_SKD2025-0004_0136 a minaret:TranscriptSegment ;
    minaret:endTime 673.16 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0137 ;
    minaret:sequenceIndex 136 ;
    minaret:startTime 670.24 ;
    minaret:text " بلکہ اور زیادہ  ان میں  اضافہ ہو جاتا ہے" .

minaret:Segment_SKD2025-0004_0137 a minaret:TranscriptSegment ;
    minaret:endTime 677.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0138 ;
    minaret:sequenceIndex 137 ;
    minaret:startTime 673.16 ;
    minaret:text " امام رازی کہتا ہے  جان لو کہ  حمد نعمت کی تعریف ہے" .

minaret:Segment_SKD2025-0004_0138 a minaret:TranscriptSegment ;
    minaret:endTime 681.16 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0139 ;
    minaret:sequenceIndex 138 ;
    minaret:startTime 677.4 ;
    minaret:text " اور نعمت کی تعریف  اس نعمت کی معرفت  کے بغیر ممکن نہیں" .

minaret:Segment_SKD2025-0004_0139 a minaret:TranscriptSegment ;
