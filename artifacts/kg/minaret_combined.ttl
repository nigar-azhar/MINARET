minaret:VerseOccurrence_TQ2005-0315_0011_300_64_26_192 a minaret:VerseOccurrence ;
    minaret:endTime 320.26 ;
    minaret:evidenceText "بے شک یہ خداوندِ عالم کا اتارا ہوا کلام ہے، اس کو امانت دار فرشتہ لے کر اترا ہے، تمہارے دل پر، یعنی محمد صلی اللہ علیہ وسلم کے دل پر، تاکہ تم ڈرانے والوں میں سے بنو، صاف عربی زبان میں ہے، اور اس کا ذکر پہلے لوگوں کی کتابوں میں بھی ہے" ;
    minaret:hasExtentType minaret:CompleteCitation ;
    minaret:hasUsageType minaret:Translation ;
    minaret:occursIn minaret:SegmentGroup_TQ2005-0315_300_64_320_26 ;
    minaret:refersTo minaret:QuranVerse_26_192 ;
    minaret:startTime 300.64 .

