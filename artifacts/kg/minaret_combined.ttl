    minaret:precedesSegment minaret:Segment_SKD2025-0004_0156 ;
    minaret:sequenceIndex 155 ;
    minaret:startTime 728.3000000000001 ;
    minaret:text " زبان سے تو ہم بول کے  الحمدللہ کہہ دیتے ہیں  اور" .

minaret:Segment_SKD2025-0004_0156 a minaret:TranscriptSegment ;
