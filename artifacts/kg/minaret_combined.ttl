    minaret:sequenceIndex 334 ;
    minaret:startTime 1843.74 ;
    minaret:text " اور انسان کی مشکلات حل کرنے کا ذریعہ بھی ہے  تو بہت ہی عظیم چیز ہے  جو ہمارے رب نے ہمیں عطا کر دی ہے" .

minaret:Segment_SKD2025-0001_0340 a minaret:TranscriptSegment ;
