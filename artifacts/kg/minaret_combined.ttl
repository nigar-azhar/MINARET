    minaret:precedesSegment minaret:Segment_SKD2025-0001_0465 ;
    minaret:sequenceIndex 464 ;
    minaret:startTime 2571.16 ;
    minaret:text " ہر چیز کے بارے میں منفی سوچنا  یہ بھی میرے خیال نہیں رکھتا  وہ مجھے نہیں پوچھتا" .

minaret:Segment_SKD2025-0001_0465 a minaret:TranscriptSegment ;
