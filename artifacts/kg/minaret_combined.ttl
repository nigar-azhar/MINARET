minaret:Hadith_SM_520 a minaret:Hadith ;
    minaret:expandedReference "Sahih Muslim, Book of Mosques and Places of Prayer, Chapter: The Masajid Built on Earth and Which Was First, Hadith 520" ;
    minaret:reference "SM_520" ;
