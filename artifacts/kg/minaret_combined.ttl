    minaret:sequenceIndex 144 ;
    minaret:startTime 697.38 ;
    minaret:text " اور شکر کا بھی ہوتا ہے  اور بعض  مفسرین کہتے ہیں" .

minaret:Segment_SKD2025-0004_0145 a minaret:TranscriptSegment ;
