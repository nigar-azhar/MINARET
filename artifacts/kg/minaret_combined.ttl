    minaret:text " دو لگاتی  ہاں کچھ لگاتی بھی ہے  لیکن" .

minaret:Segment_SKD2025-0004_0122 a minaret:TranscriptSegment ;
    minaret:endTime 629.28 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0123 ;
    minaret:sequenceIndex 122 ;
    minaret:startTime 626.98 ;
    minaret:text " ماں کی محبت  ایسے ہوتی ہے  وہ جوں جوں  بچہ روتا ہے" .

minaret:Segment_SKD2025-0004_0123 a minaret:TranscriptSegment ;
    minaret:endTime 632.04 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0124 ;
    minaret:sequenceIndex 123 ;
    minaret:startTime 629.28 ;
    minaret:text " تکلیف میں ہوتا ہے  وہ اور سینے سے لگاتی ہے  پیار کرتی ہے" .

minaret:Segment_SKD2025-0004_0124 a minaret:TranscriptSegment ;
    minaret:endTime 635.42 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0125 ;
    minaret:sequenceIndex 124 ;
    minaret:startTime 632.04 ;
    minaret:text " لاڈ کرتی ہے  کیوں کرتی ہے  محبت کی وجہ سے" .

minaret:Segment_SKD2025-0004_0125 a minaret:TranscriptSegment ;
    minaret:endTime 638.82 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0126 ;
    minaret:sequenceIndex 125 ;
    minaret:startTime 635.42 ;
    minaret:text " تو جس بندے کو  اللہ سے محبت ہوتی ہے  وہ" .

minaret:Segment_SKD2025-0004_0126 a minaret:TranscriptSegment ;
    minaret:endTime 641.72 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0127 ;
    minaret:sequenceIndex 126 ;
    minaret:startTime 638.82 ;
    minaret:text " محبت کے ساتھ  اللہ کی تعریف  حمد کا مطلب ہی ہے" .

minaret:Segment_SKD2025-0004_0127 a minaret:TranscriptSegment ;
    minaret:endTime 644.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0128 ;
    minaret:sequenceIndex 127 ;
    minaret:startTime 641.72 ;
    minaret:text " کہ محبت کے ساتھ  اللہ کی تعریف  صرف تعریف نہیں" .

minaret:Segment_SKD2025-0004_0128 a minaret:TranscriptSegment ;
    minaret:endTime 647.1 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0129 ;
    minaret:sequenceIndex 128 ;
    minaret:startTime 644.4 ;
    minaret:text " ٹھیک ہے  ہماری تعریف  سے اللہ تعالیٰ کو" .

minaret:Segment_SKD2025-0004_0129 a minaret:TranscriptSegment ;
    minaret:endTime 649.4 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0130 ;
    minaret:sequenceIndex 129 ;
    minaret:startTime 647.1 ;
    minaret:text " کوئی فائدہ پہنچتا ہے  نہیں  اور" .

minaret:Segment_SKD2025-0004_0130 a minaret:TranscriptSegment ;
    minaret:endTime 652.6999999999999 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0131 ;
    minaret:sequenceIndex 130 ;
    minaret:startTime 649.4 ;
    minaret:text " ہم نہ تعریف کریں  تو اس کو کوئی نقصان ہوتا ہے  نہیں" .

minaret:Segment_SKD2025-0004_0131 a minaret:TranscriptSegment ;
    minaret:endTime 655.86 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0132 ;
    minaret:sequenceIndex 131 ;
    minaret:startTime 652.6999999999999 ;
    minaret:text " وہ بے نیاز ہے  یہ دراصل  بندوں کے" .

minaret:Segment_SKD2025-0004_0132 a minaret:TranscriptSegment ;
    minaret:endTime 659.64 ;
    minaret:precedesSegment minaret:Segment_SKD2025-0004_0133 ;
    minaret:sequenceIndex 132 ;
    minaret:startTime 655.86 ;
    minaret:text " اپنے ہی فائدے کے لئے  ہمیں  فرق پڑتا ہے" .

minaret:Segment_SKD2025-0004_0133 a minaret:TranscriptSegment ;
