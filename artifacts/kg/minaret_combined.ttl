    minaret:startTime 2530.2999999999997 ;
    minaret:text " وہ بڑھتا ہے  جس کی وجہ سے پھر blood pressure بڑھ جاتا ہے" .

minaret:Segment_SKD2025-0001_0457 a minaret:TranscriptSegment ;
