    minaret:precedesSegment minaret:Segment_SKD2025-0001_0464 ;
    minaret:sequenceIndex 463 ;
    minaret:startTime 2565.7599999999998 ;
    minaret:text " لوگوں کو avoid کرنے کے لیے  لوگوں سے بچنے کے لیے  یہ کس چیز کا نتیجہ ہوتا ہے" .

minaret:Segment_SKD2025-0001_0464 a minaret:TranscriptSegment ;
