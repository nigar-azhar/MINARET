# CQ2 -- Which recordings "refersTo" Verse X?
# Paper-reported result: 5 recordings, spanning two series (SKD2025-0001; TQ2005-0316 through -0319) — confirms cross-series reverse lookup on a single canonical entity.
PREFIX minaret: <http://minaret-eval.org/ontology#>
PREFIX hadith: <http://www.semantichadith.com/ontology/>
PREFIX qur: <http://quranontology.com/Resource/>
PREFIX tafsir: <http://www.semantictafsir.com/ontology/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?recordingId WHERE {
  ?verseNode minaret:surahNumber 1 ; minaret:verseNumber 5 .
  ?occ minaret:refersTo ?verseNode ; minaret:occursIn ?sg .
  ?sg minaret:containsSegment ?seg .
  ?transcript minaret:hasSegment ?seg .
  ?rec minaret:hasTranscript ?transcript ; minaret:recordingId ?recordingId .
}
