# CQ14 -- Which TranscriptSegment "precedesSegment" segment X?
# Paper-reported result: the segment immediately after `sequenceIndex 0` is returned with its full text — a one-hop traversal, with no filtering or sorting on `sequenceIndex`.
PREFIX minaret: <http://minaret-eval.org/ontology#>
PREFIX hadith: <http://www.semantichadith.com/ontology/>
PREFIX qur: <http://quranontology.com/Resource/>
PREFIX tafsir: <http://www.semantictafsir.com/ontology/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?nextText WHERE {
  ?seg minaret:sequenceIndex 0 .
  ?rec minaret:recordingId "TQ2005-0314" .
  ?rec minaret:hasTranscript ?t .
  ?t minaret:hasSegment ?seg .
  ?seg minaret:precedesSegment ?next .
  ?next minaret:text ?nextText .
}
