# CQ7 -- What is the transcript text for the segment a given Verse citation "occursIn"?
# Paper-reported result: 3 transcript segments returned with full Arabic text — confirms citation-to-evidence grounding back to the raw spoken transcript.
PREFIX minaret: <http://minaret-eval.org/ontology#>
PREFIX hadith: <http://www.semantichadith.com/ontology/>
PREFIX qur: <http://quranontology.com/Resource/>
PREFIX tafsir: <http://www.semantictafsir.com/ontology/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?segText ?segStart WHERE {
  ?verseNode minaret:surahNumber 20 ; minaret:verseNumber 25 .
  ?occ minaret:refersTo ?verseNode ; minaret:occursIn ?sg .
  ?sg minaret:containsSegment ?seg .
  ?seg minaret:text ?segText ; minaret:startTime ?segStart .
} ORDER BY ?segStart LIMIT 3
