# CQ5 -- What is the external SemanticHadith entry ("skos:exactMatch") for Hadith X?
# Paper-reported result: `("JT_2517", hadith:JT-HD2517, None)` — confirms the soft-link alignment resolves to a real external URI, per the paper's KG-interlinking design (§6/§7.1 of the schema README).
PREFIX minaret: <http://minaret-eval.org/ontology#>
PREFIX hadith: <http://www.semantichadith.com/ontology/>
PREFIX qur: <http://quranontology.com/Resource/>
PREFIX tafsir: <http://www.semantictafsir.com/ontology/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?reference ?semanticHadithURI ?textAr WHERE {
  ?h minaret:reference "JT_2517" .
  ?h skos:exactMatch ?semanticHadithURI .
  ?h minaret:reference ?reference .
  OPTIONAL { ?h minaret:textUthmani ?textAr }
}
